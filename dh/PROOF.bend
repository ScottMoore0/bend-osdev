def dp.bdisc(+b: Bool) -> Type:
  match b:
    case True{}:
      Empty
    case False{}:
      Unit

def dp.absurd(+e: {False{} == True{} : Bool}) -> Empty:
  %e : dp.bdisc(_)
  Unit{}

def nat_eq_true(a: Nat, b: Nat, h: {Nat.is_eq(a, b) == True{} : Bool}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Empty.absurd({0n == 1n+q : Nat}, dp.absurd(h))
    case 1n+p 0n:
      Empty.absurd({1n+p == 0n : Nat}, dp.absurd(h))
    case 1n+p 1n+q:
      %nat_eq_true(p, q, h) : {1n+p == 1n+_ : Nat}
      {==}

# a public key's bytes, written back from the number read from them, are
# the same bytes (bignum's octets_round_trip), so they read the same

def pk_rt(lenok: Bool, inrange: Bool, +grp: D.DhGroup, +o: B.Octets, +hl: {Nat.is_eq(B.Octets.len(o), D.DhGroup.len(grp)) == lenok : Bool}, +hr: {D.Dh.check_partial(grp, N.BnNat.of_octets(o)) == inrange : Bool}) -> {Result.bind(&2, &2, D.DhError, N.BnNat, N.BnNat, D.dh.pk.go(lenok, inrange, o), y => D.Dh.public_of(grp, D.Dh.public_to(grp, y))) == D.dh.pk.go(lenok, inrange, o) : Result<&2, &2, D.DhError, N.BnNat>}:
  match lenok inrange:
    case False{} _:
      {==}
    case True{} False{}:
      {==}
    case True{} True{}:
      %nat_eq_true(B.Octets.len(o), D.DhGroup.len(grp), hl) : {D.Dh.public_of(grp, Maybe.default(&2, B.Octets, N.BnNat.to_octets(N.BnNat.of_octets(o), _), B.Octets.empty())) == Done{N.BnNat.of_octets(o)} : Result<&2, &2, D.DhError, N.BnNat>}
      %Equal.sym(Maybe<&2, B.Octets>, N.BnNat.to_octets(N.BnNat.of_octets(o), B.Octets.len(o)), Some{o}, NL.octets_round_trip(o)) : {D.Dh.public_of(grp, Maybe.default(&2, B.Octets, _, B.Octets.empty())) == Done{N.BnNat.of_octets(o)} : Result<&2, &2, D.DhError, N.BnNat>}
      %Equal.sym(Bool, Nat.is_eq(B.Octets.len(o), D.DhGroup.len(grp)), True{}, hl) : {D.dh.pk.go(_, D.Dh.check_partial(grp, N.BnNat.of_octets(o)), o) == Done{N.BnNat.of_octets(o)} : Result<&2, &2, D.DhError, N.BnNat>}
      %Equal.sym(Bool, D.Dh.check_partial(grp, N.BnNat.of_octets(o)), True{}, hr) : {D.dh.pk.go(True{}, _, o) == Done{N.BnNat.of_octets(o)} : Result<&2, &2, D.DhError, N.BnNat>}
      {==}

def Laws.public_round_trip(grp, o):
  pk_rt(Nat.is_eq(B.Octets.len(o), D.DhGroup.len(grp)), D.Dh.check_partial(grp, N.BnNat.of_octets(o)), grp, o, {==}, {==})

def Laws.agree_if(grp, x, y, h):
  %h : {D.dh.prim(grp, Md.BnMod.exp(D.Dh.public(grp, y), x, D.DhGroup.p(grp))) == D.dh.prim(grp, _) : Result<&2, &2, D.DhError, B.Octets>}
  {==}

# Small-parameter exhaustive laws

# BEGIN GENERATED by gen/exhaustive.py: exhaustive
def ex.bdisc(+b: Bool) -> Type:
  match b:
    case True{}:
      Empty
    case False{}:
      Unit

def ex.absurd(+e: {False{} == True{} : Bool}) -> Empty:
  %e : ex.bdisc(_)
  Unit{}

