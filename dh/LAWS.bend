# The laws of dh.
#
# For every input:
#   * a public key read from its bytes is read again, the same, from the
#     bytes Dh.public_to writes for it (public_round_trip);
#   * agreement: both sides compute the same shared secret when the two
#     exponentiations commute, (g^y)^x = (g^x)^y mod p (agree_if: a
#     conditional law; that they commute is number theory, which is not
#     proved here for every group and key).
#
# Small-parameter exhaustive laws (generated by gen/exhaustive.py, with
# their proofs), in the safe-prime group p = 23, q = 11, g = 2: agreement
# for every pair of private keys, and the Legendre-symbol validation
# against full validation for every value below p.
import Base
import ../bytes/bytes.bend as B
import ../bignum/bignum.bend as N
import ../bignum/modular.bend as Md
import ./dh.bend as D

def dhlaw.nat(+x: Nat) -> N.BnNat:
  N.BnNat.of_u32(U32.from_nat(x))

# x + 1, for the private keys 1 to q - 1
def dhlaw.nat1(+x: Nat) -> N.BnNat:
  N.BnNat.of_u32(U32.from_nat(Nat.add(x, 1n)))

# the toy group: the safe prime 23, q = 11, and g = 2, of order 11
def dhlaw.toy() -> D.DhGroup:
  D.DhGroup{N.BnNat.of_u32(23), N.BnNat.of_u32(2), N.BnNat.of_u32(11)}

# Properties, for every input

law public_round_trip:
  for +grp: D.DhGroup
  for +o: B.Octets
  {Result.bind(&2, &2, D.DhError, N.BnNat, N.BnNat, D.Dh.public_of(grp, o), y => D.Dh.public_of(grp, D.Dh.public_to(grp, y))) == D.Dh.public_of(grp, o) : Result<&2, &2, D.DhError, N.BnNat>}

law agree_if:
  for +grp: D.DhGroup
  for +x: N.BnNat
  for +y: N.BnNat
  for h: {Md.BnMod.exp(D.Dh.public(grp, y), x, D.DhGroup.p(grp)) == Md.BnMod.exp(D.Dh.public(grp, x), y, D.DhGroup.p(grp)) : N.BnNat}
  {D.Dh.primitive(grp, x, D.Dh.public(grp, y)) == D.Dh.primitive(grp, y, D.Dh.public(grp, x)) : Result<&2, &2, D.DhError, B.Octets>}

# Small-parameter exhaustive laws

# BEGIN GENERATED by gen/exhaustive.py: exhaustive
# in the group p = 23, q = 11, g = 2, both sides of every pair of private keys
# x, y in [1, 10] compute the same shared secret (the primitive on g^y with x,
# and on g^x with y)
law toy_agree:
  for x: Nat
  for y: Nat
  for hx: {Nat.is_lt(x, 10n) == True{} : Bool}
  for hy: {Nat.is_lt(y, 10n) == True{} : Bool}
  {D.Dh.primitive(dhlaw.toy(), dhlaw.nat1(x), D.Dh.public(dhlaw.toy(), dhlaw.nat1(y))) == D.Dh.primitive(dhlaw.toy(), dhlaw.nat1(y), D.Dh.public(dhlaw.toy(), dhlaw.nat1(x))) : Result<&2, &2, D.DhError, B.Octets>}

# in the safe-prime group p = 23, full validation by the Legendre symbol
# (check_safe) agrees with full validation by y^q mod p = 1 (check_full), for
# every y below 23
law toy_check_safe:
  for y: Nat
  for hy: {Nat.is_lt(y, 23n) == True{} : Bool}
  {D.Dh.check_safe(dhlaw.toy(), dhlaw.nat(y)) == D.Dh.check_full(dhlaw.toy(), dhlaw.nat(y)) : Bool}
# END GENERATED: exhaustive
