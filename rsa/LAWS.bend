# The laws of rsa.
#
# For every input:
#   * MGF1 over every hash gives the length asked for, and a shorter mask
#     is a prefix of a longer one (mgf1_length, mgf1_prefix);
#   * RSASSA-PKCS1-v1_5 over every hash and DigestInfo prefix: a signature
#     verifies whenever the encoding succeeds and the key's two primitives
#     undo each other on the encoded message (pkcs1_sign_verify_if: a
#     conditional law; that RSAVP1 undoes RSASP1 is number theory, Euler's
#     theorem, which is not proved here for every key);
#   * EME-PKCS1-v1_5 and EME-OAEP: decoding undoes encoding
#     (es15_round_trip; oaep_round_trip, for every hash and mask generation
#     function), and EMSA-PSS's verification accepts every encoding
#     (pss_round_trip, for every hash of a fixed length and every mask
#     generation function).
#
# Small-parameter exhaustive laws (generated by gen/exhaustive.py, with
# their proofs): for the key p = 5, q = 11, e = 3, made by
# Rsa.private_of_primes, every message below n = 55 goes through RSADP and
# back through RSAEP, and the other way, and RSADP by the Chinese remainder
# theorem equals the first form (n, d).
import Base
import ../bytes/bytes.bend as B
import ../bignum/bignum.bend as N
import ./rsa.bend as R
import ./mgf1.bend as G
import ./pkcs1.bend as P
import ./keys.bend as K
import ./es15.bend as E
import ./oaep.bend as OA
import ./pss.bend as PS

def rsalaw.nat(+x: Nat) -> N.BnNat:
  N.BnNat.of_u32(U32.from_nat(x))

# the toy key: p = 5, q = 11, e = 3 (so d = 3^-1 mod lcm(4, 10) = 7)
def rsalaw.toy() -> Result<&2, &2, R.RsaError, R.RsaPrivate>:
  R.Rsa.private_of_primes(N.BnNat.of_u32(5), N.BnNat.of_u32(11), N.BnNat.of_u32(3))

def rsalaw.is(r: Result<&2, &2, R.RsaError, N.BnNat>, +m: N.BnNat) -> Bool:
  match r:
    case Fail{e}:
      False{}
    case Done{x}:
      N.BnNat.is_eq(x, m)

def rsalaw.same(a: Result<&2, &2, R.RsaError, N.BnNat>, b: Result<&2, &2, R.RsaError, N.BnNat>) -> Bool:
  match a b:
    case Done{x} Done{y}:
      N.BnNat.is_eq(x, y)
    case _ _:
      False{}

def rsalaw.rt.go(r: Result<&2, &2, R.RsaError, R.RsaPrivate>, +m: N.BnNat) -> Bool:
  match r:
    case Fail{e}:
      False{}
    case Done{+sk}:
      +pk = R.Rsa.public(sk)
      +back = rsalaw.is(Result.bind(&2, &2, R.RsaError, N.BnNat, N.BnNat, R.Rsa.dp(sk, m), x => R.Rsa.ep(pk, x)), m)
      +forth = rsalaw.is(Result.bind(&2, &2, R.RsaError, N.BnNat, N.BnNat, R.Rsa.ep(pk, m), x => R.Rsa.dp(sk, x)), m)
      Bool.and(Bool.and(back, forth), rsalaw.same(R.Rsa.dp(sk, m), R.Rsa.dp_plain(sk, m)))

# whether, for the toy key, RSAEP(RSADP(m)) = m, RSADP(RSAEP(m)) = m and
# RSADP's two forms agree on m
def rsalaw.round_trip(+m: N.BnNat) -> Bool:
  rsalaw.rt.go(rsalaw.toy(), m)

# Properties, for every input

# MGF1 gives n bytes, whatever the hash and seed
law mgf1_length:
  for ~digest: B.Octets -> B.Octets
  for +seed: B.Octets
  for +n: Nat
  {B.Octets.len(G.RsaMgf1.mask(~digest, seed, n)) == n : Nat}

# a shorter MGF1 mask is a prefix of a longer one
law mgf1_prefix:
  for ~digest: B.Octets -> B.Octets
  for +seed: B.Octets
  for +n: Nat
  for +j: Nat
  {B.Octets.take(n, G.RsaMgf1.mask(~digest, seed, Nat.add(n, j))) == G.RsaMgf1.mask(~digest, seed, n) : B.Octets}

# RSASSA-PKCS1-v1_5: when EMSA-PKCS1-v1_5 encodes M as EM for the
# modulus's length (he), RSASP1 on EM gives the signature S (hs), and
# RSAVP1 on S gives EM back (hv), the signature of M verifies, for every
# hash, prefix, key and message
law pkcs1_sign_verify_if:
  for ~digest: B.Octets -> B.Octets
  for +prefix: B.Octets
  for +sk: R.RsaPrivate
  for +m: B.Octets
  for +em: B.Octets
  for +s: B.Octets
  for +he: {P.RsaPkcs1.encode(~digest, prefix, m, R.Rsa.k_of(sk)) == Done{em} : Result<&2, &2, R.RsaError, B.Octets>}
  for hs: {R.Rsa.dp_octets(sk, em) == Done{s} : Result<&2, &2, R.RsaError, B.Octets>}
  for hv: {R.Rsa.ep_octets(R.Rsa.public(sk), s) == Done{em} : Result<&2, &2, R.RsaError, B.Octets>}
  {Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => P.RsaPkcs1.verify(~digest, prefix, R.Rsa.public(sk), m, x), P.RsaPkcs1.sign(~digest, prefix, sk, m)) == Done{True{}} : Result<&2, &2, R.RsaError, Bool>}

# EME-PKCS1-v1_5: decoding undoes encoding, for every message, padding
# string and modulus length (and when encoding refuses, both sides refuse
# alike)
law es15_round_trip:
  for +m: B.Octets
  for +ps: B.Octets
  for +k: Nat
  {Result.bind(&2, &2, R.RsaError, B.Octets, B.Octets, E.RsaEs15.encode(m, ps, k), em => E.RsaEs15.decode(em)) == Result.map(&2, &2, R.RsaError, B.Octets, B.Octets, em => m, E.RsaEs15.encode(m, ps, k)) : Result<&2, &2, R.RsaError, B.Octets>}

# EME-OAEP: decoding undoes encoding, for every hash, mask generation
# function, label, message, seed and modulus length (and when encoding
# refuses, both sides refuse alike)
law oaep_round_trip:
  for ~digest: B.Octets -> B.Octets
  for ~mgf: B.Octets -> Nat -> B.Octets
  for +label: B.Octets
  for +m: B.Octets
  for +seed: B.Octets
  for +k: Nat
  {Result.bind(&2, &2, R.RsaError, B.Octets, B.Octets, OA.RsaOaep.encode(~digest, ~mgf, label, m, seed, k), em => OA.RsaOaep.decode(~digest, ~mgf, label, em)) == Result.map(&2, &2, R.RsaError, B.Octets, B.Octets, em => m, OA.RsaOaep.encode(~digest, ~mgf, label, m, seed, k)) : Result<&2, &2, R.RsaError, B.Octets>}

# EMSA-PSS: verification accepts every encoding, for every mask generation
# function, message, salt and emBits, and every hash whose digest of M' is
# as long as its digest of M (every hash of a fixed length: hd)
law pss_round_trip:
  for ~digest: B.Octets -> B.Octets
  for ~mgf: B.Octets -> Nat -> B.Octets
  for +m: B.Octets
  for +salt: B.Octets
  for +embits: Nat
  for +hd: {B.Octets.len(digest(B.Octets.append(B.Octets.zeros(8n), B.Octets.append(digest(m), salt)))) == B.Octets.len(digest(m)) : Nat}
  {Result.map(&2, &2, R.RsaError, B.Octets, Bool, em => PS.RsaPss.check(~digest, ~mgf, m, em, embits, B.Octets.len(salt)), PS.RsaPss.encode(~digest, ~mgf, m, salt, embits)) == Result.map(&2, &2, R.RsaError, B.Octets, Bool, em => True{}, PS.RsaPss.encode(~digest, ~mgf, m, salt, embits)) : Result<&2, &2, R.RsaError, Bool>}

# Small-parameter exhaustive laws

# BEGIN GENERATED by gen/exhaustive.py: exhaustive
# for the key p = 5, q = 11, e = 3 (Rsa.private_of_primes), every message m
# below n = 55: RSAEP(RSADP(m)) = m, RSADP(RSAEP(m)) = m, and RSADP by the CRT
# equals its first form (n, d) (rsalaw.round_trip)
law toy_round_trip:
  for m: Nat
  for hm: {Nat.is_lt(m, 55n) == True{} : Bool}
  {rsalaw.round_trip(rsalaw.nat(m)) == True{} : Bool}
# END GENERATED: exhaustive
