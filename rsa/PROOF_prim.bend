# The laws

def kp.od(di: Maybe<&2, N.BnNat>, +n: N.BnNat, +e: N.BnNat, +p: N.BnNat, +q: N.BnNat, +sk: R.RsaPrivate, h: {R.rsa.of_d(n, e, p, q, di) == Done{sk} : Result<&2, &2, R.RsaError, R.RsaPrivate>}) -> {R.Rsa.private_of(n, e, Maybe.default(&2, N.BnNat, di, N.BnNat.zero()), p, q) == Done{sk} : Result<&2, &2, R.RsaError, R.RsaPrivate>}:
  match di:
    case None{}:
      Empty.absurd({R.Rsa.private_of(n, e, Maybe.default(&2, N.BnNat, None{}, N.BnNat.zero()), p, q) == Done{sk} : Result<&2, &2, R.RsaError, R.RsaPrivate>}, kp.fd(R.RsaBadKey{}, sk, h))
    case Some{d}:
      h

def Laws.private_of_primes_key(p, q, e, sk, h):
  kp.od(Md.BnMod.inv(e, Md.BnMod.lcm(R.rsa.minus1(p), R.rsa.minus1(q))), N.BnNat.mul(p, q), e, p, q, sk, h)

