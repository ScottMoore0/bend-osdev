def Laws.dp_ep(n, e, d, p, q, sk, m, hk, hn, he, hd, hp, hq, pp, pq, hm, hlt):
  %kp.ksk(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk) : {Result.map(&2, &2, R.RsaError, N.BnNat, Nat, x => LL.bnlaw.value(x), Result.bind(&2, &2, R.RsaError, N.BnNat, N.BnNat, R.Rsa.ep(R.Rsa.public(_), m), c => R.Rsa.dp(_, c))) == Done{LL.bnlaw.value(m)} : Result<&2, &2, R.RsaError, Nat>}
