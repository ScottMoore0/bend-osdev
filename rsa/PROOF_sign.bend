def kq.de2(+n: N.BnNat, +e: N.BnNat, +d: N.BnNat, +p: N.BnNat, +q: N.BnNat, +t: N.BnNat, +hb1: {Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))) == True{} : Bool}, +hb2: {Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))) == True{} : Bool}, +hmi: {Md.BnMod.inv(q, p) == Some{t} : Maybe<&2, N.BnNat>}, +hn: {LL.bnlaw.valid(n) == True{} : Bool}, +he: {LL.bnlaw.valid(e) == True{} : Bool}, +hd: {LL.bnlaw.valid(d) == True{} : Bool}, +hp: {LL.bnlaw.valid(p) == True{} : Bool}, +hq: {LL.bnlaw.valid(q) == True{} : Bool}, +pp: {LF.bnlaw.prime(LL.bnlaw.value(p)) == True{} : Bool}, +pq: {LF.bnlaw.prime(LL.bnlaw.value(q)) == True{} : Bool}, +o: B.Octets, r: Result<&2, &2, R.RsaError, B.Octets>, +er: {R.Rsa.ep_octets(R.Rsa.public(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}), o) == r : Result<&2, &2, R.RsaError, B.Octets>}) -> {Result.bind(&2, &2, R.RsaError, B.Octets, B.Octets, r, c => R.Rsa.dp_octets(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}, c)) == Result.map(&2, &2, R.RsaError, B.Octets, B.Octets, c => o, r) : Result<&2, &2, R.RsaError, B.Octets>}:
  match r:
    case Fail{x}:
      {==}
    case Done{+c}:
