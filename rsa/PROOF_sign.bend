# RSASSA-PKCS1-v1_5

def kq.pk2(~digest: B.Octets -> B.Octets, +prefix: B.Octets, +m: B.Octets, +n: N.BnNat, +e: N.BnNat, +d: N.BnNat, +p: N.BnNat, +q: N.BnNat, +t: N.BnNat, +hb1: {Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))) == True{} : Bool}, +hb2: {Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))) == True{} : Bool}, +hmi: {Md.BnMod.inv(q, p) == Some{t} : Maybe<&2, N.BnNat>}, +hn: {LL.bnlaw.valid(n) == True{} : Bool}, +he: {LL.bnlaw.valid(e) == True{} : Bool}, +hd: {LL.bnlaw.valid(d) == True{} : Bool}, +hp: {LL.bnlaw.valid(p) == True{} : Bool}, +hq: {LL.bnlaw.valid(q) == True{} : Bool}, +pp: {LF.bnlaw.prime(LL.bnlaw.value(p)) == True{} : Bool}, +pq: {LF.bnlaw.prime(LL.bnlaw.value(q)) == True{} : Bool}, +em: B.Octets, +er1: {P.RsaPkcs1.encode(~digest, prefix, m, N.BnNat.byte_len(n)) == Done{em} : Result<&2, &2, R.RsaError, B.Octets>}, r: Result<&2, &2, R.RsaError, B.Octets>, +er2: {R.Rsa.dp_octets(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}, em) == r : Result<&2, &2, R.RsaError, B.Octets>}) -> {Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => P.RsaPkcs1.verify(~digest, prefix, R.Rsa.public(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}), m, x), r) == Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => True{}, r) : Result<&2, &2, R.RsaError, Bool>}:
  match r:
    case Fail{x}:
      {==}
    case Done{+s}:
      %Equal.sym(Result<&2, &2, R.RsaError, B.Octets>, R.Rsa.ep_octets(R.Rsa.public(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}), s), Done{em}, kq.eo3(n, e, d, p, q, t, hb1, hb2, hmi, hn, he, hd, hp, hq, pp, pq, em, s, er2)) : {Done{P.rsa.pkcs1.check(~digest, _, prefix, m, N.BnNat.byte_len(n))} == Done{True{}} : Result<&2, &2, R.RsaError, Bool>}
      %Equal.sym(Result<&2, &2, R.RsaError, B.Octets>, P.RsaPkcs1.encode(~digest, prefix, m, N.BnNat.byte_len(n)), Done{em}, er1) : {Done{P.rsa.pkcs1.cmp(_, em)} == Done{True{}} : Result<&2, &2, R.RsaError, Bool>}
      %Equal.sym(Bool, B.Octets.is_eq(em, em), True{}, BL.octets_is_eq_refl(em)) : {Done{_} == Done{True{}} : Result<&2, &2, R.RsaError, Bool>}
      {==}

def kq.pk1(~digest: B.Octets -> B.Octets, +prefix: B.Octets, +m: B.Octets, +n: N.BnNat, +e: N.BnNat, +d: N.BnNat, +p: N.BnNat, +q: N.BnNat, +t: N.BnNat, +hb1: {Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))) == True{} : Bool}, +hb2: {Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))) == True{} : Bool}, +hmi: {Md.BnMod.inv(q, p) == Some{t} : Maybe<&2, N.BnNat>}, +hn: {LL.bnlaw.valid(n) == True{} : Bool}, +he: {LL.bnlaw.valid(e) == True{} : Bool}, +hd: {LL.bnlaw.valid(d) == True{} : Bool}, +hp: {LL.bnlaw.valid(p) == True{} : Bool}, +hq: {LL.bnlaw.valid(q) == True{} : Bool}, +pp: {LF.bnlaw.prime(LL.bnlaw.value(p)) == True{} : Bool}, +pq: {LF.bnlaw.prime(LL.bnlaw.value(q)) == True{} : Bool}, r: Result<&2, &2, R.RsaError, B.Octets>, +er1: {P.RsaPkcs1.encode(~digest, prefix, m, N.BnNat.byte_len(n)) == r : Result<&2, &2, R.RsaError, B.Octets>}) -> {Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => P.RsaPkcs1.verify(~digest, prefix, R.Rsa.public(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}), m, x), Result.bind(&2, &2, R.RsaError, B.Octets, B.Octets, r, em => R.Rsa.dp_octets(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}, em))) == Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => True{}, Result.bind(&2, &2, R.RsaError, B.Octets, B.Octets, r, em => R.Rsa.dp_octets(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}, em))) : Result<&2, &2, R.RsaError, Bool>}:
  match r:
    case Fail{x}:
      {==}
    case Done{+em}:
      kq.pk2(~digest, prefix, m, n, e, d, p, q, t, hb1, hb2, hmi, hn, he, hd, hp, hq, pp, pq, em, er1, R.Rsa.dp_octets(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}, em), {==})

# The laws

def Laws.ep_dp_octets(n, e, d, p, q, sk, o, hk, hn, he, hd, hp, hq, pp, pq):
  %KP.kp.ksk(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk) : {Result.bind(&2, &2, R.RsaError, B.Octets, B.Octets, R.Rsa.dp_octets(_, o), s => R.Rsa.ep_octets(R.Rsa.public(_), s)) == Result.map(&2, &2, R.RsaError, B.Octets, B.Octets, s => o, R.Rsa.dp_octets(_, o)) : Result<&2, &2, R.RsaError, B.Octets>}
  kq.eo2(n, e, d, p, q, Maybe.default(&2, N.BnNat, Md.BnMod.inv(q, p), N.BnNat.zero()), KP.kp.kb1(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), KP.kp.kb2(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), KP.kp.kmi(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), hn, he, hd, hp, hq, pp, pq, o, R.Rsa.dp_octets(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), Maybe.default(&2, N.BnNat, Md.BnMod.inv(q, p), N.BnNat.zero())}, o), {==})

def Laws.dp_ep_octets(n, e, d, p, q, sk, o, hk, hn, he, hd, hp, hq, pp, pq):
  %KP.kp.ksk(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk) : {Result.bind(&2, &2, R.RsaError, B.Octets, B.Octets, R.Rsa.ep_octets(R.Rsa.public(_), o), c => R.Rsa.dp_octets(_, c)) == Result.map(&2, &2, R.RsaError, B.Octets, B.Octets, c => o, R.Rsa.ep_octets(R.Rsa.public(_), o)) : Result<&2, &2, R.RsaError, B.Octets>}
  kq.de2(n, e, d, p, q, Maybe.default(&2, N.BnNat, Md.BnMod.inv(q, p), N.BnNat.zero()), KP.kp.kb1(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), KP.kp.kb2(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), KP.kp.kmi(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), hn, he, hd, hp, hq, pp, pq, o, R.Rsa.ep_octets(R.Rsa.public(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), Maybe.default(&2, N.BnNat, Md.BnMod.inv(q, p), N.BnNat.zero())}), o), {==})

def Laws.pkcs1_sign_verify(digest, prefix, n, e, d, p, q, sk, m, hk, hn, he, hd, hp, hq, pp, pq):
  %KP.kp.ksk(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk) : {Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => P.RsaPkcs1.verify(~digest, prefix, R.Rsa.public(_), m, x), P.RsaPkcs1.sign(~digest, prefix, _, m)) == Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => True{}, P.RsaPkcs1.sign(~digest, prefix, _, m)) : Result<&2, &2, R.RsaError, Bool>}
  kq.pk1(~digest, prefix, m, n, e, d, p, q, Maybe.default(&2, N.BnNat, Md.BnMod.inv(q, p), N.BnNat.zero()), KP.kp.kb1(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), KP.kp.kb2(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), KP.kp.kmi(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), hn, he, hd, hp, hq, pp, pq, P.RsaPkcs1.encode(~digest, prefix, m, N.BnNat.byte_len(n)), {==})
