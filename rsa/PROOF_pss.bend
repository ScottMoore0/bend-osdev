def kz.len(~digest: B.Octets -> B.Octets, ~mgf: B.Octets -> Nat -> B.Octets, +m: B.Octets, +salt: B.Octets, +embits: Nat, +em: B.Octets, +hdg: {B.Octets.len(digest(PS.rsa.pss.mprime(digest(m), salt))) == B.Octets.len(digest(m)) : Nat}, h: {PS.RsaPss.encode(~digest, ~mgf, m, salt, embits) == Done{em} : Result<&2, &2, R.RsaError, B.Octets>}) -> {B.Octets.len(em) == PS.RsaPss.em_len(embits) : Nat}:
  kz.len2(~digest, ~mgf, Nat.is_le(Nat.add(B.Octets.len(digest(m)), Nat.add(B.Octets.len(salt), 2n)), PS.RsaPss.em_len(embits)), m, salt, embits, em, {==}, hdg, h)

# RSASSA-PSS

def kz.ndisc(r: Result<&2, &2, R.RsaError, N.BnNat>) -> Type:
  match r:
    case Fail{x}:
      Unit
    case Done{y}:
      Empty

def kz.fdn(x: R.RsaError, y: N.BnNat, e: {Fail{x} == Done{y} : Result<&2, &2, R.RsaError, N.BnNat>}) -> Empty:
  %e : kz.ndisc(_)
  Unit{}

def kz.unn(r: Result<&2, &2, R.RsaError, N.BnNat>, +a: N.BnNat) -> N.BnNat:
  match r:
    case Fail{x}:
      a
    case Done{y}:
      y

def kz.si(b1: Bool, +w: N.BnNat, +x: N.BnNat, h: {Result.map(&2, &2, R.RsaError, Unit, N.BnNat, u => w, R.RsaError.check(b1, R.RsaOutOfRange{})) == Done{x} : Result<&2, &2, R.RsaError, N.BnNat>}) -> {b1 == True{} : Bool}:
  match b1:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, kz.fdn(R.RsaOutOfRange{}, x, h))

def kz.sw(b1: Bool, +w: N.BnNat, +x: N.BnNat, h: {Result.map(&2, &2, R.RsaError, Unit, N.BnNat, u => w, R.RsaError.check(b1, R.RsaOutOfRange{})) == Done{x} : Result<&2, &2, R.RsaError, N.BnNat>}) -> {w == x : N.BnNat}:
  match b1:
    case True{}:
      Equal.cong(Result<&2, &2, R.RsaError, N.BnNat>, N.BnNat, zz => kz.unn(zz, w), Done{w}, Done{x}, h)
    case False{}:
      Empty.absurd({w == x : N.BnNat}, kz.fdn(R.RsaOutOfRange{}, x, h))

