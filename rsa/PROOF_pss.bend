def kz.p1(~digest: B.Octets -> B.Octets, ~mgf: B.Octets -> Nat -> B.Octets, +m: B.Octets, +salt: B.Octets, +hdg: {B.Octets.len(digest(B.Octets.append(B.Octets.zeros(8n), B.Octets.append(digest(m), salt)))) == B.Octets.len(digest(m)) : Nat}, +n: N.BnNat, +e: N.BnNat, +d: N.BnNat, +p: N.BnNat, +q: N.BnNat, +t: N.BnNat, +hb1: {Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))) == True{} : Bool}, +hb2: {Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))) == True{} : Bool}, +hmi: {Md.BnMod.inv(q, p) == Some{t} : Maybe<&2, N.BnNat>}, +hn: {LL.bnlaw.valid(n) == True{} : Bool}, +he: {LL.bnlaw.valid(e) == True{} : Bool}, +hd: {LL.bnlaw.valid(d) == True{} : Bool}, +hp: {LL.bnlaw.valid(p) == True{} : Bool}, +hq: {LL.bnlaw.valid(q) == True{} : Bool}, +pp: {LF.bnlaw.prime(LL.bnlaw.value(p)) == True{} : Bool}, +pq: {LF.bnlaw.prime(LL.bnlaw.value(q)) == True{} : Bool}, r: Result<&2, &2, R.RsaError, B.Octets>, +er1: {PS.RsaPss.encode(~digest, ~mgf, m, salt, Nat.sub(N.BnNat.bit_len(n), 1n)) == r : Result<&2, &2, R.RsaError, B.Octets>}) -> {Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => PS.RsaPss.verify(~digest, ~mgf, R.Rsa.public(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}), m, x, B.Octets.len(salt)), Result.bind(&2, &2, R.RsaError, B.Octets, B.Octets, r, em => Result.bind(&2, &2, R.RsaError, N.BnNat, B.Octets, R.Rsa.sp1(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}, N.BnNat.of_octets(em)), x => R.Rsa.i2osp(x, N.BnNat.byte_len(n))))) == Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => True{}, Result.bind(&2, &2, R.RsaError, B.Octets, B.Octets, r, em => Result.bind(&2, &2, R.RsaError, N.BnNat, B.Octets, R.Rsa.sp1(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}, N.BnNat.of_octets(em)), x => R.Rsa.i2osp(x, N.BnNat.byte_len(n))))) : Result<&2, &2, R.RsaError, Bool>}:
  match r:
    case Fail{x}:
      {==}
    case Done{+em}:
      kz.p2(~digest, ~mgf, m, salt, hdg, n, e, d, p, q, t, hb1, hb2, hmi, hn, he, hd, hp, hq, pp, pq, em, er1, R.Rsa.sp1(R.RsaPrivate{n, e, d, p, q, N.BnNat.mod(d, R.rsa.minus1(p)), N.BnNat.mod(d, R.rsa.minus1(q)), t}, N.BnNat.of_octets(em)), {==})

# The law

def Laws.pss_sign_verify(digest, mgf, n, e, d, p, q, sk, m, salt, hdg, hk, hn, he, hd, hp, hq, pp, pq):
  %KP.kp.ksk(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk) : {Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => PS.RsaPss.verify(~digest, ~mgf, R.Rsa.public(_), m, x, B.Octets.len(salt)), PS.RsaPss.sign(~digest, ~mgf, _, m, salt)) == Result.map(&2, &2, R.RsaError, B.Octets, Bool, x => True{}, PS.RsaPss.sign(~digest, ~mgf, _, m, salt)) : Result<&2, &2, R.RsaError, Bool>}
  kz.p1(~digest, ~mgf, m, salt, hdg, n, e, d, p, q, Maybe.default(&2, N.BnNat, Md.BnMod.inv(q, p), N.BnNat.zero()), KP.kp.kb1(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), KP.kp.kb2(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), KP.kp.kmi(Bool.and(Bool.and(N.BnNat.is_odd(n), N.BnNat.is_lt(R.rsa.three(), n)), Bool.and(N.BnNat.is_odd(e), Bool.and(N.BnNat.is_le(R.rsa.three(), e), N.BnNat.is_lt(e, n)))), Bool.and(Bool.and(N.BnNat.is_eq(N.BnNat.mul(p, q), n), Bool.and(N.BnNat.is_lt(N.BnNat.one(), p), N.BnNat.is_lt(N.BnNat.one(), q))), Bool.and(N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(p)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(p))), N.BnNat.is_eq(Md.BnMod.mul(d, e, R.rsa.minus1(q)), N.BnNat.mod(N.BnNat.one(), R.rsa.minus1(q))))), Md.BnMod.inv(q, p), n, e, d, p, q, sk, hk), hn, he, hd, hp, hq, pp, pq, PS.RsaPss.encode(~digest, ~mgf, m, salt, Nat.sub(N.BnNat.bit_len(n), 1n)), {==})
