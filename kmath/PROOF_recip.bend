def km.r11(+x0: Nat, +x1: Nat, +x2: Nat) -> {Nat.add(Nat.mul(x0, x1), Nat.add(x1, Nat.mul(x2, x1))) == Nat.mul(Nat.add(x0, 1n+x2), x1) : Nat}:
  %Equal.sym(Nat, Nat.mul(x2, x1), Nat.mul(x1, x2), UL.nat_mul_comm(x2, x1)) : {Nat.add(Nat.mul(x0, x1), Nat.add(x1, _)) == Nat.mul(Nat.add(x0, 1n+x2), x1) : Nat}
