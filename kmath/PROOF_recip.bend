def km.k_ta1(+w: Nat, +av: Nat, +qv: Nat, +s: Nat, +t: Nat, +h2: {Nat.add(s, Nat.mul(t, w)) == Nat.mul(av, Nat.add(qv, 1n)) : Nat}, +hq: {Nat.is_lt(Nat.add(qv, 1n), w) == True{} : Bool}, z: Bool, ez: {Nat.is_le(t, av) == z : Bool}) -> {Nat.is_le(t, av) == True{} : Bool}:
  match z:
    case True{}:
      ez
    case False{}:
      +u = Nat.sub(t, 1n+av)
      +uu = UL.nat_lt_witness(av, t, km.nle_lt(t, av, ez))
      +g = Nat.sub(w, 1n+Nat.add(qv, 1n))
      +gg = UL.nat_lt_witness(Nat.add(qv, 1n), w, hq)
