  %Equal.sym(Nat, Nat.add(Nat.mul(x0, x1), Nat.mul(x2, x1)), Nat.mul(Nat.add(x0, x2), x1), Equal.sym(Nat, Nat.mul(Nat.add(x0, x2), x1), Nat.add(Nat.mul(x0, x1), Nat.mul(x2, x1)), UL.nat_add_mul(x0, x2, x1))) : {Nat.add(Nat.mul(1n, x1), _) == Nat.mul(Nat.add(x0, 1n+x2), x1) : Nat}
