def km.k_q1(+w: Nat, +dv: Nat, +cv: Nat, +qv: Nat, +r0: Nat, +h1: {Nat.add(Nat.mul(qv, dv), r0) == Nat.mul(cv, w) : Nat}, +hc: {Nat.is_lt(cv, dv) == True{} : Bool}, +hd: {Nat.is_lt(dv, w) == True{} : Bool}, z: Bool, ez: {Nat.is_lt(Nat.add(qv, 1n), w) == z : Bool}) -> {Nat.is_lt(Nat.add(qv, 1n), w) == True{} : Bool}:
  match z:
    case True{}:
      ez
    case False{}:
      +u = Nat.sub(Nat.add(qv, 1n), w)
      +uu = UL.nat_le_witness(w, Nat.add(qv, 1n), km.nlt_le(Nat.add(qv, 1n), w, ez))
      +c = Nat.sub(dv, 1n+cv)
      +c1 = UL.nat_lt_witness(cv, dv, hc)
      +dd = Nat.sub(w, 1n+dv)
      +d1 = UL.nat_lt_witness(dv, w, hd)
