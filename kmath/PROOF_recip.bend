def km.k_q(+w: Nat, +dv: Nat, +cv: Nat, +qv: Nat, +r0: Nat, +h1: {Nat.add(Nat.mul(qv, dv), r0) == Nat.mul(cv, w) : Nat}, +hc: {Nat.is_lt(cv, dv) == True{} : Bool}, +hd: {Nat.is_lt(dv, w) == True{} : Bool}) -> {Nat.is_lt(Nat.add(qv, 1n), w) == True{} : Bool}:
  km.k_q1(w, dv, cv, qv, r0, h1, hc, hd, Nat.is_lt(Nat.add(qv, 1n), w), {==})

