  %km.fv(d) : {Nat.add(Nat.mul(W.W64.to_nat(W.W64.fst(W.W64.divmod(n, W.W64.from_u32(d)))), _), W.W64.to_nat(W.W64.snd(W.W64.divmod(n, W.W64.from_u32(d))))) == W.W64.to_nat(n) : Nat}
  WD.divmod_value(n, W.W64.from_u32(d), hh)

def Laws.div_u64_rem_lt(n, d, h):
  +lt = km.mlt(n, d, h)
  %km.or(W.W64.divmod(n, W.W64.from_u32(d))) : {Nat.is_lt(U32.to_nat(_), U32.to_nat(d)) == True{} : Bool}
