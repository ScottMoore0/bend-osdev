def km.ru1(-a: Nat, -b: Nat, -c: Nat, -x: Nat, pr: {Nat.is_le(a, b) == True{} : Bool} & {Nat.is_lt(c, x) == True{} : Bool}) -> {Nat.is_le(a, b) == True{} : Bool}:
  (+u, +v) = pr
  u

def km.ru2(-a: Nat, -b: Nat, -c: Nat, -x: Nat, pr: {Nat.is_le(a, b) == True{} : Bool} & {Nat.is_lt(c, x) == True{} : Bool}) -> {Nat.is_lt(c, x) == True{} : Bool}:
  (+u, +v) = pr
  v

