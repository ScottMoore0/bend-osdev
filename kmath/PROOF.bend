def gm.mlt(+p: Nat, +R: Nat, +q: Nat, h: Sigma<&1, &1, Nat, w => {Nat.add(w, R) == q : Nat}>) -> {Nat.is_lt(Nat.mul(1n+p, R), Nat.mul(1n+p, 1n+q)) == True{} : Bool}:
