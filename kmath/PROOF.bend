def gm.least(+a: Nat, +m: Nat, +b: Nat, +u: Nat, +v: Nat, eu: {Nat.mul(u, a) == m : Nat}, ev: {Nat.mul(v, b) == m : Nat}) -> Sigma<&1, &1, Nat, k => {Nat.mul(k, K.KMath.lcm(a, b)) == m : Nat}>:
