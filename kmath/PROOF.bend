def Laws.lcm_least(a, b, m, u, v, eu, ev):
  gm.least(a, m, b, u, v, eu, ev)

# isqrt: the invariant r^2 <= n < (r + 2^(b+1))^2 before bit b

def bdisc(+b: Bool) -> Type:
  match b:
    case True{}:
      Unit
    case False{}:
      Empty

def bt_absurd(+e: {True{} == False{} : Bool}) -> Empty:
  %e : bdisc(_)
  Unit{}

def le_zero_l(+n: Nat) -> {Nat.is_le(0n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      {==}

def not_le_lt(+x: Nat, +y: Nat, e: {Nat.is_le(x, y) == False{} : Bool}) -> {Nat.is_lt(y, x) == True{} : Bool}:
  match x y:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, bt_absurd(e))
    case 0n 1n+q:
      Empty.absurd({Nat.is_lt(1n+q, 0n) == True{} : Bool}, bt_absurd(e))
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      not_le_lt(p, q, e)

def add_double(+r: Nat, +p: Nat) -> {Nat.add(Nat.add(r, p), p) == Nat.add(r, Nat.double(p)) : Nat}:
  Equal.trans(Nat, Nat.add(Nat.add(r, p), p), Nat.add(r, Nat.add(p, p)), Nat.add(r, Nat.double(p)), UL.nat_add_assoc(r, p, p), Equal.cong(Nat, Nat, z => Nat.add(r, z), Nat.add(p, p), Nat.double(p), Equal.sym(Nat, Nat.double(p), Nat.add(p, p), UL.nat_double(p))))

def lt_tr(+n: Nat, -x: Nat, -y: Nat, e: {x == y : Nat}, h: {Nat.is_lt(n, Nat.mul(y, y)) == True{} : Bool}) -> {Nat.is_lt(n, Nat.mul(x, x)) == True{} : Bool}:
  Equal.trans(Bool, Nat.is_lt(n, Nat.mul(x, x)), Nat.is_lt(n, Nat.mul(y, y)), True{}, Equal.cong(Nat, Bool, +z => Nat.is_lt(n, Nat.mul(z, z)), x, y, e), h)

def isp(+k: Nat, +n: Nat, +r: Nat, +ok: Bool, e: {Nat.is_le(Nat.mul(Nat.add(r, S.KMath.pow2(k)), Nat.add(r, S.KMath.pow2(k))), n) == ok : Bool}, h1: {Nat.is_le(Nat.mul(r, r), n) == True{} : Bool}, h2: {Nat.is_lt(n, Nat.mul(Nat.add(r, S.KMath.pow2(1n+k)), Nat.add(r, S.KMath.pow2(1n+k)))) == True{} : Bool}) -> {Nat.is_le(Nat.mul(S.isqrt.go(k, n, S.isqrt.pick(ok, r, Nat.add(r, S.KMath.pow2(k)))), S.isqrt.go(k, n, S.isqrt.pick(ok, r, Nat.add(r, S.KMath.pow2(k))))), n) == True{} : Bool} & {Nat.is_lt(n, Nat.mul(Nat.add(S.isqrt.go(k, n, S.isqrt.pick(ok, r, Nat.add(r, S.KMath.pow2(k)))), 1n), Nat.add(S.isqrt.go(k, n, S.isqrt.pick(ok, r, Nat.add(r, S.KMath.pow2(k)))), 1n))) == True{} : Bool}:
  match k:
    case 0n:
      match ok:
        case True{}:
          (e, lt_tr(n, Nat.add(Nat.add(r, S.KMath.pow2(0n)), S.KMath.pow2(0n)), Nat.add(r, Nat.double(S.KMath.pow2(0n))), add_double(r, S.KMath.pow2(0n)), h2))
        case False{}:
          (h1, not_le_lt(Nat.mul(Nat.add(r, S.KMath.pow2(0n)), Nat.add(r, S.KMath.pow2(0n))), n, e))
    case 1n+j:
      match ok:
        case True{}:
          isp(j, n, Nat.add(r, S.KMath.pow2(1n+j)), Nat.is_le(Nat.mul(Nat.add(Nat.add(r, S.KMath.pow2(1n+j)), S.KMath.pow2(j)), Nat.add(Nat.add(r, S.KMath.pow2(1n+j)), S.KMath.pow2(j))), n), {==}, e, lt_tr(n, Nat.add(Nat.add(r, S.KMath.pow2(1n+j)), S.KMath.pow2(1n+j)), Nat.add(r, Nat.double(S.KMath.pow2(1n+j))), add_double(r, S.KMath.pow2(1n+j)), h2))
        case False{}:
          isp(j, n, r, Nat.is_le(Nat.mul(Nat.add(r, S.KMath.pow2(j)), Nat.add(r, S.KMath.pow2(j))), n), {==}, h1, not_le_lt(Nat.mul(Nat.add(r, S.KMath.pow2(1n+j)), Nat.add(r, S.KMath.pow2(1n+j))), n, e))

def isq(+bits: Nat, +n: Nat, h: {Nat.is_lt(n, Nat.mul(S.KMath.pow2(bits), S.KMath.pow2(bits))) == True{} : Bool}) -> {Nat.is_le(Nat.mul(S.KMath.isqrt_nat(bits, n), S.KMath.isqrt_nat(bits, n)), n) == True{} : Bool} & {Nat.is_lt(n, Nat.mul(Nat.add(S.KMath.isqrt_nat(bits, n), 1n), Nat.add(S.KMath.isqrt_nat(bits, n), 1n))) == True{} : Bool}:
  match bits:
    case 0n:
      (le_zero_l(n), h)
    case 1n+k:
      isp(k, n, 0n, Nat.is_le(Nat.mul(Nat.add(0n, S.KMath.pow2(k)), Nat.add(0n, S.KMath.pow2(k))), n), {==}, le_zero_l(n), h)

def isq.fst(+bits: Nat, +n: Nat, p: {Nat.is_le(Nat.mul(S.KMath.isqrt_nat(bits, n), S.KMath.isqrt_nat(bits, n)), n) == True{} : Bool} & {Nat.is_lt(n, Nat.mul(Nat.add(S.KMath.isqrt_nat(bits, n), 1n), Nat.add(S.KMath.isqrt_nat(bits, n), 1n))) == True{} : Bool}) -> {Nat.is_le(Nat.mul(S.KMath.isqrt_nat(bits, n), S.KMath.isqrt_nat(bits, n)), n) == True{} : Bool}:
  (a, b) = p
  a

def isq.snd(+bits: Nat, +n: Nat, p: {Nat.is_le(Nat.mul(S.KMath.isqrt_nat(bits, n), S.KMath.isqrt_nat(bits, n)), n) == True{} : Bool} & {Nat.is_lt(n, Nat.mul(Nat.add(S.KMath.isqrt_nat(bits, n), 1n), Nat.add(S.KMath.isqrt_nat(bits, n), 1n))) == True{} : Bool}) -> {Nat.is_lt(n, Nat.mul(Nat.add(S.KMath.isqrt_nat(bits, n), 1n), Nat.add(S.KMath.isqrt_nat(bits, n), 1n))) == True{} : Bool}:
  (a, b) = p
  b

def bdisc2(+b: Bool) -> Type:
  match b:
    case True{}:
      Empty
    case False{}:
      Unit

def ft_absurd(+e: {False{} == True{} : Bool}) -> Empty:
  %e : bdisc2(_)
  Unit{}

def dbl_lt1(+x: Nat, +y: Nat, h: {Nat.is_lt(x, y) == True{} : Bool}) -> {Nat.is_lt(1n+Nat.double(x), Nat.double(y)) == True{} : Bool}:
  match x y:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(1n+Nat.double(0n), Nat.double(0n)) == True{} : Bool}, ft_absurd(h))
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(1n+Nat.double(1n+p), Nat.double(0n)) == True{} : Bool}, ft_absurd(h))
    case 1n+p 1n+q:
      dbl_lt1(p, q, h)

def dbl_lt0(+x: Nat, +y: Nat, h: {Nat.is_lt(x, y) == True{} : Bool}) -> {Nat.is_lt(Nat.double(x), Nat.double(y)) == True{} : Bool}:
  match x y:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(Nat.double(0n), Nat.double(0n)) == True{} : Bool}, ft_absurd(h))
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(Nat.double(1n+p), Nat.double(0n)) == True{} : Bool}, ft_absurd(h))
    case 1n+p 1n+q:
      dbl_lt0(p, q, h)

def tn_lt(+k: Nat, +w: Word(k)) -> {Nat.is_lt(Word.to_nat(k, w), S.KMath.pow2(k)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      match w:
        case WCon{+b, +t}:
          match b:
            case False{}:
              dbl_lt0(Word.to_nat(p, t), S.KMath.pow2(p), tn_lt(p, t))
            case True{}:
              dbl_lt1(Word.to_nat(p, t), S.KMath.pow2(p), tn_lt(p, t))

def pow2_add(+a: Nat, +b: Nat) -> {S.KMath.pow2(Nat.add(a, b)) == Nat.mul(S.KMath.pow2(a), S.KMath.pow2(b)) : Nat}:
  match a:
    case 0n:
      Equal.sym(Nat, Nat.mul(1n, S.KMath.pow2(b)), S.KMath.pow2(b), UL.nat_one_mul(S.KMath.pow2(b)))
    case 1n+p:
      Equal.trans(Nat, Nat.double(S.KMath.pow2(Nat.add(p, b))), Nat.double(Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b))), Nat.mul(Nat.double(S.KMath.pow2(p)), S.KMath.pow2(b)), Equal.cong(Nat, Nat, z => Nat.double(z), S.KMath.pow2(Nat.add(p, b)), Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b)), pow2_add(p, b)), Equal.trans(Nat, Nat.double(Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b))), Nat.add(Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b)), Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b))), Nat.mul(Nat.double(S.KMath.pow2(p)), S.KMath.pow2(b)), UL.nat_double(Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b))), Equal.trans(Nat, Nat.add(Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b)), Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b))), Nat.mul(Nat.add(S.KMath.pow2(p), S.KMath.pow2(p)), S.KMath.pow2(b)), Nat.mul(Nat.double(S.KMath.pow2(p)), S.KMath.pow2(b)), Equal.sym(Nat, Nat.mul(Nat.add(S.KMath.pow2(p), S.KMath.pow2(p)), S.KMath.pow2(b)), Nat.add(Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b)), Nat.mul(S.KMath.pow2(p), S.KMath.pow2(b))), UL.nat_add_mul(S.KMath.pow2(p), S.KMath.pow2(p), S.KMath.pow2(b))), Equal.cong(Nat, Nat, z => Nat.mul(z, S.KMath.pow2(b)), Nat.add(S.KMath.pow2(p), S.KMath.pow2(p)), Nat.double(S.KMath.pow2(p)), Equal.sym(Nat, Nat.double(S.KMath.pow2(p)), Nat.add(S.KMath.pow2(p), S.KMath.pow2(p)), UL.nat_double(S.KMath.pow2(p)))))))

def u32_bound(+n: U32) -> {Nat.is_lt(U32.to_nat(n), Nat.mul(S.KMath.pow2(16n), S.KMath.pow2(16n))) == True{} : Bool}:
  match n:
    case U32{+w}:
      Equal.trans(Bool, Nat.is_lt(U32.to_nat(U32{w}), Nat.mul(S.KMath.pow2(16n), S.KMath.pow2(16n))), Nat.is_lt(Word.to_nat(Nat.add(16n, 16n), w), Nat.mul(S.KMath.pow2(16n), S.KMath.pow2(16n))), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(z, Nat.mul(S.KMath.pow2(16n), S.KMath.pow2(16n))), U32.to_nat(U32{w}), Word.to_nat(Nat.add(16n, 16n), w), {==}), Equal.trans(Bool, Nat.is_lt(Word.to_nat(Nat.add(16n, 16n), w), Nat.mul(S.KMath.pow2(16n), S.KMath.pow2(16n))), Nat.is_lt(Word.to_nat(Nat.add(16n, 16n), w), S.KMath.pow2(Nat.add(16n, 16n))), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(Word.to_nat(Nat.add(16n, 16n), w), z), Nat.mul(S.KMath.pow2(16n), S.KMath.pow2(16n)), S.KMath.pow2(Nat.add(16n, 16n)), Equal.sym(Nat, S.KMath.pow2(Nat.add(16n, 16n)), Nat.mul(S.KMath.pow2(16n), S.KMath.pow2(16n)), pow2_add(16n, 16n))), tn_lt(Nat.add(16n, 16n), w)))

def Laws.isqrt_u32_le(n):
  isq.fst(16n, U32.to_nat(n), isq(16n, U32.to_nat(n), u32_bound(n)))

def Laws.isqrt_u32_lt(n):
  isq.snd(16n, U32.to_nat(n), isq(16n, U32.to_nat(n), u32_bound(n)))

def Laws.isqrt_nat_le(bits, n, h):
  isq.fst(bits, n, isq(bits, n, h))

def Laws.isqrt_nat_lt(bits, n, h):
  isq.snd(bits, n, isq(bits, n, h))

