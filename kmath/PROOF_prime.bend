      kp.le_trans(2n, 4n, U32.to_nat(n), {==}, kp.nlt_le(U32.to_nat(n), 4n, Equal.trans(Bool, Nat.is_lt(U32.to_nat(n), 4n), U32.is_lt(n, 4), False{}, Equal.sym(Bool, U32.is_lt(n, 4), Nat.is_lt(U32.to_nat(n), 4n), UL.u32_lt_value(n, 4)), Equal.sym(Bool, False{}, U32.is_lt(n, 4), es))))

def Laws.prime_ge2(n, h):
  kp.ge(U32.is_lt(n, 4), U32.is_eq(U32.and(n, 1), 0), n, {==}, {==}, h)

# prime_no_divisor: a divisor m of n, odd, with 3 <= m and m^2 <= n, makes
# the loop answer False

