# Streebog (GOST R 34.11-2012; RFC 6986, V. Dolmatov and A. Degtyarev,
# "GOST R 34.11-2012: Hash Function", 2013): 256- and 512-bit digests of
# 64-byte blocks. The compression function (section 8)
#   g_N(h, m) = E(LPS(h xor N), m) xor h xor m,
#   E(K, m) = X[K_13] LPS X[K_12] ... LPS X[K_1](m), K_1 = K,
#   K_(i+1) = LPS(K_i xor C_i),
# where N counts the bits hashed so far; the hash (section 9) feeds the
# message 512 bits at a time, keeping N and the sum Sigma of the blocks
# modulo 2^512, then pads the last (short, possibly empty) block with a 1
# bit and zeros, and finishes with g_0(h, N) and g_0(h, Sigma). Streebog-256
# starts from h = (00000001)^64 and keeps the most significant 256 bits.
#
# Byte order: RFC 6986 writes a 512-bit vector a_63 || ... || a_0; byte i of
# a 64-byte string in memory is a_i (its examples print messages and digests
# most significant byte first, the reverse of memory order). A 512-bit
# vector here is an Hs.HsW16 of sixteen 32-bit words, least significant
# first (word i holds bytes 4i .. 4i+3, little-endian), and a digest is the
# bytes in memory order: a_0 first. The 512-bit sums use 32-bit words with
# carries.
#
# LPS runs on eight tables of 64-bit entries (each T_j[b] = l(Pi(b) << 8j);
# gen/streebog.py writes them from RFC 6986's Pi', tau and A, and checks
# them against S, P and L applied one after the other). The tables are part
# of the chaining value (built once by init), so a lookup is a walk down a
# tree of depth 8.
#
# The hashes, as the crypto package's hash interface takes them:
#   ~Hs.HsMdState<HsStbCv>, ~64n, ~32n, ~HsStreebog.init256(),
#   ~HsStreebog.update, ~HsStreebog.final256, ~HsStreebog.digest256
#   ~Hs.HsMdState<HsStbCv>, ~64n, ~64n, ~HsStreebog.init512(),
#   ~HsStreebog.update, ~HsStreebog.final512, ~HsStreebog.digest512
import Base
import ../bytes/bytes.bend as B
import ./hashes.bend as Hs

# A table of 256 64-bit entries, as a tree on the index's bits (opaque)
type HsStbTab is Data:
  HsStbLeaf{v: Hs.HsW2}
  HsStbNode{l: HsStbTab, r: HsStbTab}

# The eight LPS tables (opaque)
type HsStbTabs is Data:
  HsStbTabs{t0: HsStbTab, t1: HsStbTab, t2: HsStbTab, t3: HsStbTab, t4: HsStbTab, t5: HsStbTab, t6: HsStbTab, t7: HsStbTab}

# The chaining value (opaque): h, N, Sigma, and the tables
type HsStbCv is Data:
  HsStbCv{h: Hs.HsW16, n: Hs.HsW16, s: Hs.HsW16, t: HsStbTabs}

def hs.stb.leaves(xs: List<&2, Hs.HsW2>) -> List<&2, HsStbTab>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{HsStbLeaf{h}, hs.stb.leaves(t)}

def hs.stb.pairs(ts: List<&2, HsStbTab>) -> List<&2, HsStbTab>:
  match ts:
    case Con{a, Con{b, t}}:
      Con{HsStbNode{a, b}, hs.stb.pairs(t)}
    case _:
      Nil{}

def hs.stb.up(n: Nat, ts: List<&2, HsStbTab>) -> List<&2, HsStbTab>:
  match n:
    case 0n:
      ts
    case 1n+p:
      hs.stb.up(p, hs.stb.pairs(ts))

def hs.stb.root(ts: List<&2, HsStbTab>) -> HsStbTab:
  match ts:
    case Nil{}:
      HsStbLeaf{Hs.HsW2{0, 0}}
    case Con{h, t}:
      h

# the table of 256 entries (entry i is element i)
def hs.stb.tab(xs: List<&2, Hs.HsW2>) -> HsStbTab:
  hs.stb.root(hs.stb.up(8n, hs.stb.leaves(xs)))

def hs.stb.pick(one: Bool, l: HsStbTab, r: HsStbTab) -> HsStbTab:
  match one:
    case True{}:
      r
    case False{}:
      l

def hs.stb.get.go(d: Nat, t: HsStbTab, +i: U32) -> Hs.HsW2:
  match d:
    case 0n:
      match t:
        case HsStbLeaf{v}:
          v
        case HsStbNode{l, r}:
          Hs.HsW2{0, 0}
    case 1n+(+p):
      match t:
        case HsStbLeaf{v}:
          v
        case HsStbNode{l, r}:
          hs.stb.get.go(p, hs.stb.pick(U32.is_eq(U32.and(1, U32.shrn(i, p)), 1), l, r), i)

# entry i (a byte) of a table
def hs.stb.get(t: HsStbTab, +i: U32) -> Hs.HsW2:
  hs.stb.get.go(8n, t, i)

# the XOR of eight 64-bit values
def hs.stb.x8(e0: Hs.HsW2, e1: Hs.HsW2, e2: Hs.HsW2, e3: Hs.HsW2, e4: Hs.HsW2, e5: Hs.HsW2, e6: Hs.HsW2, e7: Hs.HsW2) -> Hs.HsW2:
  match e0 e1 e2 e3 e4 e5 e6 e7:
    case Hs.HsW2{a0, b0} Hs.HsW2{a1, b1} Hs.HsW2{a2, b2} Hs.HsW2{a3, b3} Hs.HsW2{a4, b4} Hs.HsW2{a5, b5} Hs.HsW2{a6, b6} Hs.HsW2{a7, b7}:
      Hs.HsW2{U32.xor(U32.xor(U32.xor(a0, a1), U32.xor(a2, a3)), U32.xor(U32.xor(a4, a5), U32.xor(a6, a7))), U32.xor(U32.xor(U32.xor(b0, b1), U32.xor(b2, b3)), U32.xor(U32.xor(b4, b5), U32.xor(b6, b7)))}

# eight 64-bit chunks as a 512-bit vector, chunk 0 the least significant
def hs.stb.join(o0: Hs.HsW2, o1: Hs.HsW2, o2: Hs.HsW2, o3: Hs.HsW2, o4: Hs.HsW2, o5: Hs.HsW2, o6: Hs.HsW2, o7: Hs.HsW2) -> Hs.HsW16:
  match o0 o1 o2 o3 o4 o5 o6 o7:
    case Hs.HsW2{a0, a1} Hs.HsW2{a2, a3} Hs.HsW2{a4, a5} Hs.HsW2{a6, a7} Hs.HsW2{a8, a9} Hs.HsW2{a10, a11} Hs.HsW2{a12, a13} Hs.HsW2{a14, a15}:
      Hs.HsW16{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15}

