# the permutations P0 and P1
def hs.sm3.p0(+x: U32) -> U32:
  U32.xor(U32.xor(x, Hs.hs.rotl(x, 9n)), Hs.hs.rotl(x, 17n))

def hs.sm3.p1(+x: U32) -> U32:
  U32.xor(U32.xor(x, Hs.hs.rotl(x, 15n)), Hs.hs.rotl(x, 23n))

# the boolean functions FF_j and GG_j: for rounds 0 to 15, and 16 to 63
def hs.sm3.ff0(x: U32, y: U32, z: U32) -> U32:
  U32.xor(U32.xor(x, y), z)

def hs.sm3.ff1(+x: U32, +y: U32, +z: U32) -> U32:
  U32.or(U32.or(U32.and(x, y), U32.and(x, z)), U32.and(y, z))

def hs.sm3.gg0(x: U32, y: U32, z: U32) -> U32:
  U32.xor(U32.xor(x, y), z)

def hs.sm3.gg1(+x: U32, y: U32, z: U32) -> U32:
  U32.or(U32.and(x, y), U32.and(U32.not(x), z))

