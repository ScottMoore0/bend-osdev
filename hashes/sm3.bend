# The chaining value before any block (IV)
def HsSm3.iv() -> Hs.HsW8:
  Hs.HsW8{1937774191, 1226093241, 388252375, 3666478592, 2842636476, 372324522, 3817729613, 2969243214}

# One 64-byte block (a list of another length is read as zero words: the
# engine passes only whole blocks)
def HsSm3.compress(cv: Hs.HsW8, blk: List<&2, U32>) -> Hs.HsW8:
  hs.sm3.rounds(Hs.hs.block.be(blk), cv)

def HsSm3.init() -> Hs.HsMdState<Hs.HsW8>:
  Hs.HsMd.start(~Hs.HsW8, HsSm3.iv())

def HsSm3.update(s: Hs.HsMdState<Hs.HsW8>, o: B.Octets) -> Hs.HsMdState<Hs.HsW8>:
  Hs.HsMd.update(~Hs.HsW8, ~HsSm3.compress, ~63, s, o)

# the digest of the bytes so far: the padding, then the eight words
# big-endian
def HsSm3.final(s: Hs.HsMdState<Hs.HsW8>) -> B.Octets:
  Hs.HsMd.final_md(~Hs.HsW8, ~HsSm3.compress, ~63, ~Hs.hs.len.be, ~Hs.HsW8.be, s)

# The digest in one call
def HsSm3.digest(o: B.Octets) -> B.Octets:
  HsSm3.final(HsSm3.update(HsSm3.init(), o))
