# The chaining value before any block (section 5.3.1)
def HsSha1.iv() -> Hs.HsW5:
  Hs.HsW5{1732584193, 4023233417, 2562383102, 271733878, 3285377520}

# One 64-byte block (a list of another length is read as zero words: the
# engine passes only whole blocks)
def HsSha1.compress(cv: Hs.HsW5, blk: List<&2, U32>) -> Hs.HsW5:
  hs.sha1.rounds(Hs.hs.block.be(blk), cv)

def HsSha1.init() -> Hs.HsMdState<Hs.HsW5>:
  Hs.HsMd.start(~Hs.HsW5, HsSha1.iv())

def HsSha1.update(s: Hs.HsMdState<Hs.HsW5>, o: B.Octets) -> Hs.HsMdState<Hs.HsW5>:
  Hs.HsMd.update(~Hs.HsW5, ~HsSha1.compress, ~63, s, o)

# the digest of the bytes so far: the padding of section 5.1.1, then the
# five words big-endian
def HsSha1.final(s: Hs.HsMdState<Hs.HsW5>) -> B.Octets:
  Hs.HsMd.final_md(~Hs.HsW5, ~HsSha1.compress, ~63, ~Hs.hs.len.be, ~Hs.HsW5.be, s)

# The digest in one call
def HsSha1.digest(o: B.Octets) -> B.Octets:
  HsSha1.final(HsSha1.update(HsSha1.init(), o))
