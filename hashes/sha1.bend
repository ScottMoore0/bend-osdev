# the functions of section 4.1.1: Ch (steps 0 to 19), Parity (20 to 39 and
# 60 to 79), Maj (40 to 59)
def hs.sha1.ch(+x: U32, y: U32, z: U32) -> U32:
  U32.xor(U32.and(x, y), U32.and(U32.not(x), z))

def hs.sha1.parity(x: U32, y: U32, z: U32) -> U32:
  U32.xor(U32.xor(x, y), z)

def hs.sha1.maj(+x: U32, +y: U32, +z: U32) -> U32:
  U32.xor(U32.xor(U32.and(x, y), U32.and(x, z)), U32.and(y, z))

