# The chaining value before any block (section 3.3)
def HsMd4.iv() -> Hs.HsW4:
  Hs.HsW4{1732584193, 4023233417, 2562383102, 271733878}

# One 64-byte block (a list of another length is read as zero words: the
# engine passes only whole blocks)
def HsMd4.compress(cv: Hs.HsW4, blk: List<&2, U32>) -> Hs.HsW4:
  hs.md4.rounds(Hs.hs.block.le(blk), cv)

def HsMd4.init() -> Hs.HsMdState<Hs.HsW4>:
  Hs.HsMd.start(~Hs.HsW4, HsMd4.iv())

def HsMd4.update(s: Hs.HsMdState<Hs.HsW4>, o: B.Octets) -> Hs.HsMdState<Hs.HsW4>:
  Hs.HsMd.update(~Hs.HsW4, ~HsMd4.compress, ~63, s, o)

# the digest of the bytes so far: the padding and the length, then the four
# words little-endian
def HsMd4.final(s: Hs.HsMdState<Hs.HsW4>) -> B.Octets:
  Hs.HsMd.final_md(~Hs.HsW4, ~HsMd4.compress, ~63, ~Hs.hs.len.le, ~Hs.HsW4.le, s)

# The digest in one call
def HsMd4.digest(o: B.Octets) -> B.Octets:
  HsMd4.final(HsMd4.update(HsMd4.init(), o))
