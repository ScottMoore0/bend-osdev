# MD4 (RFC 1320, R. Rivest, "The MD4 Message-Digest Algorithm", 1992): a
# 128-bit digest of 64-byte blocks, three rounds of sixteen steps each (the
# step order, shifts and constants of section 3.4, unrolled by
# gen/rounds.py). Little-endian words; the length in bits is padded in
# little-endian. MD4 is broken (collisions are found by hand): it is here
# to read what already uses it (NTLM, rsync's older protocols).
#
# The hash, as the crypto package's hash interface takes it:
#   ~Hs.HsMdState<Hs.HsW4>, ~64n, ~16n, ~HsMd4.init(), ~HsMd4.update,
#   ~HsMd4.final, ~HsMd4.digest
import Base
import ../bytes/bytes.bend as B
import ./hashes.bend as Hs

# the round functions F (round 1), G (round 2) and H (round 3)
def hs.md4.f(+x: U32, y: U32, z: U32) -> U32:
  U32.or(U32.and(x, y), U32.and(U32.not(x), z))

def hs.md4.g(+x: U32, +y: U32, +z: U32) -> U32:
  U32.or(U32.or(U32.and(x, y), U32.and(x, z)), U32.and(y, z))

def hs.md4.h(x: U32, y: U32, z: U32) -> U32:
  U32.xor(U32.xor(x, y), z)

# one step: (a + f + X[k] + K) <<< s
def hs.md4.step(a: U32, f: U32, x: U32, k: U32, +s: Nat) -> U32:
  Hs.hs.rotl(U32.add(U32.add(a, f), U32.add(x, k)), s)

