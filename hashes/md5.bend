# MD5 (RFC 1321, R. Rivest, "The MD5 Message-Digest Algorithm", 1992): a
# 128-bit digest of 64-byte blocks, four rounds of sixteen steps (the table
# T[i] = floor(2^32 abs(sin i)), the shifts and the word order of section
# 3.4, unrolled by gen/rounds.py). Little-endian words; the length in bits
# is padded in little-endian. MD5 is broken for collisions: use it for
# checksums and the formats that require it, not for security.
#
# The hash, as the crypto package's hash interface takes it:
#   ~Hs.HsMdState<Hs.HsW4>, ~64n, ~16n, ~HsMd5.init(), ~HsMd5.update,
#   ~HsMd5.final, ~HsMd5.digest
import Base
import ../bytes/bytes.bend as B
import ./hashes.bend as Hs

# the auxiliary functions F, G, H and I (section 3.4)
def hs.md5.f(+x: U32, y: U32, z: U32) -> U32:
  U32.or(U32.and(x, y), U32.and(U32.not(x), z))

def hs.md5.g(x: U32, y: U32, +z: U32) -> U32:
  U32.or(U32.and(x, z), U32.and(y, U32.not(z)))

def hs.md5.h(x: U32, y: U32, z: U32) -> U32:
  U32.xor(U32.xor(x, y), z)

def hs.md5.i(x: U32, y: U32, z: U32) -> U32:
  U32.xor(y, U32.or(x, U32.not(z)))

# one step: b + ((a + f + X[k] + T[i]) <<< s)
def hs.md5.step(a: U32, b: U32, f: U32, x: U32, t: U32, +s: Nat) -> U32:
  U32.add(b, Hs.hs.rotl(U32.add(U32.add(a, f), U32.add(x, t)), s))

