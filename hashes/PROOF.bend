  %Laws.sm3_streaming(SM.HsSm3.init(), a, B.Octets.append(b, c)) : {SM.HsSm3.final(_) == SM.HsSm3.digest(B.Octets.append(a, B.Octets.append(b, c))) : B.Octets}
  {==}

def Laws.sm3_length(s):
  w8be_len(Hs.HsMd.cv(~Hs.HsW8, Hs.hs.md.feed(~Hs.HsW8, ~SM.HsSm3.compress, ~63, Hs.HsMd.md_pad(~63, Hs.HsMd.count(~Hs.HsW8, s), Hs.hs.len.be(Hs.HsMd.bits(~Hs.HsW8, ~63, s))), s)))

def Laws.sm3_digest_length(m):
  Laws.sm3_length(SM.HsSm3.update(SM.HsSm3.init(), m))

