  w2le_len(Hs.HsMd.cv(~Hs.HsW2, Hs.HsMd.update_list(~Hs.HsW2, ~MI.HsMichael.compress, ~3, s, MI.hs.michael.pad(Hs.HsMd.count(~Hs.HsW2, s)))))

def Laws.michael_mic_length(k, m):
  Laws.michael_length(MI.HsMichael.update(MI.HsMichael.init(k), m))

