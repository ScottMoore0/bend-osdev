# The chaining value before any block
def HsRipemd160.iv() -> Hs.HsW5:
  Hs.HsW5{1732584193, 4023233417, 2562383102, 271733878, 3285377520}

# One 64-byte block (a list of another length is read as zero words: the
# engine passes only whole blocks)
def HsRipemd160.compress(cv: Hs.HsW5, blk: List<&2, U32>) -> Hs.HsW5:
  hs.ripemd160.rounds(Hs.hs.block.le(blk), cv)

def HsRipemd160.init() -> Hs.HsMdState<Hs.HsW5>:
  Hs.HsMd.start(~Hs.HsW5, HsRipemd160.iv())

def HsRipemd160.update(s: Hs.HsMdState<Hs.HsW5>, o: B.Octets) -> Hs.HsMdState<Hs.HsW5>:
  Hs.HsMd.update(~Hs.HsW5, ~HsRipemd160.compress, ~63, s, o)

# the digest of the bytes so far: MD4's padding, then the five words
# little-endian
def HsRipemd160.final(s: Hs.HsMdState<Hs.HsW5>) -> B.Octets:
  Hs.HsMd.final_md(~Hs.HsW5, ~HsRipemd160.compress, ~63, ~Hs.hs.len.le, ~Hs.HsW5.le, s)

# The digest in one call
def HsRipemd160.digest(o: B.Octets) -> B.Octets:
  HsRipemd160.final(HsRipemd160.update(HsRipemd160.init(), o))
