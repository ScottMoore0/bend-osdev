# RIPEMD-160 (H. Dobbertin, A. Bosselaers and B. Preneel, "RIPEMD-160: A
# Strengthened Version of RIPEMD", Fast Software Encryption 1996, LNCS
# 1039, pp. 71-82, and its pseudo-code appendix): a 160-bit digest of
# 64-byte blocks, two parallel lines of five rounds of sixteen steps each,
# combined at the end (the word orders r and r', rotations s and s' and
# constants K and K' of the paper, unrolled by gen/rounds.py).
# Little-endian words and length, as MD4.
#
# The hash, as the crypto package's hash interface takes it:
#   ~Hs.HsMdState<Hs.HsW5>, ~64n, ~20n, ~HsRipemd160.init(),
#   ~HsRipemd160.update, ~HsRipemd160.final, ~HsRipemd160.digest
import Base
import ../bytes/bytes.bend as B
import ./hashes.bend as Hs

# the functions f1 to f5 (the left line uses them in that order, the right
# line in the reverse order)
def hs.rmd.f1(x: U32, y: U32, z: U32) -> U32:
  U32.xor(U32.xor(x, y), z)

def hs.rmd.f2(+x: U32, y: U32, z: U32) -> U32:
  U32.or(U32.and(x, y), U32.and(U32.not(x), z))

def hs.rmd.f3(x: U32, y: U32, z: U32) -> U32:
  U32.xor(U32.or(x, U32.not(y)), z)

def hs.rmd.f4(x: U32, y: U32, +z: U32) -> U32:
  U32.or(U32.and(x, z), U32.and(y, U32.not(z)))

def hs.rmd.f5(x: U32, y: U32, z: U32) -> U32:
  U32.xor(x, U32.or(y, U32.not(z)))

# one step: ((a + f + X[r] + K) <<< s) + e
def hs.rmd.step(a: U32, f: U32, x: U32, k: U32, +s: Nat, e: U32) -> U32:
  U32.add(Hs.hs.rotl(U32.add(U32.add(a, f), U32.add(x, k)), s), e)

