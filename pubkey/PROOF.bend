# Result discriminator and injectivity, for CrError results

def pk_rdisc(-A: Data, +r: Result<&2, &2, Cr.CrError, A>) -> Type:
  match r:
    case Fail{x}:
      Unit
    case Done{x}:
      Empty

def pk_fd_absurd(-A: Data, -x: Cr.CrError, -y: A, +e: {Fail{x} == Done{y} : Result<&2, &2, Cr.CrError, A>}) -> Empty:
  %e : pk_rdisc(A, _)
  Unit{}

def pk_done_inj(-A: Data, +a: A, +b: A, +e: {Done{a} == Done{b} : Result<&2, &2, Cr.CrError, A>}) -> {a == b : A}:
  Equal.cong(Result<&2, &2, Cr.CrError, A>, A, x => Result.default(&2, &2, Cr.CrError, A, x, a), Done{a}, Done{b}, e)

def Laws.lift_pk_format(E, PK, f, d, t, r, p, h, hr):
  match r:
    case Fail{e}:
      Empty.absurd({Cr.CrError.lift(~E, ~PK, ~f, d(t(p))) == Done{p} : Result<&2, &2, Cr.CrError, PK>}, pk_fd_absurd(PK, f(e), p, h))
    case Done{q}:
      %pk_done_inj(PK, q, p, h) : {Cr.CrError.lift(~E, ~PK, ~f, d(t(_))) == Done{_} : Result<&2, &2, Cr.CrError, PK>}
      %Equal.sym(Result<&2, &2, E, PK>, d(t(q)), Done{q}, hr) : {Cr.CrError.lift(~E, ~PK, ~f, _) == Done{q} : Result<&2, &2, Cr.CrError, PK>}
      {==}

