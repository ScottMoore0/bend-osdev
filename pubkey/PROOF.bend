  %Equal.sym(Result<&2, &2, Cr.CrError, NB.BnNat>, PE.PkEcdh.secret(~prm, a), Done{x}, hx) : {Kx.cr.kex.with(~NB.BnNat, ~EE.EcPoint, ~PE.PkEcdh.shared(~prm), _, PE.PkEcdh.pk_of(~prm, PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, y)))) == Kx.CrKex.agree(~NB.BnNat, ~EE.EcPoint, ~PE.PkEcdh.secret(~prm), ~PE.PkEcdh.pk_of(~prm), ~PE.PkEcdh.shared(~prm), b, PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, x))) : Result<&2, &2, Cr.CrError, B.Octets>}
