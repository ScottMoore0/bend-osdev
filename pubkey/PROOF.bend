  h

def Laws.ecdh_pk_format_if(prm, o, p, h, hr):
  Laws.lift_pk_format(~EE.EcError, ~EE.EcPoint, ~PE.PkEcc.err, x => PE.PkEcdh.point_of(~prm, x), q => PE.PkEcdh.pk_to(~prm, q), PE.PkEcdh.point_of(~prm, o), p, h, hr)

def Laws.dh_pk_format_if(grp, o, p, h, hr):
  Laws.lift_pk_format(~DD.DhError, ~NB.BnNat, ~PD.PkDh.err, x => PD.PkDh.public_of(~grp, x), q => PD.PkDh.pk_to(~grp, q), PD.PkDh.public_of(~grp, o), p, h, hr)
