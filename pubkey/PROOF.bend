def Laws.dh_agree_if(grp, a, b, x, y, hx, hy, hfx, hfy, h):
  %Equal.sym(Result<&2, &2, Cr.CrError, NB.BnNat>, PD.PkDh.secret(~grp, a), Done{x}, hx) : {Kx.cr.kex.with(~NB.BnNat, ~NB.BnNat, ~PD.PkDh.shared(~grp), _, PD.PkDh.pk_of(~grp, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, y)))) == Kx.CrKex.agree(~NB.BnNat, ~NB.BnNat, ~PD.PkDh.secret(~grp), ~PD.PkDh.pk_of(~grp), ~PD.PkDh.shared(~grp), b, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, x))) : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Result<&2, &2, Cr.CrError, NB.BnNat>, PD.PkDh.pk_of(~grp, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, y))), Done{PD.PkDh.public(~grp, y)}, hfy) : {Kx.cr.kex.with(~NB.BnNat, ~NB.BnNat, ~PD.PkDh.shared(~grp), Done{x}, _) == Kx.CrKex.agree(~NB.BnNat, ~NB.BnNat, ~PD.PkDh.secret(~grp), ~PD.PkDh.pk_of(~grp), ~PD.PkDh.shared(~grp), b, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, x))) : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Result<&2, &2, Cr.CrError, NB.BnNat>, PD.PkDh.secret(~grp, b), Done{y}, hy) : {PD.PkDh.shared(~grp, x, PD.PkDh.public(~grp, y)) == Kx.cr.kex.with(~NB.BnNat, ~NB.BnNat, ~PD.PkDh.shared(~grp), _, PD.PkDh.pk_of(~grp, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, x)))) : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Result<&2, &2, Cr.CrError, NB.BnNat>, PD.PkDh.pk_of(~grp, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, x))), Done{PD.PkDh.public(~grp, x)}, hfx) : {PD.PkDh.shared(~grp, x, PD.PkDh.public(~grp, y)) == Kx.cr.kex.with(~NB.BnNat, ~NB.BnNat, ~PD.PkDh.shared(~grp), Done{y}, _) : Result<&2, &2, Cr.CrError, B.Octets>}
  h

