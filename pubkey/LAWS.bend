# The laws of pubkey: crypto's signature and key-agreement laws for each
# instance (generated by gen/instances.py, with their proofs).
#
# Each is conditional on what is number theory, not proved here: that the
# scheme accepts its own signatures for every key (RSA, ECDSA, SM2, EC-RDSA)
# and that both parties compute the same shared secret (DH, ECDH). Those
# hold for the algorithm packages' toy parameters by exhaustive laws
# (rsa's toy_round_trip, ecc's toy_ecdsa and toy_ecdh, dh's toy_agree, sm2's
# and ecrdsa's toy_sign_verify), and are tested on the named instances by
# check.bend and ref/run.sh (against Python's cryptography). A public key
# that survives its bytes is a hypothesis of the sign and agree laws; for
# ECDH's form (ECDSA, SM2, ECDH), GOST's (RFC 4491) and DH's, it follows
# from the packages' own format laws (the pk_format_if laws below, from
# lift_pk_format), and for RSA's from rsa's conditional one
# (rsa_pk_format_if).
import Base
import ../bytes/bytes.bend as B
import ../bignum/bignum.bend as NB
import ../ecc/ecc.bend as EE
import ../dh/dh.bend as DD
import ../ecrdsa/ecrdsa.bend as GG
import ../rsa/rsa.bend as RR
import ../rsa/keys.bend as RK
import ../crypto/crypto.bend as Cr
import ../crypto/sign.bend as Sg
import ../crypto/kex.bend as Kx
import ./rsa.bend as PR
import ./dh.bend as PD
import ./ecc.bend as PE
import ./sm2.bend as PS
import ./ecrdsa.bend as PG

# A public-key reader survives the mapping of its errors onto CrError, for
# every reader d, writer t and error mapping f: a key p read from bytes (r,
# their reading by d) is read again from t(p) when every key read from those
# bytes is read again from the bytes written for it (hr: the key format's
# round trip, at those bytes)
law lift_pk_format:
  for ~E: Data
  for ~PK: Data
  for ~f: E -> Cr.CrError
  for d: B.Octets -> Result<&2, &2, E, PK>
  for t: PK -> B.Octets
  for r: Result<&2, &2, E, PK>
  for +p: PK
  for h: {Cr.CrError.lift(~E, ~PK, ~f, r) == Done{p} : Result<&2, &2, Cr.CrError, PK>}
  for hr: {Result.bind(&2, &2, E, PK, PK, r, q => d(t(q))) == r : Result<&2, &2, E, PK>}
  {Cr.CrError.lift(~E, ~PK, ~f, d(t(p))) == Done{p} : Result<&2, &2, Cr.CrError, PK>}

# RSA's public keys (rsa's raw form, keys.bend): a checked key (hk: Rsa.public_of
# accepts its integers) is read back from the bytes written for it, given
# rsa's public_form_round_trip_if (rsa/LAWS.bend) at its integers (hr). Not
# of lift_pk_format's shape: rsa's form reads back a key read from any bytes
# only up to the representation of its integers (rsa README.md, Laws)
law rsa_pk_format_if:
  for +n: NB.BnNat
  for +e: NB.BnNat
  for hk: {RR.Rsa.public_of(n, e) == Done{RR.RsaPublic{n, e}} : Result<&2, &2, RR.RsaError, RR.RsaPublic>}
  for hr: {RK.RsaKeys.public_of(RK.RsaKeys.public_to(RR.RsaPublic{n, e})) == RR.Rsa.public_of(n, e) : Result<&2, &2, RR.RsaError, RR.RsaPublic>}
  {PR.PkRsa.pk_of(RK.RsaKeys.public_to(RR.RsaPublic{n, e})) == Done{RR.RsaPublic{n, e}} : Result<&2, &2, Cr.CrError, RR.RsaPublic>}

# The instances

# BEGIN GENERATED by gen/instances.py: laws
# RSASSA-PKCS1-v1_5, for every hash and DigestInfo prefix (crypto's
# sign_verify_bytes_if): a signature checked from the public key's bytes is
# accepted, for every key and message, when the public key survives its bytes
# (hf) and the scheme accepts the signature (ha)
law rsa_pkcs1_verify_bytes_if:
  for ~digest: B.Octets -> B.Octets
  for ~prefix: B.Octets
  for +sk: RR.RsaPrivate
  for +m: B.Octets
  for hf: {PR.PkRsa.pk_of(RK.RsaKeys.public_to(RR.Rsa.public(sk))) == Done{RR.Rsa.public(sk)} : Result<&2, &2, Cr.CrError, RR.RsaPublic>}
  for ha: {PR.PkRsa.pkcs1_verify(~digest, ~prefix, RR.Rsa.public(sk), m, PR.PkRsa.pkcs1_sign(~digest, ~prefix, sk, m)) == True{} : Bool}
  {Sg.CrSign.verify_bytes(~RR.RsaPublic, ~PR.PkRsa.pk_of, ~PR.PkRsa.pkcs1_verify(~digest, ~prefix), RK.RsaKeys.public_to(RR.Rsa.public(sk)), m, PR.PkRsa.pkcs1_sign(~digest, ~prefix, sk, m)) == True{} : Bool}

# RSASSA-PSS, for every hash (MGF1 over it) and salt length (crypto's
# sign_verify_bytes_if): a signature checked from the public key's bytes is
# accepted, for every key and message, when the public key survives its bytes
# (hf) and the scheme accepts the signature (ha)
law rsa_pss_verify_bytes_if:
  for ~digest: B.Octets -> B.Octets
  for ~slen: Nat
  for +sk: RR.RsaPrivate
  for +m: B.Octets
  for hf: {PR.PkRsa.pk_of(RK.RsaKeys.public_to(RR.Rsa.public(sk))) == Done{RR.Rsa.public(sk)} : Result<&2, &2, Cr.CrError, RR.RsaPublic>}
  for ha: {PR.PkRsa.pss_verify(~digest, ~slen, RR.Rsa.public(sk), m, PR.PkRsa.pss_sign(~digest, ~slen, sk, m)) == True{} : Bool}
  {Sg.CrSign.verify_bytes(~RR.RsaPublic, ~PR.PkRsa.pk_of, ~PR.PkRsa.pss_verify(~digest, ~slen), RK.RsaKeys.public_to(RR.Rsa.public(sk)), m, PR.PkRsa.pss_sign(~digest, ~slen, sk, m)) == True{} : Bool}

# ECDSA, for every curve, hash and MAC (RFC 6979's k) (crypto's
# sign_verify_bytes_if): a signature checked from the public key's bytes is
# accepted, for every key and message, when the public key survives its bytes
# (hf) and the scheme accepts the signature (ha)
law ecdsa_verify_bytes_if:
  for ~prm: EE.EcParams
  for ~digest: B.Octets -> B.Octets
  for ~mac: B.Octets -> B.Octets -> B.Octets
  for +sk: NB.BnNat
  for +m: B.Octets
  for hf: {PE.PkEcdh.pk_of(~prm, PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, sk))) == Done{PE.PkEcdh.public(~prm, sk)} : Result<&2, &2, Cr.CrError, EE.EcPoint>}
  for ha: {PE.PkEcdsa.verify(~prm, ~digest, PE.PkEcdh.public(~prm, sk), m, PE.PkEcdsa.sign(~prm, ~digest, ~mac, sk, m)) == True{} : Bool}
  {Sg.CrSign.verify_bytes(~EE.EcPoint, ~PE.PkEcdh.pk_of(~prm), ~PE.PkEcdsa.verify(~prm, ~digest), PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, sk)), m, PE.PkEcdsa.sign(~prm, ~digest, ~mac, sk, m)) == True{} : Bool}

# SM2, for every curve, hash, MAC (RFC 6979's k) and identity (crypto's
# sign_verify_bytes_if): a signature checked from the public key's bytes is
# accepted, for every key and message, when the public key survives its bytes
# (hf) and the scheme accepts the signature (ha)
law sm2_verify_bytes_if:
  for ~prm: EE.EcParams
  for ~digest: B.Octets -> B.Octets
  for ~mac: B.Octets -> B.Octets -> B.Octets
  for ~id: B.Octets
  for +sk: NB.BnNat
  for +m: B.Octets
  for hf: {PE.PkEcdh.pk_of(~prm, PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, sk))) == Done{PE.PkEcdh.public(~prm, sk)} : Result<&2, &2, Cr.CrError, EE.EcPoint>}
  for ha: {PS.PkSm2.verify(~prm, ~digest, ~id, PE.PkEcdh.public(~prm, sk), m, PS.PkSm2.sign(~prm, ~digest, ~mac, ~id, sk, m)) == True{} : Bool}
  {Sg.CrSign.verify_bytes(~EE.EcPoint, ~PE.PkEcdh.pk_of(~prm), ~PS.PkSm2.verify(~prm, ~digest, ~id), PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, sk)), m, PS.PkSm2.sign(~prm, ~digest, ~mac, ~id, sk, m)) == True{} : Bool}

# GOST R 34.10-2012, for every curve, hash and MAC (RFC 6979's k) (crypto's
# sign_verify_bytes_if): a signature checked from the public key's bytes is
# accepted, for every key and message, when the public key survives its bytes
# (hf) and the scheme accepts the signature (ha)
law ecrdsa_verify_bytes_if:
  for ~prm: EE.EcParams
  for ~digest: B.Octets -> B.Octets
  for ~mac: B.Octets -> B.Octets -> B.Octets
  for +sk: NB.BnNat
  for +m: B.Octets
  for hf: {PG.PkEcrdsa.pk_of(~prm, PG.PkEcrdsa.pk_to(~prm, PE.PkEcdh.public(~prm, sk))) == Done{PE.PkEcdh.public(~prm, sk)} : Result<&2, &2, Cr.CrError, EE.EcPoint>}
  for ha: {PG.PkEcrdsa.verify(~prm, ~digest, PE.PkEcdh.public(~prm, sk), m, PG.PkEcrdsa.sign(~prm, ~digest, ~mac, sk, m)) == True{} : Bool}
  {Sg.CrSign.verify_bytes(~EE.EcPoint, ~PG.PkEcrdsa.pk_of(~prm), ~PG.PkEcrdsa.verify(~prm, ~digest), PG.PkEcrdsa.pk_to(~prm, PE.PkEcdh.public(~prm, sk)), m, PG.PkEcrdsa.sign(~prm, ~digest, ~mac, sk, m)) == True{} : Bool}

# finite-field Diffie-Hellman, for every group (crypto's kex_agree_if): two
# parties agree from each other's public-key bytes, for every pair of keys,
# when the keys parse (hx, hy), the public keys survive their bytes (hfx, hfy)
# and the shared secrets agree (h)
law dh_agree_if:
  for ~grp: DD.DhGroup
  for +a: B.Octets
  for +b: B.Octets
  for +x: NB.BnNat
  for +y: NB.BnNat
  for hx: {PD.PkDh.secret(~grp, a) == Done{x} : Result<&2, &2, Cr.CrError, NB.BnNat>}
  for hy: {PD.PkDh.secret(~grp, b) == Done{y} : Result<&2, &2, Cr.CrError, NB.BnNat>}
  for hfx: {PD.PkDh.pk_of(~grp, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, x))) == Done{PD.PkDh.public(~grp, x)} : Result<&2, &2, Cr.CrError, NB.BnNat>}
  for hfy: {PD.PkDh.pk_of(~grp, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, y))) == Done{PD.PkDh.public(~grp, y)} : Result<&2, &2, Cr.CrError, NB.BnNat>}
  for h: {PD.PkDh.shared(~grp, x, PD.PkDh.public(~grp, y)) == PD.PkDh.shared(~grp, y, PD.PkDh.public(~grp, x)) : Result<&2, &2, Cr.CrError, B.Octets>}
  {Kx.CrKex.agree(~NB.BnNat, ~NB.BnNat, ~PD.PkDh.secret(~grp), ~PD.PkDh.pk_of(~grp), ~PD.PkDh.shared(~grp), a, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, y))) == Kx.CrKex.agree(~NB.BnNat, ~NB.BnNat, ~PD.PkDh.secret(~grp), ~PD.PkDh.pk_of(~grp), ~PD.PkDh.shared(~grp), b, PD.PkDh.pk_to(~grp, PD.PkDh.public(~grp, x))) : Result<&2, &2, Cr.CrError, B.Octets>}

# ECDH, for every curve (crypto's kex_agree_if): two parties agree from each
# other's public-key bytes, for every pair of keys, when the keys parse (hx,
# hy), the public keys survive their bytes (hfx, hfy) and the shared secrets
# agree (h)
law ecdh_agree_if:
  for ~prm: EE.EcParams
  for +a: B.Octets
  for +b: B.Octets
  for +x: NB.BnNat
  for +y: NB.BnNat
  for hx: {PE.PkEcdh.secret(~prm, a) == Done{x} : Result<&2, &2, Cr.CrError, NB.BnNat>}
  for hy: {PE.PkEcdh.secret(~prm, b) == Done{y} : Result<&2, &2, Cr.CrError, NB.BnNat>}
  for hfx: {PE.PkEcdh.pk_of(~prm, PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, x))) == Done{PE.PkEcdh.public(~prm, x)} : Result<&2, &2, Cr.CrError, EE.EcPoint>}
  for hfy: {PE.PkEcdh.pk_of(~prm, PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, y))) == Done{PE.PkEcdh.public(~prm, y)} : Result<&2, &2, Cr.CrError, EE.EcPoint>}
  for h: {PE.PkEcdh.shared(~prm, x, PE.PkEcdh.public(~prm, y)) == PE.PkEcdh.shared(~prm, y, PE.PkEcdh.public(~prm, x)) : Result<&2, &2, Cr.CrError, B.Octets>}
  {Kx.CrKex.agree(~NB.BnNat, ~EE.EcPoint, ~PE.PkEcdh.secret(~prm), ~PE.PkEcdh.pk_of(~prm), ~PE.PkEcdh.shared(~prm), a, PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, y))) == Kx.CrKex.agree(~NB.BnNat, ~EE.EcPoint, ~PE.PkEcdh.secret(~prm), ~PE.PkEcdh.pk_of(~prm), ~PE.PkEcdh.shared(~prm), b, PE.PkEcdh.pk_to(~prm, PE.PkEcdh.public(~prm, x))) : Result<&2, &2, Cr.CrError, B.Octets>}

# ECDH's public keys (ECDSA, SM2, ECDH), for every curve: a public key read
# from bytes o is read again from the bytes written for it, given ecc's
# point_round_trip (ecc/LAWS.bend) at o (hr)
law ecdh_pk_format_if:
  for ~prm: EE.EcParams
  for +o: B.Octets
  for +p: EE.EcPoint
  for h: {PE.PkEcdh.pk_of(~prm, o) == Done{p} : Result<&2, &2, Cr.CrError, EE.EcPoint>}
  for hr: {Result.bind(&2, &2, EE.EcError, EE.EcPoint, EE.EcPoint, PE.PkEcdh.point_of(~prm, o), q => PE.PkEcdh.point_of(~prm, PE.PkEcdh.pk_to(~prm, q))) == PE.PkEcdh.point_of(~prm, o) : Result<&2, &2, EE.EcError, EE.EcPoint>}
  {PE.PkEcdh.pk_of(~prm, PE.PkEcdh.pk_to(~prm, p)) == Done{p} : Result<&2, &2, Cr.CrError, EE.EcPoint>}

# DH's public keys, for every group: a public key read from bytes o is read
# again from the bytes written for it, given dh's public_round_trip
# (dh/LAWS.bend) at o (hr)
law dh_pk_format_if:
  for ~grp: DD.DhGroup
  for +o: B.Octets
  for +p: NB.BnNat
  for h: {PD.PkDh.pk_of(~grp, o) == Done{p} : Result<&2, &2, Cr.CrError, NB.BnNat>}
  for hr: {Result.bind(&2, &2, DD.DhError, NB.BnNat, NB.BnNat, PD.PkDh.public_of(~grp, o), q => PD.PkDh.public_of(~grp, PD.PkDh.pk_to(~grp, q))) == PD.PkDh.public_of(~grp, o) : Result<&2, &2, DD.DhError, NB.BnNat>}
  {PD.PkDh.pk_of(~grp, PD.PkDh.pk_to(~grp, p)) == Done{p} : Result<&2, &2, Cr.CrError, NB.BnNat>}

# GOST R 34.10-2012's public keys (RFC 4491's form), for every curve: a public
# key read from bytes o is read again from the bytes written for it, given
# ecrdsa's public_round_trip (ecrdsa/LAWS.bend) at o (hr)
law ecrdsa_pk_format_if:
  for ~prm: EE.EcParams
  for +o: B.Octets
  for +p: EE.EcPoint
  for h: {PG.PkEcrdsa.pk_of(~prm, o) == Done{p} : Result<&2, &2, Cr.CrError, EE.EcPoint>}
  for hr: {Result.bind(&2, &2, GG.EcrdsaError, EE.EcPoint, EE.EcPoint, PG.PkEcrdsa.public_of(~prm, o), q => PG.PkEcrdsa.public_of(~prm, PG.PkEcrdsa.pk_to(~prm, q))) == PG.PkEcrdsa.public_of(~prm, o) : Result<&2, &2, GG.EcrdsaError, EE.EcPoint>}
  {PG.PkEcrdsa.pk_of(~prm, PG.PkEcrdsa.pk_to(~prm, p)) == Done{p} : Result<&2, &2, Cr.CrError, EE.EcPoint>}
