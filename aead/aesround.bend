# The AES encryption round function, AESRound(A, B) = MixColumns(ShiftRows(
# SubBytes(A))) xor B (FIPS 197, sections 5.1.1 to 5.1.4; not the last
# round), on 16-byte blocks: the building block of AEGIS (aegis128.bend). It
# is the x86 instruction AESENC; RFC 10032 (the AEGIS family), Appendix A.1,
# gives its test vector.
#
# A block is four big-endian 32-bit words, each one column of the AES state:
# byte r of word c is the state's row r, column c (FIPS 197, 3.4: byte i of
# the input is row i mod 4, column i / 4). The S-box is a table built once
# (AdAes.sbox) and passed in, so a caller that runs many rounds (AEGIS keeps
# it in its key) builds it once.
import Base
import ../bytes/bytes.bend as B

# A 16-byte block (open type)
type AdBlk is Data:
  AdBlk{w0: U32, w1: U32, w2: U32, w3: U32}

def AdBlk.zero() -> AdBlk:
  AdBlk{0, 0, 0, 0}

def AdBlk.xor(a: AdBlk, b: AdBlk) -> AdBlk:
  match a b:
    case AdBlk{a0, a1, a2, a3} AdBlk{b0, b1, b2, b3}:
      AdBlk{U32.xor(a0, b0), U32.xor(a1, b1), U32.xor(a2, b2), U32.xor(a3, b3)}

def AdBlk.and(a: AdBlk, b: AdBlk) -> AdBlk:
  match a b:
    case AdBlk{a0, a1, a2, a3} AdBlk{b0, b1, b2, b3}:
      AdBlk{U32.and(a0, b0), U32.and(a1, b1), U32.and(a2, b2), U32.and(a3, b3)}

def ad.blk.at(xs: List<&2, U32>, i: Nat) -> U32:
  match xs:
    case Nil{}:
      0
    case Con{h, t}:
      match i:
        case 0n:
          h
        case 1n+p:
          ad.blk.at(t, p)

def ad.blk.word(+xs: List<&2, U32>, +i: Nat) -> U32:
  U32.or(U32.or(U32.shln(B.byte(ad.blk.at(xs, i)), 24n), U32.shln(B.byte(ad.blk.at(xs, Nat.add(i, 1n))), 16n)), U32.or(U32.shln(B.byte(ad.blk.at(xs, Nat.add(i, 2n))), 8n), B.byte(ad.blk.at(xs, Nat.add(i, 3n)))))

# the block of the first 16 bytes of xs (zeros past the end)
def AdBlk.of_list(+xs: List<&2, U32>) -> AdBlk:
  AdBlk{ad.blk.word(xs, 0n), ad.blk.word(xs, 4n), ad.blk.word(xs, 8n), ad.blk.word(xs, 12n)}

# a block's 16 bytes
def AdBlk.to_list(b: AdBlk) -> List<&2, U32>:
  match b:
    case AdBlk{w0, w1, w2, w3}:
      B.append(B.be32(w0), B.append(B.be32(w1), B.append(B.be32(w2), B.be32(w3))))

def AdBlk.of_octets(+o: B.Octets) -> AdBlk:
  AdBlk.of_list(B.Octets.to_list(o))

def AdBlk.to_octets(b: AdBlk) -> B.Octets:
  B.Octets.of_list(AdBlk.to_list(b))

def AdBlk.hex(b: AdBlk) -> String:
  B.Octets.hex(AdBlk.to_octets(b))

# The S-box

