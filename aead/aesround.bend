# a table of 2^d words, read by the bits of an index (internal)
type AdTab is Data:
  AdLeaf{v: U32}
  AdNode{l: AdTab, r: AdTab}

def ad.tab.leaves(xs: List<&2, U32>) -> List<&2, AdTab>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{AdLeaf{h}, ad.tab.leaves(t)}

def ad.tab.pairs(ts: List<&2, AdTab>) -> List<&2, AdTab>:
  match ts:
    case Con{a, Con{b, t}}:
      Con{AdNode{a, b}, ad.tab.pairs(t)}
    case _:
      Nil{}

def ad.tab.up(n: Nat, ts: List<&2, AdTab>) -> List<&2, AdTab>:
  match n:
    case 0n:
      ts
    case 1n+p:
      ad.tab.up(p, ad.tab.pairs(ts))

def ad.tab.root(ts: List<&2, AdTab>) -> AdTab:
  match ts:
    case Nil{}:
      AdLeaf{0}
    case Con{h, t}:
      h

def ad.tab.pick(one: Bool, l: AdTab, r: AdTab) -> AdTab:
  match one:
    case True{}:
      r
    case False{}:
      l

def ad.tab.get(d: Nat, t: AdTab, +i: U32) -> U32:
  match d:
    case 0n:
      match t:
        case AdLeaf{v}:
          v
        case AdNode{l, r}:
          0
    case 1n+(+p):
      match t:
        case AdLeaf{v}:
          v
        case AdNode{l, r}:
          ad.tab.get(p, ad.tab.pick(U32.is_eq(U32.and(1, U32.shrn(i, p)), 1), l, r), i)

# The S-box as a table (opaque)
type AdSbox is Data:
  AdSbox{t: AdTab}

def AdAes.sbox() -> AdSbox:
  AdSbox{ad.tab.root(ad.tab.up(8n, ad.tab.leaves(ad.aes.sbox.list())))}

def ad.aes.s(+t: AdTab, +w: U32, n: Nat) -> U32:
  ad.tab.get(8n, t, U32.and(255, U32.shrn(w, n)))

# x times 2 in GF(2^8) (xtime, FIPS 197 4.2.1)
def ad.aes.x2(+a: U32) -> U32:
  U32.xor(U32.and(255, U32.shl(a)), U32.mul(27, U32.shrn(a, 7n)))

# MixColumns of one column a0 .. a3 (row 0 first), as a word
def ad.aes.mix(+a0: U32, +a1: U32, +a2: U32, +a3: U32) -> U32:
  +b0 = U32.xor(U32.xor(ad.aes.x2(a0), U32.xor(ad.aes.x2(a1), a1)), U32.xor(a2, a3))
  +b1 = U32.xor(U32.xor(a0, ad.aes.x2(a1)), U32.xor(U32.xor(ad.aes.x2(a2), a2), a3))
  +b2 = U32.xor(U32.xor(a0, a1), U32.xor(ad.aes.x2(a2), U32.xor(ad.aes.x2(a3), a3)))
  +b3 = U32.xor(U32.xor(U32.xor(ad.aes.x2(a0), a0), a1), U32.xor(a2, ad.aes.x2(a3)))
  U32.or(U32.or(U32.shln(b0, 24n), U32.shln(b1, 16n)), U32.or(U32.shln(b2, 8n), b3))

# one column of the round: rows 0 .. 3 from columns c, c + 1, c + 2, c + 3
# (ShiftRows), each through the S-box (SubBytes), then MixColumns
def ad.aes.col(+t: AdTab, +x0: U32, +x1: U32, +x2: U32, +x3: U32) -> U32:
  ad.aes.mix(ad.aes.s(t, x0, 24n), ad.aes.s(t, x1, 16n), ad.aes.s(t, x2, 8n), ad.aes.s(t, x3, 0n))

# AESRound(a, k)
def AdAes.round(s: AdSbox, a: AdBlk, k: AdBlk) -> AdBlk:
  match s a k:
    case AdSbox{+t} AdBlk{+a0, +a1, +a2, +a3} AdBlk{k0, k1, k2, k3}:
      AdBlk{U32.xor(ad.aes.col(t, a0, a1, a2, a3), k0), U32.xor(ad.aes.col(t, a1, a2, a3, a0), k1), U32.xor(ad.aes.col(t, a2, a3, a0, a1), k2), U32.xor(ad.aes.col(t, a3, a0, a1, a2), k3)}
