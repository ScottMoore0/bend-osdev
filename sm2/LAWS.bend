# The laws of sm2.
#
# Small-parameter exhaustive laws (generated by gen/exhaustive.py, with
# their proofs), on the curve y^2 = x^3 + 2x + 7 over GF(11) whose base
# point (6, 2) has prime order 7 (sm2law.toy): every SM2 signature made
# with a private key d in [1, 5] (SM2's keys are in [1, n - 2]) and a
# per-message secret k in [1, 6], for the message value e = 3, verifies
# under d's public key (a k that gives r = 0, r + k = n or s = 0 is
# refused).
#
# That every signature verifies for every key of every curve is number
# theory (the group law), not proved here; ref/run.sh tests it against the
# openssl command's SM2, and check.bend runs draft-shen-sm2-ecdsa-02's
# example (Z_A, e, r and s).
import Base
import ../bytes/bytes.bend as B
import ../bignum/bignum.bend as N
import ../ecc/ecc.bend as E
import ../ecc/ecdsa.bend as S
import ./sm2.bend as M

def sm2law.nat1(+x: Nat) -> N.BnNat:
  N.BnNat.of_u32(U32.from_nat(Nat.add(x, 1n)))

# the toy curve: y^2 = x^3 + 2x + 7 over GF(11), G = (6, 2) of order 7
def sm2law.toy() -> E.EcCurve:
  E.EcCurve.of(E.EcParams{N.BnNat.of_u32(11), N.BnNat.of_u32(2), N.BnNat.of_u32(7), N.BnNat.of_u32(6), N.BnNat.of_u32(2), N.BnNat.of_u32(7), N.BnNat.of_u32(1)})

# whether a signing result verifies under q: true for a refused signature
def sm2law.verifies(+c: E.EcCurve, +q: E.EcPoint, +e: N.BnNat, r: Result<&2, &2, M.Sm2Error, S.EcSig>) -> Bool:
  match r:
    case Fail{x}:
      True{}
    case Done{s}:
      M.Sm2.verify_e(c, q, e, s)

# whether the toy curve's SM2 signature of e = 3 with private key d and
# per-message secret k verifies under d's public key (or is refused)
def sm2law.signs_verify(+d: N.BnNat, +k: N.BnNat) -> Bool:
  +c = sm2law.toy()
  +e = N.BnNat.of_u32(3)
  sm2law.verifies(c, M.Sm2.public(c, d), e, M.Sm2.sign_e(c, d, e, k))

# Small-parameter exhaustive laws

# BEGIN GENERATED by gen/exhaustive.py: exhaustive
# on the toy curve (sm2law.toy), SM2: every signature of the message value e =
# 3 made with a private key d in [1, 5] and a per-message secret k in [1, 6]
# verifies under d's public key (sm2law.signs_verify; a k that gives r = 0, r
# + k = n or s = 0 is refused)
law toy_sign_verify:
  for d: Nat
  for k: Nat
  for hd: {Nat.is_lt(d, 5n) == True{} : Bool}
  for hk: {Nat.is_lt(k, 6n) == True{} : Bool}
  {sm2law.signs_verify(sm2law.nat1(d), sm2law.nat1(k)) == True{} : Bool}
# END GENERATED: exhaustive
