# The round trips

def ks.r64(+v: W.W64) -> {K.kstr.u64.fin(K.kstr.front(8, K.kstr.strip_nl(K.kstr.toks(B.Octets.to_list(B.Octets.of_list(F.kfmt.digits(64n, False{}, v, 8, False{}, Nil{}))))), False{})) == Done{v} : Result<&2, &2, K.KStrError, W.W64>}:
