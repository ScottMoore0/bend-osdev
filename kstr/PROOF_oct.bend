      Empty.absurd({K.kstr.digits(tl, 8, Done{0}, pos) == K.kstr.digits(tl, 8, Done{W.W64.lo(v)}, pos) : Result<&2, &2, K.KStrError, U32>}, ks.tf(Equal.trans(Bool, True{}, Nat.is_eq(W.W64.to_nat(v), 0n), False{}, Equal.sym(Bool, Nat.is_eq(W.W64.to_nat(v), 0n), True{}, Equal.cong(Nat, Bool, zz => Nat.is_eq(zz, 0n), W.W64.to_nat(v), 0n, ks.lt1(W.W64.to_nat(v), hf))), Equal.trans(Bool, Nat.is_eq(W.W64.to_nat(v), 0n), W.W64.is_zero(v), False{}, Equal.sym(Bool, W.W64.is_zero(v), Nat.is_eq(W.W64.to_nat(v), 0n), WB.eq_value(v, W.W64.zero())), ez))))
