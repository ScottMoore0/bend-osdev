  WD.divmod_value(v, W.W64.from_u32(8), {==})

def ks.dml(+v: W.W64) -> {Nat.is_lt(U32.to_nat(F.kfmt.r(F.kfmt.qr64(W.W64.divmod(v, W.W64.from_u32(8))))), 8n) == True{} : Bool}:
