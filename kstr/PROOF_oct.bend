def ks.tq(n: Nat, z: Bool, +v: W.W64, ez: {W.W64.is_zero(v) == z : Bool}, +tl: List<&2, K.KStrTok>, +pos: Nat, hf: {Nat.is_lt(W.W64.to_nat(v), U.U32Nat.dbl(n, 1n)) == True{} : Bool}, +hv: {Nat.is_lt(W.W64.to_nat(v), U.U32Nat.dbl(32n, 1n)) == True{} : Bool}) -> {K.kstr.digits(ks.dt(n, z, v, tl), 8, Done{0}, pos) == K.kstr.digits(tl, 8, Done{W.W64.lo(v)}, ks.pos(n, z, v, pos)) : Result<&2, &2, K.KStrError, U32>}:
  match n z:
    case 0n True{}:
      %Equal.sym(W.W64, v, W.W64.zero(), WB.value_eq(v, W.W64.zero(), ks.wz(v, ez))) : {K.kstr.digits(tl, 8, Done{0}, pos) == K.kstr.digits(tl, 8, Done{W.W64.lo(_)}, pos) : Result<&2, &2, K.KStrError, U32>}
