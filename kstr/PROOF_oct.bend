def ks.dmq(+v: W.W64) -> {Nat.add(Nat.mul(W.W64.to_nat(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), 8n), U32.to_nat(F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)))) == W.W64.to_nat(v) : Nat}:
