  %Equal.sym(List<&2, K.KStrTok>, K.kstr.toks(B.mask(F.kfmt.digits(64n, False{}, v, 8, False{}, Nil{}))), ks.dt(64n, False{}, v, Nil{}), ks.ta(64n, False{}, v, Nil{})) : {K.kstr.u64.fin(K.kstr.front(8, K.kstr.strip_nl(_), False{})) == Done{v} : Result<&2, &2, K.KStrError, W.W64>}
  %Equal.sym(List<&2, K.KStrTok>, K.kstr.strip_nl(ks.dt(64n, False{}, v, Nil{})), ks.dt(64n, False{}, v, Nil{}), ks.tb(64n, False{}, v, Nil{})) : {K.kstr.u64.fin(K.kstr.front(8, _, False{})) == Done{v} : Result<&2, &2, K.KStrError, W.W64>}
  %Equal.sym(Result<&2, &2, K.KStrError, K.KStrDigits>, K.kstr.front(8, ks.dt(63n, W.W64.is_zero(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), Con{K.KTDigit{F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))}, Nil{}}), False{}), Done{K.KStrDigits{False{}, 8, ks.dt(63n, W.W64.is_zero(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), Con{K.KTDigit{F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))}, Nil{}}), 0n}}, ks.fr(63n, W.W64.is_zero(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), Nil{})) : {K.kstr.u64.fin(_) == Done{v} : Result<&2, &2, K.KStrError, W.W64>}
  Equal.trans(Result<&2, &2, K.KStrError, W.W64>, K.kstr.digits64(ks.dt(63n, W.W64.is_zero(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), Con{K.KTDigit{F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))}, Nil{}}), 8, Done{W.W64.zero()}, 0n), K.kstr.digits64(Con{K.KTDigit{F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))}, Nil{}}, 8, Done{F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))}, ks.pos(63n, W.W64.is_zero(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), 0n)), Done{v}, ks.tp(63n, W.W64.is_zero(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), {==}, Con{K.KTDigit{F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))}, Nil{}}, 0n, ks.hq(63n, 64n, W.W64.to_nat(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), U32.to_nat(F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), W.W64.to_nat(v), {==}, ks.dmq(v), ks.lt64(v))), ks.sp(v, Nil{}, ks.pos(63n, W.W64.is_zero(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), 0n)))

def Laws.oct64_round_trip(v):
  ks.r64(v)

