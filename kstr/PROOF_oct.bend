# kfmt.divmod(..., v, 10): q 10 + r = v and r < 10, by U32 or by W64 division

def ks.oq(p: W.W64 & W.W64) -> {W.W64.fst(p) == F.kfmt.q(F.kfmt.qr64(p)) : W.W64}:
  (q, r) = p
  {==}

def ks.or(p: W.W64 & W.W64) -> {W.W64.lo(W.W64.snd(p)) == F.kfmt.r(F.kfmt.qr64(p)) : U32}:
  (q, r) = p
  {==}

