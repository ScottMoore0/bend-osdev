def ks.dmr(+v: W.W64) -> {Nat.is_lt(U32.to_nat(F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), 8n) == True{} : Bool}:
  ks.c2(Nat.add(Nat.mul(W.W64.to_nat(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), 8n), U32.to_nat(F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)))), W.W64.to_nat(v), U32.to_nat(F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), 8n, ks.dm1(v, U32.is_eq(W.W64.hi(v), 0), {==}))

# q < 2^k when q 10 + r = v < 2^m, m = 1 + k
def ks.hq(+k: Nat, +m: Nat, +q: Nat, +r: Nat, +v: Nat, em: {1n+k == m : Nat}, e: {Nat.add(Nat.mul(q, 8n), r) == v : Nat}, h: {Nat.is_lt(v, U.U32Nat.dbl(m, 1n)) == True{} : Bool}) -> {Nat.is_lt(q, U.U32Nat.dbl(k, 1n)) == True{} : Bool}:
