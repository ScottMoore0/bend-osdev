# The digit bytes as tokens

def ks.tdn(n0: Nat, +r: U32, e: {U32.to_nat(r) == n0 : Nat}, h: {Nat.is_lt(n0, 8n) == True{} : Bool}) -> {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(r, 10), False{}, r))) == K.KTDigit{r} : K.KStrTok}:
  match n0:
    case 0n:
      %Equal.sym(U32, r, 0, UL.u32_value_eq(r, 0, e)) : {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(_, 10), False{}, _))) == K.KTDigit{_} : K.KStrTok}
      {==}
    case 1n+n1:
      match n1:
        case 0n:
          %Equal.sym(U32, r, 1, UL.u32_value_eq(r, 1, e)) : {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(_, 10), False{}, _))) == K.KTDigit{_} : K.KStrTok}
          {==}
        case 1n+n2:
          match n2:
            case 0n:
              %Equal.sym(U32, r, 2, UL.u32_value_eq(r, 2, e)) : {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(_, 10), False{}, _))) == K.KTDigit{_} : K.KStrTok}
              {==}
            case 1n+n3:
              match n3:
                case 0n:
                  %Equal.sym(U32, r, 3, UL.u32_value_eq(r, 3, e)) : {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(_, 10), False{}, _))) == K.KTDigit{_} : K.KStrTok}
                  {==}
                case 1n+n4:
                  match n4:
                    case 0n:
                      %Equal.sym(U32, r, 4, UL.u32_value_eq(r, 4, e)) : {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(_, 10), False{}, _))) == K.KTDigit{_} : K.KStrTok}
                      {==}
                    case 1n+n5:
                      match n5:
                        case 0n:
                          %Equal.sym(U32, r, 5, UL.u32_value_eq(r, 5, e)) : {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(_, 10), False{}, _))) == K.KTDigit{_} : K.KStrTok}
                          {==}
                        case 1n+n6:
                          match n6:
                            case 0n:
                              %Equal.sym(U32, r, 6, UL.u32_value_eq(r, 6, e)) : {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(_, 10), False{}, _))) == K.KTDigit{_} : K.KStrTok}
                              {==}
                            case 1n+n7:
                              match n7:
                                case 0n:
                                  %Equal.sym(U32, r, 7, UL.u32_value_eq(r, 7, e)) : {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(_, 10), False{}, _))) == K.KTDigit{_} : K.KStrTok}
                                  {==}
                                case 1n+n8:
                                  match n8:
                                    case 0n:
                                      Empty.absurd({K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(r, 10), False{}, r))) == K.KTDigit{r} : K.KStrTok}, ks.ft(h))
                                    case 1n+ +x:
                                      Empty.absurd({K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(r, 10), False{}, r))) == K.KTDigit{r} : K.KStrTok}, ks.ft(h))

def ks.td(+r: U32, h: {Nat.is_lt(U32.to_nat(r), 8n) == True{} : Bool}) -> {K.KStr.tok(B.byte(F.kfmt.digit.pick(U32.is_lt(r, 10), False{}, r))) == K.KTDigit{r} : K.KStrTok}:
  ks.tdn(U32.to_nat(r), r, {==}, h)

# the tokens of the digits of v (least significant last), onto tl
def ks.dt(n: Nat, z: Bool, +v: W.W64, tl: List<&2, K.KStrTok>) -> List<&2, K.KStrTok>:
  match n z:
    case 0n True{}:
      tl
    case 1n+k True{}:
      tl
    case 0n False{}:
      tl
    case 1n+k False{}:
      ks.dt(k, W.W64.is_zero(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), Con{K.KTDigit{F.kfmt.r(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))}, tl})

# the position after them
def ks.pos(n: Nat, z: Bool, +v: W.W64, pos: Nat) -> Nat:
  match n z:
    case 0n True{}:
      pos
    case 1n+k True{}:
      pos
    case 0n False{}:
      pos
    case 1n+k False{}:
      1n+ks.pos(k, W.W64.is_zero(F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8))), F.kfmt.q(F.kfmt.divmod(U32.is_eq(W.W64.hi(v), 0), v, 8)), pos)

def ks.ta(n: Nat, z: Bool, +v: W.W64, +acc: List<&2, U32>) -> {K.kstr.toks(B.mask(F.kfmt.digits(n, z, v, 8, False{}, acc))) == ks.dt(n, z, v, K.kstr.toks(B.mask(acc))) : List<&2, K.KStrTok>}:
  match n z:
    case 0n True{}:
      {==}
    case 1n+ +k True{}:
      {==}
    case 0n False{}:
