# A subtraction undoes an addition, for every word (TEA and XTEA)

# BEGIN GENERATED by gen/proof.py: adc
def adc_add_sub(n: Nat, a: Word(n), b: Word(n), c: Bool) -> {a == Word.adc(n, Word.adc(n, a, b, False{}, c), b, True{}, Bool.not(c)) : Word(n)}:
  match n:
    case 0n:
      match a:
        case WNil{}:
          {==}
    case 1n+p:
      match a b c:
        case WCon{True{}, at} WCon{True{}, bt} True{}:
          %adc_add_sub(p, at, bt, True{}) : {WCon{True{}, at} == WCon{True{}, _} : Word(1n+p)}
          {==}
        case WCon{True{}, at} WCon{True{}, bt} False{}:
          %adc_add_sub(p, at, bt, True{}) : {WCon{True{}, at} == WCon{True{}, _} : Word(1n+p)}
          {==}
        case WCon{True{}, at} WCon{False{}, bt} True{}:
          %adc_add_sub(p, at, bt, True{}) : {WCon{True{}, at} == WCon{True{}, _} : Word(1n+p)}
          {==}
        case WCon{True{}, at} WCon{False{}, bt} False{}:
          %adc_add_sub(p, at, bt, False{}) : {WCon{True{}, at} == WCon{True{}, _} : Word(1n+p)}
          {==}
        case WCon{False{}, at} WCon{True{}, bt} True{}:
          %adc_add_sub(p, at, bt, True{}) : {WCon{False{}, at} == WCon{False{}, _} : Word(1n+p)}
          {==}
        case WCon{False{}, at} WCon{True{}, bt} False{}:
          %adc_add_sub(p, at, bt, False{}) : {WCon{False{}, at} == WCon{False{}, _} : Word(1n+p)}
          {==}
        case WCon{False{}, at} WCon{False{}, bt} True{}:
          %adc_add_sub(p, at, bt, False{}) : {WCon{False{}, at} == WCon{False{}, _} : Word(1n+p)}
          {==}
        case WCon{False{}, at} WCon{False{}, bt} False{}:
          %adc_add_sub(p, at, bt, False{}) : {WCon{False{}, at} == WCon{False{}, _} : Word(1n+p)}
          {==}

def adc_sub_add(n: Nat, a: Word(n), b: Word(n), c: Bool) -> {a == Word.adc(n, Word.adc(n, a, b, True{}, c), b, False{}, Bool.not(c)) : Word(n)}:
  match n:
    case 0n:
      match a:
        case WNil{}:
          {==}
    case 1n+p:
      match a b c:
        case WCon{True{}, at} WCon{True{}, bt} True{}:
          %adc_sub_add(p, at, bt, True{}) : {WCon{True{}, at} == WCon{True{}, _} : Word(1n+p)}
          {==}
        case WCon{True{}, at} WCon{True{}, bt} False{}:
          %adc_sub_add(p, at, bt, False{}) : {WCon{True{}, at} == WCon{True{}, _} : Word(1n+p)}
          {==}
        case WCon{True{}, at} WCon{False{}, bt} True{}:
          %adc_sub_add(p, at, bt, True{}) : {WCon{True{}, at} == WCon{True{}, _} : Word(1n+p)}
          {==}
        case WCon{True{}, at} WCon{False{}, bt} False{}:
          %adc_sub_add(p, at, bt, True{}) : {WCon{True{}, at} == WCon{True{}, _} : Word(1n+p)}
          {==}
        case WCon{False{}, at} WCon{True{}, bt} True{}:
          %adc_sub_add(p, at, bt, False{}) : {WCon{False{}, at} == WCon{False{}, _} : Word(1n+p)}
          {==}
        case WCon{False{}, at} WCon{True{}, bt} False{}:
          %adc_sub_add(p, at, bt, False{}) : {WCon{False{}, at} == WCon{False{}, _} : Word(1n+p)}
          {==}
        case WCon{False{}, at} WCon{False{}, bt} True{}:
          %adc_sub_add(p, at, bt, True{}) : {WCon{False{}, at} == WCon{False{}, _} : Word(1n+p)}
          {==}
        case WCon{False{}, at} WCon{False{}, bt} False{}:
          %adc_sub_add(p, at, bt, False{}) : {WCon{False{}, at} == WCon{False{}, _} : Word(1n+p)}
          {==}

def u32_add_sub(a: U32, b: U32) -> {a == U32.sub(U32.add(a, b), b) : U32}:
  match a b:
    case U32{x} U32{y}:
      %adc_add_sub(32n, x, y, False{}) : {U32{x} == U32{_} : U32}
      {==}

def u32_sub_add(a: U32, b: U32) -> {a == U32.add(U32.sub(a, b), b) : U32}:
  match a b:
    case U32{x} U32{y}:
      %adc_sub_add(32n, x, y, True{}) : {U32{x} == U32{_} : U32}
      {==}
# END GENERATED: adc

# TEA and XTEA: each step adds a function of one half to the other, undone
# by subtracting it (the "adc" lemmas below); the byte swaps undone by
# themselves

def tea_unop_op(o: TE.LcTeaOp, b: L.LcBlock64) -> {b == TE.tea.unop(o, TE.tea.op(o, b)) : L.LcBlock64}:
  match o:
    case TE.LcTeaY{+s, +ka, +kb}:
      match b:
        case L.LcBlock64{y, +z}:
          %u32_add_sub(y, TE.tea.g(z, s, ka, kb)) : {L.LcBlock64{y, z} == L.LcBlock64{_, z} : L.LcBlock64}
          {==}
    case TE.LcTeaZ{+s, +ka, +kb}:
      match b:
        case L.LcBlock64{+y, z}:
          %u32_add_sub(z, TE.tea.g(y, s, ka, kb)) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}
    case TE.LcXteaY{+c}:
      match b:
        case L.LcBlock64{y, +z}:
          %u32_add_sub(y, TE.xtea.g(z, c)) : {L.LcBlock64{y, z} == L.LcBlock64{_, z} : L.LcBlock64}
          {==}
    case TE.LcXteaZ{+c}:
      match b:
        case L.LcBlock64{+y, z}:
          %u32_add_sub(z, TE.xtea.g(y, c)) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}
    case TE.LcTeaBswap{}:
      match b:
        case L.LcBlock64{+y, +z}:
          %CoreL.bswap_bswap(y) : {L.LcBlock64{y, z} == L.LcBlock64{_, L.lc.bswap.bits(L.lc.bswap.bits(z))} : L.LcBlock64}
          %CoreL.bswap_bswap(z) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}

def tea_op_unop(o: TE.LcTeaOp, b: L.LcBlock64) -> {b == TE.tea.op(o, TE.tea.unop(o, b)) : L.LcBlock64}:
  match o:
    case TE.LcTeaY{+s, +ka, +kb}:
      match b:
        case L.LcBlock64{y, +z}:
          %u32_sub_add(y, TE.tea.g(z, s, ka, kb)) : {L.LcBlock64{y, z} == L.LcBlock64{_, z} : L.LcBlock64}
          {==}
    case TE.LcTeaZ{+s, +ka, +kb}:
      match b:
        case L.LcBlock64{+y, z}:
          %u32_sub_add(z, TE.tea.g(y, s, ka, kb)) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}
    case TE.LcXteaY{+c}:
      match b:
        case L.LcBlock64{y, +z}:
          %u32_sub_add(y, TE.xtea.g(z, c)) : {L.LcBlock64{y, z} == L.LcBlock64{_, z} : L.LcBlock64}
          {==}
    case TE.LcXteaZ{+c}:
      match b:
        case L.LcBlock64{+y, z}:
          %u32_sub_add(z, TE.xtea.g(y, c)) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}
    case TE.LcTeaBswap{}:
      match b:
        case L.LcBlock64{+y, +z}:
          %CoreL.bswap_bswap(y) : {L.LcBlock64{y, z} == L.LcBlock64{_, L.lc.bswap.bits(L.lc.bswap.bits(z))} : L.LcBlock64}
          %CoreL.bswap_bswap(z) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}

def tea_unrun_run(os: List<&2, TE.LcTeaOp>, +b: L.LcBlock64) -> {b == TE.tea.unrun(os, TE.tea.run(os, b)) : L.LcBlock64}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %tea_unrun_run(t, TE.tea.op(o, b)) : {b == TE.tea.unop(o, _) : L.LcBlock64}
      tea_unop_op(o, b)

def tea_run_unrun(os: List<&2, TE.LcTeaOp>, +b: L.LcBlock64) -> {b == TE.tea.run(os, TE.tea.unrun(os, b)) : L.LcBlock64}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %tea_op_unop(o, TE.tea.unrun(t, b)) : {b == TE.tea.run(t, _) : L.LcBlock64}
      tea_run_unrun(t, b)

def Laws.tea_round_trip(k, b):
  match k:
    case TE.LcTeaKey{+ops}:
      Equal.sym(L.LcBlock64, b, TE.tea.unrun(ops, TE.tea.run(ops, b)), tea_unrun_run(ops, b))

def Laws.tea_round_trip_dual(k, b):
  match k:
    case TE.LcTeaKey{+ops}:
      Equal.sym(L.LcBlock64, b, TE.tea.run(ops, TE.tea.unrun(ops, b)), tea_run_unrun(ops, b))

# the shared steps' lemmas as laws, for XTEA

def Laws.tea_steps_round_trip(os, b):
  tea_unrun_run(os, b)

def Laws.tea_steps_round_trip_dual(os, b):
  tea_run_unrun(os, b)


