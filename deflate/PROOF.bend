def fm.law(+a: Bool, +b: Bool, +c: Bool, +d: Bool, +e: Bool, +x: Bool, +m: U32, +ignore: Bool, +rest: B.Octets) -> {Result.is_fail(&2, &2, E.DeflateError, B.Octets, I.inflate_with(I.InflateOptions{m, B.Octets.empty(), ignore}, B.Octets.cons(3, B.Octets.cons(U32{WCon{False{}, WCon{True{}, WCon{a, WCon{b, WCon{c, WCon{d, WCon{e, WCon{x, Word.zero(24n)}}}}}}}}}, rest)))) == True{} : Bool}:
  +w = W.win.of(B.Octets.to_list(B.Octets.empty()))
  +r = U32.to_nat(m)
  +b1 = {U32{WCon{False{}, WCon{True{}, WCon{a, WCon{b, WCon{c, WCon{d, WCon{e, WCon{x, Word.zero(24n)}}}}}}}}} : U32}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.cons(3, B.Octets.cons(b1, rest))), Con{B.byte(3), B.Octets.to_list(B.Octets.cons(b1, rest))}, BL.octets_cons_list(3, B.Octets.cons(b1, rest))) : {Result.is_fail(&2, &2, E.DeflateError, B.Octets, I.inf.whole(I.inf.split.of(I.inf.run.out(w, r, _), m), ignore)) == True{} : Bool}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.cons(b1, rest)), Con{B.byte(b1), B.Octets.to_list(rest)}, BL.octets_cons_list(b1, rest)) : {Result.is_fail(&2, &2, E.DeflateError, B.Octets, I.inf.whole(I.inf.split.of(I.inf.run.out(w, r, Con{B.byte(3), _}), m), ignore)) == True{} : Bool}
  fail_out(I.drv.result(I.drv.go(B.Octets.to_list(rest), I.drv.byte(I.drv.byte(I.drv.start(W.win.empty(), r), 3), b1))), m, ignore, fm.drv(a, b, c, d, e, x, B.Octets.to_list(rest), r))

# Huffman codes: a symbol's code (the path to its leaf) is what the tree
# decodes, whatever follows; so no code is a prefix of another

# decoding from a node, or a leaf reached
def dec1(t: H.DflTree, bits: List<&2, Bool>) -> Maybe<&2, H.DflDecoded>:
  match t:
    case H.DflHLeaf{x}:
      Some{H.DflDecoded{x, bits}}
    case H.DflHNil{}:
      None{}
    case H.DflHNode{z, o}:
      H.hf.decode(bits, H.DflHNode{z, o})

def dz(z: H.DflTree, +o: H.DflTree, +bits: List<&2, Bool>) -> {H.hf.decode(Con{False{}, bits}, H.DflHNode{z, o}) == dec1(z, bits) : Maybe<&2, H.DflDecoded>}:
  match z:
    case H.DflHLeaf{x}:
      {==}
    case H.DflHNil{}:
      {==}
    case H.DflHNode{z2, o2}:
      {==}

def do1(+z: H.DflTree, o: H.DflTree, +bits: List<&2, Bool>) -> {H.hf.decode(Con{True{}, bits}, H.DflHNode{z, o}) == dec1(o, bits) : Maybe<&2, H.DflDecoded>}:
  match o:
    case H.DflHLeaf{x}:
      {==}
    case H.DflHNil{}:
      {==}
    case H.DflHNode{z2, o2}:
      {==}

def pl.ty(m: Maybe<&2, List<&2, Bool>>, t: H.DflTree, s: U32, rest: List<&2, Bool>) -> Type:
  match m:
    case None{}:
      Unit
    case Some{p}:
      {dec1(t, List.append(&2, Bool, p, rest)) == Some{H.DflDecoded{s, rest}} : Maybe<&2, H.DflDecoded>}

def pl.leaf(b: Bool, +x: U32, +s: U32, +rest: List<&2, Bool>, eb: {Q.eq.u32(x, s) == b : Bool}) -> pl.ty(H.hf.path.leaf(b), H.DflHLeaf{x}, s, rest):
  match b:
    case True{}:
      %u32_sound(x, s, eb) : {Some{H.DflDecoded{x, rest}} == Some{H.DflDecoded{_, rest}} : Maybe<&2, H.DflDecoded>}
      {==}
    case False{}:
      Unit{}

def pl.node(vz: Maybe<&2, List<&2, Bool>>, vo: Maybe<&2, List<&2, Bool>>, +z: H.DflTree, +o: H.DflTree, +s: U32, +rest: List<&2, Bool>, ihz: pl.ty(vz, z, s, rest), iho: pl.ty(vo, o, s, rest)) -> pl.ty(H.hf.path.pick(vz, vo), H.DflHNode{z, o}, s, rest):
  match vz:
    case Some{+p}:
      %Equal.sym(Maybe<&2, H.DflDecoded>, H.hf.decode(Con{False{}, List.append(&2, Bool, p, rest)}, H.DflHNode{z, o}), dec1(z, List.append(&2, Bool, p, rest)), dz(z, o, List.append(&2, Bool, p, rest))) : {_ == Some{H.DflDecoded{s, rest}} : Maybe<&2, H.DflDecoded>}
      ihz
    case None{}:
      match vo:
        case Some{+q}:
          %Equal.sym(Maybe<&2, H.DflDecoded>, H.hf.decode(Con{True{}, List.append(&2, Bool, q, rest)}, H.DflHNode{z, o}), dec1(o, List.append(&2, Bool, q, rest)), do1(z, o, List.append(&2, Bool, q, rest))) : {_ == Some{H.DflDecoded{s, rest}} : Maybe<&2, H.DflDecoded>}
          iho
        case None{}:
          Unit{}

def pl(t: H.DflTree, +s: U32, +rest: List<&2, Bool>) -> pl.ty(H.huff_path(t, s), t, s, rest):
  match t:
    case H.DflHNil{}:
      Unit{}
    case H.DflHLeaf{+x}:
      pl.leaf(Q.eq.u32(x, s), x, s, rest, {==})
    case H.DflHNode{+z, +o}:
      pl.node(H.huff_path(z, s), H.huff_path(o, s), z, o, s, rest, pl(z, s, rest), pl(o, s, rest))

def mb.is(m: Maybe<&2, List<&2, Bool>>) -> Type:
  match m:
    case None{}:
      Empty
    case Some{p}:
      Unit

def absurd.ns(-p: List<&2, Bool>, e: {None{} == Some{p} : Maybe<&2, List<&2, Bool>>}) -> Empty:
  %Equal.sym(Maybe<&2, List<&2, Bool>>, None{}, Some{p}, e) : mb.is(_)
  Unit{}

def mb.get(m: Maybe<&2, List<&2, Bool>>) -> List<&2, Bool>:
  match m:
    case None{}:
      Nil{}
    case Some{p}:
      p

def hc.some(m: Maybe<&2, List<&2, Bool>>, +p: List<&2, Bool>, +z: H.DflTree, +o: H.DflTree, +s: U32, +rest: List<&2, Bool>, eh: {m == Some{p} : Maybe<&2, List<&2, Bool>>}, pf: pl.ty(m, H.DflHNode{z, o}, s, rest)) -> {H.hf.decode(List.append(&2, Bool, p, rest), H.DflHNode{z, o}) == Some{H.DflDecoded{s, rest}} : Maybe<&2, H.DflDecoded>}:
  match m:
    case Some{+p2}:
      %Equal.cong(Maybe<&2, List<&2, Bool>>, List<&2, Bool>, v => mb.get(v), Some{p2}, Some{p}, eh) : {H.hf.decode(List.append(&2, Bool, _, rest), H.DflHNode{z, o}) == Some{H.DflDecoded{s, rest}} : Maybe<&2, H.DflDecoded>}
      pf
    case None{}:
      Empty.absurd({H.hf.decode(List.append(&2, Bool, p, rest), H.DflHNode{z, o}) == Some{H.DflDecoded{s, rest}} : Maybe<&2, H.DflDecoded>}, absurd.ns(p, eh))

def hc.tree(t: H.DflTree, +s: U32, +p: List<&2, Bool>, +rest: List<&2, Bool>, h: {H.hf.code.of(t, s) == Some{p} : Maybe<&2, List<&2, Bool>>}) -> {H.huff_decode(t, List.append(&2, Bool, p, rest)) == Some{H.DflDecoded{s, rest}} : Maybe<&2, H.DflDecoded>}:
  match t:
    case H.DflHNode{+z, +o}:
      hc.some(H.huff_path(H.DflHNode{z, o}, s), p, z, o, s, rest, h, pl(H.DflHNode{z, o}, s, rest))
    case H.DflHNil{}:
      Empty.absurd({H.huff_decode(H.DflHNil{}, List.append(&2, Bool, p, rest)) == Some{H.DflDecoded{s, rest}} : Maybe<&2, H.DflDecoded>}, absurd.ns(p, h))
    case H.DflHLeaf{x}:
      Empty.absurd({H.huff_decode(H.DflHLeaf{x}, List.append(&2, Bool, p, rest)) == Some{H.DflDecoded{s, rest}} : Maybe<&2, H.DflDecoded>}, absurd.ns(p, h))

def bool_assoc(a: List<&2, Bool>, +b: List<&2, Bool>, +c: List<&2, Bool>) -> {List.append(&2, Bool, List.append(&2, Bool, a, b), c) == List.append(&2, Bool, a, List.append(&2, Bool, b, c)) : List<&2, Bool>}:
  match a:
    case Nil{}:
      {==}
    case Con{h, t}:
      %bool_assoc(t, b, c) : {Con{h, List.append(&2, Bool, List.append(&2, Bool, t, b), c)} == Con{h, _} : List<&2, Bool>}
      {==}

def dec.sym(m: Maybe<&2, H.DflDecoded>) -> U32:
  match m:
    case None{}:
      0
    case Some{H.DflDecoded{x, r}}:
      x

def hc.prefix(+ls: List<&2, U32>, +s: U32, +t: U32, +p: List<&2, Bool>, +q: List<&2, Bool>, +more: List<&2, Bool>, hs: {H.huff_code(ls, s) == Some{p} : Maybe<&2, List<&2, Bool>>}, ht: {H.huff_code(ls, t) == Some{q} : Maybe<&2, List<&2, Bool>>}, hpq: {p == List.append(&2, Bool, q, more) : List<&2, Bool>}) -> {s == t : U32}:
  +tr = H.huff_tree(ls)
  +m1 = List.append(&2, Bool, more, Nil{})
  +d1 = hc.tree(tr, s, p, Nil{}, hs)
  +d2 = hc.tree(tr, t, q, m1, ht)
  +e1 = Equal.cong(List<&2, Bool>, Maybe<&2, H.DflDecoded>, v => H.huff_decode(tr, List.append(&2, Bool, v, Nil{})), p, List.append(&2, Bool, q, more), hpq)
  +e2 = Equal.cong(List<&2, Bool>, Maybe<&2, H.DflDecoded>, v => H.huff_decode(tr, v), List.append(&2, Bool, List.append(&2, Bool, q, more), Nil{}), List.append(&2, Bool, q, m1), bool_assoc(q, more, Nil{}))
  +all = Equal.trans(Maybe<&2, H.DflDecoded>, Some{H.DflDecoded{s, Nil{}}}, H.huff_decode(tr, List.append(&2, Bool, p, Nil{})), Some{H.DflDecoded{t, m1}}, Equal.sym(Maybe<&2, H.DflDecoded>, H.huff_decode(tr, List.append(&2, Bool, p, Nil{})), Some{H.DflDecoded{s, Nil{}}}, d1), Equal.trans(Maybe<&2, H.DflDecoded>, H.huff_decode(tr, List.append(&2, Bool, p, Nil{})), H.huff_decode(tr, List.append(&2, Bool, List.append(&2, Bool, q, more), Nil{})), Some{H.DflDecoded{t, m1}}, e1, Equal.trans(Maybe<&2, H.DflDecoded>, H.huff_decode(tr, List.append(&2, Bool, List.append(&2, Bool, q, more), Nil{})), H.huff_decode(tr, List.append(&2, Bool, q, m1)), Some{H.DflDecoded{t, m1}}, e2, d2)))
  Equal.cong(Maybe<&2, H.DflDecoded>, U32, v => dec.sym(v), Some{H.DflDecoded{s, Nil{}}}, Some{H.DflDecoded{t, m1}}, all)

# Adler-32 in pieces

def adl_app(xs: List<&2, U32>, +ys: List<&2, U32>, a: A.Adler32) -> {A.adl.go(B.append(xs, ys), a) == A.adl.go(ys, A.adl.go(xs, a)) : A.Adler32}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      adl_app(t, ys, A.adl.step(a, h))

# The laws

def Laws.stored_round_trip(o, m, ignore, h):
  stored_rt(o, m, ignore, h)

def Laws.deflate_round_trip(p, o, m, ignore, h):
  deflate_rt(p, o, m, ignore, h)

def Laws.deflate_level_round_trip(l, o, m, ignore, h):
  deflate_rt(D.DeflateOptions.level(l), o, m, ignore, h)

def Laws.deflate_default_round_trip(o, m, ignore, h):
  deflate_rt(D.DeflateOptions.default(), o, m, ignore, h)

def Laws.adler32_streaming(a, x, y):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(x, y)), B.append(B.Octets.to_list(x), B.Octets.to_list(y)), BL.octets_append_list(x, y)) : {A.adl.go(B.Octets.to_list(y), A.adl.go(B.Octets.to_list(x), a)) == A.adl.go(_, a) : A.Adler32}
  Equal.sym(A.Adler32, A.adl.go(B.append(B.Octets.to_list(x), B.Octets.to_list(y)), a), A.adl.go(B.Octets.to_list(y), A.adl.go(B.Octets.to_list(x), a)), adl_app(B.Octets.to_list(x), B.Octets.to_list(y), a))

def Laws.zlib_round_trip(zo, o, m, d, ignore, h):
  match zo:
    case Z.ZlibOptions{p, f}:
      zl.rt(f, p, o, m, d, ignore, h)

def Laws.gzip_round_trip(p, o, m, d, ignore, h):
  gz.rt(p, o, m, d, ignore, h)

def Laws.output_bounded(opts, src):
  match opts:
    case I.InflateOptions{+max, dict, +ignore}:
      ob.raw(I.inf.run.out(W.win.of(B.Octets.to_list(dict)), U32.to_nat(max), B.Octets.to_list(src)), max, ignore)

def Laws.zlib_output_bounded(opts, src):
  match opts:
    case I.InflateOptions{+max, +dict, +ignore}:
      zob.after(Z.zl.head(B.Octets.to_list(src), dict), max, ignore)

def Laws.gzip_output_bounded(opts, src):
  match opts:
    case I.InflateOptions{+max, dict, +ignore}:
      +xs = B.Octets.to_list(src)
      gob.guard(G.gz.loop(Nat.add(2n, B.len.fast(xs)), G.DflGzGo{xs, U32.to_nat(max), B.Octets.empty()}, ignore), max)

def Laws.bad_block_type(opts, x, rest):
  match opts:
    case I.InflateOptions{+max, +dict, +ignore}:
      bb.core(U32.or(6, U32.shln(x, 3n)), rest, max, dict, ignore, E.DeflateBadBlockType{}, bb.byte6(x, W.win.of(B.Octets.to_list(dict)), U32.to_nat(max)))

def Laws.bad_block_type_final(opts, x, rest):
  match opts:
    case I.InflateOptions{+max, +dict, +ignore}:
      bb.core(U32.or(7, U32.shln(x, 3n)), rest, max, dict, ignore, E.DeflateBadBlockType{}, bb.byte7(x, W.win.of(B.Octets.to_list(dict)), U32.to_nat(max)))

def Laws.first_match_refused(m, ignore, a, b, c, d, e, x, rest):
  fm.law(a, b, c, d, e, x, m, ignore, rest)

def Laws.huff_code_decodes(ls, s, p, rest, h):
  hc.tree(H.huff_tree(ls), s, p, rest, h)

def Laws.huff_prefix_free(ls, s, t, p, q, more, hs, ht, hpq):
  hc.prefix(ls, s, t, p, q, more, hs, ht, hpq)

