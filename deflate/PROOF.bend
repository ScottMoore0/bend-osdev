  %Equal.sym(List<&2, U32>, B.rev(B.rev(B.mask(xs))), B.mask(xs), BL.rev_rev(B.mask(xs))) : {I.inf.whole(I.inf.split.of(Done{I.DflOutRest{B.Octets.of_list(_), Nil{}}}, m), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(B.Octets, B.Octets.of_list(B.mask(xs)), o, of_mask(o)) : {I.inf.whole(I.inf.split.of(Done{I.DflOutRest{_, Nil{}}}, m), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Bool, Nat.is_le(B.Octets.len(o), rm), True{}, h) : {I.inf.whole(I.inf.split.guard(_, o, Nil{}), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  whole_done(ignore, o)

# More room changes nothing but the room left. lift(v, k, y): what y, the
# answer with k more room, must be, given v, the answer without: v's output
# with k more room left if v went through, and anything (y itself) if not.

def app.lift(v: I.DflApp, k: Nat, y: I.DflApp) -> I.DflApp:
  match v:
    case I.DflAppFull{}:
      y
    case I.DflAppOk{a, r}:
      I.DflAppOk{a, Nat.add(r, k)}

def drv.lift(v: I.DflDrv, k: Nat, y: I.DflDrv) -> I.DflDrv:
  match v:
    case I.DflFull{}:
      y
    case I.DflRun{c, a, r}:
      I.DflRun{c, a, Nat.add(r, k)}

def drv.bump(d: I.DflDrv, k: Nat) -> I.DflDrv:
  match d:
    case I.DflFull{}:
      I.DflFull{}
    case I.DflRun{c, a, r}:
      I.DflRun{c, a, Nat.add(r, k)}

def app_room.con(+b: U32, w: I.DflApp, +y: I.DflApp, +k: Nat, ih: {y == app.lift(w, k, y) : I.DflApp}, +v: I.DflApp, e: {I.drv.app.con(b, w) == v : I.DflApp}) -> {I.drv.app.con(b, y) == app.lift(v, k, I.drv.app.con(b, y)) : I.DflApp}:
  match w:
    case I.DflAppFull{}:
      %e : {I.drv.app.con(b, y) == app.lift(_, k, I.drv.app.con(b, y)) : I.DflApp}
      {==}
    case I.DflAppOk{+a, r}:
      match r:
        case 0n:
          %e : {I.drv.app.con(b, y) == app.lift(_, k, I.drv.app.con(b, y)) : I.DflApp}
          {==}
        case 1n+q:
          %e : {I.drv.app.con(b, y) == app.lift(_, k, I.drv.app.con(b, y)) : I.DflApp}
          %Equal.sym(I.DflApp, y, I.DflAppOk{a, 1n+Nat.add(q, k)}, ih) : {I.drv.app.con(b, _) == app.lift(I.DflAppOk{Con{b, a}, q}, k, I.drv.app.con(b, _)) : I.DflApp}
          {==}

def app_room(em: List<&2, U32>, +acc: List<&2, U32>, +r: Nat, +k: Nat, +v: I.DflApp, e: {I.drv.app(em, acc, r) == v : I.DflApp}) -> {I.drv.app(em, acc, Nat.add(r, k)) == app.lift(v, k, I.drv.app(em, acc, Nat.add(r, k))) : I.DflApp}:
  match em:
    case Nil{}:
      %e : {I.DflAppOk{acc, Nat.add(r, k)} == app.lift(_, k, I.DflAppOk{acc, Nat.add(r, k)}) : I.DflApp}
      {==}
    case Con{+b, +t}:
      app_room.con(b, I.drv.app(t, acc, r), I.drv.app(t, acc, Nat.add(r, k)), k, app_room(t, acc, r, k, I.drv.app(t, acc, r), {==}), v, e)

def put_room(x: I.DflApp, +y: I.DflApp, +k: Nat, +l: {y == app.lift(x, k, y) : I.DflApp}, +st: I.DflSt, +win: W.DflWin) -> {I.drv.put(y, st, win) == drv.lift(I.drv.put(x, st, win), k, I.drv.put(y, st, win)) : I.DflDrv}:
  match x:
    case I.DflAppFull{}:
      {==}
    case I.DflAppOk{+a, +r}:
      %Equal.sym(I.DflApp, y, I.DflAppOk{a, Nat.add(r, k)}, l) : {I.drv.put(_, st, win) == drv.lift(I.DflRun{I.DflCore{st, win, Nil{}}, a, r}, k, I.drv.put(_, st, win)) : I.DflDrv}
      {==}

def core_room(cc: I.DflCore, +acc: List<&2, U32>, +r: Nat, +k: Nat) -> {I.drv.core(cc, acc, Nat.add(r, k)) == drv.lift(I.drv.core(cc, acc, r), k, I.drv.core(cc, acc, Nat.add(r, k))) : I.DflDrv}:
  match cc:
    case I.DflCore{+st, +win, +em}:
      put_room(I.drv.app(em, acc, r), I.drv.app(em, acc, Nat.add(r, k)), k, app_room(em, acc, r, k, I.drv.app(em, acc, r), {==}), st, win)

def byte_room(d: I.DflDrv, +h: U32, +k: Nat) -> {I.drv.byte(drv.bump(d, k), h) == drv.lift(I.drv.byte(d, h), k, I.drv.byte(drv.bump(d, k), h)) : I.DflDrv}:
  match d:
    case I.DflFull{}:
      {==}
    case I.DflRun{c, a, r}:
      core_room(I.inf.byte(c, h), a, r, k)

def full_absorbs(xs: List<&2, U32>) -> {I.drv.go(xs, I.DflFull{}) == I.DflFull{} : I.DflDrv}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      full_absorbs(t)

def lift_self(d: I.DflDrv, +k: Nat) -> {drv.bump(d, k) == drv.lift(d, k, drv.bump(d, k)) : I.DflDrv}:
  match d:
    case I.DflFull{}:
      {==}
    case I.DflRun{c, a, r}:
      {==}

def go_room.step(+t: List<&2, U32>, w: I.DflDrv, +y: I.DflDrv, +k: Nat, stepl: {y == drv.lift(w, k, y) : I.DflDrv}, +v: I.DflDrv, e: {I.drv.go(t, w) == v : I.DflDrv}, ih: {I.drv.go(t, drv.bump(w, k)) == drv.lift(v, k, I.drv.go(t, drv.bump(w, k))) : I.DflDrv}) -> {I.drv.go(t, y) == drv.lift(v, k, I.drv.go(t, y)) : I.DflDrv}:
  match w:
    case I.DflFull{}:
      %Equal.trans(I.DflDrv, I.DflFull{}, I.drv.go(t, I.DflFull{}), v, Equal.sym(I.DflDrv, I.drv.go(t, I.DflFull{}), I.DflFull{}, full_absorbs(t)), e) : {I.drv.go(t, y) == drv.lift(_, k, I.drv.go(t, y)) : I.DflDrv}
      {==}
    case I.DflRun{+c, +a, +r}:
      %Equal.sym(I.DflDrv, y, I.DflRun{c, a, Nat.add(r, k)}, stepl) : {I.drv.go(t, _) == drv.lift(v, k, I.drv.go(t, _)) : I.DflDrv}
      ih

# the driver with k more room ends where it ends without, with k more room
# left (if it went through without)
def go_room(xs: List<&2, U32>, +d: I.DflDrv, +k: Nat, +v: I.DflDrv, +e: {I.drv.go(xs, d) == v : I.DflDrv}) -> {I.drv.go(xs, drv.bump(d, k)) == drv.lift(v, k, I.drv.go(xs, drv.bump(d, k))) : I.DflDrv}:
  match xs:
    case Nil{}:
      %e : {drv.bump(d, k) == drv.lift(_, k, drv.bump(d, k)) : I.DflDrv}
      lift_self(d, k)
    case Con{+h, +t}:
      go_room.step(t, I.drv.byte(d, h), I.drv.byte(drv.bump(d, k), h), k, byte_room(d, h, k), v, e, go_room(t, I.drv.byte(d, h), k, v, e))

# Bitwise equality is sound and reflexive

def and_l(a: Bool, b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {a == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

def and_r(a: Bool, b: Bool, h: {Bool.and(a, b) == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      Empty.absurd({b == True{} : Bool}, absurd.ft(h))

def bit_sound(a: Bool, b: Bool, h: {Bool.not(Bool.xor(a, b)) == True{} : Bool}) -> {a == b : Bool}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      Empty.absurd({True{} == False{} : Bool}, absurd.ft(h))
    case False{} True{}:
      Empty.absurd({False{} == True{} : Bool}, absurd.ft(h))
    case False{} False{}:
      {==}

def word_sound(+n: Nat, x: Word(n), y: Word(n), +h: {Q.eq.word(n, x, y) == True{} : Bool}) -> {x == y : Word(n)}:
  match n:
    case 0n:
      match x y:
        case WNil{} WNil{}:
          {==}
    case 1n+p:
      match x y:
        case WCon{+a, +s} WCon{+b, +t}:
          %bit_sound(a, b, and_l(Bool.not(Bool.xor(a, b)), Q.eq.word(p, s, t), h)) : {WCon{a, s} == WCon{_, t} : Word(1n+p)}
          %word_sound(p, s, t, and_r(Bool.not(Bool.xor(a, b)), Q.eq.word(p, s, t), h)) : {WCon{a, s} == WCon{a, _} : Word(1n+p)}
          {==}

def u32_sound(a: U32, b: U32, h: {Q.eq.u32(a, b) == True{} : Bool}) -> {a == b : U32}:
  match a b:
    case U32{+x} U32{+y}:
      %word_sound(32n, x, y, h) : {U32{x} == U32{_} : U32}
      {==}

def word_refl(n: Nat, x: Word(n)) -> {Q.eq.word(n, x, x) == True{} : Bool}:
  match n:
    case 0n:
      match x:
        case WNil{}:
          {==}
    case 1n+p:
      match x:
        case WCon{a, s}:
          match a:
            case True{}:
              word_refl(p, s)
            case False{}:
              word_refl(p, s)

def u32_refl(a: U32) -> {Q.eq.u32(a, a) == True{} : Bool}:
  match a:
    case U32{x}:
      word_refl(32n, x)

def list_live(xs: List<&2, U32>, ys: List<&2, U32>, +live: Bool, +h: {Q.eq.list.go(xs, ys, live) == True{} : Bool}) -> {live == True{} : Bool}:
  match xs ys:
    case Nil{} Nil{}:
      h
    case Con{+a, s} Con{+b, t}:
      and_l(live, Q.eq.u32(a, b), list_live(s, t, Bool.and(live, Q.eq.u32(a, b)), h))
    case Nil{} Con{b, t}:
      Empty.absurd({live == True{} : Bool}, absurd.ft(h))
    case Con{a, s} Nil{}:
      Empty.absurd({live == True{} : Bool}, absurd.ft(h))

def list_go_sound(xs: List<&2, U32>, ys: List<&2, U32>, +live: Bool, +h: {Q.eq.list.go(xs, ys, live) == True{} : Bool}) -> {xs == ys : List<&2, U32>}:
  match xs ys:
    case Nil{} Nil{}:
      {==}
    case Con{+a, +s} Con{+b, +t}:
      %u32_sound(a, b, and_r(live, Q.eq.u32(a, b), list_live(s, t, Bool.and(live, Q.eq.u32(a, b)), h))) : {Con{a, s} == Con{_, t} : List<&2, U32>}
      %list_go_sound(s, t, Bool.and(live, Q.eq.u32(a, b)), h) : {Con{a, s} == Con{a, _} : List<&2, U32>}
      {==}
    case Nil{} Con{b, t}:
      Empty.absurd({Nil{} == Con{b, t} : List<&2, U32>}, absurd.ft(h))
    case Con{a, s} Nil{}:
      Empty.absurd({Con{a, s} == Nil{} : List<&2, U32>}, absurd.ft(h))

def list_sound(xs: List<&2, U32>, ys: List<&2, U32>, +h: {Q.eq.list(xs, ys) == True{} : Bool}) -> {xs == ys : List<&2, U32>}:
  list_go_sound(xs, ys, True{}, h)

# a <= b: b is a plus what lies between

def succ_cong(-a: Nat, -b: Nat, e: {a == b : Nat}) -> {1n+a == 1n+b : Nat}:
  %e : {1n+a == 1n+_ : Nat}
  {==}

def le_add_sub(a: Nat, b: Nat, h: {Nat.is_le(a, b) == True{} : Bool}) -> {b == Nat.add(a, Nat.sub(b, a)) : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      Empty.absurd({0n == Nat.add(1n+p, Nat.sub(0n, 1n+p)) : Nat}, absurd.ft(h))
    case 1n+p 1n+q:
      succ_cong(q, Nat.add(p, Nat.sub(q, p)), le_add_sub(p, q, h))

# The compressor's self-check: when it keeps its stream, that stream inflates
# to o, with any room from len(o) on

def ok_path(+c: B.Octets, +o: B.Octets, +m: U32, +ignore: Bool, +h: {Nat.is_le(B.Octets.len(o), U32.to_nat(m)) == True{} : Bool}, +win: W.DflWin, +acc: List<&2, U32>, +room: Nat, +e: {I.drv.go(B.Octets.to_list(c), I.drv.start(W.win.empty(), B.Octets.len(o))) == I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, room} : I.DflDrv}, +eb: {Q.eq.list(B.rev(acc), B.Octets.to_list(o)) == True{} : Bool}) -> {I.inflate_with(I.InflateOptions{m, B.Octets.empty(), ignore}, c) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}:
  +xs = B.Octets.to_list(c)
  +n = B.Octets.len(o)
  +rm = U32.to_nat(m)
  +k = Nat.sub(rm, n)
  +w0 = W.win.of(B.Octets.to_list(B.Octets.empty()))
  +s0 = I.drv.start(W.win.empty(), n)
  %Equal.sym(Nat, rm, Nat.add(n, k), le_add_sub(n, rm, h)) : {I.inf.whole(I.inf.split.of(I.inf.run.out(w0, _, xs), m), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(I.DflDrv, I.drv.go(xs, drv.bump(s0, k)), I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, Nat.add(room, k)}, go_room(xs, s0, k, I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, room}, e)) : {I.inf.whole(I.inf.split.of(I.inf.out(I.drv.result(_)), m), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(List<&2, U32>, B.rev(acc), B.Octets.to_list(o), list_sound(B.rev(acc), B.Octets.to_list(o), eb)) : {I.inf.whole(I.inf.split.of(Done{I.DflOutRest{B.Octets.of_list(_), Nil{}}}, m), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(o)), o, BL.octets_of_to(o)) : {I.inf.whole(I.inf.split.of(Done{I.DflOutRest{_, Nil{}}}, m), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Bool, Nat.is_le(B.Octets.len(o), rm), True{}, h) : {I.inf.whole(I.inf.split.guard(_, o, Nil{}), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  whole_done(ignore, o)

def dr.keep(b: Bool, +c: B.Octets, +o: B.Octets, +m: U32, +ignore: Bool, +h: {Nat.is_le(B.Octets.len(o), U32.to_nat(m)) == True{} : Bool}, +win: W.DflWin, +acc: List<&2, U32>, +room: Nat, +e: {I.drv.go(B.Octets.to_list(c), I.drv.start(W.win.empty(), B.Octets.len(o))) == I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, room} : I.DflDrv}, +eb: {Q.eq.list(B.rev(acc), B.Octets.to_list(o)) == b : Bool}) -> {I.inflate_with(I.InflateOptions{m, B.Octets.empty(), ignore}, D.dfl.keep(b, c, o)) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}:
  match b:
    case True{}:
      ok_path(c, o, m, ignore, h, win, acc, room, e, eb)
    case False{}:
      stored_rt(o, m, ignore, h)

def dr.check(r: I.DflDrv, +c: B.Octets, +o: B.Octets, +m: U32, +ignore: Bool, +h: {Nat.is_le(B.Octets.len(o), U32.to_nat(m)) == True{} : Bool}, +e: {I.drv.go(B.Octets.to_list(c), I.drv.start(W.win.empty(), B.Octets.len(o))) == r : I.DflDrv}) -> {I.inflate_with(I.InflateOptions{m, B.Octets.empty(), ignore}, D.dfl.check(r, c, o)) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}:
  match r:
    case I.DflFull{}:
      stored_rt(o, m, ignore, h)
    case I.DflRun{core, +acc, +room}:
      match core:
        case I.DflCore{st, +win, em}:
          match st:
            case I.DflEnd{rest}:
              match rest:
                case Nil{}:
                  match em:
                    case Nil{}:
                      dr.keep(Q.eq.list(B.rev(acc), B.Octets.to_list(o)), c, o, m, ignore, h, win, acc, room, e, {==})
                    case Con{x, y}:
                      stored_rt(o, m, ignore, h)
                case Con{x, y}:
                  stored_rt(o, m, ignore, h)
            case I.DflField{l1, s1, v1, k1}:
              stored_rt(o, m, ignore, h)
            case I.DflSym{n1, k1}:
              stored_rt(o, m, ignore, h)
            case I.DflAlign{f1}:
              stored_rt(o, m, ignore, h)
            case I.DflStoredLen{n1, v1, f1}:
              stored_rt(o, m, ignore, h)
            case I.DflStored{l1, f1}:
              stored_rt(o, m, ignore, h)
            case I.DflBad{e1}:
              stored_rt(o, m, ignore, h)

def deflate_rt(+p: D.DeflateOptions, +o: B.Octets, +m: U32, +ignore: Bool, +h: {Nat.is_le(B.Octets.len(o), U32.to_nat(m)) == True{} : Bool}) -> {I.inflate_with(I.InflateOptions{m, B.Octets.empty(), ignore}, D.deflate_with(p, o)) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}:
  +c = D.deflate_unchecked_with(p, o)
  dr.check(I.drv.go(B.Octets.to_list(c), I.drv.start(W.win.empty(), B.Octets.len(o))), c, o, m, ignore, h, {==})

# The same, with any bytes t after the stream (the zlib and gzip trailers):
# the stream gives o back and hands t on

def stored_rt_t(+o: B.Octets, +r: Nat, +t: List<&2, U32>, +h: {Nat.is_le(B.Octets.len(o), r) == True{} : Bool}) -> {I.inf.run.out(W.win.empty(), r, B.append(B.Octets.to_list(D.stored_stream(o)), t)) == Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}:
  +xs = B.Octets.to_list(o)
  +l = D.fb.go(xs, 0n)
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(l)), B.mask(l), BL.octets_to_of(l)) : {I.inf.run.out(W.win.empty(), r, B.append(_, t)) == Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(Result<&2, &2, E.DeflateError, I.DflRaw>, I.drv.result(I.drv.go(B.append(B.mask(l), t), I.DflRun{I.DflCore{I.inf.stored.next(0n, False{}), W.win.empty(), Nil{}}, Nil{}, r})), Done{I.DflRaw{B.rev_onto(B.mask(xs), Nil{}), t}}, fbs(xs, 0n, Nil{}, W.win.empty(), r, t, le_zero(B.len(xs)), len_hyp(o, r, h))) : {I.inf.out(_) == Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(List<&2, U32>, B.rev(B.rev(B.mask(xs))), B.mask(xs), BL.rev_rev(B.mask(xs))) : {Done{I.DflOutRest{B.Octets.of_list(_), t}} == Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(B.Octets, B.Octets.of_list(B.mask(xs)), o, of_mask(o)) : {Done{I.DflOutRest{_, t}} == Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  {==}

def ok_path_t(+c: B.Octets, +o: B.Octets, +r: Nat, +t: List<&2, U32>, +h: {Nat.is_le(B.Octets.len(o), r) == True{} : Bool}, +win: W.DflWin, +acc: List<&2, U32>, +room: Nat, +e: {I.drv.go(B.Octets.to_list(c), I.drv.start(W.win.empty(), B.Octets.len(o))) == I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, room} : I.DflDrv}, +eb: {Q.eq.list(B.rev(acc), B.Octets.to_list(o)) == True{} : Bool}) -> {I.inf.run.out(W.win.empty(), r, B.append(B.Octets.to_list(c), t)) == Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}:
  +xs = B.Octets.to_list(c)
  +n = B.Octets.len(o)
  +k = Nat.sub(r, n)
  +s0 = I.drv.start(W.win.empty(), n)
  +goal = {Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(Nat, r, Nat.add(n, k), le_add_sub(n, r, h)) : {I.inf.run.out(W.win.empty(), _, B.append(xs, t)) == goal : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(I.DflDrv, I.drv.go(B.append(xs, t), drv.bump(s0, k)), I.drv.go(t, I.drv.go(xs, drv.bump(s0, k))), go_append(xs, t, drv.bump(s0, k))) : {I.inf.out(I.drv.result(_)) == goal : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(I.DflDrv, I.drv.go(xs, drv.bump(s0, k)), I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, Nat.add(room, k)}, go_room(xs, s0, k, I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, room}, e)) : {I.inf.out(I.drv.result(I.drv.go(t, _))) == goal : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(I.DflDrv, I.drv.go(t, I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, Nat.add(room, k)}), I.DflRun{I.DflCore{I.DflEnd{B.rev_onto(t, Nil{})}, win, Nil{}}, acc, Nat.add(room, k)}, end_absorbs(t, Nil{}, win, acc, Nat.add(room, k))) : {I.inf.out(I.drv.result(_)) == goal : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(List<&2, U32>, B.rev(B.rev(t)), t, BL.rev_rev(t)) : {Done{I.DflOutRest{B.Octets.of_list(B.rev(acc)), _}} == goal : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(List<&2, U32>, B.rev(acc), B.Octets.to_list(o), list_sound(B.rev(acc), B.Octets.to_list(o), eb)) : {Done{I.DflOutRest{B.Octets.of_list(_), t}} == goal : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(o)), o, BL.octets_of_to(o)) : {Done{I.DflOutRest{_, t}} == goal : Result<&2, &2, E.DeflateError, I.DflOutRest>}
  {==}

def rt.keep(b: Bool, +c: B.Octets, +o: B.Octets, +r: Nat, +t: List<&2, U32>, +h: {Nat.is_le(B.Octets.len(o), r) == True{} : Bool}, +win: W.DflWin, +acc: List<&2, U32>, +room: Nat, +e: {I.drv.go(B.Octets.to_list(c), I.drv.start(W.win.empty(), B.Octets.len(o))) == I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, room} : I.DflDrv}, +eb: {Q.eq.list(B.rev(acc), B.Octets.to_list(o)) == b : Bool}) -> {I.inf.run.out(W.win.empty(), r, B.append(B.Octets.to_list(D.dfl.keep(b, c, o)), t)) == Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}:
  match b:
    case True{}:
      ok_path_t(c, o, r, t, h, win, acc, room, e, eb)
    case False{}:
      stored_rt_t(o, r, t, h)

def rt.check(d: I.DflDrv, +c: B.Octets, +o: B.Octets, +r: Nat, +t: List<&2, U32>, +h: {Nat.is_le(B.Octets.len(o), r) == True{} : Bool}, +e: {I.drv.go(B.Octets.to_list(c), I.drv.start(W.win.empty(), B.Octets.len(o))) == d : I.DflDrv}) -> {I.inf.run.out(W.win.empty(), r, B.append(B.Octets.to_list(D.dfl.check(d, c, o)), t)) == Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}:
  match d:
    case I.DflFull{}:
      stored_rt_t(o, r, t, h)
    case I.DflRun{core, +acc, +room}:
      match core:
        case I.DflCore{st, +win, em}:
          match st:
            case I.DflEnd{rest}:
              match rest:
                case Nil{}:
                  match em:
                    case Nil{}:
                      rt.keep(Q.eq.list(B.rev(acc), B.Octets.to_list(o)), c, o, r, t, h, win, acc, room, e, {==})
                    case Con{x, y}:
                      stored_rt_t(o, r, t, h)
                case Con{x, y}:
                  stored_rt_t(o, r, t, h)
            case I.DflField{l1, s1, v1, k1}:
              stored_rt_t(o, r, t, h)
            case I.DflSym{n1, k1}:
              stored_rt_t(o, r, t, h)
            case I.DflAlign{f1}:
              stored_rt_t(o, r, t, h)
            case I.DflStoredLen{n1, v1, f1}:
              stored_rt_t(o, r, t, h)
            case I.DflStored{l1, f1}:
              stored_rt_t(o, r, t, h)
            case I.DflBad{e1}:
              stored_rt_t(o, r, t, h)

# the raw stream deflate_with writes, then any bytes t: o, then t
def deflate_rt_t(+p: D.DeflateOptions, +o: B.Octets, +r: Nat, +t: List<&2, U32>, +h: {Nat.is_le(B.Octets.len(o), r) == True{} : Bool}) -> {I.inf.run.out(W.win.empty(), r, B.append(B.Octets.to_list(D.deflate_with(p, o)), t)) == Done{I.DflOutRest{o, t}} : Result<&2, &2, E.DeflateError, I.DflOutRest>}:
  +c = D.deflate_unchecked_with(p, o)
  rt.check(I.drv.go(B.Octets.to_list(c), I.drv.start(W.win.empty(), B.Octets.len(o))), c, o, r, t, h, {==})


# The wrappers' trailers: a 32-bit field is four bytes

def be32_len4(v: U32) -> {B.len(B.mask(B.be32(v))) == 4n : Nat}:
  match v:
    case U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, WCon{b16, WCon{b17, WCon{b18, WCon{b19, WCon{b20, WCon{b21, WCon{b22, WCon{b23, WCon{b24, WCon{b25, WCon{b26, WCon{b27, WCon{b28, WCon{b29, WCon{b30, WCon{b31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      {==}

def le32_len4(v: U32) -> {B.len(B.mask(B.le32(v))) == 4n : Nat}:
  match v:
    case U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, WCon{b16, WCon{b17, WCon{b18, WCon{b19, WCon{b20, WCon{b21, WCon{b22, WCon{b23, WCon{b24, WCon{b25, WCon{b26, WCon{b27, WCon{b28, WCon{b29, WCon{b30, WCon{b31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      {==}

def be32_len(+v: U32) -> {B.Octets.len(B.Octets.be32(v)) == 4n : Nat}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.be32(v)), B.len(B.Octets.to_list(B.Octets.be32(v))), BL.octets_len_list(B.Octets.be32(v))) : {_ == 4n : Nat}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(B.be32(v))), B.mask(B.be32(v)), BL.octets_to_of(B.be32(v))) : {B.len(_) == 4n : Nat}
  be32_len4(v)

def le32_len(+v: U32) -> {B.Octets.len(B.Octets.le32(v)) == 4n : Nat}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.le32(v)), B.len(B.Octets.to_list(B.Octets.le32(v))), BL.octets_len_list(B.Octets.le32(v))) : {_ == 4n : Nat}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(B.le32(v))), B.mask(B.le32(v)), BL.octets_to_of(B.le32(v))) : {B.len(_) == 4n : Nat}
  le32_len4(v)

# zlib: after the header, the stream and ADLER32

def zl.end(ignore: Bool, +o: B.Octets, +a: U32) -> {Z.zl.check(True{}, o, B.Octets.be32(a), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}:
  match ignore:
    case True{}:
      {==}
    case False{}:
      %Equal.sym(Nat, B.Octets.len(B.Octets.be32(a)), 4n, be32_len(a)) : {Z.zl.check.rest(Z.zl.none(Nat.sub(_, 4n)), o) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
      {==}

def zl.body_rt(+p: D.DeflateOptions, +o: B.Octets, +m: U32, +ignore: Bool, +h: {Nat.is_le(B.Octets.len(o), U32.to_nat(m)) == True{} : Bool}) -> {Z.zl.inflate(W.win.empty(), m, ignore, B.append(B.Octets.to_list(D.deflate_with(p, o)), B.Octets.to_list(B.Octets.be32(A.adler32(o))))) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}:
  +a = A.adler32(o)
  +t = B.Octets.to_list(B.Octets.be32(a))
  +r = U32.to_nat(m)
  %Equal.sym(Result<&2, &2, E.DeflateError, I.DflOutRest>, I.inf.run.out(W.win.empty(), r, B.append(B.Octets.to_list(D.deflate_with(p, o)), t)), Done{I.DflOutRest{o, t}}, deflate_rt_t(p, o, r, t, h)) : {Z.zl.body(_, m, ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Bool, Nat.is_le(B.Octets.len(o), r), True{}, h) : {Z.zl.guard(_, o, B.Octets.of_list(t), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(B.Octets, B.Octets.of_list(t), B.Octets.be32(a), BL.octets_of_to(B.Octets.be32(a))) : {Z.zl.trailer(B.Octets.be32_at(_, 0n), o, _, ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Maybe<&2, U32>, B.Octets.be32_at(B.Octets.be32(a), 0n), Some{a}, BL.octets_be32_round_trip(a)) : {Z.zl.trailer(_, o, B.Octets.be32(a), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Bool, Q.eq.u32(a, a), True{}, u32_refl(a)) : {Z.zl.check(_, o, B.Octets.be32(a), ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  zl.end(ignore, o, a)

def zl.rt(f: Z.DflFlevel, +p: D.DeflateOptions, +o: B.Octets, +m: U32, +d: B.Octets, +ignore: Bool, +h: {Nat.is_le(B.Octets.len(o), U32.to_nat(m)) == True{} : Bool}) -> {Z.zlib_decompress_with(I.InflateOptions{m, d, ignore}, Z.zlib_compress_with(Z.ZlibOptions{p, f}, o)) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}:
  match f:
    case Z.DflFlevelFastest{}:
      +c = D.deflate_with(p, o)
      +tr = B.Octets.be32(A.adler32(o))
      +opts = {I.InflateOptions{m, d, ignore} : I.InflateOptions}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(B.Octets.of_list(Z.zl.header(Z.DflFlevelFastest{})), B.Octets.append(c, tr))), B.append(B.Octets.to_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelFastest{}))), B.Octets.to_list(B.Octets.append(c, tr))), BL.octets_append_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelFastest{})), B.Octets.append(c, tr))) : {Z.zl.decode(_, opts) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(c, tr)), B.append(B.Octets.to_list(c), B.Octets.to_list(tr)), BL.octets_append_list(c, tr)) : {Z.zl.decode(B.append(B.Octets.to_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelFastest{}))), _), opts) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
      zl.body_rt(p, o, m, ignore, h)
    case Z.DflFlevelFast{}:
      +c = D.deflate_with(p, o)
      +tr = B.Octets.be32(A.adler32(o))
      +opts = {I.InflateOptions{m, d, ignore} : I.InflateOptions}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(B.Octets.of_list(Z.zl.header(Z.DflFlevelFast{})), B.Octets.append(c, tr))), B.append(B.Octets.to_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelFast{}))), B.Octets.to_list(B.Octets.append(c, tr))), BL.octets_append_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelFast{})), B.Octets.append(c, tr))) : {Z.zl.decode(_, opts) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(c, tr)), B.append(B.Octets.to_list(c), B.Octets.to_list(tr)), BL.octets_append_list(c, tr)) : {Z.zl.decode(B.append(B.Octets.to_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelFast{}))), _), opts) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
      zl.body_rt(p, o, m, ignore, h)
    case Z.DflFlevelDefault{}:
      +c = D.deflate_with(p, o)
      +tr = B.Octets.be32(A.adler32(o))
      +opts = {I.InflateOptions{m, d, ignore} : I.InflateOptions}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(B.Octets.of_list(Z.zl.header(Z.DflFlevelDefault{})), B.Octets.append(c, tr))), B.append(B.Octets.to_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelDefault{}))), B.Octets.to_list(B.Octets.append(c, tr))), BL.octets_append_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelDefault{})), B.Octets.append(c, tr))) : {Z.zl.decode(_, opts) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(c, tr)), B.append(B.Octets.to_list(c), B.Octets.to_list(tr)), BL.octets_append_list(c, tr)) : {Z.zl.decode(B.append(B.Octets.to_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelDefault{}))), _), opts) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
      zl.body_rt(p, o, m, ignore, h)
    case Z.DflFlevelMax{}:
      +c = D.deflate_with(p, o)
      +tr = B.Octets.be32(A.adler32(o))
      +opts = {I.InflateOptions{m, d, ignore} : I.InflateOptions}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(B.Octets.of_list(Z.zl.header(Z.DflFlevelMax{})), B.Octets.append(c, tr))), B.append(B.Octets.to_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelMax{}))), B.Octets.to_list(B.Octets.append(c, tr))), BL.octets_append_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelMax{})), B.Octets.append(c, tr))) : {Z.zl.decode(_, opts) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(c, tr)), B.append(B.Octets.to_list(c), B.Octets.to_list(tr)), BL.octets_append_list(c, tr)) : {Z.zl.decode(B.append(B.Octets.to_list(B.Octets.of_list(Z.zl.header(Z.DflFlevelMax{}))), _), opts) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
      zl.body_rt(p, o, m, ignore, h)

# Octets: joining the empty string changes nothing

def app_empty(+a: B.Octets) -> {B.Octets.append(a, B.Octets.empty()) == a : B.Octets}:
  %BL.octets_of_to(B.Octets.append(a, B.Octets.empty())) : {_ == a : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(a, B.Octets.empty())), B.append(B.Octets.to_list(a), B.Octets.to_list(B.Octets.empty())), BL.octets_append_list(a, B.Octets.empty())) : {B.Octets.of_list(_) == a : B.Octets}
  %Equal.sym(List<&2, U32>, B.append(B.Octets.to_list(a), Nil{}), B.Octets.to_list(a), append_nil(B.Octets.to_list(a))) : {B.Octets.of_list(_) == a : B.Octets}
  BL.octets_of_to(a)

def empty_app(+a: B.Octets) -> {B.Octets.append(B.Octets.empty(), a) == a : B.Octets}:
  %BL.octets_of_to(B.Octets.append(B.Octets.empty(), a)) : {_ == a : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(B.Octets.empty(), a)), B.append(B.Octets.to_list(B.Octets.empty()), B.Octets.to_list(a)), BL.octets_append_list(B.Octets.empty(), a)) : {B.Octets.of_list(_) == a : B.Octets}
  BL.octets_of_to(a)

# gzip, one member with the default header

def gz.rt(+p: D.DeflateOptions, +o: B.Octets, +m: U32, +d: B.Octets, +ignore: Bool, +h: {Nat.is_le(B.Octets.len(o), U32.to_nat(m)) == True{} : Bool}) -> {G.gzip_decompress_with(I.InflateOptions{m, d, ignore}, G.gzip_compress_with(G.GzipOptions{p, G.GzipHeader.default()}, o)) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}:
  +hd = B.Octets.of_list(G.gzip_header_bytes(G.GzipHeader.default()))
  +c = D.deflate_with(p, o)
  +crc = G.gz.crc32(o)
  +sz = U32.from_nat(B.Octets.len(o))
  +a1 = B.Octets.le32(crc)
  +a2 = B.Octets.le32(sz)
  +trl = B.Octets.append(a1, a2)
  +t = B.Octets.to_list(trl)
  +r = U32.to_nat(m)
  +xs = B.append(B.Octets.to_list(hd), B.append(B.Octets.to_list(c), t))
  +e0 = B.Octets.empty()
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(hd, B.Octets.append(c, trl))), B.append(B.Octets.to_list(hd), B.Octets.to_list(B.Octets.append(c, trl))), BL.octets_append_list(hd, B.Octets.append(c, trl))) : {G.gz.run(_, m, ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(c, trl)), B.append(B.Octets.to_list(c), t), BL.octets_append_list(c, trl)) : {G.gz.run(B.append(B.Octets.to_list(hd), _), m, ignore) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Result<&2, &2, E.DeflateError, I.DflOutRest>, I.inf.run.out(W.win.empty(), r, B.append(B.Octets.to_list(c), t)), Done{I.DflOutRest{o, t}}, deflate_rt_t(p, o, r, t, h)) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.body(_), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(B.Octets, B.Octets.of_list(t), trl, BL.octets_of_to(trl)) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.trailer(B.Octets.split_at(4n, _), o), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %le32_len(crc) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.trailer(B.Octets.split_at(_, trl), o), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Maybe<&2, B.OctetsSplit>, B.Octets.split_at(B.Octets.len(a1), trl), Some{B.OctetsSplit{a1, a2}}, BL.octets_split_at_append(a1, a2)) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.trailer(_, o), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Maybe<&2, U32>, B.Octets.le32_at(a1, 0n), Some{crc}, BL.octets_le32_round_trip(crc)) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.crc.at(_, o, a2), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Bool, Q.eq.u32(crc, crc), True{}, u32_refl(crc)) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.crc.ok(_, o, a2), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %app_empty(a2) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.size(B.Octets.split_at(4n, _), o), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %le32_len(sz) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.size(B.Octets.split_at(_, B.Octets.append(a2, e0)), o), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Maybe<&2, B.OctetsSplit>, B.Octets.split_at(B.Octets.len(a2), B.Octets.append(a2, e0)), Some{B.OctetsSplit{a2, e0}}, BL.octets_split_at_append(a2, e0)) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.size(_, o), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Maybe<&2, U32>, B.Octets.le32_at(a2, 0n), Some{sz}, BL.octets_le32_round_trip(sz)) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.size.at(_, o, e0), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Bool, Q.eq.u32(sz, sz), True{}, u32_refl(sz)) : {G.gz.guard(G.gz.loop(1n+B.len.fast(xs), G.gz.step.of(G.gz.size.ok(_, o, e0), ignore, r, e0), ignore), m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(B.Octets, B.Octets.append(e0, o), o, empty_app(o)) : {G.gz.guard(Done{_}, m) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(Bool, Nat.is_le(B.Octets.len(o), r), True{}, h) : {G.gz.guard.ok(_, o) == Done{o} : Result<&2, &2, E.DeflateError, B.Octets>}
  {==}

# Never more than the maximum: every answer passes a final guard

def ob.none(n: Nat, +max: U32, +out: B.Octets, +eb: {Nat.is_le(B.Octets.len(out), U32.to_nat(max)) == True{} : Bool}) -> {Laws.deflate_within(max, I.inf.whole.none(n, out)) == True{} : Bool}:
  match n:
    case 0n:
      eb
    case 1n+q:
      {==}

def ob.guard(b: Bool, +max: U32, +out: B.Octets, +rest: List<&2, U32>, ignore: Bool, +eb: {Nat.is_le(B.Octets.len(out), U32.to_nat(max)) == b : Bool}) -> {Laws.deflate_within(max, I.inf.whole(I.inf.split.guard(b, out, rest), ignore)) == True{} : Bool}:
  match b:
    case True{}:
      match ignore:
        case True{}:
          eb
        case False{}:
          ob.none(B.Octets.len(B.Octets.of_list(rest)), max, out, eb)
    case False{}:
      {==}

def ob.raw(r: Result<&2, &2, E.DeflateError, I.DflOutRest>, +max: U32, +ignore: Bool) -> {Laws.deflate_within(max, I.inf.whole(I.inf.split.of(r, max), ignore)) == True{} : Bool}:
  match r:
    case Fail{e}:
      {==}
    case Done{I.DflOutRest{+out, +rest}}:
      ob.guard(Nat.is_le(B.Octets.len(out), U32.to_nat(max)), max, out, rest, ignore, {==})

# zlib: through each check of the header and the trailer

def zob.rest(none: Bool, +max: U32, +out: B.Octets, +eb: {Nat.is_le(B.Octets.len(out), U32.to_nat(max)) == True{} : Bool}) -> {Laws.deflate_within(max, Z.zl.check.rest(none, out)) == True{} : Bool}:
  match none:
    case True{}:
      eb
    case False{}:
      {==}

def zob.check(ok: Bool, +max: U32, +out: B.Octets, +rest: B.Octets, ignore: Bool, +eb: {Nat.is_le(B.Octets.len(out), U32.to_nat(max)) == True{} : Bool}) -> {Laws.deflate_within(max, Z.zl.check(ok, out, rest, ignore)) == True{} : Bool}:
  match ok:
    case True{}:
      match ignore:
        case True{}:
          eb
        case False{}:
          zob.rest(Z.zl.none(Nat.sub(B.Octets.len(rest), 4n)), max, out, eb)
    case False{}:
      {==}

def zob.trailer(m: Maybe<&2, U32>, +max: U32, +out: B.Octets, +rest: B.Octets, +ignore: Bool, +eb: {Nat.is_le(B.Octets.len(out), U32.to_nat(max)) == True{} : Bool}) -> {Laws.deflate_within(max, Z.zl.trailer(m, out, rest, ignore)) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{v}:
      zob.check(Q.eq.u32(v, A.adler32(out)), max, out, rest, ignore, eb)

def zob.guard(b: Bool, +max: U32, +out: B.Octets, +rest: B.Octets, +ignore: Bool, +eb: {Nat.is_le(B.Octets.len(out), U32.to_nat(max)) == b : Bool}) -> {Laws.deflate_within(max, Z.zl.guard(b, out, rest, ignore)) == True{} : Bool}:
  match b:
    case True{}:
      zob.trailer(B.Octets.be32_at(rest, 0n), max, out, rest, ignore, eb)
    case False{}:
      {==}

def zob.body(r: Result<&2, &2, E.DeflateError, I.DflOutRest>, +max: U32, +ignore: Bool) -> {Laws.deflate_within(max, Z.zl.body(r, max, ignore)) == True{} : Bool}:
  match r:
    case Fail{e}:
      {==}
    case Done{I.DflOutRest{+out, rest}}:
      zob.guard(Nat.is_le(B.Octets.len(out), U32.to_nat(max)), max, out, B.Octets.of_list(rest), ignore, {==})

def zob.inflate(+win: W.DflWin, +max: U32, +ignore: Bool, +xs: List<&2, U32>) -> {Laws.deflate_within(max, Z.zl.inflate(win, max, ignore, xs)) == True{} : Bool}:
  zob.body(I.inf.run.out(win, U32.to_nat(max), xs), max, ignore)

def zob.after(r: Result<&2, &2, E.DeflateError, Z.DflZlibHead>, +max: U32, +ignore: Bool) -> {Laws.deflate_within(max, Z.zl.after(r, max, ignore)) == True{} : Bool}:
  match r:
    case Fail{e}:
      {==}
    case Done{Z.DflZlibHead{+win, +rest}}:
      zob.inflate(win, max, ignore, rest)

# gzip: the final guard

def gob.ok(b: Bool, +max: U32, +o: B.Octets, +eb: {Nat.is_le(B.Octets.len(o), U32.to_nat(max)) == b : Bool}) -> {Laws.deflate_within(max, G.gz.guard.ok(b, o)) == True{} : Bool}:
  match b:
    case True{}:
      eb
    case False{}:
      {==}

def gob.guard(r: Result<&2, &2, E.DeflateError, B.Octets>, +max: U32) -> {Laws.deflate_within(max, G.gz.guard(r, max)) == True{} : Bool}:
  match r:
    case Fail{e}:
      {==}
    case Done{+o}:
      gob.ok(Nat.is_le(B.Octets.len(o), U32.to_nat(max)), max, o, {==})

# A failed stream stays failed

def bad_absorbs(t: List<&2, U32>, +e: E.DeflateError, +win: W.DflWin, +acc: List<&2, U32>, +room: Nat) -> {I.drv.go(t, I.DflRun{I.DflCore{I.DflBad{e}, win, Nil{}}, acc, room}) == I.DflRun{I.DflCore{I.DflBad{e}, win, Nil{}}, acc, room} : I.DflDrv}:
  match t:
    case Nil{}:
      {==}
    case Con{h, u}:
      bad_absorbs(u, e, win, acc, room)

def fail_out(r: Result<&2, &2, E.DeflateError, I.DflRaw>, +m: U32, +ignore: Bool, h: {Result.is_fail(&2, &2, E.DeflateError, I.DflRaw, r) == True{} : Bool}) -> {Result.is_fail(&2, &2, E.DeflateError, B.Octets, I.inf.whole(I.inf.split.of(I.inf.out(r), m), ignore)) == True{} : Bool}:
  match r:
    case Fail{e}:
      {==}
    case Done{x}:
      Empty.absurd({Result.is_fail(&2, &2, E.DeflateError, B.Octets, I.inf.whole(I.inf.split.of(I.inf.out(Done{x}), m), ignore)) == True{} : Bool}, absurd.ft(h))

# BTYPE 11: the first byte's three header bits, whatever its other five

def bb.byte6(x: U32, +win: W.DflWin, +r: Nat) -> {I.drv.byte(I.drv.start(win, r), B.byte(U32.or(6, U32.shln(x, 3n)))) == I.DflRun{I.DflCore{I.DflBad{E.DeflateBadBlockType{}}, win, Nil{}}, Nil{}, r} : I.DflDrv}:
  match x:
    case U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, WCon{b16, WCon{b17, WCon{b18, WCon{b19, WCon{b20, WCon{b21, WCon{b22, WCon{b23, WCon{b24, WCon{b25, WCon{b26, WCon{b27, WCon{b28, WCon{b29, WCon{b30, WCon{b31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      {==}

def bb.byte7(x: U32, +win: W.DflWin, +r: Nat) -> {I.drv.byte(I.drv.start(win, r), B.byte(U32.or(7, U32.shln(x, 3n)))) == I.DflRun{I.DflCore{I.DflBad{E.DeflateBadBlockType{}}, win, Nil{}}, Nil{}, r} : I.DflDrv}:
  match x:
    case U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, WCon{b16, WCon{b17, WCon{b18, WCon{b19, WCon{b20, WCon{b21, WCon{b22, WCon{b23, WCon{b24, WCon{b25, WCon{b26, WCon{b27, WCon{b28, WCon{b29, WCon{b30, WCon{b31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      {==}

# a first byte that fails the stream at once fails it whatever follows
def bb.core(+b: U32, +rest: B.Octets, +max: U32, +dict: B.Octets, +ignore: Bool, +e: E.DeflateError, +hb: {I.drv.byte(I.drv.start(W.win.of(B.Octets.to_list(dict)), U32.to_nat(max)), B.byte(b)) == I.DflRun{I.DflCore{I.DflBad{e}, W.win.of(B.Octets.to_list(dict)), Nil{}}, Nil{}, U32.to_nat(max)} : I.DflDrv}) -> {I.inflate_with(I.InflateOptions{max, dict, ignore}, B.Octets.cons(b, rest)) == Fail{e} : Result<&2, &2, E.DeflateError, B.Octets>}:
  +w = W.win.of(B.Octets.to_list(dict))
  +r = U32.to_nat(max)
  +t = B.Octets.to_list(rest)
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.cons(b, rest)), Con{B.byte(b), t}, BL.octets_cons_list(b, rest)) : {I.inf.whole(I.inf.split.of(I.inf.run.out(w, r, _), max), ignore) == Fail{e} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(I.DflDrv, I.drv.byte(I.drv.start(w, r), B.byte(b)), I.DflRun{I.DflCore{I.DflBad{e}, w, Nil{}}, Nil{}, r}, hb) : {I.inf.whole(I.inf.split.of(I.inf.out(I.drv.result(I.drv.go(t, _))), max), ignore) == Fail{e} : Result<&2, &2, E.DeflateError, B.Octets>}
  %Equal.sym(I.DflDrv, I.drv.go(t, I.DflRun{I.DflCore{I.DflBad{e}, w, Nil{}}, Nil{}, r}), I.DflRun{I.DflCore{I.DflBad{e}, w, Nil{}}, Nil{}, r}, bad_absorbs(t, e, w, Nil{}, r)) : {I.inf.whole(I.inf.split.of(I.inf.out(I.drv.result(_)), max), ignore) == Fail{e} : Result<&2, &2, E.DeflateError, B.Octets>}
  {==}

# a final fixed block whose first symbol is length code 257, then each of
# the 32 distance codes: refused at the distance
def fm.case(+t: List<&2, U32>, +r: Nat, +err: E.DeflateError, +s: I.DflDrv, +h: {s == I.DflRun{I.DflCore{I.DflBad{err}, W.win.empty(), Nil{}}, Nil{}, r} : I.DflDrv}) -> {Result.is_fail(&2, &2, E.DeflateError, I.DflRaw, I.drv.result(I.drv.go(t, s))) == True{} : Bool}:
  %Equal.sym(I.DflDrv, s, I.DflRun{I.DflCore{I.DflBad{err}, W.win.empty(), Nil{}}, Nil{}, r}, h) : {Result.is_fail(&2, &2, E.DeflateError, I.DflRaw, I.drv.result(I.drv.go(t, _))) == True{} : Bool}
  %Equal.sym(I.DflDrv, I.drv.go(t, I.DflRun{I.DflCore{I.DflBad{err}, W.win.empty(), Nil{}}, Nil{}, r}), I.DflRun{I.DflCore{I.DflBad{err}, W.win.empty(), Nil{}}, Nil{}, r}, bad_absorbs(t, err, W.win.empty(), Nil{}, r)) : {Result.is_fail(&2, &2, E.DeflateError, I.DflRaw, I.drv.result(_)) == True{} : Bool}
  {==}

