# Contradictions

def absurd.bool(b: Bool) -> Type:
  match b:
    case True{}:
      Unit
    case False{}:
      Empty

def absurd.ft(e: {False{} == True{} : Bool}) -> Empty:
  %Equal.sym(Bool, False{}, True{}, e) : absurd.bool(_)
  Unit{}

# Lists

def append_nil(xs: List<&2, U32>) -> {B.append(xs, Nil{}) == xs : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      %append_nil(t) : {Con{h, B.append(t, Nil{})} == Con{h, _} : List<&2, U32>}
      {==}

def app_assoc(+a: List<&2, U32>, +b: List<&2, U32>, +c: List<&2, U32>) -> {B.append(a, B.append(b, c)) == B.append(B.append(a, b), c) : List<&2, U32>}:
  match a:
    case Nil{}:
      {==}
    case Con{h, t}:
      %app_assoc(t, b, c) : {Con{h, B.append(t, B.append(b, c))} == Con{h, _} : List<&2, U32>}
      {==}

def mask_app(+a: List<&2, U32>, +b: List<&2, U32>) -> {B.append(B.mask(a), B.mask(b)) == B.mask(B.append(a, b)) : List<&2, U32>}:
  match a:
    case Nil{}:
      {==}
    case Con{h, t}:
      %mask_app(t, b) : {Con{B.byte(h), B.append(B.mask(t), B.mask(b))} == Con{B.byte(h), _} : List<&2, U32>}
      {==}

def le_zero(r: Nat) -> {Nat.is_le(0n, r) == True{} : Bool}:
  match r:
    case 0n:
      {==}
    case 1n+q:
      {==}

def of_mask(+o: B.Octets) -> {B.Octets.of_list(B.mask(B.Octets.to_list(o))) == o : B.Octets}:
  +xs = B.Octets.to_list(o)
  %BL.octets_to_of(xs) : {B.Octets.of_list(_) == o : B.Octets}
  %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(B.Octets.of_list(xs))), B.Octets.of_list(xs), BL.octets_of_list_idempotent(xs)) : {_ == o : B.Octets}
  BL.octets_of_to(o)

# The driver over joined input

def go_append(xs: List<&2, U32>, +ys: List<&2, U32>, d: I.DflDrv) -> {I.drv.go(B.append(xs, ys), d) == I.drv.go(ys, I.drv.go(xs, d)) : I.DflDrv}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      go_append(t, ys, I.drv.byte(d, h))

# after the final block, bytes are only collected
def end_absorbs(t: List<&2, U32>, r: List<&2, U32>, +win: W.DflWin, +acc: List<&2, U32>, +room: Nat) -> {I.drv.go(t, I.DflRun{I.DflCore{I.DflEnd{r}, win, Nil{}}, acc, room}) == I.DflRun{I.DflCore{I.DflEnd{B.rev_onto(t, r)}, win, Nil{}}, acc, room} : I.DflDrv}:
  match t:
    case Nil{}:
      {==}
    case Con{h, u}:
      end_absorbs(u, Con{h, r}, win, acc, room)

