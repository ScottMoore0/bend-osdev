# the stored stream's block sizes

def fb.count_le(c: Nat, t: List<&2, U32>) -> {Nat.is_le(D.fb.count(c, t), c) == True{} : Bool}:
  match c:
    case 0n:
      {==}
    case 1n+d:
      match t:
        case Nil{}:
          {==}
        case Con{h, u}:
          fb.count_le(d, u)

def fb.count_len(c: Nat, t: List<&2, U32>) -> {Nat.is_le(D.fb.count(c, t), B.len(t)) == True{} : Bool}:
  match c:
    case 0n:
      le_zero(B.len(t))
    case 1n+d:
      match t:
        case Nil{}:
          {==}
        case Con{h, u}:
          fb.count_len(d, u)

# The stored stream, block by block: from the state before a block of k
# bytes (k = 0: a block header), the stream of xs (and then anything, t)
# gives xs's bytes and leaves t after the stream
def fbs(xs: List<&2, U32>, +k: Nat, +acc: List<&2, U32>, +win: W.DflWin, +r: Nat, +t: List<&2, U32>, hk: {Nat.is_le(k, B.len(xs)) == True{} : Bool}, hr: {Nat.is_le(B.len(xs), r) == True{} : Bool}) -> {I.drv.result(I.drv.go(B.append(B.mask(D.fb.go(xs, k)), t), I.DflRun{I.DflCore{I.inf.stored.next(k, False{}), win, Nil{}}, acc, r})) == Done{I.DflRaw{B.rev_onto(B.mask(xs), acc), t}} : Result<&2, &2, E.DeflateError, I.DflRaw>}:
  match xs:
    case Nil{}:
      match k:
        case 0n:
          %Equal.sym(I.DflDrv, I.drv.go(t, I.DflRun{I.DflCore{I.DflEnd{Nil{}}, win, Nil{}}, acc, r}), I.DflRun{I.DflCore{I.DflEnd{B.rev_onto(t, Nil{})}, win, Nil{}}, acc, r}, end_absorbs(t, Nil{}, win, acc, r)) : {I.drv.result(_) == Done{I.DflRaw{acc, t}} : Result<&2, &2, E.DeflateError, I.DflRaw>}
          %Equal.sym(List<&2, U32>, B.rev(B.rev(t)), t, BL.rev_rev(t)) : {Done{I.DflRaw{acc, _}} == Done{I.DflRaw{acc, t}} : Result<&2, &2, E.DeflateError, I.DflRaw>}
          {==}
        case 1n+j:
          Empty.absurd({I.drv.result(I.drv.go(B.append(B.mask(D.fb.go(Nil{}, 1n+j)), t), I.DflRun{I.DflCore{I.inf.stored.next(1n+j, False{}), win, Nil{}}, acc, r})) == Done{I.DflRaw{B.rev_onto(B.mask(Nil{}), acc), t}} : Result<&2, &2, E.DeflateError, I.DflRaw>}, absurd.ft(hk))
    case Con{+h, +u}:
      match k:
        case 0n:
          match r:
            case 0n:
              Empty.absurd({I.drv.result(I.drv.go(B.append(B.mask(D.fb.go(Con{h, u}, 0n)), t), I.DflRun{I.DflCore{I.inf.stored.next(0n, False{}), win, Nil{}}, acc, 0n})) == Done{I.DflRaw{B.rev_onto(B.mask(Con{h, u}), acc), t}} : Result<&2, &2, E.DeflateError, I.DflRaw>}, absurd.ft(hr))
            case 1n+q:
              +n = D.fb.count(254n, u)
              +hd = D.fb.hdr(1n+n)
              +rest = {Con{h, D.fb.go(u, n)} : List<&2, U32>}
              +s0 = {I.DflRun{I.DflCore{I.inf.head(), win, Nil{}}, acc, 1n+q} : I.DflDrv}
              +x = B.append(B.mask(rest), t)
              +goal = {Done{I.DflRaw{B.rev_onto(B.mask(Con{h, u}), acc), t}} : Result<&2, &2, E.DeflateError, I.DflRaw>}
              %mask_app(hd, rest) : {I.drv.result(I.drv.go(B.append(_, t), s0)) == goal : Result<&2, &2, E.DeflateError, I.DflRaw>}
              %app_assoc(B.mask(hd), B.mask(rest), t) : {I.drv.result(I.drv.go(_, s0)) == goal : Result<&2, &2, E.DeflateError, I.DflRaw>}
              %Equal.sym(I.DflDrv, I.drv.go(B.append(B.mask(hd), x), s0), I.drv.go(x, I.drv.go(B.mask(hd), s0)), go_append(B.mask(hd), x, s0)) : {I.drv.result(_) == goal : Result<&2, &2, E.DeflateError, I.DflRaw>}
              %Equal.sym(I.DflDrv, I.drv.go(B.mask(hd), s0), I.DflRun{I.DflCore{I.DflStored{1n+n, False{}}, win, Nil{}}, acc, 1n+q}, fbh.k0(n, win, acc, 1n+q, fb.count_le(254n, u))) : {I.drv.result(I.drv.go(x, _)) == goal : Result<&2, &2, E.DeflateError, I.DflRaw>}
              fbs(u, n, Con{B.byte(h), acc}, W.win.put(win, B.byte(h)), q, t, fb.count_len(254n, u), hr)
        case 1n+j:
          match r:
            case 0n:
              Empty.absurd({I.drv.result(I.drv.go(B.append(B.mask(D.fb.go(Con{h, u}, 1n+j)), t), I.DflRun{I.DflCore{I.inf.stored.next(1n+j, False{}), win, Nil{}}, acc, 0n})) == Done{I.DflRaw{B.rev_onto(B.mask(Con{h, u}), acc), t}} : Result<&2, &2, E.DeflateError, I.DflRaw>}, absurd.ft(hr))
            case 1n+q:
              fbs(u, j, Con{B.byte(h), acc}, W.win.put(win, B.byte(h)), q, t, hk, hr)

