# Octets, through bytes' laws: the empty string joins as nothing, and
# joining is associative

def oct_empty_append(+a: B.Octets) -> {B.Octets.append(B.Octets.empty(), a) == a : B.Octets}:
  %BL.octets_of_to(B.Octets.append(B.Octets.empty(), a)) : {_ == a : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(B.Octets.empty(), a)), B.append(B.Octets.to_list(B.Octets.empty()), B.Octets.to_list(a)), BL.octets_append_list(B.Octets.empty(), a)) : {B.Octets.of_list(_) == a : B.Octets}
  BL.octets_of_to(a)

def list_assoc(xs: List<&2, U32>, +ys: List<&2, U32>, +zs: List<&2, U32>) -> {B.append(B.append(xs, ys), zs) == B.append(xs, B.append(ys, zs)) : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      %list_assoc(t, ys, zs) : {Con{h, B.append(B.append(t, ys), zs)} == Con{h, _} : List<&2, U32>}
      {==}

def oct_assoc(+x: B.Octets, +a: B.Octets, +b: B.Octets) -> {B.Octets.append(B.Octets.append(x, a), b) == B.Octets.append(x, B.Octets.append(a, b)) : B.Octets}:
  %BL.octets_of_to(B.Octets.append(B.Octets.append(x, a), b)) : {_ == B.Octets.append(x, B.Octets.append(a, b)) : B.Octets}
  %BL.octets_of_to(B.Octets.append(x, B.Octets.append(a, b))) : {B.Octets.of_list(B.Octets.to_list(B.Octets.append(B.Octets.append(x, a), b))) == _ : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(B.Octets.append(x, a), b)), B.append(B.Octets.to_list(B.Octets.append(x, a)), B.Octets.to_list(b)), BL.octets_append_list(B.Octets.append(x, a), b)) : {B.Octets.of_list(_) == B.Octets.of_list(B.Octets.to_list(B.Octets.append(x, B.Octets.append(a, b)))) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(x, a)), B.append(B.Octets.to_list(x), B.Octets.to_list(a)), BL.octets_append_list(x, a)) : {B.Octets.of_list(B.append(_, B.Octets.to_list(b))) == B.Octets.of_list(B.Octets.to_list(B.Octets.append(x, B.Octets.append(a, b)))) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(x, B.Octets.append(a, b))), B.append(B.Octets.to_list(x), B.Octets.to_list(B.Octets.append(a, b))), BL.octets_append_list(x, B.Octets.append(a, b))) : {B.Octets.of_list(B.append(B.append(B.Octets.to_list(x), B.Octets.to_list(a)), B.Octets.to_list(b))) == B.Octets.of_list(_) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(a, b)), B.append(B.Octets.to_list(a), B.Octets.to_list(b)), BL.octets_append_list(a, b)) : {B.Octets.of_list(B.append(B.append(B.Octets.to_list(x), B.Octets.to_list(a)), B.Octets.to_list(b))) == B.Octets.of_list(B.append(B.Octets.to_list(x), _)) : B.Octets}
  %list_assoc(B.Octets.to_list(x), B.Octets.to_list(a), B.Octets.to_list(b)) : {B.Octets.of_list(B.append(B.append(B.Octets.to_list(x), B.Octets.to_list(a)), B.Octets.to_list(b))) == B.Octets.of_list(_) : B.Octets}
  {==}

# Digest lengths: a word's 4 bytes, big-endian; a W64's 8

def be32_len(a: U32) -> {B.Octets.len(B.Octets.be32(a)) == 4n : Nat}:
  match a:
    case U32{w}:
      {==}

def be64_halves_len(a: U32, b: U32) -> {B.Octets.len(B.Octets.of_list(B.append(B.be32(a), B.be32(b)))) == 8n : Nat}:
  match a:
    case U32{x}:
      match b:
        case U32{y}:
          {==}

def be64_len(+v: W.W64) -> {B.Octets.len(B.Octets.be64(v)) == 8n : Nat}:
  be64_halves_len(W.W64.hi(v), W.W64.lo(v))

# The buffered state

def Laws.khbuf_streaming(s, a, b):
  match s:
    case IH.KhBuf{x}:
      %oct_assoc(x, a, b) : {IH.KhBuf{_} == IH.KhBuf{B.Octets.append(B.Octets.append(x, a), b)} : IH.KhBuf}
      {==}

def Laws.khbuf_split(digest, a, b):
  %Equal.sym(B.Octets, B.Octets.append(B.Octets.empty(), a), a, oct_empty_append(a)) : {digest(B.Octets.append(_, b)) == digest(B.Octets.append(a, b)) : B.Octets}
  {==}

def Laws.khbuf_split3(digest, a, b, c):
  %Equal.sym(B.Octets, B.Octets.append(B.Octets.empty(), a), a, oct_empty_append(a)) : {digest(B.Octets.append(B.Octets.append(_, b), c)) == digest(B.Octets.append(a, B.Octets.append(b, c))) : B.Octets}
  %oct_assoc(a, b, c) : {digest(B.Octets.append(B.Octets.append(a, b), c)) == digest(_) : B.Octets}
  {==}

def Laws.khbuf_bytes(a):
  oct_empty_append(a)

