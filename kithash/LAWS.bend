  {IH.KhBuf.final(~IH.KhXxh64.digest(~seed), IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b)) == IH.KhXxh64.digest(~seed, B.Octets.append(a, b)) : B.Octets}

