  for +b: B.Octets
  {IH.KhBuf.final(~IH.KhAdler32.digest, IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b)) == IH.KhAdler32.digest(B.Octets.append(a, b)) : B.Octets}

# Adler-32 (bend-kit-hash): in three pieces, the one-shot digest of the whole
