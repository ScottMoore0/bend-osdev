law xxh64_hash_split3:
  for ~seed: W.W64
  for +a: B.Octets
  for +b: B.Octets
  for +c: B.Octets
  {IH.KhBuf.final(~IH.KhXxh64.digest(~seed), IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b), c)) == IH.KhXxh64.digest(~seed, B.Octets.append(a, B.Octets.append(b, c))) : B.Octets}

