# CRC-32 (bend-kit-hash): in two pieces, the one-shot digest of the whole
law crc32_hash_split:
  for +a: B.Octets
  for +b: B.Octets
  {IH.KhBuf.final(~IH.KhCrc32.digest, IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b)) == IH.KhCrc32.digest(B.Octets.append(a, b)) : B.Octets}

# CRC-32 (bend-kit-hash): in three pieces, the one-shot digest of the whole
law crc32_hash_split3:
  for +a: B.Octets
  for +b: B.Octets
  for +c: B.Octets
  {IH.KhBuf.final(~IH.KhCrc32.digest, IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b), c)) == IH.KhCrc32.digest(B.Octets.append(a, B.Octets.append(b, c))) : B.Octets}

# CRC-32 (bend-kit-hash): the digest has 4 bytes, from every state
law crc32_hash_length:
  for s: IH.KhBuf
  {B.Octets.len(IH.KhBuf.final(~IH.KhCrc32.digest, s)) == 4n : Nat}

