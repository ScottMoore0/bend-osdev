# XXH32 (bend-kit-hash), for every seed: in two pieces, the one-shot digest of
# the whole
law xxh32_hash_split:
  for ~seed: U32
  for +a: B.Octets
  for +b: B.Octets
  {IH.KhBuf.final(~IH.KhXxh32.digest(~seed), IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b)) == IH.KhXxh32.digest(~seed, B.Octets.append(a, b)) : B.Octets}

# XXH32 (bend-kit-hash), for every seed: in three pieces, the one-shot digest
# of the whole
law xxh32_hash_split3:
  for ~seed: U32
  for +a: B.Octets
  for +b: B.Octets
  for +c: B.Octets
  {IH.KhBuf.final(~IH.KhXxh32.digest(~seed), IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b), c)) == IH.KhXxh32.digest(~seed, B.Octets.append(a, B.Octets.append(b, c))) : B.Octets}

# XXH32 (bend-kit-hash), for every seed: the digest has 4 bytes, from every
