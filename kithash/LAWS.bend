# bend-osdev-kithash: the laws of the instances, the agreement of
# bend-kit-hash with bend-osdev's own implementations, and bend-kit-hash's
# vectors.
#
# For every input: the buffered hash state streams, and gives the one-shot
# digest for every split, whatever the digest function (khbuf_*); each
# instance's split, split3 and digest length, and each SipHash MAC's accepts
# and agrees (the generated region). By computation: bend-kit-hash's CRC-32,
# Adler-32, XXH64 and SipHash-1-3 agree with crc's, deflate's, zstd's and
# siphash's on inputs that reach every branch of their code (a law for every
# input would need laws about Base's Array and bend-kit-bytes' buffers,
# which neither has published; ref/ tests them on random inputs), and the
# published vectors: the CRC catalogue's check value, RFC 9923's FNV-1a
# values, the lz4 command's XXH32 and the openssl command's SipHash-1-3.
import Base
import ../word64/word64.bend as W
import ../bytes/bytes.bend as B
import ../crypto/crypto.bend as Cr
import ../crypto/inst_crc.bend as CR
import ../crc/crc.bend as C
import ../deflate/adler32.bend as A
import ../zstd/xxh64.bend as X
import ../siphash/siphash.bend as S
import ../siphash/halfsiphash.bend as HS
import ./kithash.bend as K
import ./inst_hash.bend as IH
import ./inst_mac.bend as IM

# The buffered state, for every digest function

law khbuf_streaming:
  for +s: IH.KhBuf
  for +a: B.Octets
  for +b: B.Octets
  {IH.KhBuf.update(s, B.Octets.append(a, b)) == IH.KhBuf.update(IH.KhBuf.update(s, a), b) : IH.KhBuf}

law khbuf_split:
  for ~digest: B.Octets -> B.Octets
  for +a: B.Octets
  for +b: B.Octets
  {IH.KhBuf.final(~digest, IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b)) == digest(B.Octets.append(a, b)) : B.Octets}

law khbuf_split3:
  for ~digest: B.Octets -> B.Octets
  for +a: B.Octets
  for +b: B.Octets
  for +c: B.Octets
  {IH.KhBuf.final(~digest, IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b), c)) == digest(B.Octets.append(a, B.Octets.append(b, c))) : B.Octets}

# the state holds exactly the bytes fed to it
law khbuf_bytes:
  for +a: B.Octets
  {IH.KhBuf.bytes(IH.KhBuf.update(IH.KhBuf.init(), a)) == a : B.Octets}

# The instances (gen/instances.py)

