  for +a: B.Octets
  for +b: B.Octets
  for +c: B.Octets
  {IH.KhBuf.final(~IH.KhAdler32.digest, IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.update(IH.KhBuf.init(), a), b), c)) == IH.KhAdler32.digest(B.Octets.append(a, B.Octets.append(b, c))) : B.Octets}

# Adler-32 (bend-kit-hash): the digest has 4 bytes, from every state
law adler32_hash_length:
  for s: IH.KhBuf
  {B.Octets.len(IH.KhBuf.final(~IH.KhAdler32.digest, s)) == 4n : Nat}

