def sp_unop_op(o: P.LcSpOp, +s: M.CmBlock) -> {s == P.sp.unop(o, P.sp.op(o, s)) : M.CmBlock}:
  match o:
    case P.LcSpBswap{}:
      sp_bswap(s)
    case P.LcSpKey{k}:
      block_xx(s, k)
    case P.LcSpS{bx}:
      sp_sop_inv(bx, False{}, s)
    case P.LcSpLt{}:
      sp_lt_inv(s)

def sp_op_unop(o: P.LcSpOp, +s: M.CmBlock) -> {s == P.sp.op(o, P.sp.unop(o, s)) : M.CmBlock}:
  match o:
    case P.LcSpBswap{}:
      sp_bswapd(s)
    case P.LcSpKey{k}:
      block_xx(s, k)
    case P.LcSpS{bx}:
      sp_sop_inv(bx, True{}, s)
    case P.LcSpLt{}:
      sp_lt_invd(s)

def sp_unrun_run(os: List<&2, P.LcSpOp>, +s: M.CmBlock) -> {s == P.sp.unrun(os, P.sp.run(os, s)) : M.CmBlock}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %sp_unrun_run(t, P.sp.op(o, s)) : {s == P.sp.unop(o, _) : M.CmBlock}
      sp_unop_op(o, s)

def sp_run_unrun(os: List<&2, P.LcSpOp>, +s: M.CmBlock) -> {s == P.sp.run(os, P.sp.unrun(os, s)) : M.CmBlock}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %sp_op_unop(o, P.sp.unrun(t, s)) : {s == P.sp.run(t, _) : M.CmBlock}
      sp_run_unrun(t, s)

def Laws.serpent_round_trip(k, b):
  match k:
    case P.LcSerpentKey{ops}:
      Equal.sym(M.CmBlock, b, P.sp.unrun(ops, P.sp.run(ops, b)), sp_unrun_run(ops, b))

def Laws.serpent_round_trip_dual(k, b):
  match k:
    case P.LcSerpentKey{ops}:
      Equal.sym(M.CmBlock, b, P.sp.run(ops, P.sp.unrun(ops, b)), sp_run_unrun(ops, b))

