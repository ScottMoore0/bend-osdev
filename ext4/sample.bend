# bend-osdev-ext4: the sample image check.bend reads (a test fixture, not
# part of the interface). Written by ref/sample.py with mke2fs 1.47.0:
# ext4, 1 KiB blocks, 2048 blocks, 64 inodes, dir_index, has_journal,
# inline_data, ea_inode, metadata_csum; /big indexed by e2fsck -D;
# attributes and three journal transactions added by debugfs. Only the
# non-zero runs of the blocks a reader needs are kept.
import Base
import ../bytes/bytes.bend as B
import ../blockdev/blockdev.bend as D

type Ext4SampleRun is Data:
  Ext4SampleRun{offset: Nat, bytes: List<&2, U32>}

type Ext4SampleBlock is Data:
  Ext4SampleBlock{block: Nat, runs: List<&2, Ext4SampleRun>}

def Ext4Sample.fill(runs: List<&2, Ext4SampleRun>, +pos: Nat) -> B.Octets:
  match runs:
    case Nil{}:
      B.Octets.zeros(Nat.sub(1024n, pos))
    case Con{Ext4SampleRun{+off, xs}, t}:
      +o = B.Octets.of_list(xs)
      B.Octets.append(B.Octets.zeros(Nat.sub(off, pos)), B.Octets.append(o, Ext4Sample.fill(t, Nat.add(off, B.Octets.len(o)))))

def Ext4Sample.write(bs: List<&2, Ext4SampleBlock>, d: D.MemDev) -> D.MemDev:
  match bs:
    case Nil{}:
      d
    case Con{Ext4SampleBlock{n, runs}, t}:
      Ext4Sample.write(t, D.MemDev.update(d, n, Ext4Sample.fill(runs, 0n)))

