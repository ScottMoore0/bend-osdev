def Laws.small7_roundtrip(m, short, some):
  match m:
    case Nil{}:
      Empty.absurd({D.Bch.decode_bits(C.Bch.bch7_4(), E.Bch.codeword(C.Bch.bch7_4(), Nil{})) == Done{Nil{}} : Result<&2, &2, E.BchError, List<&2, Bool>>}, bchp.ft(some))
    case Con{False{}, Nil{}}:
      bchp.s7r_0()
    case Con{True{}, Nil{}}:
      bchp.s7r_1()
    case Con{False{}, Con{False{}, Nil{}}}:
      bchp.s7r_00()
