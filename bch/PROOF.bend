      Empty.absurd({S.Bch.syndromes(C.Bch.bch7_4(), E.Bch.codeword(C.Bch.bch7_4(), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, r}}}}})) == [0, 0] : List<&2, U32>}, bchp.ft(short))

