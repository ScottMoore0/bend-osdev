# Proofs. Two kinds:
#   * every code: encoding is the shift register's division, and the
#     codeword begins with the data bits, by induction on the data;
#   * the small codes' laws and the vectors are computations: each law's
#     def takes the message apart (every list of bits up to the length
#     bound), and each message, and each flipped position, is computed in a
#     def of its own (gen/proof.py writes these parts).
# No law of another package is needed: gf and rs are used only through
# computing their public functions.
import Base
import ../bytes/bytes.bend as B
import ../gf/gfm.bend as M
import ./code.bend as C
import ./bits.bend as T
import ./encode.bend as E
import ./syndrome.bend as S
import ./bch.bend as D
import ./LAWS.bend as Laws

# Contradictions

def bchp.bdisc(+b: Bool) -> Type:
  match b:
    case True{}:
      Empty
    case False{}:
      Unit

def bchp.ft(+e: {False{} == True{} : Bool}) -> Empty:
  %e : bchp.bdisc(_)
  Unit{}

# Every code

def Laws.encode_short(c, m, short):
  %Equal.sym(Bool, Nat.is_le(Nat.add(List.length(&2, Bool, m), C.Bch.parity_bits(c)), U32.to_nat(C.Bch.n(c))), True{}, short) : {E.bch.enc.pick(_, c, m) == Done{E.Bch.codeword(c, m)} : Result<&2, &2, E.BchError, List<&2, Bool>>}
  {==}

def bchp.take_app(m: List<&2, Bool>, p: List<&2, Bool>) -> {List.take(&2, Bool, List.append(&2, Bool, m, p), List.length(&2, Bool, m)) == m : List<&2, Bool>}:
  match m:
    case Nil{}:
      match p:
        case Nil{}:
          {==}
        case Con{x, y}:
          {==}
    case Con{+h, +t}:
      %bchp.take_app(t, p) : {Con{h, List.take(&2, Bool, List.append(&2, Bool, t, p), List.length(&2, Bool, t))} == Con{h, _} : List<&2, Bool>}
      {==}

def Laws.codeword_message(c, m):
  bchp.take_app(m, E.Bch.parity(c, m))

