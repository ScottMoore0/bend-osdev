import Base
import ../bytes/bytes.bend as B
import ../cipher-modes/cipher-modes.bend as M
import ../cipher-core/cipher-core.bend as L
import ../cipher-core/LAWS.bend as CoreL
import ../cipher-core/PROOF.bend as CoreP
import ./cast6.bend as C6
import ../cast5/cast5.bend as C5
import ./LAWS.bend as Laws

# CAST-256: each step of a quad-round is undone by itself, so QBAR undoes Q
# and Q undoes QBAR

def c6_sc2(k: C6.LcCast6Ks, s: M.CmBlock) -> {s == C6.c6.sc(k, C6.c6.sc(k, s)) : M.CmBlock}:
  match k:
    case C6.LcCast6Ks{+m0, +m1, +m2, +m3, +r0, +r1, +r2, +r3, +t}:
      match s:
        case M.CmBlock{a, b, c, +d}:
          %CoreL.u32_xor_cancel(c, C5.cast.f(C5.LcCastF1{}, t, d, m0, r0)) : {M.CmBlock{a, b, c, d} == M.CmBlock{a, b, _, d} : M.CmBlock}
          {==}

def c6_sb2(k: C6.LcCast6Ks, s: M.CmBlock) -> {s == C6.c6.sb(k, C6.c6.sb(k, s)) : M.CmBlock}:
  match k:
    case C6.LcCast6Ks{+m0, +m1, +m2, +m3, +r0, +r1, +r2, +r3, +t}:
      match s:
        case M.CmBlock{a, b, +c, d}:
          %CoreL.u32_xor_cancel(b, C5.cast.f(C5.LcCastF2{}, t, c, m1, r1)) : {M.CmBlock{a, b, c, d} == M.CmBlock{a, _, c, d} : M.CmBlock}
          {==}

def c6_sa2(k: C6.LcCast6Ks, s: M.CmBlock) -> {s == C6.c6.sa(k, C6.c6.sa(k, s)) : M.CmBlock}:
  match k:
    case C6.LcCast6Ks{+m0, +m1, +m2, +m3, +r0, +r1, +r2, +r3, +t}:
      match s:
        case M.CmBlock{a, +b, c, d}:
          %CoreL.u32_xor_cancel(a, C5.cast.f(C5.LcCastF3{}, t, b, m2, r2)) : {M.CmBlock{a, b, c, d} == M.CmBlock{_, b, c, d} : M.CmBlock}
          {==}

def c6_sd2(k: C6.LcCast6Ks, s: M.CmBlock) -> {s == C6.c6.sd(k, C6.c6.sd(k, s)) : M.CmBlock}:
  match k:
    case C6.LcCast6Ks{+m0, +m1, +m2, +m3, +r0, +r1, +r2, +r3, +t}:
      match s:
        case M.CmBlock{+a, b, c, d}:
          %CoreL.u32_xor_cancel(d, C5.cast.f(C5.LcCastF1{}, t, a, m3, r3)) : {M.CmBlock{a, b, c, d} == M.CmBlock{a, b, c, _} : M.CmBlock}
          {==}

def c6_qq(+k: C6.LcCast6Ks, +s: M.CmBlock) -> {s == C6.c6.qbar(k, C6.c6.q(k, s)) : M.CmBlock}:
  %c6_sd2(k, C6.c6.sa(k, C6.c6.sb(k, C6.c6.sc(k, s)))) : {s == C6.c6.sc(k, C6.c6.sb(k, C6.c6.sa(k, _))) : M.CmBlock}
  %c6_sa2(k, C6.c6.sb(k, C6.c6.sc(k, s))) : {s == C6.c6.sc(k, C6.c6.sb(k, _)) : M.CmBlock}
  %c6_sb2(k, C6.c6.sc(k, s)) : {s == C6.c6.sc(k, _) : M.CmBlock}
  c6_sc2(k, s)

def c6_qbq(+k: C6.LcCast6Ks, +s: M.CmBlock) -> {s == C6.c6.q(k, C6.c6.qbar(k, s)) : M.CmBlock}:
  %c6_sc2(k, C6.c6.sb(k, C6.c6.sa(k, C6.c6.sd(k, s)))) : {s == C6.c6.sd(k, C6.c6.sa(k, C6.c6.sb(k, _))) : M.CmBlock}
  %c6_sb2(k, C6.c6.sa(k, C6.c6.sd(k, s))) : {s == C6.c6.sd(k, C6.c6.sa(k, _)) : M.CmBlock}
  %c6_sa2(k, C6.c6.sd(k, s)) : {s == C6.c6.sd(k, _) : M.CmBlock}
  c6_sd2(k, s)

def c6_unop_op(o: C6.LcCast6Op, +s: M.CmBlock) -> {s == C6.c6.unop(o, C6.c6.op(o, s)) : M.CmBlock}:
  match o:
    case C6.LcCast6Op{fwd, +k}:
      match fwd:
        case True{}:
          c6_qq(k, s)
        case False{}:
          c6_qbq(k, s)

def c6_op_unop(o: C6.LcCast6Op, +s: M.CmBlock) -> {s == C6.c6.op(o, C6.c6.unop(o, s)) : M.CmBlock}:
  match o:
    case C6.LcCast6Op{fwd, +k}:
      match fwd:
        case True{}:
          c6_qbq(k, s)
        case False{}:
          c6_qq(k, s)

def c6_unrun_run(os: List<&2, C6.LcCast6Op>, +s: M.CmBlock) -> {s == C6.c6.unrun(os, C6.c6.run(os, s)) : M.CmBlock}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %c6_unrun_run(t, C6.c6.op(o, s)) : {s == C6.c6.unop(o, _) : M.CmBlock}
      c6_unop_op(o, s)

def c6_run_unrun(os: List<&2, C6.LcCast6Op>, +s: M.CmBlock) -> {s == C6.c6.run(os, C6.c6.unrun(os, s)) : M.CmBlock}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %c6_op_unop(o, C6.c6.unrun(t, s)) : {s == C6.c6.run(t, _) : M.CmBlock}
      c6_run_unrun(t, s)

def Laws.cast6_round_trip(k, b):
  match k:
    case C6.LcCast6Key{+ops}:
      Equal.sym(M.CmBlock, b, C6.c6.unrun(ops, C6.c6.run(ops, b)), c6_unrun_run(ops, b))

def Laws.cast6_round_trip_dual(k, b):
  match k:
    case C6.LcCast6Key{+ops}:
      Equal.sym(M.CmBlock, b, C6.c6.run(ops, C6.c6.unrun(ops, b)), c6_run_unrun(ops, b))

