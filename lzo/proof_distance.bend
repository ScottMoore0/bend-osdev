# Proof helpers for bend-osdev-lzo: the distance fields of the match
# instructions, as Nat arithmetic.
#
# The decoder computes each match's distance from bytes with U32 shifts,
# masks and sums (decode.bend: dec.near, dec.d14, dec.m4). Their values come
# from bend-osdev-u32's laws (u32_shln_value, u32_shr_value, u32_add_value,
# u32_lt_value, u32_eq_value, word_value_lt) and the word lemmas here: a mask
# of low bits keeps a word's low bits (ld.and_lo_val), an "or" of two words
# whose bits do not meet is their sum (ld.or_dis), and two halvings are a
# division by 4 (ld.div4).
#
# The word lemmas are stated for widths k and m that are variables and
# instantiated at the 32 bits of a U32 where every term is symbolic.
#
# The constants of M4 (16383, 32767, 2^14, 2^15) are too large for the
# checker to expand as Nats: they stay words of ones (ld.ones) and powers
# U32Nat.dbl(k, 1), and the lemmas about them are stated for a variable k.
# The part after "# generated by gen/proof_distance.py (d14)" is that
# script's output, pasted: deep patterns over the 16 bits of lo and hi.
import Base
import ../u32/u32.bend as U
import ../u32/LAWS.bend as UL
import ../u32/PROOF.bend as UP
import ../u32/LAWS_order.bend as UO
import ../u32/PROOF_order.bend as UOP

# Logic

def ld.bt(+b: Bool) -> Type:
  match b:
    case True{}:
      Unit
    case False{}:
      Empty

def ld.ft(e: {False{} == True{} : Bool}) -> Empty:
  %Equal.sym(Bool, False{}, True{}, e) : ld.bt(_)
  Unit{}

def ld.absurd(-T: Type, e: Empty) -> T:
  match e:

def ld.true_false(e: {True{} == False{} : Bool}) -> Empty:
  ld.ft(Equal.sym(Bool, True{}, False{}, e))

# Nat: sums

def ld.succ_cong(-a: Nat, -b: Nat, +e: {a == b : Nat}) -> {1n+a == 1n+b : Nat}:
  %e : {1n+a == 1n+_ : Nat}
  {==}

def ld.double_add(+x: Nat, -y: Nat) -> {Nat.double(Nat.add(x, y)) == Nat.add(Nat.double(x), Nat.double(y)) : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      ld.succ_cong(1n+Nat.double(Nat.add(p, y)), 1n+Nat.add(Nat.double(p), Nat.double(y)), ld.succ_cong(Nat.double(Nat.add(p, y)), Nat.add(Nat.double(p), Nat.double(y)), ld.double_add(p, y)))

def ld.double_cong(-a: Nat, -b: Nat, +e: {a == b : Nat}) -> {Nat.double(a) == Nat.double(b) : Nat}:
  %e : {Nat.double(a) == Nat.double(_) : Nat}
  {==}

# (h + z) - h = z
def ld.sub_add_l(+h: Nat, +z: Nat) -> {Nat.sub(Nat.add(h, z), h) == z : Nat}:
  match h:
    case 0n:
      match z:
        case 0n:
          {==}
        case 1n+q:
          {==}
    case 1n+p:
      ld.sub_add_l(p, z)

# Nat: products

# x 2^k = x * (2^k)
def ld.dbl_mul(+k: Nat, +x: Nat) -> {U.U32Nat.dbl(k, x) == Nat.mul(x, U.U32Nat.dbl(k, 1n)) : Nat}:
  match x:
    case 0n:
      UL.dbl_zero(k)
    case 1n+p:
      %ld.dbl_mul(k, p) : {U.U32Nat.dbl(k, 1n+p) == Nat.add(U.U32Nat.dbl(k, 1n), _) : Nat}
      UL.dbl_add(k, 1n, p)

# Nat: order

def ld.lt_add_l(+a: Nat, -x: Nat, -y: Nat) -> {Nat.is_lt(Nat.add(a, x), Nat.add(a, y)) == Nat.is_lt(x, y) : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      ld.lt_add_l(p, x, y)

def ld.le_add_l(+a: Nat, -x: Nat, -y: Nat) -> {Nat.is_le(Nat.add(a, x), Nat.add(a, y)) == Nat.is_le(x, y) : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      ld.le_add_l(p, x, y)

def ld.not_lt_add(+a: Nat, +b: Nat) -> {Nat.is_lt(Nat.add(a, b), a) == False{} : Bool}:
  match a:
    case 0n:
      match b:
        case 0n:
          {==}
        case 1n+q:
          {==}
    case 1n+p:
      ld.not_lt_add(p, b)

def ld.lt_le(+x: Nat, +y: Nat, +h: {Nat.is_lt(x, y) == True{} : Bool}) -> {Nat.is_le(x, y) == True{} : Bool}:
  match x:
    case 0n:
      match y:
        case 0n:
          {==}
        case 1n+q:
          {==}
    case 1n+p:
      match y:
        case 0n:
          ld.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, ld.ft(h))
        case 1n+q:
          ld.lt_le(p, q, h)

# x < 1 + y: x <= y
def ld.not_lt_one(+p: Nat, +h: {Nat.is_lt(1n+p, 1n) == True{} : Bool}) -> Empty:
  match p:
    case 0n:
      ld.ft(h)
    case 1n+r:
      ld.ft(h)

def ld.lt_succ_le(+x: Nat, +y: Nat, +h: {Nat.is_lt(x, 1n+y) == True{} : Bool}) -> {Nat.is_le(x, y) == True{} : Bool}:
  match x:
    case 0n:
      match y:
        case 0n:
          {==}
        case 1n+q:
          {==}
    case 1n+p:
      match y:
        case 0n:
          ld.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, ld.not_lt_one(p, h))
        case 1n+q:
          ld.lt_succ_le(p, q, h)

# x < y: 1 + x <= y
def ld.lt_succ(+x: Nat, +y: Nat, +h: {Nat.is_lt(x, y) == True{} : Bool}) -> {Nat.is_le(1n+x, y) == True{} : Bool}:
  match x:
    case 0n:
      match y:
        case 0n:
          ld.absurd({Nat.is_le(1n, 0n) == True{} : Bool}, ld.ft(h))
        case 1n+q:
          match q:
            case 0n:
              {==}
            case 1n+r:
              {==}
    case 1n+p:
      match y:
        case 0n:
          ld.absurd({Nat.is_le(2n+p, 0n) == True{} : Bool}, ld.ft(h))
        case 1n+q:
          ld.lt_succ(p, q, h)

# 1 + x <= y: x < y
def ld.le_lt(+x: Nat, +y: Nat, +h: {Nat.is_le(1n+x, y) == True{} : Bool}) -> {Nat.is_lt(x, y) == True{} : Bool}:
  match x:
    case 0n:
      match y:
        case 0n:
          ld.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, ld.ft(h))
        case 1n+q:
          {==}
    case 1n+p:
      match y:
        case 0n:
          ld.absurd({Nat.is_lt(1n+p, 0n) == True{} : Bool}, ld.ft(h))
        case 1n+q:
          ld.le_lt(p, q, h)

# not x < y: y <= x
def ld.le_of_not_lt(+x: Nat, +y: Nat, +e: {Nat.is_lt(x, y) == False{} : Bool}) -> {Nat.is_le(y, x) == True{} : Bool}:
  match x:
    case 0n:
      match y:
        case 0n:
          {==}
        case 1n+q:
          ld.absurd({Nat.is_le(1n+q, 0n) == True{} : Bool}, ld.true_false(e))
    case 1n+p:
      match y:
        case 0n:
          {==}
        case 1n+q:
          ld.le_of_not_lt(p, q, e)

# x <= y: not y < x
def ld.not_lt_of_le(+x: Nat, +y: Nat, +h: {Nat.is_le(x, y) == True{} : Bool}) -> {Nat.is_lt(y, x) == False{} : Bool}:
  match x:
    case 0n:
      match y:
        case 0n:
          {==}
        case 1n+q:
          {==}
    case 1n+p:
      match y:
        case 0n:
          ld.absurd({Nat.is_lt(0n, 1n+p) == False{} : Bool}, ld.ft(h))
        case 1n+q:
          ld.not_lt_of_le(p, q, h)

# a + c <= b + c from a <= b, the sum on the left
def ld.le_add_mono(+c: Nat, +a: Nat, +b: Nat, +h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(Nat.add(c, a), Nat.add(c, b)) == True{} : Bool}:
  Equal.trans(Bool, Nat.is_le(Nat.add(c, a), Nat.add(c, b)), Nat.is_le(a, b), True{}, ld.le_add_l(c, a, b), h)

# multiples of s: a s < x s gives a s + s <= x s
def ld.step_s(+a: Nat, +x: Nat, +sp: Nat, +h: {Nat.is_lt(Nat.mul(a, 1n+sp), Nat.mul(x, 1n+sp)) == True{} : Bool}) -> {Nat.is_le(Nat.add(Nat.mul(a, 1n+sp), 1n+sp), Nat.mul(x, 1n+sp)) == True{} : Bool}:
  match a:
    case 0n:
      match x:
        case 0n:
          ld.absurd({Nat.is_le(Nat.add(0n, 1n+sp), 0n) == True{} : Bool}, ld.ft(h))
        case 1n+q:
          UO.nat_le_add_r(1n+sp, Nat.mul(q, 1n+sp))
    case 1n+p:
      match x:
        case 0n:
          ld.absurd({Nat.is_le(Nat.add(Nat.mul(1n+p, 1n+sp), 1n+sp), 0n) == True{} : Bool}, ld.ft(h))
        case 1n+q:
          +mp = Nat.mul(p, 1n+sp)
          +mq = Nat.mul(q, 1n+sp)
          %Equal.sym(Nat, Nat.add(Nat.add(1n+sp, mp), 1n+sp), Nat.add(1n+sp, Nat.add(mp, 1n+sp)), UL.nat_add_assoc(1n+sp, mp, 1n+sp)) : {Nat.is_le(_, Nat.add(1n+sp, mq)) == True{} : Bool}
          %Equal.sym(Bool, Nat.is_le(Nat.add(1n+sp, Nat.add(mp, 1n+sp)), Nat.add(1n+sp, mq)), Nat.is_le(Nat.add(mp, 1n+sp), mq), ld.le_add_l(1n+sp, Nat.add(mp, 1n+sp), mq)) : {_ == True{} : Bool}
          ld.step_s(p, q, sp, Equal.trans(Bool, Nat.is_lt(mp, mq), Nat.is_lt(Nat.add(1n+sp, mp), Nat.add(1n+sp, mq)), True{}, Equal.sym(Bool, Nat.is_lt(Nat.add(1n+sp, mp), Nat.add(1n+sp, mq)), Nat.is_lt(mp, mq), ld.lt_add_l(1n+sp, mp, mq)), h))

# rewriting under an order

def ld.le_rw(-x: Nat, -x2: Nat, -y: Nat, -y2: Nat, +ex: {x == x2 : Nat}, +ey: {y == y2 : Nat}, +h: {Nat.is_le(x, y) == True{} : Bool}) -> {Nat.is_le(x2, y2) == True{} : Bool}:
  %ex : {Nat.is_le(_, y2) == True{} : Bool}
  %ey : {Nat.is_le(x, _) == True{} : Bool}
  h

def ld.lt_rw(-x: Nat, -x2: Nat, -y: Nat, -y2: Nat, +ex: {x == x2 : Nat}, +ey: {y == y2 : Nat}, +h: {Nat.is_lt(x, y) == True{} : Bool}) -> {Nat.is_lt(x2, y2) == True{} : Bool}:
  %ex : {Nat.is_lt(_, y2) == True{} : Bool}
  %ey : {Nat.is_lt(x, _) == True{} : Bool}
  h

# Nat: division by 1 + bp (Base's Nat.divmod counts m down and r up, and d
# once per round)

def ld.dm_small(+n: Nat, +m: Nat, +d: Nat, +r: Nat, +h: {Nat.is_lt(n, 1n+m) == True{} : Bool}) -> {Nat.divmod.go(n, m, d, r) == (d, Nat.add(n, r)) : Nat & Nat}:
  match n:
    case 0n:
      {==}
    case 1n+np:
      match m:
        case 0n:
          ld.absurd({Nat.divmod.go(1n+np, 0n, d, r) == (d, Nat.add(1n+np, r)) : Nat & Nat}, ld.not_lt_one(np, h))
        case 1n+mp:
          %UL.nat_add_succ(np, r) : {Nat.divmod.go(1n+np, 1n+mp, d, r) == (d, _) : Nat & Nat}
          ld.dm_small(np, mp, d, 1n+r, h)

def ld.dm_round(+m: Nat, +n: Nat, +d: Nat, +r: Nat) -> {Nat.divmod.go(Nat.add(m, 1n+n), m, d, r) == Nat.divmod.go(n, Nat.add(m, r), 1n+d, 0n) : Nat & Nat}:
  match m:
    case 0n:
      {==}
    case 1n+mp:
      %UL.nat_add_succ(mp, r) : {Nat.divmod.go(Nat.add(1n+mp, 1n+n), 1n+mp, d, r) == Nat.divmod.go(n, _, 1n+d, 0n) : Nat & Nat}
      ld.dm_round(mp, n, d, 1n+r)

def ld.dm_rounds(+g: Nat, +i: Nat, +d: Nat, +bp: Nat, +h: {Nat.is_lt(i, 1n+bp) == True{} : Bool}) -> {Nat.divmod.go(Nat.add(Nat.mul(g, 1n+bp), i), bp, d, 0n) == (Nat.add(g, d), i) : Nat & Nat}:
  match g:
    case 0n:
      %UL.nat_add_zero(i) : {Nat.divmod.go(i, bp, d, 0n) == (d, _) : Nat & Nat}
      ld.dm_small(i, bp, d, 0n, h)
    case 1n+gp:
      +gg = Nat.mul(gp, 1n+bp)
      +y = Nat.add(gg, i)
      %Equal.sym(Nat, Nat.add(Nat.add(bp, gg), i), Nat.add(bp, y), UL.nat_add_assoc(bp, gg, i)) : {Nat.divmod.go(1n+_, bp, d, 0n) == (1n+Nat.add(gp, d), i) : Nat & Nat}
      %UL.nat_add_succ(bp, y) : {Nat.divmod.go(_, bp, d, 0n) == (1n+Nat.add(gp, d), i) : Nat & Nat}
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.add(bp, 1n+y), bp, d, 0n), Nat.divmod.go(y, Nat.add(bp, 0n), 1n+d, 0n), ld.dm_round(bp, y, d, 0n)) : {_ == (1n+Nat.add(gp, d), i) : Nat & Nat}
      %Equal.sym(Nat, Nat.add(bp, 0n), bp, UL.nat_add_zero(bp)) : {Nat.divmod.go(y, _, 1n+d, 0n) == (1n+Nat.add(gp, d), i) : Nat & Nat}
      %UL.nat_add_succ(gp, d) : {Nat.divmod.go(y, bp, 1n+d, 0n) == (_, i) : Nat & Nat}
      ld.dm_rounds(gp, i, 1n+d, bp, h)

# g (1 + bp) + i, i <= bp: quotient g, remainder i
def ld.div_of(+g: Nat, +i: Nat, +bp: Nat, +h: {Nat.is_lt(i, 1n+bp) == True{} : Bool}) -> {Nat.div(Nat.add(Nat.mul(g, 1n+bp), i), 1n+bp) == g : Nat}:
  %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.add(Nat.mul(g, 1n+bp), i), bp, 0n, 0n), (Nat.add(g, 0n), i), ld.dm_rounds(g, i, 0n, bp, h)) : {Pair.fst(Nat, Nat, _) == g : Nat}
  UL.nat_add_zero(g)

def ld.mod_of(+g: Nat, +i: Nat, +bp: Nat, +h: {Nat.is_lt(i, 1n+bp) == True{} : Bool}) -> {Nat.mod(Nat.add(Nat.mul(g, 1n+bp), i), 1n+bp) == i : Nat}:
  %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.add(Nat.mul(g, 1n+bp), i), bp, 0n, 0n), (Nat.add(g, 0n), i), ld.dm_rounds(g, i, 0n, bp, h)) : {Pair.snd(Nat, Nat, _) == i : Nat}
  {==}

# Words: a word of k + m bits as its low k bits and its high m bits

def ld.take(+k: Nat, +m: Nat, w: Word(Nat.add(k, m))) -> Word(k):
  match k:
    case 0n:
      WNil{}
    case 1n+p:
      match w:
        case WCon{b, t}:
          WCon{b, ld.take(p, m, t)}

def ld.drop(+k: Nat, +m: Nat, w: Word(Nat.add(k, m))) -> Word(m):
  match k:
    case 0n:
      w
    case 1n+p:
      match w:
        case WCon{b, t}:
          ld.drop(p, m, t)

def ld.ones(+n: Nat) -> Word(n):
  match n:
    case 0n:
      WNil{}
    case 1n+p:
      WCon{True{}, ld.ones(p)}

def ld.cat(+k: Nat, +m: Nat, a: Word(k), b: Word(m)) -> Word(Nat.add(k, m)):
  match k:
    case 0n:
      match a:
        case WNil{}:
          b
    case 1n+p:
      match a:
        case WCon{x, t}:
          WCon{x, ld.cat(p, m, t, b)}

def ld.wd(u: U32) -> Word(32n):
  match u:
    case U32{w}:
      w

def ld.wcon_cong(-p: Nat, -s: Bool, -x: Word(p), -y: Word(p), +e: {x == y : Word(p)}) -> {WCon{s, x} == WCon{s, y} : Word(1n+p)}:
  %e : {WCon{s, x} == WCon{s, _} : Word(1n+p)}
  {==}

# 2 (t + d) = 2 t + 2 d, from x = t + d
def ld.dstep(-x: Nat, +t: Nat, +d: Nat, +e: {x == Nat.add(t, d) : Nat}) -> {Nat.double(x) == Nat.add(Nat.double(t), Nat.double(d)) : Nat}:
  Equal.trans(Nat, Nat.double(x), Nat.double(Nat.add(t, d)), Nat.add(Nat.double(t), Nat.double(d)), ld.double_cong(x, Nat.add(t, d), e), ld.double_add(t, d))

# a word's value: its low k bits, plus 2^k times its high m bits
def ld.split_val(+k: Nat, +m: Nat, +w: Word(Nat.add(k, m))) -> {Word.to_nat(Nat.add(k, m), w) == Nat.add(Word.to_nat(k, ld.take(k, m, w)), U.U32Nat.dbl(k, Word.to_nat(m, ld.drop(k, m, w)))) : Nat}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      match w:
        case WCon{b, t}:
          match b:
            case False{}:
              ld.dstep(Word.to_nat(Nat.add(p, m), t), Word.to_nat(p, ld.take(p, m, t)), U.U32Nat.dbl(p, Word.to_nat(m, ld.drop(p, m, t))), ld.split_val(p, m, t))
            case True{}:
              ld.succ_cong(Nat.double(Word.to_nat(Nat.add(p, m), t)), Nat.add(Nat.double(Word.to_nat(p, ld.take(p, m, t))), Nat.double(U.U32Nat.dbl(p, Word.to_nat(m, ld.drop(p, m, t))))), ld.dstep(Word.to_nat(Nat.add(p, m), t), Word.to_nat(p, ld.take(p, m, t)), U.U32Nat.dbl(p, Word.to_nat(m, ld.drop(p, m, t))), ld.split_val(p, m, t)))

# k low bits a, then m high bits b: a + 2^k b
def ld.cat_val(+k: Nat, +m: Nat, +a: Word(k), +b: Word(m)) -> {Word.to_nat(Nat.add(k, m), ld.cat(k, m, a, b)) == Nat.add(Word.to_nat(k, a), U.U32Nat.dbl(k, Word.to_nat(m, b))) : Nat}:
  match k:
    case 0n:
      match a:
        case WNil{}:
          {==}
    case 1n+p:
      match a:
        case WCon{x, t}:
          match x:
            case False{}:
              ld.dstep(Word.to_nat(Nat.add(p, m), ld.cat(p, m, t, b)), Word.to_nat(p, t), U.U32Nat.dbl(p, Word.to_nat(m, b)), ld.cat_val(p, m, t, b))
            case True{}:
              ld.succ_cong(Nat.double(Word.to_nat(Nat.add(p, m), ld.cat(p, m, t, b))), Nat.add(Nat.double(Word.to_nat(p, t)), Nat.double(U.U32Nat.dbl(p, Word.to_nat(m, b)))), ld.dstep(Word.to_nat(Nat.add(p, m), ld.cat(p, m, t, b)), Word.to_nat(p, t), U.U32Nat.dbl(p, Word.to_nat(m, b)), ld.cat_val(p, m, t, b)))

def ld.and_ones(+n: Nat, +w: Word(n)) -> {Word.and(n, w, ld.ones(n)) == w : Word(n)}:
  match n:
    case 0n:
      match w:
        case WNil{}:
          {==}
    case 1n+p:
      match w:
        case WCon{b, t}:
          match b:
            case True{}:
              ld.wcon_cong(p, True{}, Word.and(p, t, ld.ones(p)), t, ld.and_ones(p, t))
            case False{}:
              ld.wcon_cong(p, False{}, Word.and(p, t, ld.ones(p)), t, ld.and_ones(p, t))

# w with its low k bits cleared: 2^k times its high m bits
def ld.and_hi_val(+k: Nat, +m: Nat, +w: Word(Nat.add(k, m))) -> {Word.to_nat(Nat.add(k, m), Word.and(Nat.add(k, m), w, ld.cat(k, m, Word.zero(k), ld.ones(m)))) == U.U32Nat.dbl(k, Word.to_nat(m, ld.drop(k, m, w))) : Nat}:
  match k:
    case 0n:
      Equal.cong(Word(m), Nat, x => Word.to_nat(m, x), Word.and(m, w, ld.ones(m)), w, ld.and_ones(m, w))
    case 1n+p:
      match w:
        case WCon{b, t}:
          match b:
            case True{}:
              ld.double_cong(Word.to_nat(Nat.add(p, m), Word.and(Nat.add(p, m), t, ld.cat(p, m, Word.zero(p), ld.ones(m)))), U.U32Nat.dbl(p, Word.to_nat(m, ld.drop(p, m, t))), ld.and_hi_val(p, m, t))
            case False{}:
              ld.double_cong(Word.to_nat(Nat.add(p, m), Word.and(Nat.add(p, m), t, ld.cat(p, m, Word.zero(p), ld.ones(m)))), U.U32Nat.dbl(p, Word.to_nat(m, ld.drop(p, m, t))), ld.and_hi_val(p, m, t))


def ld.add_cong(-a: Nat, -a2: Nat, -b: Nat, -b2: Nat, +ea: {a == a2 : Nat}, +eb: {b == b2 : Nat}) -> {Nat.add(a, b) == Nat.add(a2, b2) : Nat}:
  %ea : {Nat.add(a, b) == Nat.add(_, b2) : Nat}
  %eb : {Nat.add(a, b) == Nat.add(a, _) : Nat}
  {==}

def ld.lt_zero(+x: Nat) -> {Nat.is_lt(x, 0n) == False{} : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      {==}

def ld.lt_dbl(+x: Nat, +y: Nat) -> {Nat.is_lt(Nat.double(x), Nat.double(y)) == Nat.is_lt(x, y) : Bool}:
  match x:
    case 0n:
      match y:
        case 0n:
          {==}
        case 1n+q:
          {==}
    case 1n+p:
      match y:
        case 0n:
          {==}
        case 1n+q:
          ld.lt_dbl(p, q)

def ld.lt_dbl1(+x: Nat, +y: Nat) -> {Nat.is_lt(1n+Nat.double(x), Nat.double(y)) == Nat.is_lt(x, y) : Bool}:
  match x:
    case 0n:
