# the Nat facts of U32 hypotheses: x not below a, x below a
def ld.nge(+x: U32, +a: U32, +h: {U32.is_lt(x, a) == False{} : Bool}) -> {Nat.is_le(U32.to_nat(a), U32.to_nat(x)) == True{} : Bool}:
  ld.le_of_not_lt(U32.to_nat(x), U32.to_nat(a), Equal.trans(Bool, Nat.is_lt(U32.to_nat(x), U32.to_nat(a)), U32.is_lt(x, a), False{}, Equal.sym(Bool, U32.is_lt(x, a), Nat.is_lt(U32.to_nat(x), U32.to_nat(a)), UL.u32_lt_value(x, a)), h))

def ld.nlt(+x: U32, +a: U32, +h: {U32.is_lt(x, a) == True{} : Bool}) -> {Nat.is_lt(U32.to_nat(x), U32.to_nat(a)) == True{} : Bool}:
  Equal.trans(Bool, Nat.is_lt(U32.to_nat(x), U32.to_nat(a)), U32.is_lt(x, a), True{}, Equal.sym(Bool, U32.is_lt(x, a), Nat.is_lt(U32.to_nat(x), U32.to_nat(a)), UL.u32_lt_value(x, a)), h)

def ld.pos_ne(+r: Nat, +h: {Nat.is_lt(0n, r) == True{} : Bool}) -> {Nat.is_eq(r, 0n) == False{} : Bool}:
  match r:
    case 0n:
      ld.absurd({Nat.is_eq(0n, 0n) == False{} : Bool}, ld.ft(h))
    case 1n+p:
      {==}

# q s <= x < (q + 1) s, s = 1 + bp: x = q s + r, r = x - q s below s
def ld.qr_x(+x: Nat, +q: Nat, +bp: Nat, +h1: {Nat.is_le(Nat.mul(q, 1n+bp), x) == True{} : Bool}) -> {Nat.add(Nat.mul(q, 1n+bp), Nat.sub(x, Nat.mul(q, 1n+bp))) == x : Nat}:
  ld.add_sub(Nat.mul(q, 1n+bp), x, h1)

def ld.qr_lt(+x: Nat, +q: Nat, +bp: Nat, +h1: {Nat.is_le(Nat.mul(q, 1n+bp), x) == True{} : Bool}, +h2: {Nat.is_lt(x, Nat.mul(1n+q, 1n+bp)) == True{} : Bool}) -> {Nat.is_lt(Nat.sub(x, Nat.mul(q, 1n+bp)), 1n+bp) == True{} : Bool}:
  +m = Nat.mul(q, 1n+bp)
  +r = Nat.sub(x, m)
  +h3 = ld.lt_rw(x, Nat.add(m, r), Nat.add(1n+bp, m), Nat.add(m, 1n+bp), Equal.sym(Nat, Nat.add(m, r), x, ld.qr_x(x, q, bp, h1)), UL.nat_add_comm(1n+bp, m), h2)
  Equal.trans(Bool, Nat.is_lt(r, 1n+bp), Nat.is_lt(Nat.add(m, r), Nat.add(m, 1n+bp)), True{}, Equal.sym(Bool, Nat.is_lt(Nat.add(m, r), Nat.add(m, 1n+bp)), Nat.is_lt(r, 1n+bp), ld.lt_add_l(m, r, 1n+bp)), h3)

def ld.div_q(+x: Nat, +q: Nat, +bp: Nat, +h1: {Nat.is_le(Nat.mul(q, 1n+bp), x) == True{} : Bool}, +h2: {Nat.is_lt(x, Nat.mul(1n+q, 1n+bp)) == True{} : Bool}) -> {Nat.div(x, 1n+bp) == q : Nat}:
  %ld.qr_x(x, q, bp, h1) : {Nat.div(_, 1n+bp) == q : Nat}
  ld.div_of(q, Nat.sub(x, Nat.mul(q, 1n+bp)), bp, ld.qr_lt(x, q, bp, h1, h2))

# q s < x < (q + 1) s: x mod s is not 0
def ld.mod_nz(+x: Nat, +q: Nat, +bp: Nat, +h1: {Nat.is_lt(Nat.mul(q, 1n+bp), x) == True{} : Bool}, +h2: {Nat.is_lt(x, Nat.mul(1n+q, 1n+bp)) == True{} : Bool}) -> {Nat.is_eq(Nat.mod(x, 1n+bp), 0n) == False{} : Bool}:
  +m = Nat.mul(q, 1n+bp)
  +hle = ld.lt_le(m, x, h1)
  +r = Nat.sub(x, m)
  +ex = ld.qr_x(x, q, bp, hle)
  +hpos = Equal.trans(Bool, Nat.is_lt(0n, r), Nat.is_lt(Nat.add(m, 0n), Nat.add(m, r)), True{}, Equal.sym(Bool, Nat.is_lt(Nat.add(m, 0n), Nat.add(m, r)), Nat.is_lt(0n, r), ld.lt_add_l(m, 0n, r)), ld.lt_rw(m, Nat.add(m, 0n), x, Nat.add(m, r), Equal.sym(Nat, Nat.add(m, 0n), m, UL.nat_add_zero(m)), Equal.sym(Nat, Nat.add(m, r), x, ex), h1))
  %ex : {Nat.is_eq(Nat.mod(_, 1n+bp), 0n) == False{} : Bool}
  %Equal.sym(Nat, Nat.mod(Nat.add(m, r), 1n+bp), r, ld.mod_of(q, r, bp, ld.qr_lt(x, q, bp, hle, h2))) : {Nat.is_eq(_, 0n) == False{} : Bool}
  ld.pos_ne(r, hpos)

# x / 8 is x's bit 3 plus twice its bits above
def ld.q8(+a: U32) -> {Nat.div(U32.to_nat(a), 8n) == Nat.add(ld.bit3(a), U.U32Nat.dbl(1n, Word.to_nat(28n, ld.drop(1n, 28n, ld.drop(3n, 29n, ld.wd(a)))))) : Nat}:
  +t = Word.to_nat(3n, ld.take(3n, 29n, ld.wd(a)))
  +q = Nat.add(ld.bit3(a), U.U32Nat.dbl(1n, Word.to_nat(28n, ld.drop(1n, 28n, ld.drop(3n, 29n, ld.wd(a))))))
  +ea = Equal.trans(Nat, U32.to_nat(a), Nat.add(t, U.U32Nat.dbl(3n, q)), Nat.add(Nat.mul(q, 8n), t), ld.u_split3(a), Equal.trans(Nat, Nat.add(t, U.U32Nat.dbl(3n, q)), Nat.add(U.U32Nat.dbl(3n, q), t), Nat.add(Nat.mul(q, 8n), t), UL.nat_add_comm(t, U.U32Nat.dbl(3n, q)), Equal.cong(Nat, Nat, z => Nat.add(z, t), U.U32Nat.dbl(3n, q), Nat.mul(q, 8n), ld.dbl_mul(3n, q))))
  %Equal.sym(Nat, U32.to_nat(a), Nat.add(Nat.mul(q, 8n), t), ea) : {Nat.div(_, 8n) == q : Nat}
  ld.div_of(q, t, 7n, ld.lo3_lt(a))

def ld.b3_0(+b: Nat, +r: Nat, +hb: {Nat.is_lt(b, 2n) == True{} : Bool}, +e: {Nat.add(b, Nat.double(r)) == 2n : Nat}) -> {b == 0n : Nat}:
  match b:
    case 0n:
      {==}
    case 1n+c:
      match c:
        case 0n:
          ld.absurd({1n == 0n : Nat}, ld.odd_even(r, 1n, e))
        case 1n+d:
          ld.absurd({2n+d == 0n : Nat}, ld.ft(Equal.trans(Bool, False{}, Nat.is_lt(d, 0n), True{}, Equal.sym(Bool, Nat.is_lt(d, 0n), False{}, ld.lt_zero(d)), hb)))

def ld.b3_1(+b: Nat, +r: Nat, +hb: {Nat.is_lt(b, 2n) == True{} : Bool}, +e: {Nat.add(b, Nat.double(r)) == 3n : Nat}) -> {b == 1n : Nat}:
  match b:
    case 0n:
      ld.absurd({0n == 1n : Nat}, ld.odd_even(1n, r, Equal.sym(Nat, Nat.double(r), 3n, e)))
    case 1n+c:
      match c:
        case 0n:
          {==}
        case 1n+d:
          ld.absurd({2n+d == 1n : Nat}, ld.ft(Equal.trans(Bool, False{}, Nat.is_lt(d, 0n), True{}, Equal.sym(Bool, Nat.is_lt(d, 0n), False{}, ld.lt_zero(d)), hb)))

# bit 3 of x in [16, 24) is 0, in [24, 32) is 1
def ld.bit3_0(+a: U32, +h1: {Nat.is_le(16n, U32.to_nat(a)) == True{} : Bool}, +h2: {Nat.is_lt(U32.to_nat(a), 24n) == True{} : Bool}) -> {ld.bit3(a) == 0n : Nat}:
  +r = Word.to_nat(28n, ld.drop(1n, 28n, ld.drop(3n, 29n, ld.wd(a))))
  ld.b3_0(ld.bit3(a), r, ld.bit3_lt(a), Equal.trans(Nat, Nat.add(ld.bit3(a), Nat.double(r)), Nat.div(U32.to_nat(a), 8n), 2n, Equal.sym(Nat, Nat.div(U32.to_nat(a), 8n), Nat.add(ld.bit3(a), Nat.double(r)), ld.q8(a)), ld.div_q(U32.to_nat(a), 2n, 7n, h1, h2)))

def ld.bit3_1(+a: U32, +h1: {Nat.is_le(24n, U32.to_nat(a)) == True{} : Bool}, +h2: {Nat.is_lt(U32.to_nat(a), 32n) == True{} : Bool}) -> {ld.bit3(a) == 1n : Nat}:
  +r = Word.to_nat(28n, ld.drop(1n, 28n, ld.drop(3n, 29n, ld.wd(a))))
  ld.b3_1(ld.bit3(a), r, ld.bit3_lt(a), Equal.trans(Nat, Nat.add(ld.bit3(a), Nat.double(r)), Nat.div(U32.to_nat(a), 8n), 3n, Equal.sym(Nat, Nat.div(U32.to_nat(a), 8n), Nat.add(ld.bit3(a), Nat.double(r)), ld.q8(a)), ld.div_q(U32.to_nat(a), 3n, 7n, h1, h2)))

# the opcode tests of decode.bend: (x & 8) == 8, (x & 7) == 0, (x & 31) == 0
def ld.and8_eq(+a: U32, -b: Nat, +e: {ld.bit3(a) == b : Nat}) -> {U32.is_eq(U32.and(a, 8), 8) == Nat.is_eq(U.U32Nat.dbl(3n, b), 8n) : Bool}:
  Equal.trans(Bool, U32.is_eq(U32.and(a, 8), 8), Nat.is_eq(U32.to_nat(U32.and(a, 8)), U32.to_nat(8)), Nat.is_eq(U.U32Nat.dbl(3n, b), 8n), UL.u32_eq_value(U32.and(a, 8), 8), Equal.cong(Nat, Bool, z => Nat.is_eq(z, 8n), U32.to_nat(U32.and(a, 8)), U.U32Nat.dbl(3n, b), Equal.trans(Nat, U32.to_nat(U32.and(a, 8)), U.U32Nat.dbl(3n, ld.bit3(a)), U.U32Nat.dbl(3n, b), ld.u_and8(a), Equal.cong(Nat, Nat, z => U.U32Nat.dbl(3n, z), ld.bit3(a), b, e))))

def ld.and7_nz(+a: U32, +q: Nat, +h1: {Nat.is_lt(Nat.mul(q, 8n), U32.to_nat(a)) == True{} : Bool}, +h2: {Nat.is_lt(U32.to_nat(a), Nat.mul(1n+q, 8n)) == True{} : Bool}) -> {U32.is_eq(U32.and(a, 7), 0) == False{} : Bool}:
  Equal.trans(Bool, U32.is_eq(U32.and(a, 7), 0), Nat.is_eq(Nat.mod(U32.to_nat(a), 8n), 0n), False{}, Equal.trans(Bool, U32.is_eq(U32.and(a, 7), 0), Nat.is_eq(U32.to_nat(U32.and(a, 7)), U32.to_nat(0)), Nat.is_eq(Nat.mod(U32.to_nat(a), 8n), 0n), UL.u32_eq_value(U32.and(a, 7), 0), Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), U32.to_nat(U32.and(a, 7)), Nat.mod(U32.to_nat(a), 8n), ld.u_mod8(a))), ld.mod_nz(U32.to_nat(a), q, 7n, h1, h2))

def ld.and31_nz(+a: U32, +h1: {Nat.is_lt(32n, U32.to_nat(a)) == True{} : Bool}, +h2: {Nat.is_lt(U32.to_nat(a), 64n) == True{} : Bool}) -> {U32.is_eq(U32.and(a, 31), 0) == False{} : Bool}:
  Equal.trans(Bool, U32.is_eq(U32.and(a, 31), 0), Nat.is_eq(Nat.mod(U32.to_nat(a), 32n), 0n), False{}, Equal.trans(Bool, U32.is_eq(U32.and(a, 31), 0), Nat.is_eq(U32.to_nat(U32.and(a, 31)), U32.to_nat(0)), Nat.is_eq(Nat.mod(U32.to_nat(a), 32n), 0n), UL.u32_eq_value(U32.and(a, 31), 0), Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), U32.to_nat(U32.and(a, 31)), Nat.mod(U32.to_nat(a), 32n), ld.u_mod32(a))), ld.mod_nz(U32.to_nat(a), 1n, 31n, h1, h2))

# M4 with H = 0: D > 0 means lo >= 4 or hi > 0, so the end test (lo < 4 and
# hi == 0) is False

def ld.eq0(+x: Nat, +e: {Nat.is_eq(x, 0n) == True{} : Bool}) -> {x == 0n : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      ld.absurd({1n+p == 0n : Nat}, ld.ft(e))

def ld.ne2(+b2: Bool, +lo: U32, +hi: U32, +e2: {U32.is_eq(hi, 0) == b2 : Bool}, +hl: {Nat.is_lt(U32.to_nat(lo), 4n) == True{} : Bool}, +hz: {Nat.is_lt(0n, Nat.div(Nat.add(U32.to_nat(lo), Nat.mul(U32.to_nat(hi), 256n)), 4n)) == True{} : Bool}) -> {b2 == False{} : Bool}:
  match b2:
    case False{}:
      {==}
    case True{}:
      +eh = ld.eq0(U32.to_nat(hi), Equal.trans(Bool, Nat.is_eq(U32.to_nat(hi), U32.to_nat(0)), U32.is_eq(hi, 0), True{}, Equal.sym(Bool, U32.is_eq(hi, 0), Nat.is_eq(U32.to_nat(hi), U32.to_nat(0)), UL.u32_eq_value(hi, 0)), e2))
      +ed = Equal.trans(Nat, Nat.div(Nat.add(U32.to_nat(lo), Nat.mul(U32.to_nat(hi), 256n)), 4n), Nat.div(Nat.add(U32.to_nat(lo), 0n), 4n), 0n, Equal.cong(Nat, Nat, z => Nat.div(Nat.add(U32.to_nat(lo), Nat.mul(z, 256n)), 4n), U32.to_nat(hi), 0n, eh), Equal.trans(Nat, Nat.div(Nat.add(U32.to_nat(lo), 0n), 4n), Nat.div(U32.to_nat(lo), 4n), 0n, Equal.cong(Nat, Nat, z => Nat.div(z, 4n), Nat.add(U32.to_nat(lo), 0n), U32.to_nat(lo), UL.nat_add_zero(U32.to_nat(lo))), ld.div_of(0n, U32.to_nat(lo), 3n, hl)))
      ld.absurd({True{} == False{} : Bool}, ld.ft(Equal.trans(Bool, False{}, Nat.is_lt(0n, Nat.div(Nat.add(U32.to_nat(lo), Nat.mul(U32.to_nat(hi), 256n)), 4n)), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(0n, z), 0n, Nat.div(Nat.add(U32.to_nat(lo), Nat.mul(U32.to_nat(hi), 256n)), 4n), Equal.sym(Nat, Nat.div(Nat.add(U32.to_nat(lo), Nat.mul(U32.to_nat(hi), 256n)), 4n), 0n, ed)), hz)))

def ld.ne1(+b1: Bool, +lo: U32, +hi: U32, +e1: {U32.is_lt(lo, 4) == b1 : Bool}, +hz: {Nat.is_lt(0n, Nat.div(Nat.add(U32.to_nat(lo), Nat.mul(U32.to_nat(hi), 256n)), 4n)) == True{} : Bool}) -> {Bool.and(b1, U32.is_eq(hi, 0)) == False{} : Bool}:
  match b1:
    case False{}:
      {==}
    case True{}:
      ld.ne2(U32.is_eq(hi, 0), lo, hi, {==}, Equal.trans(Bool, Nat.is_lt(U32.to_nat(lo), U32.to_nat(4)), U32.is_lt(lo, 4), True{}, Equal.sym(Bool, U32.is_lt(lo, 4), Nat.is_lt(U32.to_nat(lo), U32.to_nat(4)), UL.u32_lt_value(lo, 4)), e1), hz)

def ld.notend(+lo: U32, +hi: U32, +hz: {Nat.is_lt(0n, Nat.div(Nat.add(U32.to_nat(lo), Nat.mul(U32.to_nat(hi), 256n)), 4n)) == True{} : Bool}) -> {Bool.and(U32.is_lt(lo, 4), U32.is_eq(hi, 0)) == False{} : Bool}:
  ld.ne1(U32.is_lt(lo, 4), lo, hi, {==}, hz)

# the witnesses: 1 < D + 2^n for D >= 1
def ld.dbl_pos(+n: Nat) -> {Nat.is_le(1n, U.U32Nat.dbl(n, 1n)) == True{} : Bool}:
  ld.le_rw(1n, 1n, Nat.add(1n, Word.to_nat(n, ld.ones(n))), U.U32Nat.dbl(n, 1n), {==}, ld.ones_val(n), UO.nat_le_add_r(1n, Word.to_nat(n, ld.ones(n))))

def ld.wit_lt(+d: Nat, +n: Nat, +h: {Nat.is_le(1n, d) == True{} : Bool}) -> {Nat.is_lt(1n, Nat.add(d, U.U32Nat.dbl(n, 1n))) == True{} : Bool}:
  +p = U.U32Nat.dbl(n, 1n)
  +h1 = ld.le_add_mono(1n, 1n, p, ld.dbl_pos(n))
  +h2 = ld.le_rw(Nat.add(p, 1n), Nat.add(1n, p), Nat.add(p, d), Nat.add(d, p), UL.nat_add_comm(p, 1n), UL.nat_add_comm(p, d), ld.le_add_mono(p, 1n, d, h))
  ld.le_lt(1n, Nat.add(d, p), UO.nat_le_trans(2n, Nat.add(1n, p), Nat.add(d, p), h1, h2))

# n < b + p, a = b: n < a + p, with p left as it is (2^14 is never expanded)
def ld.lt_add_rw(+n: Nat, +p: Nat, +a: Nat, +b: Nat, +e: {a == b : Nat}, +h: {Nat.is_lt(n, Nat.add(b, p)) == True{} : Bool}) -> {Nat.is_lt(n, Nat.add(a, p)) == True{} : Bool}:
  %Equal.sym(Nat, a, b, e) : {Nat.is_lt(n, Nat.add(_, p)) == True{} : Bool}
  h
