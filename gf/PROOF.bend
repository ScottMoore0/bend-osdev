def Laws.mul_inv_rs(a, nz):
  Equal.trans(U32, G.Gf8.mul(G.Gf8.rs(), a, G.Gf8.inv(G.Gf8.rs(), a)), G.Gf8.mul(G.Gf8.rs(), G.Gf8.elt(a), G.Gf8.inv(G.Gf8.rs(), a)), 1, mul_elt_l(G.Gf8.rs(), a, G.Gf8.inv(G.Gf8.rs(), a)), Equal.trans(U32, G.Gf8.mul(G.Gf8.rs(), G.Gf8.elt(a), G.Gf8.inv(G.Gf8.rs(), a)), G.Gf8.mul(G.Gf8.rs(), G.Gf8.elt(a), G.Gf8.inv(G.Gf8.rs(), G.Gf8.elt(a))), 1, Equal.cong(U32, U32, z => G.Gf8.mul(G.Gf8.rs(), G.Gf8.elt(a), z), G.Gf8.inv(G.Gf8.rs(), a), G.Gf8.inv(G.Gf8.rs(), G.Gf8.elt(a)), pow_elt(254n, G.Gf8.rs(), a)), mul_inv_rs.lift(a, nz)))

