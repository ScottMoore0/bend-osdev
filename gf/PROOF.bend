# a nonzero byte as itself, and 0 as 1, so that the per-byte facts hold
# for every byte and need no hypothesis while they are split into cases
def fixz(+x: U32) -> U32:
  Bool.pick(U32, G.Gf8.is_zero(x), 1, x)

