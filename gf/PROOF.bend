# 7. GF(2^m): addition commutes (XOR, bit by bit); for the small named
# fields, products and inverses by cases on the element's m bits

def word_xor_comm(+n: Nat, +a: Word(n), +b: Word(n)) -> {Word.xor(n, a, b) == Word.xor(n, b, a) : Word(n)}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match a b:
        case WCon{+x, +at} WCon{+y, +bt}:
          %bx_comm(x, y) : {WCon{Bool.xor(x, y), Word.xor(p, at, bt)} == WCon{_, Word.xor(p, bt, at)} : Word(1n+p)}
          %word_xor_comm(p, at, bt) : {WCon{Bool.xor(x, y), Word.xor(p, at, bt)} == WCon{Bool.xor(x, y), _} : Word(1n+p)}
          {==}

def u32_xor_comm(+a: U32, +b: U32) -> {U32.xor(a, b) == U32.xor(b, a) : U32}:
  match a b:
    case U32{+x} U32{+y}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.xor(32n, x, y), Word.xor(32n, y, x), word_xor_comm(32n, x, y))

def Laws.gfm_add_comm(f, a, b):
  Equal.cong(U32, U32, z => U32.and(M.Gfm.mask(f), z), U32.xor(a, b), U32.xor(b, a), u32_xor_comm(a, b))

def word_and_zero(+n: Nat, +r: Word(n)) -> {Word.and(n, Word.zero(n), r) == Word.zero(n) : Word(n)}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match r:
        case WCon{+x, +rt}:
          %word_and_zero(p, rt) : {WCon{False{}, Word.and(p, Word.zero(p), rt)} == WCon{False{}, _} : Word(1n+p)}
          {==}

def elt_bits4(+b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool, +r: Word(28n)) -> {M.Gfm.elt(M.Gfm.gf16(), U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, r}}}}}) == U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, Word.zero(28n)}}}}} : U32}:
  Equal.cong(Word(28n), U32, z => U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, z}}}}}, Word.and(28n, Word.zero(28n), r), Word.zero(28n), word_and_zero(28n, r))

def elt_bits5(+b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool, +b4: Bool, +r: Word(27n)) -> {M.Gfm.elt(M.Gfm.gf32(), U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, r}}}}}}) == U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, Word.zero(27n)}}}}}} : U32}:
  Equal.cong(Word(27n), U32, z => U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, z}}}}}}, Word.and(27n, Word.zero(27n), r), Word.zero(27n), word_and_zero(27n, r))

