def mul_inv_aes.lift(+a: U32, +nz: {G.Gf8.is_zero(a) == False{} : Bool}) -> {G.Gf8.mul(G.Gf8.aes(), G.Gf8.elt(a), G.Gf8.inv(G.Gf8.aes(), G.Gf8.elt(a))) == 1 : U32}:
  %fix_nz(a, nz) : {G.Gf8.mul(G.Gf8.aes(), _, G.Gf8.inv(G.Gf8.aes(), G.Gf8.elt(a))) == 1 : U32}
  %fix_nz(a, nz) : {G.Gf8.mul(G.Gf8.aes(), fixz(G.Gf8.elt(a)), G.Gf8.inv(G.Gf8.aes(), _)) == 1 : U32}
  mul_inv_aes.core(a)

def Laws.mul_inv_aes(a, nz):
  Equal.trans(U32, G.Gf8.mul(G.Gf8.aes(), a, G.Gf8.inv(G.Gf8.aes(), a)), G.Gf8.mul(G.Gf8.aes(), G.Gf8.elt(a), G.Gf8.inv(G.Gf8.aes(), a)), 1, mul_elt_l(G.Gf8.aes(), a, G.Gf8.inv(G.Gf8.aes(), a)), Equal.trans(U32, G.Gf8.mul(G.Gf8.aes(), G.Gf8.elt(a), G.Gf8.inv(G.Gf8.aes(), a)), G.Gf8.mul(G.Gf8.aes(), G.Gf8.elt(a), G.Gf8.inv(G.Gf8.aes(), G.Gf8.elt(a))), 1, Equal.cong(U32, U32, z => G.Gf8.mul(G.Gf8.aes(), G.Gf8.elt(a), z), G.Gf8.inv(G.Gf8.aes(), a), G.Gf8.inv(G.Gf8.aes(), G.Gf8.elt(a)), pow_elt(254n, G.Gf8.aes(), a)), mul_inv_aes.lift(a, nz)))

