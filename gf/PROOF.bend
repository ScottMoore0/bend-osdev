def mul_inv_rs.core(+a: U32) -> {G.Gf8.mul(G.Gf8.rs(), fixz(G.Gf8.elt(a)), G.Gf8.inv(G.Gf8.rs(), fixz(G.Gf8.elt(a)))) == 1 : U32}:
  match a:
    case U32{WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, WCon{+b6, WCon{+b7, +r}}}}}}}}}:
      %Equal.sym(U32, G.Gf8.elt(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, r}}}}}}}}}), G.Gf8Bits.to(G.Gf8Bits{b0, b1, b2, b3, b4, b5, b6, b7}), elt_bits(b0, b1, b2, b3, b4, b5, b6, b7, r)) : {G.Gf8.mul(G.Gf8.rs(), fixz(_), G.Gf8.inv(G.Gf8.rs(), fixz(_))) == 1 : U32}
      mul_inv_rs.bits(b0, b1, b2, b3, b4, b5, b6, b7)

def mul_inv_rs.lift(+a: U32, +nz: {G.Gf8.is_zero(a) == False{} : Bool}) -> {G.Gf8.mul(G.Gf8.rs(), G.Gf8.elt(a), G.Gf8.inv(G.Gf8.rs(), G.Gf8.elt(a))) == 1 : U32}:
  %fix_nz(a, nz) : {G.Gf8.mul(G.Gf8.rs(), _, G.Gf8.inv(G.Gf8.rs(), G.Gf8.elt(a))) == 1 : U32}
  %fix_nz(a, nz) : {G.Gf8.mul(G.Gf8.rs(), fixz(G.Gf8.elt(a)), G.Gf8.inv(G.Gf8.rs(), _)) == 1 : U32}
