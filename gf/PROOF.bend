def exp_log_rs.core(+a: U32) -> {G.Gf8.exp(G.Gf8.rs(), G.Gf8.log(G.Gf8.rs(), fixz(G.Gf8.elt(a)))) == fixz(G.Gf8.elt(a)) : U32}:
  match a:
    case U32{WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, WCon{+b6, WCon{+b7, +r}}}}}}}}}:
      %Equal.sym(U32, G.Gf8.elt(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, r}}}}}}}}}), G.Gf8Bits.to(G.Gf8Bits{b0, b1, b2, b3, b4, b5, b6, b7}), elt_bits(b0, b1, b2, b3, b4, b5, b6, b7, r)) : {G.Gf8.exp(G.Gf8.rs(), G.Gf8.log(G.Gf8.rs(), fixz(_))) == fixz(_) : U32}
      exp_log_rs.bits(b0, b1, b2, b3, b4, b5, b6, b7)

def exp_log_rs.lift(+a: U32, +nz: {G.Gf8.is_zero(a) == False{} : Bool}) -> {G.Gf8.exp(G.Gf8.rs(), G.Gf8.log(G.Gf8.rs(), G.Gf8.elt(a))) == G.Gf8.elt(a) : U32}:
  %fix_nz(a, nz) : {G.Gf8.exp(G.Gf8.rs(), G.Gf8.log(G.Gf8.rs(), _)) == G.Gf8.elt(a) : U32}
  %fix_nz(a, nz) : {G.Gf8.exp(G.Gf8.rs(), G.Gf8.log(G.Gf8.rs(), fixz(G.Gf8.elt(a)))) == _ : U32}
  exp_log_rs.core(a)

def Laws.exp_log_rs(a, nz):
  Equal.trans(U32, G.Gf8.exp(G.Gf8.rs(), G.Gf8.log(G.Gf8.rs(), a)), G.Gf8.exp(G.Gf8.rs(), G.Gf8.log(G.Gf8.rs(), G.Gf8.elt(a))), G.Gf8.elt(a), Equal.cong(Nat, U32, z => G.Gf8.exp(G.Gf8.rs(), z), G.Gf8.log(G.Gf8.rs(), a), G.Gf8.log(G.Gf8.rs(), G.Gf8.elt(a)), log_elt(G.Gf8.rs(), a)), exp_log_rs.lift(a, nz))

