def gc.elt0.bits(+b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool, +b4: Bool, +b5: Bool, +b6: Bool, +b7: Bool, h: {U32.is_eq(G.Gf8Bits.to(G.Gf8Bits{b0, b1, b2, b3, b4, b5, b6, b7}), 0) == True{} : Bool}) -> {G.Gf8Bits.to(G.Gf8Bits{b0, b1, b2, b3, b4, b5, b6, b7}) == 0 : U32}:
  match b5 b6 b7:
    case True{} True{} True{}:
      gc.elt0.s111(b0, b1, b2, b3, b4, h)
    case True{} True{} False{}:
      gc.elt0.s011(b0, b1, b2, b3, b4, h)
    case True{} False{} True{}:
      gc.elt0.s101(b0, b1, b2, b3, b4, h)
    case True{} False{} False{}:
      gc.elt0.s001(b0, b1, b2, b3, b4, h)
    case False{} True{} True{}:
      gc.elt0.s110(b0, b1, b2, b3, b4, h)
    case False{} True{} False{}:
      gc.elt0.s010(b0, b1, b2, b3, b4, h)
    case False{} False{} True{}:
      gc.elt0.s100(b0, b1, b2, b3, b4, h)
    case False{} False{} False{}:
      gc.elt0.s000(b0, b1, b2, b3, b4, h)

def gc.elt0(+a: U32, h: {U32.is_eq(G.Gf8.elt(a), 0) == True{} : Bool}) -> {G.Gf8.elt(a) == 0 : U32}:
  match a:
    case U32{WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, WCon{+b6, WCon{+b7, +r}}}}}}}}}:
      gc.elt0.bits(b0, b1, b2, b3, b4, b5, b6, b7, h)

