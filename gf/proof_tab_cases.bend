    case True{} True{} True{}:
      gc.aes.log.bits.s111(b0, b1, b2, b3, b4)
    case True{} True{} False{}:
      gc.aes.log.bits.s011(b0, b1, b2, b3, b4)
    case True{} False{} True{}:
      gc.aes.log.bits.s101(b0, b1, b2, b3, b4)
    case True{} False{} False{}:
      gc.aes.log.bits.s001(b0, b1, b2, b3, b4)
    case False{} True{} True{}:
