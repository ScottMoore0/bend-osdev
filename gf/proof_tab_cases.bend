def gc.rs.log.bits(+b0: Bool, +b1: Bool, +b2: Bool, +b3: Bool, +b4: Bool, +b5: Bool, +b6: Bool, +b7: Bool) -> {A.Arrays.nth(U32, gc.rs.llist(), A.Arrays.index(8n, G.Gf8Bits.to(G.Gf8Bits{b0, b1, b2, b3, b4, b5, b6, b7})), 0) == U32.from_nat(G.Gf8.log(G.Gf8.rs(), G.Gf8Bits.to(G.Gf8Bits{b0, b1, b2, b3, b4, b5, b6, b7}))) : U32}:
  match b5 b6 b7:
    case True{} True{} True{}:
      gc.rs.log.bits.s111(b0, b1, b2, b3, b4)
    case True{} True{} False{}:
      gc.rs.log.bits.s011(b0, b1, b2, b3, b4)
    case True{} False{} True{}:
