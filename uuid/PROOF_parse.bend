# The digits of the Uuid read from digits are those digits in lower case
def RT(r: Result<&2, &2, U.UuidError, U.Uuid>, cs: List<&2, Char>) -> Type:
  match r:
    case Fail{x}:
      Unit
    case Done{u}:
      {U.Uuid.digits(U.Uuid.octets(u)) == tl(cs) : List<&2, Char>}

def R3(r: Result<&2, &2, U.UuidError, U.Uuid>, +bs: List<&2, Word(8n)>, +cs: List<&2, Char>, o: OT(r, bs), hl: {U.Uuid.digits(bs) == tl(cs) : List<&2, Char>}) -> RT(r, cs):
  match r:
    case Done{+u}:
      %Equal.sym(List<&2, Word(8n)>, U.Uuid.octets(u), bs, o) : {U.Uuid.digits(_) == tl(cs) : List<&2, Char>}
      hl
    case Fail{x}:
      Unit{}

def R2(m: Maybe<&2, List<&2, Word(8n)>>, +cs: List<&2, Char>, hl: HT(m, cs)) -> RT(U.Uuid.of_digits(m), cs):
  match m:
    case None{}:
      Unit{}
    case Some{+bs}:
      R3(U.Uuid.length_ok(U.Uuid.of_octets(bs)), bs, cs, O(bs), hl)

# The text
def PT(r: Result<&2, &2, U.UuidError, U.Uuid>, s: String) -> Type:
  match r:
    case Fail{x}:
      Unit
    case Done{u}:
      {U.Uuid.show(u) == String.to_lower(s) : String}

