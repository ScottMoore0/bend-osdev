# An octet read from two digits shows them back
def cat_hi(a: Word(4n), d: Word(4n)) -> {W.W64.bits.hi(4n, 4n, W.W64.bits.cat(4n, 4n, d, a)) == a : Word(4n)}:
  match a:
    case WCon{a0, WCon{a1, WCon{a2, WCon{a3, WNil{}}}}}:
      match d:
        case WCon{d0, WCon{d1, WCon{d2, WCon{d3, WNil{}}}}}:
          {==}

def cat_lo(a: Word(4n), d: Word(4n)) -> {W.W64.bits.lo(4n, 4n, W.W64.bits.cat(4n, 4n, d, a)) == d : Word(4n)}:
  match a:
    case WCon{a0, WCon{a1, WCon{a2, WCon{a3, WNil{}}}}}:
      match d:
        case WCon{d0, WCon{d1, WCon{d2, WCon{d3, WNil{}}}}}:
          {==}

def BT1(m: Maybe<&2, Word(8n)>, c1: Char, -c2: Char) -> Type:
  match m:
    case None{}:
      Unit
    case Some{b}:
      {U.Uuid.hexdigit(U.Uuid.nibble.hi(b)) == Char.to_lower(c1) : Char}

def BT2(m: Maybe<&2, Word(8n)>, -c1: Char, c2: Char) -> Type:
  match m:
    case None{}:
      Unit
    case Some{b}:
      {U.Uuid.hexdigit(U.Uuid.nibble.lo(b)) == Char.to_lower(c2) : Char}

def Bh1(m1: Maybe<&2, Word(4n)>, m2: Maybe<&2, Word(4n)>, +c1: Char, -c2: Char, nc: NT(m1, c1)) -> BT1(U.Uuid.hexval.join(m1, m2), c1, c2):
  match m1 m2:
    case Some{+a} Some{+d}:
      %Equal.sym(Word(4n), W.W64.bits.hi(4n, 4n, W.W64.bits.cat(4n, 4n, d, a)), a, cat_hi(a, d)) : {U.Uuid.hexdigit(_) == Char.to_lower(c1) : Char}
      nc
    case Some{a} None{}:
      Unit{}
    case None{} Some{d}:
      Unit{}
    case None{} None{}:
      Unit{}

def B1(+c1: Char, +c2: Char) -> BT1(U.Uuid.rdbyte(c1, c2), c1, c2):
  Bh1(U.Uuid.hexval(c1), U.Uuid.hexval(c2), c1, c2, nibr(c1))

def Bh2(m1: Maybe<&2, Word(4n)>, m2: Maybe<&2, Word(4n)>, -c1: Char, +c2: Char, nc: NT(m2, c2)) -> BT2(U.Uuid.hexval.join(m1, m2), c1, c2):
  match m1 m2:
    case Some{+a} Some{+d}:
      %Equal.sym(Word(4n), W.W64.bits.lo(4n, 4n, W.W64.bits.cat(4n, 4n, d, a)), d, cat_lo(a, d)) : {U.Uuid.hexdigit(_) == Char.to_lower(c2) : Char}
      nc
    case Some{a} None{}:
      Unit{}
    case None{} Some{d}:
      Unit{}
    case None{} None{}:
      Unit{}

def B2(+c1: Char, +c2: Char) -> BT2(U.Uuid.rdbyte(c1, c2), c1, c2):
  Bh2(U.Uuid.hexval(c1), U.Uuid.hexval(c2), c1, c2, nibr(c2))

# the characters in lower case
def tl(cs: List<&2, Char>) -> List<&2, Char>:
  match cs:
    case Nil{}:
      Nil{}
    case Con{c, t}:
      Con{Char.to_lower(c), tl(t)}

# The octets read from digits show the digits back in lower case
def HT(m: Maybe<&2, List<&2, Word(8n)>>, cs: List<&2, Char>) -> Type:
  match m:
    case None{}:
      Unit
    case Some{bs}:
      {U.Uuid.digits(bs) == tl(cs) : List<&2, Char>}

def HLc(m: Maybe<&2, Word(8n)>, r: Maybe<&2, List<&2, Word(8n)>>, +c1: Char, +c2: Char, +t: List<&2, Char>, b1: BT1(m, c1, c2), b2: BT2(m, c1, c2), ih: HT(r, t)) -> HT(U.Uuid.cons_m(m, r), Con{c1, Con{c2, t}}):
  match m r:
    case Some{+b} Some{+bs}:
      %b1 : {U.Uuid.digits(Con{b, bs}) == Con{_, Con{Char.to_lower(c2), tl(t)}} : List<&2, Char>}
      %b2 : {U.Uuid.digits(Con{b, bs}) == Con{U.Uuid.hexdigit(U.Uuid.nibble.hi(b)), Con{_, tl(t)}} : List<&2, Char>}
      %ih : {U.Uuid.digits(Con{b, bs}) == Con{U.Uuid.hexdigit(U.Uuid.nibble.hi(b)), Con{U.Uuid.hexdigit(U.Uuid.nibble.lo(b)), _}} : List<&2, Char>}
      {==}
    case Some{b} None{}:
      Unit{}
    case None{} Some{bs}:
      Unit{}
    case None{} None{}:
      Unit{}

def HL(cs: List<&2, Char>) -> HT(U.Uuid.hexlist(cs), cs):
  match cs:
    case Nil{}:
      {==}
    case Con{c1, Nil{}}:
      Unit{}
    case Con{+c1, Con{+c2, +t}}:
      HLc(U.Uuid.rdbyte(c1, c2), U.Uuid.hexlist(t), c1, c2, t, B1(c1, c2), B2(c1, c2), HL(t))

# The octets of the Uuid read from 16 octets are those octets
def OT(r: Result<&2, &2, U.UuidError, U.Uuid>, bs: List<&2, Word(8n)>) -> Type:
  match r:
    case Fail{x}:
      Unit
    case Done{u}:
      {U.Uuid.octets(u) == bs : List<&2, Word(8n)>}

def O(bs: List<&2, Word(8n)>) -> OT(U.Uuid.length_ok(U.Uuid.of_octets(bs)), bs):
  match bs:
    case Nil{}:
      Unit{}
    case Con{WCon{x0_0, WCon{x0_1, WCon{x0_2, WCon{x0_3, WCon{x0_4, WCon{x0_5, WCon{x0_6, WCon{x0_7, WNil{}}}}}}}}}, r1}:
      match r1:
