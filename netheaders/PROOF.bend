def Laws.ipv4_round_trip(ihl, e1, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, options, e2, rest):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(I4.Ipv4Header.build(I4.Ipv4Header{4, ihl, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, B.Octets.of_list(options)}), rest)), B.append(B.Octets.to_list(I4.Ipv4Header.build(I4.Ipv4Header{4, ihl, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, B.Octets.of_list(options)})), B.Octets.to_list(rest)), BL.octets_append_list(I4.Ipv4Header.build(I4.Ipv4Header{4, ihl, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, B.Octets.of_list(options)}), rest)) : {I4.Ipv4Header.parse.list(_) == Done{I4.Ipv4Header.norm(I4.Ipv4Header{4, ihl, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, B.Octets.of_list(options)})} : Result<&2, &2, N.NetError, I4.Ipv4Header>}
  ipv4_round_trip.list(ihl, e1, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, options, e2, B.Octets.to_list(rest))

