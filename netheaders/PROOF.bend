def Laws.ipv6_round_trip(tc, fl, pl, nh, hop, src, dst, rest):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(I6.Ipv6Header.build(I6.Ipv6Header{6, tc, fl, pl, nh, hop, src, dst}), rest)), B.append(B.Octets.to_list(I6.Ipv6Header.build(I6.Ipv6Header{6, tc, fl, pl, nh, hop, src, dst})), B.Octets.to_list(rest)), BL.octets_append_list(I6.Ipv6Header.build(I6.Ipv6Header{6, tc, fl, pl, nh, hop, src, dst}), rest)) : {I6.Ipv6Header.parse.list(_) == Done{I6.Ipv6Header.norm(I6.Ipv6Header{6, tc, fl, pl, nh, hop, src, dst})} : Result<&2, &2, N.NetError, I6.Ipv6Header>}
  ipv6_round_trip.list(tc, fl, pl, nh, hop, src, dst, B.Octets.to_list(rest))

