# induction on xs, two bytes at a time; a one-byte xs contradicts e
def inet_sum_split(xs: List<&2, U32>, ys: List<&2, U32>, acc: U32, e: {K.inet_even.list(xs) == True{} : Bool}) -> {K.inet_sum.list(B.append(xs, ys), acc) == K.inet_sum.list(ys, K.inet_sum.list(xs, acc)) : U32}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      match t:
        case Nil{}:
          %e : pick_type(_, {K.inet_sum.list(B.append([x], ys), acc) == K.inet_sum.list(ys, K.inet_sum.list([x], acc)) : U32}, Unit)
          Unit{}
        case Con{y, u}:
          inet_sum_split(u, ys, K.inet_add(acc, K.inet_word(x, y)), e)

def Laws.inet_update_split(acc, a, b, e):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(a, b)), B.append(B.Octets.to_list(a), B.Octets.to_list(b)), BL.octets_append_list(a, b)) : {K.inet_sum.list(_, acc) == K.inet_update(K.inet_update(acc, a), b) : U32}
  inet_sum_split(B.Octets.to_list(a), B.Octets.to_list(b), acc, e)

