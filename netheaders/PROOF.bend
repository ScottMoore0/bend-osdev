    case U32{WCon{sp0, WCon{sp1, WCon{sp2, WCon{sp3, WCon{sp4, WCon{sp5, WCon{sp6, WCon{sp7, WCon{sp8, WCon{sp9, WCon{sp10, WCon{sp11, WCon{sp12, WCon{sp13, WCon{sp14, WCon{sp15, sph}}}}}}}}}}}}}}}}} U32{WCon{dp0, WCon{dp1, WCon{dp2, WCon{dp3, WCon{dp4, WCon{dp5, WCon{dp6, WCon{dp7, WCon{dp8, WCon{dp9, WCon{dp10, WCon{dp11, WCon{dp12, WCon{dp13, WCon{dp14, WCon{dp15, dph}}}}}}}}}}}}}}}}} U32{WCon{sq0, WCon{sq1, WCon{sq2, WCon{sq3, WCon{sq4, WCon{sq5, WCon{sq6, WCon{sq7, WCon{sq8, WCon{sq9, WCon{sq10, WCon{sq11, WCon{sq12, WCon{sq13, WCon{sq14, WCon{sq15, WCon{sq16, WCon{sq17, WCon{sq18, WCon{sq19, WCon{sq20, WCon{sq21, WCon{sq22, WCon{sq23, WCon{sq24, WCon{sq25, WCon{sq26, WCon{sq27, WCon{sq28, WCon{sq29, WCon{sq30, WCon{sq31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{ak0, WCon{ak1, WCon{ak2, WCon{ak3, WCon{ak4, WCon{ak5, WCon{ak6, WCon{ak7, WCon{ak8, WCon{ak9, WCon{ak10, WCon{ak11, WCon{ak12, WCon{ak13, WCon{ak14, WCon{ak15, WCon{ak16, WCon{ak17, WCon{ak18, WCon{ak19, WCon{ak20, WCon{ak21, WCon{ak22, WCon{ak23, WCon{ak24, WCon{ak25, WCon{ak26, WCon{ak27, WCon{ak28, WCon{ak29, WCon{ak30, WCon{ak31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{rs0, WCon{rs1, WCon{rs2, WCon{rs3, rsh}}}}} U32{WCon{fl0, WCon{fl1, WCon{fl2, WCon{fl3, WCon{fl4, WCon{fl5, WCon{fl6, WCon{fl7, flh}}}}}}}}} U32{WCon{win0, WCon{win1, WCon{win2, WCon{win3, WCon{win4, WCon{win5, WCon{win6, WCon{win7, WCon{win8, WCon{win9, WCon{win10, WCon{win11, WCon{win12, WCon{win13, WCon{win14, WCon{win15, winh}}}}}}}}}}}}}}}}} U32{WCon{ck0, WCon{ck1, WCon{ck2, WCon{ck3, WCon{ck4, WCon{ck5, WCon{ck6, WCon{ck7, WCon{ck8, WCon{ck9, WCon{ck10, WCon{ck11, WCon{ck12, WCon{ck13, WCon{ck14, WCon{ck15, ckh}}}}}}}}}}}}}}}}} U32{WCon{ur0, WCon{ur1, WCon{ur2, WCon{ur3, WCon{ur4, WCon{ur5, WCon{ur6, WCon{ur7, WCon{ur8, WCon{ur9, WCon{ur10, WCon{ur11, WCon{ur12, WCon{ur13, WCon{ur14, WCon{ur15, urh}}}}}}}}}}}}}}}}}:
