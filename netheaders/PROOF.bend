def tcp_round_trip.len5(sp: U32, dp: U32, sq: U32, ak: U32, rs: U32, fl: U32, win: U32, ck: U32, ur: U32, lh: Word(28n), options: List<&2, U32>, e2: {B.len(options) == Nat.sub(Nat.mul(4n, U32.to_nat(N.NetField.low(4n, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, lh}}}}}))), 20n) : Nat}, r: List<&2, U32>) -> {T.TcpHeader.parse.list(B.append(B.Octets.to_list(T.TcpHeader.build(T.TcpHeader{sp, dp, sq, ak, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, lh}}}}}, rs, fl, win, ck, ur, B.Octets.of_list(options)})), r)) == Done{T.TcpHeader.norm(T.TcpHeader{sp, dp, sq, ak, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, lh}}}}}, rs, fl, win, ck, ur, B.Octets.of_list(options)})} : Result<&2, &2, N.NetError, T.TcpHeader>}:
  match options:
    case Nil{}:
      tcp_round_trip.leaf5(sp, dp, sq, ak, rs, fl, win, ck, ur, lh, r)
