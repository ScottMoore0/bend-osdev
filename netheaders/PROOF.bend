def ipv4_round_trip.len5(dscp: U32, ecn: U32, tl: U32, id: U32, fl: U32, fo: U32, ttl: U32, pr: U32, ck: U32, src: U32, dst: U32, lh: Word(28n), options: List<&2, U32>, e2: {B.len(options) == Nat.sub(Nat.mul(4n, U32.to_nat(N.NetField.low(4n, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, lh}}}}}))), 20n) : Nat}, r: List<&2, U32>) -> {I4.Ipv4Header.parse.list(B.append(B.Octets.to_list(I4.Ipv4Header.build(I4.Ipv4Header{4, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, lh}}}}}, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, B.Octets.of_list(options)})), r)) == Done{I4.Ipv4Header.norm(I4.Ipv4Header{4, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, lh}}}}}, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, B.Octets.of_list(options)})} : Result<&2, &2, N.NetError, I4.Ipv4Header>}:
  match options:
    case Nil{}:
      ipv4_round_trip.leaf5(dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, lh, r)
    case Con{y, u}:
      %e2 : pick_type(Nat.is_eq(_, 0n), {I4.Ipv4Header.parse.list(B.append(B.Octets.to_list(I4.Ipv4Header.build(I4.Ipv4Header{4, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, lh}}}}}, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, B.Octets.of_list(Con{y, u})})), r)) == Done{I4.Ipv4Header.norm(I4.Ipv4Header{4, U32{WCon{True{}, WCon{False{}, WCon{True{}, WCon{False{}, lh}}}}}, dscp, ecn, tl, id, fl, fo, ttl, pr, ck, src, dst, B.Octets.of_list(Con{y, u})})} : Result<&2, &2, N.NetError, I4.Ipv4Header>}, Unit)
      Unit{}

