# How the proofs go.
#
# Every parser reads B.Octets.to_list of its input. For a built header
# followed by any bytes rest, bytes' interface law octets_append_list turns
# to_list(build(h) ++ rest) into to_list(build(h)) ++ to_list(rest), so a
# lemma about the list parser finishes the proof with rest an arbitrary list.
#
# The lemmas split every field into the bits its width keeps (a deep pattern,
# generated by a script) and compute: the builders and parsers work on bits,
# so both sides normalise to the same term. Bits above a field's width stay a
# variable, which the masks drop; the parsers never look at rest.
#
# A length that is a field (IPv4's IHL, TCP's data offset) is split into its
# four bits, sixteen cases: those below 5 contradict the hypothesis e1; for
# the others, a case analysis on the options list down to its required length
# leaves one case, the rest contradicting e2.

# a type chosen by a Bool: refutes a hypothesis {True{} == False{}} or
# {False{} == True{}}
def pick_type(b: Bool, t: Type, f: Type) -> Type:
  match b:
    case True{}:
      t
    case False{}:
      f

# the tag test on a built untagged header is the test on its EtherType
def eth_tag_test(d: E.MacAddr, s: E.MacAddr, t: U32, r: List<&2, U32>) -> {E.EthHeader.tagged(E.EthHeader.TPID_8021Q(), B.append(B.Octets.to_list(E.EthHeader.build(E.EthHeader{d, s, None{}, t})), r)) == U32.is_eq(B.low16(t), 33024) : Bool}:
  match d s t:
    case E.MacAddr{U32{WCon{d0_0, WCon{d0_1, WCon{d0_2, WCon{d0_3, WCon{d0_4, WCon{d0_5, WCon{d0_6, WCon{d0_7, d0_h}}}}}}}}}, U32{WCon{d1_0, WCon{d1_1, WCon{d1_2, WCon{d1_3, WCon{d1_4, WCon{d1_5, WCon{d1_6, WCon{d1_7, d1_h}}}}}}}}}, U32{WCon{d2_0, WCon{d2_1, WCon{d2_2, WCon{d2_3, WCon{d2_4, WCon{d2_5, WCon{d2_6, WCon{d2_7, d2_h}}}}}}}}}, U32{WCon{d3_0, WCon{d3_1, WCon{d3_2, WCon{d3_3, WCon{d3_4, WCon{d3_5, WCon{d3_6, WCon{d3_7, d3_h}}}}}}}}}, U32{WCon{d4_0, WCon{d4_1, WCon{d4_2, WCon{d4_3, WCon{d4_4, WCon{d4_5, WCon{d4_6, WCon{d4_7, d4_h}}}}}}}}}, U32{WCon{d5_0, WCon{d5_1, WCon{d5_2, WCon{d5_3, WCon{d5_4, WCon{d5_5, WCon{d5_6, WCon{d5_7, d5_h}}}}}}}}}} E.MacAddr{U32{WCon{s0_0, WCon{s0_1, WCon{s0_2, WCon{s0_3, WCon{s0_4, WCon{s0_5, WCon{s0_6, WCon{s0_7, s0_h}}}}}}}}}, U32{WCon{s1_0, WCon{s1_1, WCon{s1_2, WCon{s1_3, WCon{s1_4, WCon{s1_5, WCon{s1_6, WCon{s1_7, s1_h}}}}}}}}}, U32{WCon{s2_0, WCon{s2_1, WCon{s2_2, WCon{s2_3, WCon{s2_4, WCon{s2_5, WCon{s2_6, WCon{s2_7, s2_h}}}}}}}}}, U32{WCon{s3_0, WCon{s3_1, WCon{s3_2, WCon{s3_3, WCon{s3_4, WCon{s3_5, WCon{s3_6, WCon{s3_7, s3_h}}}}}}}}}, U32{WCon{s4_0, WCon{s4_1, WCon{s4_2, WCon{s4_3, WCon{s4_4, WCon{s4_5, WCon{s4_6, WCon{s4_7, s4_h}}}}}}}}}, U32{WCon{s5_0, WCon{s5_1, WCon{s5_2, WCon{s5_3, WCon{s5_4, WCon{s5_5, WCon{s5_6, WCon{s5_7, s5_h}}}}}}}}}} U32{WCon{t0, WCon{t1, WCon{t2, WCon{t3, WCon{t4, WCon{t5, WCon{t6, WCon{t7, WCon{t8, WCon{t9, WCon{t10, WCon{t11, WCon{t12, WCon{t13, WCon{t14, WCon{t15, th}}}}}}}}}}}}}}}}}:
      {==}

# the untagged branch of the parser gives the header back
def eth_untagged(d: E.MacAddr, s: E.MacAddr, t: U32, r: List<&2, U32>) -> {E.EthHeader.parse.go(False{}, B.append(B.Octets.to_list(E.EthHeader.build(E.EthHeader{d, s, None{}, t})), r)) == Done{E.EthHeader.norm(E.EthHeader{d, s, None{}, t})} : Result<&2, &2, N.NetError, E.EthHeader>}:
  match d s t:
    case E.MacAddr{U32{WCon{d0_0, WCon{d0_1, WCon{d0_2, WCon{d0_3, WCon{d0_4, WCon{d0_5, WCon{d0_6, WCon{d0_7, d0_h}}}}}}}}}, U32{WCon{d1_0, WCon{d1_1, WCon{d1_2, WCon{d1_3, WCon{d1_4, WCon{d1_5, WCon{d1_6, WCon{d1_7, d1_h}}}}}}}}}, U32{WCon{d2_0, WCon{d2_1, WCon{d2_2, WCon{d2_3, WCon{d2_4, WCon{d2_5, WCon{d2_6, WCon{d2_7, d2_h}}}}}}}}}, U32{WCon{d3_0, WCon{d3_1, WCon{d3_2, WCon{d3_3, WCon{d3_4, WCon{d3_5, WCon{d3_6, WCon{d3_7, d3_h}}}}}}}}}, U32{WCon{d4_0, WCon{d4_1, WCon{d4_2, WCon{d4_3, WCon{d4_4, WCon{d4_5, WCon{d4_6, WCon{d4_7, d4_h}}}}}}}}}, U32{WCon{d5_0, WCon{d5_1, WCon{d5_2, WCon{d5_3, WCon{d5_4, WCon{d5_5, WCon{d5_6, WCon{d5_7, d5_h}}}}}}}}}} E.MacAddr{U32{WCon{s0_0, WCon{s0_1, WCon{s0_2, WCon{s0_3, WCon{s0_4, WCon{s0_5, WCon{s0_6, WCon{s0_7, s0_h}}}}}}}}}, U32{WCon{s1_0, WCon{s1_1, WCon{s1_2, WCon{s1_3, WCon{s1_4, WCon{s1_5, WCon{s1_6, WCon{s1_7, s1_h}}}}}}}}}, U32{WCon{s2_0, WCon{s2_1, WCon{s2_2, WCon{s2_3, WCon{s2_4, WCon{s2_5, WCon{s2_6, WCon{s2_7, s2_h}}}}}}}}}, U32{WCon{s3_0, WCon{s3_1, WCon{s3_2, WCon{s3_3, WCon{s3_4, WCon{s3_5, WCon{s3_6, WCon{s3_7, s3_h}}}}}}}}}, U32{WCon{s4_0, WCon{s4_1, WCon{s4_2, WCon{s4_3, WCon{s4_4, WCon{s4_5, WCon{s4_6, WCon{s4_7, s4_h}}}}}}}}}, U32{WCon{s5_0, WCon{s5_1, WCon{s5_2, WCon{s5_3, WCon{s5_4, WCon{s5_5, WCon{s5_6, WCon{s5_7, s5_h}}}}}}}}}} U32{WCon{t0, WCon{t1, WCon{t2, WCon{t3, WCon{t4, WCon{t5, WCon{t6, WCon{t7, WCon{t8, WCon{t9, WCon{t10, WCon{t11, WCon{t12, WCon{t13, WCon{t14, WCon{t15, th}}}}}}}}}}}}}}}}}:
      {==}

def eth_round_trip.list(+d: E.MacAddr, +s: E.MacAddr, +t: U32, e: {U32.is_eq(B.low16(t), 33024) == False{} : Bool}, +r: List<&2, U32>) -> {E.EthHeader.parse.list(E.EthHeader.TPID_8021Q(), B.append(B.Octets.to_list(E.EthHeader.build(E.EthHeader{d, s, None{}, t})), r)) == Done{E.EthHeader.norm(E.EthHeader{d, s, None{}, t})} : Result<&2, &2, N.NetError, E.EthHeader>}:
  %Equal.sym(Bool, E.EthHeader.tagged(E.EthHeader.TPID_8021Q(), B.append(B.Octets.to_list(E.EthHeader.build(E.EthHeader{d, s, None{}, t})), r)), False{}, Equal.trans(Bool, E.EthHeader.tagged(E.EthHeader.TPID_8021Q(), B.append(B.Octets.to_list(E.EthHeader.build(E.EthHeader{d, s, None{}, t})), r)), U32.is_eq(B.low16(t), 33024), False{}, eth_tag_test(d, s, t, r), e)) : {E.EthHeader.parse.go(_, B.append(B.Octets.to_list(E.EthHeader.build(E.EthHeader{d, s, None{}, t})), r)) == Done{E.EthHeader.norm(E.EthHeader{d, s, None{}, t})} : Result<&2, &2, N.NetError, E.EthHeader>}
  eth_untagged(d, s, t, r)

def Laws.eth_round_trip(d, s, t, e, rest):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(E.EthHeader.build(E.EthHeader{d, s, None{}, t}), rest)), B.append(B.Octets.to_list(E.EthHeader.build(E.EthHeader{d, s, None{}, t})), B.Octets.to_list(rest)), BL.octets_append_list(E.EthHeader.build(E.EthHeader{d, s, None{}, t}), rest)) : {E.EthHeader.parse.list(E.EthHeader.TPID_8021Q(), _) == Done{E.EthHeader.norm(E.EthHeader{d, s, None{}, t})} : Result<&2, &2, N.NetError, E.EthHeader>}
  eth_round_trip.list(d, s, t, e, B.Octets.to_list(rest))

def eth_round_trip_vlan.list(d: E.MacAddr, s: E.MacAddr, v: E.VlanTag, t: U32, r: List<&2, U32>) -> {E.EthHeader.parse.list(E.EthHeader.TPID_8021Q(), B.append(B.Octets.to_list(E.EthHeader.build(E.EthHeader{d, s, Some{v}, t})), r)) == Done{E.EthHeader.norm(E.EthHeader{d, s, Some{v}, t})} : Result<&2, &2, N.NetError, E.EthHeader>}:
  match d s v t:
    case E.MacAddr{U32{WCon{d0_0, WCon{d0_1, WCon{d0_2, WCon{d0_3, WCon{d0_4, WCon{d0_5, WCon{d0_6, WCon{d0_7, d0_h}}}}}}}}}, U32{WCon{d1_0, WCon{d1_1, WCon{d1_2, WCon{d1_3, WCon{d1_4, WCon{d1_5, WCon{d1_6, WCon{d1_7, d1_h}}}}}}}}}, U32{WCon{d2_0, WCon{d2_1, WCon{d2_2, WCon{d2_3, WCon{d2_4, WCon{d2_5, WCon{d2_6, WCon{d2_7, d2_h}}}}}}}}}, U32{WCon{d3_0, WCon{d3_1, WCon{d3_2, WCon{d3_3, WCon{d3_4, WCon{d3_5, WCon{d3_6, WCon{d3_7, d3_h}}}}}}}}}, U32{WCon{d4_0, WCon{d4_1, WCon{d4_2, WCon{d4_3, WCon{d4_4, WCon{d4_5, WCon{d4_6, WCon{d4_7, d4_h}}}}}}}}}, U32{WCon{d5_0, WCon{d5_1, WCon{d5_2, WCon{d5_3, WCon{d5_4, WCon{d5_5, WCon{d5_6, WCon{d5_7, d5_h}}}}}}}}}} E.MacAddr{U32{WCon{s0_0, WCon{s0_1, WCon{s0_2, WCon{s0_3, WCon{s0_4, WCon{s0_5, WCon{s0_6, WCon{s0_7, s0_h}}}}}}}}}, U32{WCon{s1_0, WCon{s1_1, WCon{s1_2, WCon{s1_3, WCon{s1_4, WCon{s1_5, WCon{s1_6, WCon{s1_7, s1_h}}}}}}}}}, U32{WCon{s2_0, WCon{s2_1, WCon{s2_2, WCon{s2_3, WCon{s2_4, WCon{s2_5, WCon{s2_6, WCon{s2_7, s2_h}}}}}}}}}, U32{WCon{s3_0, WCon{s3_1, WCon{s3_2, WCon{s3_3, WCon{s3_4, WCon{s3_5, WCon{s3_6, WCon{s3_7, s3_h}}}}}}}}}, U32{WCon{s4_0, WCon{s4_1, WCon{s4_2, WCon{s4_3, WCon{s4_4, WCon{s4_5, WCon{s4_6, WCon{s4_7, s4_h}}}}}}}}}, U32{WCon{s5_0, WCon{s5_1, WCon{s5_2, WCon{s5_3, WCon{s5_4, WCon{s5_5, WCon{s5_6, WCon{s5_7, s5_h}}}}}}}}}} E.VlanTag{U32{WCon{vp0, WCon{vp1, WCon{vp2, vph}}}}, U32{WCon{vd0, vdh}}, U32{WCon{vi0, WCon{vi1, WCon{vi2, WCon{vi3, WCon{vi4, WCon{vi5, WCon{vi6, WCon{vi7, WCon{vi8, WCon{vi9, WCon{vi10, WCon{vi11, vih}}}}}}}}}}}}}} U32{WCon{t0, WCon{t1, WCon{t2, WCon{t3, WCon{t4, WCon{t5, WCon{t6, WCon{t7, WCon{t8, WCon{t9, WCon{t10, WCon{t11, WCon{t12, WCon{t13, WCon{t14, WCon{t15, th}}}}}}}}}}}}}}}}}:
      {==}

def Laws.eth_round_trip_vlan(d, s, v, t, rest):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(E.EthHeader.build(E.EthHeader{d, s, Some{v}, t}), rest)), B.append(B.Octets.to_list(E.EthHeader.build(E.EthHeader{d, s, Some{v}, t})), B.Octets.to_list(rest)), BL.octets_append_list(E.EthHeader.build(E.EthHeader{d, s, Some{v}, t}), rest)) : {E.EthHeader.parse.list(E.EthHeader.TPID_8021Q(), _) == Done{E.EthHeader.norm(E.EthHeader{d, s, Some{v}, t})} : Result<&2, &2, N.NetError, E.EthHeader>}
  eth_round_trip_vlan.list(d, s, v, t, B.Octets.to_list(rest))

def arp_round_trip.list(p: A.ArpPacket, r: List<&2, U32>) -> {A.ArpPacket.parse.list(B.append(B.Octets.to_list(A.ArpPacket.build(p)), r)) == Done{A.ArpPacket.norm(p)} : Result<&2, &2, N.NetError, A.ArpPacket>}:
  match p:
    case A.ArpPacket{U32{WCon{o0, WCon{o1, WCon{o2, WCon{o3, WCon{o4, WCon{o5, WCon{o6, WCon{o7, WCon{o8, WCon{o9, WCon{o10, WCon{o11, WCon{o12, WCon{o13, WCon{o14, WCon{o15, oh}}}}}}}}}}}}}}}}}, E.MacAddr{U32{WCon{sha0_0, WCon{sha0_1, WCon{sha0_2, WCon{sha0_3, WCon{sha0_4, WCon{sha0_5, WCon{sha0_6, WCon{sha0_7, sha0_h}}}}}}}}}, U32{WCon{sha1_0, WCon{sha1_1, WCon{sha1_2, WCon{sha1_3, WCon{sha1_4, WCon{sha1_5, WCon{sha1_6, WCon{sha1_7, sha1_h}}}}}}}}}, U32{WCon{sha2_0, WCon{sha2_1, WCon{sha2_2, WCon{sha2_3, WCon{sha2_4, WCon{sha2_5, WCon{sha2_6, WCon{sha2_7, sha2_h}}}}}}}}}, U32{WCon{sha3_0, WCon{sha3_1, WCon{sha3_2, WCon{sha3_3, WCon{sha3_4, WCon{sha3_5, WCon{sha3_6, WCon{sha3_7, sha3_h}}}}}}}}}, U32{WCon{sha4_0, WCon{sha4_1, WCon{sha4_2, WCon{sha4_3, WCon{sha4_4, WCon{sha4_5, WCon{sha4_6, WCon{sha4_7, sha4_h}}}}}}}}}, U32{WCon{sha5_0, WCon{sha5_1, WCon{sha5_2, WCon{sha5_3, WCon{sha5_4, WCon{sha5_5, WCon{sha5_6, WCon{sha5_7, sha5_h}}}}}}}}}}, U32{WCon{spa0, WCon{spa1, WCon{spa2, WCon{spa3, WCon{spa4, WCon{spa5, WCon{spa6, WCon{spa7, WCon{spa8, WCon{spa9, WCon{spa10, WCon{spa11, WCon{spa12, WCon{spa13, WCon{spa14, WCon{spa15, WCon{spa16, WCon{spa17, WCon{spa18, WCon{spa19, WCon{spa20, WCon{spa21, WCon{spa22, WCon{spa23, WCon{spa24, WCon{spa25, WCon{spa26, WCon{spa27, WCon{spa28, WCon{spa29, WCon{spa30, WCon{spa31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}, E.MacAddr{U32{WCon{tha0_0, WCon{tha0_1, WCon{tha0_2, WCon{tha0_3, WCon{tha0_4, WCon{tha0_5, WCon{tha0_6, WCon{tha0_7, tha0_h}}}}}}}}}, U32{WCon{tha1_0, WCon{tha1_1, WCon{tha1_2, WCon{tha1_3, WCon{tha1_4, WCon{tha1_5, WCon{tha1_6, WCon{tha1_7, tha1_h}}}}}}}}}, U32{WCon{tha2_0, WCon{tha2_1, WCon{tha2_2, WCon{tha2_3, WCon{tha2_4, WCon{tha2_5, WCon{tha2_6, WCon{tha2_7, tha2_h}}}}}}}}}, U32{WCon{tha3_0, WCon{tha3_1, WCon{tha3_2, WCon{tha3_3, WCon{tha3_4, WCon{tha3_5, WCon{tha3_6, WCon{tha3_7, tha3_h}}}}}}}}}, U32{WCon{tha4_0, WCon{tha4_1, WCon{tha4_2, WCon{tha4_3, WCon{tha4_4, WCon{tha4_5, WCon{tha4_6, WCon{tha4_7, tha4_h}}}}}}}}}, U32{WCon{tha5_0, WCon{tha5_1, WCon{tha5_2, WCon{tha5_3, WCon{tha5_4, WCon{tha5_5, WCon{tha5_6, WCon{tha5_7, tha5_h}}}}}}}}}}, U32{WCon{tpa0, WCon{tpa1, WCon{tpa2, WCon{tpa3, WCon{tpa4, WCon{tpa5, WCon{tpa6, WCon{tpa7, WCon{tpa8, WCon{tpa9, WCon{tpa10, WCon{tpa11, WCon{tpa12, WCon{tpa13, WCon{tpa14, WCon{tpa15, WCon{tpa16, WCon{tpa17, WCon{tpa18, WCon{tpa19, WCon{tpa20, WCon{tpa21, WCon{tpa22, WCon{tpa23, WCon{tpa24, WCon{tpa25, WCon{tpa26, WCon{tpa27, WCon{tpa28, WCon{tpa29, WCon{tpa30, WCon{tpa31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      {==}

def Laws.arp_round_trip(p, rest):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(A.ArpPacket.build(p), rest)), B.append(B.Octets.to_list(A.ArpPacket.build(p)), B.Octets.to_list(rest)), BL.octets_append_list(A.ArpPacket.build(p), rest)) : {A.ArpPacket.parse.list(_) == Done{A.ArpPacket.norm(p)} : Result<&2, &2, N.NetError, A.ArpPacket>}
  arp_round_trip.list(p, B.Octets.to_list(rest))

def ipv6_round_trip.list(tc: U32, fl: U32, pl: U32, nh: U32, hop: U32, src: I6.Ipv6Addr, dst: I6.Ipv6Addr, r: List<&2, U32>) -> {I6.Ipv6Header.parse.list(B.append(B.Octets.to_list(I6.Ipv6Header.build(I6.Ipv6Header{6, tc, fl, pl, nh, hop, src, dst})), r)) == Done{I6.Ipv6Header.norm(I6.Ipv6Header{6, tc, fl, pl, nh, hop, src, dst})} : Result<&2, &2, N.NetError, I6.Ipv6Header>}:
  match tc fl pl nh hop src dst:
