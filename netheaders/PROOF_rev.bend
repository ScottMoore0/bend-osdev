                      match t5:
                        case Nil{}:
                          %e : rv.pick(T.TcpHeader, _, {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Nil{}}}}}})) : B.Octets}, Unit)
                          Unit{}
