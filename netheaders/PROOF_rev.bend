# Proofs of LAWS_rev.bend, written by ref/gen_rev.py.
#
# How the proofs go. A law's bytes o are of_list(to_list(o)), so a lemma on
# the list xs = to_list(o) finishes it. The lemma takes xs apart down to the
# bytes the header needs: a shorter xs makes the parse a failure,
# contradicting the hypothesis. With the bytes x0 .. x(n-1) and the rest,
# the hypothesis says h is what the parser read, G (rv.get of the parse);
# the bytes taken from o are of_list of the first n of xs (rv.take_of); and
# two lists with the same bytes (after masking) make the same Octets
# (rv.of_mask). That last equality is a computation on the bytes' bits (a
# deep pattern): every field the parser read is written back bit for bit.
import Base
import ../bytes/bytes.bend as B
import ../bytes/LAWS.bend as BL
import ../bytes/PROOF.bend as BP
import ../u32/LAWS.bend as UL
import ../u32/PROOF.bend as UP
import ./netheaders.bend as N
import ./ethernet.bend as E
import ./arp.bend as A
import ./ipv4.bend as I4
import ./ipv6.bend as I6
import ./icmp.bend as C
import ./udp.bend as U
import ./tcp.bend as T
import ./proof_ones.bend as S
import ./LAWS_rev.bend as Laws

# Results

def rv.pick(-X: Data, r: Result<&2, &2, N.NetError, X>, t: Type, f: Type) -> Type:
  match r:
    case Done{x}:
      t
    case Fail{e}:
      f

def rv.get(-X: Data, r: Result<&2, &2, N.NetError, X>, +d: X) -> X:
  match r:
    case Done{x}:
      x
    case Fail{e}:
      d

# Bytes

# the first n bytes of of_list(xs), n <= len(xs), are of_list of the first n
# of xs
def rv.take_of(+n: Nat, +xs: List<&2, U32>, +h: {Nat.is_le(n, B.len(xs)) == True{} : Bool}) -> {B.Octets.take(n, B.Octets.of_list(xs)) == B.Octets.of_list(B.take(n, xs)) : B.Octets}:
  %BL.take_drop(n, xs) : {B.Octets.take(n, B.Octets.of_list(_)) == B.Octets.of_list(B.take(n, xs)) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.of_list(B.append(B.take(n, xs), B.drop(n, xs))), B.Octets.append(B.Octets.of_list(B.take(n, xs)), B.Octets.of_list(B.drop(n, xs))), S.os.of_list_append(B.take(n, xs), B.drop(n, xs))) : {B.Octets.take(n, _) == B.Octets.of_list(B.take(n, xs)) : B.Octets}
  %Equal.trans(Nat, B.Octets.len(B.Octets.of_list(B.take(n, xs))), B.len(B.take(n, xs)), n, BL.octets_len_of_list(B.take(n, xs)), S.os.len_take(n, xs, h)) : {B.Octets.take(_, B.Octets.append(B.Octets.of_list(B.take(n, xs)), B.Octets.of_list(B.drop(n, xs)))) == B.Octets.of_list(B.take(n, xs)) : B.Octets}
  BL.octets_take_append(B.Octets.of_list(B.take(n, xs)), B.Octets.of_list(B.drop(n, xs)))

# two lists with the same bytes are the same Octets
def rv.of_mask(+a: List<&2, U32>, +b: List<&2, U32>, +e: {B.mask(a) == B.mask(b) : List<&2, U32>}) -> {B.Octets.of_list(a) == B.Octets.of_list(b) : B.Octets}:
  %BL.octets_of_list_idempotent(a) : {_ == B.Octets.of_list(b) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(a)), B.mask(a), BL.octets_to_of(a)) : {B.Octets.of_list(_) == B.Octets.of_list(b) : B.Octets}
  %Equal.sym(List<&2, U32>, B.mask(a), B.mask(b), e) : {B.Octets.of_list(_) == B.Octets.of_list(b) : B.Octets}
  %BL.octets_to_of(b) : {B.Octets.of_list(_) == B.Octets.of_list(b) : B.Octets}
  BL.octets_of_list_idempotent(b)

# icmp_reverse: the bytes' bits written back
def icmp_reverse.masks(x0: U32, x1: U32, x2: U32, x3: U32, x4: U32, x5: U32, x6: U32, x7: U32, +rest: List<&2, U32>, +h: C.IcmpHeader) -> {B.mask(C.IcmpHeader.build.list(rv.get(C.IcmpHeader, C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h))) == B.mask(B.take(C.IcmpHeader.length(rv.get(C.IcmpHeader, C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})) : List<&2, U32>}:
  match x0 x1 x2 x3 x4 x5 x6 x7:
    case U32{WCon{x0_0, WCon{x0_1, WCon{x0_2, WCon{x0_3, WCon{x0_4, WCon{x0_5, WCon{x0_6, WCon{x0_7, x0_h}}}}}}}}} U32{WCon{x1_0, WCon{x1_1, WCon{x1_2, WCon{x1_3, WCon{x1_4, WCon{x1_5, WCon{x1_6, WCon{x1_7, x1_h}}}}}}}}} U32{WCon{x2_0, WCon{x2_1, WCon{x2_2, WCon{x2_3, WCon{x2_4, WCon{x2_5, WCon{x2_6, WCon{x2_7, x2_h}}}}}}}}} U32{WCon{x3_0, WCon{x3_1, WCon{x3_2, WCon{x3_3, WCon{x3_4, WCon{x3_5, WCon{x3_6, WCon{x3_7, x3_h}}}}}}}}} U32{WCon{x4_0, WCon{x4_1, WCon{x4_2, WCon{x4_3, WCon{x4_4, WCon{x4_5, WCon{x4_6, WCon{x4_7, x4_h}}}}}}}}} U32{WCon{x5_0, WCon{x5_1, WCon{x5_2, WCon{x5_3, WCon{x5_4, WCon{x5_5, WCon{x5_6, WCon{x5_7, x5_h}}}}}}}}} U32{WCon{x6_0, WCon{x6_1, WCon{x6_2, WCon{x6_3, WCon{x6_4, WCon{x6_5, WCon{x6_6, WCon{x6_7, x6_h}}}}}}}}} U32{WCon{x7_0, WCon{x7_1, WCon{x7_2, WCon{x7_3, WCon{x7_4, WCon{x7_5, WCon{x7_6, WCon{x7_7, x7_h}}}}}}}}}:
      {==}

def icmp_reverse.full(+x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +rest: List<&2, U32>, +h: C.IcmpHeader, e: {C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}) == Done{h} : Result<&2, &2, N.NetError, C.IcmpHeader>}) -> {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})) : B.Octets}:
  %Equal.cong(Result<&2, &2, N.NetError, C.IcmpHeader>, C.IcmpHeader, z => rv.get(C.IcmpHeader, z, h), C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), Done{h}, e) : {C.IcmpHeader.build(_) == B.Octets.take(C.IcmpHeader.length(_), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.take(C.IcmpHeader.length(rv.get(C.IcmpHeader, C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})), B.Octets.of_list(B.take(C.IcmpHeader.length(rv.get(C.IcmpHeader, C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})), rv.take_of(C.IcmpHeader.length(rv.get(C.IcmpHeader, C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}, S.os.le_zero(B.len(rest)))) : {C.IcmpHeader.build(rv.get(C.IcmpHeader, C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)) == _ : B.Octets}
  rv.of_mask(C.IcmpHeader.build.list(rv.get(C.IcmpHeader, C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), B.take(C.IcmpHeader.length(rv.get(C.IcmpHeader, C.IcmpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), icmp_reverse.masks(x0, x1, x2, x3, x4, x5, x6, x7, rest, h))

def icmp_reverse.list(xs: List<&2, U32>, +h: C.IcmpHeader, e: {C.IcmpHeader.parse.list(xs) == Done{h} : Result<&2, &2, N.NetError, C.IcmpHeader>}) -> {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(xs)) : B.Octets}:
  match xs:
    case Nil{}:
      %e : rv.pick(C.IcmpHeader, _, {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(Nil{})) : B.Octets}, Unit)
      Unit{}
    case Con{+x0, +t1}:
      match t1:
        case Nil{}:
          %e : rv.pick(C.IcmpHeader, _, {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(Con{x0, Nil{}})) : B.Octets}, Unit)
          Unit{}
        case Con{+x1, +t2}:
          match t2:
            case Nil{}:
              %e : rv.pick(C.IcmpHeader, _, {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Nil{}}})) : B.Octets}, Unit)
              Unit{}
            case Con{+x2, +t3}:
              match t3:
                case Nil{}:
                  %e : rv.pick(C.IcmpHeader, _, {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Nil{}}}})) : B.Octets}, Unit)
                  Unit{}
                case Con{+x3, +t4}:
                  match t4:
                    case Nil{}:
                      %e : rv.pick(C.IcmpHeader, _, {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Nil{}}}}})) : B.Octets}, Unit)
                      Unit{}
                    case Con{+x4, +t5}:
                      match t5:
                        case Nil{}:
                          %e : rv.pick(C.IcmpHeader, _, {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Nil{}}}}}})) : B.Octets}, Unit)
                          Unit{}
                        case Con{+x5, +t6}:
                          match t6:
                            case Nil{}:
                              %e : rv.pick(C.IcmpHeader, _, {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Nil{}}}}}}})) : B.Octets}, Unit)
                              Unit{}
                            case Con{+x6, +t7}:
                              match t7:
                                case Nil{}:
                                  %e : rv.pick(C.IcmpHeader, _, {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Nil{}}}}}}}})) : B.Octets}, Unit)
                                  Unit{}
                                case Con{+x7, +t8}:
                                  icmp_reverse.full(x0, x1, x2, x3, x4, x5, x6, x7, t8, h, e)

def Laws.icmp_reverse(o, h, e):
  %BL.octets_of_to(o) : {C.IcmpHeader.build(h) == B.Octets.take(C.IcmpHeader.length(h), _) : B.Octets}
  icmp_reverse.list(B.Octets.to_list(o), h, e)

# udp_reverse: the bytes' bits written back
def udp_reverse.masks(x0: U32, x1: U32, x2: U32, x3: U32, x4: U32, x5: U32, x6: U32, x7: U32, +rest: List<&2, U32>, +h: U.UdpHeader) -> {B.mask(U.UdpHeader.build.list(rv.get(U.UdpHeader, U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h))) == B.mask(B.take(U.UdpHeader.header_length(rv.get(U.UdpHeader, U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})) : List<&2, U32>}:
  match x0 x1 x2 x3 x4 x5 x6 x7:
    case U32{WCon{x0_0, WCon{x0_1, WCon{x0_2, WCon{x0_3, WCon{x0_4, WCon{x0_5, WCon{x0_6, WCon{x0_7, x0_h}}}}}}}}} U32{WCon{x1_0, WCon{x1_1, WCon{x1_2, WCon{x1_3, WCon{x1_4, WCon{x1_5, WCon{x1_6, WCon{x1_7, x1_h}}}}}}}}} U32{WCon{x2_0, WCon{x2_1, WCon{x2_2, WCon{x2_3, WCon{x2_4, WCon{x2_5, WCon{x2_6, WCon{x2_7, x2_h}}}}}}}}} U32{WCon{x3_0, WCon{x3_1, WCon{x3_2, WCon{x3_3, WCon{x3_4, WCon{x3_5, WCon{x3_6, WCon{x3_7, x3_h}}}}}}}}} U32{WCon{x4_0, WCon{x4_1, WCon{x4_2, WCon{x4_3, WCon{x4_4, WCon{x4_5, WCon{x4_6, WCon{x4_7, x4_h}}}}}}}}} U32{WCon{x5_0, WCon{x5_1, WCon{x5_2, WCon{x5_3, WCon{x5_4, WCon{x5_5, WCon{x5_6, WCon{x5_7, x5_h}}}}}}}}} U32{WCon{x6_0, WCon{x6_1, WCon{x6_2, WCon{x6_3, WCon{x6_4, WCon{x6_5, WCon{x6_6, WCon{x6_7, x6_h}}}}}}}}} U32{WCon{x7_0, WCon{x7_1, WCon{x7_2, WCon{x7_3, WCon{x7_4, WCon{x7_5, WCon{x7_6, WCon{x7_7, x7_h}}}}}}}}}:
      {==}

def udp_reverse.full(+x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +rest: List<&2, U32>, +h: U.UdpHeader, e: {U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}) == Done{h} : Result<&2, &2, N.NetError, U.UdpHeader>}) -> {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})) : B.Octets}:
  %Equal.cong(Result<&2, &2, N.NetError, U.UdpHeader>, U.UdpHeader, z => rv.get(U.UdpHeader, z, h), U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), Done{h}, e) : {U.UdpHeader.build(_) == B.Octets.take(U.UdpHeader.header_length(_), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.take(U.UdpHeader.header_length(rv.get(U.UdpHeader, U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})), B.Octets.of_list(B.take(U.UdpHeader.header_length(rv.get(U.UdpHeader, U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}})), rv.take_of(U.UdpHeader.header_length(rv.get(U.UdpHeader, U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}, S.os.le_zero(B.len(rest)))) : {U.UdpHeader.build(rv.get(U.UdpHeader, U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)) == _ : B.Octets}
  rv.of_mask(U.UdpHeader.build.list(rv.get(U.UdpHeader, U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), B.take(U.UdpHeader.header_length(rv.get(U.UdpHeader, U.UdpHeader.parse.list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), h)), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, rest}}}}}}}}), udp_reverse.masks(x0, x1, x2, x3, x4, x5, x6, x7, rest, h))

def udp_reverse.list(xs: List<&2, U32>, +h: U.UdpHeader, e: {U.UdpHeader.parse.list(xs) == Done{h} : Result<&2, &2, N.NetError, U.UdpHeader>}) -> {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(xs)) : B.Octets}:
  match xs:
    case Nil{}:
      %e : rv.pick(U.UdpHeader, _, {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(Nil{})) : B.Octets}, Unit)
      Unit{}
    case Con{+x0, +t1}:
      match t1:
        case Nil{}:
          %e : rv.pick(U.UdpHeader, _, {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(Con{x0, Nil{}})) : B.Octets}, Unit)
          Unit{}
        case Con{+x1, +t2}:
          match t2:
            case Nil{}:
              %e : rv.pick(U.UdpHeader, _, {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(Con{x0, Con{x1, Nil{}}})) : B.Octets}, Unit)
              Unit{}
            case Con{+x2, +t3}:
              match t3:
                case Nil{}:
                  %e : rv.pick(U.UdpHeader, _, {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Nil{}}}})) : B.Octets}, Unit)
                  Unit{}
                case Con{+x3, +t4}:
                  match t4:
                    case Nil{}:
                      %e : rv.pick(U.UdpHeader, _, {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Nil{}}}}})) : B.Octets}, Unit)
                      Unit{}
                    case Con{+x4, +t5}:
                      match t5:
                        case Nil{}:
                          %e : rv.pick(U.UdpHeader, _, {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Nil{}}}}}})) : B.Octets}, Unit)
                          Unit{}
                        case Con{+x5, +t6}:
                          match t6:
                            case Nil{}:
                              %e : rv.pick(U.UdpHeader, _, {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Nil{}}}}}}})) : B.Octets}, Unit)
                              Unit{}
                            case Con{+x6, +t7}:
                              match t7:
                                case Nil{}:
                                  %e : rv.pick(U.UdpHeader, _, {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Nil{}}}}}}}})) : B.Octets}, Unit)
                                  Unit{}
                                case Con{+x7, +t8}:
                                  udp_reverse.full(x0, x1, x2, x3, x4, x5, x6, x7, t8, h, e)

def Laws.udp_reverse(o, h, e):
  %BL.octets_of_to(o) : {U.UdpHeader.build(h) == B.Octets.take(U.UdpHeader.header_length(h), _) : B.Octets}
  udp_reverse.list(B.Octets.to_list(o), h, e)

# Maybe, conditions, and equal words

def rv.some(-X: Data, m: Maybe<&2, X>, +d: X) -> X:
  match m:
    case Some{x}:
      x
    case None{}:
      d

# net.check answered Done{h}: its value is h, and its condition held
def rv.check_done(-X: Data, b: Bool, +err: N.NetError, +x: X, +h: X, e: {N.net.check(X, b, err, x) == Done{h} : Result<&2, &2, N.NetError, X>}) -> {x == h : X}:
  match b:
    case True{}:
      Equal.cong(Result<&2, &2, N.NetError, X>, X, z => rv.get(X, z, x), Done{x}, Done{h}, e)
    case False{}:
      %e : rv.pick(X, _, {x == h : X}, Unit)
      Unit{}

def rv.check_true(-X: Data, b: Bool, +err: N.NetError, +x: X, +h: X, e: {N.net.check(X, b, err, x) == Done{h} : Result<&2, &2, N.NetError, X>}) -> {b == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      %e : rv.pick(X, _, {False{} == True{} : Bool}, Unit)
      Unit{}

def rv.and_l(x: Bool, +y: Bool, +e: {Bool.and(x, y) == True{} : Bool}) -> {x == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, S.os.ft(e))

def rv.and_r(x: Bool, +y: Bool, +e: {Bool.and(x, y) == True{} : Bool}) -> {y == True{} : Bool}:
  match x:
    case True{}:
      e
    case False{}:
      Empty.absurd({y == True{} : Bool}, S.os.ft(e))

def rv.nat_eq(x: Nat, y: Nat, +h: {Nat.is_eq(x, y) == True{} : Bool}) -> {x == y : Nat}:
  match x y:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Empty.absurd({0n == 1n+q : Nat}, S.os.ft(h))
    case 1n+p 0n:
      Empty.absurd({1n+p == 0n : Nat}, S.os.ft(h))
    case 1n+ +p 1n+ +q:
      S.os.succ_cong(p, q, rv.nat_eq(p, q, h))

def rv.eq_true(+a: U32, +b: U32, +h: {U32.is_eq(a, b) == True{} : Bool}) -> {a == b : U32}:
  UL.u32_value_eq(a, b, rv.nat_eq(U32.to_nat(a), U32.to_nat(b), Equal.trans(Bool, Nat.is_eq(U32.to_nat(a), U32.to_nat(b)), U32.is_eq(a, b), True{}, Equal.sym(Bool, U32.is_eq(a, b), Nat.is_eq(U32.to_nat(a), U32.to_nat(b)), UL.u32_eq_value(a, b)), h)))

# net.has(n, xs): xs has at least n bytes
def rv.has_le(n: Nat, xs: List<&2, U32>, +h: {N.net.has(n, xs) == True{} : Bool}) -> {Nat.is_le(n, B.len(xs)) == True{} : Bool}:
  match n:
    case 0n:
      S.os.le_zero(B.len(xs))
    case 1n+ +m:
      match xs:
        case Nil{}:
          Empty.absurd({Nat.is_le(1n+m, 0n) == True{} : Bool}, S.os.ft(h))
        case Con{x, +t}:
          rv.has_le(m, t, h)

