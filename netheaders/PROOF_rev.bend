def ipv4_reverse.list(xs: List<&2, U32>, +h: I4.Ipv4Header, e: {I4.Ipv4Header.parse.list(xs) == Done{h} : Result<&2, &2, N.NetError, I4.Ipv4Header>}) -> {I4.Ipv4Header.build(h) == B.Octets.take(I4.Ipv4Header.length(h), B.Octets.of_list(xs)) : B.Octets}:
  match xs:
    case Nil{}:
      %e : rv.pick(I4.Ipv4Header, _, {I4.Ipv4Header.build(h) == B.Octets.take(I4.Ipv4Header.length(h), B.Octets.of_list(Nil{})) : B.Octets}, Unit)
      Unit{}
    case Con{+x0, +t1}:
      match t1:
        case Nil{}:
          %e : rv.pick(I4.Ipv4Header, _, {I4.Ipv4Header.build(h) == B.Octets.take(I4.Ipv4Header.length(h), B.Octets.of_list(Con{x0, Nil{}})) : B.Octets}, Unit)
          Unit{}
        case Con{+x1, +t2}:
          match t2:
            case Nil{}:
