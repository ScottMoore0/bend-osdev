def tcp_reverse.list(xs: List<&2, U32>, +h: T.TcpHeader, e: {T.TcpHeader.parse.list(xs) == Done{h} : Result<&2, &2, N.NetError, T.TcpHeader>}) -> {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(xs)) : B.Octets}:
  match xs:
    case Nil{}:
      %e : rv.pick(T.TcpHeader, _, {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(Nil{})) : B.Octets}, Unit)
      Unit{}
    case Con{+x0, +t1}:
      match t1:
        case Nil{}:
          %e : rv.pick(T.TcpHeader, _, {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(Con{x0, Nil{}})) : B.Octets}, Unit)
          Unit{}
        case Con{+x1, +t2}:
          match t2:
            case Nil{}:
              %e : rv.pick(T.TcpHeader, _, {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Nil{}}})) : B.Octets}, Unit)
