def eth_reverse.split(b: Bool, +x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x11: U32, +x12: U32, +x13: U32, +rest: List<&2, U32>, +h: E.EthHeader, +eb: {U32.is_eq(rv.some(U32, B.be16_at(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, rest}}}}}}}}}}}}}}, 12n), 0), 33024) == b : Bool}, e: {E.EthHeader.parse.go(b, Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, rest}}}}}}}}}}}}}}) == Done{h} : Result<&2, &2, N.NetError, E.EthHeader>}) -> {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, rest}}}}}}}}}}}}}})) : B.Octets}:
  match b:
    case False{}:
      eth_reverse.untagged(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, rest, h, e)
    case True{}:
      eth_reverse.tagged(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, rest, eb, h, e)

def eth_reverse.full(+x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +x5: U32, +x6: U32, +x7: U32, +x8: U32, +x9: U32, +x10: U32, +x11: U32, +x12: U32, +x13: U32, +rest: List<&2, U32>, +h: E.EthHeader, e: {E.EthHeader.parse.list(E.EthHeader.TPID_8021Q(), Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, rest}}}}}}}}}}}}}}) == Done{h} : Result<&2, &2, N.NetError, E.EthHeader>}) -> {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, rest}}}}}}}}}}}}}})) : B.Octets}:
  eth_reverse.split(U32.is_eq(rv.some(U32, B.be16_at(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, rest}}}}}}}}}}}}}}, 12n), 0), 33024), x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, rest, h, {==}, e)

def eth_reverse.list(xs: List<&2, U32>, +h: E.EthHeader, e: {E.EthHeader.parse.list(E.EthHeader.TPID_8021Q(), xs) == Done{h} : Result<&2, &2, N.NetError, E.EthHeader>}) -> {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(xs)) : B.Octets}:
  match xs:
    case Nil{}:
      %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Nil{})) : B.Octets}, Unit)
      Unit{}
    case Con{+x0, +t1}:
      match t1:
        case Nil{}:
          %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Nil{}})) : B.Octets}, Unit)
          Unit{}
        case Con{+x1, +t2}:
          match t2:
            case Nil{}:
              %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Nil{}}})) : B.Octets}, Unit)
              Unit{}
            case Con{+x2, +t3}:
              match t3:
                case Nil{}:
                  %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Nil{}}}})) : B.Octets}, Unit)
                  Unit{}
                case Con{+x3, +t4}:
                  match t4:
                    case Nil{}:
                      %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Nil{}}}}})) : B.Octets}, Unit)
                      Unit{}
                    case Con{+x4, +t5}:
                      match t5:
                        case Nil{}:
                          %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Nil{}}}}}})) : B.Octets}, Unit)
                          Unit{}
                        case Con{+x5, +t6}:
                          match t6:
                            case Nil{}:
                              %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Nil{}}}}}}})) : B.Octets}, Unit)
                              Unit{}
                            case Con{+x6, +t7}:
                              match t7:
                                case Nil{}:
                                  %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Nil{}}}}}}}})) : B.Octets}, Unit)
                                  Unit{}
                                case Con{+x7, +t8}:
                                  match t8:
                                    case Nil{}:
                                      %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Nil{}}}}}}}}})) : B.Octets}, Unit)
                                      Unit{}
                                    case Con{+x8, +t9}:
                                      match t9:
                                        case Nil{}:
                                          %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Nil{}}}}}}}}}})) : B.Octets}, Unit)
                                          Unit{}
                                        case Con{+x9, +t10}:
                                          match t10:
                                            case Nil{}:
                                              %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Nil{}}}}}}}}}}})) : B.Octets}, Unit)
                                              Unit{}
                                            case Con{+x10, +t11}:
                                              match t11:
                                                case Nil{}:
                                                  %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Nil{}}}}}}}}}}}})) : B.Octets}, Unit)
                                                  Unit{}
                                                case Con{+x11, +t12}:
                                                  match t12:
                                                    case Nil{}:
                                                      %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Nil{}}}}}}}}}}}}})) : B.Octets}, Unit)
                                                      Unit{}
                                                    case Con{+x12, +t13}:
                                                      match t13:
                                                        case Nil{}:
                                                          %e : rv.pick(E.EthHeader, _, {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Nil{}}}}}}}}}}}}}})) : B.Octets}, Unit)
                                                          Unit{}
                                                        case Con{+x13, +t14}:
                                                          eth_reverse.full(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, t14, h, e)

def Laws.eth_reverse(o, h, e):
  %BL.octets_of_to(o) : {E.EthHeader.build(h) == B.Octets.take(E.EthHeader.length(h), _) : B.Octets}
  eth_reverse.list(B.Octets.to_list(o), h, e)
