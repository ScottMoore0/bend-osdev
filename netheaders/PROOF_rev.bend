                                                            case Con{+x14, +t15}:
                                                              match t15:
                                                                case Nil{}:
                                                                  %e : rv.pick(T.TcpHeader, _, {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, Con{x14, Nil{}}}}}}}}}}}}}}}})) : B.Octets}, Unit)
                                                                  Unit{}
                                                                case Con{+x15, +t16}:
                                                                  match t16:
                                                                    case Nil{}:
                                                                      %e : rv.pick(T.TcpHeader, _, {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, Con{x14, Con{x15, Nil{}}}}}}}}}}}}}}}}})) : B.Octets}, Unit)
                                                                      Unit{}
                                                                    case Con{+x16, +t17}:
                                                                      match t17:
                                                                        case Nil{}:
                                                                          %e : rv.pick(T.TcpHeader, _, {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, Con{x14, Con{x15, Con{x16, Nil{}}}}}}}}}}}}}}}}}})) : B.Octets}, Unit)
                                                                          Unit{}
                                                                        case Con{+x17, +t18}:
                                                                          match t18:
                                                                            case Nil{}:
                                                                              %e : rv.pick(T.TcpHeader, _, {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, Con{x14, Con{x15, Con{x16, Con{x17, Nil{}}}}}}}}}}}}}}}}}}})) : B.Octets}, Unit)
                                                                              Unit{}
                                                                            case Con{+x18, +t19}:
                                                                              match t19:
                                                                                case Nil{}:
                                                                                  %e : rv.pick(T.TcpHeader, _, {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Con{x9, Con{x10, Con{x11, Con{x12, Con{x13, Con{x14, Con{x15, Con{x16, Con{x17, Con{x18, Nil{}}}}}}}}}}}}}}}}}}}})) : B.Octets}, Unit)
                                                                                  Unit{}
                                                                                case Con{+x19, +t20}:
                                                                                  tcp_reverse.full(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, t20, h, e)

def Laws.tcp_reverse(o, h, e):
  %BL.octets_of_to(o) : {T.TcpHeader.build(h) == B.Octets.take(T.TcpHeader.length(h), _) : B.Octets}
  tcp_reverse.list(B.Octets.to_list(o), h, e)

