def Laws.arp_reverse(o, h, e):
  %BL.octets_of_to(o) : {A.ArpPacket.build(h) == B.Octets.take(A.ArpPacket.length(h), _) : B.Octets}
  arp_reverse.list(B.Octets.to_list(o), h, e)

# IPv4's checks: version, IHL, and the bytes present
def rv4.done(vok: Bool, +pres: Bool, +x: I4.Ipv4Header, +h: I4.Ipv4Header, e: {I4.Ipv4Header.check(vok, True{}, pres, x) == Done{h} : Result<&2, &2, N.NetError, I4.Ipv4Header>}) -> {x == h : I4.Ipv4Header}:
  match vok:
    case True{}:
      rv.check_done(I4.Ipv4Header, pres, N.NetTruncated{}, x, h, e)
    case False{}:
      %e : rv.pick(I4.Ipv4Header, _, {x == h : I4.Ipv4Header}, Unit)
      Unit{}

def rv4.pres(vok: Bool, +pres: Bool, +x: I4.Ipv4Header, +h: I4.Ipv4Header, e: {I4.Ipv4Header.check(vok, True{}, pres, x) == Done{h} : Result<&2, &2, N.NetError, I4.Ipv4Header>}) -> {pres == True{} : Bool}:
  match vok:
    case True{}:
      rv.check_true(I4.Ipv4Header, pres, N.NetTruncated{}, x, h, e)
    case False{}:
      %e : rv.pick(I4.Ipv4Header, _, {pres == True{} : Bool}, Unit)
      Unit{}

def rv4.no_ihl(vok: Bool, +pres: Bool, +x: I4.Ipv4Header, +h: I4.Ipv4Header, e: {I4.Ipv4Header.check(vok, False{}, pres, x) == Done{h} : Result<&2, &2, N.NetError, I4.Ipv4Header>}) -> Empty:
  match vok:
    case True{}:
      %e : rv.pick(I4.Ipv4Header, _, Empty, Unit)
      Unit{}
    case False{}:
      %e : rv.pick(I4.Ipv4Header, _, Empty, Unit)
      Unit{}

