# Converting a list to Octets and back masks each element: bytes' interface
# law octets_to_of, so nothing here depends on how Octets stores its bytes.
def octets_list(xs: List<&2, U32>) -> {B.mask(xs) == B.Octets.to_list(B.Octets.of_list(xs)) : List<&2, U32>}:
  Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(xs)), B.mask(xs), BL.octets_to_of(xs))

def masklist_append(a: List<&2, U32>, +b: List<&2, U32>) -> {B.append(B.mask(a), B.mask(b)) == B.mask(B.append(a, b)) : List<&2, U32>}:
  match a:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      %masklist_append(t, b) : {Con{B.byte(h), B.append(B.mask(t), B.mask(b))} == Con{B.byte(h), _} : List<&2, U32>}
      {==}

# MBR: the boot code, masked and fitted to n bytes, is dropped whole
def drop_fit(n: Nat, xs: List<&2, U32>, +r: List<&2, U32>) -> {r == B.drop(n, B.append(B.mask(M.Mbr.fit(n, xs)), r)) : List<&2, U32>}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match xs:
        case Nil{}:
          drop_fit(p, Nil{}, r)
        case Con{h, t}:
          drop_fit(p, t, r)

