def Laws.gpt_entry_round_trip(e):
  match e:
    case G.GptEntry{t, u, first, last, attr, name}:
      %UL.make_bytes(t) : {G.GptEntry.decode(G.GptEntry.encode(G.GptEntry{_, u, first, last, attr, name})) == Done{G.GptEntry.norm(G.GptEntry{_, u, first, last, attr, name})} : Result<&2, &2, G.GptError, G.GptEntry>}
