def Laws.gpt_header_round_trip(h):
  match h:
    case G.GptHeader{rev, size, crc, my, alt, first, last, guid, elba, count, esize, ecrc}:
      %WL.parts_of(my) : {G.Gpt.parse_header(G.Gpt.build_header(G.GptHeader{rev, size, crc, _, alt, first, last, guid, elba, count, esize, ecrc})) == Done{G.GptHeader.seal(G.GptHeader{rev, size, crc, _, alt, first, last, guid, elba, count, esize, ecrc})} : Result<&2, &2, G.GptError, G.GptHeader>}
      %WL.parts_of(alt) : {G.Gpt.parse_header(G.Gpt.build_header(G.GptHeader{rev, size, crc, W.W64.from_parts(W.W64.hi(my), W.W64.lo(my)), _, first, last, guid, elba, count, esize, ecrc})) == Done{G.GptHeader.seal(G.GptHeader{rev, size, crc, W.W64.from_parts(W.W64.hi(my), W.W64.lo(my)), _, first, last, guid, elba, count, esize, ecrc})} : Result<&2, &2, G.GptError, G.GptHeader>}
      %WL.parts_of(first) : {G.Gpt.parse_header(G.Gpt.build_header(G.GptHeader{rev, size, crc, W.W64.from_parts(W.W64.hi(my), W.W64.lo(my)), W.W64.from_parts(W.W64.hi(alt), W.W64.lo(alt)), _, last, guid, elba, count, esize, ecrc})) == Done{G.GptHeader.seal(G.GptHeader{rev, size, crc, W.W64.from_parts(W.W64.hi(my), W.W64.lo(my)), W.W64.from_parts(W.W64.hi(alt), W.W64.lo(alt)), _, last, guid, elba, count, esize, ecrc})} : Result<&2, &2, G.GptError, G.GptHeader>}
      %WL.parts_of(last) : {G.Gpt.parse_header(G.Gpt.build_header(G.GptHeader{rev, size, crc, W.W64.from_parts(W.W64.hi(my), W.W64.lo(my)), W.W64.from_parts(W.W64.hi(alt), W.W64.lo(alt)), W.W64.from_parts(W.W64.hi(first), W.W64.lo(first)), _, guid, elba, count, esize, ecrc})) == Done{G.GptHeader.seal(G.GptHeader{rev, size, crc, W.W64.from_parts(W.W64.hi(my), W.W64.lo(my)), W.W64.from_parts(W.W64.hi(alt), W.W64.lo(alt)), W.W64.from_parts(W.W64.hi(first), W.W64.lo(first)), _, guid, elba, count, esize, ecrc})} : Result<&2, &2, G.GptError, G.GptHeader>}
      %WL.parts_of(elba) : {G.Gpt.parse_header(G.Gpt.build_header(G.GptHeader{rev, size, crc, W.W64.from_parts(W.W64.hi(my), W.W64.lo(my)), W.W64.from_parts(W.W64.hi(alt), W.W64.lo(alt)), W.W64.from_parts(W.W64.hi(first), W.W64.lo(first)), W.W64.from_parts(W.W64.hi(last), W.W64.lo(last)), guid, _, count, esize, ecrc})) == Done{G.GptHeader.seal(G.GptHeader{rev, size, crc, W.W64.from_parts(W.W64.hi(my), W.W64.lo(my)), W.W64.from_parts(W.W64.hi(alt), W.W64.lo(alt)), W.W64.from_parts(W.W64.hi(first), W.W64.lo(first)), W.W64.from_parts(W.W64.hi(last), W.W64.lo(last)), guid, _, count, esize, ecrc})} : Result<&2, &2, G.GptError, G.GptHeader>}
