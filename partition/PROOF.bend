def Laws.gpt_header_crc(h):
  %octets_list(G.Gpt.header.encode(h, G.Gpt.crc_of(h, G.Gpt.pad(G.GptLayout.standard())), G.Gpt.pad(G.GptLayout.standard()))) : {G.Gpt.crc_ok.list(_) == True{} : Bool}
  %stored(h, G.Gpt.crc_of(h, G.Gpt.pad(G.GptLayout.standard()))) : {G.Gpt.list_eq(_, G.Gpt.le32s(C.crc32(B.Octets.of_list(G.Gpt.crc_input(B.mask(G.Gpt.header.encode(h, G.Gpt.crc_of(h, G.Gpt.pad(G.GptLayout.standard())), G.Gpt.pad(G.GptLayout.standard())))))))) == True{} : Bool}
  %zero(h, G.Gpt.crc_of(h, G.Gpt.pad(G.GptLayout.standard()))) : {G.Gpt.list_eq(G.Gpt.le32s(G.Gpt.crc_of(h, G.Gpt.pad(G.GptLayout.standard()))), G.Gpt.le32s(C.crc32(B.Octets.of_list(_)))) == True{} : Bool}
  %octets_list(G.Gpt.header.encode(h, 0, G.Gpt.pad(G.GptLayout.standard()))) : {G.Gpt.list_eq(G.Gpt.le32s(C.crc32(B.Octets.of_list(G.Gpt.crc_input(_)))), G.Gpt.le32s(C.crc32(B.Octets.of_list(G.Gpt.crc_input(B.mask(G.Gpt.header.encode(h, 0, G.Gpt.pad(G.GptLayout.standard())))))))) == True{} : Bool}
  list_eq_refl(G.Gpt.le32s(C.crc32(B.Octets.of_list(G.Gpt.crc_input(B.mask(G.Gpt.header.encode(h, 0, G.Gpt.pad(G.GptLayout.standard()))))))))

