# Gpt.build: the entries CRC it stores, read back through the round trip
def Laws.gpt_build_entries_crc(h, es):
  match h:
    case G.GptHeader{rev, size, crc, my, alt, first, last, guid, elba, count, esize, ecrc}:
      %Equal.sym(Result<&2, &2, G.GptError, G.GptHeader>, G.Gpt.parse_header(G.Gpt.build_header(G.GptHeader.with_entries_crc(G.GptHeader{rev, size, crc, my, alt, first, last, guid, elba, count, esize, ecrc}, C.crc32(G.Gpt.entries_encode(es))))), Done{G.GptHeader.seal(G.GptHeader.with_entries_crc(G.GptHeader{rev, size, crc, my, alt, first, last, guid, elba, count, esize, ecrc}, C.crc32(G.Gpt.entries_encode(es))))}, Laws.gpt_header_round_trip(G.GptHeader.with_entries_crc(G.GptHeader{rev, size, crc, my, alt, first, last, guid, elba, count, esize, ecrc}, C.crc32(G.Gpt.entries_encode(es))))) : {Result.map(&2, &2, G.GptError, G.GptHeader, U32, G.GptHeader.entries_crc, _) == Done{C.crc32(G.Gpt.entries_encode(es))} : Result<&2, &2, G.GptError, U32>}
      {==}

