# Lengths: Rs.small8's parity has 4 symbols

def rsp.app_len(a: List<&2, U32>, +b: List<&2, U32>) -> {List.length(&2, U32, List.append(&2, U32, a, b)) == Nat.add(List.length(&2, U32, a), List.length(&2, U32, b)) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{h, +t}:
      %rsp.app_len(t, b) : {1n+List.length(&2, U32, List.append(&2, U32, t, b)) == 1n+_ : Nat}
      {==}

def rsp.add_len(a: List<&2, U32>, b: List<&2, U32>, +same: {List.length(&2, U32, a) == List.length(&2, U32, b) : Nat}) -> {List.length(&2, U32, P.RsPoly.add(C.Rs.gf8(), a, b)) == List.length(&2, U32, a) : Nat}:
  match a b:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{y, t}:
      Empty.absurd({List.length(&2, U32, P.RsPoly.add(C.Rs.gf8(), Nil{}, Con{y, t})) == List.length(&2, U32, Nil{}) : Nat}, rsp.succ_zero(List.length(&2, U32, t), Equal.sym(Nat, 0n, 1n+List.length(&2, U32, t), same)))
    case Con{x, s} Nil{}:
      Empty.absurd({List.length(&2, U32, P.RsPoly.add(C.Rs.gf8(), Con{x, s}, Nil{})) == List.length(&2, U32, Con{x, s}) : Nat}, rsp.succ_zero(List.length(&2, U32, s), same))
    case Con{x, +s} Con{y, +t}:
      %rsp.add_len(s, t, rsp.succ_inj(List.length(&2, U32, s), List.length(&2, U32, t), same)) : {1n+List.length(&2, U32, P.RsPoly.add(C.Rs.gf8(), s, t)) == 1n+_ : Nat}
      {==}

def rsp.stepl(+x: U32, reg: List<&2, U32>, h: {List.length(&2, U32, reg) == 4n : Nat}) -> {List.length(&2, U32, E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], reg, x)) == 4n : Nat}:
  match reg:
    case Nil{}:
      Empty.absurd({List.length(&2, U32, E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], Nil{}, x)) == 4n : Nat}, rsp.succ_zero(3n, Equal.sym(Nat, 0n, 4n, h)))
    case Con{p0, Nil{}}:
      Empty.absurd({List.length(&2, U32, E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], Con{p0, Nil{}}, x)) == 4n : Nat}, rsp.succ_zero(2n, Equal.sym(Nat, 0n, 3n, rsp.succ_inj(0n, 3n, h))))
    case Con{p0, Con{p1, Nil{}}}:
      Empty.absurd({List.length(&2, U32, E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], Con{p0, Con{p1, Nil{}}}, x)) == 4n : Nat}, rsp.succ_zero(1n, Equal.sym(Nat, 0n, 2n, rsp.succ_inj(0n, 2n, rsp.succ_inj(1n, 3n, h)))))
    case Con{p0, Con{p1, Con{p2, Nil{}}}}:
      Empty.absurd({List.length(&2, U32, E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], Con{p0, Con{p1, Con{p2, Nil{}}}}, x)) == 4n : Nat}, rsp.succ_zero(0n, Equal.sym(Nat, 0n, 1n, rsp.succ_inj(0n, 1n, rsp.succ_inj(1n, 2n, rsp.succ_inj(2n, 3n, h))))))
    case Con{p0, Con{p1, Con{p2, Con{p3, Nil{}}}}}:
      {==}
    case Con{p0, Con{p1, Con{p2, Con{p3, Con{p4, r}}}}}:
      Empty.absurd({List.length(&2, U32, E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], Con{p0, Con{p1, Con{p2, Con{p3, Con{p4, r}}}}}, x)) == 4n : Nat}, rsp.succ_zero(List.length(&2, U32, r), rsp.succ_inj(1n+List.length(&2, U32, r), 0n, rsp.succ_inj(2n+List.length(&2, U32, r), 1n, rsp.succ_inj(3n+List.length(&2, U32, r), 2n, rsp.succ_inj(4n+List.length(&2, U32, r), 3n, h))))))

def rsp.runlen(m: List<&2, U32>, +reg: List<&2, U32>, +h: {List.length(&2, U32, reg) == 4n : Nat}) -> {List.length(&2, U32, E.rs.enc.run(m, C.Rs.gf8(), [3, 1, 2, 3], reg)) == 4n : Nat}:
  match m:
    case Nil{}:
      h
    case Con{+x, t}:
      rsp.runlen(t, E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], reg, x), rsp.stepl(x, reg, h))

def rsp.cwlen8(+m: List<&2, U32>) -> {List.length(&2, U32, E.Rs.codeword(C.Rs.small8(), m)) == Nat.add(List.length(&2, U32, m), 4n) : Nat}:
  %rsp.par8(m) : {List.length(&2, U32, List.append(&2, U32, E.Rs.mask(C.Rs.small8(), m), _)) == Nat.add(List.length(&2, U32, m), 4n) : Nat}
