  %Equal.sym(Nat, List.length(&2, U32, E.rs.enc.run(m, C.Rs.gf8(), [3, 1, 2, 3], [0, 0, 0, 0])), 4n, rsp.runlen(m, [0, 0, 0, 0], {==})) : {Nat.add(List.length(&2, U32, m), _) == Nat.add(List.length(&2, U32, m), 4n) : Nat}
  {==}

def rsp.cweq8(+m1: List<&2, U32>, +m2: List<&2, U32>, +same: {List.length(&2, U32, m1) == List.length(&2, U32, m2) : Nat}) -> {List.length(&2, U32, E.Rs.codeword(C.Rs.small8(), m1)) == List.length(&2, U32, E.Rs.codeword(C.Rs.small8(), m2)) : Nat}:
