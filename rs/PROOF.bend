  %Equal.sym(Nat, List.length(&2, U32, D.Rs.inject(w, i, v)), List.length(&2, U32, w), rsp.inj_len(w, i, v)) : {D.rs.dec.msg(C.Rs.small4(), D.rs.cor.go(D.Rs.check(C.Rs.small4(), List.length(&2, U32, w), eras), D.Rs.opts(), C.Rs.small4(), E.Rs.mask(C.Rs.small4(), D.Rs.inject(w, i, M.Gfm.elt(C.Rs.gf4(), v))), eras)) == D.rs.dec.msg(C.Rs.small4(), D.rs.cor.go(D.Rs.check(C.Rs.small4(), _, eras), D.Rs.opts(), C.Rs.small4(), E.Rs.mask(C.Rs.small4(), D.Rs.inject(w, i, v)), eras)) : Result<&2, &2, E.RsError, List<&2, U32>>}
  %Equal.sym(List<&2, U32>, E.Rs.mask(C.Rs.small4(), D.Rs.inject(w, i, M.Gfm.elt(C.Rs.gf4(), v))), E.Rs.mask(C.Rs.small4(), D.Rs.inject(w, i, v)), rsp.inj_mask4(w, i, v)) : {D.rs.dec.msg(C.Rs.small4(), D.rs.cor.go(D.Rs.check(C.Rs.small4(), List.length(&2, U32, w), eras), D.Rs.opts(), C.Rs.small4(), _, eras)) == D.rs.dec.msg(C.Rs.small4(), D.rs.cor.go(D.Rs.check(C.Rs.small4(), List.length(&2, U32, w), eras), D.Rs.opts(), C.Rs.small4(), E.Rs.mask(C.Rs.small4(), D.Rs.inject(w, i, v)), eras)) : Result<&2, &2, E.RsError, List<&2, U32>>}
