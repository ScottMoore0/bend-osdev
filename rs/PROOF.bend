# Lengths

def rsp.ndisc(+n: Nat) -> Type:
  match n:
    case 0n:
      Empty
    case 1n+p:
      Unit

def rsp.succ_zero(-n: Nat, +e: {1n+n == 0n : Nat}) -> Empty:
  %e : rsp.ndisc(_)
  Unit{}

def rsp.pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

def rsp.succ_inj(-a: Nat, -b: Nat, e: {1n+a == 1n+b : Nat}) -> {a == b : Nat}:
  Equal.cong(Nat, Nat, n => rsp.pred(n), 1n+a, 1n+b, e)

