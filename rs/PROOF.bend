# Proofs. Three kinds:
#   * vectors and the small codes' laws are computations: a symbol is split
#     into its 32 bits, the low ones (the field's) tried one value at a
#     time and the others left unknown, since every function reads symbols
#     modulo 2^m (gen/proof.py writes these parts);
#   * Rs.small8's linearity is proved by induction: Horner's rule (the
#     syndromes) and the encoder's shift register are built from additions
#     and multiplications by constants, and (x + y) k = x k + y k for each
#     of those constants is tried on every pair of elements;
#   * Rs.small8's codewords then have zero syndromes because every message
#     is a sum of messages with one nonzero symbol, whose codewords are
#     computed; and a codeword decodes to its message because its
#     syndromes are zero (no corrections), by computation of the steps.
# No law of another package is needed: gf is used only through computing
# its public functions.
import Base
import ../gf/gfm.bend as M
import ../gf/LAWS_gfm.bend as GML
import ../gf/PROOF_gfm.bend as GMP
import ./poly.bend as P
import ./arith.bend as A
import ./code.bend as C
import ./encode.bend as E
import ./syndrome.bend as Sy
import ./bm.bend as Bm
import ./chien.bend as Ch
import ./rs.bend as D
import ./LAWS.bend as Laws
import ../u32/LAWS.bend as UL
import ../u32/PROOF.bend as UP

# Contradictions

def rsp.bdisc(+b: Bool) -> Type:
  match b:
    case True{}:
      Empty
    case False{}:
      Unit

def rsp.ft(+e: {False{} == True{} : Bool}) -> Empty:
  %e : rsp.bdisc(_)
  Unit{}

