  %Equal.sym(U32, M.Gfm.elt(C.Rs.gf8(), U32.xor(x, M.Gfm.elt(C.Rs.gf8(), y))), M.Gfm.elt(C.Rs.gf8(), U32.xor(x, y)), rsp.e2_8(x, y)) : {M.Gfm.elt(C.Rs.gf8(), U32.xor(x, y)) == _ : U32}
  {==}

# Syndromes: Horner's rule is linear

def rsp.synmask_one(w: List<&2, U32>, +k: U32, +acc: U32) -> {Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), k, acc) == Sy.rs.syn.one(w, C.Rs.gf8(), k, acc) : U32}:
  match w:
    case Nil{}:
      {==}
    case Con{+s, +t}:
      %Equal.sym(U32, M.Gfm.elt(C.Rs.gf8(), U32.xor(M.Gfm.mul(C.Rs.gf8(), acc, k), M.Gfm.elt(C.Rs.gf8(), s))), M.Gfm.elt(C.Rs.gf8(), U32.xor(M.Gfm.mul(C.Rs.gf8(), acc, k), s)), rsp.e2_8(M.Gfm.mul(C.Rs.gf8(), acc, k), s)) : {Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), t), C.Rs.gf8(), k, _) == Sy.rs.syn.one(t, C.Rs.gf8(), k, M.Gfm.add(C.Rs.gf8(), M.Gfm.mul(C.Rs.gf8(), acc, k), s)) : U32}
      rsp.synmask_one(t, k, M.Gfm.add(C.Rs.gf8(), M.Gfm.mul(C.Rs.gf8(), acc, k), s))

# Rs.small8's syndromes are Horner's rule at its roots 2, 4, 3 and 6 (the
# roots computed apart: the kernel computes closed terms quickly)
def rsp.syn_unf8(+x: List<&2, U32>) -> {Sy.rs.syn.all(C.Rs.roots(C.Rs.small8()), C.Rs.field(C.Rs.small8()), x) == Sy.Rs.syndromes(C.Rs.small8(), x) : List<&2, U32>}:
  {==}

def rsp.roots8() -> {[2, 4, 3, 6] == C.Rs.roots(C.Rs.small8()) : List<&2, U32>}:
  {==}

def rsp.field8() -> {C.Rs.gf8() == C.Rs.field(C.Rs.small8()) : M.GfmField}:
  {==}

def rsp.syn8(+x: List<&2, U32>) -> {Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), x) == Sy.Rs.syndromes(C.Rs.small8(), x) : List<&2, U32>}:
  %rsp.syn_unf8(x) : {Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), x) == _ : List<&2, U32>}
  %rsp.roots8() : {Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), x) == Sy.rs.syn.all(_, C.Rs.field(C.Rs.small8()), x) : List<&2, U32>}
  %rsp.field8() : {Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), x) == Sy.rs.syn.all([2, 4, 3, 6], _, x) : List<&2, U32>}
  {==}

def rsp.synmask(+w: List<&2, U32>) -> {Sy.Rs.syndromes(C.Rs.small8(), E.Rs.mask(C.Rs.small8(), w)) == Sy.Rs.syndromes(C.Rs.small8(), w) : List<&2, U32>}:
  %rsp.syn8(E.Rs.mask(C.Rs.small8(), w)) : {_ == Sy.Rs.syndromes(C.Rs.small8(), w) : List<&2, U32>}
  %rsp.syn8(w) : {Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), E.Rs.mask(C.Rs.small8(), w)) == _ : List<&2, U32>}
  %Equal.sym(U32, Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 2, 0), Sy.rs.syn.one(w, C.Rs.gf8(), 2, 0), rsp.synmask_one(w, 2, 0)) : {[_, Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 4, 0), Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 3, 0), Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 6, 0)] == Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), w) : List<&2, U32>}
  %Equal.sym(U32, Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 4, 0), Sy.rs.syn.one(w, C.Rs.gf8(), 4, 0), rsp.synmask_one(w, 4, 0)) : {[Sy.rs.syn.one(w, C.Rs.gf8(), 2, 0), _, Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 3, 0), Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 6, 0)] == Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), w) : List<&2, U32>}
  %Equal.sym(U32, Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 3, 0), Sy.rs.syn.one(w, C.Rs.gf8(), 3, 0), rsp.synmask_one(w, 3, 0)) : {[Sy.rs.syn.one(w, C.Rs.gf8(), 2, 0), Sy.rs.syn.one(w, C.Rs.gf8(), 4, 0), _, Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 6, 0)] == Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), w) : List<&2, U32>}
  %Equal.sym(U32, Sy.rs.syn.one(E.Rs.mask(C.Rs.small8(), w), C.Rs.gf8(), 6, 0), Sy.rs.syn.one(w, C.Rs.gf8(), 6, 0), rsp.synmask_one(w, 6, 0)) : {[Sy.rs.syn.one(w, C.Rs.gf8(), 2, 0), Sy.rs.syn.one(w, C.Rs.gf8(), 4, 0), Sy.rs.syn.one(w, C.Rs.gf8(), 3, 0), _] == Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), w) : List<&2, U32>}
  {==}

def Laws.small8_syndromes_linear(a, b, same):
  %rsp.syn8(P.RsPoly.add(C.Rs.gf8(), a, b)) : {_ == P.RsPoly.add(C.Rs.gf8(), Sy.Rs.syndromes(C.Rs.small8(), a), Sy.Rs.syndromes(C.Rs.small8(), b)) : List<&2, U32>}
  %rsp.syn8(a) : {Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), P.RsPoly.add(C.Rs.gf8(), a, b)) == P.RsPoly.add(C.Rs.gf8(), _, Sy.Rs.syndromes(C.Rs.small8(), b)) : List<&2, U32>}
  %rsp.syn8(b) : {Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), P.RsPoly.add(C.Rs.gf8(), a, b)) == P.RsPoly.add(C.Rs.gf8(), Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), a), _) : List<&2, U32>}
  %Equal.sym(U32, Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 2, 0), M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 2, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 2, 0)), rsp.hlin_2(a, b, 0, 0, same)) : {[_, Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 4, 0), Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 3, 0), Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 6, 0)] == P.RsPoly.add(C.Rs.gf8(), Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), a), Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), b)) : List<&2, U32>}
  %Equal.sym(U32, Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 4, 0), M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 4, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 4, 0)), rsp.hlin_4(a, b, 0, 0, same)) : {[M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 2, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 2, 0)), _, Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 3, 0), Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 6, 0)] == P.RsPoly.add(C.Rs.gf8(), Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), a), Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), b)) : List<&2, U32>}
  %Equal.sym(U32, Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 3, 0), M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 3, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 3, 0)), rsp.hlin_3(a, b, 0, 0, same)) : {[M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 2, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 2, 0)), M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 4, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 4, 0)), _, Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 6, 0)] == P.RsPoly.add(C.Rs.gf8(), Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), a), Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), b)) : List<&2, U32>}
  %Equal.sym(U32, Sy.rs.syn.one(P.RsPoly.add(C.Rs.gf8(), a, b), C.Rs.gf8(), 6, 0), M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 6, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 6, 0)), rsp.hlin_6(a, b, 0, 0, same)) : {[M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 2, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 2, 0)), M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 4, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 4, 0)), M.Gfm.add(C.Rs.gf8(), Sy.rs.syn.one(a, C.Rs.gf8(), 3, 0), Sy.rs.syn.one(b, C.Rs.gf8(), 3, 0)), _] == P.RsPoly.add(C.Rs.gf8(), Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), a), Sy.rs.syn.all([2, 4, 3, 6], C.Rs.gf8(), b)) : List<&2, U32>}
  {==}

# The encoder's shift register is linear

# the feedback of a sum is the sum of the feedbacks, times g
def rsp.dfb_3(+m1: U32, +m2: U32, +p0: U32, +q0: U32) -> {M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, m2), M.Gfm.add(C.Rs.gf8(), p0, q0)), 3) == M.Gfm.add(C.Rs.gf8(), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, p0), 3), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m2, q0), 3)) : U32}:
  %Equal.sym(U32, M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, m2), M.Gfm.add(C.Rs.gf8(), p0, q0)), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, p0), M.Gfm.add(C.Rs.gf8(), m2, q0)), rsp.add8_sh(m1, m2, p0, q0)) : {M.Gfm.mul(C.Rs.gf8(), _, 3) == M.Gfm.add(C.Rs.gf8(), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, p0), 3), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m2, q0), 3)) : U32}
  rsp.dist8_3(M.Gfm.add(C.Rs.gf8(), m1, p0), M.Gfm.add(C.Rs.gf8(), m2, q0))

def rsp.dfb_1(+m1: U32, +m2: U32, +p0: U32, +q0: U32) -> {M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, m2), M.Gfm.add(C.Rs.gf8(), p0, q0)), 1) == M.Gfm.add(C.Rs.gf8(), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, p0), 1), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m2, q0), 1)) : U32}:
  %Equal.sym(U32, M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, m2), M.Gfm.add(C.Rs.gf8(), p0, q0)), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, p0), M.Gfm.add(C.Rs.gf8(), m2, q0)), rsp.add8_sh(m1, m2, p0, q0)) : {M.Gfm.mul(C.Rs.gf8(), _, 1) == M.Gfm.add(C.Rs.gf8(), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, p0), 1), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m2, q0), 1)) : U32}
  rsp.dist8_1(M.Gfm.add(C.Rs.gf8(), m1, p0), M.Gfm.add(C.Rs.gf8(), m2, q0))

def rsp.dfb_2(+m1: U32, +m2: U32, +p0: U32, +q0: U32) -> {M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, m2), M.Gfm.add(C.Rs.gf8(), p0, q0)), 2) == M.Gfm.add(C.Rs.gf8(), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, p0), 2), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m2, q0), 2)) : U32}:
  %Equal.sym(U32, M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, m2), M.Gfm.add(C.Rs.gf8(), p0, q0)), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, p0), M.Gfm.add(C.Rs.gf8(), m2, q0)), rsp.add8_sh(m1, m2, p0, q0)) : {M.Gfm.mul(C.Rs.gf8(), _, 2) == M.Gfm.add(C.Rs.gf8(), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m1, p0), 2), M.Gfm.mul(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), m2, q0), 2)) : U32}
  rsp.dist8_2(M.Gfm.add(C.Rs.gf8(), m1, p0), M.Gfm.add(C.Rs.gf8(), m2, q0))

def rsp.steplin(+p0: U32, +p1: U32, +p2: U32, +p3: U32, +q0: U32, +q1: U32, +q2: U32, +q3: U32, +m1: U32, +m2: U32) -> {E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], P.RsPoly.add(C.Rs.gf8(), [p0, p1, p2, p3], [q0, q1, q2, q3]), M.Gfm.add(C.Rs.gf8(), m1, m2)) == P.RsPoly.add(C.Rs.gf8(), E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], [p0, p1, p2, p3], m1), E.rs.enc.step(C.Rs.gf8(), [3, 1, 2, 3], [q0, q1, q2, q3], m2)) : List<&2, U32>}:
