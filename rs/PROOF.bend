def Laws.small8_codeword_syndromes(m, short):
  match m:
    case Nil{}:
      rsp.sz0()
    case Con{x, Nil{}}:
      rsp.basis_a(x)
    case Con{x, Con{y, Nil{}}}:
      rsp.sz2(x, y)
    case Con{x, Con{y, Con{z, Nil{}}}}:
      rsp.sz3(x, y, z)
    case Con{x, Con{y, Con{z, Con{w, r}}}}:
      Empty.absurd({Sy.Rs.syndromes(C.Rs.small8(), E.Rs.codeword(C.Rs.small8(), Con{x, Con{y, Con{z, Con{w, r}}}})) == [0, 0, 0, 0] : List<&2, U32>}, rsp.ft(short))

