def rsp.subn8(n: Nat, short: {Nat.is_le(n, 3n) == True{} : Bool}, some: {Nat.is_lt(0n, n) == True{} : Bool}) -> {Nat.sub(Nat.add(n, 4n), U32.to_nat(C.Rs.nroots(C.Rs.small8()))) == n : Nat}:
  match n:
    case 0n:
      Empty.absurd({Nat.sub(Nat.add(0n, 4n), U32.to_nat(C.Rs.nroots(C.Rs.small8()))) == 0n : Nat}, rsp.ft(some))
    case 1n:
      rsp.subn8_1()
    case 2n:
      rsp.subn8_2()
    case 3n:
      rsp.subn8_3()
    case 4n+k:
      Empty.absurd({Nat.sub(Nat.add(4n+k, 4n), U32.to_nat(C.Rs.nroots(C.Rs.small8()))) == 4n+k : Nat}, rsp.ft(short))

