def rsp.msplit3(+x: U32, +y: U32, +z: U32) -> {E.Rs.mask(C.Rs.small8(), [x, y, z]) == E.Rs.mask(C.Rs.small8(), P.RsPoly.add(C.Rs.gf8(), P.RsPoly.add(C.Rs.gf8(), [x, 0, 0], [0, y, 0]), [0, 0, z])) : List<&2, U32>}:
