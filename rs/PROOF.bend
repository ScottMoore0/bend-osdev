def rsp.chk8(n: Nat, short: {Nat.is_le(n, 3n) == True{} : Bool}, some: {Nat.is_lt(0n, n) == True{} : Bool}) -> {D.Rs.check(C.Rs.small8(), Nat.add(n, 4n), Nil{}) == None{} : Maybe<&2, E.RsError>}:
  match n:
    case 0n:
      Empty.absurd({D.Rs.check(C.Rs.small8(), Nat.add(0n, 4n), Nil{}) == None{} : Maybe<&2, E.RsError>}, rsp.ft(some))
    case 1n:
      rsp.chk8_1()
    case 2n:
      rsp.chk8_2()
    case 3n:
      rsp.chk8_3()
    case 4n+k:
      Empty.absurd({D.Rs.check(C.Rs.small8(), Nat.add(4n+k, 4n), Nil{}) == None{} : Maybe<&2, E.RsError>}, rsp.ft(short))

