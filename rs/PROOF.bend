# GF(8): small facts about elements

def rsp.bx_zero(+a: Bool) -> {Bool.xor(a, False{}) == a : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def rsp.wx_zero(n: Nat, a: Word(n)) -> {Word.xor(n, a, Word.zero(n)) == a : Word(n)}:
  match n:
    case 0n:
      match a:
        case WNil{}:
          {==}
    case 1n+p:
      match a:
        case WCon{+ah, +at}:
          %rsp.bx_zero(ah) : {WCon{Bool.xor(ah, False{}), Word.xor(p, at, Word.zero(p))} == WCon{_, at} : Word(1n+p)}
          %rsp.wx_zero(p, at) : {WCon{Bool.xor(ah, False{}), Word.xor(p, at, Word.zero(p))} == WCon{Bool.xor(ah, False{}), _} : Word(1n+p)}
          {==}

def rsp.ux_zero(a: U32) -> {U32.xor(a, 0) == a : U32}:
  match a:
    case U32{+x}:
      %rsp.wx_zero(32n, x) : {U32{Word.xor(32n, x, Word.zero(32n))} == U32{_} : U32}
      {==}

# x + 0 = elt x
def rsp.a80(+x: U32) -> {M.Gfm.add(C.Rs.gf8(), x, 0) == M.Gfm.elt(C.Rs.gf8(), x) : U32}:
  %rsp.ux_zero(x) : {M.Gfm.add(C.Rs.gf8(), x, 0) == M.Gfm.elt(C.Rs.gf8(), _) : U32}
  {==}

# elt (x + y) = elt x + elt y
