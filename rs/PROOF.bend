# the encoder reads each symbol modulo 2^m
def rsp.runmask(m: List<&2, U32>, +gd: List<&2, U32>, +reg: List<&2, U32>) -> {E.rs.enc.run(E.Rs.mask(C.Rs.small8(), m), C.Rs.gf8(), gd, reg) == E.rs.enc.run(m, C.Rs.gf8(), gd, reg) : List<&2, U32>}:
  match m:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      %Equal.sym(U32, M.Gfm.elt(C.Rs.gf8(), U32.xor(M.Gfm.elt(C.Rs.gf8(), x), E.rs.enc.top(reg))), M.Gfm.elt(C.Rs.gf8(), U32.xor(x, E.rs.enc.top(reg))), rsp.e1_8(x, E.rs.enc.top(reg))) : {E.rs.enc.run(E.Rs.mask(C.Rs.small8(), t), C.Rs.gf8(), gd, P.RsPoly.add(C.Rs.gf8(), E.rs.enc.up(reg), P.RsPoly.scale(C.Rs.gf8(), _, gd))) == E.rs.enc.run(Con{x, t}, C.Rs.gf8(), gd, reg) : List<&2, U32>}
      rsp.runmask(t, gd, E.rs.enc.step(C.Rs.gf8(), gd, reg, x))

def rsp.cwmask(+m: List<&2, U32>) -> {E.Rs.codeword(C.Rs.small8(), E.Rs.mask(C.Rs.small8(), m)) == E.Rs.codeword(C.Rs.small8(), m) : List<&2, U32>}:
  %Equal.sym(List<&2, U32>, E.Rs.mask(C.Rs.small8(), E.Rs.mask(C.Rs.small8(), m)), E.Rs.mask(C.Rs.small8(), m), rsp.maskmask(m)) : {List.append(&2, U32, _, E.Rs.parity(C.Rs.small8(), E.Rs.mask(C.Rs.small8(), m))) == E.Rs.codeword(C.Rs.small8(), m) : List<&2, U32>}
  %Equal.sym(List<&2, U32>, E.rs.enc.run(E.Rs.mask(C.Rs.small8(), m), C.Rs.gf8(), E.Rs.gen_desc(C.Rs.small8()), E.rs.zeros(U32.to_nat(C.Rs.nroots(C.Rs.small8())))), E.rs.enc.run(m, C.Rs.gf8(), E.Rs.gen_desc(C.Rs.small8()), E.rs.zeros(U32.to_nat(C.Rs.nroots(C.Rs.small8())))), rsp.runmask(m, E.Rs.gen_desc(C.Rs.small8()), E.rs.zeros(U32.to_nat(C.Rs.nroots(C.Rs.small8()))))) : {List.append(&2, U32, E.Rs.mask(C.Rs.small8(), m), _) == E.Rs.codeword(C.Rs.small8(), m) : List<&2, U32>}
  {==}

# Splitting a message into messages of one symbol each

def rsp.en_x0(+x: U32) -> {M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), x, 0)) == M.Gfm.elt(C.Rs.gf8(), x) : U32}:
  %Equal.sym(U32, M.Gfm.add(C.Rs.gf8(), x, 0), M.Gfm.elt(C.Rs.gf8(), x), rsp.a80(x)) : {M.Gfm.elt(C.Rs.gf8(), _) == M.Gfm.elt(C.Rs.gf8(), x) : U32}
  rsp.eid_8(x)

def rsp.en_0y(+y: U32) -> {M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, y)) == M.Gfm.elt(C.Rs.gf8(), y) : U32}:
  %Equal.sym(U32, M.Gfm.add(C.Rs.gf8(), 0, y), M.Gfm.elt(C.Rs.gf8(), y), rsp.a0_8(y)) : {M.Gfm.elt(C.Rs.gf8(), _) == M.Gfm.elt(C.Rs.gf8(), y) : U32}
  rsp.eid_8(y)

def rsp.en_x00(+x: U32) -> {M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), x, 0), 0)) == M.Gfm.elt(C.Rs.gf8(), x) : U32}:
  %Equal.sym(U32, M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), x, 0), 0), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), x, 0)), rsp.a80(M.Gfm.add(C.Rs.gf8(), x, 0))) : {M.Gfm.elt(C.Rs.gf8(), _) == M.Gfm.elt(C.Rs.gf8(), x) : U32}
  %Equal.sym(U32, M.Gfm.elt(C.Rs.gf8(), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), x, 0))), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), x, 0)), rsp.eid_8(M.Gfm.add(C.Rs.gf8(), x, 0))) : {_ == M.Gfm.elt(C.Rs.gf8(), x) : U32}
  rsp.en_x0(x)

def rsp.en_0y0(+y: U32) -> {M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, y), 0)) == M.Gfm.elt(C.Rs.gf8(), y) : U32}:
  %Equal.sym(U32, M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, y), 0), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, y)), rsp.a80(M.Gfm.add(C.Rs.gf8(), 0, y))) : {M.Gfm.elt(C.Rs.gf8(), _) == M.Gfm.elt(C.Rs.gf8(), y) : U32}
  %Equal.sym(U32, M.Gfm.elt(C.Rs.gf8(), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, y))), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, y)), rsp.eid_8(M.Gfm.add(C.Rs.gf8(), 0, y))) : {_ == M.Gfm.elt(C.Rs.gf8(), y) : U32}
  rsp.en_0y(y)

def rsp.msplit2(+x: U32, +y: U32) -> {E.Rs.mask(C.Rs.small8(), [x, y]) == E.Rs.mask(C.Rs.small8(), P.RsPoly.add(C.Rs.gf8(), [x, 0], [0, y])) : List<&2, U32>}:
  %rsp.en_x0(x) : {[_, M.Gfm.elt(C.Rs.gf8(), y)] == [M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), x, 0)), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, y))] : List<&2, U32>}
