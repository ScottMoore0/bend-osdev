  %rsp.en_0y(z) : {[M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), x, 0), 0)), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, y), 0)), _] == [M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), x, 0), 0)), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, y), 0)), M.Gfm.elt(C.Rs.gf8(), M.Gfm.add(C.Rs.gf8(), 0, z))] : List<&2, U32>}
