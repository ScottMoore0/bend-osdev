def Laws.small8_roundtrip(m, short, some):
  rsp.rtn(m, short, some)

# Rs.small4: the encoder and decoder read symbols modulo 2^2, so each law
# is reduced to the four messages, three positions and four changes, which
# are computed (one decode per def)

def rsp.maskmask4(m: List<&2, U32>) -> {E.Rs.mask(C.Rs.small4(), E.Rs.mask(C.Rs.small4(), m)) == E.Rs.mask(C.Rs.small4(), m) : List<&2, U32>}:
  match m:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      %rsp.eid_4(x) : {Con{M.Gfm.elt(C.Rs.gf4(), M.Gfm.elt(C.Rs.gf4(), x)), E.Rs.mask(C.Rs.small4(), E.Rs.mask(C.Rs.small4(), t))} == Con{_, E.Rs.mask(C.Rs.small4(), t)} : List<&2, U32>}
      %rsp.maskmask4(t) : {Con{M.Gfm.elt(C.Rs.gf4(), M.Gfm.elt(C.Rs.gf4(), x)), E.Rs.mask(C.Rs.small4(), E.Rs.mask(C.Rs.small4(), t))} == Con{M.Gfm.elt(C.Rs.gf4(), M.Gfm.elt(C.Rs.gf4(), x)), _} : List<&2, U32>}
      {==}

def rsp.runmask4(m: List<&2, U32>, +gd: List<&2, U32>, +reg: List<&2, U32>) -> {E.rs.enc.run(E.Rs.mask(C.Rs.small4(), m), C.Rs.gf4(), gd, reg) == E.rs.enc.run(m, C.Rs.gf4(), gd, reg) : List<&2, U32>}:
  match m:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      %Equal.sym(U32, M.Gfm.elt(C.Rs.gf4(), U32.xor(M.Gfm.elt(C.Rs.gf4(), x), E.rs.enc.top(reg))), M.Gfm.elt(C.Rs.gf4(), U32.xor(x, E.rs.enc.top(reg))), rsp.e1_4(x, E.rs.enc.top(reg))) : {E.rs.enc.run(E.Rs.mask(C.Rs.small4(), t), C.Rs.gf4(), gd, P.RsPoly.add(C.Rs.gf4(), E.rs.enc.up(reg), P.RsPoly.scale(C.Rs.gf4(), _, gd))) == E.rs.enc.run(Con{x, t}, C.Rs.gf4(), gd, reg) : List<&2, U32>}
      rsp.runmask4(t, gd, E.rs.enc.step(C.Rs.gf4(), gd, reg, x))

def rsp.cwmask4(+m: List<&2, U32>) -> {E.Rs.codeword(C.Rs.small4(), E.Rs.mask(C.Rs.small4(), m)) == E.Rs.codeword(C.Rs.small4(), m) : List<&2, U32>}:
  %Equal.sym(List<&2, U32>, E.Rs.mask(C.Rs.small4(), E.Rs.mask(C.Rs.small4(), m)), E.Rs.mask(C.Rs.small4(), m), rsp.maskmask4(m)) : {List.append(&2, U32, _, E.Rs.parity(C.Rs.small4(), E.Rs.mask(C.Rs.small4(), m))) == E.Rs.codeword(C.Rs.small4(), m) : List<&2, U32>}
  %Equal.sym(List<&2, U32>, E.rs.enc.run(E.Rs.mask(C.Rs.small4(), m), C.Rs.gf4(), E.Rs.gen_desc(C.Rs.small4()), E.rs.zeros(U32.to_nat(C.Rs.nroots(C.Rs.small4())))), E.rs.enc.run(m, C.Rs.gf4(), E.Rs.gen_desc(C.Rs.small4()), E.rs.zeros(U32.to_nat(C.Rs.nroots(C.Rs.small4())))), rsp.runmask4(m, E.Rs.gen_desc(C.Rs.small4()), E.rs.zeros(U32.to_nat(C.Rs.nroots(C.Rs.small4()))))) : {List.append(&2, U32, E.Rs.mask(C.Rs.small4(), m), _) == E.Rs.codeword(C.Rs.small4(), m) : List<&2, U32>}
  {==}

# a changed symbol leaves the word's length
def rsp.inj_len(w: List<&2, U32>, i: Nat, +v: U32) -> {List.length(&2, U32, D.Rs.inject(w, i, v)) == List.length(&2, U32, w) : Nat}:
  match w:
    case Nil{}:
      {==}
    case Con{s, +t}:
      match i:
        case 0n:
          {==}
        case 1n+k:
          %rsp.inj_len(t, k, v) : {1n+List.length(&2, U32, D.Rs.inject(t, k, v)) == 1n+_ : Nat}
          {==}

# in GF(4), a change is read modulo 2^2
def rsp.inj_mask4(w: List<&2, U32>, i: Nat, +v: U32) -> {E.Rs.mask(C.Rs.small4(), D.Rs.inject(w, i, M.Gfm.elt(C.Rs.gf4(), v))) == E.Rs.mask(C.Rs.small4(), D.Rs.inject(w, i, v)) : List<&2, U32>}:
  match w:
    case Nil{}:
      {==}
    case Con{+s, +t}:
      match i:
        case 0n:
          %rsp.e2_4(s, v) : {Con{M.Gfm.elt(C.Rs.gf4(), U32.xor(s, M.Gfm.elt(C.Rs.gf4(), v))), E.Rs.mask(C.Rs.small4(), t)} == Con{_, E.Rs.mask(C.Rs.small4(), t)} : List<&2, U32>}
          {==}
        case 1n+k:
          %rsp.inj_mask4(t, k, v) : {Con{M.Gfm.elt(C.Rs.gf4(), s), E.Rs.mask(C.Rs.small4(), D.Rs.inject(t, k, M.Gfm.elt(C.Rs.gf4(), v)))} == Con{M.Gfm.elt(C.Rs.gf4(), s), _} : List<&2, U32>}
          {==}

# so Rs.small4's decoder reads only the change modulo 2^2
def rsp.decv4(+w: List<&2, U32>, +i: Nat, +v: U32, +eras: List<&2, Nat>) -> {D.Rs.decode(C.Rs.small4(), D.Rs.inject(w, i, M.Gfm.elt(C.Rs.gf4(), v)), eras) == D.Rs.decode(C.Rs.small4(), D.Rs.inject(w, i, v), eras) : Result<&2, &2, E.RsError, List<&2, U32>>}:
