    case True{}:
      Equal.cong(Nat, Maybe<&2, Nat>, zz => Some{zz}, 0n, W.W64.to_nat(a), Equal.sym(Nat, W.W64.to_nat(a), 0n, wsh.zv(a, ez)))
    case False{}:
      wsh.go(20n, a, "", wsh.f20(a))

def Laws.show_reads(a):
