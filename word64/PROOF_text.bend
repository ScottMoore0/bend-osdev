def wsh.pick(z: Bool, +a: W.W64, ez: {W.W64.is_zero(a) == z : Bool}) -> {Nat.read.go(W.W64.show.pick(z, a), 0n) == Some{W.W64.to_nat(a)} : Maybe<&2, Nat>}:
