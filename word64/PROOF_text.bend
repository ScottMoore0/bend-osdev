def wsd.fst(-x: Nat, -y: Nat, -c: Nat, -d: Nat, pr: {x == y : Nat} & {Nat.is_lt(c, d) == True{} : Bool}) -> {x == y : Nat}:
  (+u, +v) = pr
  u

def wsd.snd(-x: Nat, -y: Nat, -c: Nat, -d: Nat, pr: {x == y : Nat} & {Nat.is_lt(c, d) == True{} : Bool}) -> {Nat.is_lt(c, d) == True{} : Bool}:
  (+u, +v) = pr
  v

def wsh.q(+a: W.W64) -> W.W64:
  W.W64.small.q(W.W64.small.divmod(a, 10))

def wsh.r(+a: W.W64) -> U32:
  W.W64.small.r(W.W64.small.divmod(a, 10))

def wsd.v(+rp: U32, +c: U32) -> U32:
  U32.add(U32.mul(rp, 65536), c)

def wsd.d(+rp: U32, +c: U32) -> U32:
  U32.div(wsd.v(rp, c), 10)

def wsd.m(+rp: U32, +c: U32) -> U32:
  U32.mod(wsd.v(rp, c), 10)

def wsd.q(+qp: U32, +rp: U32, +c: U32) -> U32:
  U32.or(U32.shln(qp, 16n), wsd.d(rp, c))

