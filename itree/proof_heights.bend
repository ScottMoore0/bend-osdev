# insertion on the left: the subtrees differ by at most two
def il_nr2(a: Nat, ap: Nat, b: Nat, e1: {nr(a, b) == True{} : Bool}, e2: {grow(a, ap) == True{} : Bool}) -> {nr2(ap, b) == True{} : Bool}:
