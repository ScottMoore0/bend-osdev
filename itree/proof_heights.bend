def mg_h.z4(bq: Nat, aq: Nat, hq: Nat, y: Nat, e1: {Nat.is_eq(1n+hq, 1n+Nat.max(1n+aq, 1n+bq)) == True{} : Bool}, e2: {nr(1n+aq, 1n+bq) == True{} : Bool}, e3: {shrink(1n+bq, 0n) == True{} : Bool}, e4: {balh(1n+aq, 0n, y) == True{} : Bool}) -> {shrink(1n+hq, y) == True{} : Bool}:
  match bq:
    case 0n:
      match aq:
        case 0n:
          match hq:
            case 0n:
              Empty.absurd({shrink(1n, y) == True{} : Bool}, ab.ft(e1))
            case 1n+n3:
              match n3:
                case 0n:
                  match y:
                    case 0n:
                      Empty.absurd({shrink(2n, 0n) == True{} : Bool}, ab.ft(e4))
                    case 1n+n5:
                      match n5:
                        case 0n:
                          Empty.absurd({shrink(2n, 1n) == True{} : Bool}, ab.ft(e4))
                        case 1n+n6:
                          match n6:
                            case 0n:
                              {==}
                            case 1n+n7:
                              Empty.absurd({shrink(2n, 3n+n7) == True{} : Bool}, ab.ft(e4))
                case 1n+n4:
                  Empty.absurd({shrink(3n+n4, y) == True{} : Bool}, ab.ft(e1))
        case 1n+n2:
          match n2:
            case 0n:
              match hq:
                case 0n:
                  Empty.absurd({shrink(1n, y) == True{} : Bool}, ab.ft(e1))
                case 1n+n9:
                  match n9:
                    case 0n:
                      Empty.absurd({shrink(2n, y) == True{} : Bool}, ab.ft(e1))
                    case 1n+n10:
                      match n10:
                        case 0n:
                          match y:
                            case 0n:
                              Empty.absurd({shrink(3n, 0n) == True{} : Bool}, ab.ft(e4))
                            case 1n+n12:
                              match n12:
                                case 0n:
                                  Empty.absurd({shrink(3n, 1n) == True{} : Bool}, ab.ft(e4))
                                case 1n+n13:
                                  match n13:
                                    case 0n:
                                      {==}
                                    case 1n+n14:
                                      match n14:
                                        case 0n:
                                          {==}
                                        case 1n+n15:
                                          Empty.absurd({shrink(3n, 4n+n15) == True{} : Bool}, ab.ft(e4))
                        case 1n+n11:
                          Empty.absurd({shrink(4n+n11, y) == True{} : Bool}, ab.ft(e1))
            case 1n+n8:
              Empty.absurd({shrink(1n+hq, y) == True{} : Bool}, ab.ft(e2))
    case 1n+n1:
      Empty.absurd({shrink(1n+hq, y) == True{} : Bool}, ab.ft(e3))

def mg_h.z5(aq: Nat, bq: Nat, hq: Nat, xq: Nat, e1: {Nat.is_eq(1n+hq, 1n+Nat.max(1n+aq, 1n+bq)) == True{} : Bool}, e2: {nr(1n+aq, 1n+bq) == True{} : Bool}, e3: {shrink(1n+bq, 1n+xq) == True{} : Bool}, e4: {balh(1n+aq, 1n+xq, 0n) == True{} : Bool}) -> {shrink(1n+hq, 0n) == True{} : Bool}:
  Empty.absurd({shrink(1n+hq, 0n) == True{} : Bool}, ab.ft(e4))

# merge: the node shrinks by at most one
def mg_h(a: Nat, b: Nat, h: Nat, x: Nat, y: Nat, e1: {Nat.is_eq(h, 1n+Nat.max(a, b)) == True{} : Bool}, e2: {nr(a, b) == True{} : Bool}, e3: {shrink(b, x) == True{} : Bool}, e4: {balh(a, x, y) == True{} : Bool}) -> {shrink(h, y) == True{} : Bool}:
  match a:
    case 0n:
      mg_h.z1(b, h, x, y, e1, e2, e3, e4)
    case 1n+aq:
      match b:
        case 0n:
          mg_h.z2(aq, h, x, y, e1, e2, e3, e4)
        case 1n+bq:
          match h:
            case 0n:
              mg_h.z3(aq, bq, x, y, e1, e2, e3, e4)
            case 1n+hq:
              match x:
                case 0n:
                  mg_h.z4(bq, aq, hq, y, e1, e2, e3, e4)
                case 1n+xq:
                  match y:
                    case 0n:
                      mg_h.z5(aq, bq, hq, xq, e1, e2, e3, e4)
                    case 1n+yq:
                      mg_h(aq, bq, hq, xq, yq, e1, e2, e3, e4)

def sz_l.z1(b: Nat, h: Nat, x: Nat, e1: {Nat.is_le(2n+x, h) == True{} : Bool}, e2: {Nat.is_eq(h, 1n+Nat.max(0n, b)) == True{} : Bool}, e3: {nr(0n, b) == True{} : Bool}) -> {Nat.is_le(x, 0n) == True{} : Bool}:
  match b:
    case 0n:
      match h:
        case 0n:
          Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e1))
        case 1n+n2:
          match n2:
            case 0n:
              Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e1))
            case 1n+n3:
              Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e2))
    case 1n+n1:
      match n1:
        case 0n:
          match h:
            case 0n:
              Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e1))
            case 1n+n5:
              match n5:
                case 0n:
                  Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e1))
                case 1n+n6:
                  match n6:
                    case 0n:
                      match x:
                        case 0n:
                          {==}
                        case 1n+n8:
                          Empty.absurd({Nat.is_le(1n+n8, 0n) == True{} : Bool}, ab.ft(e1))
                    case 1n+n7:
                      Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e2))
        case 1n+n4:
          Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e3))

def sz_l.z2(aq: Nat, h: Nat, x: Nat, e1: {Nat.is_le(2n+x, h) == True{} : Bool}, e2: {Nat.is_eq(h, 1n+Nat.max(1n+aq, 0n)) == True{} : Bool}, e3: {nr(1n+aq, 0n) == True{} : Bool}) -> {Nat.is_le(x, 1n+aq) == True{} : Bool}:
  match aq:
    case 0n:
      match h:
        case 0n:
          Empty.absurd({Nat.is_le(x, 1n) == True{} : Bool}, ab.ft(e1))
        case 1n+n2:
          match n2:
            case 0n:
              Empty.absurd({Nat.is_le(x, 1n) == True{} : Bool}, ab.ft(e1))
            case 1n+n3:
              match n3:
                case 0n:
                  match x:
                    case 0n:
                      {==}
                    case 1n+n5:
                      Empty.absurd({Nat.is_le(1n+n5, 1n) == True{} : Bool}, ab.ft(e1))
                case 1n+n4:
                  Empty.absurd({Nat.is_le(x, 1n) == True{} : Bool}, ab.ft(e2))
    case 1n+n1:
      Empty.absurd({Nat.is_le(x, 2n+n1) == True{} : Bool}, ab.ft(e3))

def sz_l.z3(aq: Nat, bq: Nat, x: Nat, e1: {Nat.is_le(2n+x, 0n) == True{} : Bool}, e2: {Nat.is_eq(0n, 1n+Nat.max(1n+aq, 1n+bq)) == True{} : Bool}, e3: {nr(1n+aq, 1n+bq) == True{} : Bool}) -> {Nat.is_le(x, 1n+aq) == True{} : Bool}:
  Empty.absurd({Nat.is_le(x, 1n+aq) == True{} : Bool}, ab.ft(e1))

def sz_l.z4(aq: Nat, bq: Nat, hq: Nat, e1: {Nat.is_le(2n, 1n+hq) == True{} : Bool}, e2: {Nat.is_eq(1n+hq, 1n+Nat.max(1n+aq, 1n+bq)) == True{} : Bool}, e3: {nr(1n+aq, 1n+bq) == True{} : Bool}) -> {Nat.is_le(0n, 1n+aq) == True{} : Bool}:
  {==}

# a node of height at least x + 2: its left subtree has height at least x
def sz_l(a: Nat, b: Nat, h: Nat, x: Nat, e1: {Nat.is_le(2n+x, h) == True{} : Bool}, e2: {Nat.is_eq(h, 1n+Nat.max(a, b)) == True{} : Bool}, e3: {nr(a, b) == True{} : Bool}) -> {Nat.is_le(x, a) == True{} : Bool}:
  match a:
    case 0n:
      sz_l.z1(b, h, x, e1, e2, e3)
    case 1n+aq:
      match b:
        case 0n:
          sz_l.z2(aq, h, x, e1, e2, e3)
        case 1n+bq:
          match h:
            case 0n:
              sz_l.z3(aq, bq, x, e1, e2, e3)
            case 1n+hq:
              match x:
                case 0n:
                  sz_l.z4(aq, bq, hq, e1, e2, e3)
                case 1n+xq:
                  sz_l(aq, bq, hq, xq, e1, e2, e3)

def sz_r.z1(b: Nat, h: Nat, x: Nat, e1: {Nat.is_le(2n+x, h) == True{} : Bool}, e2: {Nat.is_eq(h, 1n+Nat.max(0n, b)) == True{} : Bool}, e3: {nr(0n, b) == True{} : Bool}) -> {Nat.is_le(x, b) == True{} : Bool}:
  match b:
    case 0n:
      match h:
        case 0n:
          Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e1))
        case 1n+n2:
          match n2:
            case 0n:
              Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e1))
            case 1n+n3:
              Empty.absurd({Nat.is_le(x, 0n) == True{} : Bool}, ab.ft(e2))
    case 1n+n1:
      match n1:
        case 0n:
          match h:
            case 0n:
              Empty.absurd({Nat.is_le(x, 1n) == True{} : Bool}, ab.ft(e1))
            case 1n+n5:
              match n5:
                case 0n:
                  Empty.absurd({Nat.is_le(x, 1n) == True{} : Bool}, ab.ft(e1))
                case 1n+n6:
                  match n6:
                    case 0n:
                      match x:
                        case 0n:
                          {==}
                        case 1n+n8:
                          Empty.absurd({Nat.is_le(1n+n8, 1n) == True{} : Bool}, ab.ft(e1))
                    case 1n+n7:
                      Empty.absurd({Nat.is_le(x, 1n) == True{} : Bool}, ab.ft(e2))
        case 1n+n4:
          Empty.absurd({Nat.is_le(x, 2n+n4) == True{} : Bool}, ab.ft(e3))

def sz_r.z2(aq: Nat, h: Nat, x: Nat, e1: {Nat.is_le(2n+x, h) == True{} : Bool}, e2: {Nat.is_eq(h, 1n+Nat.max(1n+aq, 0n)) == True{} : Bool}, e3: {nr(1n+aq, 0n) == True{} : Bool}) -> {Nat.is_le(x, 0n) == True{} : Bool}:
