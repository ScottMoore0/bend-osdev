def sz_r.z3(aq: Nat, bq: Nat, x: Nat, e1: {Nat.is_le(2n+x, 0n) == True{} : Bool}, e2: {Nat.is_eq(0n, 1n+Nat.max(1n+aq, 1n+bq)) == True{} : Bool}, e3: {nr(1n+aq, 1n+bq) == True{} : Bool}) -> {Nat.is_le(x, 1n+bq) == True{} : Bool}:
