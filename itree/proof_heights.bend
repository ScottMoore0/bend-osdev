def mg_h.z3(aq: Nat, bq: Nat, x: Nat, y: Nat, e1: {Nat.is_eq(0n, 1n+Nat.max(1n+aq, 1n+bq)) == True{} : Bool}, e2: {nr(1n+aq, 1n+bq) == True{} : Bool}, e3: {shrink(1n+bq, x) == True{} : Bool}, e4: {balh(1n+aq, x, y) == True{} : Bool}) -> {shrink(0n, y) == True{} : Bool}:
