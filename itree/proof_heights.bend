            case 1n+n3:
              match n3:
                case 0n:
                  match x:
                    case 0n:
                      {==}
                    case 1n+n5:
                      Empty.absurd({Nat.is_le(1n+n5, 0n) == True{} : Bool}, ab.ft(e1))
                case 1n+n4:
