def sz_r.z4(aq: Nat, bq: Nat, hq: Nat, e1: {Nat.is_le(2n, 1n+hq) == True{} : Bool}, e2: {Nat.is_eq(1n+hq, 1n+Nat.max(1n+aq, 1n+bq)) == True{} : Bool}, e3: {nr(1n+aq, 1n+bq) == True{} : Bool}) -> {Nat.is_le(0n, 1n+bq) == True{} : Bool}:
  {==}

# a node of height at least x + 2: its right subtree has height at least x
def sz_r(a: Nat, b: Nat, h: Nat, x: Nat, e1: {Nat.is_le(2n+x, h) == True{} : Bool}, e2: {Nat.is_eq(h, 1n+Nat.max(a, b)) == True{} : Bool}, e3: {nr(a, b) == True{} : Bool}) -> {Nat.is_le(x, b) == True{} : Bool}:
  match a:
    case 0n:
      sz_r.z1(b, h, x, e1, e2, e3)
    case 1n+aq:
      match b:
        case 0n:
          sz_r.z2(aq, h, x, e1, e2, e3)
        case 1n+bq:
          match h:
            case 0n:
              sz_r.z3(aq, bq, x, e1, e2, e3)
            case 1n+hq:
              match x:
                case 0n:
                  sz_r.z4(aq, bq, hq, e1, e2, e3)
                case 1n+xq:
                  sz_r(aq, bq, hq, xq, e1, e2, e3)
