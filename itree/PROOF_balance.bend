# Proofs of LAWS_balance.bend, for the U32 instance (ITree32).
#
# The plan, the usual argument for AVL trees (Knuth, TAOCP 6.2.3):
# * mk builds a node with its height computed from its children, so the
#   node is balanced when its children are and their heights differ by at
#   most one;
# * bal, given balanced subtrees whose heights differ by at most two, builds
#   a balanced tree whose height is the larger subtree's, or one more, and
#   one more when it did not rotate (balh); each rotation is a case of the
#   heights of the subtrees involved;
# * insertion makes a subtree at most one higher (grow), and removal at
#   most one lower (shrink, through merge and del_min), so the parent's
#   subtrees differ by at most two when bal is called;
# * the size bound: in a balanced tree of height at least 2k + 2 both
#   subtrees have height at least 2k, so by induction each holds at least
#   2^k - 1 entries, and the tree at least 2^(k+1) - 1.
#
# The facts about heights are claims about a few Nat variables, proved in
# proof_heights.bend (generated by gen/heights.py). Nothing here depends
# on the keys or their order.
import Base
import ./itree.bend as T
import ./proof_heights.bend as Hn
import ./LAWS_balance.bend as Laws
import ../u32/LAWS.bend as UL
import ../u32/PROOF.bend as UP

# Bool

def and_l(x: Bool, -y: Bool, +e: {Bool.and(x, y) == True{} : Bool}) -> {x == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, Hn.ab.ft(e))

def and_r(x: Bool, -y: Bool, +e: {Bool.and(x, y) == True{} : Bool}) -> {y == True{} : Bool}:
  match x:
    case True{}:
      e
    case False{}:
      Empty.absurd({y == True{} : Bool}, Hn.ab.ft(e))

def and_intro(-x: Bool, -y: Bool, +ex: {x == True{} : Bool}, +ey: {y == True{} : Bool}) -> {Bool.and(x, y) == True{} : Bool}:
  %Equal.sym(Bool, x, True{}, ex) : {Bool.and(_, y) == True{} : Bool}
  ey

# Nat

def nat.eq_refl(x: Nat) -> {Nat.is_eq(x, x) == True{} : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      nat.eq_refl(p)

def nat.lt_zero(x: Nat, +e: {Nat.is_lt(x, 0n) == True{} : Bool}) -> Empty:
  match x:
    case 0n:
      Hn.ab.ft(e)
    case 1n+p:
      Hn.ab.ft(e)

def nat.le_zero(x: Nat) -> {Nat.is_le(0n, x) == True{} : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      {==}

# p <= x and p <= y give p + p <= x + y
def nat.le_add_self(+p: Nat, +x: Nat, +y: Nat, +ex: {Nat.is_le(p, x) == True{} : Bool}, +ey: {Nat.is_le(p, y) == True{} : Bool}) -> {Nat.is_le(Nat.add(p, p), Nat.add(x, y)) == True{} : Bool}:
  match p:
    case 0n:
      nat.le_zero(Nat.add(x, y))
    case 1n+(+q):
      match x:
        case 0n:
          Empty.absurd({Nat.is_le(Nat.add(1n+q, 1n+q), Nat.add(0n, y)) == True{} : Bool}, Hn.ab.ft(ex))
        case 1n+(+xp):
          match y:
            case 0n:
              Empty.absurd({Nat.is_le(Nat.add(1n+q, 1n+q), Nat.add(1n+xp, 0n)) == True{} : Bool}, Hn.ab.ft(ey))
            case 1n+(+yp):
              %Equal.sym(Nat, Nat.add(q, 1n+q), 1n+Nat.add(q, q), UL.nat_add_succ(q, q)) : {Nat.is_le(1n+_, 1n+Nat.add(xp, 1n+yp)) == True{} : Bool}
              %Equal.sym(Nat, Nat.add(xp, 1n+yp), 1n+Nat.add(xp, yp), UL.nat_add_succ(xp, yp)) : {Nat.is_le(2n+Nat.add(q, q), 1n+_) == True{} : Bool}
              nat.le_add_self(q, xp, yp, ex, ey)

# p <= x + 1 and p <= y + 1 give 2p <= x + y + 2
def nat.twice(+p: Nat, +x: Nat, +y: Nat, +ex: {Nat.is_le(p, 1n+x) == True{} : Bool}, +ey: {Nat.is_le(p, 1n+y) == True{} : Bool}) -> {Nat.is_le(Nat.mul(2n, p), 2n+Nat.add(x, y)) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(p, 0n), p, UL.nat_add_zero(p)) : {Nat.is_le(Nat.add(p, _), 2n+Nat.add(x, y)) == True{} : Bool}
  %UL.nat_add_succ(x, y) : {Nat.is_le(Nat.add(p, p), 1n+_) == True{} : Bool}
  nat.le_add_self(p, 1n+x, 1n+y, ex, ey)

# Trees

def Tr(-V: Data) -> Data:
  T.ITree<U32, V>

def Ent(-V: Data) -> Data:
  T.ITreeEntry<U32, V>

def ht(-V: Data, t: Tr(V)) -> Nat:
  T.ITree.height(U32, V, t)

def bl(-V: Data, t: Tr(V)) -> Bool:
  T.ITree.balanced(U32, V, t)

def mk(-V: Data, +l: Tr(V), +e: Ent(V), +r: Tr(V)) -> Tr(V):
  T.ITree.mk(~U32, ~U32.cmp, V, l, e, r)

def bal(-V: Data, +l: Tr(V), e: Ent(V), +r: Tr(V)) -> Tr(V):
  T.ITree.bal(~U32, ~U32.cmp, V, l, e, r)

# the parts of balanced at a node: its stored height, the two height
# differences, and its subtrees
def b1(-V: Data, +h: Nat, +l: Tr(V), +r: Tr(V)) -> Bool:
  Nat.is_eq(h, 1n+Nat.max(ht(V, l), ht(V, r)))

def b2(-V: Data, +l: Tr(V), +r: Tr(V)) -> Bool:
  Nat.is_le(ht(V, l), 1n+ht(V, r))

def b3(-V: Data, +l: Tr(V), +r: Tr(V)) -> Bool:
  Nat.is_le(ht(V, r), 1n+ht(V, l))

def b4(-V: Data, +l: Tr(V), +r: Tr(V)) -> Bool:
  Bool.and(bl(V, l), bl(V, r))

def bn.h(-V: Data, +h: Nat, -m: U32, +l: Tr(V), -e: Ent(V), +r: Tr(V), +en: {bl(V, T.ITreeNode{h, m, l, e, r}) == True{} : Bool}) -> {b1(V, h, l, r) == True{} : Bool}:
  and_l(b1(V, h, l, r), Bool.and(b2(V, l, r), Bool.and(b3(V, l, r), b4(V, l, r))), en)

def bn.n(-V: Data, +h: Nat, -m: U32, +l: Tr(V), -e: Ent(V), +r: Tr(V), +en: {bl(V, T.ITreeNode{h, m, l, e, r}) == True{} : Bool}) -> {Hn.nr(ht(V, l), ht(V, r)) == True{} : Bool}:
  +x = and_r(b1(V, h, l, r), Bool.and(b2(V, l, r), Bool.and(b3(V, l, r), b4(V, l, r))), en)
  and_intro(b2(V, l, r), b3(V, l, r), and_l(b2(V, l, r), Bool.and(b3(V, l, r), b4(V, l, r)), x), and_l(b3(V, l, r), b4(V, l, r), and_r(b2(V, l, r), Bool.and(b3(V, l, r), b4(V, l, r)), x)))

def bn.s(-V: Data, +h: Nat, -m: U32, +l: Tr(V), -e: Ent(V), +r: Tr(V), +en: {bl(V, T.ITreeNode{h, m, l, e, r}) == True{} : Bool}) -> {b4(V, l, r) == True{} : Bool}:
  and_r(b3(V, l, r), b4(V, l, r), and_r(b2(V, l, r), Bool.and(b3(V, l, r), b4(V, l, r)), and_r(b1(V, h, l, r), Bool.and(b2(V, l, r), Bool.and(b3(V, l, r), b4(V, l, r))), en)))

def bn.l(-V: Data, +h: Nat, -m: U32, +l: Tr(V), -e: Ent(V), +r: Tr(V), +en: {bl(V, T.ITreeNode{h, m, l, e, r}) == True{} : Bool}) -> {bl(V, l) == True{} : Bool}:
  and_l(bl(V, l), bl(V, r), bn.s(V, h, m, l, e, r, en))

def bn.r(-V: Data, +h: Nat, -m: U32, +l: Tr(V), -e: Ent(V), +r: Tr(V), +en: {bl(V, T.ITreeNode{h, m, l, e, r}) == True{} : Bool}) -> {bl(V, r) == True{} : Bool}:
  and_r(bl(V, l), bl(V, r), bn.s(V, h, m, l, e, r, en))

# a node built by mk is balanced when its subtrees are, and their heights
# differ by at most one
def mk.B(-V: Data, +l: Tr(V), +e: Ent(V), +r: Tr(V), +el: {bl(V, l) == True{} : Bool}, +er: {bl(V, r) == True{} : Bool}, +n: {Hn.nr(ht(V, l), ht(V, r)) == True{} : Bool}) -> {bl(V, mk(V, l, e, r)) == True{} : Bool}:
  and_intro(b1(V, 1n+Nat.max(ht(V, l), ht(V, r)), l, r), Bool.and(b2(V, l, r), Bool.and(b3(V, l, r), b4(V, l, r))), nat.eq_refl(1n+Nat.max(ht(V, l), ht(V, r))), and_intro(b2(V, l, r), Bool.and(b3(V, l, r), b4(V, l, r)), and_l(b2(V, l, r), b3(V, l, r), n), and_intro(b3(V, l, r), b4(V, l, r), and_r(b2(V, l, r), b3(V, l, r), n), and_intro(bl(V, l), bl(V, r), el, er))))

# Rebalancing: balanced, with the height balh says

def okb(-V: Data, +x: Tr(V), +a: Nat, +b: Nat) -> Bool:
  Bool.and(bl(V, x), Hn.balh(a, b, ht(V, x)))

# rot_r, a double rotation: lr is not empty (it is higher than ll)
def rotr.dbl(-V: Data, +h: Nat, +ll: Tr(V), +le: Ent(V), lr: Tr(V), +e: Ent(V), +r: Tr(V), +ed: {Nat.is_lt(ht(V, ll), ht(V, lr)) == True{} : Bool}, +eh: {Nat.is_eq(h, 1n+Nat.max(ht(V, ll), ht(V, lr))) == True{} : Bool}, +en: {Hn.nr(ht(V, ll), ht(V, lr)) == True{} : Bool}, +ell: {bl(V, ll) == True{} : Bool}, +elr: {bl(V, lr) == True{} : Bool}, +er: {bl(V, r) == True{} : Bool}, +elh: {Nat.is_lt(1n+ht(V, r), h) == True{} : Bool}, +n2: {Hn.nr2(h, ht(V, r)) == True{} : Bool}) -> {okb(V, T.ITree.rot_r.go(~U32, ~U32.cmp, V, True{}, ll, le, lr, e, r), h, ht(V, r)) == True{} : Bool}:
  match lr:
    case T.ITreeLeaf{}:
      Empty.absurd({okb(V, T.ITree.rot_r.go(~U32, ~U32.cmp, V, True{}, ll, le, T.ITreeLeaf{}, e, r), h, ht(V, r)) == True{} : Bool}, nat.lt_zero(ht(V, ll), ed))
    case T.ITreeNode{+h2, +m2, +lrl, +lre, +lrr}:
      +f6 = bn.h(V, h2, m2, lrl, lre, lrr, elr)
      +f7 = bn.n(V, h2, m2, lrl, lre, lrr, elr)
      and_intro(bl(V, mk(V, mk(V, ll, le, lrl), lre, mk(V, lrr, e, r))), Hn.balh(h, ht(V, r), 1n+Nat.max(1n+Nat.max(ht(V, ll), ht(V, lrl)), 1n+Nat.max(ht(V, lrr), ht(V, r)))), mk.B(V, mk(V, ll, le, lrl), lre, mk(V, lrr, e, r), mk.B(V, ll, le, lrl, ell, bn.l(V, h2, m2, lrl, lre, lrr, elr), Hn.rr2_a(ht(V, ll), ht(V, lrl), ht(V, lrr), ht(V, r), h, h2, ed, eh, en, elh, n2, f6, f7)), mk.B(V, lrr, e, r, bn.r(V, h2, m2, lrl, lre, lrr, elr), er, Hn.rr2_b(ht(V, ll), ht(V, lrl), ht(V, lrr), ht(V, r), h, h2, ed, eh, en, elh, n2, f6, f7)), Hn.rr2_c(ht(V, ll), ht(V, lrl), ht(V, lrr), ht(V, r), h, h2, ed, eh, en, elh, n2, f6, f7)), Hn.rr2_h(ht(V, ll), ht(V, lrl), ht(V, lrr), ht(V, r), h, h2, ed, eh, en, elh, n2, f6, f7))

def rotr.go(dbl: Bool, -V: Data, +h: Nat, +ll: Tr(V), +le: Ent(V), +lr: Tr(V), +e: Ent(V), +r: Tr(V), +ed: {Nat.is_lt(ht(V, ll), ht(V, lr)) == dbl : Bool}, +eh: {Nat.is_eq(h, 1n+Nat.max(ht(V, ll), ht(V, lr))) == True{} : Bool}, +en: {Hn.nr(ht(V, ll), ht(V, lr)) == True{} : Bool}, +ell: {bl(V, ll) == True{} : Bool}, +elr: {bl(V, lr) == True{} : Bool}, +er: {bl(V, r) == True{} : Bool}, +elh: {Nat.is_lt(1n+ht(V, r), h) == True{} : Bool}, +n2: {Hn.nr2(h, ht(V, r)) == True{} : Bool}) -> {okb(V, T.ITree.rot_r.go(~U32, ~U32.cmp, V, dbl, ll, le, lr, e, r), h, ht(V, r)) == True{} : Bool}:
  match dbl:
    case False{}:
      and_intro(bl(V, mk(V, ll, le, mk(V, lr, e, r))), Hn.balh(h, ht(V, r), 1n+Nat.max(ht(V, ll), 1n+Nat.max(ht(V, lr), ht(V, r)))), mk.B(V, ll, le, mk(V, lr, e, r), ell, mk.B(V, lr, e, r, elr, er, Hn.rr1_a(ht(V, ll), ht(V, lr), ht(V, r), h, ed, eh, en, elh, n2)), Hn.rr1_b(ht(V, ll), ht(V, lr), ht(V, r), h, ed, eh, en, elh, n2)), Hn.rr1_h(ht(V, ll), ht(V, lr), ht(V, r), h, ed, eh, en, elh, n2))
    case True{}:
      rotr.dbl(V, h, ll, le, lr, e, r, ed, eh, en, ell, elr, er, elh, n2)

# l is two higher than r
def rotr(-V: Data, l: Tr(V), +e: Ent(V), +r: Tr(V), +elh: {Nat.is_lt(1n+ht(V, r), ht(V, l)) == True{} : Bool}, +el: {bl(V, l) == True{} : Bool}, +er: {bl(V, r) == True{} : Bool}, +n2: {Hn.nr2(ht(V, l), ht(V, r)) == True{} : Bool}) -> {okb(V, T.ITree.rot_r(~U32, ~U32.cmp, V, l, e, r), ht(V, l), ht(V, r)) == True{} : Bool}:
  match l:
    case T.ITreeLeaf{}:
      Empty.absurd({okb(V, T.ITree.rot_r(~U32, ~U32.cmp, V, T.ITreeLeaf{}, e, r), 0n, ht(V, r)) == True{} : Bool}, Hn.ab.ft(elh))
    case T.ITreeNode{+h, +m, +ll, +le, +lr}:
      rotr.go(Nat.is_lt(ht(V, ll), ht(V, lr)), V, h, ll, le, lr, e, r, {==}, bn.h(V, h, m, ll, le, lr, el), bn.n(V, h, m, ll, le, lr, el), bn.l(V, h, m, ll, le, lr, el), bn.r(V, h, m, ll, le, lr, el), er, elh, n2)

# rot_l, a double rotation: rl is not empty (it is higher than rr)
def rotl.dbl(-V: Data, +h: Nat, +l: Tr(V), +e: Ent(V), rl: Tr(V), +re: Ent(V), +rr: Tr(V), +ed: {Nat.is_lt(ht(V, rr), ht(V, rl)) == True{} : Bool}, +eh: {Nat.is_eq(h, 1n+Nat.max(ht(V, rl), ht(V, rr))) == True{} : Bool}, +en: {Hn.nr(ht(V, rl), ht(V, rr)) == True{} : Bool}, +el: {bl(V, l) == True{} : Bool}, +erl: {bl(V, rl) == True{} : Bool}, +err: {bl(V, rr) == True{} : Bool}, +erh: {Nat.is_lt(1n+ht(V, l), h) == True{} : Bool}, +n2: {Hn.nr2(ht(V, l), h) == True{} : Bool}) -> {okb(V, T.ITree.rot_l.go(~U32, ~U32.cmp, V, True{}, l, e, rl, re, rr), ht(V, l), h) == True{} : Bool}:
  match rl:
    case T.ITreeLeaf{}:
      Empty.absurd({okb(V, T.ITree.rot_l.go(~U32, ~U32.cmp, V, True{}, l, e, T.ITreeLeaf{}, re, rr), ht(V, l), h) == True{} : Bool}, nat.lt_zero(ht(V, rr), ed))
    case T.ITreeNode{+h2, +m2, +rll, +rle, +rlr}:
      +f6 = bn.h(V, h2, m2, rll, rle, rlr, erl)
      +f7 = bn.n(V, h2, m2, rll, rle, rlr, erl)
      and_intro(bl(V, mk(V, mk(V, l, e, rll), rle, mk(V, rlr, re, rr))), Hn.balh(ht(V, l), h, 1n+Nat.max(1n+Nat.max(ht(V, l), ht(V, rll)), 1n+Nat.max(ht(V, rlr), ht(V, rr)))), mk.B(V, mk(V, l, e, rll), rle, mk(V, rlr, re, rr), mk.B(V, l, e, rll, el, bn.l(V, h2, m2, rll, rle, rlr, erl), Hn.rl2_a(ht(V, rr), ht(V, rll), ht(V, rlr), ht(V, l), h, h2, ed, eh, en, erh, n2, f6, f7)), mk.B(V, rlr, re, rr, bn.r(V, h2, m2, rll, rle, rlr, erl), err, Hn.rl2_b(ht(V, rr), ht(V, rll), ht(V, rlr), ht(V, l), h, h2, ed, eh, en, erh, n2, f6, f7)), Hn.rl2_c(ht(V, rr), ht(V, rll), ht(V, rlr), ht(V, l), h, h2, ed, eh, en, erh, n2, f6, f7)), Hn.rl2_h(ht(V, rr), ht(V, rll), ht(V, rlr), ht(V, l), h, h2, ed, eh, en, erh, n2, f6, f7))

def rotl.go(dbl: Bool, -V: Data, +h: Nat, +l: Tr(V), +e: Ent(V), +rl: Tr(V), +re: Ent(V), +rr: Tr(V), +ed: {Nat.is_lt(ht(V, rr), ht(V, rl)) == dbl : Bool}, +eh: {Nat.is_eq(h, 1n+Nat.max(ht(V, rl), ht(V, rr))) == True{} : Bool}, +en: {Hn.nr(ht(V, rl), ht(V, rr)) == True{} : Bool}, +el: {bl(V, l) == True{} : Bool}, +erl: {bl(V, rl) == True{} : Bool}, +err: {bl(V, rr) == True{} : Bool}, +erh: {Nat.is_lt(1n+ht(V, l), h) == True{} : Bool}, +n2: {Hn.nr2(ht(V, l), h) == True{} : Bool}) -> {okb(V, T.ITree.rot_l.go(~U32, ~U32.cmp, V, dbl, l, e, rl, re, rr), ht(V, l), h) == True{} : Bool}:
  match dbl:
    case False{}:
      and_intro(bl(V, mk(V, mk(V, l, e, rl), re, rr)), Hn.balh(ht(V, l), h, 1n+Nat.max(1n+Nat.max(ht(V, l), ht(V, rl)), ht(V, rr))), mk.B(V, mk(V, l, e, rl), re, rr, mk.B(V, l, e, rl, el, erl, Hn.rl1_a(ht(V, rr), ht(V, rl), ht(V, l), h, ed, eh, en, erh, n2)), err, Hn.rl1_b(ht(V, rr), ht(V, rl), ht(V, l), h, ed, eh, en, erh, n2)), Hn.rl1_h(ht(V, rr), ht(V, rl), ht(V, l), h, ed, eh, en, erh, n2))
    case True{}:
      rotl.dbl(V, h, l, e, rl, re, rr, ed, eh, en, el, erl, err, erh, n2)

# r is two higher than l
def rotl(-V: Data, +l: Tr(V), +e: Ent(V), r: Tr(V), +erh: {Nat.is_lt(1n+ht(V, l), ht(V, r)) == True{} : Bool}, +el: {bl(V, l) == True{} : Bool}, +er: {bl(V, r) == True{} : Bool}, +n2: {Hn.nr2(ht(V, l), ht(V, r)) == True{} : Bool}) -> {okb(V, T.ITree.rot_l(~U32, ~U32.cmp, V, l, e, r), ht(V, l), ht(V, r)) == True{} : Bool}:
  match r:
    case T.ITreeLeaf{}:
      Empty.absurd({okb(V, T.ITree.rot_l(~U32, ~U32.cmp, V, l, e, T.ITreeLeaf{}), ht(V, l), 0n) == True{} : Bool}, Hn.ab.ft(erh))
    case T.ITreeNode{+h, +m, +rl, +re, +rr}:
      rotl.go(Nat.is_lt(ht(V, rr), ht(V, rl)), V, h, l, e, rl, re, rr, {==}, bn.h(V, h, m, rl, re, rr, er), bn.n(V, h, m, rl, re, rr, er), el, bn.l(V, h, m, rl, re, rr, er), bn.r(V, h, m, rl, re, rr, er), erh, n2)

def bal.go(lh: Bool, rh: Bool, -V: Data, +l: Tr(V), +e: Ent(V), +r: Tr(V), +elh: {Nat.is_lt(1n+ht(V, r), ht(V, l)) == lh : Bool}, +erh: {Nat.is_lt(1n+ht(V, l), ht(V, r)) == rh : Bool}, +el: {bl(V, l) == True{} : Bool}, +er: {bl(V, r) == True{} : Bool}, +n2: {Hn.nr2(ht(V, l), ht(V, r)) == True{} : Bool}) -> {okb(V, T.ITree.bal.go(~U32, ~U32.cmp, V, lh, rh, l, e, r), ht(V, l), ht(V, r)) == True{} : Bool}:
  match lh:
    case True{}:
      rotr(V, l, e, r, elh, el, er, n2)
    case False{}:
      match rh:
        case True{}:
          rotl(V, l, e, r, erh, el, er, n2)
        case False{}:
          and_intro(bl(V, mk(V, l, e, r)), Hn.balh(ht(V, l), ht(V, r), 1n+Nat.max(ht(V, l), ht(V, r))), mk.B(V, l, e, r, el, er, Hn.mk_nr(ht(V, l), ht(V, r), elh, erh)), Hn.mk_balh(ht(V, l), ht(V, r), elh, erh))

# bal of balanced subtrees whose heights differ by at most two is
# balanced, of the height balh says
def bal.ok(-V: Data, +l: Tr(V), +e: Ent(V), +r: Tr(V), +el: {bl(V, l) == True{} : Bool}, +er: {bl(V, r) == True{} : Bool}, +n2: {Hn.nr2(ht(V, l), ht(V, r)) == True{} : Bool}) -> {okb(V, bal(V, l, e, r), ht(V, l), ht(V, r)) == True{} : Bool}:
  bal.go(Nat.is_lt(1n+ht(V, r), ht(V, l)), Nat.is_lt(1n+ht(V, l), ht(V, r)), V, l, e, r, {==}, {==}, el, er, n2)

def bal.B(-V: Data, +x: Tr(V), +a: Nat, +b: Nat, +o: {okb(V, x, a, b) == True{} : Bool}) -> {bl(V, x) == True{} : Bool}:
  and_l(bl(V, x), Hn.balh(a, b, ht(V, x)), o)

def bal.H(-V: Data, +x: Tr(V), +a: Nat, +b: Nat, +o: {okb(V, x, a, b) == True{} : Bool}) -> {Hn.balh(a, b, ht(V, x)) == True{} : Bool}:
  and_r(bl(V, x), Hn.balh(a, b, ht(V, x)), o)

# Insertion: balanced, at most one higher

def probe(-V: Data, t: Tr(V), +s: U32, +l: U32) -> Cmp:
  T.ITree.probe(~U32, ~U32.cmp, V, t, s, l)

def ins(-V: Data, t: Tr(V), c: Cmp, +s: U32, +l: U32, +v: V) -> Tr(V):
  T.ITree.ins(~U32, ~U32.cmp, V, t, c, s, l, v)

def okg(-V: Data, +a: Nat, +x: Tr(V)) -> Bool:
  Bool.and(bl(V, x), Hn.grow(a, ht(V, x)))

def ins.ok(-V: Data, t: Tr(V), c: Cmp, +s: U32, +l: U32, +v: V, +et: {bl(V, t) == True{} : Bool}) -> {okg(V, ht(V, t), ins(V, t, c, s, l, v)) == True{} : Bool}:
  match t:
    case T.ITreeLeaf{}:
      {==}
    case T.ITreeNode{+h, +m, +tl, +e, +tr}:
      match c:
        case LT{}:
          +ih = ins.ok(V, tl, probe(V, tl, s, l), s, l, v, bn.l(V, h, m, tl, e, tr, et))
          +g = and_r(bl(V, ins(V, tl, probe(V, tl, s, l), s, l, v)), Hn.grow(ht(V, tl), ht(V, ins(V, tl, probe(V, tl, s, l), s, l, v))), ih)
          +o = bal.ok(V, ins(V, tl, probe(V, tl, s, l), s, l, v), e, tr, and_l(bl(V, ins(V, tl, probe(V, tl, s, l), s, l, v)), Hn.grow(ht(V, tl), ht(V, ins(V, tl, probe(V, tl, s, l), s, l, v))), ih), bn.r(V, h, m, tl, e, tr, et), Hn.il_nr2(ht(V, tl), ht(V, ins(V, tl, probe(V, tl, s, l), s, l, v)), ht(V, tr), bn.n(V, h, m, tl, e, tr, et), g))
          and_intro(bl(V, bal(V, ins(V, tl, probe(V, tl, s, l), s, l, v), e, tr)), Hn.grow(h, ht(V, bal(V, ins(V, tl, probe(V, tl, s, l), s, l, v), e, tr))), bal.B(V, bal(V, ins(V, tl, probe(V, tl, s, l), s, l, v), e, tr), ht(V, ins(V, tl, probe(V, tl, s, l), s, l, v)), ht(V, tr), o), Hn.il_h(ht(V, tl), ht(V, ins(V, tl, probe(V, tl, s, l), s, l, v)), ht(V, tr), h, ht(V, bal(V, ins(V, tl, probe(V, tl, s, l), s, l, v), e, tr)), bn.h(V, h, m, tl, e, tr, et), bn.n(V, h, m, tl, e, tr, et), g, bal.H(V, bal(V, ins(V, tl, probe(V, tl, s, l), s, l, v), e, tr), ht(V, ins(V, tl, probe(V, tl, s, l), s, l, v)), ht(V, tr), o)))
        case EQ{}:
          and_intro(bl(V, mk(V, tl, T.ITreeEntry{s, l, v}, tr)), Hn.grow(h, 1n+Nat.max(ht(V, tl), ht(V, tr))), mk.B(V, tl, T.ITreeEntry{s, l, v}, tr, bn.l(V, h, m, tl, e, tr, et), bn.r(V, h, m, tl, e, tr, et), bn.n(V, h, m, tl, e, tr, et)), Hn.ieq_h(h, 1n+Nat.max(ht(V, tl), ht(V, tr)), bn.h(V, h, m, tl, e, tr, et)))
        case GT{}:
          +ih = ins.ok(V, tr, probe(V, tr, s, l), s, l, v, bn.r(V, h, m, tl, e, tr, et))
          +g = and_r(bl(V, ins(V, tr, probe(V, tr, s, l), s, l, v)), Hn.grow(ht(V, tr), ht(V, ins(V, tr, probe(V, tr, s, l), s, l, v))), ih)
          +o = bal.ok(V, tl, e, ins(V, tr, probe(V, tr, s, l), s, l, v), bn.l(V, h, m, tl, e, tr, et), and_l(bl(V, ins(V, tr, probe(V, tr, s, l), s, l, v)), Hn.grow(ht(V, tr), ht(V, ins(V, tr, probe(V, tr, s, l), s, l, v))), ih), Hn.ir_nr2(ht(V, tl), ht(V, tr), ht(V, ins(V, tr, probe(V, tr, s, l), s, l, v)), bn.n(V, h, m, tl, e, tr, et), g))
          and_intro(bl(V, bal(V, tl, e, ins(V, tr, probe(V, tr, s, l), s, l, v))), Hn.grow(h, ht(V, bal(V, tl, e, ins(V, tr, probe(V, tr, s, l), s, l, v)))), bal.B(V, bal(V, tl, e, ins(V, tr, probe(V, tr, s, l), s, l, v)), ht(V, tl), ht(V, ins(V, tr, probe(V, tr, s, l), s, l, v)), o), Hn.ir_h(ht(V, tl), ht(V, tr), ht(V, ins(V, tr, probe(V, tr, s, l), s, l, v)), h, ht(V, bal(V, tl, e, ins(V, tr, probe(V, tr, s, l), s, l, v))), bn.h(V, h, m, tl, e, tr, et), bn.n(V, h, m, tl, e, tr, et), g, bal.H(V, bal(V, tl, e, ins(V, tr, probe(V, tr, s, l), s, l, v)), ht(V, tl), ht(V, ins(V, tr, probe(V, tr, s, l), s, l, v)), o)))

def set.ok(c: Cmp, -V: Data, +t: Tr(V), +s: U32, +l: U32, +v: V, +et: {bl(V, t) == True{} : Bool}) -> {bl(V, T.ITree.set.go(~U32, ~U32.cmp, V, c, t, s, l, v)) == True{} : Bool}:
  match c:
    case LT{}:
      and_l(bl(V, ins(V, t, probe(V, t, s, l), s, l, v)), Hn.grow(ht(V, t), ht(V, ins(V, t, probe(V, t, s, l), s, l, v))), ins.ok(V, t, probe(V, t, s, l), s, l, v, et))
    case EQ{}:
      and_l(bl(V, ins(V, t, probe(V, t, s, l), s, l, v)), Hn.grow(ht(V, t), ht(V, ins(V, t, probe(V, t, s, l), s, l, v))), ins.ok(V, t, probe(V, t, s, l), s, l, v, et))
    case GT{}:
      et

# Removal: balanced, at most one lower

def okr(-V: Data, +a: Nat, +x: Tr(V)) -> Bool:
  Bool.and(bl(V, x), Hn.shrink(a, ht(V, x)))

def okr.B(-V: Data, +a: Nat, +x: Tr(V), +o: {okr(V, a, x) == True{} : Bool}) -> {bl(V, x) == True{} : Bool}:
  and_l(bl(V, x), Hn.shrink(a, ht(V, x)), o)

def okr.H(-V: Data, +a: Nat, +x: Tr(V), +o: {okr(V, a, x) == True{} : Bool}) -> {Hn.shrink(a, ht(V, x)) == True{} : Bool}:
  and_r(bl(V, x), Hn.shrink(a, ht(V, x)), o)

def dmin(-V: Data, t: Tr(V), e: Ent(V), r: Tr(V)) -> Tr(V):
  T.ITree.del_min(~U32, ~U32.cmp, V, t, e, r)

# the node (t, e, r) less its first entry: balanced, at most one lower
def dmin.ok(-V: Data, t: Tr(V), +e: Ent(V), +r: Tr(V), +et: {bl(V, t) == True{} : Bool}, +er: {bl(V, r) == True{} : Bool}, +n: {Hn.nr(ht(V, t), ht(V, r)) == True{} : Bool}) -> {okr(V, 1n+Nat.max(ht(V, t), ht(V, r)), dmin(V, t, e, r)) == True{} : Bool}:
  match t:
    case T.ITreeLeaf{}:
      and_intro(bl(V, r), Hn.shrink(1n+ht(V, r), ht(V, r)), er, Hn.dm_leaf(ht(V, r), n))
    case T.ITreeNode{+h2, +m2, +l2, +e2, +r2}:
      +ih = dmin.ok(V, l2, e2, r2, bn.l(V, h2, m2, l2, e2, r2, et), bn.r(V, h2, m2, l2, e2, r2, et), bn.n(V, h2, m2, l2, e2, r2, et))
      +sd = Hn.node_shrink(h2, 1n+Nat.max(ht(V, l2), ht(V, r2)), ht(V, dmin(V, l2, e2, r2)), bn.h(V, h2, m2, l2, e2, r2, et), okr.H(V, 1n+Nat.max(ht(V, l2), ht(V, r2)), dmin(V, l2, e2, r2), ih))
      +o = bal.ok(V, dmin(V, l2, e2, r2), e, r, okr.B(V, 1n+Nat.max(ht(V, l2), ht(V, r2)), dmin(V, l2, e2, r2), ih), er, Hn.dm_nr2(ht(V, r), h2, ht(V, dmin(V, l2, e2, r2)), sd, n))
      and_intro(bl(V, bal(V, dmin(V, l2, e2, r2), e, r)), Hn.shrink(1n+Nat.max(h2, ht(V, r)), ht(V, bal(V, dmin(V, l2, e2, r2), e, r))), bal.B(V, bal(V, dmin(V, l2, e2, r2), e, r), ht(V, dmin(V, l2, e2, r2)), ht(V, r), o), Hn.dm_h(ht(V, r), h2, ht(V, dmin(V, l2, e2, r2)), ht(V, bal(V, dmin(V, l2, e2, r2), e, r)), sd, n, bal.H(V, bal(V, dmin(V, l2, e2, r2), e, r), ht(V, dmin(V, l2, e2, r2)), ht(V, r), o)))

# the subtrees l, r of a node of height h, merged: balanced, at most one
# lower than h
def merge.ok(-V: Data, +l: Tr(V), r: Tr(V), +h: Nat, +el: {bl(V, l) == True{} : Bool}, +er: {bl(V, r) == True{} : Bool}, +n: {Hn.nr(ht(V, l), ht(V, r)) == True{} : Bool}, +eh: {Nat.is_eq(h, 1n+Nat.max(ht(V, l), ht(V, r))) == True{} : Bool}) -> {okr(V, h, T.ITree.merge(~U32, ~U32.cmp, V, l, r)) == True{} : Bool}:
  match r:
    case T.ITreeLeaf{}:
      and_intro(bl(V, l), Hn.shrink(h, ht(V, l)), el, Hn.mg_leaf(ht(V, l), h, eh, n))
    case T.ITreeNode{+hr, +mr, +rl, +re, +rr}:
      +ih = dmin.ok(V, rl, re, rr, bn.l(V, hr, mr, rl, re, rr, er), bn.r(V, hr, mr, rl, re, rr, er), bn.n(V, hr, mr, rl, re, rr, er))
      +sd = Hn.node_shrink(hr, 1n+Nat.max(ht(V, rl), ht(V, rr)), ht(V, dmin(V, rl, re, rr)), bn.h(V, hr, mr, rl, re, rr, er), okr.H(V, 1n+Nat.max(ht(V, rl), ht(V, rr)), dmin(V, rl, re, rr), ih))
      +o = bal.ok(V, l, T.ITree.min_of(U32, V, rl, re), dmin(V, rl, re, rr), el, okr.B(V, 1n+Nat.max(ht(V, rl), ht(V, rr)), dmin(V, rl, re, rr), ih), Hn.mg_nr2(ht(V, l), hr, ht(V, dmin(V, rl, re, rr)), n, sd))
      and_intro(bl(V, bal(V, l, T.ITree.min_of(U32, V, rl, re), dmin(V, rl, re, rr))), Hn.shrink(h, ht(V, bal(V, l, T.ITree.min_of(U32, V, rl, re), dmin(V, rl, re, rr)))), bal.B(V, bal(V, l, T.ITree.min_of(U32, V, rl, re), dmin(V, rl, re, rr)), ht(V, l), ht(V, dmin(V, rl, re, rr)), o), Hn.mg_h(ht(V, l), hr, h, ht(V, dmin(V, rl, re, rr)), ht(V, bal(V, l, T.ITree.min_of(U32, V, rl, re), dmin(V, rl, re, rr))), eh, n, sd, bal.H(V, bal(V, l, T.ITree.min_of(U32, V, rl, re), dmin(V, rl, re, rr)), ht(V, l), ht(V, dmin(V, rl, re, rr)), o)))

def rem(-V: Data, t: Tr(V), c: Cmp, +s: U32, +l: U32) -> Tr(V):
  T.ITree.rem(~U32, ~U32.cmp, V, t, c, s, l)

def rem.ok(-V: Data, t: Tr(V), c: Cmp, +s: U32, +l: U32, +et: {bl(V, t) == True{} : Bool}) -> {okr(V, ht(V, t), rem(V, t, c, s, l)) == True{} : Bool}:
  match t:
    case T.ITreeLeaf{}:
      {==}
    case T.ITreeNode{+h, +m, +tl, +e, +tr}:
      match c:
        case LT{}:
          +ih = rem.ok(V, tl, probe(V, tl, s, l), s, l, bn.l(V, h, m, tl, e, tr, et))
          +sh = okr.H(V, ht(V, tl), rem(V, tl, probe(V, tl, s, l), s, l), ih)
          +o = bal.ok(V, rem(V, tl, probe(V, tl, s, l), s, l), e, tr, okr.B(V, ht(V, tl), rem(V, tl, probe(V, tl, s, l), s, l), ih), bn.r(V, h, m, tl, e, tr, et), Hn.rml_nr2(ht(V, tl), ht(V, rem(V, tl, probe(V, tl, s, l), s, l)), ht(V, tr), bn.n(V, h, m, tl, e, tr, et), sh))
          and_intro(bl(V, bal(V, rem(V, tl, probe(V, tl, s, l), s, l), e, tr)), Hn.shrink(h, ht(V, bal(V, rem(V, tl, probe(V, tl, s, l), s, l), e, tr))), bal.B(V, bal(V, rem(V, tl, probe(V, tl, s, l), s, l), e, tr), ht(V, rem(V, tl, probe(V, tl, s, l), s, l)), ht(V, tr), o), Hn.rml_h(ht(V, tl), ht(V, rem(V, tl, probe(V, tl, s, l), s, l)), ht(V, tr), h, ht(V, bal(V, rem(V, tl, probe(V, tl, s, l), s, l), e, tr)), bn.h(V, h, m, tl, e, tr, et), bn.n(V, h, m, tl, e, tr, et), sh, bal.H(V, bal(V, rem(V, tl, probe(V, tl, s, l), s, l), e, tr), ht(V, rem(V, tl, probe(V, tl, s, l), s, l)), ht(V, tr), o)))
        case EQ{}:
          merge.ok(V, tl, tr, h, bn.l(V, h, m, tl, e, tr, et), bn.r(V, h, m, tl, e, tr, et), bn.n(V, h, m, tl, e, tr, et), bn.h(V, h, m, tl, e, tr, et))
        case GT{}:
          +ih = rem.ok(V, tr, probe(V, tr, s, l), s, l, bn.r(V, h, m, tl, e, tr, et))
          +sh = okr.H(V, ht(V, tr), rem(V, tr, probe(V, tr, s, l), s, l), ih)
          +o = bal.ok(V, tl, e, rem(V, tr, probe(V, tr, s, l), s, l), bn.l(V, h, m, tl, e, tr, et), okr.B(V, ht(V, tr), rem(V, tr, probe(V, tr, s, l), s, l), ih), Hn.rmr_nr2(ht(V, tl), ht(V, tr), ht(V, rem(V, tr, probe(V, tr, s, l), s, l)), bn.n(V, h, m, tl, e, tr, et), sh))
          and_intro(bl(V, bal(V, tl, e, rem(V, tr, probe(V, tr, s, l), s, l))), Hn.shrink(h, ht(V, bal(V, tl, e, rem(V, tr, probe(V, tr, s, l), s, l)))), bal.B(V, bal(V, tl, e, rem(V, tr, probe(V, tr, s, l), s, l)), ht(V, tl), ht(V, rem(V, tr, probe(V, tr, s, l), s, l)), o), Hn.rmr_h(ht(V, tl), ht(V, tr), ht(V, rem(V, tr, probe(V, tr, s, l), s, l)), h, ht(V, bal(V, tl, e, rem(V, tr, probe(V, tr, s, l), s, l))), bn.h(V, h, m, tl, e, tr, et), bn.n(V, h, m, tl, e, tr, et), sh, bal.H(V, bal(V, tl, e, rem(V, tr, probe(V, tr, s, l), s, l)), ht(V, tl), ht(V, rem(V, tr, probe(V, tr, s, l), s, l)), o)))

# The size bound

def size(-V: Data, t: Tr(V)) -> Nat:
  T.ITree.size(U32, V, t)

def size.ok(-V: Data, t: Tr(V), k: Nat, +et: {bl(V, t) == True{} : Bool}, +ek: {Nat.is_le(Nat.double(k), ht(V, t)) == True{} : Bool}) -> {Nat.is_le(Nat.pow(2n, k), 1n+size(V, t)) == True{} : Bool}:
  match t:
    case T.ITreeLeaf{}:
      match k:
        case 0n:
          {==}
        case 1n+j:
          Empty.absurd({Nat.is_le(Nat.pow(2n, 1n+j), 1n+size(V, T.ITreeLeaf{})) == True{} : Bool}, Hn.ab.ft(ek))
    case T.ITreeNode{+h, +m, +l, +e, +r}:
      match k:
        case 0n:
          {==}
        case 1n+(+j):
          +il = size.ok(V, l, j, bn.l(V, h, m, l, e, r, et), Hn.sz_l(ht(V, l), ht(V, r), h, Nat.double(j), ek, bn.h(V, h, m, l, e, r, et), bn.n(V, h, m, l, e, r, et)))
          +ir = size.ok(V, r, j, bn.r(V, h, m, l, e, r, et), Hn.sz_r(ht(V, l), ht(V, r), h, Nat.double(j), ek, bn.h(V, h, m, l, e, r, et), bn.n(V, h, m, l, e, r, et)))
          nat.twice(Nat.pow(2n, j), size(V, l), size(V, r), il, ir)

# The laws

def Laws.balanced_empty(V):
  {==}

def Laws.balanced_set(V, t, s, l, v, e):
  set.ok(U32.cmp(s, l), V, t, s, l, v, e)

def Laws.balanced_remove(V, t, s, l, e):
  okr.B(V, ht(V, t), rem(V, t, probe(V, t, s, l), s, l), rem.ok(V, t, probe(V, t, s, l), s, l, e))

def Laws.size_bound(V, t, k, e, f):
  size.ok(V, t, k, e, f)

def Laws.example_height():
  {==}

def Laws.example_bound_hyp():
  {==}

def Laws.example_balanced_remove():
  {==}
