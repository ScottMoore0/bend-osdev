# FCrypt: its rounds, undone

def Laws.fcrypt_round_trip(k, b):
  match k:
    case FC.LcFcryptKey{+rks}:
      Equal.sym(L.LcBlock64, b, L.lc.fe.unrun(~FC.LcFcRk, ~FC.fc.f, rks, L.lc.fe.run(~FC.LcFcRk, ~FC.fc.f, rks, b)), CoreL.feistel_unrun_run(~FC.LcFcRk, ~FC.fc.f, rks, b))

def Laws.fcrypt_round_trip_dual(k, b):
  match k:
    case FC.LcFcryptKey{+rks}:
      Equal.sym(L.LcBlock64, b, L.lc.fe.run(~FC.LcFcRk, ~FC.fc.f, rks, L.lc.fe.unrun(~FC.LcFcRk, ~FC.fc.f, rks, b)), CoreL.feistel_run_unrun(~FC.LcFcRk, ~FC.fc.f, rks, b))

