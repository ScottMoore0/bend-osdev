# The laws of ecc.
#
# For every curve and input:
#   * point-validation soundness: every point SEC 1's decoding accepts is
#     on the curve (point_of_on_curve), and every point full validation
#     accepts is on the curve (validate_on_curve);
#   * a point decoded from bytes is decoded again, the same, from the bytes
#     EcCurve.point_to writes for it (point_round_trip).
#
# Small-parameter exhaustive laws (generated by gen/exhaustive.py, with
# their proofs), on the curve y^2 = x^3 + 2x + 7 over GF(11), whose base
# point (6, 2) has prime order 7 (ecclaw.toy): ECDH agreement for every
# pair of private keys, and ECDSA verification of every signature, for
# every private key and per-message secret. The curve's parameters pass
# EcCurve.check (toy_check). Agreement and verification for every key of
# every curve are number theory (the group law), not proved here; ref/run.sh
# tests them on the named curves against Python's cryptography.
import Base
import ../bytes/bytes.bend as B
import ../bignum/bignum.bend as N
import ./ecc.bend as E
import ./ecdh.bend as D
import ./ecdsa.bend as S

def ecclaw.nat1(+x: Nat) -> N.BnNat:
  N.BnNat.of_u32(U32.from_nat(Nat.add(x, 1n)))

# the toy curve: y^2 = x^3 + 2x + 7 over GF(11), G = (6, 2) of order 7
def ecclaw.toy() -> E.EcCurve:
  E.EcCurve.of(E.EcParams{N.BnNat.of_u32(11), N.BnNat.of_u32(2), N.BnNat.of_u32(7), N.BnNat.of_u32(6), N.BnNat.of_u32(2), N.BnNat.of_u32(7), N.BnNat.of_u32(1)})

# the hash value 0xa0, whose leftmost 3 bits (n's length) are 5
def ecclaw.hash() -> B.Octets:
  B.Octets.of_list([160])

# whether a signing result verifies under q: true for a refused signature
def ecclaw.verifies(+c: E.EcCurve, q: E.EcPoint, +h: B.Octets, r: Result<&2, &2, E.EcError, S.EcSig>) -> Bool:
  match r:
    case Fail{e}:
      True{}
    case Done{s}:
      S.EcDsa.verify_hash(c, q, h, s)

# whether the toy curve's ECDSA signature of ecclaw.hash with private key d
# and per-message secret k verifies under d's public key (or is refused)
def ecclaw.signs_verify(+d: N.BnNat, +k: N.BnNat) -> Bool:
  +c = ecclaw.toy()
  ecclaw.verifies(c, D.EcDh.public(c, d), ecclaw.hash(), S.EcDsa.sign_hash(c, d, ecclaw.hash(), k))

# Properties, for every input

law point_of_on_curve:
  for +c: E.EcCurve
  for +o: B.Octets
  {Result.map(&2, &2, E.EcError, E.EcPoint, Bool, p => E.EcCurve.on_curve(c, p), E.EcCurve.point_of(c, o)) == Result.map(&2, &2, E.EcError, E.EcPoint, Bool, p => True{}, E.EcCurve.point_of(c, o)) : Result<&2, &2, E.EcError, Bool>}

law validate_on_curve:
  for +c: E.EcCurve
  for +p: E.EcPoint
  for h: {E.EcCurve.validate(c, p) == True{} : Bool}
  {E.EcCurve.on_curve(c, p) == True{} : Bool}

law point_round_trip:
  for +c: E.EcCurve
  for +o: B.Octets
  {Result.bind(&2, &2, E.EcError, E.EcPoint, E.EcPoint, E.EcCurve.point_of(c, o), p => E.EcCurve.point_of(c, E.EcCurve.point_to(c, p))) == E.EcCurve.point_of(c, o) : Result<&2, &2, E.EcError, E.EcPoint>}

# Vectors

law toy_check:
  {E.EcCurve.check(ecclaw.toy()) == True{} : Bool}

# Small-parameter exhaustive laws

# BEGIN GENERATED by gen/exhaustive.py: exhaustive
# on the toy curve (ecclaw.toy), both sides of every pair of private keys d1,
# d2 in [1, 6] compute the same ECDH shared secret
law toy_ecdh:
  for a: Nat
  for b: Nat
  for ha: {Nat.is_lt(a, 6n) == True{} : Bool}
  for hb: {Nat.is_lt(b, 6n) == True{} : Bool}
  {D.EcDh.primitive(ecclaw.toy(), ecclaw.nat1(a), D.EcDh.public(ecclaw.toy(), ecclaw.nat1(b))) == D.EcDh.primitive(ecclaw.toy(), ecclaw.nat1(b), D.EcDh.public(ecclaw.toy(), ecclaw.nat1(a))) : Result<&2, &2, E.EcError, B.Octets>}

# on the toy curve, ECDSA: every signature made with a private key d and a
# per-message secret k in [1, 6] (of the hash value ecclaw.hash) verifies
# under d's public key (ecclaw.signs_verify; a k that gives r = 0 or s = 0 is
# refused)
law toy_ecdsa:
  for d: Nat
  for k: Nat
  for hd: {Nat.is_lt(d, 6n) == True{} : Bool}
  for hk: {Nat.is_lt(k, 6n) == True{} : Bool}
  {ecclaw.signs_verify(ecclaw.nat1(d), ecclaw.nat1(k)) == True{} : Bool}
# END GENERATED: exhaustive
