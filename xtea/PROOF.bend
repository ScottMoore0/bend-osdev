def Laws.xtea_round_trip(k, b):
  match k:
    case XT.LcXteaKey{+ops}:
      Equal.sym(L.LcBlock64, b, TE.tea.unrun(ops, TE.tea.run(ops, b)), TeaL.tea_steps_round_trip(ops, b))

def Laws.xtea_round_trip_dual(k, b):
  match k:
    case XT.LcXteaKey{+ops}:
      Equal.sym(L.LcBlock64, b, TE.tea.run(ops, TE.tea.unrun(ops, b)), TeaL.tea_steps_round_trip_dual(ops, b))

