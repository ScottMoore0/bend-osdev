def aria_unop_op(o: A.LcAriaOp, +s: A.LcAriaSt) -> {s == A.aria.unop(o, A.aria.op(o, s)) : A.LcAriaSt}:
  match o:
    case A.LcAriaRk{+k}:
      aria_xor2(s, k)
    case A.LcAriaSl1{}:
      aria_sl21(s)
    case A.LcAriaSl2{}:
      aria_sl12(s)
    case A.LcAriaDiff{}:
      aria_diff(s)

def aria_op_unop(o: A.LcAriaOp, +s: A.LcAriaSt) -> {s == A.aria.op(o, A.aria.unop(o, s)) : A.LcAriaSt}:
  match o:
    case A.LcAriaRk{+k}:
      aria_xor2(s, k)
    case A.LcAriaSl1{}:
      aria_sl12(s)
    case A.LcAriaSl2{}:
      aria_sl21(s)
    case A.LcAriaDiff{}:
      aria_diffd(s)

