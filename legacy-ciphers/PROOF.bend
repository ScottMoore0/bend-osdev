    case M.CmBlock{+a, +b, +c, +d}:
      %bswap2(a) : {M.CmBlock{a, b, c, d} == M.CmBlock{_, L.lc.bswap.bits(L.lc.bswap.bits(b)), L.lc.bswap.bits(L.lc.bswap.bits(c)), L.lc.bswap.bits(L.lc.bswap.bits(d))} : M.CmBlock}
      %bswap2(b) : {M.CmBlock{a, b, c, d} == M.CmBlock{a, _, L.lc.bswap.bits(L.lc.bswap.bits(c)), L.lc.bswap.bits(L.lc.bswap.bits(d))} : M.CmBlock}
      %bswap2(c) : {M.CmBlock{a, b, c, d} == M.CmBlock{a, b, _, L.lc.bswap.bits(L.lc.bswap.bits(d))} : M.CmBlock}
      %bswap2(d) : {M.CmBlock{a, b, c, d} == M.CmBlock{a, b, c, _} : M.CmBlock}
      {==}

def sp_unop_op(o: P.LcSpOp, +s: M.CmBlock) -> {s == P.sp.unop(o, P.sp.op(o, s)) : M.CmBlock}:
  match o:
    case P.LcSpBswap{}:
      sp_bswap(s)
    case P.LcSpKey{k}:
      block_xx(s, k)
    case P.LcSpS{bx}:
      sp_sop_inv(bx, False{}, s)
    case P.LcSpLt{}:
      sp_lt_inv(s)

def sp_op_unop(o: P.LcSpOp, +s: M.CmBlock) -> {s == P.sp.op(o, P.sp.unop(o, s)) : M.CmBlock}:
  match o:
    case P.LcSpBswap{}:
      sp_bswapd(s)
    case P.LcSpKey{k}:
      block_xx(s, k)
    case P.LcSpS{bx}:
      sp_sop_inv(bx, True{}, s)
    case P.LcSpLt{}:
      sp_lt_invd(s)

def sp_unrun_run(os: List<&2, P.LcSpOp>, +s: M.CmBlock) -> {s == P.sp.unrun(os, P.sp.run(os, s)) : M.CmBlock}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %sp_unrun_run(t, P.sp.op(o, s)) : {s == P.sp.unop(o, _) : M.CmBlock}
      sp_unop_op(o, s)

def sp_run_unrun(os: List<&2, P.LcSpOp>, +s: M.CmBlock) -> {s == P.sp.run(os, P.sp.unrun(os, s)) : M.CmBlock}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %sp_op_unop(o, P.sp.unrun(t, s)) : {s == P.sp.run(t, _) : M.CmBlock}
      sp_run_unrun(t, s)

def Laws.serpent_round_trip(k, b):
  match k:
    case P.LcSerpentKey{ops}:
      Equal.sym(M.CmBlock, b, P.sp.unrun(ops, P.sp.run(ops, b)), sp_unrun_run(ops, b))

def Laws.serpent_round_trip_dual(k, b):
  match k:
    case P.LcSerpentKey{ops}:
      Equal.sym(M.CmBlock, b, P.sp.run(ops, P.sp.unrun(ops, b)), sp_run_unrun(ops, b))

# RC4: the tail-recursive loop is the structural form; XORing the keystream
# twice gives each byte back; the structural form splits at an append

# the loop, for every list and state, is the structural output reversed
# onto what it had
def rc4_go_ref(xs: List<&2, U32>, +st: R.LcRc4State, +acc: List<&2, U32>) -> {R.rc4.go(xs, st, acc) == R.LcRc4Run{R.rc4.after(xs, st), R.rc4.rev_onto(acc, R.rc4.xs(xs, st))} : R.LcRc4Run}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      rc4_go_ref(t, R.rc4.step.st(R.rc4.next(st)), Con{B.byte(U32.xor(x, R.rc4.step.k(R.rc4.next(st)))), acc})

def rc4_update_ref(+st: R.LcRc4State, +m: B.Octets) -> {R.LcRc4Out{R.rc4.after(B.Octets.to_list(m), st), B.Octets.of_list(R.rc4.xs(B.Octets.to_list(m), st))} == R.LcRc4.update(st, m) : R.LcRc4Out}:
  %Equal.sym(R.LcRc4Run, R.rc4.go(B.Octets.to_list(m), st, Nil{}), R.LcRc4Run{R.rc4.after(B.Octets.to_list(m), st), R.rc4.rev_onto(Nil{}, R.rc4.xs(B.Octets.to_list(m), st))}, rc4_go_ref(B.Octets.to_list(m), st, Nil{})) : {R.LcRc4Out{R.rc4.after(B.Octets.to_list(m), st), B.Octets.of_list(R.rc4.xs(B.Octets.to_list(m), st))} == R.rc4.out(_) : R.LcRc4Out}
  {==}

def byte_xx(+h: U32, +k: U32) -> {B.byte(h) == B.byte(U32.xor(B.byte(U32.xor(h, k)), k)) : U32}:
  %byte_xor_byte(U32.xor(h, k), k) : {B.byte(h) == _ : U32}
  %u32_xx(h, k) : {B.byte(h) == B.byte(_) : U32}
  {==}

def rc4_mask_xs(ys: List<&2, U32>, +st: R.LcRc4State) -> {R.rc4.xs(ys, st) == R.rc4.xs(B.mask(ys), st) : List<&2, U32>}:
  match ys:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      %byte_xor_byte(h, R.rc4.step.k(R.rc4.next(st))) : {Con{B.byte(U32.xor(h, R.rc4.step.k(R.rc4.next(st)))), R.rc4.xs(t, R.rc4.step.st(R.rc4.next(st)))} == Con{_, R.rc4.xs(B.mask(t), R.rc4.step.st(R.rc4.next(st)))} : List<&2, U32>}
      %rc4_mask_xs(t, R.rc4.step.st(R.rc4.next(st))) : {Con{B.byte(U32.xor(h, R.rc4.step.k(R.rc4.next(st)))), R.rc4.xs(t, R.rc4.step.st(R.rc4.next(st)))} == Con{B.byte(U32.xor(h, R.rc4.step.k(R.rc4.next(st)))), _} : List<&2, U32>}
      {==}

def rc4_xs_xs(ys: List<&2, U32>, +st: R.LcRc4State) -> {B.mask(ys) == R.rc4.xs(R.rc4.xs(ys, st), st) : List<&2, U32>}:
  match ys:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      %byte_xx(h, R.rc4.step.k(R.rc4.next(st))) : {Con{B.byte(h), B.mask(t)} == Con{_, R.rc4.xs(R.rc4.xs(t, R.rc4.step.st(R.rc4.next(st))), R.rc4.step.st(R.rc4.next(st)))} : List<&2, U32>}
      %rc4_xs_xs(t, R.rc4.step.st(R.rc4.next(st))) : {Con{B.byte(h), B.mask(t)} == Con{B.byte(h), _} : List<&2, U32>}
      {==}

def Laws.rc4_involution(st, m):
  %rc4_update_ref(st, m) : {R.LcRc4.out_data(R.LcRc4.update(st, R.LcRc4.out_data(_))) == m : B.Octets}
  %rc4_update_ref(st, B.Octets.of_list(R.rc4.xs(B.Octets.to_list(m), st))) : {R.LcRc4.out_data(_) == m : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(R.rc4.xs(B.Octets.to_list(m), st))), B.mask(R.rc4.xs(B.Octets.to_list(m), st)), BL.octets_to_of(R.rc4.xs(B.Octets.to_list(m), st))) : {B.Octets.of_list(R.rc4.xs(_, st)) == m : B.Octets}
  %rc4_mask_xs(R.rc4.xs(B.Octets.to_list(m), st), st) : {B.Octets.of_list(_) == m : B.Octets}
  %rc4_xs_xs(B.Octets.to_list(m), st) : {B.Octets.of_list(_) == m : B.Octets}
  %BL.octets_to_of(B.Octets.to_list(m)) : {B.Octets.of_list(_) == m : B.Octets}
  %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(B.Octets.of_list(B.Octets.to_list(m)))), B.Octets.of_list(B.Octets.to_list(m)), BL.octets_of_list_idempotent(B.Octets.to_list(m))) : {_ == m : B.Octets}
  BL.octets_of_to(m)

def rc4_after_append(xs: List<&2, U32>, +ys: List<&2, U32>, +st: R.LcRc4State) -> {R.rc4.after(B.append(xs, ys), st) == R.rc4.after(ys, R.rc4.after(xs, st)) : R.LcRc4State}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      rc4_after_append(t, ys, R.rc4.step.st(R.rc4.next(st)))

def rc4_xs_append(xs: List<&2, U32>, +ys: List<&2, U32>, +st: R.LcRc4State) -> {R.rc4.xs(B.append(xs, ys), st) == B.append(R.rc4.xs(xs, st), R.rc4.xs(ys, R.rc4.after(xs, st))) : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      %rc4_xs_append(t, ys, R.rc4.step.st(R.rc4.next(st))) : {Con{B.byte(U32.xor(x, R.rc4.step.k(R.rc4.next(st)))), R.rc4.xs(B.append(t, ys), R.rc4.step.st(R.rc4.next(st)))} == Con{B.byte(U32.xor(x, R.rc4.step.k(R.rc4.next(st)))), _} : List<&2, U32>}
      {==}

def mask_append(p: List<&2, U32>, +q: List<&2, U32>) -> {B.mask(B.append(p, q)) == B.append(B.mask(p), B.mask(q)) : List<&2, U32>}:
  match p:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      %mask_append(t, q) : {Con{B.byte(h), B.mask(B.append(t, q))} == Con{B.byte(h), _} : List<&2, U32>}
      {==}

# Octets.of_list of an append is the append of the Octets (from bytes' laws)
def octets_of_append(+p: List<&2, U32>, +q: List<&2, U32>) -> {B.Octets.of_list(B.append(p, q)) == B.Octets.append(B.Octets.of_list(p), B.Octets.of_list(q)) : B.Octets}:
  %BL.octets_of_to(B.Octets.append(B.Octets.of_list(p), B.Octets.of_list(q))) : {B.Octets.of_list(B.append(p, q)) == _ : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(B.Octets.of_list(p), B.Octets.of_list(q))), B.append(B.Octets.to_list(B.Octets.of_list(p)), B.Octets.to_list(B.Octets.of_list(q))), BL.octets_append_list(B.Octets.of_list(p), B.Octets.of_list(q))) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(_) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(p)), B.mask(p), BL.octets_to_of(p)) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(B.append(_, B.Octets.to_list(B.Octets.of_list(q)))) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(q)), B.mask(q), BL.octets_to_of(q)) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(B.append(B.mask(p), _)) : B.Octets}
  %mask_append(p, q) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(_) : B.Octets}
  %BL.octets_to_of(B.append(p, q)) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(_) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(B.Octets.of_list(B.append(p, q)))), B.Octets.of_list(B.append(p, q)), BL.octets_of_list_idempotent(B.append(p, q))) : {B.Octets.of_list(B.append(p, q)) == _ : B.Octets}
  {==}

def Laws.rc4_streaming_state(st, a, b):
  %rc4_update_ref(st, a) : {R.LcRc4.out_state(R.LcRc4.update(st, B.Octets.append(a, b))) == R.LcRc4.out_state(R.LcRc4.update(R.LcRc4.out_state(_), b)) : R.LcRc4State}
  %rc4_update_ref(R.rc4.after(B.Octets.to_list(a), st), b) : {R.LcRc4.out_state(R.LcRc4.update(st, B.Octets.append(a, b))) == R.LcRc4.out_state(_) : R.LcRc4State}
  %rc4_update_ref(st, B.Octets.append(a, b)) : {R.LcRc4.out_state(_) == R.rc4.after(B.Octets.to_list(b), R.rc4.after(B.Octets.to_list(a), st)) : R.LcRc4State}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(a, b)), B.append(B.Octets.to_list(a), B.Octets.to_list(b)), BL.octets_append_list(a, b)) : {R.rc4.after(_, st) == R.rc4.after(B.Octets.to_list(b), R.rc4.after(B.Octets.to_list(a), st)) : R.LcRc4State}
  rc4_after_append(B.Octets.to_list(a), B.Octets.to_list(b), st)

def Laws.rc4_streaming_data(st, a, b):
  %rc4_update_ref(st, a) : {R.LcRc4.out_data(R.LcRc4.update(st, B.Octets.append(a, b))) == B.Octets.append(R.LcRc4.out_data(_), R.LcRc4.out_data(R.LcRc4.update(R.LcRc4.out_state(_), b))) : B.Octets}
  %rc4_update_ref(R.rc4.after(B.Octets.to_list(a), st), b) : {R.LcRc4.out_data(R.LcRc4.update(st, B.Octets.append(a, b))) == B.Octets.append(B.Octets.of_list(R.rc4.xs(B.Octets.to_list(a), st)), R.LcRc4.out_data(_)) : B.Octets}
  %rc4_update_ref(st, B.Octets.append(a, b)) : {R.LcRc4.out_data(_) == B.Octets.append(B.Octets.of_list(R.rc4.xs(B.Octets.to_list(a), st)), B.Octets.of_list(R.rc4.xs(B.Octets.to_list(b), R.rc4.after(B.Octets.to_list(a), st)))) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(a, b)), B.append(B.Octets.to_list(a), B.Octets.to_list(b)), BL.octets_append_list(a, b)) : {B.Octets.of_list(R.rc4.xs(_, st)) == B.Octets.append(B.Octets.of_list(R.rc4.xs(B.Octets.to_list(a), st)), B.Octets.of_list(R.rc4.xs(B.Octets.to_list(b), R.rc4.after(B.Octets.to_list(a), st)))) : B.Octets}
  %Equal.sym(List<&2, U32>, R.rc4.xs(B.append(B.Octets.to_list(a), B.Octets.to_list(b)), st), B.append(R.rc4.xs(B.Octets.to_list(a), st), R.rc4.xs(B.Octets.to_list(b), R.rc4.after(B.Octets.to_list(a), st))), rc4_xs_append(B.Octets.to_list(a), B.Octets.to_list(b), st)) : {B.Octets.of_list(_) == B.Octets.append(B.Octets.of_list(R.rc4.xs(B.Octets.to_list(a), st)), B.Octets.of_list(R.rc4.xs(B.Octets.to_list(b), R.rc4.after(B.Octets.to_list(a), st)))) : B.Octets}
  octets_of_append(R.rc4.xs(B.Octets.to_list(a), st), R.rc4.xs(B.Octets.to_list(b), R.rc4.after(B.Octets.to_list(a), st)))

# 64-bit blocks as bytes (blk_bytes and blk8 above)

def Laws.block64_octets_round_trip(b):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(L.lc.block_bytes(b, Nil{}))), B.mask(L.lc.block_bytes(b, Nil{})), BL.octets_to_of(L.lc.block_bytes(b, Nil{}))) : {L.lc.block_of(_) == Some{b} : Maybe<&2, L.LcBlock64>}
  blk_bytes(b)

# the bytes of the blocks bs in front of ys, structurally
def m64_joins(bs: List<&2, L.LcBlock64>, ys: List<&2, U32>) -> List<&2, U32>:
  match bs:
    case Nil{}:
      ys
    case Con{b, t}:
      L.lc.block_bytes(b, m64_joins(t, ys))

def m64_join_rev(bs: List<&2, L.LcBlock64>, +zs: List<&2, L.LcBlock64>, +ys: List<&2, U32>) -> {X.m64.join(zs, m64_joins(bs, ys)) == X.m64.join(X.m64.rev_onto(bs, zs), ys) : List<&2, U32>}:
  match bs:
    case Nil{}:
      {==}
    case Con{b, t}:
      m64_join_rev(t, Con{b, zs}, ys)

def m64_split_joins(bs: List<&2, L.LcBlock64>, +acc: List<&2, L.LcBlock64>) -> {X.m64.split(B.mask(m64_joins(bs, Nil{})), acc) == Some{X.m64.rev_onto(acc, bs)} : Maybe<&2, List<&2, L.LcBlock64>>}:
  match bs:
    case Nil{}:
      {==}
    case Con{L.LcBlock64{+hi, +lo}, +t}:
      %blk8(hi, lo) : {X.m64.split(B.mask(m64_joins(t, Nil{})), Con{_, acc}) == Some{X.m64.rev_onto(acc, Con{L.LcBlock64{hi, lo}, t})} : Maybe<&2, List<&2, L.LcBlock64>>}
      m64_split_joins(t, Con{L.LcBlock64{hi, lo}, acc})

def Laws.blocks64_octets_round_trip(bs):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(X.m64.join(X.m64.rev_onto(bs, Nil{}), Nil{}))), B.mask(X.m64.join(X.m64.rev_onto(bs, Nil{}), Nil{})), BL.octets_to_of(X.m64.join(X.m64.rev_onto(bs, Nil{}), Nil{}))) : {X.m64.blocks(B.Octets.len(X.Lc64.octets_of(bs)), X.m64.split(_, Nil{})) == Done{bs} : Result<&2, &2, L.LcError, List<&2, L.LcBlock64>>}
  %m64_join_rev(bs, Nil{}, Nil{}) : {X.m64.blocks(B.Octets.len(X.Lc64.octets_of(bs)), X.m64.split(B.mask(_), Nil{})) == Done{bs} : Result<&2, &2, L.LcError, List<&2, L.LcBlock64>>}
  %Equal.sym(Maybe<&2, List<&2, L.LcBlock64>>, X.m64.split(B.mask(m64_joins(bs, Nil{})), Nil{}), Some{X.m64.rev_onto(Nil{}, bs)}, m64_split_joins(bs, Nil{})) : {X.m64.blocks(B.Octets.len(X.Lc64.octets_of(bs)), _) == Done{bs} : Result<&2, &2, L.LcError, List<&2, L.LcBlock64>>}
  {==}

# The modes: the tail-recursive loops are the structural forms; then XOR and
# decryption undo each block, for any cipher whose decryption undoes its
# encryption (for DES and 3DES, by their laws)

def bool_xx2(a: Bool, b: Bool) -> {b == Bool.xor(a, Bool.xor(a, b)) : Bool}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def word_xx2(n: Nat, a: Word(n), b: Word(n)) -> {b == Word.xor(n, a, Word.xor(n, a, b)) : Word(n)}:
  match n:
    case 0n:
      match a b:
        case WNil{} WNil{}:
          {==}
    case 1n+p:
      match a b:
        case WCon{ah, at} WCon{bh, bt}:
          %bool_xx2(ah, bh) : {WCon{bh, bt} == WCon{_, Word.xor(p, at, Word.xor(p, at, bt))} : Word(1n+p)}
          %word_xx2(p, at, bt) : {WCon{bh, bt} == WCon{bh, _} : Word(1n+p)}
          {==}

def u32_xx2(a: U32, b: U32) -> {b == U32.xor(a, U32.xor(a, b)) : U32}:
  match a b:
    case U32{x} U32{y}:
      %word_xx2(32n, x, y) : {U32{y} == U32{_} : U32}
      {==}

def b64_xx2(a: L.LcBlock64, b: L.LcBlock64) -> {b == L.LcBlock64.xor(a, L.LcBlock64.xor(a, b)) : L.LcBlock64}:
  match a b:
    case L.LcBlock64{+a0, +a1} L.LcBlock64{+b0, +b1}:
      %u32_xx2(a0, b0) : {L.LcBlock64{b0, b1} == L.LcBlock64{_, U32.xor(a1, U32.xor(a1, b1))} : L.LcBlock64}
      %u32_xx2(a1, b1) : {L.LcBlock64{b0, b1} == L.LcBlock64{b0, _} : L.LcBlock64}
      {==}

def ecb_ref(~K: Data, ~f: K -> L.LcBlock64 -> L.LcBlock64, +k: K, bs: List<&2, L.LcBlock64>, +acc: List<&2, L.LcBlock64>) -> {X.m64.ecb.go(~K, ~f, k, bs, acc) == X.m64.rev_onto(acc, X.m64.ecb(~K, ~f, k, bs)) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{b, t}:
      ecb_ref(~K, ~f, k, t, Con{f(k, b), acc})

def cbc_enc_ref(~K: Data, ~enc: K -> L.LcBlock64 -> L.LcBlock64, +k: K, bs: List<&2, L.LcBlock64>, +iv: L.LcBlock64, +acc: List<&2, L.LcBlock64>) -> {X.m64.cbc.enc.go(~K, ~enc, k, bs, iv, acc) == X.m64.rev_onto(acc, X.m64.cbc.enc(~K, ~enc, k, bs, iv)) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+p, t}:
      cbc_enc_ref(~K, ~enc, k, t, enc(k, L.LcBlock64.xor(iv, p)), Con{enc(k, L.LcBlock64.xor(iv, p)), acc})

def cbc_dec_ref(~K: Data, ~dec: K -> L.LcBlock64 -> L.LcBlock64, +k: K, bs: List<&2, L.LcBlock64>, +iv: L.LcBlock64, +acc: List<&2, L.LcBlock64>) -> {X.m64.cbc.dec.go(~K, ~dec, k, bs, iv, acc) == X.m64.rev_onto(acc, X.m64.cbc.dec(~K, ~dec, k, bs, iv)) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+c, t}:
      cbc_dec_ref(~K, ~dec, k, t, c, Con{L.LcBlock64.xor(iv, dec(k, c)), acc})

def tdes_rt(k: T.LcTdesKey, +b: L.LcBlock64) -> {b == T.LcTdes.decrypt(k, T.LcTdes.encrypt(k, b)) : L.LcBlock64}:
  Equal.sym(L.LcBlock64, T.LcTdes.decrypt(k, T.LcTdes.encrypt(k, b)), b, Laws.tdes_round_trip(k, b))

def ecb_rt_des(+k: D.LcDesKey, bs: List<&2, L.LcBlock64>) -> {bs == X.m64.ecb(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, bs)) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+b, +t}:
      %des_rt(k, b) : {Con{b, t} == Con{_, X.m64.ecb(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, t))} : List<&2, L.LcBlock64>}
      %ecb_rt_des(k, t) : {Con{b, t} == Con{b, _} : List<&2, L.LcBlock64>}
      {==}

def cbc_rt_des(+k: D.LcDesKey, bs: List<&2, L.LcBlock64>, +iv: L.LcBlock64) -> {bs == X.m64.cbc.dec(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv), iv) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+p, +t}:
      %des_rt(k, L.LcBlock64.xor(iv, p)) : {Con{p, t} == Con{L.LcBlock64.xor(iv, _), X.m64.cbc.dec(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, t, D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p))), D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p)))} : List<&2, L.LcBlock64>}
      %b64_xx2(iv, p) : {Con{p, t} == Con{_, X.m64.cbc.dec(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, t, D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p))), D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p)))} : List<&2, L.LcBlock64>}
      %cbc_rt_des(k, t, D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p))) : {Con{p, t} == Con{p, _} : List<&2, L.LcBlock64>}
      {==}

# the public block layers, through the structural forms
def ecb_blocks_rt_des(+k: D.LcDesKey, +bs: List<&2, L.LcBlock64>) -> {X.Lc64.ecb_decrypt_blocks(~D.LcDesKey, ~D.LcDes.decrypt, k, X.Lc64.ecb_encrypt_blocks(~D.LcDesKey, ~D.LcDes.encrypt, k, bs)) == bs : List<&2, L.LcBlock64>}:
  %Equal.sym(List<&2, L.LcBlock64>, X.m64.ecb.go(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, Nil{}), X.m64.rev_onto(Nil{}, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, bs)), ecb_ref(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, Nil{})) : {X.m64.ecb.go(~D.LcDesKey, ~D.LcDes.decrypt, k, _, Nil{}) == bs : List<&2, L.LcBlock64>}
  %Equal.sym(List<&2, L.LcBlock64>, X.m64.ecb.go(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, bs), Nil{}), X.m64.rev_onto(Nil{}, X.m64.ecb(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, bs))), ecb_ref(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, bs), Nil{})) : {_ == bs : List<&2, L.LcBlock64>}
  Equal.sym(List<&2, L.LcBlock64>, bs, X.m64.ecb(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, bs)), ecb_rt_des(k, bs))

def cbc_blocks_rt_des(+k: D.LcDesKey, +iv: L.LcBlock64, +bs: List<&2, L.LcBlock64>) -> {X.Lc64.cbc_decrypt_blocks(~D.LcDesKey, ~D.LcDes.decrypt, k, iv, X.Lc64.cbc_encrypt_blocks(~D.LcDesKey, ~D.LcDes.encrypt, k, iv, bs)) == bs : List<&2, L.LcBlock64>}:
  %Equal.sym(List<&2, L.LcBlock64>, X.m64.cbc.enc.go(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv, Nil{}), X.m64.rev_onto(Nil{}, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv)), cbc_enc_ref(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv, Nil{})) : {X.m64.cbc.dec.go(~D.LcDesKey, ~D.LcDes.decrypt, k, _, iv, Nil{}) == bs : List<&2, L.LcBlock64>}
  %Equal.sym(List<&2, L.LcBlock64>, X.m64.cbc.dec.go(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv), iv, Nil{}), X.m64.rev_onto(Nil{}, X.m64.cbc.dec(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv), iv)), cbc_dec_ref(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv), iv, Nil{})) : {_ == bs : List<&2, L.LcBlock64>}
  Equal.sym(List<&2, L.LcBlock64>, bs, X.m64.cbc.dec(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv), iv), cbc_rt_des(k, bs, iv))

def ecb_rt_tdes(+k: T.LcTdesKey, bs: List<&2, L.LcBlock64>) -> {bs == X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs)) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+b, +t}:
      %tdes_rt(k, b) : {Con{b, t} == Con{_, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.encrypt, k, t))} : List<&2, L.LcBlock64>}
      %ecb_rt_tdes(k, t) : {Con{b, t} == Con{b, _} : List<&2, L.LcBlock64>}
      {==}

def cbc_rt_tdes(+k: T.LcTdesKey, bs: List<&2, L.LcBlock64>, +iv: L.LcBlock64) -> {bs == X.m64.cbc.dec(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.cbc.enc(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, iv), iv) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+p, +t}:
      %tdes_rt(k, L.LcBlock64.xor(iv, p)) : {Con{p, t} == Con{L.LcBlock64.xor(iv, _), X.m64.cbc.dec(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.cbc.enc(~T.LcTdesKey, ~T.LcTdes.encrypt, k, t, T.LcTdes.encrypt(k, L.LcBlock64.xor(iv, p))), T.LcTdes.encrypt(k, L.LcBlock64.xor(iv, p)))} : List<&2, L.LcBlock64>}
      %b64_xx2(iv, p) : {Con{p, t} == Con{_, X.m64.cbc.dec(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.cbc.enc(~T.LcTdesKey, ~T.LcTdes.encrypt, k, t, T.LcTdes.encrypt(k, L.LcBlock64.xor(iv, p))), T.LcTdes.encrypt(k, L.LcBlock64.xor(iv, p)))} : List<&2, L.LcBlock64>}
      %cbc_rt_tdes(k, t, T.LcTdes.encrypt(k, L.LcBlock64.xor(iv, p))) : {Con{p, t} == Con{p, _} : List<&2, L.LcBlock64>}
      {==}

# the public block layers, through the structural forms
def ecb_blocks_rt_tdes(+k: T.LcTdesKey, +bs: List<&2, L.LcBlock64>) -> {X.Lc64.ecb_decrypt_blocks(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.Lc64.ecb_encrypt_blocks(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs)) == bs : List<&2, L.LcBlock64>}:
  %Equal.sym(List<&2, L.LcBlock64>, X.m64.ecb.go(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, Nil{}), X.m64.rev_onto(Nil{}, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs)), ecb_ref(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, Nil{})) : {X.m64.ecb.go(~T.LcTdesKey, ~T.LcTdes.decrypt, k, _, Nil{}) == bs : List<&2, L.LcBlock64>}
  %Equal.sym(List<&2, L.LcBlock64>, X.m64.ecb.go(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs), Nil{}), X.m64.rev_onto(Nil{}, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs))), ecb_ref(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs), Nil{})) : {_ == bs : List<&2, L.LcBlock64>}
  Equal.sym(List<&2, L.LcBlock64>, bs, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs)), ecb_rt_tdes(k, bs))

def cbc_blocks_rt_tdes(+k: T.LcTdesKey, +iv: L.LcBlock64, +bs: List<&2, L.LcBlock64>) -> {X.Lc64.cbc_decrypt_blocks(~T.LcTdesKey, ~T.LcTdes.decrypt, k, iv, X.Lc64.cbc_encrypt_blocks(~T.LcTdesKey, ~T.LcTdes.encrypt, k, iv, bs)) == bs : List<&2, L.LcBlock64>}:
  %Equal.sym(List<&2, L.LcBlock64>, X.m64.cbc.enc.go(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, iv, Nil{}), X.m64.rev_onto(Nil{}, X.m64.cbc.enc(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, iv)), cbc_enc_ref(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, iv, Nil{})) : {X.m64.cbc.dec.go(~T.LcTdesKey, ~T.LcTdes.decrypt, k, _, iv, Nil{}) == bs : List<&2, L.LcBlock64>}
  %Equal.sym(List<&2, L.LcBlock64>, X.m64.cbc.dec.go(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.cbc.enc(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, iv), iv, Nil{}), X.m64.rev_onto(Nil{}, X.m64.cbc.dec(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.cbc.enc(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, iv), iv)), cbc_dec_ref(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.cbc.enc(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, iv), iv, Nil{})) : {_ == bs : List<&2, L.LcBlock64>}
  Equal.sym(List<&2, L.LcBlock64>, bs, X.m64.cbc.dec(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.cbc.enc(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, iv), iv), cbc_rt_tdes(k, bs, iv))

def Laws.des_ecb_round_trip(k, bs):
  ecb_blocks_rt_des(k, bs)

def Laws.des_cbc_round_trip(k, iv, bs):
  cbc_blocks_rt_des(k, iv, bs)

def Laws.tdes_ecb_round_trip(k, bs):
  ecb_blocks_rt_tdes(k, bs)

def Laws.tdes_cbc_round_trip(k, iv, bs):
  cbc_blocks_rt_tdes(k, iv, bs)

# The byte layers, on the bytes of whole blocks under the bytes of an IV

def cbc_enc_ok(~K: Data, ~enc: K -> L.LcBlock64 -> L.LcBlock64, +k: K, +iv: L.LcBlock64, +bs: List<&2, L.LcBlock64>) -> {X.Lc64.cbc_encrypt(~K, ~enc, k, L.LcBlock64.to_octets(iv), X.Lc64.octets_of(bs)) == Done{X.Lc64.octets_of(X.Lc64.cbc_encrypt_blocks(~K, ~enc, k, iv, bs))} : Result<&2, &2, L.LcError, B.Octets>}:
  %Equal.sym(Maybe<&2, L.LcBlock64>, L.LcBlock64.of_octets(L.LcBlock64.to_octets(iv)), Some{iv}, Laws.block64_octets_round_trip(iv)) : {X.m64.cbc.e1(~K, ~enc, k, X.m64.iv(_, B.Octets.len(L.LcBlock64.to_octets(iv))), X.Lc64.octets_of(bs)) == Done{X.Lc64.octets_of(X.Lc64.cbc_encrypt_blocks(~K, ~enc, k, iv, bs))} : Result<&2, &2, L.LcError, B.Octets>}
  %Equal.sym(Result<&2, &2, L.LcError, List<&2, L.LcBlock64>>, X.Lc64.blocks_of(X.Lc64.octets_of(bs)), Done{bs}, Laws.blocks64_octets_round_trip(bs)) : {X.m64.cbc.e2(~K, ~enc, k, iv, _) == Done{X.Lc64.octets_of(X.Lc64.cbc_encrypt_blocks(~K, ~enc, k, iv, bs))} : Result<&2, &2, L.LcError, B.Octets>}
  {==}

def cbc_dec_ok(~K: Data, ~dec: K -> L.LcBlock64 -> L.LcBlock64, +k: K, +iv: L.LcBlock64, +bs: List<&2, L.LcBlock64>) -> {X.Lc64.cbc_decrypt(~K, ~dec, k, L.LcBlock64.to_octets(iv), X.Lc64.octets_of(bs)) == Done{X.Lc64.octets_of(X.Lc64.cbc_decrypt_blocks(~K, ~dec, k, iv, bs))} : Result<&2, &2, L.LcError, B.Octets>}:
  %Equal.sym(Maybe<&2, L.LcBlock64>, L.LcBlock64.of_octets(L.LcBlock64.to_octets(iv)), Some{iv}, Laws.block64_octets_round_trip(iv)) : {X.m64.cbc.d1(~K, ~dec, k, X.m64.iv(_, B.Octets.len(L.LcBlock64.to_octets(iv))), X.Lc64.octets_of(bs)) == Done{X.Lc64.octets_of(X.Lc64.cbc_decrypt_blocks(~K, ~dec, k, iv, bs))} : Result<&2, &2, L.LcError, B.Octets>}
  %Equal.sym(Result<&2, &2, L.LcError, List<&2, L.LcBlock64>>, X.Lc64.blocks_of(X.Lc64.octets_of(bs)), Done{bs}, Laws.blocks64_octets_round_trip(bs)) : {X.m64.cbc.d2(~K, ~dec, k, iv, _) == Done{X.Lc64.octets_of(X.Lc64.cbc_decrypt_blocks(~K, ~dec, k, iv, bs))} : Result<&2, &2, L.LcError, B.Octets>}
  {==}

def ecb_enc_ok(~K: Data, ~f: K -> L.LcBlock64 -> L.LcBlock64, +k: K, +bs: List<&2, L.LcBlock64>) -> {Result.map(&2, &2, L.LcError, List<&2, L.LcBlock64>, B.Octets, xs => X.Lc64.octets_of(X.Lc64.ecb_encrypt_blocks(~K, ~f, k, xs)), X.Lc64.blocks_of(X.Lc64.octets_of(bs))) == Done{X.Lc64.octets_of(X.Lc64.ecb_encrypt_blocks(~K, ~f, k, bs))} : Result<&2, &2, L.LcError, B.Octets>}:
  %Equal.sym(Result<&2, &2, L.LcError, List<&2, L.LcBlock64>>, X.Lc64.blocks_of(X.Lc64.octets_of(bs)), Done{bs}, Laws.blocks64_octets_round_trip(bs)) : {Result.map(&2, &2, L.LcError, List<&2, L.LcBlock64>, B.Octets, xs => X.Lc64.octets_of(X.Lc64.ecb_encrypt_blocks(~K, ~f, k, xs)), _) == Done{X.Lc64.octets_of(X.Lc64.ecb_encrypt_blocks(~K, ~f, k, bs))} : Result<&2, &2, L.LcError, B.Octets>}
  {==}

def ecb_dec_ok(~K: Data, ~f: K -> L.LcBlock64 -> L.LcBlock64, +k: K, +bs: List<&2, L.LcBlock64>) -> {Result.map(&2, &2, L.LcError, List<&2, L.LcBlock64>, B.Octets, xs => X.Lc64.octets_of(X.Lc64.ecb_decrypt_blocks(~K, ~f, k, xs)), X.Lc64.blocks_of(X.Lc64.octets_of(bs))) == Done{X.Lc64.octets_of(X.Lc64.ecb_decrypt_blocks(~K, ~f, k, bs))} : Result<&2, &2, L.LcError, B.Octets>}:
  %Equal.sym(Result<&2, &2, L.LcError, List<&2, L.LcBlock64>>, X.Lc64.blocks_of(X.Lc64.octets_of(bs)), Done{bs}, Laws.blocks64_octets_round_trip(bs)) : {Result.map(&2, &2, L.LcError, List<&2, L.LcBlock64>, B.Octets, xs => X.Lc64.octets_of(X.Lc64.ecb_decrypt_blocks(~K, ~f, k, xs)), _) == Done{X.Lc64.octets_of(X.Lc64.ecb_decrypt_blocks(~K, ~f, k, bs))} : Result<&2, &2, L.LcError, B.Octets>}
  {==}

def Laws.des_cbc_octets_round_trip(k, iv, bs):
  %Equal.sym(Result<&2, &2, L.LcError, B.Octets>, X.Lc64.cbc_encrypt(~D.LcDesKey, ~D.LcDes.encrypt, k, L.LcBlock64.to_octets(iv), X.Lc64.octets_of(bs)), Done{X.Lc64.octets_of(X.Lc64.cbc_encrypt_blocks(~D.LcDesKey, ~D.LcDes.encrypt, k, iv, bs))}, cbc_enc_ok(~D.LcDesKey, ~D.LcDes.encrypt, k, iv, bs)) : {Result.bind(&2, &2, L.LcError, B.Octets, B.Octets, _, c => X.Lc64.cbc_decrypt(~D.LcDesKey, ~D.LcDes.decrypt, k, L.LcBlock64.to_octets(iv), c)) == Done{X.Lc64.octets_of(bs)} : Result<&2, &2, L.LcError, B.Octets>}
  %Equal.sym(Result<&2, &2, L.LcError, B.Octets>, X.Lc64.cbc_decrypt(~D.LcDesKey, ~D.LcDes.decrypt, k, L.LcBlock64.to_octets(iv), X.Lc64.octets_of(X.Lc64.cbc_encrypt_blocks(~D.LcDesKey, ~D.LcDes.encrypt, k, iv, bs))), Done{X.Lc64.octets_of(X.Lc64.cbc_decrypt_blocks(~D.LcDesKey, ~D.LcDes.decrypt, k, iv, X.Lc64.cbc_encrypt_blocks(~D.LcDesKey, ~D.LcDes.encrypt, k, iv, bs)))}, cbc_dec_ok(~D.LcDesKey, ~D.LcDes.decrypt, k, iv, X.Lc64.cbc_encrypt_blocks(~D.LcDesKey, ~D.LcDes.encrypt, k, iv, bs))) : {_ == Done{X.Lc64.octets_of(bs)} : Result<&2, &2, L.LcError, B.Octets>}
  %Laws.des_cbc_round_trip(k, iv, bs) : {Done{X.Lc64.octets_of(X.Lc64.cbc_decrypt_blocks(~D.LcDesKey, ~D.LcDes.decrypt, k, iv, X.Lc64.cbc_encrypt_blocks(~D.LcDesKey, ~D.LcDes.encrypt, k, iv, bs)))} == Done{X.Lc64.octets_of(_)} : Result<&2, &2, L.LcError, B.Octets>}
  {==}

