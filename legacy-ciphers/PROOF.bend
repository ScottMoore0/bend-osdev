# Feistel rounds over any round function (legacy-ciphers.bend's lc.fe, for
# CAST-128 and FCrypt): a round is undone whatever f is, so a list of rounds
# is undone by its rounds undone in reverse order

def fe_unstep_step(~RK: Data, ~f: RK -> U32 -> U32, +k: RK, b: L.LcBlock64) -> {b == L.lc.fe.unstep(~RK, ~f, k, L.lc.fe.step(~RK, ~f, k, b)) : L.LcBlock64}:
  match b:
    case L.LcBlock64{l, +r}:
      %u32_xx(l, f(k, r)) : {L.LcBlock64{l, r} == L.LcBlock64{_, r} : L.LcBlock64}
      {==}

def fe_step_unstep(~RK: Data, ~f: RK -> U32 -> U32, +k: RK, b: L.LcBlock64) -> {b == L.lc.fe.step(~RK, ~f, k, L.lc.fe.unstep(~RK, ~f, k, b)) : L.LcBlock64}:
  match b:
    case L.LcBlock64{+l, r}:
      %u32_xx(r, f(k, l)) : {L.LcBlock64{l, r} == L.LcBlock64{l, _} : L.LcBlock64}
      {==}

def fe_unrun_run(~RK: Data, ~f: RK -> U32 -> U32, ks: List<&2, RK>, +b: L.LcBlock64) -> {b == L.lc.fe.unrun(~RK, ~f, ks, L.lc.fe.run(~RK, ~f, ks, b)) : L.LcBlock64}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +t}:
      %fe_unrun_run(~RK, ~f, t, L.lc.fe.step(~RK, ~f, k, b)) : {b == L.lc.fe.unstep(~RK, ~f, k, _) : L.LcBlock64}
      fe_unstep_step(~RK, ~f, k, b)

def fe_run_unrun(~RK: Data, ~f: RK -> U32 -> U32, ks: List<&2, RK>, +b: L.LcBlock64) -> {b == L.lc.fe.run(~RK, ~f, ks, L.lc.fe.unrun(~RK, ~f, ks, b)) : L.LcBlock64}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +t}:
      %fe_step_unstep(~RK, ~f, k, L.lc.fe.unrun(~RK, ~f, t, b)) : {b == L.lc.fe.run(~RK, ~f, t, _) : L.LcBlock64}
      fe_run_unrun(~RK, ~f, t, b)

def swap2(b: L.LcBlock64) -> {b == L.lc.swap(L.lc.swap(b)) : L.LcBlock64}:
  match b:
    case L.LcBlock64{h, l}:
      {==}

# FCrypt: its rounds, undone

def Laws.fcrypt_round_trip(k, b):
  match k:
    case FC.LcFcryptKey{+rks}:
      Equal.sym(L.LcBlock64, b, L.lc.fe.unrun(~FC.LcFcRk, ~FC.fc.f, rks, L.lc.fe.run(~FC.LcFcRk, ~FC.fc.f, rks, b)), fe_unrun_run(~FC.LcFcRk, ~FC.fc.f, rks, b))

def Laws.fcrypt_round_trip_dual(k, b):
  match k:
    case FC.LcFcryptKey{+rks}:
      Equal.sym(L.LcBlock64, b, L.lc.fe.run(~FC.LcFcRk, ~FC.fc.f, rks, L.lc.fe.unrun(~FC.LcFcRk, ~FC.fc.f, rks, b)), fe_run_unrun(~FC.LcFcRk, ~FC.fc.f, rks, b))

# CAST-128: its rounds, then the exchange of the halves, undone

def Laws.cast5_round_trip(k, b):
  match k:
    case C5.LcCast5Key{+rks}:
      %swap2(L.lc.fe.run(~C5.LcCast5Rk, ~C5.cast5.f, rks, b)) : {L.lc.fe.unrun(~C5.LcCast5Rk, ~C5.cast5.f, rks, _) == b : L.LcBlock64}
      Equal.sym(L.LcBlock64, b, L.lc.fe.unrun(~C5.LcCast5Rk, ~C5.cast5.f, rks, L.lc.fe.run(~C5.LcCast5Rk, ~C5.cast5.f, rks, b)), fe_unrun_run(~C5.LcCast5Rk, ~C5.cast5.f, rks, b))

def Laws.cast5_round_trip_dual(k, b):
  match k:
    case C5.LcCast5Key{+rks}:
      %fe_run_unrun(~C5.LcCast5Rk, ~C5.cast5.f, rks, L.lc.swap(b)) : {L.lc.swap(_) == b : L.LcBlock64}
      Equal.sym(L.LcBlock64, b, L.lc.swap(L.lc.swap(b)), swap2(b))

# TEA and XTEA: each step adds a function of one half to the other, undone
# by subtracting it (the "adc" lemmas below); the byte swaps undone by
# themselves

def tea_unop_op(o: TE.LcTeaOp, b: L.LcBlock64) -> {b == TE.tea.unop(o, TE.tea.op(o, b)) : L.LcBlock64}:
  match o:
    case TE.LcTeaY{+s, +ka, +kb}:
      match b:
        case L.LcBlock64{y, +z}:
          %u32_add_sub(y, TE.tea.g(z, s, ka, kb)) : {L.LcBlock64{y, z} == L.LcBlock64{_, z} : L.LcBlock64}
          {==}
    case TE.LcTeaZ{+s, +ka, +kb}:
      match b:
        case L.LcBlock64{+y, z}:
          %u32_add_sub(z, TE.tea.g(y, s, ka, kb)) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}
    case TE.LcXteaY{+c}:
      match b:
        case L.LcBlock64{y, +z}:
          %u32_add_sub(y, TE.xtea.g(z, c)) : {L.LcBlock64{y, z} == L.LcBlock64{_, z} : L.LcBlock64}
          {==}
    case TE.LcXteaZ{+c}:
      match b:
        case L.LcBlock64{+y, z}:
          %u32_add_sub(z, TE.xtea.g(y, c)) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}
    case TE.LcTeaBswap{}:
      match b:
        case L.LcBlock64{+y, +z}:
          %bswap2(y) : {L.LcBlock64{y, z} == L.LcBlock64{_, L.lc.bswap.bits(L.lc.bswap.bits(z))} : L.LcBlock64}
          %bswap2(z) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}

def tea_op_unop(o: TE.LcTeaOp, b: L.LcBlock64) -> {b == TE.tea.op(o, TE.tea.unop(o, b)) : L.LcBlock64}:
  match o:
    case TE.LcTeaY{+s, +ka, +kb}:
      match b:
        case L.LcBlock64{y, +z}:
          %u32_sub_add(y, TE.tea.g(z, s, ka, kb)) : {L.LcBlock64{y, z} == L.LcBlock64{_, z} : L.LcBlock64}
          {==}
    case TE.LcTeaZ{+s, +ka, +kb}:
      match b:
        case L.LcBlock64{+y, z}:
          %u32_sub_add(z, TE.tea.g(y, s, ka, kb)) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}
    case TE.LcXteaY{+c}:
      match b:
        case L.LcBlock64{y, +z}:
          %u32_sub_add(y, TE.xtea.g(z, c)) : {L.LcBlock64{y, z} == L.LcBlock64{_, z} : L.LcBlock64}
          {==}
    case TE.LcXteaZ{+c}:
      match b:
        case L.LcBlock64{+y, z}:
          %u32_sub_add(z, TE.xtea.g(y, c)) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}
    case TE.LcTeaBswap{}:
      match b:
        case L.LcBlock64{+y, +z}:
          %bswap2(y) : {L.LcBlock64{y, z} == L.LcBlock64{_, L.lc.bswap.bits(L.lc.bswap.bits(z))} : L.LcBlock64}
          %bswap2(z) : {L.LcBlock64{y, z} == L.LcBlock64{y, _} : L.LcBlock64}
          {==}

def tea_unrun_run(os: List<&2, TE.LcTeaOp>, +b: L.LcBlock64) -> {b == TE.tea.unrun(os, TE.tea.run(os, b)) : L.LcBlock64}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %tea_unrun_run(t, TE.tea.op(o, b)) : {b == TE.tea.unop(o, _) : L.LcBlock64}
      tea_unop_op(o, b)

def tea_run_unrun(os: List<&2, TE.LcTeaOp>, +b: L.LcBlock64) -> {b == TE.tea.run(os, TE.tea.unrun(os, b)) : L.LcBlock64}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %tea_op_unop(o, TE.tea.unrun(t, b)) : {b == TE.tea.run(t, _) : L.LcBlock64}
      tea_run_unrun(t, b)

def Laws.tea_round_trip(k, b):
  match k:
    case TE.LcTeaKey{+ops}:
      Equal.sym(L.LcBlock64, b, TE.tea.unrun(ops, TE.tea.run(ops, b)), tea_unrun_run(ops, b))

def Laws.tea_round_trip_dual(k, b):
  match k:
    case TE.LcTeaKey{+ops}:
      Equal.sym(L.LcBlock64, b, TE.tea.run(ops, TE.tea.unrun(ops, b)), tea_run_unrun(ops, b))

def Laws.xtea_round_trip(k, b):
  match k:
    case XT.LcXteaKey{+ops}:
      Equal.sym(L.LcBlock64, b, TE.tea.unrun(ops, TE.tea.run(ops, b)), tea_unrun_run(ops, b))

def Laws.xtea_round_trip_dual(k, b):
  match k:
    case XT.LcXteaKey{+ops}:
      Equal.sym(L.LcBlock64, b, TE.tea.run(ops, TE.tea.unrun(ops, b)), tea_run_unrun(ops, b))

# Blowfish: a round and the final step, each undone by XOR whatever F is

def bf_unop_op(o: BF.LcBfOp, b: L.LcBlock64) -> {b == BF.bf.unop(o, BF.bf.op(o, b)) : L.LcBlock64}:
  match o:
    case BF.LcBfRound{+p, +t}:
      match b:
        case L.LcBlock64{+l, +r}:
          %u32_xx(l, p) : {L.LcBlock64{l, r} == L.LcBlock64{_, U32.xor(U32.xor(r, BF.bf.f(t, U32.xor(l, p))), BF.bf.f(t, U32.xor(l, p)))} : L.LcBlock64}
          %u32_xx(r, BF.bf.f(t, U32.xor(l, p))) : {L.LcBlock64{l, r} == L.LcBlock64{l, _} : L.LcBlock64}
          {==}
    case BF.LcBfFinal{+p17, +p18}:
      match b:
        case L.LcBlock64{+l, +r}:
          %u32_xx(l, p17) : {L.LcBlock64{l, r} == L.LcBlock64{_, U32.xor(U32.xor(r, p18), p18)} : L.LcBlock64}
          %u32_xx(r, p18) : {L.LcBlock64{l, r} == L.LcBlock64{l, _} : L.LcBlock64}
          {==}

def bf_op_unop(o: BF.LcBfOp, b: L.LcBlock64) -> {b == BF.bf.op(o, BF.bf.unop(o, b)) : L.LcBlock64}:
  match o:
    case BF.LcBfRound{+p, +t}:
      match b:
        case L.LcBlock64{+x, +y}:
          %u32_xx(y, p) : {L.LcBlock64{x, y} == L.LcBlock64{U32.xor(U32.xor(x, BF.bf.f(t, y)), BF.bf.f(t, _)), _} : L.LcBlock64}
          %u32_xx(x, BF.bf.f(t, y)) : {L.LcBlock64{x, y} == L.LcBlock64{_, y} : L.LcBlock64}
          {==}
    case BF.LcBfFinal{+p17, +p18}:
      match b:
        case L.LcBlock64{+x, +y}:
          %u32_xx(x, p18) : {L.LcBlock64{x, y} == L.LcBlock64{_, U32.xor(U32.xor(y, p17), p17)} : L.LcBlock64}
          %u32_xx(y, p17) : {L.LcBlock64{x, y} == L.LcBlock64{x, _} : L.LcBlock64}
          {==}

def bf_unrun_run(os: List<&2, BF.LcBfOp>, +b: L.LcBlock64) -> {b == BF.bf.unrun(os, BF.bf.run(os, b)) : L.LcBlock64}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %bf_unrun_run(t, BF.bf.op(o, b)) : {b == BF.bf.unop(o, _) : L.LcBlock64}
      bf_unop_op(o, b)

def bf_run_unrun(os: List<&2, BF.LcBfOp>, +b: L.LcBlock64) -> {b == BF.bf.run(os, BF.bf.unrun(os, b)) : L.LcBlock64}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %bf_op_unop(o, BF.bf.unrun(t, b)) : {b == BF.bf.run(t, _) : L.LcBlock64}
      bf_run_unrun(t, b)

def Laws.blowfish_round_trip(k, b):
  match k:
    case BF.LcBlowfishKey{+ops}:
      Equal.sym(L.LcBlock64, b, BF.bf.unrun(ops, BF.bf.run(ops, b)), bf_unrun_run(ops, b))

def Laws.blowfish_round_trip_dual(k, b):
  match k:
    case BF.LcBlowfishKey{+ops}:
      Equal.sym(L.LcBlock64, b, BF.bf.run(ops, BF.bf.unrun(ops, b)), bf_run_unrun(ops, b))

# CAST-256: each step of a quad-round is undone by itself, so QBAR undoes Q
# and Q undoes QBAR

def c6_sc2(k: C6.LcCast6Ks, s: M.CmBlock) -> {s == C6.c6.sc(k, C6.c6.sc(k, s)) : M.CmBlock}:
  match k:
    case C6.LcCast6Ks{+m0, +m1, +m2, +m3, +r0, +r1, +r2, +r3, +t}:
      match s:
        case M.CmBlock{a, b, c, +d}:
          %u32_xx(c, C5.cast.f(C5.LcCastF1{}, t, d, m0, r0)) : {M.CmBlock{a, b, c, d} == M.CmBlock{a, b, _, d} : M.CmBlock}
          {==}

def c6_sb2(k: C6.LcCast6Ks, s: M.CmBlock) -> {s == C6.c6.sb(k, C6.c6.sb(k, s)) : M.CmBlock}:
  match k:
    case C6.LcCast6Ks{+m0, +m1, +m2, +m3, +r0, +r1, +r2, +r3, +t}:
      match s:
        case M.CmBlock{a, b, +c, d}:
          %u32_xx(b, C5.cast.f(C5.LcCastF2{}, t, c, m1, r1)) : {M.CmBlock{a, b, c, d} == M.CmBlock{a, _, c, d} : M.CmBlock}
          {==}

def c6_sa2(k: C6.LcCast6Ks, s: M.CmBlock) -> {s == C6.c6.sa(k, C6.c6.sa(k, s)) : M.CmBlock}:
  match k:
    case C6.LcCast6Ks{+m0, +m1, +m2, +m3, +r0, +r1, +r2, +r3, +t}:
      match s:
        case M.CmBlock{a, +b, c, d}:
          %u32_xx(a, C5.cast.f(C5.LcCastF3{}, t, b, m2, r2)) : {M.CmBlock{a, b, c, d} == M.CmBlock{_, b, c, d} : M.CmBlock}
          {==}

def c6_sd2(k: C6.LcCast6Ks, s: M.CmBlock) -> {s == C6.c6.sd(k, C6.c6.sd(k, s)) : M.CmBlock}:
  match k:
    case C6.LcCast6Ks{+m0, +m1, +m2, +m3, +r0, +r1, +r2, +r3, +t}:
      match s:
        case M.CmBlock{+a, b, c, d}:
          %u32_xx(d, C5.cast.f(C5.LcCastF1{}, t, a, m3, r3)) : {M.CmBlock{a, b, c, d} == M.CmBlock{a, b, c, _} : M.CmBlock}
          {==}

def c6_qq(+k: C6.LcCast6Ks, +s: M.CmBlock) -> {s == C6.c6.qbar(k, C6.c6.q(k, s)) : M.CmBlock}:
  %c6_sd2(k, C6.c6.sa(k, C6.c6.sb(k, C6.c6.sc(k, s)))) : {s == C6.c6.sc(k, C6.c6.sb(k, C6.c6.sa(k, _))) : M.CmBlock}
  %c6_sa2(k, C6.c6.sb(k, C6.c6.sc(k, s))) : {s == C6.c6.sc(k, C6.c6.sb(k, _)) : M.CmBlock}
  %c6_sb2(k, C6.c6.sc(k, s)) : {s == C6.c6.sc(k, _) : M.CmBlock}
  c6_sc2(k, s)

def c6_qbq(+k: C6.LcCast6Ks, +s: M.CmBlock) -> {s == C6.c6.q(k, C6.c6.qbar(k, s)) : M.CmBlock}:
  %c6_sc2(k, C6.c6.sb(k, C6.c6.sa(k, C6.c6.sd(k, s)))) : {s == C6.c6.sd(k, C6.c6.sa(k, C6.c6.sb(k, _))) : M.CmBlock}
  %c6_sb2(k, C6.c6.sa(k, C6.c6.sd(k, s))) : {s == C6.c6.sd(k, C6.c6.sa(k, _)) : M.CmBlock}
  %c6_sa2(k, C6.c6.sd(k, s)) : {s == C6.c6.sd(k, _) : M.CmBlock}
  c6_sd2(k, s)

def c6_unop_op(o: C6.LcCast6Op, +s: M.CmBlock) -> {s == C6.c6.unop(o, C6.c6.op(o, s)) : M.CmBlock}:
  match o:
    case C6.LcCast6Op{fwd, +k}:
      match fwd:
        case True{}:
          c6_qq(k, s)
        case False{}:
          c6_qbq(k, s)

def c6_op_unop(o: C6.LcCast6Op, +s: M.CmBlock) -> {s == C6.c6.op(o, C6.c6.unop(o, s)) : M.CmBlock}:
  match o:
    case C6.LcCast6Op{fwd, +k}:
      match fwd:
        case True{}:
          c6_qbq(k, s)
        case False{}:
          c6_qq(k, s)

def c6_unrun_run(os: List<&2, C6.LcCast6Op>, +s: M.CmBlock) -> {s == C6.c6.unrun(os, C6.c6.run(os, s)) : M.CmBlock}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %c6_unrun_run(t, C6.c6.op(o, s)) : {s == C6.c6.unop(o, _) : M.CmBlock}
      c6_unop_op(o, s)

def c6_run_unrun(os: List<&2, C6.LcCast6Op>, +s: M.CmBlock) -> {s == C6.c6.run(os, C6.c6.unrun(os, s)) : M.CmBlock}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      %c6_op_unop(o, C6.c6.unrun(t, s)) : {s == C6.c6.run(t, _) : M.CmBlock}
      c6_run_unrun(t, s)

def Laws.cast6_round_trip(k, b):
  match k:
    case C6.LcCast6Key{+ops}:
      Equal.sym(M.CmBlock, b, C6.c6.unrun(ops, C6.c6.run(ops, b)), c6_unrun_run(ops, b))

def Laws.cast6_round_trip_dual(k, b):
  match k:
    case C6.LcCast6Key{+ops}:
      Equal.sym(M.CmBlock, b, C6.c6.run(ops, C6.c6.unrun(ops, b)), c6_run_unrun(ops, b))

