# the first j steps undone, last first, and the reverse
def aria_d0(s: A.LcAriaSt) -> {s == A.aria.u0(A.aria.d0(s)) : A.LcAriaSt}:
  {==}

def aria_dd0(s: A.LcAriaSt) -> {s == A.aria.d0(A.aria.u0(s)) : A.LcAriaSt}:
  {==}

def aria_d1(+s: A.LcAriaSt) -> {s == A.aria.u1(A.aria.d1(s)) : A.LcAriaSt}:
  %aria_e0(A.aria.d0(s)) : {s == A.aria.u0(_) : A.LcAriaSt}
  aria_d0(s)

def aria_dd1(+s: A.LcAriaSt) -> {s == A.aria.d1(A.aria.u1(s)) : A.LcAriaSt}:
  %aria_dd0(A.aria.e0(s)) : {s == A.aria.e0(_) : A.LcAriaSt}
  aria_e0(s)

def aria_d2(+s: A.LcAriaSt) -> {s == A.aria.u2(A.aria.d2(s)) : A.LcAriaSt}:
  %aria_e1(A.aria.d1(s)) : {s == A.aria.u1(_) : A.LcAriaSt}
  aria_d1(s)

def aria_dd2(+s: A.LcAriaSt) -> {s == A.aria.d2(A.aria.u2(s)) : A.LcAriaSt}:
  %aria_dd1(A.aria.e1(s)) : {s == A.aria.e1(_) : A.LcAriaSt}
