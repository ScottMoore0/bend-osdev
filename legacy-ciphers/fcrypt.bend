# The four S-boxes, built once per key (internal)
type LcFcTabs is Data:
  LcFcTabs{s0: L.LcTab, s1: L.LcTab, s2: L.LcTab, s3: L.LcTab}

def fc.tables() -> LcFcTabs:
  LcFcTabs{L.lc.tab(8n, fc.s0.list()), L.lc.tab(8n, fc.s1.list()), L.lc.tab(8n, fc.s2.list()), L.lc.tab(8n, fc.s3.list())}

# A round key: W_i and the S-boxes (internal)
type LcFcRk is Data:
  LcFcRk{w: U32, t: LcFcTabs}

# F(R, W_i)
def fc.f(k: LcFcRk, r: U32) -> U32:
  match k:
    case LcFcRk{w, t}:
      match t:
        case LcFcTabs{s0, s1, s2, s3}:
          +x = U32.xor(r, w)
          L.lc.rotl(L.lc.be(L.lc.tab.get(8n, s0, L.lc.byte(x, 0n)), L.lc.tab.get(8n, s1, L.lc.byte(x, 1n)), L.lc.tab.get(8n, s3, L.lc.byte(x, 3n)), L.lc.tab.get(8n, s2, L.lc.byte(x, 2n))), 27n)

# The key schedule

# the 56-bit value of the key bytes xs (parity bits dropped), onto v
def fc.v(xs: List<&2, U32>, v: W.W64) -> W.W64:
  match xs:
    case Nil{}:
      v
    case Con{x, t}:
      fc.v(t, W.W64.or(W.W64.shl(v, 7n), W.W64.from_u32(U32.shrn(U32.and(255, x), 1n))))

# v rotated right by 11 within 56 bits
def fc.rot11(+v: W.W64) -> W.W64:
  W.W64.and(W.W64.or(W.W64.shr(v, 11n), W.W64.shl(v, 45n)), W.W64.from_parts(16777215, 4294967295))

def fc.rks(n: Nat, +t: LcFcTabs, +v: W.W64) -> List<&2, LcFcRk>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      Con{LcFcRk{W.W64.lo(v), t}, fc.rks(p, t, fc.rot11(v))}

# An FCrypt key: the sixteen round keys (opaque; built by LcFcrypt.key)
type LcFcryptKey is Data:
  LcFcryptKey{rks: List<&2, LcFcRk>}

def fc.key.pick(ok: Bool, +xs: List<&2, U32>) -> Result<&2, &2, L.LcError, LcFcryptKey>:
  match ok:
    case True{}:
      Done{LcFcryptKey{fc.rks(16n, fc.tables(), fc.v(xs, W.W64.zero()))}}
    case False{}:
      Fail{L.LcBadKeyLength{B.len(xs)}}

# The cipher

# an 8-byte key (the parity bits are ignored)
def LcFcrypt.key(o: B.Octets) -> Result<&2, &2, L.LcError, LcFcryptKey>:
  +xs = B.Octets.to_list(o)
  fc.key.pick(Nat.is_eq(B.len(xs), 8n), xs)

def LcFcrypt.encrypt(k: LcFcryptKey, b: L.LcBlock64) -> L.LcBlock64:
  match k:
    case LcFcryptKey{rks}:
      L.lc.fe.run(~LcFcRk, ~fc.f, rks, b)

def LcFcrypt.decrypt(k: LcFcryptKey, b: L.LcBlock64) -> L.LcBlock64:
  match k:
    case LcFcryptKey{rks}:
      L.lc.fe.unrun(~LcFcRk, ~fc.f, rks, b)
