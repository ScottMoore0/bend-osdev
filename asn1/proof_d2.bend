# v below 100: its two characters are digits and octets, and read back as v
def pk.d2(+v: Nat, +lt: {Nat.is_lt(v, 100n) == True{} : Bool}) -> {pk.d2f(v) == PkD2{True{}, True{}, True{}, True{}, v} : PkD2}:
  pk.d2_0(v, lt)
