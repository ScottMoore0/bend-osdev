# the leading identifier octet of a class, P/C bit and low bits (below 32)
# reads back as them
def ab.id1(c: T.Asn1Class, cons: Bool, +low: Nat, +lt: {Nat.is_lt(low, 32n) == True{} : Bool}) -> {T.a1.id1(U32.to_nat(Nu.a1.b(T.a1.id_octet(c, cons, low)))) == T.A1Id1{c, cons, low} : T.A1Id1}:
  match c cons:
    case T.Asn1Universal{} True{}:
      ab.i0_t_0(low, lt)
    case T.Asn1Universal{} False{}:
      ab.i0_f_0(low, lt)
    case T.Asn1Application{} True{}:
      ab.i1_t_0(low, lt)
    case T.Asn1Application{} False{}:
      ab.i1_f_0(low, lt)
    case T.Asn1Context{} True{}:
      ab.i2_t_0(low, lt)
    case T.Asn1Context{} False{}:
      ab.i2_f_0(low, lt)
    case T.Asn1Private{} True{}:
      ab.i3_t_0(low, lt)
    case T.Asn1Private{} False{}:
      ab.i3_f_0(low, lt)
