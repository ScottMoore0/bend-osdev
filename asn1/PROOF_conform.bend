          cf.or_l(Laws.asn1law.conf(D, Laws.Asn1LawOne{}, [a], [y]), Laws.asn1law.conf(1n+D, Laws.Asn1LawAny{}, rest, [y]), Equal.trans(Bool, Laws.asn1law.conf(D, Laws.Asn1LawOne{}, [a], [y]), Laws.asn1law.conf(D, Laws.Asn1LawOne{}, [s], [y]), True{}, Equal.cong(Sc.Asn1Schema, Bool, z => Laws.asn1law.conf(D, Laws.Asn1LawOne{}, [z], [y]), a, s, es), hx))
        case False{}:
