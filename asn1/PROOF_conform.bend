    case Nil{}:
      match es:
        case Nil{}:
          {==}
        case Con{+e, +t}:
          {==}
    case Con{+s, +rest}:
      match hit:
        case True{}:
          match es:
            case Con{+e, +t}:
              Equal.trans(List<&2, Sc.Asn1Schema>, cf.sch(cf.sl(Sc.a1.s.slot(Sc.A1Slot{s, Some{e}}, Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, t), t)))), Con{s, cf.sch(cf.sl(Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, t), t)))}, Con{s, rest}, cf.slot_sch(Sc.A1Slot{s, Some{e}}, Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, t), t)), Equal.cong(List<&2, Sc.Asn1Schema>, List<&2, Sc.Asn1Schema>, z => Con{s, z}, cf.sch(cf.sl(Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, t), t))), rest, cf.al(rest, Sc.a1.s.hit_head(rest, t), t)))
            case Nil{}:
              Equal.trans(List<&2, Sc.Asn1Schema>, cf.sch(cf.sl(Sc.a1.s.slot(Sc.A1Slot{s, None{}}, Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, Nil{}), Nil{})))), Con{s, cf.sch(cf.sl(Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, Nil{}), Nil{})))}, Con{s, rest}, cf.slot_sch(Sc.A1Slot{s, None{}}, Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, Nil{}), Nil{})), Equal.cong(List<&2, Sc.Asn1Schema>, List<&2, Sc.Asn1Schema>, z => Con{s, z}, cf.sch(cf.sl(Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, Nil{}), Nil{}))), rest, cf.al(rest, Sc.a1.s.hit_head(rest, Nil{}), Nil{})))
        case False{}:
          Equal.trans(List<&2, Sc.Asn1Schema>, cf.sch(cf.sl(Sc.a1.s.slot(Sc.A1Slot{s, None{}}, Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, es), es)))), Con{s, cf.sch(cf.sl(Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, es), es)))}, Con{s, rest}, cf.slot_sch(Sc.A1Slot{s, None{}}, Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, es), es)), Equal.cong(List<&2, Sc.Asn1Schema>, List<&2, Sc.Asn1Schema>, z => Con{s, z}, cf.sch(cf.sl(Sc.a1.s.align(rest, Sc.a1.s.hit_head(rest, es), es))), rest, cf.al(rest, Sc.a1.s.hit_head(rest, es), es)))

def cf.wo(+F: Nat, +a: Sc.A1Aligned, +ms: List<&2, Sc.Asn1Match>) -> {cf.w(F, Sc.a1.s.work_of(a), ms) == Laws.asn1law.conf(F, Laws.Asn1LawFields{}, cf.sch(cf.sl(a)), ms) : Bool}:
  match a:
    case Sc.A1Aligned{+xs, +ex}:
      {==}

def cf.seqw(+F: Nat, +fs: List<&2, Sc.Asn1Schema>, +xs: List<&2, A.Asn1Tlv>, +ms: List<&2, Sc.Asn1Match>, +h: {cf.w(F, Sc.a1.s.seq_work(fs, xs), ms) == True{} : Bool}) -> {Laws.asn1law.conf(F, Laws.Asn1LawFields{}, fs, ms) == True{} : Bool}:
