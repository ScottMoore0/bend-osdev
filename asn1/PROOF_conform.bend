# ---------------------------------------------------------------- what each answer must be

def cf.sch(+sl: List<&2, Sc.A1Slot>) -> List<&2, Sc.Asn1Schema>:
  match sl:
    case Nil{}:
      Nil{}
    case Con{+x, +t}:
      match x:
        case Sc.A1Slot{+s, +me}:
          Con{s, cf.sch(t)}

def cf.w(+F: Nat, +w: Sc.A1Work, +ms: List<&2, Sc.Asn1Match>) -> Bool:
  match w:
    case Sc.A1WNone{}:
      match ms:
        case Nil{}:
          True{}
        case Con{+x, +t}:
          False{}
    case Sc.A1WSlots{+sl, +ex}:
      Laws.asn1law.conf(F, Laws.Asn1LawFields{}, cf.sch(sl), ms)
    case Sc.A1WOne{+s, +e}:
      match ms:
        case Nil{}:
          False{}
        case Con{+x, +t}:
          match t:
            case Nil{}:
              Laws.asn1law.conf(F, Laws.Asn1LawOne{}, [s], [x])
            case Con{+y, +u}:
              False{}

def cf.r(+F: Nat, +w: Sc.A1Work, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>) -> Bool:
  match res:
    case Fail{+e}:
      True{}
    case Done{+ms}:
      cf.w(F, w, ms)

def cf.slot(+F: Nat, +s: Sc.Asn1Schema, +a: Result<&2, &2, E.Asn1Error, Sc.Asn1Match>) -> Bool:
  match a:
    case Fail{+e}:
      True{}
    case Done{+x}:
      Laws.asn1law.conf(F, Laws.Asn1LawOne{}, [s], [x])

# a match conforming to the schema inside an OPTIONAL or DEFAULT conforms
# to the field, with one more fuel
def cf.inner(+D: Nat, +s: Sc.Asn1Schema, +x: Sc.Asn1Match, +h: {Laws.asn1law.conf(D, Laws.Asn1LawOne{}, [Sc.a1.s.inner(s)], [x]) == True{} : Bool}) -> {Laws.asn1law.conf(1n+D, Laws.Asn1LawOne{}, [s], [x]) == True{} : Bool}:
  match s:
    case Sc.Asn1SAny{}:
      cf.mono(D, Laws.Asn1LawOne{}, [Sc.Asn1SAny{}], [x], h)
    case Sc.Asn1SElem{+t}:
      cf.mono(D, Laws.Asn1LawOne{}, [Sc.Asn1SElem{t}], [x], h)
    case Sc.Asn1SSeq{+t, +fs}:
      cf.mono(D, Laws.Asn1LawOne{}, [Sc.Asn1SSeq{t, fs}], [x], h)
    case Sc.Asn1SOf{+t, +item, +set}:
      cf.mono(D, Laws.Asn1LawOne{}, [Sc.Asn1SOf{t, item, set}], [x], h)
    case Sc.Asn1SChoice{+alts}:
      cf.mono(D, Laws.Asn1LawOne{}, [Sc.Asn1SChoice{alts}], [x], h)
    case Sc.Asn1SExplicit{+num, +inner}:
      cf.mono(D, Laws.Asn1LawOne{}, [Sc.Asn1SExplicit{num, inner}], [x], h)
    case Sc.Asn1SOpt{+inner}:
      cf.or_r(Laws.asn1law.is_absent(x), Laws.asn1law.conf(D, Laws.Asn1LawOne{}, [inner], [x]), h)
    case Sc.Asn1SDefault{+inner, +v}:
      cf.or_r(Laws.asn1law.is_default(x), Laws.asn1law.conf(D, Laws.Asn1LawOne{}, [inner], [x]), h)

def cf.tag(+t: T.Asn1Tag, +c: Bool, +e: A.Asn1Tlv) -> {Sc.a1.s.tag_ok(t, c, e) == Laws.asn1law.tag_is(t, c, e) : Bool}:
  match e:
    case A.Asn1Tlv{+n, +raw}:
      {==}

def cf.tag_true(+t: T.Asn1Tag, +c: Bool, +e: A.Asn1Tlv, +h: {Sc.a1.s.tag_ok(t, c, e) == True{} : Bool}) -> {Laws.asn1law.tag_is(t, c, e) == True{} : Bool}:
  Equal.trans(Bool, Laws.asn1law.tag_is(t, c, e), Sc.a1.s.tag_ok(t, c, e), True{}, Equal.sym(Bool, Sc.a1.s.tag_ok(t, c, e), Laws.asn1law.tag_is(t, c, e), cf.tag(t, c, e)), h)

# ---------------------------------------------------------------- slots

def cf.cons(+D: Nat, +s: Sc.Asn1Schema, -me: Maybe<&2, A.Asn1Tlv>, +rest: List<&2, Sc.A1Slot>, +ex: Bool, +a: Result<&2, &2, E.Asn1Error, Sc.Asn1Match>, +b: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +ha: {cf.slot(1n+D, s, a) == True{} : Bool}, +hb: {cf.r(D, Sc.A1WSlots{rest, ex}, b) == True{} : Bool}) -> {cf.r(2n+D, Sc.A1WSlots{Con{Sc.A1Slot{s, me}, rest}, ex}, Sc.a1.s.cons(a, b)) == True{} : Bool}:
  match a:
    case Fail{+e}:
      {==}
    case Done{+x}:
      match b:
        case Fail{+e}:
          {==}
        case Done{+xs}:
          cf.and2(Laws.asn1law.conf(1n+D, Laws.Asn1LawOne{}, [s], [x]), Laws.asn1law.conf(2n+D, Laws.Asn1LawFields{}, cf.sch(rest), xs), ha, cf.mono2(D, Laws.Asn1LawFields{}, cf.sch(rest), xs, hb))

def cf.present(+D: Nat, ok: Bool, +s: Sc.Asn1Schema, +e: A.Asn1Tlv, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +h: {cf.r(D, Sc.A1WOne{Sc.a1.s.inner(s), e}, res) == True{} : Bool}) -> {cf.slot(1n+D, s, Sc.a1.s.present(ok, res)) == True{} : Bool}:
  match ok:
    case False{}:
      {==}
    case True{}:
      match res:
        case Fail{+x}:
          {==}
        case Done{+ms}:
          match ms:
            case Nil{}:
              {==}
            case Con{+y, +t}:
              match t:
                case Nil{}:
                  cf.inner(D, s, y, h)
                case Con{+z, +u}:
                  {==}

def cf.slot_res(+D: Nat, +der: Bool, +me: Maybe<&2, A.Asn1Tlv>, +s: Sc.Asn1Schema, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +h: {cf.r(D, Sc.a1.s.slot_work(s, me), res) == True{} : Bool}) -> {cf.slot(1n+D, s, Sc.a1.s.slot_res(der, me, s, res)) == True{} : Bool}:
  match me:
    case None{}:
      match s:
        case Sc.Asn1SAny{}:
          {==}
        case Sc.Asn1SElem{+t}:
          {==}
        case Sc.Asn1SSeq{+t, +fs}:
          {==}
        case Sc.Asn1SOf{+t, +item, +set}:
          {==}
        case Sc.Asn1SChoice{+alts}:
          {==}
        case Sc.Asn1SExplicit{+num, +inner}:
          {==}
        case Sc.Asn1SOpt{+inner}:
          {==}
        case Sc.Asn1SDefault{+inner, +v}:
          {==}
    case Some{+e}:
      cf.present(D, Sc.a1.s.default_ok(der, s, e), s, e, res, h)

# ---------------------------------------------------------------- a sequence's fields

def cf.sl(+a: Sc.A1Aligned) -> List<&2, Sc.A1Slot>:
  match a:
    case Sc.A1Aligned{+xs, +ex}:
      xs

def cf.slot_sch(+x: Sc.A1Slot, +a: Sc.A1Aligned) -> {cf.sch(cf.sl(Sc.a1.s.slot(x, a))) == cf.sch(Con{x, cf.sl(a)}) : List<&2, Sc.Asn1Schema>}:
  match a:
    case Sc.A1Aligned{+xs, +ex}:
      {==}

# the slots of a sequence's fields are its fields, in order
def cf.al(+fs: List<&2, Sc.Asn1Schema>, +hit: Bool, +es: List<&2, A.Asn1Tlv>) -> {cf.sch(cf.sl(Sc.a1.s.align(fs, hit, es))) == fs : List<&2, Sc.Asn1Schema>}:
