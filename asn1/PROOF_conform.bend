def cf.choice(+D: Nat, +alts: List<&2, Sc.Asn1Schema>, +e: A.Asn1Tlv, +p: Maybe<&2, Sc.A1Pick>, +ep: {Sc.a1.s.pick(alts, Sc.a1.s.tlv_tag(e), 0n) == p : Maybe<&2, Sc.A1Pick>}, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +h: {cf.r(D, Sc.a1.s.choice_work(p, e), res) == True{} : Bool}) -> {cf.r(2n+D, Sc.A1WOne{Sc.Asn1SChoice{alts}, e}, Sc.a1.s.choice_res(p, res)) == True{} : Bool}:
  match p:
    case None{}:
      {==}
    case Some{+pk}:
      match pk:
        case Sc.A1Pick{+i, +s}:
          match res:
            case Fail{+x}:
              {==}
            case Done{+ms}:
              match ms:
                case Nil{}:
                  {==}
                case Con{+y, +u}:
                  match u:
                    case Nil{}:
                      cf.chx(D, alts, Sc.a1.s.tlv_tag(e), 0n, i, s, y, Sc.Asn1S.admits(cf.hd(alts), Sc.a1.s.tlv_tag(e)), {==}, ep, h)
                    case Con{+z, +v}:
                      {==}

def cf.expl(+D: Nat, +n: Nat, +inner: Sc.Asn1Schema, +e: A.Asn1Tlv, b: Bool, +eb: {Sc.a1.s.tag_ok(T.Asn1Tag.context(n), True{}, e) == b : Bool}, +items: Result<&2, &2, E.Asn1Error, List<&2, A.Asn1Tlv>>, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +h: {cf.r(D, Sc.a1.s.one_work(items, inner), res) == True{} : Bool}) -> {cf.r(2n+D, Sc.A1WOne{Sc.Asn1SExplicit{n, inner}, e}, Sc.a1.s.gate(b, Sc.a1.s.one_res(items, e, res))) == True{} : Bool}:
  match b:
    case True{}:
      match items:
        case Fail{+x}:
          {==}
        case Done{+xs}:
          match xs:
            case Nil{}:
              {==}
            case Con{+x, +t}:
              match t:
                case Nil{}:
                  match res:
                    case Fail{+z}:
                      {==}
                    case Done{+ms}:
                      match ms:
                        case Nil{}:
                          {==}
                        case Con{+y, +u}:
                          match u:
                            case Nil{}:
                              cf.and2(Laws.asn1law.tag_is(T.Asn1Tag.context(n), True{}, e), Laws.asn1law.conf(1n+D, Laws.Asn1LawOne{}, [inner], [y]), cf.tag_true(T.Asn1Tag.context(n), True{}, e, eb), cf.mono(D, Laws.Asn1LawOne{}, [inner], [y], h))
                            case Con{+z, +v}:
                              {==}
                case Con{+z, +v}:
                  {==}
    case False{}:
      {==}

def cf.opt(+D: Nat, +inner: Sc.Asn1Schema, +e: A.Asn1Tlv, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +h: {cf.r(D, Sc.A1WOne{inner, e}, res) == True{} : Bool}) -> {cf.r(2n+D, Sc.A1WOne{Sc.Asn1SOpt{inner}, e}, res) == True{} : Bool}:
  match res:
    case Fail{+x}:
      {==}
    case Done{+ms}:
      match ms:
        case Nil{}:
          Empty.absurd({cf.r(2n+D, Sc.A1WOne{Sc.Asn1SOpt{inner}, e}, Done{Nil{}}) == True{} : Bool}, cf.ft(h))
        case Con{+x, +u}:
          match u:
            case Nil{}:
              cf.or_r(Laws.asn1law.is_absent(x), Laws.asn1law.conf(1n+D, Laws.Asn1LawOne{}, [inner], [x]), cf.mono(D, Laws.Asn1LawOne{}, [inner], [x], h))
            case Con{+y, +ys}:
              Empty.absurd({cf.r(2n+D, Sc.A1WOne{Sc.Asn1SOpt{inner}, e}, Done{Con{x, Con{y, ys}}}) == True{} : Bool}, cf.ft(h))

def cf.dflt(+D: Nat, +inner: Sc.Asn1Schema, +v: N.Asn1Node, +e: A.Asn1Tlv, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +h: {cf.r(D, Sc.A1WOne{inner, e}, res) == True{} : Bool}) -> {cf.r(2n+D, Sc.A1WOne{Sc.Asn1SDefault{inner, v}, e}, res) == True{} : Bool}:
  match res:
    case Fail{+x}:
      {==}
    case Done{+ms}:
      match ms:
        case Nil{}:
          Empty.absurd({cf.r(2n+D, Sc.A1WOne{Sc.Asn1SDefault{inner, v}, e}, Done{Nil{}}) == True{} : Bool}, cf.ft(h))
        case Con{+x, +u}:
          match u:
            case Nil{}:
              cf.or_r(Laws.asn1law.is_default(x), Laws.asn1law.conf(1n+D, Laws.Asn1LawOne{}, [inner], [x]), cf.mono(D, Laws.Asn1LawOne{}, [inner], [x], h))
            case Con{+y, +ys}:
              Empty.absurd({cf.r(2n+D, Sc.A1WOne{Sc.Asn1SDefault{inner, v}, e}, Done{Con{x, Con{y, ys}}}) == True{} : Bool}, cf.ft(h))

# ---------------------------------------------------------------- the matcher

def cf.m(fuel: Nat, +r: R.Asn1Rules, +w: Sc.A1Work) -> {cf.r(Nat.double(fuel), w, Sc.a1.s.m(fuel, r, w)) == True{} : Bool}:
  match fuel:
    case 0n:
      {==}
    case 1n+ +f:
      match w:
        case Sc.A1WNone{}:
          {==}
        case Sc.A1WSlots{+sl, +ex}:
          match sl:
            case Nil{}:
              match ex:
                case True{}:
                  {==}
                case False{}:
                  {==}
            case Con{+x, +rest}:
              match x:
                case Sc.A1Slot{+s, +me}:
                  cf.cons(Nat.double(f), s, me, rest, ex, Sc.a1.s.slot_res(R.Asn1Rules.values(r), me, s, Sc.a1.s.m(f, r, Sc.a1.s.slot_work(s, me))), Sc.a1.s.m(f, r, Sc.A1WSlots{rest, ex}), cf.slot_res(Nat.double(f), R.Asn1Rules.values(r), me, s, Sc.a1.s.m(f, r, Sc.a1.s.slot_work(s, me)), cf.m(f, r, Sc.a1.s.slot_work(s, me))), cf.m(f, r, Sc.A1WSlots{rest, ex}))
        case Sc.A1WOne{+s, +e}:
          match s:
            case Sc.Asn1SAny{}:
              {==}
            case Sc.Asn1SElem{+t}:
              cf.gelem(Nat.double(f), t, e, Sc.a1.s.tag_ok(t, False{}, e), {==})
            case Sc.Asn1SSeq{+t, +fs}:
              cf.seq(Nat.double(f), t, fs, e, Sc.a1.s.tag_ok(t, True{}, e), {==}, A.Asn1.items(r, e), Sc.a1.s.m(f, r, Sc.a1.s.seq_work(fs, Sc.a1.s.items_or_nil(A.Asn1.items(r, e)))), cf.m(f, r, Sc.a1.s.seq_work(fs, Sc.a1.s.items_or_nil(A.Asn1.items(r, e)))))
            case Sc.Asn1SOf{+t, +item, +set}:
              cf.of(Nat.double(f), t, item, set, r, e, A.Asn1.items(r, e), Bool.and(Sc.a1.s.tag_ok(t, True{}, e), Sc.a1.s.set_ok(set, r, Sc.a1.s.items_or_nil(A.Asn1.items(r, e)))), {==}, Sc.a1.s.m(f, r, Sc.A1WSlots{Sc.a1.s.of_slots(Sc.a1.s.items_or_nil(A.Asn1.items(r, e)), item), False{}}), cf.m(f, r, Sc.A1WSlots{Sc.a1.s.of_slots(Sc.a1.s.items_or_nil(A.Asn1.items(r, e)), item), False{}}))
            case Sc.Asn1SChoice{+alts}:
              cf.choice(Nat.double(f), alts, e, Sc.a1.s.pick(alts, Sc.a1.s.tlv_tag(e), 0n), {==}, Sc.a1.s.m(f, r, Sc.a1.s.choice_work(Sc.a1.s.pick(alts, Sc.a1.s.tlv_tag(e), 0n), e)), cf.m(f, r, Sc.a1.s.choice_work(Sc.a1.s.pick(alts, Sc.a1.s.tlv_tag(e), 0n), e)))
            case Sc.Asn1SExplicit{+num, +inner}:
              cf.expl(Nat.double(f), num, inner, e, Sc.a1.s.tag_ok(T.Asn1Tag.context(num), True{}, e), {==}, A.Asn1.items(r, e), Sc.a1.s.m(f, r, Sc.a1.s.one_work(A.Asn1.items(r, e), inner)), cf.m(f, r, Sc.a1.s.one_work(A.Asn1.items(r, e), inner)))
            case Sc.Asn1SOpt{+inner}:
              cf.opt(Nat.double(f), inner, e, Sc.a1.s.m(f, r, Sc.A1WOne{inner, e}), cf.m(f, r, Sc.A1WOne{inner, e}))
            case Sc.Asn1SDefault{+inner, +v}:
              cf.dflt(Nat.double(f), inner, v, e, Sc.a1.s.m(f, r, Sc.A1WOne{inner, e}), cf.m(f, r, Sc.A1WOne{inner, e}))

# ---------------------------------------------------------------- the laws

def cf.ok1(+F: Nat, +s: Sc.Asn1Schema, +x: A.Asn1Tlv, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +h: {cf.r(F, Sc.A1WOne{s, x}, res) == True{} : Bool}) -> {cf.slot(F, s, Sc.a1.s.ok1(res)) == True{} : Bool}:
  match res:
    case Fail{+e}:
      {==}
    case Done{+ms}:
      match ms:
        case Nil{}:
          {==}
        case Con{+y, +t}:
          match t:
            case Nil{}:
              h
            case Con{+z, +u}:
              {==}

# the matcher's fuel for an element, doubled
def cf.fuel(+x: A.Asn1Tlv) -> Nat:
  match x:
    case A.Asn1Tlv{+n, +raw}:
      Nat.double(Nat.mul(Nat.add(B.Octets.len(raw), 1n), 64n))

def cf.tlv(+r: R.Asn1Rules, +s: Sc.Asn1Schema, +x: A.Asn1Tlv) -> {cf.slot(cf.fuel(x), s, Sc.Asn1.match_tlv(r, s, x)) == True{} : Bool}:
  match x:
    case A.Asn1Tlv{+n, +raw}:
      cf.ok1(Nat.double(Nat.mul(Nat.add(B.Octets.len(raw), 1n), 64n)), s, A.Asn1Tlv{n, raw}, Sc.a1.s.m(Nat.mul(Nat.add(B.Octets.len(raw), 1n), 64n), r, Sc.A1WOne{s, A.Asn1Tlv{n, raw}}), cf.m(Nat.mul(Nat.add(B.Octets.len(raw), 1n), 64n), r, Sc.A1WOne{s, A.Asn1Tlv{n, raw}}))

def Laws.match_tlv_conforms(r, s, x, m, e):
  (cf.fuel(x), Equal.trans(Bool, Laws.asn1law.conf(cf.fuel(x), Laws.Asn1LawOne{}, [s], [m]), cf.slot(cf.fuel(x), s, Sc.Asn1.match_tlv(r, s, x)), True{}, Equal.cong(Result<&2, &2, E.Asn1Error, Sc.Asn1Match>, Bool, z => cf.slot(cf.fuel(x), s, z), Done{m}, Sc.Asn1.match_tlv(r, s, x), Equal.sym(Result<&2, &2, E.Asn1Error, Sc.Asn1Match>, Sc.Asn1.match_tlv(r, s, x), Done{m}, e)), cf.tlv(r, s, x)))

def cf.top2(ok: Bool, +r: R.Asn1Rules, +s: Sc.Asn1Schema, +x: A.Asn1Tlv, +m: Sc.Asn1Match, +e: {Sc.a1.s.top2(ok, r, s, x) == Done{m} : Result<&2, &2, E.Asn1Error, Sc.Asn1Match>}) -> Sigma<&1, &1, Nat, n => {Laws.asn1law.conf(n, Laws.Asn1LawOne{}, [s], [m]) == True{} : Bool}>:
  match ok:
    case True{}:
      Laws.match_tlv_conforms(r, s, x, m, e)
    case False{}:
      Empty.absurd(Sigma<&1, &1, Nat, n => {Laws.asn1law.conf(n, Laws.Asn1LawOne{}, [s], [m]) == True{} : Bool}>, cf.fail_done(E.Asn1Trailing{}, m, e))

def cf.top(+r: R.Asn1Rules, +s: Sc.Asn1Schema, +res: Result<&2, &2, E.Asn1Error, A.Asn1TlvRead>, +m: Sc.Asn1Match, +e: {Sc.a1.s.top(r, s, res) == Done{m} : Result<&2, &2, E.Asn1Error, Sc.Asn1Match>}) -> Sigma<&1, &1, Nat, n => {Laws.asn1law.conf(n, Laws.Asn1LawOne{}, [s], [m]) == True{} : Bool}>:
  match res:
    case Fail{+x}:
      Empty.absurd(Sigma<&1, &1, Nat, n => {Laws.asn1law.conf(n, Laws.Asn1LawOne{}, [s], [m]) == True{} : Bool}>, cf.fail_done(x, m, e))
    case Done{+rd}:
      match rd:
        case A.Asn1TlvRead{+x, +rest}:
          cf.top2(Bool.or(R.Asn1Rules.trailing(r), Nat.is_eq(B.Octets.len(rest), 0n)), r, s, x, m, e)

def Laws.match_conforms(r, s, b, m, e):
  cf.top(r, s, A.Asn1.read(r, b), m, e)

def Laws.vec_conforms():
  {==}

