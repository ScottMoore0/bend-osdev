# a SEQUENCE OF's slots all carry the item
def cf.ofs(F: Nat, +xs: List<&2, A.Asn1Tlv>, +item: Sc.Asn1Schema, +ms: List<&2, Sc.Asn1Match>, +h: {Laws.asn1law.conf(F, Laws.Asn1LawFields{}, cf.sch(Sc.a1.s.of_slots(xs, item)), ms) == True{} : Bool}) -> {Laws.asn1law.conf(F, Laws.Asn1LawAll{}, [item], ms) == True{} : Bool}:
  match F:
    case 0n:
      Empty.absurd({Laws.asn1law.conf(0n, Laws.Asn1LawAll{}, [item], ms) == True{} : Bool}, cf.ft(h))
    case 1n+ +p:
      match xs:
        case Nil{}:
          match ms:
            case Nil{}:
              {==}
            case Con{+y, +ys}:
              Empty.absurd({Laws.asn1law.conf(1n+p, Laws.Asn1LawAll{}, [item], Con{y, ys}) == True{} : Bool}, cf.ft(h))
        case Con{+x, +t}:
          match ms:
            case Nil{}:
              {==}
            case Con{+y, +ys}:
              cf.and2(Laws.asn1law.conf(p, Laws.Asn1LawOne{}, [item], [y]), Laws.asn1law.conf(1n+p, Laws.Asn1LawAll{}, [item], ys), cf.and_l(Laws.asn1law.conf(p, Laws.Asn1LawOne{}, [item], [y]), Laws.asn1law.conf(1n+p, Laws.Asn1LawFields{}, cf.sch(Sc.a1.s.of_slots(t, item)), ys), h), cf.ofs(1n+p, t, item, ys, cf.and_r(Laws.asn1law.conf(p, Laws.Asn1LawOne{}, [item], [y]), Laws.asn1law.conf(1n+p, Laws.Asn1LawFields{}, cf.sch(Sc.a1.s.of_slots(t, item)), ys), h)))

# ---------------------------------------------------------------- the schema forms

def cf.gelem(+D: Nat, +t: T.Asn1Tag, +e: A.Asn1Tlv, b: Bool, +eb: {Sc.a1.s.tag_ok(t, False{}, e) == b : Bool}) -> {cf.r(2n+D, Sc.A1WOne{Sc.Asn1SElem{t}, e}, Sc.a1.s.gate(b, Done{[Sc.Asn1MElem{e}]})) == True{} : Bool}:
  match b:
    case True{}:
      cf.tag_true(t, False{}, e, eb)
    case False{}:
      {==}

def cf.seq(+D: Nat, +t: T.Asn1Tag, +fs: List<&2, Sc.Asn1Schema>, +e: A.Asn1Tlv, b: Bool, +eb: {Sc.a1.s.tag_ok(t, True{}, e) == b : Bool}, +items: Result<&2, &2, E.Asn1Error, List<&2, A.Asn1Tlv>>, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +h: {cf.r(D, Sc.a1.s.seq_work(fs, Sc.a1.s.items_or_nil(items)), res) == True{} : Bool}) -> {cf.r(2n+D, Sc.A1WOne{Sc.Asn1SSeq{t, fs}, e}, Sc.a1.s.gate(b, Sc.a1.s.items_err(items, Sc.a1.s.wrap_seq(e, res)))) == True{} : Bool}:
  match b:
    case True{}:
      match items:
        case Fail{+x}:
          {==}
        case Done{+xs}:
          match res:
            case Fail{+x}:
              {==}
            case Done{+ms}:
              cf.and2(Laws.asn1law.tag_is(t, True{}, e), Laws.asn1law.conf(1n+D, Laws.Asn1LawFields{}, fs, ms), cf.tag_true(t, True{}, e, eb), cf.mono(D, Laws.Asn1LawFields{}, fs, ms, cf.seqw(D, fs, xs, ms, h)))
    case False{}:
      {==}

def cf.of(+D: Nat, +t: T.Asn1Tag, +item: Sc.Asn1Schema, +set: Bool, +r: R.Asn1Rules, +e: A.Asn1Tlv, items: Result<&2, &2, E.Asn1Error, List<&2, A.Asn1Tlv>>, b: Bool, +eb: {Bool.and(Sc.a1.s.tag_ok(t, True{}, e), Sc.a1.s.set_ok(set, r, Sc.a1.s.items_or_nil(items))) == b : Bool}, +res: Result<&2, &2, E.Asn1Error, List<&2, Sc.Asn1Match>>, +h: {cf.r(D, Sc.A1WSlots{Sc.a1.s.of_slots(Sc.a1.s.items_or_nil(items), item), False{}}, res) == True{} : Bool}) -> {cf.r(2n+D, Sc.A1WOne{Sc.Asn1SOf{t, item, set}, e}, Sc.a1.s.gate(b, Sc.a1.s.items_err(items, Sc.a1.s.wrap_seq(e, res)))) == True{} : Bool}:
  match items:
    case Fail{+x}:
      match b:
        case True{}:
          {==}
        case False{}:
          {==}
    case Done{+xs}:
      match b:
        case True{}:
          match res:
            case Fail{+x}:
              {==}
            case Done{+ms}:
              cf.and2(Laws.asn1law.tag_is(t, True{}, e), Laws.asn1law.conf(1n+D, Laws.Asn1LawAll{}, [item], ms), cf.tag_true(t, True{}, e, cf.and_l(Sc.a1.s.tag_ok(t, True{}, e), Sc.a1.s.set_ok(set, r, xs), eb)), cf.mono(D, Laws.Asn1LawAll{}, [item], ms, cf.ofs(D, xs, item, ms, h)))
        case False{}:
          {==}

def cf.issome(+p: Maybe<&2, Sc.A1Pick>) -> Bool:
  match p:
    case None{}:
      False{}
    case Some{+x}:
      True{}

def cf.selp(+p: Maybe<&2, Sc.A1Pick>) -> Sc.Asn1Schema:
  match p:
    case None{}:
      Sc.Asn1SAny{}
    case Some{+x}:
      match x:
        case Sc.A1Pick{+i, +s}:
          s

def cf.hd(+alts: List<&2, Sc.Asn1Schema>) -> Sc.Asn1Schema:
  match alts:
    case Nil{}:
      Sc.Asn1SAny{}
    case Con{+a, +rest}:
      a

# the alternative the matcher picks is one of the alternatives; b says
# whether the first alternative admits the tag
