      +e2 = Equal.trans(Result<&2, &2, E.Asn1Error, Ti.Asn1Time>, Ti.a1.t.check(True{}, Ti.a1.gen.finish(True{}, Ti.a1.gen.frac(True{}, Ti.a1.gen.two.go(False{}, Ti.A1Gen{[Nat.add(Nat.mul(Ti.a1.t.val(p0), 10n), Ti.a1.t.val(q0)), Nat.add(Nat.mul(Ti.a1.t.val(p1), 10n), Ti.a1.t.val(q1)), Nat.add(Nat.mul(Ti.a1.t.val(p2), 10n), Ti.a1.t.val(q2)), Nat.add(Nat.mul(Ti.a1.t.val(p3), 10n), Ti.a1.t.val(q3)), Nat.add(Nat.mul(Ti.a1.t.val(p4), 10n), Ti.a1.t.val(q4))], 0n, 0n, False{}, False{}, Nil{}, Con{p5, Con{q5, t5}}, True{}})))), Ti.a1.t.check(True{}, Ti.a1.gen.finish(True{}, Ti.a1.gen.frac(True{}, Ti.a1.gen.two.go(Ti.a1.t.two(Con{p5, Con{q5, t5}}), Ti.A1Gen{[Nat.add(Nat.mul(Ti.a1.t.val(p0), 10n), Ti.a1.t.val(q0)), Nat.add(Nat.mul(Ti.a1.t.val(p1), 10n), Ti.a1.t.val(q1)), Nat.add(Nat.mul(Ti.a1.t.val(p2), 10n), Ti.a1.t.val(q2)), Nat.add(Nat.mul(Ti.a1.t.val(p3), 10n), Ti.a1.t.val(q3)), Nat.add(Nat.mul(Ti.a1.t.val(p4), 10n), Ti.a1.t.val(q4))], 0n, 0n, False{}, False{}, Nil{}, Con{p5, Con{q5, t5}}, True{}})))), Done{tt}, Equal.cong(Bool, Result<&2, &2, E.Asn1Error, Ti.Asn1Time>, b => Ti.a1.t.check(True{}, Ti.a1.gen.finish(True{}, Ti.a1.gen.frac(True{}, Ti.a1.gen.two.go(b, Ti.A1Gen{[Nat.add(Nat.mul(Ti.a1.t.val(p0), 10n), Ti.a1.t.val(q0)), Nat.add(Nat.mul(Ti.a1.t.val(p1), 10n), Ti.a1.t.val(q1)), Nat.add(Nat.mul(Ti.a1.t.val(p2), 10n), Ti.a1.t.val(q2)), Nat.add(Nat.mul(Ti.a1.t.val(p3), 10n), Ti.a1.t.val(q3)), Nat.add(Nat.mul(Ti.a1.t.val(p4), 10n), Ti.a1.t.val(q4))], 0n, 0n, False{}, False{}, Nil{}, Con{p5, Con{q5, t5}}, True{}})))), False{}, Ti.a1.t.two(Con{p5, Con{q5, t5}}), Equal.sym(Bool, Ti.a1.t.two(Con{p5, Con{q5, t5}}), False{}, htw)), e)
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{p0, Con{q0, Con{p1, Con{q1, Con{p2, Con{q2, Con{p3, Con{q3, Con{p4, Con{q4, Con{p5, Con{q5, t5}}}}}}}}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e2))

def pd.gen_r1(rest: List<&2, U32>, +p0: U32, +q0: U32, +p1: U32, +q1: U32, +p2: U32, +q2: U32, +p3: U32, +q3: U32, +p4: U32, +q4: U32, -tt: Ti.Asn1Time, +hd: {Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Ti.a1.t.dig(p0), Ti.a1.t.dig(q0)), Bool.and(Ti.a1.t.dig(p1), Ti.a1.t.dig(q1))), Bool.and(Ti.a1.t.dig(p2), Ti.a1.t.dig(q2))), Bool.and(Ti.a1.t.dig(p3), Ti.a1.t.dig(q3))), Bool.and(Ti.a1.t.dig(p4), Ti.a1.t.dig(q4))) == True{} : Bool}, +hn: {pd.nofrac(tt) == True{} : Bool}, +e: {Ti.a1.t.check(True{}, Ti.a1.gen.finish(True{}, Ti.a1.gen.frac(True{}, Ti.a1.gen.two(Ti.a1.gen.two(Ti.A1Gen{[Nat.add(Nat.mul(Ti.a1.t.val(p0), 10n), Ti.a1.t.val(q0)), Nat.add(Nat.mul(Ti.a1.t.val(p1), 10n), Ti.a1.t.val(q1)), Nat.add(Nat.mul(Ti.a1.t.val(p2), 10n), Ti.a1.t.val(q2)), Nat.add(Nat.mul(Ti.a1.t.val(p3), 10n), Ti.a1.t.val(q3)), Nat.add(Nat.mul(Ti.a1.t.val(p4), 10n), Ti.a1.t.val(q4))], 0n, 0n, False{}, False{}, Nil{}, rest, True{}}))))) == Done{tt} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> {Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{p0, Con{q0, Con{p1, Con{q1, Con{p2, Con{q2, Con{p3, Con{q3, Con{p4, Con{q4, rest}}}}}}}}}})} : N.Asn1Node}:
  match rest:
    case Con{+p5, Con{+q5, +t5}}:
      pd.gen_tw1(Ti.a1.t.two(Con{p5, Con{q5, t5}}), p0, q0, p1, q1, p2, q2, p3, q3, p4, q4, p5, q5, t5, tt, hd, hn, {==}, e)
    case Nil{}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{p0, Con{q0, Con{p1, Con{q1, Con{p2, Con{q2, Con{p3, Con{q3, Con{p4, Con{q4, Nil{}}}}}}}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x, Nil{}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{p0, Con{q0, Con{p1, Con{q1, Con{p2, Con{q2, Con{p3, Con{q3, Con{p4, Con{q4, Con{x, Nil{}}}}}}}}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))

def pd.gen_ok(ok: Bool, +p0: U32, +q0: U32, +p1: U32, +q1: U32, +p2: U32, +q2: U32, +p3: U32, +q3: U32, +p4: U32, +q4: U32, +rest: List<&2, U32>, -tt: Ti.Asn1Time, +hok: {Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Ti.a1.t.dig(p0), Ti.a1.t.dig(q0)), Bool.and(Ti.a1.t.dig(p1), Ti.a1.t.dig(q1))), Bool.and(Ti.a1.t.dig(p2), Ti.a1.t.dig(q2))), Bool.and(Ti.a1.t.dig(p3), Ti.a1.t.dig(q3))), Bool.and(Ti.a1.t.dig(p4), Ti.a1.t.dig(q4))) == ok : Bool}, +hn: {pd.nofrac(tt) == True{} : Bool}, +e: {Ti.a1.t.check(True{}, Ti.a1.gen.finish(True{}, Ti.a1.gen.frac(True{}, Ti.a1.gen.two(Ti.a1.gen.two(Ti.a1.gen.start(Ti.a1.t.done(ok, [Nat.add(Nat.mul(Ti.a1.t.val(p4), 10n), Ti.a1.t.val(q4)), Nat.add(Nat.mul(Ti.a1.t.val(p3), 10n), Ti.a1.t.val(q3)), Nat.add(Nat.mul(Ti.a1.t.val(p2), 10n), Ti.a1.t.val(q2)), Nat.add(Nat.mul(Ti.a1.t.val(p1), 10n), Ti.a1.t.val(q1)), Nat.add(Nat.mul(Ti.a1.t.val(p0), 10n), Ti.a1.t.val(q0))], rest))))))) == Done{tt} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> {Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{p0, Con{q0, Con{p1, Con{q1, Con{p2, Con{q2, Con{p3, Con{q3, Con{p4, Con{q4, rest}}}}}}}}}})} : N.Asn1Node}:
  match ok:
    case True{}:
      pd.gen_r1(rest, p0, q0, p1, q1, p2, q2, p3, q3, p4, q4, tt, hok, hn, e)
    case False{}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{p0, Con{q0, Con{p1, Con{q1, Con{p2, Con{q2, Con{p3, Con{q3, Con{p4, Con{q4, rest}}}}}}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))

# under DER, GeneralizedTime characters read (with no fraction of a second)
# are the writer's characters for the time read
def pd.gen_xs(+xs: List<&2, U32>, -tt: Ti.Asn1Time, +hn: {pd.nofrac(tt) == True{} : Bool}, +e: {Ti.a1.t.check(True{}, Ti.a1.gen.finish(True{}, Ti.a1.gen.frac(True{}, Ti.a1.gen.two(Ti.a1.gen.two(Ti.a1.gen.start(Ti.a1.t.nums(5n, xs, True{}, Nil{}))))))) == Done{tt} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> {Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(xs)} : N.Asn1Node}:
  match xs:
    case Con{+p0, Con{+q0, Con{+p1, Con{+q1, Con{+p2, Con{+q2, Con{+p3, Con{+q3, Con{+p4, Con{+q4, +rest}}}}}}}}}}:
      pd.gen_ok(Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Ti.a1.t.dig(p0), Ti.a1.t.dig(q0)), Bool.and(Ti.a1.t.dig(p1), Ti.a1.t.dig(q1))), Bool.and(Ti.a1.t.dig(p2), Ti.a1.t.dig(q2))), Bool.and(Ti.a1.t.dig(p3), Ti.a1.t.dig(q3))), Bool.and(Ti.a1.t.dig(p4), Ti.a1.t.dig(q4))), p0, q0, p1, q1, p2, q2, p3, q3, p4, q4, rest, tt, {==}, hn, e)
    case Nil{}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Nil{})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x0, Nil{}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{x0, Nil{}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x0, Con{x1, Nil{}}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{x0, Con{x1, Nil{}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x0, Con{x1, Con{x2, Nil{}}}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Nil{}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x0, Con{x1, Con{x2, Con{x3, Nil{}}}}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Nil{}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Nil{}}}}}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Nil{}}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Nil{}}}}}}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Nil{}}}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Nil{}}}}}}}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Nil{}}}}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Nil{}}}}}}}}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Nil{}}}}}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Nil{}}}}}}}}}}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), B.Octets.of_list(Con{x0, Con{x1, Con{x2, Con{x3, Con{x4, Con{x5, Con{x6, Con{x7, Con{x8, Nil{}}}}}}}}}})} : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))

# end of the generated part

# under DER, a UTCTime element read is the element written for its time
def pd.utc_top(res: Result<&2, &2, E.Asn1Error, B.Octets>, +r: R.Asn1Rules, +hv: {R.Asn1Rules.values(r) == True{} : Bool}, +hp: {R.Asn1Rules.prim_strings(r) == True{} : Bool}, +pivot: Nat, +n: N.Asn1Node, -t: Ti.Asn1Time, +hres: {P.a1.string_value(R.Asn1Rules.prim_strings(r), T.Asn1Tag.utc_time(), T.Asn1Tag.utc_time(), n) == res : Result<&2, &2, E.Asn1Error, B.Octets>}, +e: {Ti.a1.t.from(res, r, pivot, True{}) == Done{t} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> {Ti.Asn1.utc_time(t) == n : N.Asn1Node}:
  match res:
    case Fail{x}:
      Empty.absurd({Ti.Asn1.utc_time(t) == n : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, x, t, e))
    case Done{+o}:
      +hn = PS.sx.sv(T.Asn1Tag.utc_time(), T.Asn1Tag.utc_time(), n, o, Equal.trans(Result<&2, &2, E.Asn1Error, B.Octets>, P.a1.string_value(True{}, T.Asn1Tag.utc_time(), T.Asn1Tag.utc_time(), n), P.a1.string_value(R.Asn1Rules.prim_strings(r), T.Asn1Tag.utc_time(), T.Asn1Tag.utc_time(), n), Done{o}, PS.sx.prim_rw(r, hp, T.Asn1Tag.utc_time(), T.Asn1Tag.utc_time(), n), hres))
      +xs = B.Octets.to_list(o)
      +e2 = Equal.trans(Result<&2, &2, E.Asn1Error, Ti.Asn1Time>, Ti.a1.t.check(True{}, Ti.a1.utc.parse(Ti.a1.t.nums(5n, xs, True{}, Nil{}), True{}, pivot)), Ti.a1.t.check(R.Asn1Rules.values(r), Ti.a1.utc.parse(Ti.a1.t.nums(5n, xs, True{}, Nil{}), R.Asn1Rules.values(r), pivot)), Done{t}, Equal.cong(Bool, Result<&2, &2, E.Asn1Error, Ti.Asn1Time>, v => Ti.a1.t.check(v, Ti.a1.utc.parse(Ti.a1.t.nums(5n, xs, True{}, Nil{}), v, pivot)), True{}, R.Asn1Rules.values(r), Equal.sym(Bool, R.Asn1Rules.values(r), True{}, hv)), e)
      %hn : {Ti.Asn1.utc_time(t) == _ : N.Asn1Node}
      %AL.al.of_to(o) : {Ti.Asn1.utc_time(t) == N.Asn1Prim{T.Asn1Tag.utc_time(), _} : N.Asn1Node}
      pd.utc_xs(xs, pivot, t, e2)

# under DER, a GeneralizedTime element read, with no fraction of a second,
# is the element written for its time
def pd.gen_top(res: Result<&2, &2, E.Asn1Error, B.Octets>, +r: R.Asn1Rules, +hv: {R.Asn1Rules.values(r) == True{} : Bool}, +hp: {R.Asn1Rules.prim_strings(r) == True{} : Bool}, +n: N.Asn1Node, -tt: Ti.Asn1Time, +hn: {pd.nofrac(tt) == True{} : Bool}, +hres: {P.a1.string_value(R.Asn1Rules.prim_strings(r), T.Asn1Tag.generalized_time(), T.Asn1Tag.generalized_time(), n) == res : Result<&2, &2, E.Asn1Error, B.Octets>}, +e: {Ti.a1.t.from(res, r, 50n, False{}) == Done{tt} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> {Ti.Asn1.gen_time(tt) == n : N.Asn1Node}:
  match res:
    case Fail{x}:
      Empty.absurd({Ti.Asn1.gen_time(tt) == n : N.Asn1Node}, PS.sx.fd(Ti.Asn1Time, x, tt, e))
    case Done{+o}:
      +hn2 = PS.sx.sv(T.Asn1Tag.generalized_time(), T.Asn1Tag.generalized_time(), n, o, Equal.trans(Result<&2, &2, E.Asn1Error, B.Octets>, P.a1.string_value(True{}, T.Asn1Tag.generalized_time(), T.Asn1Tag.generalized_time(), n), P.a1.string_value(R.Asn1Rules.prim_strings(r), T.Asn1Tag.generalized_time(), T.Asn1Tag.generalized_time(), n), Done{o}, PS.sx.prim_rw(r, hp, T.Asn1Tag.generalized_time(), T.Asn1Tag.generalized_time(), n), hres))
      +xs = B.Octets.to_list(o)
      +e2 = Equal.trans(Result<&2, &2, E.Asn1Error, Ti.Asn1Time>, Ti.a1.t.check(True{}, Ti.a1.gen.finish(True{}, Ti.a1.gen.frac(True{}, Ti.a1.gen.two(Ti.a1.gen.two(Ti.a1.gen.start(Ti.a1.t.nums(5n, xs, True{}, Nil{}))))))), Ti.a1.t.check(R.Asn1Rules.values(r), Ti.a1.gen.finish(R.Asn1Rules.values(r), Ti.a1.gen.frac(R.Asn1Rules.values(r), Ti.a1.gen.two(Ti.a1.gen.two(Ti.a1.gen.start(Ti.a1.t.nums(5n, xs, True{}, Nil{}))))))), Done{tt}, Equal.cong(Bool, Result<&2, &2, E.Asn1Error, Ti.Asn1Time>, v => Ti.a1.t.check(v, Ti.a1.gen.finish(v, Ti.a1.gen.frac(v, Ti.a1.gen.two(Ti.a1.gen.two(Ti.a1.gen.start(Ti.a1.t.nums(5n, xs, True{}, Nil{}))))))), True{}, R.Asn1Rules.values(r), Equal.sym(Bool, R.Asn1Rules.values(r), True{}, hv)), e)
      %hn2 : {Ti.Asn1.gen_time(tt) == _ : N.Asn1Node}
      %AL.al.of_to(o) : {Ti.Asn1.gen_time(tt) == N.Asn1Prim{T.Asn1Tag.generalized_time(), _} : N.Asn1Node}
      pd.gen_xs(xs, tt, hn, e2)
