# Proof helpers for bend-osdev-asn1: under DER's checks, the UTCTime and
# GeneralizedTime characters the reader accepts are those the writer writes
# for the time read (for GeneralizedTime, when the time read has no
# fraction of a second). A digit character is the writer's character for
# its value (pd.dig_eq, through bend-osdev-u32's value laws), two digits are
# the writer's characters for their two-digit number (division by 10 is
# unique), the year's digits come back (through the century rule, or as
# century and year), and DER leaves only Z after the seconds (an offset is
# not Zulu time). The part after "# generated by gen/gen_tstrict.py" is that
# script's output: deep patterns over the twelve or fourteen digit
# characters.
import Base
import ../bytes/bytes.bend as B
import ../u32/LAWS.bend as UL
import ../u32/PROOF.bend as UP
import ./error.bend as E
import ./tag.bend as T
import ./node.bend as N
import ./rules.bend as R
import ./prim.bend as P
import ./time.bend as Ti
import ./proof_nat.bend as AN
import ./proof_list.bend as AL
import ./proof_u32.bend as AU
import ./proof_clock.bend as PK
import ./proof_strict.bend as PS

# Digit characters

def pd.fq(q: Nat, +h: {Nat.is_lt(q, 10n) == True{} : Bool}) -> {U32.to_nat(U32.from_nat(Nat.add(48n, q))) == Nat.add(48n, q) : Nat}:
  match q:
    case 0n:
      {==}
    case 1n:
      {==}
    case 2n:
      {==}
    case 3n:
      {==}
    case 4n:
      {==}
    case 5n:
      {==}
    case 6n:
      {==}
    case 7n:
      {==}
    case 8n:
      {==}
    case 9n:
      {==}
    case 10n+k:
      Empty.absurd({U32.to_nat(U32.from_nat(Nat.add(48n, 10n+k))) == Nat.add(48n, 10n+k) : Nat}, AN.an.ft(Equal.trans(Bool, False{}, Nat.is_lt(k, 0n), True{}, Equal.sym(Bool, Nat.is_lt(k, 0n), False{}, AN.an.lt0(k)), h)))

# a <= b: a + (b - a) == b
def pd.add_sub(+a: Nat, +b: Nat, +h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.add(a, Nat.sub(b, a)) == b : Nat}:
  match a b:
    case 0n _:
      AN.an.sub_zero(b)
    case 1n+p 0n:
      Empty.absurd({Nat.add(1n+p, Nat.sub(0n, 1n+p)) == 0n : Nat}, AN.an.ft(h))
    case 1n+p 1n+q:
      %pd.add_sub(p, q, h) : {1n+Nat.add(p, Nat.sub(q, p)) == 1n+_ : Nat}
      {==}

def pd.ge48(+x: U32, +h: {Ti.a1.t.dig(x) == True{} : Bool}) -> {Nat.is_le(48n, U32.to_nat(x)) == True{} : Bool}:
  Equal.trans(Bool, Nat.is_le(48n, U32.to_nat(x)), U32.is_le(48, x), True{}, Equal.sym(Bool, U32.is_le(48, x), Nat.is_le(U32.to_nat(48), U32.to_nat(x)), UL.u32_le_value(48, x)), AN.an.and_l(U32.is_le(48, x), U32.is_le(x, 57), h))

def pd.le57(+x: U32, +h: {Ti.a1.t.dig(x) == True{} : Bool}) -> {Nat.is_le(U32.to_nat(x), 57n) == True{} : Bool}:
  Equal.trans(Bool, Nat.is_le(U32.to_nat(x), 57n), U32.is_le(x, 57), True{}, Equal.sym(Bool, U32.is_le(x, 57), Nat.is_le(U32.to_nat(x), U32.to_nat(57)), UL.u32_le_value(x, 57)), AN.an.and_r(U32.is_le(48, x), U32.is_le(x, 57), h))

# a digit character's value is its code less 48
def pd.dig_v(+x: U32, +h: {Ti.a1.t.dig(x) == True{} : Bool}) -> {Ti.a1.t.val(x) == Nat.sub(U32.to_nat(x), 48n) : Nat}:
  UL.u32_sub_value(x, 48, pd.ge48(x, h))

def pd.dig_q(+x: U32, +h: {Ti.a1.t.dig(x) == True{} : Bool}) -> {Nat.is_lt(Nat.sub(U32.to_nat(x), 48n), 10n) == True{} : Bool}:
  +v = U32.to_nat(x)
  +q = Nat.sub(v, 48n)
  +eq = pd.add_sub(48n, v, pd.ge48(x, h))
  +h1 = Equal.trans(Bool, Nat.is_le(Nat.add(48n, q), 57n), Nat.is_le(v, 57n), True{}, Equal.cong(Nat, Bool, w => Nat.is_le(w, 57n), Nat.add(48n, q), v, eq), pd.le57(x, h))
  +h2 = Equal.trans(Bool, Nat.is_le(q, 9n), Nat.is_le(Nat.add(48n, q), Nat.add(48n, 9n)), True{}, Equal.sym(Bool, Nat.is_le(Nat.add(48n, q), Nat.add(48n, 9n)), Nat.is_le(q, 9n), AN.an.cancel_le(48n, q, 9n)), h1)
  AN.an.le_lt_succ(q, 9n, h2)

def pd.dig_lt(+x: U32, +h: {Ti.a1.t.dig(x) == True{} : Bool}) -> {Nat.is_lt(Ti.a1.t.val(x), 10n) == True{} : Bool}:
  %Equal.sym(Nat, Ti.a1.t.val(x), Nat.sub(U32.to_nat(x), 48n), pd.dig_v(x, h)) : {Nat.is_lt(_, 10n) == True{} : Bool}
  pd.dig_q(x, h)

# a digit character is the writer's character for its value
def pd.dig_eq(+x: U32, +h: {Ti.a1.t.dig(x) == True{} : Bool}) -> {U32.from_nat(Nat.add(48n, Ti.a1.t.val(x))) == x : U32}:
  +v = U32.to_nat(x)
  +q = Nat.sub(v, 48n)
  %Equal.sym(Nat, Ti.a1.t.val(x), q, pd.dig_v(x, h)) : {U32.from_nat(Nat.add(48n, _)) == x : U32}
  UL.u32_value_eq(U32.from_nat(Nat.add(48n, q)), x, Equal.trans(Nat, U32.to_nat(U32.from_nat(Nat.add(48n, q))), Nat.add(48n, q), v, pd.fq(q, pd.dig_q(x, h)), pd.add_sub(48n, v, pd.ge48(x, h))))

def pd.mul_le(+a: Nat, +c: Nat, +k: Nat, +h: {Nat.is_le(a, c) == True{} : Bool}) -> {Nat.is_le(Nat.mul(a, k), Nat.mul(c, k)) == True{} : Bool}:
  match a c:
    case 0n _:
      AN.an.le_zero(Nat.mul(c, k))
    case 1n+ap 0n:
      Empty.absurd({Nat.is_le(Nat.mul(1n+ap, k), 0n) == True{} : Bool}, AN.an.ft(h))
    case 1n+ap 1n+cp:
      AN.an.le_add_mono(k, Nat.mul(ap, k), Nat.mul(cp, k), pd.mul_le(ap, cp, k, h))

# two digits read as a number below 100
def pd.lt100(+a: U32, +b: U32, +ha: {Ti.a1.t.dig(a) == True{} : Bool}, +hb: {Ti.a1.t.dig(b) == True{} : Bool}) -> {Nat.is_lt(Nat.add(Nat.mul(Ti.a1.t.val(a), 10n), Ti.a1.t.val(b)), 100n) == True{} : Bool}:
  +la = AN.an.lt_succ_le(Ti.a1.t.val(a), 9n, pd.dig_lt(a, ha))
  +lb = AN.an.lt_succ_le(Ti.a1.t.val(b), 9n, pd.dig_lt(b, hb))
  +m = pd.mul_le(Ti.a1.t.val(a), 9n, 10n, la)
  AN.an.le_lt_succ(Nat.add(Nat.mul(Ti.a1.t.val(a), 10n), Ti.a1.t.val(b)), 99n, AN.an.le_add2(Nat.mul(Ti.a1.t.val(a), 10n), Ti.a1.t.val(b), 90n, 9n, m, lb))

# two digits are the writer's characters for the number they read as
def pd.d2_eq(+a: U32, +b: U32, +ha: {Ti.a1.t.dig(a) == True{} : Bool}, +hb: {Ti.a1.t.dig(b) == True{} : Bool}) -> {Ti.a1.t.d2(Nat.add(Nat.mul(Ti.a1.t.val(a), 10n), Ti.a1.t.val(b))) == [a, b] : List<&2, U32>}:
  +va = Ti.a1.t.val(a)
  +vb = Ti.a1.t.val(b)
  +v = Nat.add(Nat.mul(va, 10n), vb)
  +hbq = pd.dig_lt(b, hb)
  %Equal.sym(Nat, Nat.div(v, 10n), va, PK.pk.div_of(va, vb, 9n, hbq)) : {[U32.from_nat(Nat.add(48n, _)), U32.from_nat(Nat.add(48n, Nat.mod(v, 10n)))] == [a, b] : List<&2, U32>}
  %Equal.sym(Nat, Nat.mod(v, 10n), vb, PK.pk.mod_of(va, vb, 9n, hbq)) : {[U32.from_nat(Nat.add(48n, va)), U32.from_nat(Nat.add(48n, _))] == [a, b] : List<&2, U32>}
  %Equal.sym(U32, U32.from_nat(Nat.add(48n, va)), a, pd.dig_eq(a, ha)) : {[_, U32.from_nat(Nat.add(48n, vb))] == [a, b] : List<&2, U32>}
  %Equal.sym(U32, U32.from_nat(Nat.add(48n, vb)), b, pd.dig_eq(b, hb)) : {[a, _] == [a, b] : List<&2, U32>}
  {==}

def pd.app2(+v: Nat, +a: U32, +b: U32, +t1: List<&2, U32>, +t2: List<&2, U32>, +e1: {Ti.a1.t.d2(v) == [a, b] : List<&2, U32>}, +e2: {t1 == t2 : List<&2, U32>}) -> {Ti.a1.t.app(Ti.a1.t.d2(v), t1) == Con{a, Con{b, t2}} : List<&2, U32>}:
  %Equal.sym(List<&2, U32>, Ti.a1.t.d2(v), [a, b], e1) : {Ti.a1.t.app(_, t1) == Con{a, Con{b, t2}} : List<&2, U32>}
  %Equal.sym(List<&2, U32>, t1, t2, e2) : {Con{a, Con{b, _}} == Con{a, Con{b, t2}} : List<&2, U32>}
  {==}

# The zone: an offset is not Zulu time

def pd.mz(mz: Maybe<&2, Ti.Asn1Zone>) -> Bool:
  match mz:
    case None{}:
      False{}
    case Some{z}:
      Ti.a1.t.zulu(z)

def pd.off_nz(s: Maybe<&2, Bool>, m: Maybe<&2, Ti.A1TNums>) -> {pd.mz(Ti.a1.t.off(s, m)) == False{} : Bool}:
  match s:
    case None{}:
      {==}
    case Some{neg}:
      match m:
        case None{}:
          {==}
        case Some{Ti.A1TNums{vals, r}}:
          match vals:
            case Nil{}:
              {==}
            case Con{h, t1}:
              match t1:
                case Nil{}:
                  match r:
                    case Nil{}:
                      {==}
                    case Con{x, y}:
                      {==}
                case Con{mi, t2}:
                  match t2:
                    case Nil{}:
                      match r:
                        case Nil{}:
                          {==}
                        case Con{x, y}:
                          {==}
                    case Con{w, t3}:
                      {==}

def pd.c2t(ok: Bool, +tt: Ti.Asn1Time, -t: Ti.Asn1Time, +hok: {Bool.and(Ti.Asn1Time.valid(tt), R.a1.when(True{}, Ti.a1.t.zulu(Ti.Asn1Time.zone(tt)))) == ok : Bool}, +e: {Ti.a1.t.check2(ok, tt) == Done{t} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> {tt == t : Ti.Asn1Time}:
  match ok:
    case True{}:
      PS.sx.dd(Ti.Asn1Time, tt, t, e)
    case False{}:
      Empty.absurd({tt == t : Ti.Asn1Time}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, t, e))

def pd.c2z(ok: Bool, +tt: Ti.Asn1Time, -t: Ti.Asn1Time, +hok: {Bool.and(Ti.Asn1Time.valid(tt), R.a1.when(True{}, Ti.a1.t.zulu(Ti.Asn1Time.zone(tt)))) == ok : Bool}, +e: {Ti.a1.t.check2(ok, tt) == Done{t} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> {Ti.a1.t.zulu(Ti.Asn1Time.zone(tt)) == True{} : Bool}:
  match ok:
    case True{}:
      AN.an.and_r(Ti.Asn1Time.valid(tt), Ti.a1.t.zulu(Ti.Asn1Time.zone(tt)), hok)
    case False{}:
      Empty.absurd({Ti.a1.t.zulu(Ti.Asn1Time.zone(tt)) == True{} : Bool}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, t, e))

# under DER, a UTCTime's zone read must be Zulu time
def pd.zone_needs(mz: Maybe<&2, Ti.Asn1Zone>, +pivot: Nat, +f0: Nat, +f1: Nat, +f2: Nat, +f3: Nat, +f4: Nat, +sv: Nat, -t: Ti.Asn1Time, +e: {Ti.a1.t.check(True{}, Ti.a1.utc.zone(pivot, [f0, f1, f2, f3, f4], sv, mz)) == Done{t} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> {pd.mz(mz) == True{} : Bool}:
  match mz:
    case None{}:
      Empty.absurd({False{} == True{} : Bool}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, t, e))
    case Some{+z}:
      +tt : Ti.Asn1Time = Ti.Asn1Time{Ti.a1.utc.year(f0, pivot), f1, f2, f3, f4, sv, Nil{}, z}
      pd.c2z(Bool.and(Ti.Asn1Time.valid(tt), R.a1.when(True{}, Ti.a1.t.zulu(Ti.Asn1Time.zone(tt)))), tt, t, {==}, e)

def pd.off_no(+s: Maybe<&2, Bool>, +m: Maybe<&2, Ti.A1TNums>, +pivot: Nat, +f0: Nat, +f1: Nat, +f2: Nat, +f3: Nat, +f4: Nat, +sv: Nat, -t: Ti.Asn1Time, +e: {Ti.a1.t.check(True{}, Ti.a1.utc.zone(pivot, [f0, f1, f2, f3, f4], sv, Ti.a1.t.off(s, m))) == Done{t} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> Empty:
  AN.an.ft(Equal.trans(Bool, False{}, pd.mz(Ti.a1.t.off(s, m)), True{}, Equal.sym(Bool, pd.mz(Ti.a1.t.off(s, m)), False{}, pd.off_nz(s, m)), pd.zone_needs(Ti.a1.t.off(s, m), pivot, f0, f1, f2, f3, f4, sv, t, e)))

# GeneralizedTime: what DER lets through after the seconds

def pd.or_f(b: Bool) -> {Bool.or(b, False{}) == b : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

# a time with no fraction of a second
def pd.nofrac(tt: Ti.Asn1Time) -> Bool:
  match tt:
    case Ti.Asn1Time{y, mo, d, h, mi, s, f, z}:
      List.is_empty(&2, Nat, f)

def pd.gzone_needs(mz: Maybe<&2, Ti.Asn1Zone>, +y: Nat, +mo: Nat, +d: Nat, +h: Nat, +mi: Nat, +sv: Nat, -tt: Ti.Asn1Time, +e: {Ti.a1.t.check(True{}, Ti.a1.gen.mk(True{}, y, mo, d, h, mi, sv, Nil{}, mz)) == Done{tt} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> {pd.mz(mz) == True{} : Bool}:
  match mz:
    case None{}:
      Empty.absurd({False{} == True{} : Bool}, PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e))
    case Some{+z}:
      +t0 : Ti.Asn1Time = Ti.Asn1Time{y, mo, d, h, mi, sv, Nil{}, z}
      pd.c2z(Bool.and(Ti.Asn1Time.valid(t0), R.a1.when(True{}, Ti.a1.t.zulu(Ti.Asn1Time.zone(t0)))), t0, tt, {==}, e)

def pd.goff_no(+s: Maybe<&2, Bool>, +m: Maybe<&2, Ti.A1TNums>, +y: Nat, +mo: Nat, +d: Nat, +h: Nat, +mi: Nat, +sv: Nat, -tt: Ti.Asn1Time, +e: {Ti.a1.t.check(True{}, Ti.a1.gen.mk(True{}, y, mo, d, h, mi, sv, Nil{}, Ti.a1.t.off(s, m))) == Done{tt} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> Empty:
  AN.an.ft(Equal.trans(Bool, False{}, pd.mz(Ti.a1.t.off(s, m)), True{}, Equal.sym(Bool, pd.mz(Ti.a1.t.off(s, m)), False{}, pd.off_nz(s, m)), pd.gzone_needs(Ti.a1.t.off(s, m), y, mo, d, h, mi, sv, tt, e)))

def pd.mk_ne(okd: Bool, mz: Maybe<&2, Ti.Asn1Zone>, +y: Nat, +mo: Nat, +d: Nat, +h: Nat, +mi: Nat, +sv: Nat, +dd: Nat, +dt: List<&2, Nat>, -tt: Ti.Asn1Time, +hn: {pd.nofrac(tt) == True{} : Bool}, +e: {Ti.a1.t.check(True{}, Ti.a1.gen.mk(okd, y, mo, d, h, mi, sv, Con{dd, dt}, mz)) == Done{tt} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> Empty:
  match okd:
    case True{}:
      match mz:
        case None{}:
          PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e)
        case Some{+z}:
          +t0 : Ti.Asn1Time = Ti.Asn1Time{y, mo, d, h, mi, sv, Con{dd, dt}, z}
          +et = pd.c2t(Bool.and(Ti.Asn1Time.valid(t0), R.a1.when(True{}, Ti.a1.t.zulu(Ti.Asn1Time.zone(t0)))), t0, tt, {==}, e)
          AN.an.ft(Equal.trans(Bool, False{}, pd.nofrac(tt), True{}, Equal.cong(Ti.Asn1Time, Bool, x => pd.nofrac(x), t0, tt, et), hn))
    case False{}:
      PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e)

# a fraction of a second read: the time has one
def pd.gen_run(res: Ti.A1TNums, +v0: Nat, +v1: Nat, +v2: Nat, +v3: Nat, +v4: Nat, +v5: Nat, +v6: Nat, +t7: List<&2, U32>, -tt: Ti.Asn1Time, +hn: {pd.nofrac(tt) == True{} : Bool}, +e: {Ti.a1.t.check(True{}, Ti.a1.gen.finish(True{}, Ti.a1.gen.frac.put(res, Ti.A1Gen{[v0, v1, v2, v3, v4], v5, v6, True{}, True{}, Nil{}, t7, True{}}))) == Done{tt} : Result<&2, &2, E.Asn1Error, Ti.Asn1Time>}) -> Empty:
  match res:
    case Ti.A1TNums{ds, +r2}:
      match ds:
        case Nil{}:
          PS.sx.fd(Ti.Asn1Time, E.Asn1BadTime{}, tt, e)
        case Con{+dd, +dt}:
          pd.mk_ne(Ti.a1.gen.der_ok(Ti.A1Gen{[v0, v1, v2, v3, v4], v5, v6, True{}, True{}, Con{dd, dt}, r2, True{}}), Ti.a1.t.zone(r2, False{}, True{}), Nat.add(Nat.mul(v0, 100n), v1), v2, v3, v4, v5, v6, dd, dt, tt, hn, e)

# generated by gen/gen_tstrict.py

# the writer's characters for the time read are the characters read
def pd.utc_w(+p0: U32, +q0: U32, +p1: U32, +q1: U32, +p2: U32, +q2: U32, +p3: U32, +q3: U32, +p4: U32, +q4: U32, +p5: U32, +q5: U32, +pivot: Nat, +hd: {Bool.and(Bool.and(Bool.and(Bool.and(Bool.and(Ti.a1.t.dig(p0), Ti.a1.t.dig(q0)), Bool.and(Ti.a1.t.dig(p1), Ti.a1.t.dig(q1))), Bool.and(Ti.a1.t.dig(p2), Ti.a1.t.dig(q2))), Bool.and(Ti.a1.t.dig(p3), Ti.a1.t.dig(q3))), Bool.and(Ti.a1.t.dig(p4), Ti.a1.t.dig(q4))) == True{} : Bool}, +hd5: {Bool.and(Ti.a1.t.dig(p5), Ti.a1.t.dig(q5)) == True{} : Bool}) -> {Ti.a1.t.app(Ti.a1.t.d2(Nat.mod(Ti.a1.utc.year(Nat.add(Nat.mul(Ti.a1.t.val(p0), 10n), Ti.a1.t.val(q0)), pivot), 100n)), Ti.a1.t.app(Ti.a1.t.d2(Nat.add(Nat.mul(Ti.a1.t.val(p1), 10n), Ti.a1.t.val(q1))), Ti.a1.t.app(Ti.a1.t.d2(Nat.add(Nat.mul(Ti.a1.t.val(p2), 10n), Ti.a1.t.val(q2))), Ti.a1.t.app(Ti.a1.t.d2(Nat.add(Nat.mul(Ti.a1.t.val(p3), 10n), Ti.a1.t.val(q3))), Ti.a1.t.app(Ti.a1.t.d2(Nat.add(Nat.mul(Ti.a1.t.val(p4), 10n), Ti.a1.t.val(q4))), Ti.a1.t.app(Ti.a1.t.d2(Nat.add(Nat.mul(Ti.a1.t.val(p5), 10n), Ti.a1.t.val(q5))), [90])))))) == Con{p0, Con{q0, Con{p1, Con{q1, Con{p2, Con{q2, Con{p3, Con{q3, Con{p4, Con{q4, Con{p5, Con{q5, [90]}}}}}}}}}}}} : List<&2, U32>}:
  +g4 = AN.an.and_r(Bool.and(Bool.and(Bool.and(Bool.and(Ti.a1.t.dig(p0), Ti.a1.t.dig(q0)), Bool.and(Ti.a1.t.dig(p1), Ti.a1.t.dig(q1))), Bool.and(Ti.a1.t.dig(p2), Ti.a1.t.dig(q2))), Bool.and(Ti.a1.t.dig(p3), Ti.a1.t.dig(q3))), Bool.and(Ti.a1.t.dig(p4), Ti.a1.t.dig(q4)), hd)
  +k3 = AN.an.and_l(Bool.and(Bool.and(Bool.and(Bool.and(Ti.a1.t.dig(p0), Ti.a1.t.dig(q0)), Bool.and(Ti.a1.t.dig(p1), Ti.a1.t.dig(q1))), Bool.and(Ti.a1.t.dig(p2), Ti.a1.t.dig(q2))), Bool.and(Ti.a1.t.dig(p3), Ti.a1.t.dig(q3))), Bool.and(Ti.a1.t.dig(p4), Ti.a1.t.dig(q4)), hd)
