      pc.t_0(b1, b2, b3, b4, b5, b6, b7)

# every octet: the checks answer as the tables do
def pc.oct(x: U32) -> {pc.chk(B.byte(x)) == pc.tbl(B.byte(x)) : PcCh}:
  match x:
    case U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, hi}}}}}}}}}:
      pc.t_x(c0, c1, c2, c3, c4, c5, c6, c7)
