# A, and A undone (22 steps)
def aria.diffuse(s: LcAriaSt) -> LcAriaSt:
  aria.d22(s)

def aria.undiffuse(s: LcAriaSt) -> LcAriaSt:
  aria.u22(s)
# END GENERATED: diffusion

# The substitution layers SL1 (SB1, SB2, SB3, SB4 in turn) and SL2 (SB3,
# SB4, SB1, SB2)
def aria.sl1(s: LcAriaSt) -> LcAriaSt:
  match s:
    case LcAriaSt{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}:
      LcAriaSt{aria.sb1(x0), aria.sb2(x1), aria.sb3(x2), aria.sb4(x3), aria.sb1(x4), aria.sb2(x5), aria.sb3(x6), aria.sb4(x7), aria.sb1(x8), aria.sb2(x9), aria.sb3(x10), aria.sb4(x11), aria.sb1(x12), aria.sb2(x13), aria.sb3(x14), aria.sb4(x15)}

def aria.sl2(s: LcAriaSt) -> LcAriaSt:
  match s:
    case LcAriaSt{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}:
      LcAriaSt{aria.sb3(x0), aria.sb4(x1), aria.sb1(x2), aria.sb2(x3), aria.sb3(x4), aria.sb4(x5), aria.sb1(x6), aria.sb2(x7), aria.sb3(x8), aria.sb4(x9), aria.sb1(x10), aria.sb2(x11), aria.sb3(x12), aria.sb4(x13), aria.sb1(x14), aria.sb2(x15)}

# Blocks and states: a word's bytes, most significant first, by bit slicing

def aria.byte0(x: Word(32n)) -> Word(8n):
  W.W64.bits.hi(8n, 8n, W.W64.bits.hi(8n, 16n, W.W64.bits.hi(8n, 24n, x)))

def aria.byte1(x: Word(32n)) -> Word(8n):
  W.W64.bits.lo(8n, 8n, W.W64.bits.hi(8n, 16n, W.W64.bits.hi(8n, 24n, x)))

def aria.byte2(x: Word(32n)) -> Word(8n):
  W.W64.bits.lo(8n, 16n, W.W64.bits.hi(8n, 24n, x))

def aria.byte3(x: Word(32n)) -> Word(8n):
  W.W64.bits.lo(8n, 24n, x)

# the word with bytes a (most significant), b, c, d
def aria.word(a: Word(8n), b: Word(8n), c: Word(8n), d: Word(8n)) -> U32:
  U32{W.W64.bits.cat(8n, 24n, d, W.W64.bits.cat(8n, 16n, c, W.W64.bits.cat(8n, 8n, b, a)))}

# a word's four bytes (internal)
type LcAriaQ is Data:
  LcAriaQ{a: Word(8n), b: Word(8n), c: Word(8n), d: Word(8n)}

def aria.quad(w: U32) -> LcAriaQ:
  match w:
    case U32{+x}:
      LcAriaQ{aria.byte0(x), aria.byte1(x), aria.byte2(x), aria.byte3(x)}

def aria.of_quads(q0: LcAriaQ, q1: LcAriaQ, q2: LcAriaQ, q3: LcAriaQ) -> LcAriaSt:
  match q0 q1 q2 q3:
    case LcAriaQ{x0, x1, x2, x3} LcAriaQ{x4, x5, x6, x7} LcAriaQ{x8, x9, x10, x11} LcAriaQ{x12, x13, x14, x15}:
      LcAriaSt{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}

# four bytes XORed with the bytes of a round key's word
def aria.xq(x0: Word(8n), x1: Word(8n), x2: Word(8n), x3: Word(8n), w: U32) -> LcAriaQ:
  match w:
    case U32{+k}:
      LcAriaQ{Word.xor(8n, x0, aria.byte0(k)), Word.xor(8n, x1, aria.byte1(k)), Word.xor(8n, x2, aria.byte2(k)), Word.xor(8n, x3, aria.byte3(k))}

# The state XORed with a round key, kept as a block (a word at a time: Bend's
# C backend takes at most 247 live one-word values, and a state is 128 bits)
def aria.xor(s: LcAriaSt, k: M.CmBlock) -> LcAriaSt:
  match s k:
    case LcAriaSt{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15} M.CmBlock{w0, w1, w2, w3}:
      aria.of_quads(aria.xq(x0, x1, x2, x3, w0), aria.xq(x4, x5, x6, x7, w1), aria.xq(x8, x9, x10, x11, w2), aria.xq(x12, x13, x14, x15, w3))

def aria.of_block(b: M.CmBlock) -> LcAriaSt:
  match b:
    case M.CmBlock{w0, w1, w2, w3}:
      aria.of_quads(aria.quad(w0), aria.quad(w1), aria.quad(w2), aria.quad(w3))

def aria.to_block(s: LcAriaSt) -> M.CmBlock:
  match s:
    case LcAriaSt{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}:
      M.CmBlock{aria.word(x0, x1, x2, x3), aria.word(x4, x5, x6, x7), aria.word(x8, x9, x10, x11), aria.word(x12, x13, x14, x15)}

# The steps of the cipher (internal)
type LcAriaOp is Data:
  LcAriaRk{k: M.CmBlock}
  LcAriaSl1{}
  LcAriaSl2{}
  LcAriaDiff{}

def aria.op(o: LcAriaOp, s: LcAriaSt) -> LcAriaSt:
  match o:
    case LcAriaRk{k}:
      aria.xor(s, k)
    case LcAriaSl1{}:
      aria.sl1(s)
    case LcAriaSl2{}:
      aria.sl2(s)
    case LcAriaDiff{}:
      aria.diffuse(s)

def aria.unop(o: LcAriaOp, s: LcAriaSt) -> LcAriaSt:
  match o:
    case LcAriaRk{k}:
      aria.xor(s, k)
    case LcAriaSl1{}:
      aria.sl2(s)
    case LcAriaSl2{}:
      aria.sl1(s)
    case LcAriaDiff{}:
      aria.undiffuse(s)

def aria.run(os: List<&2, LcAriaOp>, s: LcAriaSt) -> LcAriaSt:
  match os:
    case Nil{}:
      s
    case Con{o, t}:
      aria.run(t, aria.op(o, s))

def aria.unrun(os: List<&2, LcAriaOp>, s: LcAriaSt) -> LcAriaSt:
  match os:
    case Nil{}:
      s
    case Con{o, t}:
      aria.unop(o, aria.unrun(t, s))

# The key schedule (RFC 5794, 2.2), on blocks

# C1, C2, C3: the fractional part of 1/pi
def aria.c(i: Nat) -> M.CmBlock:
  match i:
    case 0n:
      M.CmBlock{1367130551, 656542356, 4262702056, 4204424928}
    case 1n:
      M.CmBlock{1840335564, 2653014048, 4280857045, 4015907504}
    case _:
      M.CmBlock{3683792669, 556198256, 52729717, 82364686}

def aria.fo(+d: M.CmBlock, +rk: M.CmBlock) -> M.CmBlock:
  aria.to_block(aria.diffuse(aria.sl1(aria.of_block(M.CmBlock.xor(d, rk)))))

def aria.fe(+d: M.CmBlock, +rk: M.CmBlock) -> M.CmBlock:
  aria.to_block(aria.diffuse(aria.sl2(aria.of_block(M.CmBlock.xor(d, rk)))))

# the 128-bit block rotated right by n bits (n below 128)
def aria.rotw(b: M.CmBlock) -> M.CmBlock:
  match b:
    case M.CmBlock{a, c, d, e}:
      M.CmBlock{e, a, c, d}

def aria.rotw.n(n: Nat, b: M.CmBlock) -> M.CmBlock:
  match n:
    case 0n:
      b
    case 1n+p:
      aria.rotw.n(p, aria.rotw(b))

def aria.rotb(+r: Nat, b: M.CmBlock) -> M.CmBlock:
  match b:
    case M.CmBlock{+a, +c, +d, +e}:
      +l = Nat.sub(32n, r)
      M.CmBlock{U32.or(U32.shrn(a, r), U32.shln(e, l)), U32.or(U32.shrn(c, r), U32.shln(a, l)), U32.or(U32.shrn(d, r), U32.shln(c, l)), U32.or(U32.shrn(e, r), U32.shln(d, l))}

def aria.rotr(+n: Nat, b: M.CmBlock) -> M.CmBlock:
  aria.rotb(Nat.mod(n, 32n), aria.rotw.n(Nat.div(n, 32n), b))

# the four rotated round keys of one rotation: W0 xor (W1 >>> r), ...
def aria.ek4(+r: Nat, +w0: M.CmBlock, +w1: M.CmBlock, +w2: M.CmBlock, +w3: M.CmBlock) -> List<&2, M.CmBlock>:
  [M.CmBlock.xor(w0, aria.rotr(r, w1)), M.CmBlock.xor(w1, aria.rotr(r, w2)), M.CmBlock.xor(w2, aria.rotr(r, w3)), M.CmBlock.xor(aria.rotr(r, w0), w3)]

def aria.append(xs: List<&2, M.CmBlock>, ys: List<&2, M.CmBlock>) -> List<&2, M.CmBlock>:
  match xs:
    case Nil{}:
      ys
    case Con{h, t}:
      Con{h, aria.append(t, ys)}

# ek1 .. ek17 from W0 .. W3 (>>> 19, >>> 31, <<< 61, <<< 31, <<< 19)
def aria.eks(+w0: M.CmBlock, +w1: M.CmBlock, +w2: M.CmBlock, +w3: M.CmBlock) -> List<&2, M.CmBlock>:
  aria.append(aria.ek4(19n, w0, w1, w2, w3), aria.append(aria.ek4(31n, w0, w1, w2, w3), aria.append(aria.ek4(67n, w0, w1, w2, w3), aria.append(aria.ek4(97n, w0, w1, w2, w3), [M.CmBlock.xor(w0, aria.rotr(109n, w1))]))))

# the steps of the rounds from round i (odd True for odd rounds), n rounds
# but the last left, round keys eks
def aria.ops(n: Nat, eks: List<&2, M.CmBlock>, odd: Bool) -> List<&2, LcAriaOp>:
  match n eks:
    case 0n Con{k1, Con{k2, rest}}:
      [LcAriaRk{k1}, LcAriaSl2{}, LcAriaRk{k2}]
    case 1n+p Con{k, rest}:
      match odd:
        case True{}:
          Con{LcAriaRk{k}, Con{LcAriaSl1{}, Con{LcAriaDiff{}, aria.ops(p, rest, False{})}}}
        case False{}:
          Con{LcAriaRk{k}, Con{LcAriaSl2{}, Con{LcAriaDiff{}, aria.ops(p, rest, True{})}}}
    case _ _:
      Nil{}

# a block of 16 bytes from offset i of xs
def aria.block(+xs: List<&2, U32>, +i: Nat) -> M.CmBlock:
  M.CmBlock{L.lc.be(L.lc.at(xs, i), L.lc.at(xs, Nat.add(i, 1n)), L.lc.at(xs, Nat.add(i, 2n)), L.lc.at(xs, Nat.add(i, 3n))), L.lc.be(L.lc.at(xs, Nat.add(i, 4n)), L.lc.at(xs, Nat.add(i, 5n)), L.lc.at(xs, Nat.add(i, 6n)), L.lc.at(xs, Nat.add(i, 7n))), L.lc.be(L.lc.at(xs, Nat.add(i, 8n)), L.lc.at(xs, Nat.add(i, 9n)), L.lc.at(xs, Nat.add(i, 10n)), L.lc.at(xs, Nat.add(i, 11n))), L.lc.be(L.lc.at(xs, Nat.add(i, 12n)), L.lc.at(xs, Nat.add(i, 13n)), L.lc.at(xs, Nat.add(i, 14n)), L.lc.at(xs, Nat.add(i, 15n)))}

# W0 .. W3 and the round keys, for CK1, CK2, CK3 = C(c1), C(c2), C(c3)
def aria.ws(+kl: M.CmBlock, +kr: M.CmBlock, c1: Nat, c2: Nat, c3: Nat) -> List<&2, M.CmBlock>:
  +w1 = M.CmBlock.xor(aria.fo(kl, aria.c(c1)), kr)
  +w2 = M.CmBlock.xor(aria.fe(w1, aria.c(c2)), kl)
  +w3 = M.CmBlock.xor(aria.fo(w2, aria.c(c3)), w1)
  aria.eks(kl, w1, w2, w3)

# An ARIA key: the steps of the cipher (opaque; built by LcAria.key)
type LcAriaKey is Data:
  LcAriaKey{ops: List<&2, LcAriaOp>}

def aria.key(n16: Bool, n24: Bool, +xs: List<&2, U32>) -> LcAriaKey:
  match n16 n24:
    case True{} _:
      LcAriaKey{aria.ops(11n, aria.ws(aria.block(xs, 0n), aria.block(xs, 16n), 0n, 1n, 2n), True{})}
    case False{} True{}:
      LcAriaKey{aria.ops(13n, aria.ws(aria.block(xs, 0n), aria.block(xs, 16n), 1n, 2n, 0n), True{})}
    case False{} False{}:
      LcAriaKey{aria.ops(15n, aria.ws(aria.block(xs, 0n), aria.block(xs, 16n), 2n, 0n, 1n), True{})}

def aria.key.pick(ok: Bool, n16: Bool, n24: Bool, +n: Nat, +xs: List<&2, U32>) -> Result<&2, &2, L.LcError, LcAriaKey>:
  match ok:
    case True{}:
      Done{aria.key(n16, n24, B.append(xs, B.zeros(Nat.sub(32n, n))))}
    case False{}:
      Fail{L.LcBadKeyLength{n}}

# The cipher

# a key of 16, 24 or 32 bytes (ARIA-128, -192, -256, by its length)
def LcAria.key(o: B.Octets) -> Result<&2, &2, L.LcError, LcAriaKey>:
  +xs = B.Octets.to_list(o)
  +n = B.len(xs)
  aria.key.pick(Bool.or(Nat.is_eq(n, 16n), Bool.or(Nat.is_eq(n, 24n), Nat.is_eq(n, 32n))), Nat.is_eq(n, 16n), Nat.is_eq(n, 24n), n, xs)

def LcAria.encrypt(k: LcAriaKey, b: M.CmBlock) -> M.CmBlock:
  match k:
    case LcAriaKey{ops}:
      aria.to_block(aria.run(ops, aria.of_block(b)))

def LcAria.decrypt(k: LcAriaKey, b: M.CmBlock) -> M.CmBlock:
  match k:
    case LcAriaKey{ops}:
      aria.to_block(aria.unrun(ops, aria.of_block(b)))
