      LcAriaSt{x0, Word.xor(8n, x1, x2), x2, x3, Word.xor(8n, x4, x2), Word.xor(8n, x5, x2), Word.xor(8n, x6, x2), Word.xor(8n, x7, x2), Word.xor(8n, x8, x2), Word.xor(8n, x9, x2), Word.xor(8n, x10, x2), Word.xor(8n, x11, x2), x12, x13, x14, x15}

def aria.e18(s: LcAriaSt) -> LcAriaSt:
  match s:
    case LcAriaSt{x0, +x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}:
      LcAriaSt{x0, x1, Word.xor(8n, x2, x1), x3, x4, Word.xor(8n, x5, x1), x6, Word.xor(8n, x7, x1), Word.xor(8n, x8, x1), Word.xor(8n, x9, x1), x10, x11, Word.xor(8n, x12, x1), x13, x14, Word.xor(8n, x15, x1)}

def aria.e19(s: LcAriaSt) -> LcAriaSt:
  match s:
    case LcAriaSt{x0, x1, +x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}:
      LcAriaSt{x0, Word.xor(8n, x1, x2), x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}

def aria.e20(s: LcAriaSt) -> LcAriaSt:
  match s:
    case LcAriaSt{+x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}:
      LcAriaSt{x0, x1, x2, Word.xor(8n, x3, x0), Word.xor(8n, x4, x0), x5, Word.xor(8n, x6, x0), x7, Word.xor(8n, x8, x0), Word.xor(8n, x9, x0), x10, x11, x12, Word.xor(8n, x13, x0), Word.xor(8n, x14, x0), x15}

def aria.e21(s: LcAriaSt) -> LcAriaSt:
  match s:
    case LcAriaSt{x0, x1, x2, +x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}:
      LcAriaSt{Word.xor(8n, x0, x3), x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}

# d<j>: the first j steps; u<j>: them undone, last first
def aria.d0(s: LcAriaSt) -> LcAriaSt:
  s

def aria.u0(s: LcAriaSt) -> LcAriaSt:
  s

def aria.d1(s: LcAriaSt) -> LcAriaSt:
  aria.e0(aria.d0(s))

def aria.u1(s: LcAriaSt) -> LcAriaSt:
