def rv.u0() -> {rv.upto(1n+126n, 0n) == True{} : Bool}:
  Equal.trans(Bool, rv.upto(1n+126n, 0n), Bool.and(rv.impi(0n), rv.upto(126n, 1n+0n)), True{}, rv.unf(126n, 0n), rv.and_i(rv.impi(0n), rv.upto(126n, 1n+0n), rv.c0(), rv.u1()))

def rv.d0() -> {rv.allimp(R.Oid.registry()) == True{} : Bool}:
  %rv.drop0(R.Oid.registry()) : {rv.allimp(_) == True{} : Bool}
  rv.bridge(127n, 0n, rv.u0(), {==})

# ---------------------------------------------------------------- the law

def Laws.entries_valid(i, e, h, hb):
  rv.found(R.Oid.registry(), i, e, rv.d0(), h, hb)
