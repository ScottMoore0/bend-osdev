def Laws.names_unique(i, j, e1, e2, h1, h2, h3):
  rp.uniqn(R.Oid.registry(), i, j, e1, e2, rp.dn0(), h1, h2, h3)

def Laws.arcs_unique(i, j, e1, e2, h1, h2, h3):
  rp.uniqa(R.Oid.registry(), i, j, e1, e2, rp.da0(), h1, h2, h3)

def Laws.lookup_found(i, e, h):
  rp.founda(R.Oid.registry(), i, e, rp.da0(), h)

