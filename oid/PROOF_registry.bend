  Equal.trans(Bool, rp.uptoa(1n+124n, 2n), Bool.and(rp.allai(2n, List.drop(&2, R.OidEntry, R.Oid.registry(), 1n+2n)), rp.uptoa(124n, 1n+2n)), True{}, rp.unfa(124n, 2n), rp.and_i(rp.allai(2n, List.drop(&2, R.OidEntry, R.Oid.registry(), 1n+2n)), rp.uptoa(124n, 1n+2n), rp.ca2(), rp.ua3()))

def rp.ca1() -> {rp.allai(1n, List.drop(&2, R.OidEntry, R.Oid.registry(), 1n+1n)) == True{} : Bool}:
  {==}

def rp.ua1() -> {rp.uptoa(1n+125n, 1n) == True{} : Bool}:
  Equal.trans(Bool, rp.uptoa(1n+125n, 1n), Bool.and(rp.allai(1n, List.drop(&2, R.OidEntry, R.Oid.registry(), 1n+1n)), rp.uptoa(125n, 1n+1n)), True{}, rp.unfa(125n, 1n), rp.and_i(rp.allai(1n, List.drop(&2, R.OidEntry, R.Oid.registry(), 1n+1n)), rp.uptoa(125n, 1n+1n), rp.ca1(), rp.ua2()))

def rp.ca0() -> {rp.allai(0n, List.drop(&2, R.OidEntry, R.Oid.registry(), 1n+0n)) == True{} : Bool}:
  {==}

def rp.ua0() -> {rp.uptoa(1n+126n, 0n) == True{} : Bool}:
  Equal.trans(Bool, rp.uptoa(1n+126n, 0n), Bool.and(rp.allai(0n, List.drop(&2, R.OidEntry, R.Oid.registry(), 1n+0n)), rp.uptoa(126n, 1n+0n)), True{}, rp.unfa(126n, 0n), rp.and_i(rp.allai(0n, List.drop(&2, R.OidEntry, R.Oid.registry(), 1n+0n)), rp.uptoa(126n, 1n+0n), rp.ca0(), rp.ua1()))

def rp.da0() -> {rp.dista(R.Oid.registry()) == True{} : Bool}:
  %rp.drop0(R.Oid.registry()) : {rp.dista(_) == True{} : Bool}
  rp.bridgea(127n, 0n, rp.ua0(), {==})

