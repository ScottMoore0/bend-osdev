# ---------------------------------------------------------------- the registry, entry by entry

def rp.lt_add(k: Nat, +m: Nat) -> {Nat.is_lt(k, Nat.add(k, 1n+m)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      rp.lt_add(p, m)

def rp.drop_len(xs: List<&2, R.OidEntry>) -> {List.drop(&2, R.OidEntry, xs, List.length(&2, R.OidEntry, xs)) == Nil{} : List<&2, R.OidEntry>}:
  match xs:
    case Nil{}:
      {==}
    case Con{f, t}:
      rp.drop_len(t)

# the entries from position k on, n of them, each against those after it
def rp.upton(n: Nat, +k: Nat) -> Bool:
  match n:
    case 0n:
      True{}
    case 1n+m:
      Bool.and(rp.allni(k, List.drop(&2, R.OidEntry, R.Oid.registry(), 1n+k)), rp.upton(m, 1n+k))

# the positions' checks give the list's
