# The laws of ecrdsa.
#
# For every curve and input: a public key read from bytes (RFC 4491's form,
# x then y little-endian) is read again, the same, from the bytes
# Ecrdsa.public_to writes for it (public_round_trip).
#
# Small-parameter exhaustive laws (generated by gen/exhaustive.py, with
# their proofs), on the curve y^2 = x^3 + 2x + 7 over GF(11) whose base
# point (6, 2) has prime order 7 (ecrdsalaw.toy): every GOST R 34.10-2012
# signature made with a private key d in [1, 6] and a per-message secret k
# in [1, 6], for the message value e = 3, verifies under d's public key (a
# k that gives r = 0 or s = 0 is refused).
#
# That every signature verifies for every key of every curve is number
# theory (the group law), not proved here; check.bend runs RFC 7091's
# test example (section 7: public key, r and s) and ref/run.sh tests the
# named curves against this package's model of RFC 7091 in ref/gen.py.
import Base
import ../bytes/bytes.bend as B
import ../bignum/bignum.bend as N
import ../ecc/ecc.bend as E
import ../ecc/ecdsa.bend as S
import ./ecrdsa.bend as G

def ecrdsalaw.nat1(+x: Nat) -> N.BnNat:
  N.BnNat.of_u32(U32.from_nat(Nat.add(x, 1n)))

# the toy curve: y^2 = x^3 + 2x + 7 over GF(11), G = (6, 2) of order 7
def ecrdsalaw.toy() -> E.EcCurve:
  E.EcCurve.of(E.EcParams{N.BnNat.of_u32(11), N.BnNat.of_u32(2), N.BnNat.of_u32(7), N.BnNat.of_u32(6), N.BnNat.of_u32(2), N.BnNat.of_u32(7), N.BnNat.of_u32(1)})

# whether a signing result verifies under q: true for a refused signature
def ecrdsalaw.verifies(+c: E.EcCurve, q: E.EcPoint, +e: N.BnNat, r: Result<&2, &2, G.EcrdsaError, S.EcSig>) -> Bool:
  match r:
    case Fail{x}:
      True{}
    case Done{s}:
      G.Ecrdsa.verify_e(c, q, e, s)

# whether the toy curve's signature of e = 3 with private key d and
# per-message secret k verifies under d's public key (or is refused)
def ecrdsalaw.signs_verify(+d: N.BnNat, +k: N.BnNat) -> Bool:
  +c = ecrdsalaw.toy()
  +e = N.BnNat.of_u32(3)
  ecrdsalaw.verifies(c, G.Ecrdsa.public(c, d), e, G.Ecrdsa.sign_e(c, d, e, k))

# Properties, for every input

law public_round_trip:
  for +c: E.EcCurve
  for +o: B.Octets
  {Result.bind(&2, &2, G.EcrdsaError, E.EcPoint, E.EcPoint, G.Ecrdsa.public_of(c, o), p => G.Ecrdsa.public_of(c, G.Ecrdsa.public_to(c, p))) == G.Ecrdsa.public_of(c, o) : Result<&2, &2, G.EcrdsaError, E.EcPoint>}

# Small-parameter exhaustive laws

# BEGIN GENERATED by gen/exhaustive.py: exhaustive
# on the toy curve (ecrdsalaw.toy), GOST R 34.10-2012: every signature of the
# message value e = 3 made with a private key d and a per-message secret k in
# [1, 6] verifies under d's public key (ecrdsalaw.signs_verify; a k that gives
# r = 0 or s = 0 is refused)
law toy_sign_verify:
  for d: Nat
  for k: Nat
  for hd: {Nat.is_lt(d, 6n) == True{} : Bool}
  for hk: {Nat.is_lt(k, 6n) == True{} : Bool}
  {ecrdsalaw.signs_verify(ecrdsalaw.nat1(d), ecrdsalaw.nat1(k)) == True{} : Bool}
# END GENERATED: exhaustive
