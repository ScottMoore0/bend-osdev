# Per-bit lemmas (generated: every combination of the bits at each position)

def bits.sub_refl(+n: Nat, +x: Word(n)) -> {C.CapBits.subset(n, x, x) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+n1:
      match x:
        case WCon{True{}, +xt}:
          bits.sub_refl(n1, xt)
        case WCon{False{}, +xt}:
          bits.sub_refl(n1, xt)

def bits.sub_zero(+n: Nat, +x: Word(n)) -> {C.CapBits.subset(n, Word.zero(n), x) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+n1:
      match x:
        case WCon{True{}, +xt}:
          bits.sub_zero(n1, xt)
        case WCon{False{}, +xt}:
          bits.sub_zero(n1, xt)

def bits.sub_or_r(+n: Nat, +x: Word(n), +c: Word(n)) -> {C.CapBits.subset(n, c, Word.or(n, x, c)) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+n1:
      match x c:
        case WCon{True{}, +xt} WCon{True{}, +ct}:
          bits.sub_or_r(n1, xt, ct)
        case WCon{True{}, +xt} WCon{False{}, +ct}:
          bits.sub_or_r(n1, xt, ct)
        case WCon{False{}, +xt} WCon{True{}, +ct}:
          bits.sub_or_r(n1, xt, ct)
        case WCon{False{}, +xt} WCon{False{}, +ct}:
          bits.sub_or_r(n1, xt, ct)

def bits.sub_and_l(+n: Nat, +x: Word(n), +y: Word(n)) -> {C.CapBits.subset(n, Word.and(n, x, y), x) == True{} : Bool}:
