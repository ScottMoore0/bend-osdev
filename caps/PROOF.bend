import Base
import ./caps.bend as C
import ./exec.bend as E
import ./adjust.bend as A
import ./LAWS.bend as Laws

# Every set operation works bit by bit, so each fact about sets is proved by
# induction on the width n: at each bit, every combination of the bits
# involved either satisfies the fact (and the rest is the induction
# hypothesis) or contradicts a hypothesis. The laws then follow by
# unfolding the operations and choosing which lemma each case needs.
# Hypotheses are taken as arguments after the match ("convoy" style), so
# that matching on a value refines them too.

# Contradictions

def bits.disc(b: Bool) -> Type:
  match b:
    case False{}:
      Unit
    case True{}:
      Empty

def bits.disc2(b: Bool) -> Type:
  match b:
    case False{}:
      Empty
    case True{}:
      Unit

def bits.ft(+e: {False{} == True{} : Bool}) -> bits.disc(True{}):
  %e : bits.disc(_)
  Unit{}

def bits.tf(+e: {True{} == False{} : Bool}) -> bits.disc2(False{}):
  %e : bits.disc2(_)
  Unit{}

def bits.absurd(-x: Bool, +e: {False{} == True{} : Bool}) -> {x == True{} : Bool}:
  Empty.absurd({x == True{} : Bool}, bits.ft(e))

def bits.absurd_eq(-T: Type, -x: T, -y: T, +e: {False{} == True{} : Bool}) -> {x == y : T}:
  Empty.absurd({x == y : T}, bits.ft(e))

def bits.absurd_tf(-T: Type, -x: T, -y: T, +e: {True{} == False{} : Bool}) -> {x == y : T}:
  Empty.absurd({x == y : T}, bits.tf(e))

# Conjunctions

def bool.and_l(+x: Bool, +y: Bool) -> {Bool.and(x, y) == True{} : Bool} -> {x == True{} : Bool}:
  match x:
    case True{}:
      h => {==}
    case False{}:
      h => bits.absurd(False{}, h)

def bool.and_r(+x: Bool, +y: Bool) -> {Bool.and(x, y) == True{} : Bool} -> {y == True{} : Bool}:
  match x:
    case True{}:
      h => h
    case False{}:
      h => bits.absurd(y, h)

def bool.and3(+x: Bool, +y: Bool, +z: Bool) -> {x == True{} : Bool} -> {y == True{} : Bool} -> {z == True{} : Bool} -> {Bool.and(x, Bool.and(y, z)) == True{} : Bool}:
  match x y z:
    case True{} True{} True{}:
      hx => hy => hz => {==}
    case False{} y z:
      hx => hy => hz => bits.absurd(Bool.and(False{}, Bool.and(y, z)), hx)
    case True{} False{} z:
      hx => hy => hz => bits.absurd(Bool.and(True{}, Bool.and(False{}, z)), hy)
    case True{} True{} False{}:
      hx => hy => hz => bits.absurd(False{}, hz)

# A state is valid exactly when its three subset tests pass

def valid.intro(+s: C.CapState) -> {C.CapSet.subset(C.CapState.effective(s), C.CapState.permitted(s)) == True{} : Bool} -> {C.CapSet.subset(C.CapState.ambient(s), C.CapState.permitted(s)) == True{} : Bool} -> {C.CapSet.subset(C.CapState.ambient(s), C.CapState.inheritable(s)) == True{} : Bool} -> {C.CapState.valid(s) == True{} : Bool}:
  match s:
    case C.CapState{+p, +i, +e, +b, +a}:
      h1 => h2 => h3 => bool.and3(C.CapSet.subset(e, p), C.CapSet.subset(a, p), C.CapSet.subset(a, i))(h1)(h2)(h3)

def valid.ep(+s: C.CapState) -> {C.CapState.valid(s) == True{} : Bool} -> {C.CapSet.subset(C.CapState.effective(s), C.CapState.permitted(s)) == True{} : Bool}:
  match s:
    case C.CapState{+p, +i, +e, +b, +a}:
      h => bool.and_l(C.CapSet.subset(e, p), Bool.and(C.CapSet.subset(a, p), C.CapSet.subset(a, i)))(h)

def valid.ap(+s: C.CapState) -> {C.CapState.valid(s) == True{} : Bool} -> {C.CapSet.subset(C.CapState.ambient(s), C.CapState.permitted(s)) == True{} : Bool}:
  match s:
    case C.CapState{+p, +i, +e, +b, +a}:
      h => bool.and_l(C.CapSet.subset(a, p), C.CapSet.subset(a, i))(bool.and_r(C.CapSet.subset(e, p), Bool.and(C.CapSet.subset(a, p), C.CapSet.subset(a, i)))(h))

def valid.ai(+s: C.CapState) -> {C.CapState.valid(s) == True{} : Bool} -> {C.CapSet.subset(C.CapState.ambient(s), C.CapState.inheritable(s)) == True{} : Bool}:
  match s:
    case C.CapState{+p, +i, +e, +b, +a}:
      h => bool.and_r(C.CapSet.subset(a, p), C.CapSet.subset(a, i))(bool.and_r(C.CapSet.subset(e, p), Bool.and(C.CapSet.subset(a, p), C.CapSet.subset(a, i)))(h))

