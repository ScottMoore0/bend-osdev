def by.cg(c: Cmp, e: {Cmp.is_gt(c) == True{} : Bool}) -> {c == GT{} : Cmp}:
  match c:
    case LT{}:
      Empty.absurd({LT{} == GT{} : Cmp}, PL.bq.ft(e))
    case EQ{}:
      Empty.absurd({EQ{} == GT{} : Cmp}, PL.bq.ft(e))
    case GT{}:
      {==}

