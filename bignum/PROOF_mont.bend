def by.trv(+xs: List<&2, U32>, +k: Nat, +hx: {LL.bnlaw.ok(xs) == True{} : Bool}) -> {LL.bnlaw.val(Mt.bn.trim(k, xs)) == U.U32Nat.low(Nat.mul(k, 16n), LL.bnlaw.val(xs)) : Nat}:
