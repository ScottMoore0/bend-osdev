def by.mpkk(z: Bool, +sq: List<&2, U32>, +x: List<&2, U32>, +n: List<&2, U32>, +np: U32, +k: Nat, +hsq: {LL.bnlaw.ok(sq) == True{} : Bool}) -> {LL.bnlaw.ok(Mt.bn.mexp.pick(z, sq, x, n, np, k)) == True{} : Bool}:
