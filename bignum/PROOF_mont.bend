# Valid limbs without zeros on top are determined by their value

def by.nc0(z: Bool, +x: U32, ez: {U32.is_zero(x) == z : Bool}) -> {N.bn.norm(N.bn.lone(z, x)) == N.bn.lone(z, x) : List<&2, U32>}:
  match z:
    case True{}:
      {==}
    case False{}:
      Equal.cong(Bool, List<&2, U32>, zz => N.bn.lone(zz, x), U32.is_zero(x), False{}, ez)

def by.nc(r: List<&2, U32>, +x: U32, ih: {N.bn.norm(r) == r : List<&2, U32>}) -> {N.bn.norm(N.bn.cons(x, r)) == N.bn.cons(x, r) : List<&2, U32>}:
  match r:
    case Nil{}:
