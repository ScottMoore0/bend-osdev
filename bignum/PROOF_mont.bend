def by.mgk(es: List<&2, U32>, +acc: List<&2, U32>, +x: List<&2, U32>, +n: List<&2, U32>, +np: U32, +k: Nat, +hacc: {LL.bnlaw.ok(acc) == True{} : Bool}) -> {LL.bnlaw.ok(Mt.bn.mexp.go(es, acc, x, n, np, k)) == True{} : Bool}:
