def by.csg(c: Cmp, +t: List<&2, U32>, +n: List<&2, U32>, +ht: {LL.bnlaw.ok(t) == True{} : Bool}, +hn: {LL.bnlaw.ok(n) == True{} : Bool}, +hlt: {Nat.is_lt(LL.bnlaw.val(t), Nat.double(LL.bnlaw.val(n))) == True{} : Bool}, ec: {Nat.cmp(LL.bnlaw.val(t), LL.bnlaw.val(n)) == c : Cmp}) -> {LL.bnlaw.val(Mt.bn.csub.go(N.bn.ge(c), t, n)) == Nat.mod(LL.bnlaw.val(t), LL.bnlaw.val(n)) : Nat}:
