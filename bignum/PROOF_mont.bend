def by.csgk(z: Bool, +t: List<&2, U32>, +n: List<&2, U32>, +ht: {LL.bnlaw.ok(t) == True{} : Bool}) -> {LL.bnlaw.ok(Mt.bn.csub.go(z, t, n)) == True{} : Bool}:
  match z:
    case True{}:
      PL.bq.sk(t, n, 0)
    case False{}:
      ht

