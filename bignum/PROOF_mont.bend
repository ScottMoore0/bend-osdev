    case EQ{}:
      by.csge(t, n, ht, hn, hlt, Equal.trans(Bool, Nat.is_le(LL.bnlaw.val(n), LL.bnlaw.val(t)), Nat.is_le(LL.bnlaw.val(n), LL.bnlaw.val(n)), True{}, Equal.cong(Nat, Bool, zz => Nat.is_le(LL.bnlaw.val(n), zz), LL.bnlaw.val(t), LL.bnlaw.val(n), Equal.sym(Nat, LL.bnlaw.val(n), LL.bnlaw.val(t), Equal.sym(Nat, LL.bnlaw.val(t), LL.bnlaw.val(n), PL.bq.ceq(LL.bnlaw.val(t), LL.bnlaw.val(n), ec)))), UL.nat_le_refl(LL.bnlaw.val(n))))
