def pr.c(n: Nat, k: Nat) -> Nat:
  match n k:
    case 0n 0n:
      1n
    case 0n 1n+ +j:
      0n
    case 1n+ +m 0n:
      1n
    case 1n+ +m 1n+ +j:
      Nat.add(pr.c(m, j), pr.c(m, 1n+j))

def pr.c0(+n: Nat) -> {pr.c(n, 0n) == 1n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+ +m:
      {==}

def pr.lts(+j: Nat) -> {Nat.is_lt(j, 1n+j) == True{} : Bool}:
  match j:
    case 0n:
      {==}
    case 1n+ +i:
      pr.lts(i)

# C(n, k) = 0 for k > n, and C(n, n) = 1
def pr.cbig(+n: Nat, +k: Nat, +h: {Nat.is_lt(n, k) == True{} : Bool}) -> {pr.c(n, k) == 0n : Nat}:
  match n k:
    case 0n 0n:
      Empty.absurd({pr.c(0n, 0n) == 0n : Nat}, PL.bq.ft(h))
    case 0n 1n+ +j:
      {==}
    case 1n+ +m 0n:
      Empty.absurd({pr.c(1n+m, 0n) == 0n : Nat}, PL.bq.ft(h))
    case 1n+ +m 1n+ +j:
      Equal.trans(Nat, Nat.add(pr.c(m, j), pr.c(m, 1n+j)), pr.c(m, 1n+j), 0n, Equal.cong(Nat, Nat, zz => Nat.add(zz, pr.c(m, 1n+j)), pr.c(m, j), 0n, pr.cbig(m, j, h)), pr.cbig(m, 1n+j, PL.bq.lt_trans(m, j, 1n+j, h, pr.lts(j))))

def pr.cn(+n: Nat) -> {pr.c(n, n) == 1n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+ +m:
      Equal.trans(Nat, Nat.add(pr.c(m, m), pr.c(m, 1n+m)), Nat.add(1n, pr.c(m, 1n+m)), 1n, Equal.cong(Nat, Nat, zz => Nat.add(zz, pr.c(m, 1n+m)), pr.c(m, m), 1n, pr.cn(m)), Equal.cong(Nat, Nat, zz => Nat.add(1n, zz), pr.c(m, 1n+m), 0n, pr.cbig(m, 1n+m, pr.lts(m))))

# absorption: (1 + k) C(1 + n, 1 + k) = (1 + n) C(n, k)
def pr.ab(+n: Nat, +k: Nat) -> {Nat.mul(1n+k, pr.c(1n+n, 1n+k)) == Nat.mul(1n+n, pr.c(n, k)) : Nat}:
  match n k:
    case 0n 0n:
      {==}
    case 0n 1n+ +j:
