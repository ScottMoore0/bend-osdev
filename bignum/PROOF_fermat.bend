    case 0n:
      Nat.mul(pr.c(n, 0n), Nat.pow(a, 0n))
    case 1n+ +i:
      Nat.add(pr.bs(n, a, i), Nat.mul(pr.c(n, 1n+i), Nat.pow(a, 1n+i)))

