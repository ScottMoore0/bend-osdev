# a prime p = 1 + n divides C(p, 1 + j) for j < n
def pr.pc(+n: Nat, +j: Nat, +hp: {Laws.bnlaw.prime(1n+n) == True{} : Bool}, hj: {Nat.is_lt(j, n) == True{} : Bool}) -> Sigma<&1, &1, Nat, kk => {Nat.mul(kk, 1n+n) == pr.c(1n+n, 1n+j) : Nat}>:
  pr.eu(1n+n, 1n+j, pr.c(1n+n, 1n+j), hp, {==}, hj, (pr.c(n, j), Equal.trans(Nat, Nat.mul(pr.c(n, j), 1n+n), Nat.mul(1n+n, pr.c(n, j)), Nat.mul(1n+j, pr.c(1n+n, 1n+j)), UL.nat_mul_comm(pr.c(n, j), 1n+n), Equal.sym(Nat, Nat.mul(1n+j, pr.c(1n+n, 1n+j)), Nat.mul(1n+n, pr.c(n, j)), pr.ab(n, j)))))

