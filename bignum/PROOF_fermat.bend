def pr.mid(k: Nat, +n: Nat, +a: Nat, +hp: {Laws.bnlaw.prime(1n+n) == True{} : Bool}, hk: {Nat.is_le(k, n) == True{} : Bool}) -> {Nat.mod(pr.bs(1n+n, a, k), 1n+n) == 1n : Nat}:
  match k:
    case 0n:
      PX.bx.msm(1n, 1n+n, PL.bq.and1(Nat.is_lt(1n, 1n+n), Laws.bnlaw.nodiv(Nat.sub(1n+n, 2n), 1n+n, 2n), hp))
