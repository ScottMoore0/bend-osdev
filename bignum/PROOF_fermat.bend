      +hi = PL.bq.le_lt(i, n, hk)
      pr.mid2(n, a, i, pr.pc(n, i, hp, hi), pr.mid(i, n, a, hp, PL.bq.lt_le(i, n, hi)))

# (1 + a)^p = 1 + a^p (mod p)
