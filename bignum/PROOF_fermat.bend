# a^p = a (mod p), by induction on a
def pr.fl(a: Nat, +n: Nat, +hp: {Laws.bnlaw.prime(1n+n) == True{} : Bool}) -> {Nat.mod(Nat.pow(a, 1n+n), 1n+n) == Nat.mod(a, 1n+n) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+ +b:
      Equal.trans(Nat, Nat.mod(Nat.pow(1n+b, 1n+n), 1n+n), Nat.mod(Nat.add(b, 1n), 1n+n), Nat.mod(1n+b, 1n+n), Equal.trans(Nat, Nat.mod(Nat.pow(1n+b, 1n+n), 1n+n), Nat.mod(Nat.add(Nat.mod(b, 1n+n), 1n), 1n+n), Nat.mod(Nat.add(b, 1n), 1n+n), Equal.trans(Nat, Nat.mod(Nat.pow(1n+b, 1n+n), 1n+n), Nat.mod(Nat.add(Nat.mod(Nat.pow(b, 1n+n), 1n+n), 1n), 1n+n), Nat.mod(Nat.add(Nat.mod(b, 1n+n), 1n), 1n+n), Equal.trans(Nat, Nat.mod(Nat.pow(1n+b, 1n+n), 1n+n), Nat.mod(Nat.add(Nat.pow(b, 1n+n), 1n), 1n+n), Nat.mod(Nat.add(Nat.mod(Nat.pow(b, 1n+n), 1n+n), 1n), 1n+n), Equal.trans(Nat, Nat.mod(Nat.pow(1n+b, 1n+n), 1n+n), Nat.mod(Nat.add(1n, Nat.pow(b, 1n+n)), 1n+n), Nat.mod(Nat.add(Nat.pow(b, 1n+n), 1n), 1n+n), pr.step(n, b, hp), Equal.cong(Nat, Nat, zz => Nat.mod(zz, 1n+n), Nat.add(1n, Nat.pow(b, 1n+n)), Nat.add(Nat.pow(b, 1n+n), 1n), pr.r11(Nat.pow(b, 1n+n)))), Equal.sym(Nat, Nat.mod(Nat.add(Nat.mod(Nat.pow(b, 1n+n), 1n+n), 1n), 1n+n), Nat.mod(Nat.add(Nat.pow(b, 1n+n), 1n), 1n+n), PX.bx.mal(Nat.pow(b, 1n+n), 1n, 1n+n, {==}))), Equal.cong(Nat, Nat, zz => Nat.mod(Nat.add(zz, 1n), 1n+n), Nat.mod(Nat.pow(b, 1n+n), 1n+n), Nat.mod(b, 1n+n), pr.fl(b, n, hp))), PX.bx.mal(b, 1n, 1n+n, {==})), Equal.cong(Nat, Nat, zz => Nat.mod(zz, 1n+n), Nat.add(b, 1n), 1n+b, pr.r12(b)))

def pr.top(+p: Nat, +a: Nat, hp: {Laws.bnlaw.prime(p) == True{} : Bool}) -> {Nat.mod(Nat.pow(a, p), p) == Nat.mod(a, p) : Nat}:
  match p:
    case 0n:
      Empty.absurd({Nat.mod(Nat.pow(a, 0n), 0n) == Nat.mod(a, 0n) : Nat}, PL.bq.ft(hp))
    case 1n+ +n:
      pr.fl(a, n, hp)

# The laws

def Laws.fermat(p, a, hp):
  pr.top(p, a, hp)

def Laws.prime_vector():
  {==}
