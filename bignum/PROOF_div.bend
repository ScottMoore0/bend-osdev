# The shifts: zeros below, shlb, shl, shl1 and shr1

# powers of two in the exact form the next step takes them (a closed one is
# never compared by computation)
def bd.d17(+h: Nat, +m: Nat, e: {1n+h == m : Nat}) -> {Nat.double(U.U32Nat.dbl(h, 1n)) == U.U32Nat.dbl(m, 1n) : Nat}:
  %e : {Nat.double(U.U32Nat.dbl(h, 1n)) == U.U32Nat.dbl(_, 1n) : Nat}
  {==}

def bd.d2(+h: Nat, +m: Nat, e: {Nat.add(h, 1n) == m : Nat}) -> {U.U32Nat.dbl(h, 2n) == U.U32Nat.dbl(m, 1n) : Nat}:
