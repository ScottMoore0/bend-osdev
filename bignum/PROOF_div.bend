def bd.dm(+x: List<&2, U32>, +y: List<&2, U32>, +hx: {LL.bnlaw.ok(x) == True{} : Bool}, +hy: {LL.bnlaw.ok(y) == True{} : Bool}, +hB: {Nat.is_lt(0n, LL.bnlaw.val(y)) == True{} : Bool}) -> {Nat.add(Nat.mul(LL.bnlaw.value(N.BnDivMod.q(N.bn.divmod(x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y)))) == LL.bnlaw.val(x) : Nat} & {Nat.is_lt(LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y))), LL.bnlaw.val(y)) == True{} : Bool}:
  bd.go(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, hx, hy, hB, {==})

# The results are numbers (eta), and the laws

def bd.eg(i: Nat, +r: List<&2, U32>, +s: List<&2, U32>, +q: List<&2, U32>) -> {N.bn.div.go(i, r, s, q) == N.BnDivMod{N.BnDivMod.q(N.bn.div.go(i, r, s, q)), N.BnDivMod.r(N.bn.div.go(i, r, s, q))} : N.BnDivMod}:
  match i:
    case 0n:
      {==}
    case 1n+ +p:
      bd.eg(p, N.bn.div.r(N.bn.ge(N.bn.cmp(r, s, EQ{})), r, s), N.bn.shr1(s), N.bn.shl1(q, N.bn.div.bit(N.bn.ge(N.bn.cmp(r, s, EQ{})))))

def bd.ed(z: Bool, +a: List<&2, U32>, +b: List<&2, U32>, +la: Nat, +lb: Nat) -> {N.bn.divmod.go(z, a, b, la, lb) == N.BnDivMod{N.BnDivMod.q(N.bn.divmod.go(z, a, b, la, lb)), N.BnDivMod.r(N.bn.divmod.go(z, a, b, la, lb))} : N.BnDivMod}:
  match z:
    case True{}:
      {==}
    case False{}:
      bd.eg(Nat.sub(la, lb), N.bn.norm(a), N.bn.shl(N.bn.norm(b), Nat.sub(la, lb)), Nil{})

def bd.lqk(i: Nat, +r: List<&2, U32>, +s: List<&2, U32>, +q: List<&2, U32>, +hq: {LL.bnlaw.ok(q) == True{} : Bool}) -> {LL.bnlaw.valid(N.BnDivMod.q(N.bn.div.go(i, r, s, q))) == True{} : Bool}:
  match i:
    case 0n:
      bd.s1k(q, N.bn.div.bit(N.bn.ge(N.bn.cmp(r, s, EQ{}))), hq, bd.bk(N.bn.ge(N.bn.cmp(r, s, EQ{}))))
    case 1n+ +p:
      bd.lqk(p, N.bn.div.r(N.bn.ge(N.bn.cmp(r, s, EQ{})), r, s), N.bn.shr1(s), N.bn.shl1(q, N.bn.div.bit(N.bn.ge(N.bn.cmp(r, s, EQ{})))), bd.s1k(q, N.bn.div.bit(N.bn.ge(N.bn.cmp(r, s, EQ{}))), hq, bd.bk(N.bn.ge(N.bn.cmp(r, s, EQ{})))))

def bd.lrk(i: Nat, +r: List<&2, U32>, +s: List<&2, U32>, +q: List<&2, U32>, +hr: {LL.bnlaw.ok(r) == True{} : Bool}) -> {LL.bnlaw.valid(N.BnDivMod.r(N.bn.div.go(i, r, s, q))) == True{} : Bool}:
  match i:
    case 0n:
      PL.bq.nk(N.bn.div.r(N.bn.ge(N.bn.cmp(r, s, EQ{})), r, s), bd.drk(N.bn.ge(N.bn.cmp(r, s, EQ{})), r, s, hr))
    case 1n+ +p:
      bd.lrk(p, N.bn.div.r(N.bn.ge(N.bn.cmp(r, s, EQ{})), r, s), N.bn.shr1(s), N.bn.shl1(q, N.bn.div.bit(N.bn.ge(N.bn.cmp(r, s, EQ{})))), bd.drk(N.bn.ge(N.bn.cmp(r, s, EQ{})), r, s, hr))

def bd.dn(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>, hz: {z == True{} : Bool}) -> {N.bn.divmod.zero(z, x, y) == None{} : Maybe<&2, N.BnDivMod>}:
  match z:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({N.bn.divmod.zero(False{}, x, y) == None{} : Maybe<&2, N.BnDivMod>}, PL.bq.ft(hz))

def bd.dq(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>, hz: {z == False{} : Bool}) -> {Maybe.map(&2, N.BnDivMod, N.BnNat, d => N.BnDivMod.q(d), N.bn.divmod.zero(z, x, y)) == Some{N.bn.div.q(N.bn.divmod.zero(z, x, y))} : Maybe<&2, N.BnNat>}:
  match z:
    case True{}:
      Empty.absurd({Maybe.map(&2, N.BnDivMod, N.BnNat, d => N.BnDivMod.q(d), N.bn.divmod.zero(True{}, x, y)) == Some{N.bn.div.q(N.bn.divmod.zero(True{}, x, y))} : Maybe<&2, N.BnNat>}, PL.bq.tf(hz))
    case False{}:
      %Equal.sym(N.BnDivMod, N.bn.divmod(x, y), N.BnDivMod{N.BnDivMod.q(N.bn.divmod(x, y)), N.BnDivMod.r(N.bn.divmod(x, y))}, bd.ed(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, N.bn.bitlen(x), N.bn.bitlen(y))) : {Maybe.map(&2, N.BnDivMod, N.BnNat, d => N.BnDivMod.q(d), Some{_}) == Some{N.bn.div.q(Some{_})} : Maybe<&2, N.BnNat>}
      {==}

def bd.dr(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>, hz: {z == False{} : Bool}) -> {Maybe.map(&2, N.BnDivMod, N.BnNat, d => N.BnDivMod.r(d), N.bn.divmod.zero(z, x, y)) == Some{N.bn.mod.zero(z, x, y)} : Maybe<&2, N.BnNat>}:
  match z:
    case True{}:
      Empty.absurd({Maybe.map(&2, N.BnDivMod, N.BnNat, d => N.BnDivMod.r(d), N.bn.divmod.zero(True{}, x, y)) == Some{N.bn.mod.zero(True{}, x, y)} : Maybe<&2, N.BnNat>}, PL.bq.tf(hz))
    case False{}:
      %Equal.sym(N.BnDivMod, N.bn.divmod(x, y), N.BnDivMod{N.BnDivMod.q(N.bn.divmod(x, y)), N.BnDivMod.r(N.bn.divmod(x, y))}, bd.ed(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, N.bn.bitlen(x), N.bn.bitlen(y))) : {Maybe.map(&2, N.BnDivMod, N.BnNat, d => N.BnDivMod.r(d), Some{_}) == Some{N.bn.mod.r(_)} : Maybe<&2, N.BnNat>}
      {==}

def bd.dv(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>, +hx: {LL.bnlaw.ok(x) == True{} : Bool}, +hy: {LL.bnlaw.ok(y) == True{} : Bool}, ez: {N.bn.allz(y) == z : Bool}, hz: {z == False{} : Bool}) -> {Nat.add(Nat.mul(LL.bnlaw.value(N.bn.div.q(N.bn.divmod.zero(z, x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.bn.mod.zero(z, x, y))) == LL.bnlaw.val(x) : Nat} & {Nat.is_lt(LL.bnlaw.value(N.bn.mod.zero(z, x, y)), LL.bnlaw.val(y)) == True{} : Bool}:
  match z:
    case True{}:
      Empty.absurd({Nat.add(Nat.mul(0n, LL.bnlaw.val(y)), LL.bnlaw.val(x)) == LL.bnlaw.val(x) : Nat} & {Nat.is_lt(LL.bnlaw.val(x), LL.bnlaw.val(y)) == True{} : Bool}, PL.bq.tf(hz))
    case False{}:
      +hB = PL.bq.nz(LL.bnlaw.val(y), Equal.trans(Bool, Nat.is_eq(LL.bnlaw.val(y), 0n), N.bn.allz(y), False{}, Equal.sym(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), PL.bq.zv(y)), ez))
      %Equal.sym(N.BnDivMod, N.bn.divmod(x, y), N.BnDivMod{N.BnDivMod.q(N.bn.divmod(x, y)), N.BnDivMod.r(N.bn.divmod(x, y))}, bd.ed(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, N.bn.bitlen(x), N.bn.bitlen(y))) : {Nat.add(Nat.mul(LL.bnlaw.value(N.bn.div.q(Some{_})), LL.bnlaw.val(y)), LL.bnlaw.value(N.bn.mod.r(_))) == LL.bnlaw.val(x) : Nat} & {Nat.is_lt(LL.bnlaw.value(N.bn.mod.r(_)), LL.bnlaw.val(y)) == True{} : Bool}
      bd.dm(x, y, hx, hy, hB)

def bd.mv(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>, +hx: {LL.bnlaw.ok(x) == True{} : Bool}, +hy: {LL.bnlaw.ok(y) == True{} : Bool}, ez: {N.bn.allz(y) == z : Bool}) -> {LL.bnlaw.value(N.bn.mod.zero(z, x, y)) == Nat.mod(LL.bnlaw.val(x), LL.bnlaw.val(y)) : Nat}:
  match z:
    case True{}:
      %Equal.sym(Nat, LL.bnlaw.val(y), 0n, PL.bq.z0(LL.bnlaw.val(y), Equal.trans(Bool, Nat.is_eq(LL.bnlaw.val(y), 0n), N.bn.allz(y), True{}, Equal.sym(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), PL.bq.zv(y)), ez))) : {LL.bnlaw.val(x) == Nat.mod(LL.bnlaw.val(x), _) : Nat}
      {==}
    case False{}:
      +hB = PL.bq.nz(LL.bnlaw.val(y), Equal.trans(Bool, Nat.is_eq(LL.bnlaw.val(y), 0n), N.bn.allz(y), False{}, Equal.sym(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), PL.bq.zv(y)), ez))
      %Equal.sym(N.BnDivMod, N.bn.divmod(x, y), N.BnDivMod{N.BnDivMod.q(N.bn.divmod(x, y)), N.BnDivMod.r(N.bn.divmod(x, y))}, bd.ed(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, N.bn.bitlen(x), N.bn.bitlen(y))) : {LL.bnlaw.value(N.bn.mod.r(_)) == Nat.mod(LL.bnlaw.val(x), LL.bnlaw.val(y)) : Nat}
      +e1 = PL.bq.c1(Nat.add(Nat.mul(LL.bnlaw.value(N.BnDivMod.q(N.bn.divmod(x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y)))), LL.bnlaw.val(x), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y))), LL.bnlaw.val(y), bd.dm(x, y, hx, hy, hB))
      +l1 = PL.bq.c2(Nat.add(Nat.mul(LL.bnlaw.value(N.BnDivMod.q(N.bn.divmod(x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y)))), LL.bnlaw.val(x), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y))), LL.bnlaw.val(y), bd.dm(x, y, hx, hy, hB))
      UL.nat_mod_unique(LL.bnlaw.val(y), LL.bnlaw.value(N.BnDivMod.q(N.bn.divmod(x, y))), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y))), Nat.div(LL.bnlaw.val(x), LL.bnlaw.val(y)), Nat.mod(LL.bnlaw.val(x), LL.bnlaw.val(y)), Equal.trans(Nat, Nat.add(Nat.mul(LL.bnlaw.value(N.BnDivMod.q(N.bn.divmod(x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y)))), LL.bnlaw.val(x), Nat.add(Nat.mul(Nat.div(LL.bnlaw.val(x), LL.bnlaw.val(y)), LL.bnlaw.val(y)), Nat.mod(LL.bnlaw.val(x), LL.bnlaw.val(y))), e1, Equal.sym(Nat, Nat.add(Nat.mul(Nat.div(LL.bnlaw.val(x), LL.bnlaw.val(y)), LL.bnlaw.val(y)), Nat.mod(LL.bnlaw.val(x), LL.bnlaw.val(y))), LL.bnlaw.val(x), bd.ndm(LL.bnlaw.val(x), LL.bnlaw.val(y), hB))), l1, bd.nml(LL.bnlaw.val(x), LL.bnlaw.val(y), hB))

def bd.vv(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>, +hx: {LL.bnlaw.ok(x) == True{} : Bool}, +hy: {LL.bnlaw.ok(y) == True{} : Bool}, ez: {N.bn.allz(y) == z : Bool}) -> {LL.bnlaw.value(N.bn.div.q(N.bn.divmod.zero(z, x, y))) == Nat.div(LL.bnlaw.val(x), LL.bnlaw.val(y)) : Nat}:
  match z:
    case True{}:
      %Equal.sym(Nat, LL.bnlaw.val(y), 0n, PL.bq.z0(LL.bnlaw.val(y), Equal.trans(Bool, Nat.is_eq(LL.bnlaw.val(y), 0n), N.bn.allz(y), True{}, Equal.sym(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), PL.bq.zv(y)), ez))) : {0n == Nat.div(LL.bnlaw.val(x), _) : Nat}
      {==}
    case False{}:
      +hB = PL.bq.nz(LL.bnlaw.val(y), Equal.trans(Bool, Nat.is_eq(LL.bnlaw.val(y), 0n), N.bn.allz(y), False{}, Equal.sym(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), PL.bq.zv(y)), ez))
      %Equal.sym(N.BnDivMod, N.bn.divmod(x, y), N.BnDivMod{N.BnDivMod.q(N.bn.divmod(x, y)), N.BnDivMod.r(N.bn.divmod(x, y))}, bd.ed(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, N.bn.bitlen(x), N.bn.bitlen(y))) : {LL.bnlaw.value(N.bn.div.q(Some{_})) == Nat.div(LL.bnlaw.val(x), LL.bnlaw.val(y)) : Nat}
      +e1 = PL.bq.c1(Nat.add(Nat.mul(LL.bnlaw.value(N.BnDivMod.q(N.bn.divmod(x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y)))), LL.bnlaw.val(x), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y))), LL.bnlaw.val(y), bd.dm(x, y, hx, hy, hB))
      +l1 = PL.bq.c2(Nat.add(Nat.mul(LL.bnlaw.value(N.BnDivMod.q(N.bn.divmod(x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y)))), LL.bnlaw.val(x), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y))), LL.bnlaw.val(y), bd.dm(x, y, hx, hy, hB))
      UL.nat_div_unique(LL.bnlaw.val(y), LL.bnlaw.value(N.BnDivMod.q(N.bn.divmod(x, y))), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y))), Nat.div(LL.bnlaw.val(x), LL.bnlaw.val(y)), Nat.mod(LL.bnlaw.val(x), LL.bnlaw.val(y)), Equal.trans(Nat, Nat.add(Nat.mul(LL.bnlaw.value(N.BnDivMod.q(N.bn.divmod(x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.BnDivMod.r(N.bn.divmod(x, y)))), LL.bnlaw.val(x), Nat.add(Nat.mul(Nat.div(LL.bnlaw.val(x), LL.bnlaw.val(y)), LL.bnlaw.val(y)), Nat.mod(LL.bnlaw.val(x), LL.bnlaw.val(y))), e1, Equal.sym(Nat, Nat.add(Nat.mul(Nat.div(LL.bnlaw.val(x), LL.bnlaw.val(y)), LL.bnlaw.val(y)), Nat.mod(LL.bnlaw.val(x), LL.bnlaw.val(y))), LL.bnlaw.val(x), bd.ndm(LL.bnlaw.val(x), LL.bnlaw.val(y), hB))), l1, bd.nml(LL.bnlaw.val(x), LL.bnlaw.val(y), hB))

def bd.gqk(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>, +la: Nat, +lb: Nat) -> {LL.bnlaw.valid(N.BnDivMod.q(N.bn.divmod.go(z, x, y, la, lb))) == True{} : Bool}:
  match z:
    case True{}:
      {==}
    case False{}:
      bd.lqk(Nat.sub(la, lb), N.bn.norm(x), N.bn.shl(N.bn.norm(y), Nat.sub(la, lb)), Nil{}, {==})

def bd.grk(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>, +la: Nat, +lb: Nat, +hx: {LL.bnlaw.ok(x) == True{} : Bool}) -> {LL.bnlaw.valid(N.BnDivMod.r(N.bn.divmod.go(z, x, y, la, lb))) == True{} : Bool}:
  match z:
    case True{}:
      hx
    case False{}:
      bd.lrk(Nat.sub(la, lb), N.bn.norm(x), N.bn.shl(N.bn.norm(y), Nat.sub(la, lb)), Nil{}, PL.bq.nk(x, hx))

def bd.dk(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>) -> {LL.bnlaw.valid(N.bn.div.q(N.bn.divmod.zero(z, x, y))) == True{} : Bool}:
  match z:
    case True{}:
      {==}
    case False{}:
      %Equal.sym(N.BnDivMod, N.bn.divmod(x, y), N.BnDivMod{N.BnDivMod.q(N.bn.divmod(x, y)), N.BnDivMod.r(N.bn.divmod(x, y))}, bd.ed(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, N.bn.bitlen(x), N.bn.bitlen(y))) : {LL.bnlaw.valid(N.bn.div.q(Some{_})) == True{} : Bool}
      bd.gqk(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, N.bn.bitlen(x), N.bn.bitlen(y))

def bd.mk(z: Bool, +x: List<&2, U32>, +y: List<&2, U32>, +hx: {LL.bnlaw.ok(x) == True{} : Bool}) -> {LL.bnlaw.valid(N.bn.mod.zero(z, x, y)) == True{} : Bool}:
  match z:
    case True{}:
      hx
    case False{}:
      %Equal.sym(N.BnDivMod, N.bn.divmod(x, y), N.BnDivMod{N.BnDivMod.q(N.bn.divmod(x, y)), N.BnDivMod.r(N.bn.divmod(x, y))}, bd.ed(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, N.bn.bitlen(x), N.bn.bitlen(y))) : {LL.bnlaw.valid(N.bn.mod.r(_)) == True{} : Bool}
      bd.grk(Nat.is_lt(N.bn.bitlen(x), N.bn.bitlen(y)), x, y, N.bn.bitlen(x), N.bn.bitlen(y), hx)

def Laws.divmod_none(a, b, h):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bd.dn(N.bn.allz(y), x, y, Equal.trans(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), True{}, PL.bq.zv(y), Equal.cong(Nat, Bool, zz => Nat.is_eq(zz, 0n), LL.bnlaw.val(y), 0n, h)))

def Laws.divmod_q(a, b, h):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bd.dq(N.bn.allz(y), x, y, Equal.trans(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), False{}, PL.bq.zv(y), PL.bq.nz1(LL.bnlaw.val(y), h)))

def Laws.divmod_r(a, b, h):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bd.dr(N.bn.allz(y), x, y, Equal.trans(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), False{}, PL.bq.zv(y), PL.bq.nz1(LL.bnlaw.val(y), h)))

def Laws.divmod_value(a, b, ha, hb, h):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      PL.bq.c1(Nat.add(Nat.mul(LL.bnlaw.value(N.bn.div.q(N.bn.divmod.zero(N.bn.allz(y), x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.bn.mod.zero(N.bn.allz(y), x, y))), LL.bnlaw.val(x), LL.bnlaw.value(N.bn.mod.zero(N.bn.allz(y), x, y)), LL.bnlaw.val(y), bd.dv(N.bn.allz(y), x, y, ha, hb, {==}, Equal.trans(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), False{}, PL.bq.zv(y), PL.bq.nz1(LL.bnlaw.val(y), h))))

def Laws.mod_lt(a, b, ha, hb, h):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      PL.bq.c2(Nat.add(Nat.mul(LL.bnlaw.value(N.bn.div.q(N.bn.divmod.zero(N.bn.allz(y), x, y))), LL.bnlaw.val(y)), LL.bnlaw.value(N.bn.mod.zero(N.bn.allz(y), x, y))), LL.bnlaw.val(x), LL.bnlaw.value(N.bn.mod.zero(N.bn.allz(y), x, y)), LL.bnlaw.val(y), bd.dv(N.bn.allz(y), x, y, ha, hb, {==}, Equal.trans(Bool, N.bn.allz(y), Nat.is_eq(LL.bnlaw.val(y), 0n), False{}, PL.bq.zv(y), PL.bq.nz1(LL.bnlaw.val(y), h))))

def Laws.mod_value(a, b, ha, hb):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bd.mv(N.bn.allz(y), x, y, ha, hb, {==})

def Laws.div_value(a, b, ha, hb):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bd.vv(N.bn.allz(y), x, y, ha, hb, {==})

def Laws.div_valid(a, b):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bd.dk(N.bn.allz(y), x, y)

def Laws.mod_valid(a, b, ha):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bd.mk(N.bn.allz(y), x, y, ha)

