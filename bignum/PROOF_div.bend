def bd.sbv(xs: List<&2, U32>, +s: Nat, +c: U32, +hx: {LL.bnlaw.ok(xs) == True{} : Bool}, +hs: {Nat.is_le(s, 16n) == True{} : Bool}, +hc: {Nat.is_lt(U32.to_nat(c), U.U32Nat.dbl(s, 1n)) == True{} : Bool}) -> {LL.bnlaw.val(N.bn.shlb(xs, s, c)) == Nat.add(U.U32Nat.dbl(s, LL.bnlaw.val(xs)), U32.to_nat(c)) : Nat}:
  match xs:
    case Nil{}:
      Equal.trans(Nat, LL.bnlaw.val(N.bn.lone(U32.is_zero(c), c)), U32.to_nat(c), Nat.add(U.U32Nat.dbl(s, 0n), U32.to_nat(c)), PL.bq.lone(c, U32.is_zero(c), {==}), Equal.sym(Nat, Nat.add(U.U32Nat.dbl(s, 0n), U32.to_nat(c)), U32.to_nat(c), Equal.trans(Nat, Nat.add(U.U32Nat.dbl(s, 0n), U32.to_nat(c)), Nat.add(0n, U32.to_nat(c)), U32.to_nat(c), Equal.cong(Nat, Nat, zz => Nat.add(zz, U32.to_nat(c)), U.U32Nat.dbl(s, 0n), 0n, UL.dbl_zero(s)), {==})))
