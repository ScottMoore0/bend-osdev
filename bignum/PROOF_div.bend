def bd.lnz(ys: List<&2, U32>) -> Bool:
  match ys:
    case Nil{}:
      True{}
    case Con{y, t}:
      Bool.not(U32.is_zero(List.last.go(&2, U32, t, y)))

def bd.nt(b: Bool, h: {Bool.not(b) == True{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, PL.bq.ft(h))
    case False{}:
      {==}

def bd.cz1(+x: U32, z: Bool, ez: {U32.is_zero(x) == z : Bool}) -> {bd.lnz(N.bn.lone(z, x)) == True{} : Bool}:
  match z:
    case True{}:
      {==}
    case False{}:
      Equal.cong(Bool, Bool, zz => Bool.not(zz), U32.is_zero(x), False{}, ez)

def bd.cz(+x: U32, r: List<&2, U32>, hr: {bd.lnz(r) == True{} : Bool}) -> {bd.lnz(N.bn.cons(x, r)) == True{} : Bool}:
  match r:
    case Nil{}:
      bd.cz1(x, U32.is_zero(x), {==})
    case Con{a, s}:
      hr

def bd.nz(xs: List<&2, U32>) -> {bd.lnz(N.bn.norm(xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      bd.cz(x, N.bn.norm(t), bd.nz(t))

def bd.tv(rest: List<&2, U32>, +y: U32, h: {LL.bnlaw.ok(Con{y, rest}) == True{} : Bool}) -> {U32.is_zero(U32.shrn(List.last.go(&2, U32, rest, y), 16n)) == True{} : Bool}:
  match rest:
    case Nil{}:
      PL.bq.and1(U32.is_zero(U32.shrn(y, 16n)), True{}, h)
    case Con{+a, +s}:
      bd.tv(s, a, PL.bq.and2(U32.is_zero(U32.shrn(y, 16n)), LL.bnlaw.ok(Con{a, s}), h))

