# whether an answer is right: an inverse t below m with Av t mod m = 1, valid
def gi.okb(r: Maybe<&2, N.BnNat>, +Av: Nat, +M: Nat) -> Bool:
  match r:
    case None{}:
      True{}
    case Some{+t}:
      Bool.and(Nat.is_eq(Nat.mod(Nat.mul(Av, LL.bnlaw.value(t)), M), 1n), Bool.and(Nat.is_lt(LL.bnlaw.value(t), M), LL.bnlaw.valid(t)))

def gi.mr(x: Maybe<&2, N.BnDivMod>, +y: N.BnNat, +dd: N.BnDivMod, e: {Maybe.map(&2, N.BnDivMod, N.BnNat, d => N.BnDivMod.r(d), x) == Some{y} : Maybe<&2, N.BnNat>}) -> {N.BnDivMod.r(Maybe.default(&2, N.BnDivMod, x, dd)) == y : N.BnNat}:
  match x:
    case None{}:
      Empty.absurd({N.BnDivMod.r(dd) == y : N.BnNat}, PL.bq.ft(Equal.cong(Maybe<&2, N.BnNat>, Bool, zz => Laws.bnlaw.is_some(zz), None{}, Some{y}, e)))
    case Some{dm}:
      Equal.cong(Maybe<&2, N.BnNat>, N.BnNat, zz => Maybe.default(&2, N.BnNat, zz, y), Some{N.BnDivMod.r(dm)}, Some{y}, e)

def gi.mq(x: Maybe<&2, N.BnDivMod>, +y: N.BnNat, +dd: N.BnDivMod, e: {Maybe.map(&2, N.BnDivMod, N.BnNat, d => N.BnDivMod.q(d), x) == Some{y} : Maybe<&2, N.BnNat>}) -> {N.BnDivMod.q(Maybe.default(&2, N.BnDivMod, x, dd)) == y : N.BnNat}:
  match x:
    case None{}:
      Empty.absurd({N.BnDivMod.q(dd) == y : N.BnNat}, PL.bq.ft(Equal.cong(Maybe<&2, N.BnNat>, Bool, zz => Laws.bnlaw.is_some(zz), None{}, Some{y}, e)))
    case Some{dm}:
