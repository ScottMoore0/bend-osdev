# The laws

def Laws.inv_some(a, m, ha, hm):
  gi.p2(Md.BnMod.inv(a, m), a, m, gi.top(a, m, ha, hm))

def Laws.inv_value(a, m, t, ha, hm, e):
  PX.bx.eqt(Nat.mod(Nat.mul(LL.bnlaw.value(a), LL.bnlaw.value(t)), LL.bnlaw.value(m)), 1n, PL.bq.and1(Nat.is_eq(Nat.mod(Nat.mul(LL.bnlaw.value(a), LL.bnlaw.value(t)), LL.bnlaw.value(m)), 1n), Bool.and(Nat.is_lt(LL.bnlaw.value(t), LL.bnlaw.value(m)), LL.bnlaw.valid(t)), gi.got(a, m, t, ha, hm, e)))

def Laws.inv_lt(a, m, t, ha, hm, e):
  PL.bq.and1(Nat.is_lt(LL.bnlaw.value(t), LL.bnlaw.value(m)), LL.bnlaw.valid(t), PL.bq.and2(Nat.is_eq(Nat.mod(Nat.mul(LL.bnlaw.value(a), LL.bnlaw.value(t)), LL.bnlaw.value(m)), 1n), Bool.and(Nat.is_lt(LL.bnlaw.value(t), LL.bnlaw.value(m)), LL.bnlaw.valid(t)), gi.got(a, m, t, ha, hm, e)))

def Laws.inv_valid(a, m, t, ha, hm, e):
  PL.bq.and2(Nat.is_lt(LL.bnlaw.value(t), LL.bnlaw.value(m)), LL.bnlaw.valid(t), PL.bq.and2(Nat.is_eq(Nat.mod(Nat.mul(LL.bnlaw.value(a), LL.bnlaw.value(t)), LL.bnlaw.value(m)), 1n), Bool.and(Nat.is_lt(LL.bnlaw.value(t), LL.bnlaw.value(m)), LL.bnlaw.valid(t)), gi.got(a, m, t, ha, hm, e)))
