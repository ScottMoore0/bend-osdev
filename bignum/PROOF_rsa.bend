def rx.pqb(b: Bool, +p: Nat, +q: Nat, +w: Nat, +k1: Nat, +k2: Nat, eb: {Nat.is_lt(p, q) == b : Bool}, +hp: {LF.bnlaw.prime(p) == True{} : Bool}, +hq: {LF.bnlaw.prime(q) == True{} : Bool}, +hpq: {Nat.is_eq(p, q) == False{} : Bool}, +e1: {Nat.mul(k1, p) == w : Nat}, +e2: {Nat.mul(k2, q) == w : Nat}) -> Sigma<&1, &1, Nat, kk => {Nat.mul(kk, Nat.mul(p, q)) == w : Nat}>:
