  s2 = rx.dvd(Nat.sub(y, x), x, q, rx.p0(q, hq), Equal.trans(Nat, Nat.mod(Nat.add(Nat.sub(y, x), x), q), Nat.mod(y, q), Nat.mod(x, q), Equal.cong(Nat, Nat, zz => Nat.mod(zz, q), Nat.add(Nat.sub(y, x), x), y, ew), Equal.sym(Nat, Nat.mod(x, q), Nat.mod(y, q), ey)))
  rx.crt2(p, q, x, y, Nat.sub(y, x), rx.pqs(p, q, Nat.sub(y, x), hp, hq, hpq, s1, s2), ew, rx.mpos(p, q, rx.p0(p, hp), rx.p0(q, hq)))

def rx.crtb(b: Bool, +p: Nat, +q: Nat, +x: Nat, +y: Nat, eb: {Nat.is_le(x, y) == b : Bool}, +hp: {LF.bnlaw.prime(p) == True{} : Bool}, +hq: {LF.bnlaw.prime(q) == True{} : Bool}, +hpq: {Nat.is_eq(p, q) == False{} : Bool}, +ex: {Nat.mod(x, p) == Nat.mod(y, p) : Nat}, +ey: {Nat.mod(x, q) == Nat.mod(y, q) : Nat}) -> {Nat.mod(x, Nat.mul(p, q)) == Nat.mod(y, Nat.mul(p, q)) : Nat}:
