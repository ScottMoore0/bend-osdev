def rx.pqs(+p: Nat, +q: Nat, +w: Nat, +hp: {LF.bnlaw.prime(p) == True{} : Bool}, +hq: {LF.bnlaw.prime(q) == True{} : Bool}, +hpq: {Nat.is_eq(p, q) == False{} : Bool}, s1: Sigma<&1, &1, Nat, kk => {Nat.mul(kk, p) == w : Nat}>, s2: Sigma<&1, &1, Nat, kk => {Nat.mul(kk, q) == w : Nat}>) -> Sigma<&1, &1, Nat, kk => {Nat.mul(kk, Nat.mul(p, q)) == w : Nat}>:
