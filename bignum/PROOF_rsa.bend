# x = y mod lcm(a, b), lcm(a, b) = k a, gives x = y mod a
def rx.cl(+a: Nat, +b: Nat, +x: Nat, +y: Nat, +L: Nat, h: {Nat.mod(x, L) == Nat.mod(y, L) : Nat}, s: Sigma<&1, &1, Nat, kk => {Nat.mul(kk, a) == L : Nat}>) -> {Nat.mod(x, a) == Nat.mod(y, a) : Nat}:
  (+k, +ek) = s
  rx.cdiv(k, a, x, y, Equal.trans(Nat, Nat.mod(x, Nat.mul(k, a)), Nat.mod(x, L), Nat.mod(y, Nat.mul(k, a)), Equal.cong(Nat, Nat, zz => Nat.mod(x, zz), Nat.mul(k, a), L, ek), Equal.trans(Nat, Nat.mod(x, L), Nat.mod(y, L), Nat.mod(y, Nat.mul(k, a)), h, Equal.cong(Nat, Nat, zz => Nat.mod(y, zz), L, Nat.mul(k, a), Equal.sym(Nat, Nat.mul(k, a), L, ek)))))

# BnNat.is_odd and the value

def rx.r16(+x0: Nat, +x1: Nat) -> {Nat.add(Nat.mul(x0, 2n), x1) == Nat.add(x1, Nat.double(x0)) : Nat}:
  %Equal.sym(Nat, Nat.mul(x0, U.U32Nat.dbl(1n, 1n)), U.U32Nat.dbl(1n, Nat.mul(x0, 1n)), UL.dbl_mul_r(1n, x0, 1n)) : {Nat.add(_, x1) == Nat.add(x1, Nat.double(x0)) : Nat}
  %Equal.sym(Nat, Nat.mul(x0, 1n), x0, UL.nat_mul_one(x0)) : {Nat.add(U.U32Nat.dbl(1n, _), x1) == Nat.add(x1, Nat.double(x0)) : Nat}
  %Equal.sym(Nat, Nat.add(U.U32Nat.dbl(1n, x0), x1), Nat.add(x1, U.U32Nat.dbl(1n, x0)), UL.nat_add_comm(U.U32Nat.dbl(1n, x0), x1)) : {_ == Nat.add(x1, Nat.double(x0)) : Nat}
  %Equal.sym(Nat, Nat.double(x0), Nat.add(x0, x0), Equal.sym(Nat, Nat.add(x0, x0), Nat.double(x0), Equal.sym(Nat, Nat.double(x0), Nat.add(x0, x0), UL.nat_double(x0)))) : {Nat.add(x1, _) == Nat.add(x1, Nat.double(x0)) : Nat}
  %Equal.sym(Nat, Nat.add(x0, x0), Nat.double(x0), Equal.sym(Nat, Nat.double(x0), Nat.add(x0, x0), UL.nat_double(x0))) : {Nat.add(x1, _) == Nat.add(x1, Nat.double(x0)) : Nat}
  {==}

def rx.mod2(+V: Nat) -> {Nat.mod(V, 2n) == U.U32Nat.odd(V) : Nat}:
  PX.bx.mu(V, 2n, U.U32Nat.half(V), U.U32Nat.odd(V), Equal.trans(Nat, Nat.add(Nat.mul(U.U32Nat.half(V), 2n), U.U32Nat.odd(V)), Nat.add(U.U32Nat.odd(V), Nat.double(U.U32Nat.half(V))), V, rx.r16(U.U32Nat.half(V), U.U32Nat.odd(V)), UL.nat_odd_half(V)), rx.l12(U.U32Nat.odd(V), UL.nat_odd_le(V)))

def rx.oddv(x: N.BnNat, hx: {LL.bnlaw.valid(x) == True{} : Bool}) -> {N.BnNat.is_odd(x) == Nat.is_eq(Nat.mod(LL.bnlaw.value(x), 2n), 1n) : Bool}:
  match x:
    case N.BnNat{+ls}:
      Equal.trans(Bool, U32.is_eq(U32.and(1, N.bn.hd(ls)), 1), Nat.is_eq(U32.to_nat(U32.and(1, N.bn.hd(ls))), U32.to_nat(1)), Nat.is_eq(Nat.mod(LL.bnlaw.val(ls), 2n), 1n), UL.u32_eq_value(U32.and(1, N.bn.hd(ls)), 1), Equal.cong(Nat, Bool, zz => Nat.is_eq(zz, 1n), U32.to_nat(U32.and(1, N.bn.hd(ls))), Nat.mod(LL.bnlaw.val(ls), 2n), Equal.trans(Nat, U32.to_nat(U32.and(1, N.bn.hd(ls))), U.U32Nat.odd(U32.to_nat(N.bn.hd(ls))), Nat.mod(LL.bnlaw.val(ls), 2n), PX.bx.b1(N.bn.hd(ls)), Equal.trans(Nat, U.U32Nat.odd(U32.to_nat(N.bn.hd(ls))), U.U32Nat.odd(U.U32Nat.low(16n, LL.bnlaw.val(ls))), Nat.mod(LL.bnlaw.val(ls), 2n), Equal.cong(Nat, Nat, zz => U.U32Nat.odd(zz), U32.to_nat(N.bn.hd(ls)), U.U32Nat.low(16n, LL.bnlaw.val(ls)), PX.bx.hdl(ls, hx)), Equal.trans(Nat, U.U32Nat.odd(U.U32Nat.low(16n, LL.bnlaw.val(ls))), U.U32Nat.odd(LL.bnlaw.val(ls)), Nat.mod(LL.bnlaw.val(ls), 2n), PX.bx.hl(0n, LL.bnlaw.val(ls), {==}), Equal.sym(Nat, Nat.mod(LL.bnlaw.val(ls), 2n), U.U32Nat.odd(LL.bnlaw.val(ls)), rx.mod2(LL.bnlaw.val(ls))))))))

# The laws

def Laws.fermat_gen(p, a, k, hp):
  match p:
    case 0n:
      Empty.absurd({Nat.mod(Nat.pow(a, Nat.add(1n, Nat.mul(k, Nat.sub(0n, 1n)))), 0n) == Nat.mod(a, 0n) : Nat}, PL.bq.ft(hp))
    case 1n+ +n:
      Equal.trans(Nat, Nat.mod(Nat.pow(a, Nat.add(1n, Nat.mul(k, Nat.sub(n, 0n)))), 1n+n), Nat.mod(Nat.pow(a, Nat.add(1n, Nat.mul(k, n))), 1n+n), Nat.mod(a, 1n+n), Equal.cong(Nat, Nat, zz => Nat.mod(Nat.pow(a, Nat.add(1n, Nat.mul(k, zz))), 1n+n), Nat.sub(n, 0n), n, PL.bq.sub0(n)), rx.fg(k, n, a, hp))

def Laws.crt_unique(p, q, x, y, hp, hq, hpq, ex, ey):
  rx.crt(p, q, x, y, hp, hq, hpq, ex, ey)

def Laws.rsa_nat(p, q, e, d, m, hp, hq, hpq, hdp, hdq):
  Equal.trans(Nat, Nat.mod(Nat.pow(Nat.pow(m, e), d), Nat.mul(p, q)), Nat.mod(Nat.pow(m, Nat.mul(d, e)), Nat.mul(p, q)), Nat.mod(m, Nat.mul(p, q)), Equal.cong(Nat, Nat, zz => Nat.mod(zz, Nat.mul(p, q)), Nat.pow(Nat.pow(m, e), d), Nat.pow(m, Nat.mul(d, e)), Equal.trans(Nat, Nat.pow(Nat.pow(m, e), d), Nat.pow(m, Nat.mul(e, d)), Nat.pow(m, Nat.mul(d, e)), PX.bx.pm(m, e, d), Equal.cong(Nat, Nat, zz => Nat.pow(m, zz), Nat.mul(e, d), Nat.mul(d, e), UL.nat_mul_comm(e, d)))), rx.rsa(p, q, m, Nat.mul(d, e), hp, hq, hpq, hdp, hdq))

def Laws.rsa_nat_rev(p, q, e, d, m, hp, hq, hpq, hdp, hdq):
  Equal.trans(Nat, Nat.mod(Nat.pow(Nat.pow(m, d), e), Nat.mul(p, q)), Nat.mod(Nat.pow(m, Nat.mul(d, e)), Nat.mul(p, q)), Nat.mod(m, Nat.mul(p, q)), Equal.cong(Nat, Nat, zz => Nat.mod(zz, Nat.mul(p, q)), Nat.pow(Nat.pow(m, d), e), Nat.pow(m, Nat.mul(d, e)), PX.bx.pm(m, d, e)), rx.rsa(p, q, m, Nat.mul(d, e), hp, hq, hpq, hdp, hdq))

def Laws.crt_exp_nat(p, q, e, d, t, c, hp, hq, hpq, hodd, hdp, hdq, ht):
  rx.cx(p, q, e, d, t, c, hp, hq, hpq, hodd, hdp, hdq, ht)

def Laws.mod_lcm_l(a, b, x, y, h):
  rx.cl(a, b, x, y, K.KMath.lcm(a, b), h, KL.lcm_multiple_l(a, b))

def Laws.mod_lcm_r(a, b, x, y, h):
  rx.cl(b, a, x, y, K.KMath.lcm(a, b), h, KL.lcm_multiple_r(a, b))

def Laws.nat_pow_pow(x, a, b):
  PX.bx.pm(x, a, b)

def Laws.nat_pow_mod(x, e, m, hm):
  PX.bx.pmod(x, e, m, hm)

def Laws.nat_mod_small(a, m, h):
  PX.bx.msm(a, m, h)

def Laws.nat_mod_lt(a, m, hm):
  PD.bd.nml(a, m, hm)

def Laws.is_odd_value(x, hx):
  rx.oddv(x, hx)
