# x = y mod p and mod q, with x <= y, give x = y mod p q
def rx.crt1(+p: Nat, +q: Nat, +x: Nat, +y: Nat, +hp: {LF.bnlaw.prime(p) == True{} : Bool}, +hq: {LF.bnlaw.prime(q) == True{} : Bool}, +hpq: {Nat.is_eq(p, q) == False{} : Bool}, +ex: {Nat.mod(x, p) == Nat.mod(y, p) : Nat}, +ey: {Nat.mod(x, q) == Nat.mod(y, q) : Nat}, +hle: {Nat.is_le(x, y) == True{} : Bool}) -> {Nat.mod(x, Nat.mul(p, q)) == Nat.mod(y, Nat.mul(p, q)) : Nat}:
