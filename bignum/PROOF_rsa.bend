# m^X = m mod p for a prime p = 1 + n, X > 0 and X = 1 mod n
def rx.ex2(X: Nat, +m: Nat, +hp: {LF.bnlaw.prime(2n) == True{} : Bool}, hX0: {Nat.is_lt(0n, X) == True{} : Bool}) -> {Nat.mod(Nat.pow(m, X), 2n) == Nat.mod(m, 2n) : Nat}:
  match X:
    case 0n:
      Empty.absurd({Nat.mod(Nat.pow(m, 0n), 2n) == Nat.mod(m, 2n) : Nat}, PL.bq.ft(hX0))
    case 1n+ +x:
      Equal.trans(Nat, Nat.mod(Nat.pow(m, 1n+x), 2n), Nat.mod(Nat.pow(m, Nat.add(1n, Nat.mul(x, 1n))), 2n), Nat.mod(m, 2n), Equal.cong(Nat, Nat, zz => Nat.mod(Nat.pow(m, zz), 2n), 1n+x, Nat.add(1n, Nat.mul(x, 1n)), rx.r9(x)), rx.fg(x, 1n, m, hp))

def rx.ex1(n: Nat, +m: Nat, +X: Nat, +hp: {LF.bnlaw.prime(1n+n) == True{} : Bool}, hX: {Nat.mod(X, n) == Nat.mod(1n, n) : Nat}, hX0: {Nat.is_lt(0n, X) == True{} : Bool}) -> {Nat.mod(Nat.pow(m, X), 1n+n) == Nat.mod(m, 1n+n) : Nat}:
  match n:
    case 0n:
      Empty.absurd({Nat.mod(Nat.pow(m, X), 1n) == Nat.mod(m, 1n) : Nat}, PL.bq.ft(hp))
    case 1n+ +n1:
      match n1:
        case 0n:
          rx.ex2(X, m, hp, hX0)
        case 1n+ +n2:
          Equal.trans(Nat, Nat.mod(Nat.pow(m, X), 3n+n2), Nat.mod(Nat.pow(m, Nat.add(1n, Nat.mul(Nat.div(X, 2n+n2), 2n+n2))), 3n+n2), Nat.mod(m, 3n+n2), Equal.trans(Nat, Nat.mod(Nat.pow(m, X), 3n+n2), Nat.mod(Nat.pow(m, Nat.add(Nat.mul(Nat.div(X, 2n+n2), 2n+n2), 1n)), 3n+n2), Nat.mod(Nat.pow(m, Nat.add(1n, Nat.mul(Nat.div(X, 2n+n2), 2n+n2))), 3n+n2), Equal.trans(Nat, Nat.mod(Nat.pow(m, X), 3n+n2), Nat.mod(Nat.pow(m, Nat.add(Nat.mul(Nat.div(X, 2n+n2), 2n+n2), Nat.mod(1n, 2n+n2))), 3n+n2), Nat.mod(Nat.pow(m, Nat.add(Nat.mul(Nat.div(X, 2n+n2), 2n+n2), 1n)), 3n+n2), Equal.trans(Nat, Nat.mod(Nat.pow(m, X), 3n+n2), Nat.mod(Nat.pow(m, Nat.add(Nat.mul(Nat.div(X, 2n+n2), 2n+n2), Nat.mod(X, 2n+n2))), 3n+n2), Nat.mod(Nat.pow(m, Nat.add(Nat.mul(Nat.div(X, 2n+n2), 2n+n2), Nat.mod(1n, 2n+n2))), 3n+n2), Equal.cong(Nat, Nat, zz => Nat.mod(Nat.pow(m, zz), 3n+n2), X, Nat.add(Nat.mul(Nat.div(X, 2n+n2), 2n+n2), Nat.mod(X, 2n+n2)), Equal.sym(Nat, Nat.add(Nat.mul(Nat.div(X, 2n+n2), 2n+n2), Nat.mod(X, 2n+n2)), X, PD.bd.ndm(X, 2n+n2, {==}))), Equal.cong(Nat, Nat, zz => Nat.mod(Nat.pow(m, Nat.add(Nat.mul(Nat.div(X, 2n+n2), 2n+n2), zz)), 3n+n2), Nat.mod(X, 2n+n2), Nat.mod(1n, 2n+n2), hX)), {==}), Equal.cong(Nat, Nat, zz => Nat.mod(Nat.pow(m, zz), 3n+n2), Nat.add(Nat.mul(Nat.div(X, 2n+n2), 2n+n2), 1n), Nat.add(1n, Nat.mul(Nat.div(X, 2n+n2), 2n+n2)), rx.r10(Nat.div(X, 2n+n2), n2))), rx.fg(Nat.div(X, 2n+n2), 2n+n2, m, hp))

# d e > 0: d e = 0 = 1 mod p - 1 and mod q - 1 would make p = q = 2
def rx.xpos(X: Nat, +n: Nat, +n2: Nat, hX: {Nat.mod(X, n) == Nat.mod(1n, n) : Nat}, hX2: {Nat.mod(X, n2) == Nat.mod(1n, n2) : Nat}, hne: {Nat.is_eq(n, n2) == False{} : Bool}) -> {Nat.is_lt(0n, X) == True{} : Bool}:
  match X:
    case 0n:
      +e1 = rx.one(n, hX)
      +e2 = rx.one(n2, hX2)
      Empty.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, PL.bq.tf(Equal.trans(Bool, True{}, Nat.is_eq(n, n2), False{}, Equal.sym(Bool, Nat.is_eq(n, n2), True{}, Equal.trans(Bool, Nat.is_eq(n, n2), Nat.is_eq(1n, n2), True{}, Equal.cong(Nat, Bool, zz => Nat.is_eq(zz, n2), n, 1n, e1), Equal.cong(Nat, Bool, zz => Nat.is_eq(1n, zz), n2, 1n, e2))), hne)))
    case 1n+ +x:
      {==}

# m^X = m mod p q for X = 1 modulo p - 1 and modulo q - 1
def rx.rsa(p: Nat, q: Nat, +m: Nat, +X: Nat, +hp: {LF.bnlaw.prime(p) == True{} : Bool}, +hq: {LF.bnlaw.prime(q) == True{} : Bool}, +hpq: {Nat.is_eq(p, q) == False{} : Bool}, hdp: {Nat.mod(X, Nat.sub(p, 1n)) == Nat.mod(1n, Nat.sub(p, 1n)) : Nat}, hdq: {Nat.mod(X, Nat.sub(q, 1n)) == Nat.mod(1n, Nat.sub(q, 1n)) : Nat}) -> {Nat.mod(Nat.pow(m, X), Nat.mul(p, q)) == Nat.mod(m, Nat.mul(p, q)) : Nat}:
  match p q:
    case 0n 0n:
      Empty.absurd({Nat.mod(Nat.pow(m, X), Nat.mul(0n, 0n)) == Nat.mod(m, Nat.mul(0n, 0n)) : Nat}, PL.bq.ft(hp))
    case 0n 1n+ +j:
      Empty.absurd({Nat.mod(Nat.pow(m, X), Nat.mul(0n, 1n+j)) == Nat.mod(m, Nat.mul(0n, 1n+j)) : Nat}, PL.bq.ft(hp))
    case 1n+ +i 0n:
      Empty.absurd({Nat.mod(Nat.pow(m, X), Nat.mul(1n+i, 0n)) == Nat.mod(m, Nat.mul(1n+i, 0n)) : Nat}, PL.bq.ft(hq))
    case 1n+ +n 1n+ +n2:
      +h1 = rx.sub1(n, X, 1n, hdp)
