    case True{}:
      rx.crt1(p, q, x, y, hp, hq, hpq, ex, ey, eb)
    case False{}:
      Equal.sym(Nat, Nat.mod(y, Nat.mul(p, q)), Nat.mod(x, Nat.mul(p, q)), rx.crt1(p, q, y, x, hp, hq, hpq, Equal.sym(Nat, Nat.mod(x, p), Nat.mod(y, p), ex), Equal.sym(Nat, Nat.mod(x, q), Nat.mod(y, q), ey), PL.bq.lt_le(y, x, PL.bq.nle_lt(x, y, eb))))

def rx.crt(+p: Nat, +q: Nat, +x: Nat, +y: Nat, +hp: {LF.bnlaw.prime(p) == True{} : Bool}, +hq: {LF.bnlaw.prime(q) == True{} : Bool}, +hpq: {Nat.is_eq(p, q) == False{} : Bool}, +ex: {Nat.mod(x, p) == Nat.mod(y, p) : Nat}, +ey: {Nat.mod(x, q) == Nat.mod(y, q) : Nat}) -> {Nat.mod(x, Nat.mul(p, q)) == Nat.mod(y, Nat.mul(p, q)) : Nat}:
  rx.crtb(Nat.is_le(x, y), p, q, x, y, {==}, hp, hq, hpq, ex, ey)

