# The reference exponentiation: square, and multiply where the bit is set

def bx.pkv(z: Bool, +acc: N.BnNat, +xm: N.BnNat, +m: N.BnNat, +H: Nat, +O: Nat, ez: {Nat.is_eq(O, 1n) == z : Bool}, +hO: {Nat.is_le(O, 1n) == True{} : Bool}, +hm: {LL.bnlaw.valid(m) == True{} : Bool}, +hm0: {Nat.is_lt(0n, LL.bnlaw.value(m)) == True{} : Bool}, +hx: {LL.bnlaw.valid(xm) == True{} : Bool}, +ha: {LL.bnlaw.valid(acc) == True{} : Bool}, +ea: {LL.bnlaw.value(acc) == Nat.mod(Nat.pow(LL.bnlaw.value(xm), H), LL.bnlaw.value(m)) : Nat}) -> {LL.bnlaw.value(Md.bn.pexp.pick(z, Md.BnMod.mul(acc, acc, m), xm, m)) == Nat.mod(Nat.pow(LL.bnlaw.value(xm), Nat.add(O, Nat.double(H))), LL.bnlaw.value(m)) : Nat}:
