def bx.pkk(z: Bool, +acc: N.BnNat, +xm: N.BnNat, +m: N.BnNat) -> {LL.bnlaw.valid(Md.bn.pexp.pick(z, Md.BnMod.mul(acc, acc, m), xm, m)) == True{} : Bool}:
