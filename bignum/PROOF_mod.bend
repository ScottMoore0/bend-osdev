  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      {==}

def bx.tlk(xs: List<&2, U32>, +hx: {LL.bnlaw.ok(xs) == True{} : Bool}) -> {LL.bnlaw.ok(N.bn.tl(xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      PL.bq.and2(U32.is_zero(U32.shrn(x, 16n)), LL.bnlaw.ok(t), hx)

