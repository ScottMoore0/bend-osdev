  match O:
    case 0n:
      {==}
    case 1n+q:
      match q:
        case 0n:
          Empty.absurd({1n == 0n : Nat}, PL.bq.tf(ez))
        case 1n+r:
          Empty.absurd({2n+r == 0n : Nat}, PL.bq.ft(hO))

# Limbs: the head is the low 16 bits, the tail the rest; take, drop, zeros

def bx.hdl(xs: List<&2, U32>, +hx: {LL.bnlaw.ok(xs) == True{} : Bool}) -> {U32.to_nat(N.bn.hd(xs)) == U.U32Nat.low(16n, LL.bnlaw.val(xs)) : Nat}:
