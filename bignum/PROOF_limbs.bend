    case Nil{} Nil{}:
      bq.ck(Nil{}, c, {==}, hc)
    case Nil{} Con{+y, +ys}:
      bq.ck(Con{y, ys}, c, hy, hc)
    case Con{+x, +xs} Nil{}:
