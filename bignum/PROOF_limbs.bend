def bq.ol(xs: List<&2, U32>) -> {Laws.bnlaw.ok(N.bn.mask16(xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      bq.and3(U32.is_zero(U32.shrn(U32.and(65535, x), 16n)), Laws.bnlaw.ok(N.bn.mask16(t)), bq.mk(x), bq.ol(t))

def Laws.of_limbs_valid(xs):
  bq.ol(xs)

def Laws.add_value(a, b, ha, hb):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      %UL.nat_add_zero(Nat.add(Laws.bnlaw.val(x), Laws.bnlaw.val(y))) : {Laws.bnlaw.val(N.bn.add(x, y, 0)) == _ : Nat}
      bq.av(x, y, 0, ha, hb, {==})

def Laws.add_valid(a, b, ha, hb):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bq.ak(x, y, 0, ha, hb, {==})

# Comparison: the high limbs decide, unless they are equal

