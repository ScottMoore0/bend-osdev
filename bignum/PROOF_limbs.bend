    case Con{+x, +xs} Con{+y, +ys}:
      bq.and3(U32.is_zero(U32.shrn(U32.and(65535, U32.sub(U32.sub(U32.add(x, 65536), y), w)), 16n)), Laws.bnlaw.ok(N.bn.sub(xs, ys, U32.sub(1, U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), y), w), 16n)))), bq.mk(U32.sub(U32.sub(U32.add(x, 65536), y), w)), bq.sk(xs, ys, U32.sub(1, U32.shrn(U32.sub(U32.sub(U32.add(x, 65536), y), w), 16n))))
    case Con{+x, +xs} Nil{}:
      bq.and3(U32.is_zero(U32.shrn(U32.and(65535, U32.sub(U32.add(x, 65536), w)), 16n)), Laws.bnlaw.ok(N.bn.sub(xs, Nil{}, U32.sub(1, U32.shrn(U32.sub(U32.add(x, 65536), w), 16n)))), bq.mk(U32.sub(U32.add(x, 65536), w)), bq.sk(xs, Nil{}, U32.sub(1, U32.shrn(U32.sub(U32.add(x, 65536), w), 16n))))
    case Nil{} Con{+y, +ys}:
      {==}
    case Nil{} Nil{}:
      {==}

