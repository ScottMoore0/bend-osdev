def bq.sgk(+x: List<&2, U32>, +y: List<&2, U32>, z: Bool) -> {Laws.bnlaw.valid(N.bn.sub.go(z, x, y)) == True{} : Bool}:
  match z:
    case True{}:
      bq.nk(N.bn.sub(x, y, 0), bq.sk(x, y, 0))
    case False{}:
      {==}

def Laws.sub_value(a, b, ha, hb):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      +ha2 = ha
      +hb2 = hb
      %Equal.sym(Cmp, N.bn.cmp(x, y, EQ{}), Nat.cmp(Laws.bnlaw.val(x), Laws.bnlaw.val(y)), Equal.trans(Cmp, N.bn.cmp(x, y, EQ{}), N.bn.step(Nat.cmp(Laws.bnlaw.val(x), Laws.bnlaw.val(y)), EQ{}), Nat.cmp(Laws.bnlaw.val(x), Laws.bnlaw.val(y)), bq.cm(x, y, EQ{}, ha2, hb2), bq.st(Nat.cmp(Laws.bnlaw.val(x), Laws.bnlaw.val(y))))) : {Laws.bnlaw.value(N.bn.sub.go(N.bn.ge(_), x, y)) == Nat.sub(Laws.bnlaw.val(x), Laws.bnlaw.val(y)) : Nat}
      bq.sg(x, y, ha2, hb2, Nat.cmp(Laws.bnlaw.val(x), Laws.bnlaw.val(y)), {==})

def Laws.sub_valid(a, b):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bq.sgk(x, y, N.bn.ge(N.bn.cmp(x, y, EQ{})))

