    case 1n+p 0n:
      Empty.absurd({1n+p == 0n : Nat}, bq.ft(Equal.cong(Cmp, Bool, zz => Cmp.is_eq(zz), GT{}, EQ{}, e)))
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, zz => 1n+zz, p, q, bq.ceq(p, q, e))

