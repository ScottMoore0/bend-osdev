def bq.consk(+x: U32, r: List<&2, U32>, +hx: {U32.is_zero(U32.shrn(x, 16n)) == True{} : Bool}, hr: {Laws.bnlaw.ok(r) == True{} : Bool}) -> {Laws.bnlaw.ok(N.bn.cons(x, r)) == True{} : Bool}:
  match r:
    case Nil{}:
      bq.okl(x, U32.is_zero(x), {==}, bq.lv(x, hx))
    case Con{a, t}:
      bq.and3(U32.is_zero(U32.shrn(x, 16n)), Laws.bnlaw.ok(Con{a, t}), hx, hr)

