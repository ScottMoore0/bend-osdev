# The laws of bignum.
#
# For every input: big-endian bytes read as a number (OS2IP) and written
# back to their own length (I2OSP) give the bytes back.
#
# Small-parameter exhaustive laws (generated by gen/exhaustive.py, which
# also writes their proofs): every value below a bound, each case by
# computation. Montgomery's exponentiation is tied there to the reference
# square and multiply, the inverse checked against its definition, the
# Jacobi symbol against Euler's criterion. Laws for every input about the
# arithmetic itself (that add, mul and divmod compute the sums, products
# and quotients of the numbers the limbs stand for) are not stated: they
# need the arithmetic of the 16-bit limbs, which the checker cannot reason
# about symbolically (README.md, "Laws"); ref/run.sh tests them against
# Python's integers instead.
#
# Vectors: values computed with Python's integers, by computation.
import Base
import ../bytes/bytes.bend as B
import ./bignum.bend as N
import ./modular.bend as Md
import ./prime.bend as Pr
import ./jacobi.bend as J

# the number n (for the exhaustive laws' small values)
def bnlaw.nat(+x: Nat) -> N.BnNat:
  N.BnNat.of_u32(U32.from_nat(x))

def bnlaw.inv_check(r: Maybe<&2, N.BnNat>, +a: N.BnNat, +m: N.BnNat) -> Bool:
  match r:
    case None{}:
      Bool.not(N.BnNat.is_eq(Md.BnMod.gcd(a, m), N.BnNat.one()))
    case Some{+x}:
      Bool.and(N.BnNat.is_eq(Md.BnMod.gcd(a, m), N.BnNat.one()), Bool.and(N.BnNat.is_lt(x, m), N.BnNat.is_eq(Md.BnMod.mul(a, x, m), N.BnNat.one())))

# whether BnMod.inv(a, m) is right: an x below m with a x = 1 mod m when
# gcd(a, m) = 1, and None otherwise
def bnlaw.inv_ok(+a: N.BnNat, +m: N.BnNat) -> Bool:
  bnlaw.inv_check(Md.BnMod.inv(a, m), a, m)

def bnlaw.euler.go(z: Bool, one: Bool) -> J.BnJacobi:
  match z one:
    case True{} _:
      J.BnJacZero{}
    case False{} True{}:
      J.BnJacPlus{}
    case False{} False{}:
      J.BnJacMinus{}

# the Legendre symbol from Euler's criterion's value a^((p - 1) / 2) mod p
def bnlaw.euler(+r: N.BnNat) -> J.BnJacobi:
  bnlaw.euler.go(N.BnNat.is_zero(r), N.BnNat.is_eq(r, N.BnNat.one()))

def bnlaw.jac_eq(j: Maybe<&2, J.BnJacobi>, k: J.BnJacobi) -> Bool:
  match j k:
    case Some{J.BnJacZero{}} J.BnJacZero{}:
      True{}
    case Some{J.BnJacPlus{}} J.BnJacPlus{}:
      True{}
    case Some{J.BnJacMinus{}} J.BnJacMinus{}:
      True{}
    case _ _:
      False{}

# whether the Jacobi symbol (a / p) is the Legendre symbol of Euler's
# criterion, a^((p - 1) / 2) mod p, for an odd prime p
def bnlaw.jacobi_ok(+a: N.BnNat, +p: N.BnNat) -> Bool:
  bnlaw.jac_eq(J.BnNat.jacobi(a, p), bnlaw.euler(Md.BnMod.exp_plain(a, N.BnNat.shr(p, 1n), p)))

def bnlaw.hex(s: String) -> N.BnNat:
  Maybe.default(&2, N.BnNat, N.BnNat.of_hex(s), N.BnNat.zero())

# Properties, for every input

# OS2IP then I2OSP to the bytes' own length gives the bytes back (RFC 8017,
# section 4: the two conversions are inverse)
law octets_round_trip:
  for +o: B.Octets
  {N.BnNat.to_octets(N.BnNat.of_octets(o), B.Octets.len(o)) == Some{o} : Maybe<&2, B.Octets>}

# Small-parameter exhaustive laws

# BEGIN GENERATED by gen/exhaustive.py: exhaustive
# Montgomery's method (BnMod.exp) agrees with the reference square and
# multiply (BnMod.exp_plain), for every base and exponent below 7, modulo 7
law exp_mont_small:
  for x: Nat
  for e: Nat
  for hx: {Nat.is_lt(x, 7n) == True{} : Bool}
  for he: {Nat.is_lt(e, 7n) == True{} : Bool}
  {N.BnNat.is_eq(Md.BnMod.exp(bnlaw.nat(x), bnlaw.nat(e), N.BnNat.of_u32(7)), Md.BnMod.exp_plain(bnlaw.nat(x), bnlaw.nat(e), N.BnNat.of_u32(7))) == True{} : Bool}

# BnMod.inv: for every a below 12, modulo 12, the inverse it gives is one (a x
# = 1 mod 12), and it gives one exactly when gcd(a, 12) = 1
law inv_small:
  for a: Nat
  for ha: {Nat.is_lt(a, 12n) == True{} : Bool}
  {bnlaw.inv_ok(bnlaw.nat(a), N.BnNat.of_u32(12)) == True{} : Bool}

# the Jacobi symbol modulo the prime 11 is the Legendre symbol given by
# Euler's criterion a^5 mod 11 (bnlaw.jacobi_ok), for every a below 11
law jacobi_small:
  for a: Nat
  for ha: {Nat.is_lt(a, 11n) == True{} : Bool}
  {bnlaw.jacobi_ok(bnlaw.nat(a), N.BnNat.of_u32(11)) == True{} : Bool}
# END GENERATED: exhaustive

# Vectors (values from Python's integers)

# (2^64 - 1)^2
law mul_vector:
  {N.BnNat.hex(N.BnNat.mul(bnlaw.hex("ffffffffffffffff"), bnlaw.hex("ffffffffffffffff"))) == "fffffffffffffffe0000000000000001" : String}

# (2^100 + 12345) divided by 1000003
law divmod_vector:
  {Maybe.map(&2, N.BnDivMod, String, d => N.BnNat.hex(N.BnDivMod.q(d)) ++ " " ++ N.BnNat.hex(N.BnDivMod.r(d)), N.BnNat.divmod(bnlaw.hex("10000000000000000000003039"), bnlaw.hex("f4243"))) == Some{"10c6f45449cb59c68de59 40cee"} : Maybe<&2, String>}

# 4^13 mod 497 = 445
law modexp_vector:
  {N.BnNat.to_u32(Md.BnMod.exp(N.BnNat.of_u32(4), N.BnNat.of_u32(13), N.BnNat.of_u32(497))) == 445 : U32}

# gcd(1071, 462) = 21, and 17^-1 mod 3120 = 2753
law gcd_vector:
  {N.BnNat.to_u32(Md.BnMod.gcd(N.BnNat.of_u32(1071), N.BnNat.of_u32(462))) == 21 : U32}

law inv_vector:
  {Maybe.map(&2, N.BnNat, U32, x => N.BnNat.to_u32(x), Md.BnMod.inv(N.BnNat.of_u32(17), N.BnNat.of_u32(3120))) == Some{2753} : Maybe<&2, U32>}

# 561 = 3 * 11 * 17, a Carmichael number, fails Miller-Rabin to base 2;
# 65537 is prime
law miller_rabin_561:
  {Pr.BnPrime.miller_rabin(N.BnNat.of_u32(561), [N.BnNat.of_u32(2)]) == False{} : Bool}

law prime_65537:
  {Pr.BnPrime.is_probable(N.BnNat.of_u32(65537), [N.BnNat.of_u32(2), N.BnNat.of_u32(3)]) == True{} : Bool}

# (1001 / 9907) = -1
law jacobi_vector:
  {J.BnNat.jacobi(N.BnNat.of_u32(1001), N.BnNat.of_u32(9907)) == Some{J.BnJacMinus{}} : Maybe<&2, J.BnJacobi>}
