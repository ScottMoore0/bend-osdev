# the fuel 2 T + 4 of a pair whose bit lengths add up to at most T suffices
def gc.ini(z: Bool, +a: N.BnNat, +b: N.BnNat, +T: Nat, hT: {Nat.is_le(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), T) == True{} : Bool}) -> {Nat.is_lt(gc.meas(z, a, b), Nat.add(Nat.mul(2n, T), 4n)) == True{} : Bool}:
  match z:
    case True{}:
      Equal.trans(Bool, Nat.is_lt(0n, Nat.add(Nat.mul(2n, T), 4n)), Nat.is_lt(0n, 1n+Nat.add(Nat.mul(2n, T), 3n)), True{}, Equal.cong(Nat, Bool, zz => Nat.is_lt(0n, zz), Nat.add(Nat.mul(2n, T), 4n), 1n+Nat.add(Nat.mul(2n, T), 3n), UL.nat_add_succ(Nat.mul(2n, T), 3n)), {==})
    case False{}:
      +m1 = Equal.trans(Bool, Nat.is_le(Nat.add(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), U.U32Nat.bit(Nat.is_lt(LL.bnlaw.value(a), LL.bnlaw.value(b)))), Nat.add(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), 1n)), Nat.is_le(U.U32Nat.bit(Nat.is_lt(LL.bnlaw.value(a), LL.bnlaw.value(b))), 1n), True{}, gc.lel(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), U.U32Nat.bit(Nat.is_lt(LL.bnlaw.value(a), LL.bnlaw.value(b))), 1n), gc.b1(Nat.is_lt(LL.bnlaw.value(a), LL.bnlaw.value(b))))
      +m2 = Equal.trans(Bool, Nat.is_le(Nat.add(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), 1n), Nat.add(T, 1n)), Nat.is_le(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), T), True{}, gc.ler(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), T, 1n), hT)
      PL.bq.lelt(Nat.add(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), U.U32Nat.bit(Nat.is_lt(LL.bnlaw.value(a), LL.bnlaw.value(b)))), Nat.add(T, 1n), Nat.add(Nat.mul(2n, T), 4n), PL.bq.le_trans(Nat.add(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), U.U32Nat.bit(Nat.is_lt(LL.bnlaw.value(a), LL.bnlaw.value(b)))), Nat.add(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), 1n), Nat.add(T, 1n), m1, m2), Equal.trans(Bool, Nat.is_lt(Nat.add(T, 1n), Nat.add(Nat.mul(2n, T), 4n)), Nat.is_lt(Nat.add(T, 1n), Nat.add(Nat.add(T, 2n), 1n+Nat.add(T, 1n))), True{}, Equal.sym(Bool, Nat.is_lt(Nat.add(T, 1n), Nat.add(Nat.add(T, 2n), 1n+Nat.add(T, 1n))), Nat.is_lt(Nat.add(T, 1n), Nat.add(Nat.mul(2n, T), 4n)), Equal.cong(Nat, Bool, zz => Nat.is_lt(Nat.add(T, 1n), zz), Nat.add(Nat.add(T, 2n), 1n+Nat.add(T, 1n)), Nat.add(Nat.mul(2n, T), 4n), gc.r4(T))), UL.nat_lt_add(Nat.add(T, 1n), Nat.add(T, 2n))))

# Euclid's loop: its result is kmath's gcd of the values, and valid

def gc.go(f: Nat, z: Bool, +a: N.BnNat, +b: N.BnNat, ez: {N.BnNat.is_zero(b) == z : Bool}, +ha: {LL.bnlaw.valid(a) == True{} : Bool}, +hb: {LL.bnlaw.valid(b) == True{} : Bool}, hf: {Nat.is_lt(gc.meas(z, a, b), f) == True{} : Bool}) -> {LL.bnlaw.value(Md.bn.gcd.go(f, z, a, b)) == K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)) : Nat}:
  match f:
    case 0n:
      Empty.absurd({LL.bnlaw.value(Md.bn.gcd.go(0n, z, a, b)) == K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)) : Nat}, gc.lt0(gc.meas(z, a, b), hf))
    case 1n+ +p:
      match z:
        case True{}:
          Equal.sym(Nat, K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), LL.bnlaw.value(a), Equal.trans(Nat, K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), K.KMath.gcd(LL.bnlaw.value(a), 0n), LL.bnlaw.value(a), Equal.cong(Nat, Nat, zz => K.KMath.gcd(LL.bnlaw.value(a), zz), LL.bnlaw.value(b), 0n, gc.vz(b, ez)), KL.gcd_zero_r(LL.bnlaw.value(a))))
        case False{}:
          +hB = gc.vnz(b, ez)
          +hr = LD.mod_valid(a, b, ha)
          +er = LD.mod_value(a, b, ha, hb)
          +ih = gc.go(p, N.BnNat.is_zero(N.BnNat.mod(a, b)), b, N.BnNat.mod(a, b), {==}, hb, hr, gc.fs(N.BnNat.is_zero(N.BnNat.mod(a, b)), a, b, N.BnNat.mod(a, b), p, {==}, ha, hb, hr, hB, LD.mod_lt(a, b, ha, hb, hB), er, hf))
          Equal.trans(Nat, LL.bnlaw.value(Md.bn.gcd.go(p, N.BnNat.is_zero(N.BnNat.mod(a, b)), b, N.BnNat.mod(a, b))), K.KMath.gcd(LL.bnlaw.value(b), LL.bnlaw.value(N.BnNat.mod(a, b))), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), ih, Equal.trans(Nat, K.KMath.gcd(LL.bnlaw.value(b), LL.bnlaw.value(N.BnNat.mod(a, b))), K.KMath.gcd(LL.bnlaw.value(b), Nat.mod(LL.bnlaw.value(a), LL.bnlaw.value(b))), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), Equal.cong(Nat, Nat, zz => K.KMath.gcd(LL.bnlaw.value(b), zz), LL.bnlaw.value(N.BnNat.mod(a, b)), Nat.mod(LL.bnlaw.value(a), LL.bnlaw.value(b)), er), gc.ks(LL.bnlaw.value(a), LL.bnlaw.value(b), hB)))

def gc.vk(f: Nat, z: Bool, +a: N.BnNat, +b: N.BnNat, +ha: {LL.bnlaw.valid(a) == True{} : Bool}, +hb: {LL.bnlaw.valid(b) == True{} : Bool}) -> {LL.bnlaw.valid(Md.bn.gcd.go(f, z, a, b)) == True{} : Bool}:
  match f:
    case 0n:
      ha
    case 1n+p:
      match z:
        case True{}:
          ha
        case False{}:
          gc.vk(p, N.BnNat.is_zero(N.BnNat.mod(a, b)), b, N.BnNat.mod(a, b), hb, LD.mod_valid(a, b, ha))

def gc.top(+a: N.BnNat, +b: N.BnNat, +ha: {LL.bnlaw.valid(a) == True{} : Bool}, +hb: {LL.bnlaw.valid(b) == True{} : Bool}) -> {LL.bnlaw.value(Md.BnMod.gcd(a, b)) == K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)) : Nat}:
  gc.go(Md.bn.euclid.fuel(a, b), N.BnNat.is_zero(b), a, b, {==}, ha, hb, gc.ini(N.BnNat.is_zero(b), a, b, Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)), UL.nat_le_refl(Nat.add(N.BnNat.bit_len(a), N.BnNat.bit_len(b)))))

def gc.gv(+a: N.BnNat, +b: N.BnNat, +ha: {LL.bnlaw.valid(a) == True{} : Bool}, +hb: {LL.bnlaw.valid(b) == True{} : Bool}) -> {LL.bnlaw.valid(Md.BnMod.gcd(a, b)) == True{} : Bool}:
  gc.vk(Md.bn.euclid.fuel(a, b), N.BnNat.is_zero(b), a, b, ha, hb)

# lcm(a, b) = (a / gcd(a, b)) b
def gc.lv(+a: N.BnNat, +b: N.BnNat, +ha: {LL.bnlaw.valid(a) == True{} : Bool}, +hb: {LL.bnlaw.valid(b) == True{} : Bool}) -> {LL.bnlaw.value(Md.BnMod.lcm(a, b)) == K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)) : Nat}:
  Equal.trans(Nat, LL.bnlaw.value(N.BnNat.mul(N.BnNat.div(a, Md.BnMod.gcd(a, b)), b)), Nat.mul(LL.bnlaw.value(N.BnNat.div(a, Md.BnMod.gcd(a, b))), LL.bnlaw.value(b)), Nat.mul(Nat.div(LL.bnlaw.value(a), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b))), LL.bnlaw.value(b)), LM.mul_value(N.BnNat.div(a, Md.BnMod.gcd(a, b)), b, LD.div_valid(a, Md.BnMod.gcd(a, b)), hb), Equal.cong(Nat, Nat, zz => Nat.mul(zz, LL.bnlaw.value(b)), LL.bnlaw.value(N.BnNat.div(a, Md.BnMod.gcd(a, b))), Nat.div(LL.bnlaw.value(a), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b))), Equal.trans(Nat, LL.bnlaw.value(N.BnNat.div(a, Md.BnMod.gcd(a, b))), Nat.div(LL.bnlaw.value(a), LL.bnlaw.value(Md.BnMod.gcd(a, b))), Nat.div(LL.bnlaw.value(a), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b))), LD.div_value(a, Md.BnMod.gcd(a, b), ha, gc.gv(a, b, ha, hb)), Equal.cong(Nat, Nat, zz => Nat.div(LL.bnlaw.value(a), zz), LL.bnlaw.value(Md.BnMod.gcd(a, b)), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), gc.top(a, b, ha, hb)))))

# The laws

def Laws.gcd_value(a, b, ha, hb):
  gc.top(a, b, ha, hb)

def Laws.gcd_valid(a, b, ha, hb):
  gc.gv(a, b, ha, hb)

def Laws.gcd_divides_l(a, b, ha, hb):
  gc.dl(LL.bnlaw.value(Md.BnMod.gcd(a, b)), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), LL.bnlaw.value(a), gc.top(a, b, ha, hb), KL.gcd_divides_l(LL.bnlaw.value(a), LL.bnlaw.value(b)))

def Laws.gcd_divides_r(a, b, ha, hb):
  gc.dl(LL.bnlaw.value(Md.BnMod.gcd(a, b)), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), LL.bnlaw.value(b), gc.top(a, b, ha, hb), KL.gcd_divides_r(LL.bnlaw.value(a), LL.bnlaw.value(b)))

def Laws.gcd_greatest(a, b, ha, hb, d, u, v, eu, ev):
  gc.dr(d, K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), LL.bnlaw.value(Md.BnMod.gcd(a, b)), Equal.sym(Nat, LL.bnlaw.value(Md.BnMod.gcd(a, b)), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), gc.top(a, b, ha, hb)), KL.gcd_greatest(LL.bnlaw.value(a), LL.bnlaw.value(b), d, u, v, eu, ev))

def Laws.gcd_zero_r(a, b, ha, hb, hz):
  Equal.trans(Nat, LL.bnlaw.value(Md.BnMod.gcd(a, b)), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), LL.bnlaw.value(a), gc.top(a, b, ha, hb), Equal.trans(Nat, K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), K.KMath.gcd(LL.bnlaw.value(a), 0n), LL.bnlaw.value(a), Equal.cong(Nat, Nat, zz => K.KMath.gcd(LL.bnlaw.value(a), zz), LL.bnlaw.value(b), 0n, hz), KL.gcd_zero_r(LL.bnlaw.value(a))))

def Laws.gcd_zero_l(a, b, ha, hb, hz):
  Equal.trans(Nat, LL.bnlaw.value(Md.BnMod.gcd(a, b)), K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), LL.bnlaw.value(b), gc.top(a, b, ha, hb), Equal.trans(Nat, K.KMath.gcd(LL.bnlaw.value(a), LL.bnlaw.value(b)), K.KMath.gcd(0n, LL.bnlaw.value(b)), LL.bnlaw.value(b), Equal.cong(Nat, Nat, zz => K.KMath.gcd(zz, LL.bnlaw.value(b)), LL.bnlaw.value(a), 0n, hz), KL.gcd_zero_l(LL.bnlaw.value(b))))

def Laws.lcm_value(a, b, ha, hb):
  gc.lv(a, b, ha, hb)

def Laws.lcm_valid(a, b):
  LM.mul_valid(N.BnNat.div(a, Md.BnMod.gcd(a, b)), b)

def Laws.lcm_multiple_l(a, b, ha, hb):
  gc.dr(LL.bnlaw.value(a), K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)), LL.bnlaw.value(Md.BnMod.lcm(a, b)), Equal.sym(Nat, LL.bnlaw.value(Md.BnMod.lcm(a, b)), K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)), gc.lv(a, b, ha, hb)), KL.lcm_multiple_l(LL.bnlaw.value(a), LL.bnlaw.value(b)))

def Laws.lcm_multiple_r(a, b, ha, hb):
  gc.dr(LL.bnlaw.value(b), K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)), LL.bnlaw.value(Md.BnMod.lcm(a, b)), Equal.sym(Nat, LL.bnlaw.value(Md.BnMod.lcm(a, b)), K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)), gc.lv(a, b, ha, hb)), KL.lcm_multiple_r(LL.bnlaw.value(a), LL.bnlaw.value(b)))

def Laws.lcm_least(a, b, ha, hb, m, u, v, eu, ev):
  gc.dl(LL.bnlaw.value(Md.BnMod.lcm(a, b)), K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)), m, gc.lv(a, b, ha, hb), KL.lcm_least(LL.bnlaw.value(a), LL.bnlaw.value(b), m, u, v, eu, ev))

def Laws.lcm_zero_r(a, b, ha, hb, hz):
  Equal.trans(Nat, LL.bnlaw.value(Md.BnMod.lcm(a, b)), K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)), 0n, gc.lv(a, b, ha, hb), Equal.trans(Nat, K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)), K.KMath.lcm(LL.bnlaw.value(a), 0n), 0n, Equal.cong(Nat, Nat, zz => K.KMath.lcm(LL.bnlaw.value(a), zz), LL.bnlaw.value(b), 0n, hz), KL.lcm_zero_r(LL.bnlaw.value(a))))

def Laws.lcm_zero_l(a, b, ha, hb, hz):
  Equal.trans(Nat, LL.bnlaw.value(Md.BnMod.lcm(a, b)), K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)), 0n, gc.lv(a, b, ha, hb), Equal.trans(Nat, K.KMath.lcm(LL.bnlaw.value(a), LL.bnlaw.value(b)), K.KMath.lcm(0n, LL.bnlaw.value(b)), 0n, Equal.cong(Nat, Nat, zz => K.KMath.lcm(zz, LL.bnlaw.value(b)), LL.bnlaw.value(a), 0n, hz), KL.lcm_zero_l(LL.bnlaw.value(b))))
