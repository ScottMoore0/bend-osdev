# The bound of a U32 value, in the exact form a law takes it

def bm.ve(+w: Word(32n)) -> {Word.to_nat(32n, w) == U32.to_nat(U32{w}) : Nat}:
  {==}

def bm.lt32(+x: U32) -> {Nat.is_lt(U32.to_nat(x), U.U32Nat.dbl(32n, 1n)) == True{} : Bool}:
  match x:
    case U32{+w}:
      %bm.ve(w) : {Nat.is_lt(_, U.U32Nat.dbl(32n, 1n)) == True{} : Bool}
      UL.word_value_lt(32n, w)

