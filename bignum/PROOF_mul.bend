def bm.mok(b: List<&2, U32>, +x: U32, acc: List<&2, U32>, +c: U32, +ha: {LL.bnlaw.ok(acc) == True{} : Bool}, +hc: {Nat.is_lt(U32.to_nat(c), U.U32Nat.dbl(16n, 1n)) == True{} : Bool}) -> {LL.bnlaw.ok(N.bn.mac(b, x, acc, c)) == True{} : Bool}:
  match b acc:
    case Con{+y, +ys} Con{+z, +zs}:
      PL.bq.and3(U32.is_zero(U32.shrn(U32.and(65535, U32.add(U32.add(z, U32.mul(x, y)), c)), 16n)), LL.bnlaw.ok(N.bn.mac(ys, x, zs, U32.shrn(U32.add(U32.add(z, U32.mul(x, y)), c), 16n))), PL.bq.mk(U32.add(U32.add(z, U32.mul(x, y)), c)), bm.mok(ys, x, zs, U32.shrn(U32.add(U32.add(z, U32.mul(x, y)), c), 16n), PL.bq.and2(U32.is_zero(U32.shrn(z, 16n)), LL.bnlaw.ok(zs), ha), bm.hc(U32.add(U32.add(z, U32.mul(x, y)), c))))
    case Con{+y, +ys} Nil{}:
      PL.bq.and3(U32.is_zero(U32.shrn(U32.and(65535, U32.add(U32.mul(x, y), c)), 16n)), LL.bnlaw.ok(N.bn.mac(ys, x, Nil{}, U32.shrn(U32.add(U32.mul(x, y), c), 16n))), PL.bq.mk(U32.add(U32.mul(x, y), c)), bm.mok(ys, x, Nil{}, U32.shrn(U32.add(U32.mul(x, y), c), 16n), {==}, bm.hc(U32.add(U32.mul(x, y), c))))
    case Nil{} Nil{}:
      PL.bq.ck(Nil{}, c, {==}, hc)
    case Nil{} Con{+z, +zs}:
      PL.bq.ck(Con{z, zs}, c, ha, hc)

# The product: the rows add up to a b, and every limb is 16-bit

def bm.r12(+x0: Nat, +x1: Nat, +x2: Nat) -> {Nat.add(Nat.add(U.U32Nat.dbl(16n, Nat.mul(x0, x1)), Nat.mul(x2, x1)), 0n) == Nat.mul(Nat.add(x2, U.U32Nat.dbl(16n, x0)), x1) : Nat}:
  %Equal.sym(Nat, Nat.mul(x2, x1), Nat.mul(x1, x2), UL.nat_mul_comm(x2, x1)) : {Nat.add(Nat.add(U.U32Nat.dbl(16n, Nat.mul(x0, x1)), _), 0n) == Nat.mul(Nat.add(x2, U.U32Nat.dbl(16n, x0)), x1) : Nat}
  %Equal.sym(Nat, Nat.add(U.U32Nat.dbl(16n, Nat.mul(x0, x1)), Nat.mul(x1, x2)), Nat.add(Nat.mul(x1, x2), U.U32Nat.dbl(16n, Nat.mul(x0, x1))), UL.nat_add_comm(U.U32Nat.dbl(16n, Nat.mul(x0, x1)), Nat.mul(x1, x2))) : {Nat.add(_, 0n) == Nat.mul(Nat.add(x2, U.U32Nat.dbl(16n, x0)), x1) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(x1, x2), U.U32Nat.dbl(16n, Nat.mul(x0, x1))), 0n), Nat.add(Nat.mul(x1, x2), U.U32Nat.dbl(16n, Nat.mul(x0, x1))), UL.nat_add_zero(Nat.add(Nat.mul(x1, x2), U.U32Nat.dbl(16n, Nat.mul(x0, x1))))) : {_ == Nat.mul(Nat.add(x2, U.U32Nat.dbl(16n, x0)), x1) : Nat}
  %Equal.sym(Nat, U.U32Nat.dbl(16n, Nat.mul(x0, x1)), Nat.mul(U.U32Nat.dbl(16n, x0), x1), Equal.sym(Nat, Nat.mul(U.U32Nat.dbl(16n, x0), x1), U.U32Nat.dbl(16n, Nat.mul(x0, x1)), UL.dbl_mul_l(16n, x0, x1))) : {Nat.add(Nat.mul(x1, x2), _) == Nat.mul(Nat.add(x2, U.U32Nat.dbl(16n, x0)), x1) : Nat}
  %Equal.sym(Nat, Nat.mul(x1, x2), Nat.mul(x2, x1), Equal.sym(Nat, Nat.mul(x2, x1), Nat.mul(x1, x2), UL.nat_mul_comm(x2, x1))) : {Nat.add(_, Nat.mul(U.U32Nat.dbl(16n, x0), x1)) == Nat.mul(Nat.add(x2, U.U32Nat.dbl(16n, x0)), x1) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(x2, x1), Nat.mul(U.U32Nat.dbl(16n, x0), x1)), Nat.mul(Nat.add(x2, U.U32Nat.dbl(16n, x0)), x1), Equal.sym(Nat, Nat.mul(Nat.add(x2, U.U32Nat.dbl(16n, x0)), x1), Nat.add(Nat.mul(x2, x1), Nat.mul(U.U32Nat.dbl(16n, x0), x1)), UL.nat_add_mul(x2, U.U32Nat.dbl(16n, x0), x1))) : {_ == Nat.mul(Nat.add(x2, U.U32Nat.dbl(16n, x0)), x1) : Nat}
  {==}

def bm.mlk(xs: List<&2, U32>, +b: List<&2, U32>) -> {LL.bnlaw.ok(N.bn.mul(xs, b)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      bm.mok(b, x, Con{0, N.bn.mul(t, b)}, 0, bm.mlk(t, b), PL.bq.z16())

def bm.mlv(xs: List<&2, U32>, +b: List<&2, U32>, +hx: {LL.bnlaw.ok(xs) == True{} : Bool}, +hb: {LL.bnlaw.ok(b) == True{} : Bool}) -> {LL.bnlaw.val(N.bn.mul(xs, b)) == Nat.mul(LL.bnlaw.val(xs), LL.bnlaw.val(b)) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      +hx1 = PL.bq.lv(x, PL.bq.and1(U32.is_zero(U32.shrn(x, 16n)), LL.bnlaw.ok(t), hx))
      +ih = bm.mlv(t, b, PL.bq.and2(U32.is_zero(U32.shrn(x, 16n)), LL.bnlaw.ok(t), hx), hb)
      Equal.trans(Nat, LL.bnlaw.val(N.bn.mac(b, x, Con{0, N.bn.mul(t, b)}, 0)), Nat.add(Nat.add(U.U32Nat.dbl(16n, LL.bnlaw.val(N.bn.mul(t, b))), Nat.mul(U32.to_nat(x), LL.bnlaw.val(b))), 0n), Nat.mul(Nat.add(U32.to_nat(x), U.U32Nat.dbl(16n, LL.bnlaw.val(t))), LL.bnlaw.val(b)), bm.mv(b, x, Con{0, N.bn.mul(t, b)}, 0, hb, hx1, bm.mlk(t, b), PL.bq.z16()), Equal.trans(Nat, Nat.add(Nat.add(U.U32Nat.dbl(16n, LL.bnlaw.val(N.bn.mul(t, b))), Nat.mul(U32.to_nat(x), LL.bnlaw.val(b))), 0n), Nat.add(Nat.add(U.U32Nat.dbl(16n, Nat.mul(LL.bnlaw.val(t), LL.bnlaw.val(b))), Nat.mul(U32.to_nat(x), LL.bnlaw.val(b))), 0n), Nat.mul(Nat.add(U32.to_nat(x), U.U32Nat.dbl(16n, LL.bnlaw.val(t))), LL.bnlaw.val(b)), Equal.cong(Nat, Nat, zz => Nat.add(Nat.add(U.U32Nat.dbl(16n, zz), Nat.mul(U32.to_nat(x), LL.bnlaw.val(b))), 0n), LL.bnlaw.val(N.bn.mul(t, b)), Nat.mul(LL.bnlaw.val(t), LL.bnlaw.val(b)), ih), bm.r12(LL.bnlaw.val(t), LL.bnlaw.val(b), U32.to_nat(x))))

def Laws.mul_value(a, b, ha, hb):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bm.mlv(x, y, ha, hb)

def Laws.mul_valid(a, b):
  match a b:
    case N.BnNat{+x} N.BnNat{+y}:
      bm.mlk(x, y)

