# CRCs in three pieces: the streaming law twice

def Laws.crc32_hash_split3(spec, a, b, c):
  %CL.streaming32(spec, C.Crc32Spec.update(spec, C.Crc32Spec.start(spec), a), b, c) : {CR.CrCrc32.final(~spec, _) == CR.CrCrc32.digest(~spec, B.Octets.append(a, B.Octets.append(b, c))) : B.Octets}
  %CL.streaming32(spec, C.Crc32Spec.start(spec), a, B.Octets.append(b, c)) : {CR.CrCrc32.final(~spec, _) == CR.CrCrc32.digest(~spec, B.Octets.append(a, B.Octets.append(b, c))) : B.Octets}
  {==}

