  %xor_update_ref(~S, ~next, s, B.Octets.append(a, b)) : {St.CrXor.out_data(~S, _) == B.Octets.append(B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s)), B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)))) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(a, b)), B.append(B.Octets.to_list(a), B.Octets.to_list(b)), BL.octets_append_list(a, b)) : {B.Octets.of_list(St.cr.ks.xs(~S, ~next, _, s)) == B.Octets.append(B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s)), B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)))) : B.Octets}
  %Equal.sym(List<&2, U32>, St.cr.ks.xs(~S, ~next, B.append(B.Octets.to_list(a), B.Octets.to_list(b)), s), B.append(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s), St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s))), ks_xs_append(~S, ~next, B.Octets.to_list(a), B.Octets.to_list(b), s)) : {B.Octets.of_list(_) == B.Octets.append(B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s)), B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)))) : B.Octets}
  octets_of_append(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s), St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)))

# CTR: CrXor over CTR's keystream generator

def Laws.ctr_involution(K, Blk, enc, blk_of, blk_to, s, m):
  Laws.xor_involution(~Md.CrCtrState<K>, ~Md.CrCtr.next(~K, ~Blk, ~enc, ~blk_of, ~blk_to), s, m)

def Laws.ctr_streaming_data(K, Blk, enc, blk_of, blk_to, s, a, b):
  Laws.xor_streaming_data(~Md.CrCtrState<K>, ~Md.CrCtr.next(~K, ~Blk, ~enc, ~blk_of, ~blk_to), s, a, b)

def Laws.ctr_streaming_state(K, Blk, enc, blk_of, blk_to, s, a, b):
  Laws.xor_streaming_state(~Md.CrCtrState<K>, ~Md.CrCtr.next(~K, ~Blk, ~enc, ~blk_of, ~blk_to), s, a, b)

# The block formats

def Laws.cmblock_format(b):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(CM.cr.f128.bytes(b))), B.mask(CM.cr.f128.bytes(b)), BL.octets_to_of(CM.cr.f128.bytes(b))) : {CM.cr.f128.block(_) == Some{b} : Maybe<&2, M.CmBlock>}
  f128_bytes(b)

def cmblock_xx(s: M.CmBlock, k: M.CmBlock) -> {s == CM.CrBlk128.xor(CM.CrBlk128.xor(s, k), k) : M.CmBlock}:
  match s k:
    case M.CmBlock{+a0, +a1, +a2, +a3} M.CmBlock{+b0, +b1, +b2, +b3}:
      %u32_xx(a0, b0) : {M.CmBlock{a0, a1, a2, a3} == M.CmBlock{_, U32.xor(U32.xor(a1, b1), b1), U32.xor(U32.xor(a2, b2), b2), U32.xor(U32.xor(a3, b3), b3)} : M.CmBlock}
      %u32_xx(a1, b1) : {M.CmBlock{a0, a1, a2, a3} == M.CmBlock{a0, _, U32.xor(U32.xor(a2, b2), b2), U32.xor(U32.xor(a3, b3), b3)} : M.CmBlock}
      %u32_xx(a2, b2) : {M.CmBlock{a0, a1, a2, a3} == M.CmBlock{a0, a1, _, U32.xor(U32.xor(a3, b3), b3)} : M.CmBlock}
      %u32_xx(a3, b3) : {M.CmBlock{a0, a1, a2, a3} == M.CmBlock{a0, a1, a2, _} : M.CmBlock}
      {==}

def Laws.cmblock_xor(a, b):
  Equal.sym(M.CmBlock, a, CM.CrBlk128.xor(CM.CrBlk128.xor(a, b), b), cmblock_xx(a, b))

def Laws.lcblock64_format(b):
  LL.block64_octets_round_trip(b)

def lcblock64_xx(s: L.LcBlock64, k: L.LcBlock64) -> {s == LC.CrBlk64.xor(LC.CrBlk64.xor(s, k), k) : L.LcBlock64}:
  match s k:
    case L.LcBlock64{+a0, +a1} L.LcBlock64{+b0, +b1}:
      %u32_xx(a0, b0) : {L.LcBlock64{a0, a1} == L.LcBlock64{_, U32.xor(U32.xor(a1, b1), b1)} : L.LcBlock64}
      %u32_xx(a1, b1) : {L.LcBlock64{a0, a1} == L.LcBlock64{a0, _} : L.LcBlock64}
      {==}

def Laws.lcblock64_xor(a, b):
  Equal.sym(L.LcBlock64, a, LC.CrBlk64.xor(LC.CrBlk64.xor(a, b), b), lcblock64_xx(a, b))

# ECB and CBC: the loops that run are the structural forms (for every block
# cipher; the round trips, which need the cipher's own law, are per instance)

def ecb_tr(~K: Data, ~Blk: Data, ~f: K -> Blk -> Blk, +k: K, bs: List<&2, Blk>, +acc: List<&2, Blk>) -> {Md.cr.ecb.go(~K, ~Blk, ~f, k, bs, acc) == Md.cr.blks.rev_onto(~Blk, acc, Md.cr.ecb(~K, ~Blk, ~f, k, bs)) : List<&2, Blk>}:
  match bs:
    case Nil{}:
      {==}
    case Con{b, t}:
      ecb_tr(~K, ~Blk, ~f, k, t, Con{f(k, b), acc})

def ecb_pub(~K: Data, ~Blk: Data, ~f: K -> Blk -> Blk, +k: K, bs: List<&2, Blk>) -> {Md.cr.ecb.go(~K, ~Blk, ~f, k, bs, Nil{}) == Md.cr.ecb(~K, ~Blk, ~f, k, bs) : List<&2, Blk>}:
  ecb_tr(~K, ~Blk, ~f, k, bs, Nil{})

def cbc_enc_tr(~K: Data, ~Blk: Data, ~enc: K -> Blk -> Blk, ~bxor: Blk -> Blk -> Blk, +k: K, bs: List<&2, Blk>, +iv: Blk, +acc: List<&2, Blk>) -> {Md.cr.cbc.enc.go(~K, ~Blk, ~enc, ~bxor, k, bs, iv, acc) == Md.cr.blks.rev_onto(~Blk, acc, Md.cr.cbc.enc(~K, ~Blk, ~enc, ~bxor, k, bs, iv)) : List<&2, Blk>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+p, t}:
      cbc_enc_tr(~K, ~Blk, ~enc, ~bxor, k, t, enc(k, bxor(p, iv)), Con{enc(k, bxor(p, iv)), acc})

def cbc_dec_tr(~K: Data, ~Blk: Data, ~dec: K -> Blk -> Blk, ~bxor: Blk -> Blk -> Blk, +k: K, bs: List<&2, Blk>, +iv: Blk, +acc: List<&2, Blk>) -> {Md.cr.cbc.dec.go(~K, ~Blk, ~dec, ~bxor, k, bs, iv, acc) == Md.cr.blks.rev_onto(~Blk, acc, Md.cr.cbc.dec(~K, ~Blk, ~dec, ~bxor, k, bs, iv)) : List<&2, Blk>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+c, t}:
      cbc_dec_tr(~K, ~Blk, ~dec, ~bxor, k, t, c, Con{bxor(dec(k, c), iv), acc})

def cbc_enc_pub(~K: Data, ~Blk: Data, ~enc: K -> Blk -> Blk, ~bxor: Blk -> Blk -> Blk, +k: K, bs: List<&2, Blk>, +iv: Blk) -> {Md.cr.cbc.enc.go(~K, ~Blk, ~enc, ~bxor, k, bs, iv, Nil{}) == Md.cr.cbc.enc(~K, ~Blk, ~enc, ~bxor, k, bs, iv) : List<&2, Blk>}:
  cbc_enc_tr(~K, ~Blk, ~enc, ~bxor, k, bs, iv, Nil{})

def cbc_dec_pub(~K: Data, ~Blk: Data, ~dec: K -> Blk -> Blk, ~bxor: Blk -> Blk -> Blk, +k: K, bs: List<&2, Blk>, +iv: Blk) -> {Md.cr.cbc.dec.go(~K, ~Blk, ~dec, ~bxor, k, bs, iv, Nil{}) == Md.cr.cbc.dec(~K, ~Blk, ~dec, ~bxor, k, bs, iv) : List<&2, Blk>}:
  cbc_dec_tr(~K, ~Blk, ~dec, ~bxor, k, bs, iv, Nil{})

# MACs

def Laws.mac_verify_tag_accepts(K, compute, k, m):
  BL.octets_is_eq_refl(compute(k, m))

def Laws.mac_verify_tag_agrees(K, compute, k, m, t):
  {==}

def Laws.hmac_accepts(digest, kk, m):
  Laws.mac_verify_tag_accepts(~Hm.CrHmacKey, ~Hm.CrHmac.mac(~digest), kk, m)

def Laws.cmac_accepts(K, enc, k, m):
  Laws.mac_verify_tag_accepts(~K, ~CMI.CrCmac.mac(~K, ~enc), k, m)

# CRCs as hashes: from crc's streaming laws

def Laws.crc32_hash_streaming(spec, c, a, b):
  CL.streaming32(spec, c, a, b)

def Laws.crc32_hash_split(spec, a, b):
  %CL.streaming32(spec, C.Crc32Spec.start(spec), a, b) : {CR.CrCrc32.final(~spec, _) == CR.CrCrc32.digest(~spec, B.Octets.append(a, b)) : B.Octets}
  {==}

def Laws.crc64_hash_streaming(spec, c, a, b):
  CL.streaming64(spec, c, a, b)

def Laws.crc64_hash_split(spec, a, b):
  %CL.streaming64(spec, C.Crc64Spec.start(spec), a, b) : {CR.CrCrc64.final(~spec, _) == CR.CrCrc64.digest(~spec, B.Octets.append(a, b)) : B.Octets}
  {==}

# AEADs

def Laws.lift_round_trip(E, f, d, r, p, h):
  match r:
    case Fail{e}:
      {==}
    case Done{c}:
      %Equal.sym(Result<&2, &2, E, B.Octets>, d(c), Done{p}, h) : {Cr.CrError.lift(~E, ~B.Octets, ~f, _) == Done{p} : Result<&2, &2, Cr.CrError, B.Octets>}
      {==}

def Laws.ccm_round_trip_if(K, enc, tlen, k, nonce, aad, p, h):
  Laws.lift_round_trip(~M.CmError, ~CM.CrCm.err, c => MC.Ccm.decrypt(~K, ~enc, k, tlen, nonce, aad, c), MC.Ccm.encrypt(~K, ~enc, k, tlen, nonce, aad, p), p, h)

# Signatures and key agreement

def Laws.sign_verify_bytes_if(SK, PK, public, pk_of, pk_to, sign, verify, sk, m, hf, ha):
  %Equal.sym(Result<&2, &2, Cr.CrError, PK>, pk_of(pk_to(public(sk))), Done{public(sk)}, hf) : {Sg.cr.sign.check(~PK, ~verify, _, m, sign(sk, m)) == True{} : Bool}
  ha

def Laws.kex_agree_if(SK, PK, secret, public, pk_of, pk_to, shared, a, b, x, y, hx, hy, hfx, hfy, h):
  %Equal.sym(Result<&2, &2, Cr.CrError, SK>, secret(a), Done{x}, hx) : {Kx.cr.kex.with(~SK, ~PK, ~shared, _, pk_of(pk_to(public(y)))) == Kx.CrKex.agree(~SK, ~PK, ~secret, ~pk_of, ~shared, b, pk_to(public(x))) : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Result<&2, &2, Cr.CrError, PK>, pk_of(pk_to(public(y))), Done{public(y)}, hfy) : {Kx.cr.kex.with(~SK, ~PK, ~shared, Done{x}, _) == Kx.CrKex.agree(~SK, ~PK, ~secret, ~pk_of, ~shared, b, pk_to(public(x))) : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Result<&2, &2, Cr.CrError, SK>, secret(b), Done{y}, hy) : {shared(x, public(y)) == Kx.cr.kex.with(~SK, ~PK, ~shared, _, pk_of(pk_to(public(x)))) : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Result<&2, &2, Cr.CrError, PK>, pk_of(pk_to(public(x))), Done{public(x)}, hfx) : {shared(x, public(y)) == Kx.cr.kex.with(~SK, ~PK, ~shared, Done{y}, _) : Result<&2, &2, Cr.CrError, B.Octets>}
  h

