# The 128-bit block format

def Laws.cmblock_format(b):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(CM.cr.f128.bytes(b))), B.mask(CM.cr.f128.bytes(b)), BL.octets_to_of(CM.cr.f128.bytes(b))) : {CM.cr.f128.block(_) == Some{b} : Maybe<&2, M.CmBlock>}
  Bits.f128_bytes(b)

def Laws.cmblock_xor(a, b):
  Equal.sym(M.CmBlock, a, CM.CrBlk128.xor(CM.CrBlk128.xor(a, b), b), Bits.cmblock_xx(a, b))

def Laws.cmac_accepts(K, enc, k, m):
  CrL.mac_verify_tag_accepts(~K, ~CMI.CrCmac.mac(~K, ~enc), k, m)

def Laws.ccm_round_trip_if(K, enc, tlen, k, nonce, aad, p, h):
  CrL.lift_round_trip(~M.CmError, ~CM.CrCm.err, c => MC.Ccm.decrypt(~K, ~enc, k, tlen, nonce, aad, c), MC.Ccm.encrypt(~K, ~enc, k, tlen, nonce, aad, p), p, h)

# cipher-modes' ccm_round_trip is the hypothesis, at the same arguments
def Laws.ccm_aead_round_trip(K, enc, tlen, k, nonce, aad, p):
  Laws.ccm_round_trip_if(~K, ~enc, ~tlen, k, nonce, aad, p, CML.ccm_round_trip(~K, ~enc, k, tlen, nonce, aad, p))

def Laws.aes_fips197_c1():
  {==}

