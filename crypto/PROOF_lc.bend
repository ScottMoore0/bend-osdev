def ecb_rt.cast6(+k: C6.LcCast6Key, bs: List<&2, M.CmBlock>) -> {bs == Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, k, Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, k, bs)) : List<&2, M.CmBlock>}:
  match bs:
    case Nil{}:
      {==}
    case Con{b, t}:
      %Equal.sym(M.CmBlock, C6.LcCast6.decrypt(k, C6.LcCast6.encrypt(k, b)), b, Cast6L.cast6_round_trip(k, b)) : {Con{b, t} == Con{_, Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, k, Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, k, t))} : List<&2, M.CmBlock>}
      %ecb_rt.cast6(k, t) : {Con{b, t} == Con{b, _} : List<&2, M.CmBlock>}
      {==}

def Laws.cast6_ecb_round_trip(k, bs):
  %Equal.sym(List<&2, M.CmBlock>, Md.cr.ecb.go(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, k, bs, Nil{}), Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, k, bs), PM.ecb_pub(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, k, bs)) : {Md.cr.ecb.go(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, k, _, Nil{}) == bs : List<&2, M.CmBlock>}
  %Equal.sym(List<&2, M.CmBlock>, Md.cr.ecb.go(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, k, Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, k, bs), Nil{}), Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, k, Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, k, bs)), PM.ecb_pub(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, k, Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, k, bs))) : {_ == bs : List<&2, M.CmBlock>}
  Equal.sym(List<&2, M.CmBlock>, bs, Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, k, Md.cr.ecb(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, k, bs)), ecb_rt.cast6(k, bs))

def cbc_rt.cast6(+k: C6.LcCast6Key, bs: List<&2, M.CmBlock>, +iv: M.CmBlock) -> {bs == Md.cr.cbc.dec(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, ~CM.CrBlk128.xor, k, Md.cr.cbc.enc(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, bs, iv), iv) : List<&2, M.CmBlock>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+p, t}:
      %Equal.sym(M.CmBlock, C6.LcCast6.decrypt(k, C6.LcCast6.encrypt(k, CM.CrBlk128.xor(p, iv))), CM.CrBlk128.xor(p, iv), Cast6L.cast6_round_trip(k, CM.CrBlk128.xor(p, iv))) : {Con{p, t} == Con{CM.CrBlk128.xor(_, iv), Md.cr.cbc.dec(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, ~CM.CrBlk128.xor, k, Md.cr.cbc.enc(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, t, C6.LcCast6.encrypt(k, CM.CrBlk128.xor(p, iv))), C6.LcCast6.encrypt(k, CM.CrBlk128.xor(p, iv)))} : List<&2, M.CmBlock>}
      %Bits.cmblock_xx(p, iv) : {Con{p, t} == Con{_, Md.cr.cbc.dec(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, ~CM.CrBlk128.xor, k, Md.cr.cbc.enc(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, t, C6.LcCast6.encrypt(k, CM.CrBlk128.xor(p, iv))), C6.LcCast6.encrypt(k, CM.CrBlk128.xor(p, iv)))} : List<&2, M.CmBlock>}
      %cbc_rt.cast6(k, t, C6.LcCast6.encrypt(k, CM.CrBlk128.xor(p, iv))) : {Con{p, t} == Con{p, _} : List<&2, M.CmBlock>}
      {==}

def Laws.cast6_cbc_round_trip(k, iv, bs):
  %Equal.sym(List<&2, M.CmBlock>, Md.cr.cbc.enc.go(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, bs, iv, Nil{}), Md.cr.cbc.enc(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, bs, iv), PM.cbc_enc_pub(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, bs, iv)) : {Md.cr.cbc.dec.go(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, ~CM.CrBlk128.xor, k, _, iv, Nil{}) == bs : List<&2, M.CmBlock>}
  %Equal.sym(List<&2, M.CmBlock>, Md.cr.cbc.dec.go(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, ~CM.CrBlk128.xor, k, Md.cr.cbc.enc(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, bs, iv), iv, Nil{}), Md.cr.cbc.dec(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, ~CM.CrBlk128.xor, k, Md.cr.cbc.enc(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, bs, iv), iv), PM.cbc_dec_pub(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, ~CM.CrBlk128.xor, k, Md.cr.cbc.enc(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, bs, iv), iv)) : {_ == bs : List<&2, M.CmBlock>}
  Equal.sym(List<&2, M.CmBlock>, bs, Md.cr.cbc.dec(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, ~CM.CrBlk128.xor, k, Md.cr.cbc.enc(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, bs, iv), iv), cbc_rt.cast6(k, bs, iv))

def pcbc_rt.cast6(+k: C6.LcCast6Key, bs: List<&2, M.CmBlock>, +iv: M.CmBlock) -> {bs == Pc.cr.pcbc.dec(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.decrypt, ~CM.CrBlk128.xor, k, Pc.cr.pcbc.enc(~C6.LcCast6Key, ~M.CmBlock, ~C6.LcCast6.encrypt, ~CM.CrBlk128.xor, k, bs, iv), iv) : List<&2, M.CmBlock>}:
