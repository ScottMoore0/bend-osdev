# The 64-bit block format

def Laws.lcblock64_format(b):
  CoreL.block64_octets_round_trip(b)

def Laws.lcblock64_xor(a, b):
  Equal.sym(L.LcBlock64, a, LC.CrBlk64.xor(LC.CrBlk64.xor(a, b), b), Bits.lcblock64_xx(a, b))

