      %Bits.cmblock_xx(Tf.LcTwofish.encrypt(k, CM.CrBlk128.xor(p, x)), x) : {p == CM.CrBlk128.xor(Tf.LcTwofish.decrypt(k, _), x) : M.CmBlock}
