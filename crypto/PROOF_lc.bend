def lrw_b.sm4(+k: S.LcSm4Key, t: Maybe<&2, M.CmBlock>, +p: M.CmBlock) -> {p == Lw.cr.lrw.bdec(~S.LcSm4Key, ~M.CmBlock, ~S.LcSm4.decrypt, ~CM.CrBlk128.xor, k, t, Lw.cr.lrw.benc(~S.LcSm4Key, ~M.CmBlock, ~S.LcSm4.encrypt, ~CM.CrBlk128.xor, k, t, p)) : M.CmBlock}:
  match t:
    case None{}:
      Equal.sym(M.CmBlock, S.LcSm4.decrypt(k, S.LcSm4.encrypt(k, p)), p, Sm4L.sm4_round_trip(k, p))
    case Some{+x}:
      %Bits.cmblock_xx(S.LcSm4.encrypt(k, CM.CrBlk128.xor(p, x)), x) : {p == CM.CrBlk128.xor(S.LcSm4.decrypt(k, _), x) : M.CmBlock}
      %Equal.sym(M.CmBlock, S.LcSm4.decrypt(k, S.LcSm4.encrypt(k, CM.CrBlk128.xor(p, x))), CM.CrBlk128.xor(p, x), Sm4L.sm4_round_trip(k, CM.CrBlk128.xor(p, x))) : {p == CM.CrBlk128.xor(_, x) : M.CmBlock}
      Bits.cmblock_xx(p, x)

