# Laws of the cipher packages' algorithms (des, sm4, camellia, serpent,
# twofish, aria, cast6, blowfish, cast5, tea, xtea, fcrypt, rc4, and
# cipher-core's 64-bit block) through crypto's interfaces: the 64-bit
# block format (inst_lc.bend), each block cipher as a block cipher and in
# ECB, CBC, PCBC and (the 128-bit ones, in cipher-modes' block format) LRW,
# RC4 as a stream cipher (inst_rc4.bend), and refusals of the modes over
# them. The generic laws are in LAWS.bend.
#
# A law that needs a property of the algorithm (a block cipher's decryption
# undoes its encryption) cannot take that property as a hypothesis and still
# pass --verdict (a template hypothesis has no model in the BendTT kernel,
# and an ordinary one is affine, so an induction cannot use it at every
# step). Those laws are stated once per instance instead, from the law
# schemas in gen/instances.py, which also writes their proofs (the generated
# regions here and in the proof file).
import Base
import ../bytes/bytes.bend as B
import ../cipher-modes/cipher-modes.bend as M
import ../cipher-core/cipher-core.bend as L
import ../des/des.bend as D
import ../des/tdes.bend as T
import ../sm4/sm4.bend as S
import ../camellia/camellia.bend as Ca
import ../serpent/serpent.bend as Sp
import ../twofish/twofish.bend as Tf
import ../rc4/rc4.bend as R
import ../aria/aria.bend as Ar
import ../cast6/cast6.bend as C6
import ../blowfish/blowfish.bend as Bf
import ../cast5/cast5.bend as C5
import ../tea/tea.bend as Te
import ../xtea/xtea.bend as Xt
import ../fcrypt/fcrypt.bend as Fc
import ./crypto.bend as Cr
import ./modes.bend as Md
import ./pcbc.bend as Pc
import ./lrw.bend as Lw
import ../gf/gf128.bend as G
import ./inst_cm.bend as CM
import ./inst_lc.bend as LC
import ./inst_rc4.bend as RC

# The 64-bit block format (inst_lc.bend): a block read back from its bytes
# is itself, and XOR with the same block twice changes nothing

law lcblock64_format:
  for +b: L.LcBlock64
  {L.LcBlock64.of_octets(L.LcBlock64.to_octets(b)) == Some{b} : Maybe<&2, L.LcBlock64>}

law lcblock64_xor:
  for a: L.LcBlock64
  for b: L.LcBlock64
  {LC.CrBlk64.xor(LC.CrBlk64.xor(a, b), b) == a : L.LcBlock64}

# refusals: an RC4 key of 0 bytes, an IV given to RC4, a CTR counter block
# of the wrong length (over DES), and bytes that are not whole blocks (of
# 64 bits)
law rc4_empty_key:
  {Result.map(&2, &2, Cr.CrError, R.LcRc4State, Unit, s => Unit{}, RC.CrRc4.start(B.Octets.empty(), B.Octets.empty())) == Fail{Cr.CrBadKeyLength{0n}} : Result<&2, &2, Cr.CrError, Unit>}

law rc4_iv_refused:
  {Result.map(&2, &2, Cr.CrError, R.LcRc4State, Unit, s => Unit{}, RC.CrRc4.start(B.Octets.empty(), B.Octets.zeros(1n))) == Fail{Cr.CrBadIvLength{1n}} : Result<&2, &2, Cr.CrError, Unit>}

law ctr_bad_iv:
  {Result.map(&2, &2, Cr.CrError, Md.CrCtrState<D.LcDesKey>, Unit, s => Unit{}, Md.CrCtr.start(~D.LcDesKey, ~8n, ~LC.CrLc.key(~D.LcDesKey, ~D.LcDes.key), B.Octets.zeros(8n), B.Octets.zeros(7n))) == Fail{Cr.CrBadIvLength{7n}} : Result<&2, &2, Cr.CrError, Unit>}

law blocks_of_not_whole:
  {Result.map(&2, &2, Cr.CrError, List<&2, L.LcBlock64>, Unit, bs => Unit{}, Md.CrModes.blocks_of(~L.LcBlock64, ~8n, ~L.LcBlock64.of_octets, B.Octets.zeros(12n))) == Fail{Cr.CrNotBlockMultiple{12n}} : Result<&2, &2, Cr.CrError, Unit>}

# Per-instance laws, from the law schemas (gen/instances.py)

# BEGIN GENERATED by gen/instances.py: laws
# DES (the des package): decryption undoes encryption, for every key and block
law des_block_round_trip:
  for k: D.LcDesKey
  for +b: L.LcBlock64
  {D.LcDes.decrypt(k, D.LcDes.encrypt(k, b)) == b : L.LcBlock64}

# DES (the des package): encryption undoes decryption (a permutation of the blocks)
law des_block_round_trip_dual:
  for k: D.LcDesKey
  for +b: L.LcBlock64
  {D.LcDes.encrypt(k, D.LcDes.decrypt(k, b)) == b : L.LcBlock64}

# DES (the des package): a key of 7 bytes is refused
law des_key_length:
  {Result.map(&2, &2, Cr.CrError, D.LcDesKey, Unit, k => Unit{}, LC.CrLc.key(~D.LcDesKey, ~D.LcDes.key, B.Octets.zeros(7n))) == Fail{Cr.CrBadKeyLength{7n}} : Result<&2, &2, Cr.CrError, Unit>}

# DES (the des package) in ECB (modes.bend): decryption undoes encryption, for every key and list of blocks
law des_ecb_round_trip:
  for +k: D.LcDesKey
  for +bs: List<&2, L.LcBlock64>
  {Md.CrEcb.decrypt_blocks(~D.LcDesKey, ~L.LcBlock64, ~D.LcDes.decrypt, k, Md.CrEcb.encrypt_blocks(~D.LcDesKey, ~L.LcBlock64, ~D.LcDes.encrypt, k, bs)) == bs : List<&2, L.LcBlock64>}

# DES (the des package) in CBC (modes.bend): decryption undoes encryption, for every key, IV and list of blocks
law des_cbc_round_trip:
  for +k: D.LcDesKey
  for +iv: L.LcBlock64
  for +bs: List<&2, L.LcBlock64>
  {Md.CrCbc.decrypt_blocks(~D.LcDesKey, ~L.LcBlock64, ~D.LcDes.decrypt, ~LC.CrBlk64.xor, k, iv, Md.CrCbc.encrypt_blocks(~D.LcDesKey, ~L.LcBlock64, ~D.LcDes.encrypt, ~LC.CrBlk64.xor, k, iv, bs)) == bs : List<&2, L.LcBlock64>}

# DES (the des package) in PCBC (pcbc.bend): decryption undoes encryption, for every key, IV and list of blocks
law des_pcbc_round_trip:
  for +k: D.LcDesKey
  for +iv: L.LcBlock64
  for +bs: List<&2, L.LcBlock64>
  {Pc.CrPcbc.decrypt_blocks(~D.LcDesKey, ~L.LcBlock64, ~D.LcDes.decrypt, ~LC.CrBlk64.xor, k, iv, Pc.CrPcbc.encrypt_blocks(~D.LcDesKey, ~L.LcBlock64, ~D.LcDes.encrypt, ~LC.CrBlk64.xor, k, iv, bs)) == bs : List<&2, L.LcBlock64>}

