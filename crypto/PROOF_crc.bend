def Laws.hmac_crc64_split(spec, kk, a, b):
  match kk:
    case Hm.CrHmacKey{+i, +o}:
      %Equal.sym(B.Octets, CR.CrCrc64.final(~spec, CR.CrCrc64.update(~spec, CR.CrCrc64.update(~spec, CR.CrCrc64.update(~spec, CR.CrCrc64.init(~spec), i), a), b)), CR.CrCrc64.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))), Laws.crc64_hash_split3(~spec, i, a, b)) : {CR.CrCrc64.final(~spec, CR.CrCrc64.update(~spec, CR.CrCrc64.update(~spec, CR.CrCrc64.init(~spec), o), _)) == CR.CrCrc64.digest(~spec, B.Octets.append(o, CR.CrCrc64.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))) : B.Octets}
      %Equal.sym(B.Octets, CR.CrCrc64.final(~spec, CR.CrCrc64.update(~spec, CR.CrCrc64.update(~spec, CR.CrCrc64.init(~spec), o), CR.CrCrc64.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))), CR.CrCrc64.digest(~spec, B.Octets.append(o, CR.CrCrc64.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))), Laws.crc64_hash_split(~spec, o, CR.CrCrc64.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))) : {_ == CR.CrCrc64.digest(~spec, B.Octets.append(o, CR.CrCrc64.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))) : B.Octets}
