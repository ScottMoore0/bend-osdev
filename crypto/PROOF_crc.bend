def Laws.hmac_crc32_streaming(spec, s, a, b):
  match s:
    case Hm.CrHmacState{h, o}:
      %Laws.crc32_hash_streaming(~spec, h, a, b) : {Hm.CrHmacState{CR.CrCrc32.update(~spec, h, B.Octets.append(a, b)), o} == Hm.CrHmacState{_, o} : Hm.CrHmacState<U32>}
      {==}

def Laws.hmac_crc32_split(spec, kk, a, b):
  match kk:
    case Hm.CrHmacKey{+i, +o}:
      %Equal.sym(B.Octets, CR.CrCrc32.final(~spec, CR.CrCrc32.update(~spec, CR.CrCrc32.update(~spec, CR.CrCrc32.update(~spec, CR.CrCrc32.init(~spec), i), a), b)), CR.CrCrc32.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))), Laws.crc32_hash_split3(~spec, i, a, b)) : {CR.CrCrc32.final(~spec, CR.CrCrc32.update(~spec, CR.CrCrc32.update(~spec, CR.CrCrc32.init(~spec), o), _)) == CR.CrCrc32.digest(~spec, B.Octets.append(o, CR.CrCrc32.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))) : B.Octets}
      %Equal.sym(B.Octets, CR.CrCrc32.final(~spec, CR.CrCrc32.update(~spec, CR.CrCrc32.update(~spec, CR.CrCrc32.init(~spec), o), CR.CrCrc32.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))), CR.CrCrc32.digest(~spec, B.Octets.append(o, CR.CrCrc32.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))), Laws.crc32_hash_split(~spec, o, CR.CrCrc32.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))) : {_ == CR.CrCrc32.digest(~spec, B.Octets.append(o, CR.CrCrc32.digest(~spec, B.Octets.append(i, B.Octets.append(a, b))))) : B.Octets}
      {==}

def Laws.hmac_crc64_streaming(spec, s, a, b):
