def Laws.hpet_round_trip(h, sig4, oem6, tid8, cid4, h0, oem6b, tid8b, cid4b, id, gs, gw, go, ga, gaddr, n, m, p, gs8, gw8, go8, ga8, n8, m16, p8):
  match h:
    case H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}:
      match h0:
        case H.AcpiHeader{s0, l0, r0, c0, o0, t0, orv0, ci0, cr0}:
          %tb.sdt_body(B.Octets.of_string("HPET"), l0, r0, c0, o0, t0, orv0, ci0, cr0, {==}, oem6b, tid8b, cid4b, B.Octets.concat([B.Octets.le32(id), G.AcpiGas.encode(G.AcpiGas{gs, gw, go, ga, gaddr}), B.Octets.of_list([n]), B.Octets.le16(m), B.Octets.of_list([p])])) : {Hp.AcpiHpet.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, _}) == Done{Hp.AcpiHpet{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, id, G.AcpiGas{gs, gw, go, ga, gaddr}, n, m, p}} : Result<&2, &2, E.AcpiError, Hp.AcpiHpet>}
          %WL.parts_of(gaddr) : {Hp.AcpiHpet.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le32(id), G.AcpiGas.encode(G.AcpiGas{gs, gw, go, ga, _}), B.Octets.of_list([n]), B.Octets.le16(m), B.Octets.of_list([p])])}) == Done{Hp.AcpiHpet{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, id, G.AcpiGas{gs, gw, go, ga, _}, n, m, p}} : Result<&2, &2, E.AcpiError, Hp.AcpiHpet>}
          %gs8 : {Hp.AcpiHpet.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le32(id), G.AcpiGas.encode(G.AcpiGas{gs, gw, go, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}), B.Octets.of_list([n]), B.Octets.le16(m), B.Octets.of_list([p])])}) == Done{Hp.AcpiHpet{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, id, G.AcpiGas{_, gw, go, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}, n, m, p}} : Result<&2, &2, E.AcpiError, Hp.AcpiHpet>}
          %gw8 : {Hp.AcpiHpet.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le32(id), G.AcpiGas.encode(G.AcpiGas{gs, gw, go, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}), B.Octets.of_list([n]), B.Octets.le16(m), B.Octets.of_list([p])])}) == Done{Hp.AcpiHpet{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, id, G.AcpiGas{B.byte(gs), _, go, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}, n, m, p}} : Result<&2, &2, E.AcpiError, Hp.AcpiHpet>}
          %go8 : {Hp.AcpiHpet.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le32(id), G.AcpiGas.encode(G.AcpiGas{gs, gw, go, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}), B.Octets.of_list([n]), B.Octets.le16(m), B.Octets.of_list([p])])}) == Done{Hp.AcpiHpet{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, id, G.AcpiGas{B.byte(gs), B.byte(gw), _, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}, n, m, p}} : Result<&2, &2, E.AcpiError, Hp.AcpiHpet>}
          %ga8 : {Hp.AcpiHpet.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le32(id), G.AcpiGas.encode(G.AcpiGas{gs, gw, go, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}), B.Octets.of_list([n]), B.Octets.le16(m), B.Octets.of_list([p])])}) == Done{Hp.AcpiHpet{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, id, G.AcpiGas{B.byte(gs), B.byte(gw), B.byte(go), _, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}, n, m, p}} : Result<&2, &2, E.AcpiError, Hp.AcpiHpet>}
          %n8 : {Hp.AcpiHpet.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le32(id), G.AcpiGas.encode(G.AcpiGas{gs, gw, go, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}), B.Octets.of_list([n]), B.Octets.le16(m), B.Octets.of_list([p])])}) == Done{Hp.AcpiHpet{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, id, G.AcpiGas{B.byte(gs), B.byte(gw), B.byte(go), B.byte(ga), W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}, _, m, p}} : Result<&2, &2, E.AcpiError, Hp.AcpiHpet>}
          %m16 : {Hp.AcpiHpet.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le32(id), G.AcpiGas.encode(G.AcpiGas{gs, gw, go, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}), B.Octets.of_list([n]), B.Octets.le16(m), B.Octets.of_list([p])])}) == Done{Hp.AcpiHpet{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, id, G.AcpiGas{B.byte(gs), B.byte(gw), B.byte(go), B.byte(ga), W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}, B.byte(n), _, p}} : Result<&2, &2, E.AcpiError, Hp.AcpiHpet>}
          %p8 : {Hp.AcpiHpet.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le32(id), G.AcpiGas.encode(G.AcpiGas{gs, gw, go, ga, W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}), B.Octets.of_list([n]), B.Octets.le16(m), B.Octets.of_list([p])])}) == Done{Hp.AcpiHpet{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, id, G.AcpiGas{B.byte(gs), B.byte(gw), B.byte(go), B.byte(ga), W.W64.from_parts(W.W64.hi(gaddr), W.W64.lo(gaddr))}, B.byte(n), B.low16(m), _}} : Result<&2, &2, E.AcpiError, Hp.AcpiHpet>}
          tb.hp(s, l, r, c, o, t, orv, ci, cr, sig4, oem6, tid8, cid4, id, gs, gw, go, ga, W.W64.hi(gaddr), W.W64.lo(gaddr), n, m, p)

def Laws.bgrt_round_trip(h, sig4, oem6, tid8, cid4, h0, oem6b, tid8b, cid4b, v, st, it, a, x, y, v16, st8, it8):
  match h:
    case H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}:
      match h0:
        case H.AcpiHeader{s0, l0, r0, c0, o0, t0, orv0, ci0, cr0}:
          %tb.sdt_body(B.Octets.of_string("BGRT"), l0, r0, c0, o0, t0, orv0, ci0, cr0, {==}, oem6b, tid8b, cid4b, B.Octets.concat([B.Octets.le16(v), B.Octets.of_list([st, it]), B.Octets.le64(a), B.Octets.le32(x), B.Octets.le32(y)])) : {Bg.AcpiBgrt.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, _}) == Done{Bg.AcpiBgrt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, v, st, it, a, x, y}} : Result<&2, &2, E.AcpiError, Bg.AcpiBgrt>}
          %WL.parts_of(a) : {Bg.AcpiBgrt.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le16(v), B.Octets.of_list([st, it]), B.Octets.le64(_), B.Octets.le32(x), B.Octets.le32(y)])}) == Done{Bg.AcpiBgrt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, v, st, it, _, x, y}} : Result<&2, &2, E.AcpiError, Bg.AcpiBgrt>}
          %v16 : {Bg.AcpiBgrt.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le16(v), B.Octets.of_list([st, it]), B.Octets.le64(W.W64.from_parts(W.W64.hi(a), W.W64.lo(a))), B.Octets.le32(x), B.Octets.le32(y)])}) == Done{Bg.AcpiBgrt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, _, st, it, W.W64.from_parts(W.W64.hi(a), W.W64.lo(a)), x, y}} : Result<&2, &2, E.AcpiError, Bg.AcpiBgrt>}
          %st8 : {Bg.AcpiBgrt.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le16(v), B.Octets.of_list([st, it]), B.Octets.le64(W.W64.from_parts(W.W64.hi(a), W.W64.lo(a))), B.Octets.le32(x), B.Octets.le32(y)])}) == Done{Bg.AcpiBgrt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.low16(v), _, it, W.W64.from_parts(W.W64.hi(a), W.W64.lo(a)), x, y}} : Result<&2, &2, E.AcpiError, Bg.AcpiBgrt>}
          %it8 : {Bg.AcpiBgrt.of_sdt(H.AcpiSdt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.Octets.concat([B.Octets.le16(v), B.Octets.of_list([st, it]), B.Octets.le64(W.W64.from_parts(W.W64.hi(a), W.W64.lo(a))), B.Octets.le32(x), B.Octets.le32(y)])}) == Done{Bg.AcpiBgrt{H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}, B.low16(v), B.byte(st), _, W.W64.from_parts(W.W64.hi(a), W.W64.lo(a)), x, y}} : Result<&2, &2, E.AcpiError, Bg.AcpiBgrt>}
          tb.bg(s, l, r, c, o, t, orv, ci, cr, sig4, oem6, tid8, cid4, v, st, it, W.W64.hi(a), W.W64.lo(a), x, y)

# Lists of entries: lengths are multiples of the entry size, and Nat's
# division by it counts them

def gapp_nil(-A: Data, +xs: List<&2, A>) -> {xs == List.append(&2, A, xs, Nil{}) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      %gapp_nil(A, t) : {Con{h, t} == Con{h, _} : List<&2, A>}
      {==}

def rev_app(-A: Data, +xs: List<&2, A>, +a: List<&2, A>, +b: List<&2, A>) -> {List.reverse.go(&2, A, a, List.append(&2, A, xs, b)) == List.reverse.go(&2, A, List.reverse.go(&2, A, xs, a), b) : List<&2, A>}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      rev_app(A, t, Con{h, a}, b)

def revrev(-A: Data, +xs: List<&2, A>) -> {xs == List.reverse(&2, A, List.reverse.go(&2, A, xs, Nil{})) : List<&2, A>}:
  Equal.trans(List<&2, A>, xs, List.append(&2, A, xs, Nil{}), List.reverse(&2, A, List.reverse.go(&2, A, xs, Nil{})), gapp_nil(A, xs), rev_app(A, xs, Nil{}, Nil{}))

def tb.asr(+x: Nat, +a: Nat) -> {1n+Nat.add(x, a) == Nat.add(x, 1n+a) : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      %tb.asr(p, a) : {1n+1n+Nat.add(p, a) == 1n+_ : Nat}
      {==}

def tb.srv(+xs: List<&2, W.W64>, +acc: List<&2, W.W64>) -> {List.reverse.go(&2, W.W64, xs, acc) == R.sl.rev(xs, acc) : List<&2, W.W64>}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      tb.srv(t, Con{h, acc})

def tb.srev(+xs: List<&2, W.W64>) -> {xs == R.sl.rev(R.sl.rev(xs, Nil{}), Nil{}) : List<&2, W.W64>}:
  %tb.srv(R.sl.rev(xs, Nil{}), Nil{}) : {xs == _ : List<&2, W.W64>}
  %tb.srv(xs, Nil{}) : {xs == List.reverse.go(&2, W.W64, _, Nil{}) : List<&2, W.W64>}
  revrev(W.W64, xs)

def tb.dm4(+n: Nat, +d: Nat) -> {Nat.divmod.go(Nat.mul(n, 4n), 3n, d, 0n) == (Nat.add(n, d), 0n) : Nat & Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.mul(p, 4n), 3n, 1n+d, 0n), (Nat.add(p, 1n+d), 0n), tb.dm4(p, 1n+d)) : {_ == (Nat.add(1n+p, d), 0n) : Nat & Nat}
      %tb.asr(p, d) : {(_, 0n) == (Nat.add(1n+p, d), 0n) : Nat & Nat}
      {==}

def tb.dm8(+n: Nat, +d: Nat) -> {Nat.divmod.go(Nat.mul(n, 8n), 7n, d, 0n) == (Nat.add(n, d), 0n) : Nat & Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.mul(p, 8n), 7n, 1n+d, 0n), (Nat.add(p, 1n+d), 0n), tb.dm8(p, 1n+d)) : {_ == (Nat.add(1n+p, d), 0n) : Nat & Nat}
      %tb.asr(p, d) : {(_, 0n) == (Nat.add(1n+p, d), 0n) : Nat & Nat}
      {==}

def tb.dm16(+n: Nat, +d: Nat) -> {Nat.divmod.go(Nat.mul(n, 16n), 15n, d, 0n) == (Nat.add(n, d), 0n) : Nat & Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.mul(p, 16n), 15n, 1n+d, 0n), (Nat.add(p, 1n+d), 0n), tb.dm16(p, 1n+d)) : {_ == (Nat.add(1n+p, d), 0n) : Nat & Nat}
      %tb.asr(p, d) : {(_, 0n) == (Nat.add(1n+p, d), 0n) : Nat & Nat}
      {==}

def tb.xlen(+xs: List<&2, W.W64>) -> {Nat.mul(List.length(&2, W.W64, xs), 8n) == B.Octets.len(B.Octets.concat(R.sl.enc(xs, True{}))) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      %Equal.sym(B.Octets, B.Octets.concat(Con{B.Octets.le64(x), R.sl.enc(t, True{})}), B.Octets.append(B.Octets.le64(x), B.Octets.concat(R.sl.enc(t, True{}))), BL.octets_concat_cons(B.Octets.le64(x), R.sl.enc(t, True{}))) : {Nat.mul(List.length(&2, W.W64, Con{x, t}), 8n) == B.Octets.len(_) : Nat}
      %tb.la(B.Octets.le64(x), B.Octets.concat(R.sl.enc(t, True{}))) : {Nat.mul(List.length(&2, W.W64, Con{x, t}), 8n) == _ : Nat}
      %Equal.sym(Nat, B.Octets.len(B.Octets.le64(x)), 8n, BL.octets_len_le64(x)) : {Nat.mul(List.length(&2, W.W64, Con{x, t}), 8n) == Nat.add(_, B.Octets.len(B.Octets.concat(R.sl.enc(t, True{})))) : Nat}
      %tb.xlen(t) : {Nat.mul(List.length(&2, W.W64, Con{x, t}), 8n) == Nat.add(8n, _) : Nat}
      {==}

def tb.rlen(+xs: List<&2, W.W64>) -> {Nat.mul(List.length(&2, W.W64, xs), 4n) == B.Octets.len(B.Octets.concat(R.sl.enc(xs, False{}))) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      %Equal.sym(B.Octets, B.Octets.concat(Con{B.Octets.le32(W.W64.lo(x)), R.sl.enc(t, False{})}), B.Octets.append(B.Octets.le32(W.W64.lo(x)), B.Octets.concat(R.sl.enc(t, False{}))), BL.octets_concat_cons(B.Octets.le32(W.W64.lo(x)), R.sl.enc(t, False{}))) : {Nat.mul(List.length(&2, W.W64, Con{x, t}), 4n) == B.Octets.len(_) : Nat}
      %tb.la(B.Octets.le32(W.W64.lo(x)), B.Octets.concat(R.sl.enc(t, False{}))) : {Nat.mul(List.length(&2, W.W64, Con{x, t}), 4n) == _ : Nat}
      %Equal.sym(Nat, B.Octets.len(B.Octets.le32(W.W64.lo(x))), 4n, BL.octets_len_le32(W.W64.lo(x))) : {Nat.mul(List.length(&2, W.W64, Con{x, t}), 4n) == Nat.add(_, B.Octets.len(B.Octets.concat(R.sl.enc(t, False{})))) : Nat}
      %tb.rlen(t) : {Nat.mul(List.length(&2, W.W64, Con{x, t}), 4n) == Nat.add(4n, _) : Nat}
      {==}

def tb.l32(+v: U32) -> {Nat.is_le(4n, B.Octets.len(B.Octets.le32(v))) == True{} : Bool}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.le32(v)), 4n, BL.octets_len_le32(v)) : {Nat.is_le(4n, _) == True{} : Bool}
  {==}

def tb.e8(+v: W.W64) -> {Nat.add(B.Octets.len(B.Octets.le64(v)), 0n) == 8n : Nat}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.le64(v)), 8n, BL.octets_len_le64(v)) : {Nat.add(_, 0n) == 8n : Nat}
  {==}

def tb.e4(+v: U32) -> {Nat.add(B.Octets.len(B.Octets.le32(v)), 0n) == 4n : Nat}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.le32(v)), 4n, BL.octets_len_le32(v)) : {Nat.add(_, 0n) == 4n : Nat}
  {==}

def tb.d8(+v: W.W64, +rest: B.Octets) -> {rest == B.Octets.drop(8n, B.Octets.append(B.Octets.le64(v), rest)) : B.Octets}:
  %tb.e8(v) : {rest == B.Octets.drop(_, B.Octets.append(B.Octets.le64(v), rest)) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.drop(Nat.add(B.Octets.len(B.Octets.le64(v)), 0n), B.Octets.append(B.Octets.le64(v), rest)), B.Octets.drop(0n, rest), BL.octets_drop_append_add(B.Octets.le64(v), 0n, rest)) : {rest == _ : B.Octets}
  %Equal.sym(B.Octets, B.Octets.drop(0n, rest), rest, BL.octets_drop_zero(rest)) : {rest == _ : B.Octets}
  {==}

def tb.d4(+v: U32, +rest: B.Octets) -> {rest == B.Octets.drop(4n, B.Octets.append(B.Octets.le32(v), rest)) : B.Octets}:
  %tb.e4(v) : {rest == B.Octets.drop(_, B.Octets.append(B.Octets.le32(v), rest)) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.drop(Nat.add(B.Octets.len(B.Octets.le32(v)), 0n), B.Octets.append(B.Octets.le32(v), rest)), B.Octets.drop(0n, rest), BL.octets_drop_append_add(B.Octets.le32(v), 0n, rest)) : {rest == _ : B.Octets}
  %Equal.sym(B.Octets, B.Octets.drop(0n, rest), rest, BL.octets_drop_zero(rest)) : {rest == _ : B.Octets}
  {==}

def tb.g8(+v: W.W64, +rest: B.Octets) -> {v == F.AcpiF.u64(B.Octets.append(B.Octets.le64(v), rest), 0n) : W.W64}:
  %Equal.sym(Maybe<&2, W.W64>, B.Octets.le64_at(B.Octets.append(B.Octets.le64(v), rest), 0n), B.Octets.le64_at(B.Octets.le64(v), 0n), BL.octets_le64_at_append_le(B.Octets.le64(v), rest, 0n, tb.l64(v))) : {v == Maybe.default(&2, W.W64, _, W.W64.zero()) : W.W64}
  %Equal.sym(Maybe<&2, W.W64>, B.Octets.le64_at(B.Octets.le64(v), 0n), Some{v}, BL.octets_le64_round_trip(v)) : {v == Maybe.default(&2, W.W64, _, W.W64.zero()) : W.W64}
  {==}

def tb.g4(+v: U32, +rest: B.Octets) -> {v == F.AcpiF.u32(B.Octets.append(B.Octets.le32(v), rest), 0n) : U32}:
  %Equal.sym(Maybe<&2, U32>, B.Octets.le32_at(B.Octets.append(B.Octets.le32(v), rest), 0n), B.Octets.le32_at(B.Octets.le32(v), 0n), BL.octets_le32_at_append_le(B.Octets.le32(v), rest, 0n, tb.l32(v))) : {v == Maybe.default(&2, U32, _, 0) : U32}
  %Equal.sym(Maybe<&2, U32>, B.Octets.le32_at(B.Octets.le32(v), 0n), Some{v}, BL.octets_le32_round_trip(v)) : {v == Maybe.default(&2, U32, _, 0) : U32}
  {==}

def tb.xread(+xs: List<&2, W.W64>, +acc: List<&2, W.W64>) -> {R.sl.read(List.length(&2, W.W64, xs), True{}, B.Octets.concat(R.sl.enc(xs, True{})), acc) == R.sl.rev(R.sl.rev(xs, acc), Nil{}) : List<&2, W.W64>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, t}:
      %Equal.sym(B.Octets, B.Octets.concat(Con{B.Octets.le64(x), R.sl.enc(t, True{})}), B.Octets.append(B.Octets.le64(x), B.Octets.concat(R.sl.enc(t, True{}))), BL.octets_concat_cons(B.Octets.le64(x), R.sl.enc(t, True{}))) : {R.sl.read(List.length(&2, W.W64, t), True{}, B.Octets.drop(8n, _), Con{F.AcpiF.u64(_, 0n), acc}) == R.sl.rev(R.sl.rev(Con{x, t}, acc), Nil{}) : List<&2, W.W64>}
      %tb.d8(x, B.Octets.concat(R.sl.enc(t, True{}))) : {R.sl.read(List.length(&2, W.W64, t), True{}, _, Con{F.AcpiF.u64(B.Octets.append(B.Octets.le64(x), B.Octets.concat(R.sl.enc(t, True{}))), 0n), acc}) == R.sl.rev(R.sl.rev(Con{x, t}, acc), Nil{}) : List<&2, W.W64>}
      %tb.g8(x, B.Octets.concat(R.sl.enc(t, True{}))) : {R.sl.read(List.length(&2, W.W64, t), True{}, B.Octets.concat(R.sl.enc(t, True{})), Con{_, acc}) == R.sl.rev(R.sl.rev(Con{x, t}, acc), Nil{}) : List<&2, W.W64>}
      tb.xread(t, Con{x, acc})

def tb.rread(+xs: List<&2, W.W64>, +acc: List<&2, W.W64>) -> {R.sl.read(List.length(&2, W.W64, xs), False{}, B.Octets.concat(R.sl.enc(xs, False{})), acc) == R.sl.rev(R.sl.rev(Laws.acpilaw.low32(xs), acc), Nil{}) : List<&2, W.W64>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, t}:
      %Equal.sym(B.Octets, B.Octets.concat(Con{B.Octets.le32(W.W64.lo(x)), R.sl.enc(t, False{})}), B.Octets.append(B.Octets.le32(W.W64.lo(x)), B.Octets.concat(R.sl.enc(t, False{}))), BL.octets_concat_cons(B.Octets.le32(W.W64.lo(x)), R.sl.enc(t, False{}))) : {R.sl.read(List.length(&2, W.W64, t), False{}, B.Octets.drop(4n, _), Con{W.W64.from_u32(F.AcpiF.u32(_, 0n)), acc}) == R.sl.rev(R.sl.rev(Laws.acpilaw.low32(Con{x, t}), acc), Nil{}) : List<&2, W.W64>}
      %tb.d4(W.W64.lo(x), B.Octets.concat(R.sl.enc(t, False{}))) : {R.sl.read(List.length(&2, W.W64, t), False{}, _, Con{W.W64.from_u32(F.AcpiF.u32(B.Octets.append(B.Octets.le32(W.W64.lo(x)), B.Octets.concat(R.sl.enc(t, False{}))), 0n)), acc}) == R.sl.rev(R.sl.rev(Laws.acpilaw.low32(Con{x, t}), acc), Nil{}) : List<&2, W.W64>}
      %tb.g4(W.W64.lo(x), B.Octets.concat(R.sl.enc(t, False{}))) : {R.sl.read(List.length(&2, W.W64, t), False{}, B.Octets.concat(R.sl.enc(t, False{})), Con{W.W64.from_u32(_), acc}) == R.sl.rev(R.sl.rev(Laws.acpilaw.low32(Con{x, t}), acc), Nil{}) : List<&2, W.W64>}
      tb.rread(t, Con{W.W64.from_u32(W.W64.lo(x)), acc})

def Laws.xsdt_round_trip(h, h0, oem6b, tid8b, cid4b, xs):
  match h0:
    case H.AcpiHeader{s0, l0, r0, c0, o0, t0, orv0, ci0, cr0}:
      %tb.sdt_body(B.Octets.of_string("XSDT"), l0, r0, c0, o0, t0, orv0, ci0, cr0, {==}, oem6b, tid8b, cid4b, B.Octets.concat(R.sl.enc(xs, True{}))) : {R.AcpiXsdt.of_sdt(H.AcpiSdt{h, _}) == Done{R.AcpiSdtList{h, xs}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %tb.xlen(xs) : {R.sl.body(Nat.is_eq(Nat.mod(_, 8n), 0n), True{}, h, B.Octets.concat(R.sl.enc(xs, True{}))) == Done{R.AcpiSdtList{h, xs}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.mul(List.length(&2, W.W64, xs), 8n), 7n, 0n, 0n), (Nat.add(List.length(&2, W.W64, xs), 0n), 0n), tb.dm8(List.length(&2, W.W64, xs), 0n)) : {R.sl.body(Nat.is_eq(Pair.snd(Nat, Nat, _), 0n), True{}, h, B.Octets.concat(R.sl.enc(xs, True{}))) == Done{R.AcpiSdtList{h, xs}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %tb.xlen(xs) : {Done{R.AcpiSdtList{h, R.sl.read(Nat.div(_, 8n), True{}, B.Octets.concat(R.sl.enc(xs, True{})), Nil{})}} == Done{R.AcpiSdtList{h, xs}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.mul(List.length(&2, W.W64, xs), 8n), 7n, 0n, 0n), (Nat.add(List.length(&2, W.W64, xs), 0n), 0n), tb.dm8(List.length(&2, W.W64, xs), 0n)) : {Done{R.AcpiSdtList{h, R.sl.read(Pair.fst(Nat, Nat, _), True{}, B.Octets.concat(R.sl.enc(xs, True{})), Nil{})}} == Done{R.AcpiSdtList{h, xs}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %Equal.sym(Nat, Nat.add(List.length(&2, W.W64, xs), 0n), List.length(&2, W.W64, xs), tb.add0(List.length(&2, W.W64, xs))) : {Done{R.AcpiSdtList{h, R.sl.read(_, True{}, B.Octets.concat(R.sl.enc(xs, True{})), Nil{})}} == Done{R.AcpiSdtList{h, xs}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %Equal.sym(List<&2, W.W64>, R.sl.read(List.length(&2, W.W64, xs), True{}, B.Octets.concat(R.sl.enc(xs, True{})), Nil{}), R.sl.rev(R.sl.rev(xs, Nil{}), Nil{}), tb.xread(xs, Nil{})) : {Done{R.AcpiSdtList{h, _}} == Done{R.AcpiSdtList{h, xs}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %tb.srev(xs) : {Done{R.AcpiSdtList{h, _}} == Done{R.AcpiSdtList{h, xs}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      {==}

def Laws.rsdt_round_trip(h, h0, oem6b, tid8b, cid4b, xs):
  match h0:
    case H.AcpiHeader{s0, l0, r0, c0, o0, t0, orv0, ci0, cr0}:
      %tb.sdt_body(B.Octets.of_string("RSDT"), l0, r0, c0, o0, t0, orv0, ci0, cr0, {==}, oem6b, tid8b, cid4b, B.Octets.concat(R.sl.enc(xs, False{}))) : {R.AcpiRsdt.of_sdt(H.AcpiSdt{h, _}) == Done{R.AcpiSdtList{h, Laws.acpilaw.low32(xs)}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %tb.rlen(xs) : {R.sl.body(Nat.is_eq(Nat.mod(_, 4n), 0n), False{}, h, B.Octets.concat(R.sl.enc(xs, False{}))) == Done{R.AcpiSdtList{h, Laws.acpilaw.low32(xs)}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.mul(List.length(&2, W.W64, xs), 4n), 3n, 0n, 0n), (Nat.add(List.length(&2, W.W64, xs), 0n), 0n), tb.dm4(List.length(&2, W.W64, xs), 0n)) : {R.sl.body(Nat.is_eq(Pair.snd(Nat, Nat, _), 0n), False{}, h, B.Octets.concat(R.sl.enc(xs, False{}))) == Done{R.AcpiSdtList{h, Laws.acpilaw.low32(xs)}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %tb.rlen(xs) : {Done{R.AcpiSdtList{h, R.sl.read(Nat.div(_, 4n), False{}, B.Octets.concat(R.sl.enc(xs, False{})), Nil{})}} == Done{R.AcpiSdtList{h, Laws.acpilaw.low32(xs)}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.mul(List.length(&2, W.W64, xs), 4n), 3n, 0n, 0n), (Nat.add(List.length(&2, W.W64, xs), 0n), 0n), tb.dm4(List.length(&2, W.W64, xs), 0n)) : {Done{R.AcpiSdtList{h, R.sl.read(Pair.fst(Nat, Nat, _), False{}, B.Octets.concat(R.sl.enc(xs, False{})), Nil{})}} == Done{R.AcpiSdtList{h, Laws.acpilaw.low32(xs)}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %Equal.sym(Nat, Nat.add(List.length(&2, W.W64, xs), 0n), List.length(&2, W.W64, xs), tb.add0(List.length(&2, W.W64, xs))) : {Done{R.AcpiSdtList{h, R.sl.read(_, False{}, B.Octets.concat(R.sl.enc(xs, False{})), Nil{})}} == Done{R.AcpiSdtList{h, Laws.acpilaw.low32(xs)}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %Equal.sym(List<&2, W.W64>, R.sl.read(List.length(&2, W.W64, xs), False{}, B.Octets.concat(R.sl.enc(xs, False{})), Nil{}), R.sl.rev(R.sl.rev(Laws.acpilaw.low32(xs), Nil{}), Nil{}), tb.rread(xs, Nil{})) : {Done{R.AcpiSdtList{h, _}} == Done{R.AcpiSdtList{h, Laws.acpilaw.low32(xs)}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      %tb.srev(Laws.acpilaw.low32(xs)) : {Done{R.AcpiSdtList{h, _}} == Done{R.AcpiSdtList{h, Laws.acpilaw.low32(xs)}} : Result<&2, &2, E.AcpiError, R.AcpiSdtList>}
      {==}

# MCFG: each 16-byte structure, its fields split into bits, computed; the
# structures after it are reached through bytes' laws

def tb.clen(+ah: U32, +al: U32, +s: U32, +lo: U32, +hi: U32) -> {16n == B.Octets.len(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)])) : Nat}:
  match ah al s:
    case U32{WCon{ah0, WCon{ah1, WCon{ah2, WCon{ah3, WCon{ah4, WCon{ah5, WCon{ah6, WCon{ah7, WCon{ah8, WCon{ah9, WCon{ah10, WCon{ah11, WCon{ah12, WCon{ah13, WCon{ah14, WCon{ah15, WCon{ah16, WCon{ah17, WCon{ah18, WCon{ah19, WCon{ah20, WCon{ah21, WCon{ah22, WCon{ah23, WCon{ah24, WCon{ah25, WCon{ah26, WCon{ah27, WCon{ah28, WCon{ah29, WCon{ah30, WCon{ah31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{al0, WCon{al1, WCon{al2, WCon{al3, WCon{al4, WCon{al5, WCon{al6, WCon{al7, WCon{al8, WCon{al9, WCon{al10, WCon{al11, WCon{al12, WCon{al13, WCon{al14, WCon{al15, WCon{al16, WCon{al17, WCon{al18, WCon{al19, WCon{al20, WCon{al21, WCon{al22, WCon{al23, WCon{al24, WCon{al25, WCon{al26, WCon{al27, WCon{al28, WCon{al29, WCon{al30, WCon{al31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{s0, WCon{s1, WCon{s2, WCon{s3, WCon{s4, WCon{s5, WCon{s6, WCon{s7, WCon{s8, WCon{s9, WCon{s10, WCon{s11, WCon{s12, WCon{s13, WCon{s14, WCon{s15, WCon{s16, WCon{s17, WCon{s18, WCon{s19, WCon{s20, WCon{s21, WCon{s22, WCon{s23, WCon{s24, WCon{s25, WCon{s26, WCon{s27, WCon{s28, WCon{s29, WCon{s30, WCon{s31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      {==}

def tb.cvals(+ah: U32, +al: U32, +s: U32, +lo: U32, +hi: U32) -> {Mc.AcpiMcfgEntry{W.W64.from_parts(ah, al), B.low16(s), B.byte(lo), B.byte(hi)} == Mc.AcpiMcfgEntry{F.AcpiF.u64(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 0n), F.AcpiF.u16(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 8n), F.AcpiF.u8(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 10n), F.AcpiF.u8(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 11n)} : Mc.AcpiMcfgEntry}:
  match ah al s:
    case U32{WCon{ah0, WCon{ah1, WCon{ah2, WCon{ah3, WCon{ah4, WCon{ah5, WCon{ah6, WCon{ah7, WCon{ah8, WCon{ah9, WCon{ah10, WCon{ah11, WCon{ah12, WCon{ah13, WCon{ah14, WCon{ah15, WCon{ah16, WCon{ah17, WCon{ah18, WCon{ah19, WCon{ah20, WCon{ah21, WCon{ah22, WCon{ah23, WCon{ah24, WCon{ah25, WCon{ah26, WCon{ah27, WCon{ah28, WCon{ah29, WCon{ah30, WCon{ah31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{al0, WCon{al1, WCon{al2, WCon{al3, WCon{al4, WCon{al5, WCon{al6, WCon{al7, WCon{al8, WCon{al9, WCon{al10, WCon{al11, WCon{al12, WCon{al13, WCon{al14, WCon{al15, WCon{al16, WCon{al17, WCon{al18, WCon{al19, WCon{al20, WCon{al21, WCon{al22, WCon{al23, WCon{al24, WCon{al25, WCon{al26, WCon{al27, WCon{al28, WCon{al29, WCon{al30, WCon{al31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{s0, WCon{s1, WCon{s2, WCon{s3, WCon{s4, WCon{s5, WCon{s6, WCon{s7, WCon{s8, WCon{s9, WCon{s10, WCon{s11, WCon{s12, WCon{s13, WCon{s14, WCon{s15, WCon{s16, WCon{s17, WCon{s18, WCon{s19, WCon{s20, WCon{s21, WCon{s22, WCon{s23, WCon{s24, WCon{s25, WCon{s26, WCon{s27, WCon{s28, WCon{s29, WCon{s30, WCon{s31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      {==}

def tb.ile(+k: Nat, +c: B.Octets, +h16: {16n == B.Octets.len(c) : Nat}, +ok: {Nat.is_le(k, 16n) == True{} : Bool}) -> {Nat.is_le(k, B.Octets.len(c)) == True{} : Bool}:
  %h16 : {Nat.is_le(k, _) == True{} : Bool}
  ok

def tb.ilt(+k: Nat, +c: B.Octets, +h16: {16n == B.Octets.len(c) : Nat}, +ok: {Nat.is_lt(k, 16n) == True{} : Bool}) -> {Nat.is_lt(k, B.Octets.len(c)) == True{} : Bool}:
  %h16 : {Nat.is_lt(k, _) == True{} : Bool}
  ok

def tb.c64(+c: B.Octets, +rest: B.Octets, +h16: {16n == B.Octets.len(c) : Nat}) -> {F.AcpiF.u64(c, 0n) == F.AcpiF.u64(B.Octets.append(c, rest), 0n) : W.W64}:
  %Equal.sym(Maybe<&2, W.W64>, B.Octets.le64_at(B.Octets.append(c, rest), 0n), B.Octets.le64_at(c, 0n), BL.octets_le64_at_append_le(c, rest, 0n, tb.ile(8n, c, h16, {==}))) : {F.AcpiF.u64(c, 0n) == Maybe.default(&2, W.W64, _, W.W64.zero()) : W.W64}
  {==}

def tb.c16(+c: B.Octets, +rest: B.Octets, +h16: {16n == B.Octets.len(c) : Nat}) -> {F.AcpiF.u16(c, 8n) == F.AcpiF.u16(B.Octets.append(c, rest), 8n) : U32}:
  %Equal.sym(Maybe<&2, U32>, B.Octets.le16_at(B.Octets.append(c, rest), 8n), B.Octets.le16_at(c, 8n), BL.octets_le16_at_append_le(c, rest, 8n, tb.ile(10n, c, h16, {==}))) : {F.AcpiF.u16(c, 8n) == Maybe.default(&2, U32, _, 0) : U32}
  {==}

def tb.c8(+c: B.Octets, +rest: B.Octets, +k: Nat, +hk: {Nat.is_lt(k, B.Octets.len(c)) == True{} : Bool}) -> {F.AcpiF.u8(c, k) == F.AcpiF.u8(B.Octets.append(c, rest), k) : U32}:
  %Equal.sym(Maybe<&2, U32>, B.Octets.at(B.Octets.append(c, rest), k), B.Octets.at(c, k), BL.octets_at_append_lt(c, rest, k, hk)) : {F.AcpiF.u8(c, k) == Maybe.default(&2, U32, _, 0) : U32}
  {==}

def tb.cdrop(+c: B.Octets, +rest: B.Octets, +h16: {16n == B.Octets.len(c) : Nat}) -> {rest == B.Octets.drop(16n, B.Octets.append(c, rest)) : B.Octets}:
  %Equal.sym(Nat, 16n, Nat.add(B.Octets.len(c), 0n), Equal.trans(Nat, 16n, B.Octets.len(c), Nat.add(B.Octets.len(c), 0n), h16, Equal.sym(Nat, Nat.add(B.Octets.len(c), 0n), B.Octets.len(c), tb.add0(B.Octets.len(c))))) : {rest == B.Octets.drop(_, B.Octets.append(c, rest)) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.drop(Nat.add(B.Octets.len(c), 0n), B.Octets.append(c, rest)), B.Octets.drop(0n, rest), BL.octets_drop_append_add(c, 0n, rest)) : {rest == _ : B.Octets}
  %Equal.sym(B.Octets, B.Octets.drop(0n, rest), rest, BL.octets_drop_zero(rest)) : {rest == _ : B.Octets}
  {==}

def tb.ment_b(+ah: U32, +al: U32, +s: U32, +lo: U32, +hi: U32, +rest: B.Octets) -> {Mc.AcpiMcfgEntry{W.W64.from_parts(ah, al), B.low16(s), B.byte(lo), B.byte(hi)} == Mc.AcpiMcfgEntry{F.AcpiF.u64(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 0n), F.AcpiF.u16(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 8n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 10n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 11n)} : Mc.AcpiMcfgEntry}:
  %tb.c64(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest, tb.clen(ah, al, s, lo, hi)) : {Mc.AcpiMcfgEntry{W.W64.from_parts(ah, al), B.low16(s), B.byte(lo), B.byte(hi)} == Mc.AcpiMcfgEntry{_, F.AcpiF.u16(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 8n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 10n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 11n)} : Mc.AcpiMcfgEntry}
  %tb.c16(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest, tb.clen(ah, al, s, lo, hi)) : {Mc.AcpiMcfgEntry{W.W64.from_parts(ah, al), B.low16(s), B.byte(lo), B.byte(hi)} == Mc.AcpiMcfgEntry{F.AcpiF.u64(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 0n), _, F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 10n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 11n)} : Mc.AcpiMcfgEntry}
  %tb.c8(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest, 10n, tb.ilt(10n, B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), tb.clen(ah, al, s, lo, hi), {==})) : {Mc.AcpiMcfgEntry{W.W64.from_parts(ah, al), B.low16(s), B.byte(lo), B.byte(hi)} == Mc.AcpiMcfgEntry{F.AcpiF.u64(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 0n), F.AcpiF.u16(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 8n), _, F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 11n)} : Mc.AcpiMcfgEntry}
  %tb.c8(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest, 11n, tb.ilt(11n, B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), tb.clen(ah, al, s, lo, hi), {==})) : {Mc.AcpiMcfgEntry{W.W64.from_parts(ah, al), B.low16(s), B.byte(lo), B.byte(hi)} == Mc.AcpiMcfgEntry{F.AcpiF.u64(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 0n), F.AcpiF.u16(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 8n), F.AcpiF.u8(B.Octets.concat([B.Octets.le64(W.W64.from_parts(ah, al)), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), 10n), _} : Mc.AcpiMcfgEntry}
  tb.cvals(ah, al, s, lo, hi)

def tb.clen_g(+b: W.W64, +s: U32, +lo: U32, +hi: U32) -> {16n == B.Octets.len(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)])) : Nat}:
  %WL.parts_of(b) : {16n == B.Octets.len(B.Octets.concat([B.Octets.le64(_), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)])) : Nat}
  tb.clen(W.W64.hi(b), W.W64.lo(b), s, lo, hi)

def tb.ment(+b: W.W64, +s: U32, +lo: U32, +hi: U32, +rest: B.Octets) -> {Mc.AcpiMcfgEntry{b, B.low16(s), B.byte(lo), B.byte(hi)} == Mc.AcpiMcfgEntry{F.AcpiF.u64(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 0n), F.AcpiF.u16(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 8n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 10n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 11n)} : Mc.AcpiMcfgEntry}:
  %WL.parts_of(b) : {Mc.AcpiMcfgEntry{_, B.low16(s), B.byte(lo), B.byte(hi)} == Mc.AcpiMcfgEntry{F.AcpiF.u64(B.Octets.append(B.Octets.concat([B.Octets.le64(_), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 0n), F.AcpiF.u16(B.Octets.append(B.Octets.concat([B.Octets.le64(_), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 8n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(_), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 10n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(_), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest), 11n)} : Mc.AcpiMcfgEntry}
  tb.ment_b(W.W64.hi(b), W.W64.lo(b), s, lo, hi, rest)

def tb.mdrop(+b: W.W64, +s: U32, +lo: U32, +hi: U32, +rest: B.Octets) -> {rest == B.Octets.drop(16n, B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest)) : B.Octets}:
  tb.cdrop(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), rest, tb.clen_g(b, s, lo, hi))

def tb.mlen(+es: List<&2, Mc.AcpiMcfgEntry>) -> {Nat.mul(List.length(&2, Mc.AcpiMcfgEntry, es), 16n) == B.Octets.len(B.Octets.concat(Mc.mcfg.enc(es))) : Nat}:
  match es:
    case Nil{}:
      {==}
    case Con{e, t}:
      match e:
        case Mc.AcpiMcfgEntry{+b, +s, +lo, +hi}:
          %Equal.sym(B.Octets, B.Octets.concat(Con{B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), Mc.mcfg.enc(t)}), B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), BL.octets_concat_cons(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), Mc.mcfg.enc(t))) : {Nat.mul(List.length(&2, Mc.AcpiMcfgEntry, Con{Mc.AcpiMcfgEntry{b, s, lo, hi}, t}), 16n) == B.Octets.len(_) : Nat}
          %tb.la(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))) : {Nat.mul(List.length(&2, Mc.AcpiMcfgEntry, Con{Mc.AcpiMcfgEntry{b, s, lo, hi}, t}), 16n) == _ : Nat}
          %tb.clen_g(b, s, lo, hi) : {Nat.mul(List.length(&2, Mc.AcpiMcfgEntry, Con{Mc.AcpiMcfgEntry{b, s, lo, hi}, t}), 16n) == Nat.add(_, B.Octets.len(B.Octets.concat(Mc.mcfg.enc(t)))) : Nat}
          %tb.mlen(t) : {Nat.mul(List.length(&2, Mc.AcpiMcfgEntry, Con{Mc.AcpiMcfgEntry{b, s, lo, hi}, t}), 16n) == Nat.add(16n, _) : Nat}
          {==}

def tb.mread(+es: List<&2, Mc.AcpiMcfgEntry>) -> {Laws.acpilaw.mcfg_fit(es) == Mc.mcfg.read(List.length(&2, Mc.AcpiMcfgEntry, es), B.Octets.concat(Mc.mcfg.enc(es))) : List<&2, Mc.AcpiMcfgEntry>}:
  match es:
    case Nil{}:
      {==}
    case Con{e, t}:
      match e:
        case Mc.AcpiMcfgEntry{+b, +s, +lo, +hi}:
          %Equal.sym(B.Octets, B.Octets.concat(Con{B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), Mc.mcfg.enc(t)}), B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), BL.octets_concat_cons(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), Mc.mcfg.enc(t))) : {Con{Mc.AcpiMcfgEntry{b, B.low16(s), B.byte(lo), B.byte(hi)}, Laws.acpilaw.mcfg_fit(t)} == Con{Mc.AcpiMcfgEntry{F.AcpiF.u64(_, 0n), F.AcpiF.u16(_, 8n), F.AcpiF.u8(_, 10n), F.AcpiF.u8(_, 11n)}, Mc.mcfg.read(List.length(&2, Mc.AcpiMcfgEntry, t), B.Octets.drop(16n, _))} : List<&2, Mc.AcpiMcfgEntry>}
          %tb.mdrop(b, s, lo, hi, B.Octets.concat(Mc.mcfg.enc(t))) : {Con{Mc.AcpiMcfgEntry{b, B.low16(s), B.byte(lo), B.byte(hi)}, Laws.acpilaw.mcfg_fit(t)} == Con{Mc.AcpiMcfgEntry{F.AcpiF.u64(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), 0n), F.AcpiF.u16(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), 8n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), 10n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), 11n)}, Mc.mcfg.read(List.length(&2, Mc.AcpiMcfgEntry, t), _)} : List<&2, Mc.AcpiMcfgEntry>}
          %tb.mread(t) : {Con{Mc.AcpiMcfgEntry{b, B.low16(s), B.byte(lo), B.byte(hi)}, Laws.acpilaw.mcfg_fit(t)} == Con{Mc.AcpiMcfgEntry{F.AcpiF.u64(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), 0n), F.AcpiF.u16(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), 8n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), 10n), F.AcpiF.u8(B.Octets.append(B.Octets.concat([B.Octets.le64(b), B.Octets.le16(s), B.Octets.of_list([lo, hi]), B.Octets.zeros(4n)]), B.Octets.concat(Mc.mcfg.enc(t))), 11n)}, _} : List<&2, Mc.AcpiMcfgEntry>}
          %tb.ment(b, s, lo, hi, B.Octets.concat(Mc.mcfg.enc(t))) : {Con{Mc.AcpiMcfgEntry{b, B.low16(s), B.byte(lo), B.byte(hi)}, Laws.acpilaw.mcfg_fit(t)} == Con{_, Laws.acpilaw.mcfg_fit(t)} : List<&2, Mc.AcpiMcfgEntry>}
          {==}

def tb.le8(+x: Nat) -> {True{} == Nat.is_le(8n, Nat.add(8n, x)) : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      {==}

def tb.sb8(+x: Nat) -> {x == Nat.sub(Nat.add(8n, x), 8n) : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      {==}

def tb.z8(+c: B.Octets) -> {c == B.Octets.drop(8n, B.Octets.append(B.Octets.zeros(8n), c)) : B.Octets}:
  %Equal.sym(B.Octets, B.Octets.drop(Nat.add(B.Octets.len(B.Octets.zeros(8n)), 0n), B.Octets.append(B.Octets.zeros(8n), c)), B.Octets.drop(0n, c), BL.octets_drop_append_add(B.Octets.zeros(8n), 0n, c)) : {c == _ : B.Octets}
  %Equal.sym(B.Octets, B.Octets.drop(0n, c), c, BL.octets_drop_zero(c)) : {c == _ : B.Octets}
  {==}

def Laws.mcfg_round_trip(h, h0, oem6b, tid8b, cid4b, es):
  match h0:
    case H.AcpiHeader{s0, l0, r0, c0, o0, t0, orv0, ci0, cr0}:
      %tb.sdt_body(B.Octets.of_string("MCFG"), l0, r0, c0, o0, t0, orv0, ci0, cr0, {==}, oem6b, tid8b, cid4b, B.Octets.append(B.Octets.zeros(8n), B.Octets.concat(Mc.mcfg.enc(es)))) : {Mc.AcpiMcfg.of_sdt(H.AcpiSdt{h, _}) == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %tb.la(B.Octets.zeros(8n), B.Octets.concat(Mc.mcfg.enc(es))) : {Mc.mcfg.body(Bool.and(Nat.is_le(8n, _), Nat.is_eq(Nat.mod(Nat.sub(_, 8n), 16n), 0n)), h, B.Octets.append(B.Octets.zeros(8n), B.Octets.concat(Mc.mcfg.enc(es)))) == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %tb.le8(B.Octets.len(B.Octets.concat(Mc.mcfg.enc(es)))) : {Mc.mcfg.body(Bool.and(_, Nat.is_eq(Nat.mod(Nat.sub(Nat.add(8n, B.Octets.len(B.Octets.concat(Mc.mcfg.enc(es)))), 8n), 16n), 0n)), h, B.Octets.append(B.Octets.zeros(8n), B.Octets.concat(Mc.mcfg.enc(es)))) == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %tb.sb8(B.Octets.len(B.Octets.concat(Mc.mcfg.enc(es)))) : {Mc.mcfg.body(Nat.is_eq(Nat.mod(_, 16n), 0n), h, B.Octets.append(B.Octets.zeros(8n), B.Octets.concat(Mc.mcfg.enc(es)))) == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %tb.mlen(es) : {Mc.mcfg.body(Nat.is_eq(Nat.mod(_, 16n), 0n), h, B.Octets.append(B.Octets.zeros(8n), B.Octets.concat(Mc.mcfg.enc(es)))) == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.mul(List.length(&2, Mc.AcpiMcfgEntry, es), 16n), 15n, 0n, 0n), (Nat.add(List.length(&2, Mc.AcpiMcfgEntry, es), 0n), 0n), tb.dm16(List.length(&2, Mc.AcpiMcfgEntry, es), 0n)) : {Mc.mcfg.body(Nat.is_eq(Pair.snd(Nat, Nat, _), 0n), h, B.Octets.append(B.Octets.zeros(8n), B.Octets.concat(Mc.mcfg.enc(es)))) == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %tb.z8(B.Octets.concat(Mc.mcfg.enc(es))) : {Done{Mc.AcpiMcfg{h, Mc.mcfg.read(Nat.div(B.Octets.len(_), 16n), _)}} == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %tb.mlen(es) : {Done{Mc.AcpiMcfg{h, Mc.mcfg.read(Nat.div(_, 16n), B.Octets.concat(Mc.mcfg.enc(es)))}} == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %Equal.sym(Nat & Nat, Nat.divmod.go(Nat.mul(List.length(&2, Mc.AcpiMcfgEntry, es), 16n), 15n, 0n, 0n), (Nat.add(List.length(&2, Mc.AcpiMcfgEntry, es), 0n), 0n), tb.dm16(List.length(&2, Mc.AcpiMcfgEntry, es), 0n)) : {Done{Mc.AcpiMcfg{h, Mc.mcfg.read(Pair.fst(Nat, Nat, _), B.Octets.concat(Mc.mcfg.enc(es)))}} == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %Equal.sym(Nat, Nat.add(List.length(&2, Mc.AcpiMcfgEntry, es), 0n), List.length(&2, Mc.AcpiMcfgEntry, es), tb.add0(List.length(&2, Mc.AcpiMcfgEntry, es))) : {Done{Mc.AcpiMcfg{h, Mc.mcfg.read(_, B.Octets.concat(Mc.mcfg.enc(es)))}} == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      %tb.mread(es) : {Done{Mc.AcpiMcfg{h, _}} == Done{Mc.AcpiMcfg{h, Laws.acpilaw.mcfg_fit(es)}} : Result<&2, &2, E.AcpiError, Mc.AcpiMcfg>}
      {==}

def Laws.aml_round_trip(h, h0, sig4b, oem6b, tid8b, cid4b, a):
  match h0:
    case H.AcpiHeader{s0, l0, r0, c0, o0, t0, orv0, ci0, cr0}:
      %tb.sdt_body(s0, l0, r0, c0, o0, t0, orv0, ci0, cr0, sig4b, oem6b, tid8b, cid4b, a) : {Ds.AcpiAml.of_sdt(H.AcpiSdt{h, _}) == Done{Ds.AcpiAml{h, a}} : Result<&2, &2, E.AcpiError, Ds.AcpiAml>}
      {==}
