# Lemmas are mostly stated as {value == expression}, the direction a rewrite
# needs: %e : P replaces the expression (marked _ in P) by the value.
#
# The fields of a structure are read by bytes' laws for fields at offsets
# inside joined bytes, or, where every 16-, 32- and 64-bit field is split
# into its bits, by computing (as bytes' own proofs do); a W64 is split
# through word64's parts_of (from_parts of its halves), and from_parts and
# le64 then compute through word64's definitions.

def tb.add0(+x: Nat) -> {Nat.add(x, 0n) == x : Nat}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      %tb.add0(p) : {1n+Nat.add(p, 0n) == 1n+_ : Nat}
      {==}

# The Generic Address Structure: its byte fields from the 4 bytes in front,
# its address from the le64 after them

def tb.gas_b(+a: B.Octets, +q: B.Octets, +r: B.Octets, +k: Nat, +hk: {Nat.is_lt(k, B.Octets.len(q)) == True{} : Bool}) -> {B.Octets.at(q, k) == B.Octets.at(B.Octets.append(a, B.Octets.append(q, r)), Nat.add(B.Octets.len(a), k)) : Maybe<&2, U32>}:
  Equal.trans(Maybe<&2, U32>, B.Octets.at(q, k), B.Octets.at(B.Octets.append(q, r), k), B.Octets.at(B.Octets.append(a, B.Octets.append(q, r)), Nat.add(B.Octets.len(a), k)), Equal.sym(Maybe<&2, U32>, B.Octets.at(B.Octets.append(q, r), k), B.Octets.at(q, k), BL.octets_at_append_lt(q, r, k, hk)), Equal.sym(Maybe<&2, U32>, B.Octets.at(B.Octets.append(a, B.Octets.append(q, r)), Nat.add(B.Octets.len(a), k)), B.Octets.at(B.Octets.append(q, r), k), BL.octets_at_append_add(a, B.Octets.append(q, r), k)))

def tb.l64(+v: W.W64) -> {Nat.is_le(8n, B.Octets.len(B.Octets.le64(v))) == True{} : Bool}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.le64(v)), 8n, BL.octets_len_le64(v)) : {Nat.is_le(8n, _) == True{} : Bool}
  {==}

def tb.gas_a(+a: B.Octets, +s: U32, +w: U32, +off: U32, +acc: U32, +addr: W.W64, +b: B.Octets) -> {Some{addr} == B.Octets.le64_at(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 4n)) : Maybe<&2, W.W64>}:
  Equal.sym(Maybe<&2, W.W64>, B.Octets.le64_at(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 4n)), Some{addr}, Equal.trans(Maybe<&2, W.W64>, B.Octets.le64_at(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 4n)), B.Octets.le64_at(B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b)), 4n), Some{addr}, BL.octets_le64_at_append_add(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b)), 4n), Equal.trans(Maybe<&2, W.W64>, B.Octets.le64_at(B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b)), 4n), B.Octets.le64_at(B.Octets.append(B.Octets.le64(addr), b), 0n), Some{addr}, BL.octets_le64_at_append_add(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b), 0n), Equal.trans(Maybe<&2, W.W64>, B.Octets.le64_at(B.Octets.append(B.Octets.le64(addr), b), 0n), B.Octets.le64_at(B.Octets.le64(addr), 0n), Some{addr}, BL.octets_le64_at_append_le(B.Octets.le64(addr), b, 0n, tb.l64(addr)), BL.octets_le64_round_trip(addr)))))

def Laws.gas_round_trip(a, s, w, off, acc, addr, b, s8, w8, off8, acc8):
  %Equal.sym(B.Octets, B.Octets.append(B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.le64(addr)), b), B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b)), BL.octets_append_assoc(B.Octets.of_list([s, w, off, acc]), B.Octets.le64(addr), b)) : {G.AcpiGas.at(B.Octets.append(a, _), B.Octets.len(a)) == G.AcpiGas{s, w, off, acc, addr} : G.AcpiGas}
  %tb.add0(B.Octets.len(a)) : {G.AcpiGas{F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), _), F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 1n)), F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 2n)), F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 3n)), F.AcpiF.u64(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 4n))} == G.AcpiGas{s, w, off, acc, addr} : G.AcpiGas}
  %tb.gas_b(a, B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b), 0n, {==}) : {G.AcpiGas{Maybe.default(&2, U32, _, 0), F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 1n)), F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 2n)), F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 3n)), F.AcpiF.u64(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 4n))} == G.AcpiGas{s, w, off, acc, addr} : G.AcpiGas}
  %tb.gas_b(a, B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b), 1n, {==}) : {G.AcpiGas{B.byte(s), Maybe.default(&2, U32, _, 0), F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 2n)), F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 3n)), F.AcpiF.u64(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 4n))} == G.AcpiGas{s, w, off, acc, addr} : G.AcpiGas}
  %tb.gas_b(a, B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b), 2n, {==}) : {G.AcpiGas{B.byte(s), B.byte(w), Maybe.default(&2, U32, _, 0), F.AcpiF.u8(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 3n)), F.AcpiF.u64(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 4n))} == G.AcpiGas{s, w, off, acc, addr} : G.AcpiGas}
  %tb.gas_b(a, B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b), 3n, {==}) : {G.AcpiGas{B.byte(s), B.byte(w), B.byte(off), Maybe.default(&2, U32, _, 0), F.AcpiF.u64(B.Octets.append(a, B.Octets.append(B.Octets.of_list([s, w, off, acc]), B.Octets.append(B.Octets.le64(addr), b))), Nat.add(B.Octets.len(a), 4n))} == G.AcpiGas{s, w, off, acc, addr} : G.AcpiGas}
  %tb.gas_a(a, s, w, off, acc, addr, b) : {G.AcpiGas{B.byte(s), B.byte(w), B.byte(off), B.byte(acc), Maybe.default(&2, W.W64, _, W.W64.zero())} == G.AcpiGas{s, w, off, acc, addr} : G.AcpiGas}
  %s8 : {G.AcpiGas{B.byte(s), B.byte(w), B.byte(off), B.byte(acc), addr} == G.AcpiGas{_, w, off, acc, addr} : G.AcpiGas}
  %w8 : {G.AcpiGas{B.byte(s), B.byte(w), B.byte(off), B.byte(acc), addr} == G.AcpiGas{B.byte(s), _, off, acc, addr} : G.AcpiGas}
  %off8 : {G.AcpiGas{B.byte(s), B.byte(w), B.byte(off), B.byte(acc), addr} == G.AcpiGas{B.byte(s), B.byte(w), _, acc, addr} : G.AcpiGas}
  %acc8 : {G.AcpiGas{B.byte(s), B.byte(w), B.byte(off), B.byte(acc), addr} == G.AcpiGas{B.byte(s), B.byte(w), B.byte(off), _, addr} : G.AcpiGas}
  {==}

# The FACS: with every word split into its bits, parsing computes

def tb.facs_bits(+l: U32, +hs: U32, +wv: U32, +gl: U32, +fl: U32, +ah: U32, +al: U32, +v: U32, +of: U32) -> {Fa.AcpiFacs.parse(Fa.AcpiFacs.build(Fa.AcpiFacs{l, hs, wv, gl, fl, W.W64.from_parts(ah, al), v, of})) == Done{Fa.AcpiFacs{64, hs, wv, gl, fl, W.W64.from_parts(ah, al), B.byte(v), of}} : Result<&2, &2, E.AcpiError, Fa.AcpiFacs>}:
  match hs wv gl fl ah al of:
    case U32{WCon{a0, WCon{a1, WCon{a2, WCon{a3, WCon{a4, WCon{a5, WCon{a6, WCon{a7, WCon{a8, WCon{a9, WCon{a10, WCon{a11, WCon{a12, WCon{a13, WCon{a14, WCon{a15, WCon{a16, WCon{a17, WCon{a18, WCon{a19, WCon{a20, WCon{a21, WCon{a22, WCon{a23, WCon{a24, WCon{a25, WCon{a26, WCon{a27, WCon{a28, WCon{a29, WCon{a30, WCon{a31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, WCon{b8, WCon{b9, WCon{b10, WCon{b11, WCon{b12, WCon{b13, WCon{b14, WCon{b15, WCon{b16, WCon{b17, WCon{b18, WCon{b19, WCon{b20, WCon{b21, WCon{b22, WCon{b23, WCon{b24, WCon{b25, WCon{b26, WCon{b27, WCon{b28, WCon{b29, WCon{b30, WCon{b31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, WCon{c8, WCon{c9, WCon{c10, WCon{c11, WCon{c12, WCon{c13, WCon{c14, WCon{c15, WCon{c16, WCon{c17, WCon{c18, WCon{c19, WCon{c20, WCon{c21, WCon{c22, WCon{c23, WCon{c24, WCon{c25, WCon{c26, WCon{c27, WCon{c28, WCon{c29, WCon{c30, WCon{c31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{d0, WCon{d1, WCon{d2, WCon{d3, WCon{d4, WCon{d5, WCon{d6, WCon{d7, WCon{d8, WCon{d9, WCon{d10, WCon{d11, WCon{d12, WCon{d13, WCon{d14, WCon{d15, WCon{d16, WCon{d17, WCon{d18, WCon{d19, WCon{d20, WCon{d21, WCon{d22, WCon{d23, WCon{d24, WCon{d25, WCon{d26, WCon{d27, WCon{d28, WCon{d29, WCon{d30, WCon{d31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{e0, WCon{e1, WCon{e2, WCon{e3, WCon{e4, WCon{e5, WCon{e6, WCon{e7, WCon{e8, WCon{e9, WCon{e10, WCon{e11, WCon{e12, WCon{e13, WCon{e14, WCon{e15, WCon{e16, WCon{e17, WCon{e18, WCon{e19, WCon{e20, WCon{e21, WCon{e22, WCon{e23, WCon{e24, WCon{e25, WCon{e26, WCon{e27, WCon{e28, WCon{e29, WCon{e30, WCon{e31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{f0, WCon{f1, WCon{f2, WCon{f3, WCon{f4, WCon{f5, WCon{f6, WCon{f7, WCon{f8, WCon{f9, WCon{f10, WCon{f11, WCon{f12, WCon{f13, WCon{f14, WCon{f15, WCon{f16, WCon{f17, WCon{f18, WCon{f19, WCon{f20, WCon{f21, WCon{f22, WCon{f23, WCon{f24, WCon{f25, WCon{f26, WCon{f27, WCon{f28, WCon{f29, WCon{f30, WCon{f31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}} U32{WCon{g0, WCon{g1, WCon{g2, WCon{g3, WCon{g4, WCon{g5, WCon{g6, WCon{g7, WCon{g8, WCon{g9, WCon{g10, WCon{g11, WCon{g12, WCon{g13, WCon{g14, WCon{g15, WCon{g16, WCon{g17, WCon{g18, WCon{g19, WCon{g20, WCon{g21, WCon{g22, WCon{g23, WCon{g24, WCon{g25, WCon{g26, WCon{g27, WCon{g28, WCon{g29, WCon{g30, WCon{g31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      {==}

def Laws.facs_round_trip(l, hs, wv, gl, fl, xw, v, of, v8):
  %WL.parts_of(xw) : {Fa.AcpiFacs.parse(Fa.AcpiFacs.build(Fa.AcpiFacs{l, hs, wv, gl, fl, _, v, of})) == Done{Fa.AcpiFacs{64, hs, wv, gl, fl, _, v, of}} : Result<&2, &2, E.AcpiError, Fa.AcpiFacs>}
  %v8 : {Fa.AcpiFacs.parse(Fa.AcpiFacs.build(Fa.AcpiFacs{l, hs, wv, gl, fl, W.W64.from_parts(W.W64.hi(xw), W.W64.lo(xw)), v, of})) == Done{Fa.AcpiFacs{64, hs, wv, gl, fl, W.W64.from_parts(W.W64.hi(xw), W.W64.lo(xw)), _, of}} : Result<&2, &2, E.AcpiError, Fa.AcpiFacs>}
  tb.facs_bits(l, hs, wv, gl, fl, W.W64.hi(xw), W.W64.lo(xw), v, of)

# A table built by AcpiSdt.build: its header is 36 bytes (when its text
# fields have their sizes), the checksum byte replaces byte 9, and the bytes
# after the header are the body as given

def tb.la(+a: B.Octets, +b: B.Octets) -> {Nat.add(B.Octets.len(a), B.Octets.len(b)) == B.Octets.len(B.Octets.append(a, b)) : Nat}:
  Equal.sym(Nat, B.Octets.len(B.Octets.append(a, b)), Nat.add(B.Octets.len(a), B.Octets.len(b)), BL.octets_len_append(a, b))

def tb.elen(+s: B.Octets, +l: U32, +r: U32, +c: U32, +o: B.Octets, +t: B.Octets, +orv: U32, +ci: B.Octets, +cr: U32, +sig4: {B.Octets.len(s) == 4n : Nat}, +oem6: {B.Octets.len(o) == 6n : Nat}, +tid8: {B.Octets.len(t) == 8n : Nat}, +cid4: {B.Octets.len(ci) == 4n : Nat}) -> {B.Octets.len(H.AcpiHeader.encode(H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr})) == 36n : Nat}:
  %tb.la(s, B.Octets.append(B.Octets.le32(l), B.Octets.append(H.hd.byte(r), B.Octets.append(H.hd.byte(c), B.Octets.append(o, B.Octets.append(t, B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr))))))))) : {_ == 36n : Nat}
  %Equal.sym(Nat, B.Octets.len(s), 4n, sig4) : {Nat.add(_, B.Octets.len(B.Octets.append(B.Octets.le32(l), B.Octets.append(H.hd.byte(r), B.Octets.append(H.hd.byte(c), B.Octets.append(o, B.Octets.append(t, B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr)))))))))) == 36n : Nat}
  %tb.la(B.Octets.le32(l), B.Octets.append(H.hd.byte(r), B.Octets.append(H.hd.byte(c), B.Octets.append(o, B.Octets.append(t, B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr)))))))) : {Nat.add(4n, _) == 36n : Nat}
  %Equal.sym(Nat, B.Octets.len(B.Octets.le32(l)), 4n, BL.octets_len_le32(l)) : {Nat.add(4n, Nat.add(_, B.Octets.len(B.Octets.append(H.hd.byte(r), B.Octets.append(H.hd.byte(c), B.Octets.append(o, B.Octets.append(t, B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr)))))))))) == 36n : Nat}
  %tb.la(H.hd.byte(r), B.Octets.append(H.hd.byte(c), B.Octets.append(o, B.Octets.append(t, B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr))))))) : {Nat.add(8n, _) == 36n : Nat}
  %tb.la(H.hd.byte(c), B.Octets.append(o, B.Octets.append(t, B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr)))))) : {Nat.add(9n, _) == 36n : Nat}
  %tb.la(o, B.Octets.append(t, B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr))))) : {Nat.add(10n, _) == 36n : Nat}
  %Equal.sym(Nat, B.Octets.len(o), 6n, oem6) : {Nat.add(10n, Nat.add(_, B.Octets.len(B.Octets.append(t, B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr))))))) == 36n : Nat}
  %tb.la(t, B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr)))) : {Nat.add(16n, _) == 36n : Nat}
  %Equal.sym(Nat, B.Octets.len(t), 8n, tid8) : {Nat.add(16n, Nat.add(_, B.Octets.len(B.Octets.append(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr)))))) == 36n : Nat}
  %tb.la(B.Octets.le32(orv), B.Octets.append(ci, B.Octets.le32(cr))) : {Nat.add(24n, _) == 36n : Nat}
  %Equal.sym(Nat, B.Octets.len(B.Octets.le32(orv)), 4n, BL.octets_len_le32(orv)) : {Nat.add(24n, Nat.add(_, B.Octets.len(B.Octets.append(ci, B.Octets.le32(cr))))) == 36n : Nat}
  %tb.la(ci, B.Octets.le32(cr)) : {Nat.add(28n, _) == 36n : Nat}
  %Equal.sym(Nat, B.Octets.len(ci), 4n, cid4) : {Nat.add(28n, Nat.add(_, B.Octets.len(B.Octets.le32(cr)))) == 36n : Nat}
  %Equal.sym(Nat, B.Octets.len(B.Octets.le32(cr)), 4n, BL.octets_len_le32(cr)) : {Nat.add(32n, _) == 36n : Nat}
  {==}

def tb.lenchk(+s: B.Octets, +l: U32, +r: U32, +c: U32, +o: B.Octets, +t: B.Octets, +orv: U32, +ci: B.Octets, +cr: U32, +sig4: {B.Octets.len(s) == 4n : Nat}, +oem6: {B.Octets.len(o) == 6n : Nat}, +tid8: {B.Octets.len(t) == 8n : Nat}, +cid4: {B.Octets.len(ci) == 4n : Nat}, +body: B.Octets) -> {Nat.add(36n, B.Octets.len(body)) == B.Octets.len(B.Octets.append(H.AcpiHeader.encode(H.AcpiHeader{s, l, r, c, o, t, orv, ci, cr}), body)) : Nat}:
