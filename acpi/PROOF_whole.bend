# fix at i, with i bytes before it, keeps those bytes and the bytes after it

def ckw.ltadd(+i: Nat, +r: Nat) -> {Nat.is_lt(i, Nat.add(i, 1n+r)) == True{} : Bool}:
  match i:
    case 0n:
      {==}
    case 1n+p:
      ckw.ltadd(p, r)

