# The proof of LAWS_whole.bend.
#
# AcpiSdt.build(h, body) is fix(9, encode(h0) ++ body), h0 being h with
# its Length computed and its Checksum 0. The header's first 9 bytes and
# the bytes from 10 on are untouched by fix, so the table is encode(hk) ++
# body, hk being h with the Length and the Checksum k that fix writes
# (ckw.bl1, through bytes' take, drop and append laws, ckw.gfix). Its
# bytes sum to zero (LAWS_checksum.bend: fix_ok); its Length field reads
# 36 + len(body) back (ckw.p1, ckw.fnv: the U32 of a Nat no more than a
# U32's value has that value), which is the table's length (tb.lenchk), so
# AcpiSdt.check accepts the whole table (ckw.chk); its header decodes as hk
# with any bytes after it (ckw.dec, as PROOF.bend's hdr_rt does without
# them), and the bytes after the header are the body (tb.elen). Each
# table's parse then checks the signature build wrote and reads the body
# by the laws of LAWS_tables.bend.
import Base
import ../word64/word64.bend as W
import ../word64/LAWS.bend as WL
import ../word64/PROOF.bend as WP
import ../bytes/bytes.bend as B
import ../bytes/LAWS.bend as BL
import ../bytes/PROOF.bend as BP
import ../u32/LAWS.bend as UL
import ../u32/PROOF.bend as UP
import ../u32/LAWS_order.bend as UO
import ../u32/PROOF_order.bend as UOP
import ./error.bend as E
import ./header.bend as H
import ./checksum.bend as C
import ./gas.bend as G
import ./hpet.bend as Hp
import ./bgrt.bend as Bg
import ./rsdt.bend as R
import ./mcfg.bend as Mc
import ./dsdt.bend as Ds
import ./LAWS_tables.bend as TL
import ./PROOF_tables.bend as TP
import ./LAWS_checksum.bend as CL
import ./PROOF_checksum.bend as CP
import ./LAWS_whole.bend as Laws

# The U32 of a Nat no more than a U32's value has that value

def ckw.fnh(+p: Nat, +z: U32, +h: {Nat.is_le(1n+p, U32.to_nat(z)) == True{} : Bool}, +ih: {U32.to_nat(U32.from_nat(p)) == p : Nat}) -> {Nat.is_le(1n+U32.to_nat(U32.from_nat(p)), U32.to_nat(z)) == True{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(U32.from_nat(p)), p, ih) : {Nat.is_le(1n+_, U32.to_nat(z)) == True{} : Bool}
  h

def ckw.fnv(+n: Nat, +z: U32, +h: {Nat.is_le(n, U32.to_nat(z)) == True{} : Bool}) -> {U32.to_nat(U32.from_nat(n)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      %Equal.sym(Nat, U32.to_nat(U32.inc(U32.from_nat(p))), 1n+U32.to_nat(U32.from_nat(p)), UL.u32_inc_value(U32.from_nat(p), z, ckw.fnh(p, z, h, ckw.fnv(p, z, UO.nat_le_trans(p, 1n+p, U32.to_nat(z), UL.nat_le_add(p, 1n), h))))) : {_ == 1n+p : Nat}
      %Equal.sym(Nat, U32.to_nat(U32.from_nat(p)), p, ckw.fnv(p, z, UO.nat_le_trans(p, 1n+p, U32.to_nat(z), UL.nat_le_add(p, 1n), h))) : {1n+_ == 1n+p : Nat}
      {==}

# Small facts about lengths

def ckw.l4(+v: U32) -> {Nat.is_le(Nat.add(0n, 4n), B.Octets.len(B.Octets.le32(v))) == True{} : Bool}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.le32(v)), 4n, BL.octets_len_le32(v)) : {Nat.is_le(Nat.add(0n, 4n), _) == True{} : Bool}
  {==}

def ckw.lt01(+k: U32) -> {Nat.is_lt(0n, B.Octets.len(H.hd.byte(k))) == True{} : Bool}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.of_list([k])), B.len([k]), BL.octets_len_of_list([k])) : {Nat.is_lt(0n, _) == True{} : Bool}
  {==}

