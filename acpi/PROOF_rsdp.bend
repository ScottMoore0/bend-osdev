# The proof of LAWS_rsdp.bend.
#
# The first 20 bytes build writes are fix(8, signature ++ [0] ++ OEMID ++
# [revision] ++ RsdtAddress), which is the same bytes with the checksum
# byte k1 at offset 8 (ckr.fa, by PROOF_whole.bend's ckw.gfix, the OEMID
# being 6 bytes already: ckr.fit); every field parse reads is then found by
# bytes' laws for fields inside joined bytes (ckr.at15, ckr.u16, ckr.sl9),
# and the bytes sum to zero (LAWS_checksum.bend: fix_ok). Revision 2 adds
# Length 36, XsdtAddress and three reserved bytes after those 20, fixed at
# offset 32 (ckr.f2); its reads go through the first 32 bytes to the first
# 20 (ckr.t8 ... ckr.q24).
import Base
import ../word64/word64.bend as W
import ../bytes/bytes.bend as B
import ../bytes/LAWS.bend as BL
import ../bytes/PROOF.bend as BP
import ../word64/LAWS.bend as WL
import ../word64/PROOF.bend as WP
import ../u32/LAWS.bend as UL
import ../u32/PROOF.bend as UP
import ./error.bend as E
import ./checksum.bend as C
import ./fields.bend as F
import ./rsdp.bend as P
import ./LAWS_checksum.bend as CL
import ./PROOF_checksum.bend as CP
import ./PROOF_whole.bend as WH
import ./LAWS_rsdp.bend as Laws

# The OEMID, fitted to 6 bytes, is the OEMID

def ckr.subn(+n: Nat) -> {Nat.sub(n, n) == 0n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+q:
      ckr.subn(q)

def ckr.z0() -> {B.Octets.zeros(0n) == B.Octets.empty() : B.Octets}:
  {==}

def ckr.fit(+oem: B.Octets, +oem6: {B.Octets.len(oem) == 6n : Nat}) -> {F.AcpiF.fit(6n, oem) == oem : B.Octets}:
  %oem6 : {B.Octets.append(B.Octets.take(_, oem), B.Octets.zeros(Nat.sub(_, B.Octets.len(B.Octets.take(_, oem))))) == oem : B.Octets}
  %Equal.sym(B.Octets, B.Octets.take(B.Octets.len(oem), oem), oem, BL.octets_take_len(oem)) : {B.Octets.append(_, B.Octets.zeros(Nat.sub(B.Octets.len(oem), B.Octets.len(_)))) == oem : B.Octets}
  %Equal.sym(Nat, Nat.sub(B.Octets.len(oem), B.Octets.len(oem)), 0n, ckr.subn(B.Octets.len(oem))) : {B.Octets.append(oem, B.Octets.zeros(_)) == oem : B.Octets}
  %Equal.sym(B.Octets, B.Octets.zeros(0n), B.Octets.empty(), ckr.z0()) : {B.Octets.append(oem, _) == oem : B.Octets}
  BL.octets_append_empty_r(oem)

# The first 20 bytes, with the checksum byte k1 at offset 8

def ckr.vr(+oem: B.Octets, +oem6: {B.Octets.len(oem) == 6n : Nat}, +rev: U32, +rsdt: U32) -> {B.Octets.concat([P.AcpiRsdp.signature(), B.Octets.of_list([0]), F.AcpiF.fit(6n, oem), B.Octets.of_list([rev]), B.Octets.le32(rsdt)]) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}:
  %Equal.sym(B.Octets, B.Octets.concat(Con{P.AcpiRsdp.signature(), [B.Octets.of_list([0]), F.AcpiF.fit(6n, oem), B.Octets.of_list([rev]), B.Octets.le32(rsdt)]}), B.Octets.append(P.AcpiRsdp.signature(), B.Octets.concat([B.Octets.of_list([0]), F.AcpiF.fit(6n, oem), B.Octets.of_list([rev]), B.Octets.le32(rsdt)])), BL.octets_concat_cons(P.AcpiRsdp.signature(), [B.Octets.of_list([0]), F.AcpiF.fit(6n, oem), B.Octets.of_list([rev]), B.Octets.le32(rsdt)])) : {_ == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.concat(Con{B.Octets.of_list([0]), [F.AcpiF.fit(6n, oem), B.Octets.of_list([rev]), B.Octets.le32(rsdt)]}), B.Octets.append(B.Octets.of_list([0]), B.Octets.concat([F.AcpiF.fit(6n, oem), B.Octets.of_list([rev]), B.Octets.le32(rsdt)])), BL.octets_concat_cons(B.Octets.of_list([0]), [F.AcpiF.fit(6n, oem), B.Octets.of_list([rev]), B.Octets.le32(rsdt)])) : {B.Octets.append(P.AcpiRsdp.signature(), _) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.concat(Con{F.AcpiF.fit(6n, oem), [B.Octets.of_list([rev]), B.Octets.le32(rsdt)]}), B.Octets.append(F.AcpiF.fit(6n, oem), B.Octets.concat([B.Octets.of_list([rev]), B.Octets.le32(rsdt)])), BL.octets_concat_cons(F.AcpiF.fit(6n, oem), [B.Octets.of_list([rev]), B.Octets.le32(rsdt)])) : {B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), _)) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.concat(Con{B.Octets.of_list([rev]), [B.Octets.le32(rsdt)]}), B.Octets.append(B.Octets.of_list([rev]), B.Octets.concat([B.Octets.le32(rsdt)])), BL.octets_concat_cons(B.Octets.of_list([rev]), [B.Octets.le32(rsdt)])) : {B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(F.AcpiF.fit(6n, oem), _))) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.concat(Con{B.Octets.le32(rsdt), Nil{}}), B.Octets.append(B.Octets.le32(rsdt), B.Octets.concat(Nil{})), BL.octets_concat_cons(B.Octets.le32(rsdt), Nil{})) : {B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(F.AcpiF.fit(6n, oem), B.Octets.append(B.Octets.of_list([rev]), _)))) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.concat(Nil{}), B.Octets.empty(), BL.octets_concat_nil()) : {B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(F.AcpiF.fit(6n, oem), B.Octets.append(B.Octets.of_list([rev]), B.Octets.append(B.Octets.le32(rsdt), _))))) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.append(B.Octets.le32(rsdt), B.Octets.empty()), B.Octets.le32(rsdt), BL.octets_append_empty_r(B.Octets.le32(rsdt))) : {B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(F.AcpiF.fit(6n, oem), B.Octets.append(B.Octets.of_list([rev]), _)))) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}
  %Equal.sym(B.Octets, F.AcpiF.fit(6n, oem), oem, ckr.fit(oem, oem6)) : {B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(_, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}
  {==}

def ckr.fa(+oem: B.Octets, +oem6: {B.Octets.len(oem) == 6n : Nat}, +rev: U32, +rsdt: U32) -> {P.rs.v1(oem, rev, rsdt) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([C.AcpiChecksum.byte_for(8n, B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))))]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}:
  %Equal.sym(B.Octets, B.Octets.concat([P.AcpiRsdp.signature(), B.Octets.of_list([0]), F.AcpiF.fit(6n, oem), B.Octets.of_list([rev]), B.Octets.le32(rsdt)]), B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))), ckr.vr(oem, oem6, rev, rsdt)) : {C.AcpiChecksum.fix(8n, _) == B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([C.AcpiChecksum.byte_for(8n, B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([0]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))))]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : B.Octets}
  WH.ckw.gfix(8n, P.AcpiRsdp.signature(), 0, B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), {==})

# Its length and its fields

def ckr.l20(+k: U32, +oem: B.Octets, +oem6: {B.Octets.len(oem) == 6n : Nat}, +rev: U32, +rsdt: U32) -> {B.Octets.len(B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))))) == 20n : Nat}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))))), Nat.add(B.Octets.len(P.AcpiRsdp.signature()), B.Octets.len(B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))))), BL.octets_len_append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))))) : {_ == 20n : Nat}
  %Equal.sym(Nat, B.Octets.len(B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))), Nat.add(B.Octets.len(B.Octets.of_list([k])), B.Octets.len(B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))), BL.octets_len_append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))) : {Nat.add(B.Octets.len(P.AcpiRsdp.signature()), _) == 20n : Nat}
  %Equal.sym(Nat, B.Octets.len(B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), Nat.add(B.Octets.len(oem), B.Octets.len(B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), BL.octets_len_append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))) : {Nat.add(B.Octets.len(P.AcpiRsdp.signature()), Nat.add(B.Octets.len(B.Octets.of_list([k])), _)) == 20n : Nat}
  %Equal.sym(Nat, B.Octets.len(B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), Nat.add(B.Octets.len(B.Octets.of_list([rev])), B.Octets.len(B.Octets.le32(rsdt))), BL.octets_len_append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))) : {Nat.add(B.Octets.len(P.AcpiRsdp.signature()), Nat.add(B.Octets.len(B.Octets.of_list([k])), Nat.add(B.Octets.len(oem), _))) == 20n : Nat}
  %Equal.sym(Nat, B.Octets.len(oem), 6n, oem6) : {Nat.add(B.Octets.len(P.AcpiRsdp.signature()), Nat.add(B.Octets.len(B.Octets.of_list([k])), Nat.add(_, Nat.add(B.Octets.len(B.Octets.of_list([rev])), B.Octets.len(B.Octets.le32(rsdt)))))) == 20n : Nat}
  %Equal.sym(Nat, B.Octets.len(B.Octets.of_list([k])), B.len([k]), BL.octets_len_of_list([k])) : {Nat.add(B.Octets.len(P.AcpiRsdp.signature()), Nat.add(_, Nat.add(6n, Nat.add(B.Octets.len(B.Octets.of_list([rev])), B.Octets.len(B.Octets.le32(rsdt)))))) == 20n : Nat}
  %Equal.sym(Nat, B.Octets.len(B.Octets.of_list([rev])), B.len([rev]), BL.octets_len_of_list([rev])) : {Nat.add(B.Octets.len(P.AcpiRsdp.signature()), Nat.add(B.len([k]), Nat.add(6n, Nat.add(_, B.Octets.len(B.Octets.le32(rsdt)))))) == 20n : Nat}
  %Equal.sym(Nat, B.Octets.len(B.Octets.le32(rsdt)), 4n, BL.octets_len_le32(rsdt)) : {Nat.add(B.Octets.len(P.AcpiRsdp.signature()), Nat.add(B.len([k]), Nat.add(6n, Nat.add(B.len([rev]), _)))) == 20n : Nat}
  {==}

def ckr.at15(+k: U32, +oem: B.Octets, +oem6: {B.Octets.len(oem) == 6n : Nat}, +rev: U32, +rsdt: U32, +rev8: {B.byte(rev) == rev : U32}) -> {B.Octets.at(B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))), 15n) == Some{rev} : Maybe<&2, U32>}:
  %Equal.sym(Maybe<&2, U32>, B.Octets.at(B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))), Nat.add(B.Octets.len(P.AcpiRsdp.signature()), 7n)), B.Octets.at(B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), 7n), BL.octets_at_append_add(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), 7n)) : {_ == Some{rev} : Maybe<&2, U32>}
  %Equal.cong(Nat, Nat, z => Nat.add(z, 6n), B.Octets.len(B.Octets.of_list([k])), B.len([k]), BL.octets_len_of_list([k])) : {B.Octets.at(B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), _) == Some{rev} : Maybe<&2, U32>}
  %Equal.sym(Maybe<&2, U32>, B.Octets.at(B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), Nat.add(B.Octets.len(B.Octets.of_list([k])), 6n)), B.Octets.at(B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), 6n), BL.octets_at_append_add(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), 6n)) : {_ == Some{rev} : Maybe<&2, U32>}
  %Equal.cong(Nat, Nat, z => Nat.add(z, 0n), B.Octets.len(oem), 6n, oem6) : {B.Octets.at(B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), _) == Some{rev} : Maybe<&2, U32>}
  %Equal.sym(Maybe<&2, U32>, B.Octets.at(B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), Nat.add(B.Octets.len(oem), 0n)), B.Octets.at(B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)), 0n), BL.octets_at_append_add(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)), 0n)) : {_ == Some{rev} : Maybe<&2, U32>}
  %Equal.sym(Maybe<&2, U32>, B.Octets.at(B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)), 0n), B.Octets.at(B.Octets.of_list([rev]), 0n), BL.octets_at_append_lt(B.Octets.of_list([rev]), B.Octets.le32(rsdt), 0n, WH.ckw.lt01(rev))) : {_ == Some{rev} : Maybe<&2, U32>}
  %Equal.sym(Maybe<&2, U32>, B.Octets.at(B.Octets.of_list([rev]), 0n), B.at(B.Octets.to_list(B.Octets.of_list([rev])), 0n), BL.octets_at_list(B.Octets.of_list([rev]), 0n)) : {_ == Some{rev} : Maybe<&2, U32>}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list([rev])), B.mask([rev]), BL.octets_to_of([rev])) : {B.at(_, 0n) == Some{rev} : Maybe<&2, U32>}
  %Equal.sym(U32, B.byte(rev), rev, rev8) : {Some{B.byte(_)} == Some{rev} : Maybe<&2, U32>}
  %Equal.sym(U32, B.byte(rev), rev, rev8) : {Some{_} == Some{rev} : Maybe<&2, U32>}
  {==}

def ckr.u16(+k: U32, +oem: B.Octets, +oem6: {B.Octets.len(oem) == 6n : Nat}, +rev: U32, +rsdt: U32) -> {B.Octets.le32_at(B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))), 16n) == Some{rsdt} : Maybe<&2, U32>}:
  %Equal.sym(Maybe<&2, U32>, B.Octets.le32_at(B.Octets.append(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))))), Nat.add(B.Octets.len(P.AcpiRsdp.signature()), 8n)), B.Octets.le32_at(B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), 8n), BL.octets_le32_at_append_add(P.AcpiRsdp.signature(), B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), 8n)) : {_ == Some{rsdt} : Maybe<&2, U32>}
  %Equal.cong(Nat, Nat, z => Nat.add(z, 7n), B.Octets.len(B.Octets.of_list([k])), B.len([k]), BL.octets_len_of_list([k])) : {B.Octets.le32_at(B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), _) == Some{rsdt} : Maybe<&2, U32>}
  %Equal.sym(Maybe<&2, U32>, B.Octets.le32_at(B.Octets.append(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)))), Nat.add(B.Octets.len(B.Octets.of_list([k])), 7n)), B.Octets.le32_at(B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), 7n), BL.octets_le32_at_append_add(B.Octets.of_list([k]), B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), 7n)) : {_ == Some{rsdt} : Maybe<&2, U32>}
  %Equal.cong(Nat, Nat, z => Nat.add(z, 1n), B.Octets.len(oem), 6n, oem6) : {B.Octets.le32_at(B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), _) == Some{rsdt} : Maybe<&2, U32>}
  %Equal.sym(Maybe<&2, U32>, B.Octets.le32_at(B.Octets.append(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt))), Nat.add(B.Octets.len(oem), 1n)), B.Octets.le32_at(B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)), 1n), BL.octets_le32_at_append_add(oem, B.Octets.append(B.Octets.of_list([rev]), B.Octets.le32(rsdt)), 1n)) : {_ == Some{rsdt} : Maybe<&2, U32>}
