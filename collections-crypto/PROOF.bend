# The AEAD round trip

# open's answer on bend-collections' ciphertext and tag c, when its encrypt
# gave c (hm), its decrypt gives the plaintext back from c (hr), and c is a
# byte string (hb); v is bend-collections' check of the key and nonce
# lengths, which hm shows is passed
def cc_aead_valid(+alg: A.Alg, +key: List<&2, U32>, +n: B.Octets, +a: B.Octets, +p: B.Octets, +c: List<&2, U32>, hm: {A.encrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), B.Octets.to_list(p)) == Some{c} : Maybe<&2, List<&2, U32>>}, hr: {A.decrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), c) == Some{B.Octets.to_list(p)} : Maybe<&2, List<&2, U32>>}, hb: {B.mask(c) == c : List<&2, U32>}, +v: Bool, +hv: {A.valid(alg, key, B.Octets.to_list(n)) == v : Bool}) -> {Ad.CcAead.open(Ad.CcAeadKey{alg, key}, n, a, B.Octets.of_list(c)) == Done{p} : Result<&2, &2, Cr.CrError, B.Octets>}:
  match v:
    case False{}:
      +none = Equal.cong(Bool, Maybe<&2, List<&2, U32>>, x => A.when_open(x, A.seal(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), B.Octets.to_list(p))), A.valid(alg, key, B.Octets.to_list(n)), False{}, hv)
      Empty.absurd({Ad.CcAead.open(Ad.CcAeadKey{alg, key}, n, a, B.Octets.of_list(c)) == Done{p} : Result<&2, &2, Cr.CrError, B.Octets>}, cc_ns_absurd(List<&2, U32>, c, Equal.trans(Maybe<&2, List<&2, U32>>, None{}, A.encrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), B.Octets.to_list(p)), Some{c}, Equal.sym(Maybe<&2, List<&2, U32>>, A.encrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), B.Octets.to_list(p)), None{}, none), hm)))
    case True{}:
      +nb = cc_and_r(Nat.is_eq(List.length(&2, U32, key), A.key_size(alg)), Nat.is_eq(List.length(&2, U32, B.Octets.to_list(n)), A.nonce_size(alg)), hv)
      %Equal.sym(Bool, Nat.is_eq(List.length(&2, U32, B.Octets.to_list(n)), A.nonce_size(alg)), True{}, nb) : {Ad.cc.aead.open(_, alg, key, n, a, B.Octets.of_list(c)) == Done{p} : Result<&2, &2, Cr.CrError, B.Octets>}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(c)), B.mask(c), BL.octets_to_of(c)) : {C.CcRes.of_maybe(Cr.CrTagMismatch{}, A.decrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), _)) == Done{p} : Result<&2, &2, Cr.CrError, B.Octets>}
      %Equal.sym(List<&2, U32>, B.mask(c), c, hb) : {C.CcRes.of_maybe(Cr.CrTagMismatch{}, A.decrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), _)) == Done{p} : Result<&2, &2, Cr.CrError, B.Octets>}
      %Equal.sym(Maybe<&2, List<&2, U32>>, A.decrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), c), Some{B.Octets.to_list(p)}, hr) : {C.CcRes.of_maybe(Cr.CrTagMismatch{}, _) == Done{p} : Result<&2, &2, Cr.CrError, B.Octets>}
      %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(p)), p, BL.octets_of_to(p)) : {Done{_} == Done{p} : Result<&2, &2, Cr.CrError, B.Octets>}
      {==}

# the round trip over bend-collections' answer m to encrypt
def cc_aead_m(+alg: A.Alg, +key: List<&2, U32>, +n: B.Octets, +a: B.Octets, +p: B.Octets, +m: Maybe<&2, List<&2, U32>>, hm: {A.encrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), B.Octets.to_list(p)) == m : Maybe<&2, List<&2, U32>>}, hr: {Maybe.bind(&2, List<&2, U32>, List<&2, U32>, m, c => A.decrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), c)) == Maybe.map(&2, List<&2, U32>, List<&2, U32>, c => B.Octets.to_list(p), m) : Maybe<&2, List<&2, U32>>}, h: {Ad.cc.aead.mask(m) == m : Maybe<&2, List<&2, U32>>}) -> {Result.bind(&2, &2, Cr.CrError, B.Octets, B.Octets, C.CcRes.of_maybe(Cr.CrBadNonceLength{B.Octets.len(n)}, m), c => Ad.CcAead.open(Ad.CcAeadKey{alg, key}, n, a, c)) == Result.map(&2, &2, Cr.CrError, B.Octets, B.Octets, c => p, C.CcRes.of_maybe(Cr.CrBadNonceLength{B.Octets.len(n)}, m)) : Result<&2, &2, Cr.CrError, B.Octets>}:
  match m:
    case None{}:
      {==}
    case Some{+c}:
      cc_aead_valid(alg, key, n, a, p, c, hm, hr, cc_some_inj(List<&2, U32>, B.mask(c), c, h), A.valid(alg, key, B.Octets.to_list(n)), {==})

def Laws.aead_round_trip_if(k, n, a, p, hr, h):
  match k:
    case Ad.CcAeadKey{+alg, +key}:
      cc_aead_m(alg, key, n, a, p, A.encrypt(alg, key, B.Octets.to_list(n), B.Octets.to_list(a), B.Octets.to_list(p)), {==}, hr, h)

# Stream ciphers from keystream generators: crypto proves its three CrXor
# laws for every keystream generator (crypto/PROOF.bend); its PROOF.bend
# took over 2 GB of the checker's memory then, so the lemmas are written out
# here, as crypto states them, and hold for every generator too. They
# unfold CrXor.update, so they name crypto's stream.bend's loop (cr.ks.*),
# as pubkey's proofs name crypto's cr.sign.check and cr.kex.with.

def cc_bool_xx(a: Bool, b: Bool) -> {a == Bool.xor(Bool.xor(a, b), b) : Bool}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def cc_word_xx(n: Nat, a: Word(n), b: Word(n)) -> {a == Word.xor(n, Word.xor(n, a, b), b) : Word(n)}:
  match n:
    case 0n:
      match a b:
        case WNil{} WNil{}:
          {==}
    case 1n+p:
      match a b:
        case WCon{ah, at} WCon{bh, bt}:
          %cc_bool_xx(ah, bh) : {WCon{ah, at} == WCon{_, Word.xor(p, Word.xor(p, at, bt), bt)} : Word(1n+p)}
          %cc_word_xx(p, at, bt) : {WCon{ah, at} == WCon{ah, _} : Word(1n+p)}
          {==}

def cc_u32_xx(a: U32, b: U32) -> {a == U32.xor(U32.xor(a, b), b) : U32}:
  match a b:
    case U32{x} U32{y}:
      %cc_word_xx(32n, x, y) : {U32{x} == U32{_} : U32}
      {==}

def cc_byte_xx(+h: U32, +k: U32) -> {B.byte(h) == B.byte(U32.xor(B.byte(U32.xor(h, k)), k)) : U32}:
  %cc_byte_xor_byte(U32.xor(h, k), k) : {B.byte(h) == _ : U32}
  %cc_u32_xx(h, k) : {B.byte(h) == B.byte(_) : U32}
  {==}

def cc_rev2(l: List<&2, U32>, +a: List<&2, U32>) -> {St.cr.rev_onto(St.cr.rev_onto(l, a), Nil{}) == St.cr.rev_onto(a, l) : List<&2, U32>}:
  match l:
    case Nil{}:
      {==}
    case Con{h, t}:
      cc_rev2(t, Con{h, a})

def cc_mask_append(p: List<&2, U32>, +q: List<&2, U32>) -> {B.mask(B.append(p, q)) == B.append(B.mask(p), B.mask(q)) : List<&2, U32>}:
  match p:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      %cc_mask_append(t, q) : {Con{B.byte(h), B.mask(B.append(t, q))} == Con{B.byte(h), _} : List<&2, U32>}
      {==}

def cc_octets_of_append(+p: List<&2, U32>, +q: List<&2, U32>) -> {B.Octets.of_list(B.append(p, q)) == B.Octets.append(B.Octets.of_list(p), B.Octets.of_list(q)) : B.Octets}:
  %BL.octets_of_to(B.Octets.append(B.Octets.of_list(p), B.Octets.of_list(q))) : {B.Octets.of_list(B.append(p, q)) == _ : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(B.Octets.of_list(p), B.Octets.of_list(q))), B.append(B.Octets.to_list(B.Octets.of_list(p)), B.Octets.to_list(B.Octets.of_list(q))), BL.octets_append_list(B.Octets.of_list(p), B.Octets.of_list(q))) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(_) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(p)), B.mask(p), BL.octets_to_of(p)) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(B.append(_, B.Octets.to_list(B.Octets.of_list(q)))) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(q)), B.mask(q), BL.octets_to_of(q)) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(B.append(B.mask(p), _)) : B.Octets}
  %cc_mask_append(p, q) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(_) : B.Octets}
  %BL.octets_to_of(B.append(p, q)) : {B.Octets.of_list(B.append(p, q)) == B.Octets.of_list(_) : B.Octets}
  %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(B.Octets.of_list(B.append(p, q)))), B.Octets.of_list(B.append(p, q)), BL.octets_of_list_idempotent(B.append(p, q))) : {B.Octets.of_list(B.append(p, q)) == _ : B.Octets}
  {==}

def cc_ks_go_ref(~S: Data, ~next: S -> St.CrKsStep<S>, ys: List<&2, U32>, +s: S, +acc: List<&2, U32>) -> {St.cr.ks.go(~S, ~next, ys, s, acc) == St.CrKsRun{St.cr.ks.after(~S, ~next, ys, s), St.cr.rev_onto(St.cr.ks.xs(~S, ~next, ys, s), acc)} : St.CrKsRun<S>}:
  match ys:
    case Nil{}:
      {==}
    case Con{x, t}:
      cc_ks_go_ref(~S, ~next, t, St.CrKsStep.st(~S, next(s)), Con{B.byte(U32.xor(x, St.CrKsStep.k(~S, next(s)))), acc})

def cc_xor_update_ref(~S: Data, ~next: S -> St.CrKsStep<S>, +s: S, +m: B.Octets) -> {St.CrXorOut{St.cr.ks.after(~S, ~next, B.Octets.to_list(m), s), B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s))} == St.CrXor.update(~S, ~next, s, m) : St.CrXorOut<S>}:
  %Equal.sym(St.CrKsRun<S>, St.cr.ks.go(~S, ~next, B.Octets.to_list(m), s, Nil{}), St.CrKsRun{St.cr.ks.after(~S, ~next, B.Octets.to_list(m), s), St.cr.rev_onto(St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s), Nil{})}, cc_ks_go_ref(~S, ~next, B.Octets.to_list(m), s, Nil{})) : {St.CrXorOut{St.cr.ks.after(~S, ~next, B.Octets.to_list(m), s), B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s))} == St.cr.ks.out(~S, _) : St.CrXorOut<S>}
  %cc_rev2(St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s), Nil{}) : {St.CrXorOut{St.cr.ks.after(~S, ~next, B.Octets.to_list(m), s), B.Octets.of_list(_)} == St.CrXorOut{St.cr.ks.after(~S, ~next, B.Octets.to_list(m), s), B.Octets.of_list(St.cr.rev_onto(St.cr.rev_onto(St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s), Nil{}), Nil{}))} : St.CrXorOut<S>}
  {==}

def cc_ks_mask_xs(~S: Data, ~next: S -> St.CrKsStep<S>, ys: List<&2, U32>, +s: S) -> {St.cr.ks.xs(~S, ~next, ys, s) == St.cr.ks.xs(~S, ~next, B.mask(ys), s) : List<&2, U32>}:
  match ys:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      %cc_byte_xor_byte(h, St.CrKsStep.k(~S, next(s))) : {Con{B.byte(U32.xor(h, St.CrKsStep.k(~S, next(s)))), St.cr.ks.xs(~S, ~next, t, St.CrKsStep.st(~S, next(s)))} == Con{_, St.cr.ks.xs(~S, ~next, B.mask(t), St.CrKsStep.st(~S, next(s)))} : List<&2, U32>}
      %cc_ks_mask_xs(~S, ~next, t, St.CrKsStep.st(~S, next(s))) : {Con{B.byte(U32.xor(h, St.CrKsStep.k(~S, next(s)))), St.cr.ks.xs(~S, ~next, t, St.CrKsStep.st(~S, next(s)))} == Con{B.byte(U32.xor(h, St.CrKsStep.k(~S, next(s)))), _} : List<&2, U32>}
      {==}

def cc_ks_xs_xs(~S: Data, ~next: S -> St.CrKsStep<S>, ys: List<&2, U32>, +s: S) -> {B.mask(ys) == St.cr.ks.xs(~S, ~next, St.cr.ks.xs(~S, ~next, ys, s), s) : List<&2, U32>}:
  match ys:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      %cc_byte_xx(h, St.CrKsStep.k(~S, next(s))) : {Con{B.byte(h), B.mask(t)} == Con{_, St.cr.ks.xs(~S, ~next, St.cr.ks.xs(~S, ~next, t, St.CrKsStep.st(~S, next(s))), St.CrKsStep.st(~S, next(s)))} : List<&2, U32>}
      %cc_ks_xs_xs(~S, ~next, t, St.CrKsStep.st(~S, next(s))) : {Con{B.byte(h), B.mask(t)} == Con{B.byte(h), _} : List<&2, U32>}
      {==}

def cc_ks_after_append(~S: Data, ~next: S -> St.CrKsStep<S>, xs: List<&2, U32>, +ys: List<&2, U32>, +s: S) -> {St.cr.ks.after(~S, ~next, B.append(xs, ys), s) == St.cr.ks.after(~S, ~next, ys, St.cr.ks.after(~S, ~next, xs, s)) : S}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      cc_ks_after_append(~S, ~next, t, ys, St.CrKsStep.st(~S, next(s)))

def cc_ks_xs_append(~S: Data, ~next: S -> St.CrKsStep<S>, xs: List<&2, U32>, +ys: List<&2, U32>, +s: S) -> {St.cr.ks.xs(~S, ~next, B.append(xs, ys), s) == B.append(St.cr.ks.xs(~S, ~next, xs, s), St.cr.ks.xs(~S, ~next, ys, St.cr.ks.after(~S, ~next, xs, s))) : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      %cc_ks_xs_append(~S, ~next, t, ys, St.CrKsStep.st(~S, next(s))) : {Con{B.byte(U32.xor(x, St.CrKsStep.k(~S, next(s)))), St.cr.ks.xs(~S, ~next, B.append(t, ys), St.CrKsStep.st(~S, next(s)))} == Con{B.byte(U32.xor(x, St.CrKsStep.k(~S, next(s)))), _} : List<&2, U32>}
      {==}

# crypto's xor_involution, xor_streaming_state and xor_streaming_data, for
# every keystream generator
def cc_xor_involution(~S: Data, ~next: S -> St.CrKsStep<S>, +s: S, +m: B.Octets) -> {St.CrXor.out_data(~S, St.CrXor.update(~S, ~next, s, St.CrXor.out_data(~S, St.CrXor.update(~S, ~next, s, m)))) == m : B.Octets}:
  %cc_xor_update_ref(~S, ~next, s, m) : {St.CrXor.out_data(~S, St.CrXor.update(~S, ~next, s, St.CrXor.out_data(~S, _))) == m : B.Octets}
  %cc_xor_update_ref(~S, ~next, s, B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s))) : {St.CrXor.out_data(~S, _) == m : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s))), B.mask(St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s)), BL.octets_to_of(St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s))) : {B.Octets.of_list(St.cr.ks.xs(~S, ~next, _, s)) == m : B.Octets}
  %cc_ks_mask_xs(~S, ~next, St.cr.ks.xs(~S, ~next, B.Octets.to_list(m), s), s) : {B.Octets.of_list(_) == m : B.Octets}
  %cc_ks_xs_xs(~S, ~next, B.Octets.to_list(m), s) : {B.Octets.of_list(_) == m : B.Octets}
  %BL.octets_to_of(B.Octets.to_list(m)) : {B.Octets.of_list(_) == m : B.Octets}
  %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(B.Octets.of_list(B.Octets.to_list(m)))), B.Octets.of_list(B.Octets.to_list(m)), BL.octets_of_list_idempotent(B.Octets.to_list(m))) : {_ == m : B.Octets}
  BL.octets_of_to(m)

def cc_xor_streaming_state(~S: Data, ~next: S -> St.CrKsStep<S>, +s: S, +a: B.Octets, +b: B.Octets) -> {St.CrXor.out_state(~S, St.CrXor.update(~S, ~next, s, B.Octets.append(a, b))) == St.CrXor.out_state(~S, St.CrXor.update(~S, ~next, St.CrXor.out_state(~S, St.CrXor.update(~S, ~next, s, a)), b)) : S}:
  %cc_xor_update_ref(~S, ~next, s, a) : {St.CrXor.out_state(~S, St.CrXor.update(~S, ~next, s, B.Octets.append(a, b))) == St.CrXor.out_state(~S, St.CrXor.update(~S, ~next, St.CrXor.out_state(~S, _), b)) : S}
  %cc_xor_update_ref(~S, ~next, St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s), b) : {St.CrXor.out_state(~S, St.CrXor.update(~S, ~next, s, B.Octets.append(a, b))) == St.CrXor.out_state(~S, _) : S}
  %cc_xor_update_ref(~S, ~next, s, B.Octets.append(a, b)) : {St.CrXor.out_state(~S, _) == St.cr.ks.after(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)) : S}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(a, b)), B.append(B.Octets.to_list(a), B.Octets.to_list(b)), BL.octets_append_list(a, b)) : {St.cr.ks.after(~S, ~next, _, s) == St.cr.ks.after(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)) : S}
  cc_ks_after_append(~S, ~next, B.Octets.to_list(a), B.Octets.to_list(b), s)

def cc_xor_streaming_data(~S: Data, ~next: S -> St.CrKsStep<S>, +s: S, +a: B.Octets, +b: B.Octets) -> {St.CrXor.out_data(~S, St.CrXor.update(~S, ~next, s, B.Octets.append(a, b))) == B.Octets.append(St.CrXor.out_data(~S, St.CrXor.update(~S, ~next, s, a)), St.CrXor.out_data(~S, St.CrXor.update(~S, ~next, St.CrXor.out_state(~S, St.CrXor.update(~S, ~next, s, a)), b))) : B.Octets}:
  %cc_xor_update_ref(~S, ~next, s, a) : {St.CrXor.out_data(~S, St.CrXor.update(~S, ~next, s, B.Octets.append(a, b))) == B.Octets.append(St.CrXor.out_data(~S, _), St.CrXor.out_data(~S, St.CrXor.update(~S, ~next, St.CrXor.out_state(~S, _), b))) : B.Octets}
  %cc_xor_update_ref(~S, ~next, St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s), b) : {St.CrXor.out_data(~S, St.CrXor.update(~S, ~next, s, B.Octets.append(a, b))) == B.Octets.append(B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s)), St.CrXor.out_data(~S, _)) : B.Octets}
  %cc_xor_update_ref(~S, ~next, s, B.Octets.append(a, b)) : {St.CrXor.out_data(~S, _) == B.Octets.append(B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s)), B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)))) : B.Octets}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(a, b)), B.append(B.Octets.to_list(a), B.Octets.to_list(b)), BL.octets_append_list(a, b)) : {B.Octets.of_list(St.cr.ks.xs(~S, ~next, _, s)) == B.Octets.append(B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s)), B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)))) : B.Octets}
  %Equal.sym(List<&2, U32>, St.cr.ks.xs(~S, ~next, B.append(B.Octets.to_list(a), B.Octets.to_list(b)), s), B.append(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s), St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s))), cc_ks_xs_append(~S, ~next, B.Octets.to_list(a), B.Octets.to_list(b), s)) : {B.Octets.of_list(_) == B.Octets.append(B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s)), B.Octets.of_list(St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)))) : B.Octets}
  cc_octets_of_append(St.cr.ks.xs(~S, ~next, B.Octets.to_list(a), s), St.cr.ks.xs(~S, ~next, B.Octets.to_list(b), St.cr.ks.after(~S, ~next, B.Octets.to_list(a), s)))

# The specifications, from bend-collections-laws-crypto's laws

def cc_nat_refl(n: Nat) -> {Nat.is_eq(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      cc_nat_refl(p)

# a length check on bytes of that length passes
def cc_len_true(+o: B.Octets, +n: Nat, +h: {B.Octets.len(o) == n : Nat}) -> {Nat.is_eq(B.Octets.len(o), n) == True{} : Bool}:
  %Equal.sym(Nat, B.Octets.len(o), n, h) : {Nat.is_eq(_, n) == True{} : Bool}
  cc_nat_refl(n)

def cc_mask_len(xs: List<&2, U32>) -> {B.len(B.mask(xs)) == B.len(xs) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      Equal.cong(Nat, Nat, x => 1n+x, B.len(B.mask(t)), B.len(t), cc_mask_len(t))

def cc_octets_len_of(+xs: List<&2, U32>) -> {B.Octets.len(B.Octets.of_list(xs)) == B.len(xs) : Nat}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.of_list(xs)), B.len(B.Octets.to_list(B.Octets.of_list(xs))), BL.octets_len_list(B.Octets.of_list(xs))) : {_ == B.len(xs) : Nat}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(xs)), B.mask(xs), BL.octets_to_of(xs)) : {B.len(_) == B.len(xs) : Nat}
  cc_mask_len(xs)

# every element of a masked list is below 256 (bytes' byte_below_256)
def cc_valid_mask(xs: List<&2, U32>) -> {X.valid_bytes(B.len(xs), B.mask(xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, t}:
      %Equal.sym(Bool, U32.is_lt(B.byte(h), 256), True{}, BL.byte_below_256(h)) : {Bool.and(_, X.valid_bytes(B.len(t), B.mask(t))) == True{} : Bool}
      cc_valid_mask(t)

# an Octets' bytes are their own mask
def cc_mask_self(+o: B.Octets) -> {B.mask(B.Octets.to_list(o)) == B.Octets.to_list(o) : List<&2, U32>}:
  Equal.trans(List<&2, U32>, B.mask(B.Octets.to_list(o)), B.Octets.to_list(B.Octets.of_list(B.Octets.to_list(o))), B.Octets.to_list(o), Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(B.Octets.to_list(o))), B.mask(B.Octets.to_list(o)), BL.octets_to_of(B.Octets.to_list(o))), Equal.cong(B.Octets, List<&2, U32>, x => B.Octets.to_list(x), B.Octets.of_list(B.Octets.to_list(o)), o, BL.octets_of_to(o)))

# n bytes of an Octets are n values below 256, as bend-collections' curve
# laws take them (FS.bytes_ok; FS.tight for n = 32)
def cc_bytes_ok(+o: B.Octets, +n: Nat, +h: {B.Octets.len(o) == n : Nat}) -> {FS.bytes_ok(n, B.Octets.to_list(o)) == True{} : Bool}:
  %h : {FS.bytes_ok(_, B.Octets.to_list(o)) == True{} : Bool}
  %Equal.sym(Nat, B.Octets.len(o), B.len(B.Octets.to_list(o)), BL.octets_len_list(o)) : {FS.bytes_ok(_, B.Octets.to_list(o)) == True{} : Bool}
  %cc_mask_self(o) : {FS.bytes_ok(B.len(B.Octets.to_list(o)), _) == True{} : Bool}
  %CP.valid_eq(B.len(B.Octets.to_list(o)), B.mask(B.Octets.to_list(o))) : {_ == True{} : Bool}
  cc_valid_mask(B.Octets.to_list(o))

def Laws.keccak256_spec(o):
  %KL.ethereum_keccak256(Bl.CcBlake.pack(o), B.Octets.len(o)) : {Kc.CcKeccak.keccak256(o) == Bl.CcBlake.out(8n, _) : B.Octets}
  {==}

def Laws.x25519_public_spec(one, h1, o, h):
  %Equal.sym(Bool, Nat.is_eq(B.Octets.len(o), 32n), True{}, cc_len_true(o, 32n, h)) : {Result.map(&2, &2, Cr.CrError, Xx.CcX25519Sk, B.Octets, k => Xx.CcX25519.pk_to(Xx.CcX25519.public(k)), Xx.cc.x25519.secret(_, o)) == Done{B.Octets.of_list(SX.x25519(one, B.Octets.to_list(o), SKX.base()))} : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Maybe<&2, List<&2, U32>>, X.x25519(B.Octets.to_list(o), X.base()), Bool.pick(Maybe<&2, List<&2, U32>>, Bool.and(FS.tight(B.Octets.to_list(o)), FS.tight(X.base())), Some{SX.x25519(one, B.Octets.to_list(o), X.base())}, None{}), CP.x25519_checked(one, h1, B.Octets.to_list(o), X.base())) : {Done{C.CcRes.or_empty(_)} == Done{B.Octets.of_list(SX.x25519(one, B.Octets.to_list(o), SKX.base()))} : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Bool, FS.bytes_ok(32n, B.Octets.to_list(o)), True{}, cc_bytes_ok(o, 32n, h)) : {Done{C.CcRes.or_empty(Bool.pick(Maybe<&2, List<&2, U32>>, Bool.and(_, FS.tight(X.base())), Some{SX.x25519(one, B.Octets.to_list(o), X.base())}, None{}))} == Done{B.Octets.of_list(SX.x25519(one, B.Octets.to_list(o), SKX.base()))} : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Bool, FS.tight(X.base()), True{}, CP.base_tight()) : {Done{C.CcRes.or_empty(Bool.pick(Maybe<&2, List<&2, U32>>, Bool.and(True{}, _), Some{SX.x25519(one, B.Octets.to_list(o), X.base())}, None{}))} == Done{B.Octets.of_list(SX.x25519(one, B.Octets.to_list(o), SKX.base()))} : Result<&2, &2, Cr.CrError, B.Octets>}
  {==}

def Laws.x25519_shared_spec(one, h1, a, u, ha, hu):
  +S = SKX.unless_zero(SX.x25519(one, B.Octets.to_list(a), B.Octets.to_list(u)), Nat.is_eq(FS.value(SX.x25519(one, B.Octets.to_list(a), B.Octets.to_list(u))), 0n))
  %Equal.sym(Bool, Nat.is_eq(B.Octets.len(a), 32n), True{}, cc_len_true(a, 32n, ha)) : {Kx.cr.kex.with(~Xx.CcX25519Sk, ~Xx.CcX25519Pk, ~Xx.CcX25519.shared, Xx.cc.x25519.secret(_, a), Xx.CcX25519.pk_of(u)) == C.CcRes.of_maybe(Cr.CrBadKey{}, S) : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Bool, Nat.is_eq(B.Octets.len(u), 32n), True{}, cc_len_true(u, 32n, hu)) : {Kx.cr.kex.with(~Xx.CcX25519Sk, ~Xx.CcX25519Pk, ~Xx.CcX25519.shared, Done{Xx.CcX25519Sk{B.Octets.to_list(a)}}, Xx.cc.x25519.pk(_, u)) == C.CcRes.of_maybe(Cr.CrBadKey{}, S) : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Maybe<&2, List<&2, U32>>, K.shared_secret(B.Octets.to_list(a), B.Octets.to_list(u)), S, CP.kex_shared(one, h1, B.Octets.to_list(a), B.Octets.to_list(u), cc_bytes_ok(a, 32n, ha), cc_bytes_ok(u, 32n, hu))) : {C.CcRes.of_maybe(Cr.CrBadKey{}, _) == C.CcRes.of_maybe(Cr.CrBadKey{}, S) : Result<&2, &2, Cr.CrError, B.Octets>}
  {==}

def Laws.ed25519_public_spec(one, h1, o, h):
  %Equal.sym(Bool, Nat.is_eq(B.Octets.len(o), 32n), True{}, cc_len_true(o, 32n, h)) : {Result.map(&2, &2, Cr.CrError, Ed.CcEdSk, B.Octets, k => Ed.CcEd25519.pk_to(Ed.CcEd25519.public(k)), Ed.cc.ed.secret(_, o)) == Done{B.Octets.of_list(SE.public_key(one, B.Octets.to_list(o)))} : Result<&2, &2, Cr.CrError, B.Octets>}
  %Equal.sym(Maybe<&2, SG.Keypair>, SG.generate_keypair(B.Octets.to_list(o)), Some{SG.Keypair{B.Octets.to_list(o), SE.public_key(one, B.Octets.to_list(o))}}, EP.sign_keypair(one, h1, B.Octets.to_list(o), cc_bytes_ok(o, 32n, h))) : {Done{Ed.CcEd25519.pk_to(Ed.cc.ed.public(_))} == Done{B.Octets.of_list(SE.public_key(one, B.Octets.to_list(o)))} : Result<&2, &2, Cr.CrError, B.Octets>}
  {==}

