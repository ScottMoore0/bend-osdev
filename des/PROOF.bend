# DES: the swap is its own inverse, and a Feistel round is undone whatever f
# is (IP and IP^-1 above)

def des_swap2(h: D.LcDesHalves) -> {h == D.des.swap(D.des.swap(h)) : D.LcDesHalves}:
  match h:
    case D.LcDesHalves{l, r}:
      {==}

def des_unstep_step(+k: D.LcDesRk, h: D.LcDesHalves) -> {h == D.des.unstep(k, D.des.step(k, h)) : D.LcDesHalves}:
  match h:
    case D.LcDesHalves{l, +r}:
      %CoreL.u32_xor_cancel(l, D.des.f(k, r)) : {D.LcDesHalves{l, r} == D.LcDesHalves{_, r} : D.LcDesHalves}
      {==}

def des_step_unstep(+k: D.LcDesRk, h: D.LcDesHalves) -> {h == D.des.step(k, D.des.unstep(k, h)) : D.LcDesHalves}:
  match h:
    case D.LcDesHalves{+a, b}:
      %CoreL.u32_xor_cancel(b, D.des.f(k, a)) : {D.LcDesHalves{a, b} == D.LcDesHalves{a, _} : D.LcDesHalves}
      {==}

def des_unrounds_rounds(ks: List<&2, D.LcDesRk>, +h: D.LcDesHalves) -> {h == D.des.unrounds(ks, D.des.rounds(ks, h)) : D.LcDesHalves}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +t}:
      %des_unrounds_rounds(t, D.des.step(k, h)) : {h == D.des.unstep(k, _) : D.LcDesHalves}
      des_unstep_step(k, h)

def des_rounds_unrounds(ks: List<&2, D.LcDesRk>, +h: D.LcDesHalves) -> {h == D.des.rounds(ks, D.des.unrounds(ks, h)) : D.LcDesHalves}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +t}:
      %des_step_unstep(k, D.des.unrounds(t, h)) : {h == D.des.rounds(t, _) : D.LcDesHalves}
      des_rounds_unrounds(t, h)

def Laws.des_round_trip(k, b):
  match k:
    case D.LcDesKey{+ks}:
      %des_ip_fp(D.des.swap(D.des.rounds(ks, D.des.ip(b)))) : {D.des.fp(D.des.unrounds(ks, D.des.swap(_))) == b : L.LcBlock64}
      %des_swap2(D.des.rounds(ks, D.des.ip(b))) : {D.des.fp(D.des.unrounds(ks, _)) == b : L.LcBlock64}
      %des_unrounds_rounds(ks, D.des.ip(b)) : {D.des.fp(_) == b : L.LcBlock64}
      Equal.sym(L.LcBlock64, b, D.des.fp(D.des.ip(b)), des_fp_ip(b))

def Laws.des_round_trip_dual(k, b):
  match k:
    case D.LcDesKey{+ks}:
      %des_ip_fp(D.des.unrounds(ks, D.des.swap(D.des.ip(b)))) : {D.des.fp(D.des.swap(D.des.rounds(ks, _))) == b : L.LcBlock64}
      %des_rounds_unrounds(ks, D.des.swap(D.des.ip(b))) : {D.des.fp(D.des.swap(_)) == b : L.LcBlock64}
      %des_swap2(D.des.ip(b)) : {D.des.fp(_) == b : L.LcBlock64}
      Equal.sym(L.LcBlock64, b, D.des.fp(D.des.ip(b)), des_fp_ip(b))

# Triple DES: from DES's two laws

def des_rt(k: D.LcDesKey, +b: L.LcBlock64) -> {b == D.LcDes.decrypt(k, D.LcDes.encrypt(k, b)) : L.LcBlock64}:
  Equal.sym(L.LcBlock64, D.LcDes.decrypt(k, D.LcDes.encrypt(k, b)), b, Laws.des_round_trip(k, b))

def des_rt_dual(k: D.LcDesKey, +b: L.LcBlock64) -> {b == D.LcDes.encrypt(k, D.LcDes.decrypt(k, b)) : L.LcBlock64}:
  Equal.sym(L.LcBlock64, D.LcDes.encrypt(k, D.LcDes.decrypt(k, b)), b, Laws.des_round_trip_dual(k, b))

def Laws.tdes_round_trip(k, b):
  match k:
    case T.LcTdesKey{+k1, +k2, +k3}:
      %des_rt(k3, D.LcDes.decrypt(k2, D.LcDes.encrypt(k1, b))) : {D.LcDes.decrypt(k1, D.LcDes.encrypt(k2, _)) == b : L.LcBlock64}
      %des_rt_dual(k2, D.LcDes.encrypt(k1, b)) : {D.LcDes.decrypt(k1, _) == b : L.LcBlock64}
      Laws.des_round_trip(k1, b)

def Laws.tdes_round_trip_dual(k, b):
  match k:
    case T.LcTdesKey{+k1, +k2, +k3}:
      %des_rt_dual(k1, D.LcDes.encrypt(k2, D.LcDes.decrypt(k3, b))) : {D.LcDes.encrypt(k3, D.LcDes.decrypt(k2, _)) == b : L.LcBlock64}
      %des_rt(k2, D.LcDes.decrypt(k3, b)) : {D.LcDes.encrypt(k3, _) == b : L.LcBlock64}
      Laws.des_round_trip_dual(k3, b)

# The modes: for DES and 3DES, by their laws, through the core's mode laws

def tdes_rt(k: T.LcTdesKey, +b: L.LcBlock64) -> {b == T.LcTdes.decrypt(k, T.LcTdes.encrypt(k, b)) : L.LcBlock64}:
  Equal.sym(L.LcBlock64, T.LcTdes.decrypt(k, T.LcTdes.encrypt(k, b)), b, Laws.tdes_round_trip(k, b))

def ecb_rt_des(+k: D.LcDesKey, bs: List<&2, L.LcBlock64>) -> {bs == X.m64.ecb(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, bs)) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+b, +t}:
      %des_rt(k, b) : {Con{b, t} == Con{_, X.m64.ecb(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, t))} : List<&2, L.LcBlock64>}
      %ecb_rt_des(k, t) : {Con{b, t} == Con{b, _} : List<&2, L.LcBlock64>}
      {==}

def cbc_rt_des(+k: D.LcDesKey, bs: List<&2, L.LcBlock64>, +iv: L.LcBlock64) -> {bs == X.m64.cbc.dec(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv), iv) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+p, +t}:
      %des_rt(k, L.LcBlock64.xor(iv, p)) : {Con{p, t} == Con{L.LcBlock64.xor(iv, _), X.m64.cbc.dec(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, t, D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p))), D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p)))} : List<&2, L.LcBlock64>}
      %CoreL.block64_xor_cancel(iv, p) : {Con{p, t} == Con{_, X.m64.cbc.dec(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, t, D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p))), D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p)))} : List<&2, L.LcBlock64>}
      %cbc_rt_des(k, t, D.LcDes.encrypt(k, L.LcBlock64.xor(iv, p))) : {Con{p, t} == Con{p, _} : List<&2, L.LcBlock64>}
      {==}

# the public block layers, through the structural forms (the core's laws)
def ecb_blocks_rt_des(+k: D.LcDesKey, +bs: List<&2, L.LcBlock64>) -> {X.Lc64.ecb_decrypt_blocks(~D.LcDesKey, ~D.LcDes.decrypt, k, X.Lc64.ecb_encrypt_blocks(~D.LcDesKey, ~D.LcDes.encrypt, k, bs)) == bs : List<&2, L.LcBlock64>}:
  %CoreL.modes64_ecb_blocks(~D.LcDesKey, ~D.LcDes.encrypt, ~D.LcDes.decrypt, k, bs) : {_ == bs : List<&2, L.LcBlock64>}
  Equal.sym(List<&2, L.LcBlock64>, bs, X.m64.ecb(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.ecb(~D.LcDesKey, ~D.LcDes.encrypt, k, bs)), ecb_rt_des(k, bs))

def cbc_blocks_rt_des(+k: D.LcDesKey, +iv: L.LcBlock64, +bs: List<&2, L.LcBlock64>) -> {X.Lc64.cbc_decrypt_blocks(~D.LcDesKey, ~D.LcDes.decrypt, k, iv, X.Lc64.cbc_encrypt_blocks(~D.LcDesKey, ~D.LcDes.encrypt, k, iv, bs)) == bs : List<&2, L.LcBlock64>}:
  %CoreL.modes64_cbc_blocks(~D.LcDesKey, ~D.LcDes.encrypt, ~D.LcDes.decrypt, k, iv, bs) : {_ == bs : List<&2, L.LcBlock64>}
  Equal.sym(List<&2, L.LcBlock64>, bs, X.m64.cbc.dec(~D.LcDesKey, ~D.LcDes.decrypt, k, X.m64.cbc.enc(~D.LcDesKey, ~D.LcDes.encrypt, k, bs, iv), iv), cbc_rt_des(k, bs, iv))


def ecb_rt_tdes(+k: T.LcTdesKey, bs: List<&2, L.LcBlock64>) -> {bs == X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs)) : List<&2, L.LcBlock64>}:
  match bs:
    case Nil{}:
      {==}
    case Con{+b, +t}:
      %tdes_rt(k, b) : {Con{b, t} == Con{_, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.ecb(~T.LcTdesKey, ~T.LcTdes.encrypt, k, t))} : List<&2, L.LcBlock64>}
      %ecb_rt_tdes(k, t) : {Con{b, t} == Con{b, _} : List<&2, L.LcBlock64>}
      {==}

def cbc_rt_tdes(+k: T.LcTdesKey, bs: List<&2, L.LcBlock64>, +iv: L.LcBlock64) -> {bs == X.m64.cbc.dec(~T.LcTdesKey, ~T.LcTdes.decrypt, k, X.m64.cbc.enc(~T.LcTdesKey, ~T.LcTdes.encrypt, k, bs, iv), iv) : List<&2, L.LcBlock64>}:
