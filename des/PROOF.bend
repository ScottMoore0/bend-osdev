def Laws.des_ecb_round_trip(k, bs):
  ecb_blocks_rt_des(k, bs)

def Laws.des_cbc_round_trip(k, iv, bs):
  cbc_blocks_rt_des(k, iv, bs)

def Laws.tdes_ecb_round_trip(k, bs):
