# bend-osdev-landlock: network access rights (LANDLOCK_ACCESS_NET_BIND_TCP and
# CONNECT_TCP, ABI 4), sets of them, and net-port rules
# (LANDLOCK_RULE_NET_PORT): a rule allows some network rights on one TCP
# port, and a layer grants on a port the union of its rules for that port.
#
# The sets work as the filesystem sets do (rights.bend): one Bool per right,
# in the kernel's bit order, through LandlockBits.
import Base
import ../word64/word64.bend as W
import ./error.bend as E
import ./rights.bend as R

# BEGIN GENERATED by gen/sets.py: types
type LandlockNetRight is Data:
  LandlockBindTcp{}
  LandlockConnectTcp{}

type LandlockNet is Data:
  LandlockNet{bind_tcp: Bool, connect_tcp: Bool}
# END GENERATED: types

# BEGIN GENERATED by gen/sets.py: defs
# the right's bit number in the kernel's mask
def LandlockNetRight.index(r: LandlockNetRight) -> Nat:
  match r:
    case LandlockBindTcp{}:
      0n
    case LandlockConnectTcp{}:
      1n

# the kernel's name, less its LANDLOCK_ prefix
def LandlockNetRight.name(r: LandlockNetRight) -> String:
  match r:
    case LandlockBindTcp{}:
      "BIND_TCP"
    case LandlockConnectTcp{}:
      "CONNECT_TCP"

# every right, in bit order
def LandlockNetRight.all() -> List<&2, LandlockNetRight>:
  [LandlockBindTcp{}, LandlockConnectTcp{}]

# the set as one Bool per right, in bit order
def LandlockNet.bools(s: LandlockNet) -> List<&2, Bool>:
  match s:
    case LandlockNet{bind_tcp, connect_tcp}:
      [bind_tcp, connect_tcp]

# the set whose right i is element i of xs (False past the end)
def LandlockNet.of_bools(+xs: List<&2, Bool>) -> LandlockNet:
  LandlockNet{R.LandlockBits.nth(0n, xs), R.LandlockBits.nth(1n, xs)}

# the set of one right
def LandlockNet.single(r: LandlockNetRight) -> LandlockNet:
  match r:
    case LandlockBindTcp{}:
      LandlockNet{True{}, False{}}
    case LandlockConnectTcp{}:
      LandlockNet{False{}, True{}}
# END GENERATED: defs

# BEGIN GENERATED by gen/sets.py: ops
def LandlockNet.has(s: LandlockNet, r: LandlockNetRight) -> Bool:
  R.LandlockBits.nth(LandlockNetRight.index(r), LandlockNet.bools(s))

def LandlockNet.none() -> LandlockNet:
  LandlockNet.of_bools(Nil{})

def LandlockNet.all() -> LandlockNet:
  LandlockNet.of_bools(R.LandlockBits.trues(2n))

def LandlockNet.union(a: LandlockNet, b: LandlockNet) -> LandlockNet:
  LandlockNet.of_bools(R.LandlockBits.zor(LandlockNet.bools(a), LandlockNet.bools(b)))

def LandlockNet.inter(a: LandlockNet, b: LandlockNet) -> LandlockNet:
  LandlockNet.of_bools(R.LandlockBits.zand(LandlockNet.bools(a), LandlockNet.bools(b)))

def LandlockNet.minus(a: LandlockNet, b: LandlockNet) -> LandlockNet:
  LandlockNet.of_bools(R.LandlockBits.zminus(LandlockNet.bools(a), LandlockNet.bools(b)))

def LandlockNet.subset(a: LandlockNet, b: LandlockNet) -> Bool:
  R.LandlockBits.sub(LandlockNet.bools(a), LandlockNet.bools(b))

def LandlockNet.is_empty(s: LandlockNet) -> Bool:
  Bool.not(R.LandlockBits.any(LandlockNet.bools(s)))

def LandlockNet.is_eq(+a: LandlockNet, +b: LandlockNet) -> Bool:
  Bool.and(LandlockNet.subset(a, b), LandlockNet.subset(b, a))

def LandlockNet.add(s: LandlockNet, r: LandlockNetRight) -> LandlockNet:
  LandlockNet.union(s, LandlockNet.single(r))

def LandlockNet.of_list(rs: List<&2, LandlockNetRight>) -> LandlockNet:
  match rs:
    case Nil{}:
      LandlockNet.none()
    case Con{r, t}:
      LandlockNet.union(LandlockNet.single(r), LandlockNet.of_list(t))

def LandlockNet.to_list.put(keep: Bool, r: LandlockNetRight, rest: List<&2, LandlockNetRight>) -> List<&2, LandlockNetRight>:
  match keep:
    case True{}:
      Con{r, rest}
    case False{}:
      rest

def LandlockNet.to_list.go(xs: List<&2, LandlockNetRight>, +s: LandlockNet) -> List<&2, LandlockNetRight>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+r, t}:
      LandlockNet.to_list.put(LandlockNet.has(s, r), r, LandlockNet.to_list.go(t, s))

# the rights in the set, in bit order
def LandlockNet.to_list(s: LandlockNet) -> List<&2, LandlockNetRight>:
  LandlockNet.to_list.go(LandlockNetRight.all(), s)

def LandlockNet.names(xs: List<&2, LandlockNetRight>) -> List<&2, String>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{r, t}:
      Con{LandlockNetRight.name(r), LandlockNet.names(t)}

# the rights' names joined by "|"; "0" for the empty set
def LandlockNet.show(s: LandlockNet) -> String:
  R.LandlockBits.join(LandlockNet.names(LandlockNet.to_list(s)))

def LandlockNet.to_u32(s: LandlockNet) -> U32:
  R.LandlockBits.to_u32(LandlockNet.bools(s), 1)

# the kernel's mask, a __u64 (bit i for right i)
def LandlockNet.to_mask(s: LandlockNet) -> W.W64:
  W.W64.from_u32(LandlockNet.to_u32(s))

def LandlockNet.of_mask.go(ok: Bool, lo: U32) -> Result<&2, &2, E.LandlockError, LandlockNet>:
  match ok:
    case True{}:
      Done{LandlockNet.of_bools(R.LandlockBits.of_u32(2n, lo))}
    case False{}:
      Fail{E.LandlockUnknownAccess{}}

# a kernel mask as a set; a bit no ABI defines is LandlockUnknownAccess
def LandlockNet.of_mask(+m: W.W64) -> Result<&2, &2, E.LandlockError, LandlockNet>:
  +lo = W.W64.lo(m)
  LandlockNet.of_mask.go(Bool.and(U32.is_eq(W.W64.hi(m), 0), U32.is_eq(U32.shrn(lo, 2n), 0)), lo)

# END GENERATED: ops

# Net-port rules

type LandlockNetRule is Data:
  LandlockNetRule{port: U32, allowed: LandlockNet}

def LandlockNetRule.port(r: LandlockNetRule) -> U32:
  match r:
    case LandlockNetRule{port, allowed}:
      port

def LandlockNetRule.allowed(r: LandlockNetRule) -> LandlockNet:
  match r:
    case LandlockNetRule{port, allowed}:
      allowed

def LandlockNet.granted.pick(hit: Bool, allowed: LandlockNet) -> LandlockNet:
  match hit:
    case True{}:
      allowed
    case False{}:
      LandlockNet.none()

# the union of the rights the rules allow on this port
def LandlockNet.granted(rules: List<&2, LandlockNetRule>, +port: U32) -> LandlockNet:
  match rules:
    case Nil{}:
      LandlockNet.none()
    case Con{LandlockNetRule{p, a}, t}:
      LandlockNet.union(LandlockNet.granted.pick(U32.is_eq(p, port), a), LandlockNet.granted(t, port))

# the highest port a rule may name (landlock_add_rule: EINVAL above it)
def LandlockNet.max_port() -> U32:
  65535
