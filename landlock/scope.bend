# bend-osdev-landlock: IPC scoping (LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET and
# LANDLOCK_SCOPE_SIGNAL, ABI 6). A layer that scopes an action stops its
# processes from doing it to a process outside that layer's domain: from
# connecting to an abstract UNIX socket another process created, or from
# sending it a signal. The target is inside the layer when its own domain
# contains the layer (the same domain, or one nested in it).
#
# A layer is named by an identity (a U32) unique among the layers compared;
# a domain is inside a layer when the layer's identity is among its own.
import Base
import ../word64/word64.bend as W
import ./error.bend as E
import ./rights.bend as R

# BEGIN GENERATED by gen/sets.py: types
type LandlockScopeRight is Data:
  LandlockScopeAbstractUnix{}
  LandlockScopeSignal{}

type LandlockScope is Data:
  LandlockScope{abstract_unix_socket: Bool, signal: Bool}
# END GENERATED: types

# BEGIN GENERATED by gen/sets.py: defs
# the right's bit number in the kernel's mask
def LandlockScopeRight.index(r: LandlockScopeRight) -> Nat:
  match r:
    case LandlockScopeAbstractUnix{}:
      0n
    case LandlockScopeSignal{}:
      1n

# the kernel's name, less its LANDLOCK_ prefix
def LandlockScopeRight.name(r: LandlockScopeRight) -> String:
  match r:
    case LandlockScopeAbstractUnix{}:
      "ABSTRACT_UNIX_SOCKET"
    case LandlockScopeSignal{}:
      "SIGNAL"

# every right, in bit order
def LandlockScopeRight.all() -> List<&2, LandlockScopeRight>:
  [LandlockScopeAbstractUnix{}, LandlockScopeSignal{}]

# the set as one Bool per right, in bit order
def LandlockScope.bools(s: LandlockScope) -> List<&2, Bool>:
  match s:
    case LandlockScope{abstract_unix_socket, signal}:
      [abstract_unix_socket, signal]

# the set whose right i is element i of xs (False past the end)
def LandlockScope.of_bools(+xs: List<&2, Bool>) -> LandlockScope:
  LandlockScope{R.LandlockBits.nth(0n, xs), R.LandlockBits.nth(1n, xs)}

# the set of one right
def LandlockScope.single(r: LandlockScopeRight) -> LandlockScope:
  match r:
    case LandlockScopeAbstractUnix{}:
      LandlockScope{True{}, False{}}
    case LandlockScopeSignal{}:
      LandlockScope{False{}, True{}}
# END GENERATED: defs

# BEGIN GENERATED by gen/sets.py: ops
def LandlockScope.has(s: LandlockScope, r: LandlockScopeRight) -> Bool:
  R.LandlockBits.nth(LandlockScopeRight.index(r), LandlockScope.bools(s))

def LandlockScope.none() -> LandlockScope:
  LandlockScope.of_bools(Nil{})

def LandlockScope.all() -> LandlockScope:
  LandlockScope.of_bools(R.LandlockBits.trues(2n))

def LandlockScope.union(a: LandlockScope, b: LandlockScope) -> LandlockScope:
  LandlockScope.of_bools(R.LandlockBits.zor(LandlockScope.bools(a), LandlockScope.bools(b)))

def LandlockScope.inter(a: LandlockScope, b: LandlockScope) -> LandlockScope:
  LandlockScope.of_bools(R.LandlockBits.zand(LandlockScope.bools(a), LandlockScope.bools(b)))

def LandlockScope.minus(a: LandlockScope, b: LandlockScope) -> LandlockScope:
  LandlockScope.of_bools(R.LandlockBits.zminus(LandlockScope.bools(a), LandlockScope.bools(b)))

def LandlockScope.subset(a: LandlockScope, b: LandlockScope) -> Bool:
  R.LandlockBits.sub(LandlockScope.bools(a), LandlockScope.bools(b))

def LandlockScope.is_empty(s: LandlockScope) -> Bool:
  Bool.not(R.LandlockBits.any(LandlockScope.bools(s)))

def LandlockScope.is_eq(+a: LandlockScope, +b: LandlockScope) -> Bool:
  Bool.and(LandlockScope.subset(a, b), LandlockScope.subset(b, a))

def LandlockScope.add(s: LandlockScope, r: LandlockScopeRight) -> LandlockScope:
  LandlockScope.union(s, LandlockScope.single(r))

def LandlockScope.of_list(rs: List<&2, LandlockScopeRight>) -> LandlockScope:
  match rs:
    case Nil{}:
      LandlockScope.none()
    case Con{r, t}:
      LandlockScope.union(LandlockScope.single(r), LandlockScope.of_list(t))

def LandlockScope.to_list.put(keep: Bool, r: LandlockScopeRight, rest: List<&2, LandlockScopeRight>) -> List<&2, LandlockScopeRight>:
  match keep:
    case True{}:
      Con{r, rest}
    case False{}:
      rest

def LandlockScope.to_list.go(xs: List<&2, LandlockScopeRight>, +s: LandlockScope) -> List<&2, LandlockScopeRight>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+r, t}:
      LandlockScope.to_list.put(LandlockScope.has(s, r), r, LandlockScope.to_list.go(t, s))

# the rights in the set, in bit order
def LandlockScope.to_list(s: LandlockScope) -> List<&2, LandlockScopeRight>:
  LandlockScope.to_list.go(LandlockScopeRight.all(), s)

def LandlockScope.names(xs: List<&2, LandlockScopeRight>) -> List<&2, String>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{r, t}:
      Con{LandlockScopeRight.name(r), LandlockScope.names(t)}

# the rights' names joined by "|"; "0" for the empty set
def LandlockScope.show(s: LandlockScope) -> String:
  R.LandlockBits.join(LandlockScope.names(LandlockScope.to_list(s)))

def LandlockScope.to_u32(s: LandlockScope) -> U32:
  R.LandlockBits.to_u32(LandlockScope.bools(s), 1)

# the kernel's mask, a __u64 (bit i for right i)
def LandlockScope.to_mask(s: LandlockScope) -> W.W64:
  W.W64.from_u32(LandlockScope.to_u32(s))

def LandlockScope.of_mask.go(ok: Bool, lo: U32) -> Result<&2, &2, E.LandlockError, LandlockScope>:
  match ok:
    case True{}:
      Done{LandlockScope.of_bools(R.LandlockBits.of_u32(2n, lo))}
    case False{}:
      Fail{E.LandlockUnknownAccess{}}

# a kernel mask as a set; a bit no ABI defines is LandlockUnknownAccess
def LandlockScope.of_mask(+m: W.W64) -> Result<&2, &2, E.LandlockError, LandlockScope>:
  +lo = W.W64.lo(m)
  LandlockScope.of_mask.go(Bool.and(U32.is_eq(W.W64.hi(m), 0), U32.is_eq(U32.shrn(lo, 2n), 0)), lo)

# END GENERATED: ops

# The check

def LandlockScope.member(ids: List<&2, U32>, +id: U32) -> Bool:
  match ids:
    case Nil{}:
      False{}
    case Con{h, t}:
      Bool.or(U32.is_eq(h, id), LandlockScope.member(t, id))

# one layer (its identity and scoped set) and a target process (the
# identities of its domain's layers): the layer never refuses an action it
# does not scope, and refuses one it does when the target is outside it
def LandlockScope.layer_allows(scoped: LandlockScope, id: U32, target: List<&2, U32>, x: LandlockScopeRight) -> Bool:
  R.LandlockBits.imp(LandlockScope.has(scoped, x), LandlockScope.member(target, id))
