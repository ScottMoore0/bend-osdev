# bend-osdev-landlock: filesystem access rights (landlock(7), "Filesystem
# actions"), sets of them, and the file types the MAKE_* and REMOVE_* rights
# are about.
#
# A set of rights is a record of one Bool per right, in the kernel's bit
# order (LANDLOCK_ACCESS_FS_EXECUTE is bit 0, ..., IOCTL_DEV bit 15). Every
# set operation goes through the set's list of Bools (LandlockFs.bools and
# LandlockFs.of_bools) and the generic list operations of LandlockBits, which
# net.bend and scope.bend share; the laws are proved once for those.
import Base
import ../word64/word64.bend as W
import ./error.bend as E

# Generic operations on lists of Bools (element i is right i)

def LandlockBits.imp(a: Bool, b: Bool) -> Bool:
  match a:
    case False{}:
      True{}
    case True{}:
      b

# element i, False past the end
def LandlockBits.nth(i: Nat, xs: List<&2, Bool>) -> Bool:
  match i:
    case 0n:
      match xs:
        case Nil{}:
          False{}
        case Con{h, t}:
          h
    case 1n+p:
      match xs:
        case Nil{}:
          False{}
        case Con{h, t}:
          LandlockBits.nth(p, t)

def LandlockBits.zand(xs: List<&2, Bool>, ys: List<&2, Bool>) -> List<&2, Bool>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{x, xt}:
      match ys:
        case Nil{}:
          Nil{}
        case Con{y, yt}:
          Con{Bool.and(x, y), LandlockBits.zand(xt, yt)}

def LandlockBits.zor(xs: List<&2, Bool>, ys: List<&2, Bool>) -> List<&2, Bool>:
  match xs:
    case Nil{}:
      ys
    case Con{x, xt}:
      match ys:
        case Nil{}:
          Con{x, xt}
        case Con{y, yt}:
          Con{Bool.or(x, y), LandlockBits.zor(xt, yt)}

def LandlockBits.zminus(xs: List<&2, Bool>, ys: List<&2, Bool>) -> List<&2, Bool>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{x, xt}:
      match ys:
        case Nil{}:
          Con{x, xt}
        case Con{y, yt}:
          Con{Bool.and(x, Bool.not(y)), LandlockBits.zminus(xt, yt)}

# every element of xs that is True is True in ys
def LandlockBits.sub(xs: List<&2, Bool>, ys: List<&2, Bool>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{x, xt}:
      match ys:
        case Nil{}:
          Bool.and(Bool.not(x), LandlockBits.sub(xt, Nil{}))
        case Con{y, yt}:
          Bool.and(LandlockBits.imp(x, y), LandlockBits.sub(xt, yt))

def LandlockBits.any(xs: List<&2, Bool>) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{x, xt}:
      Bool.or(x, LandlockBits.any(xt))

def LandlockBits.trues(n: Nat) -> List<&2, Bool>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      Con{True{}, LandlockBits.trues(p)}

def LandlockBits.pick(b: Bool, w: U32) -> U32:
  match b:
    case True{}:
      w
    case False{}:
      0

# the mask with bit i set for each True element i, from weight w
def LandlockBits.to_u32(xs: List<&2, Bool>, +w: U32) -> U32:
  match xs:
    case Nil{}:
      0
    case Con{x, xt}:
      U32.or(LandlockBits.pick(x, w), LandlockBits.to_u32(xt, U32.shl(w)))

# the low n bits of a mask, as Bools
def LandlockBits.of_u32(n: Nat, +x: U32) -> List<&2, Bool>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      Con{U32.is_eq(U32.and(x, 1), 1), LandlockBits.of_u32(p, U32.shr(x))}

def LandlockBits.join.go(rest: List<&2, String>, first: String) -> String:
  match rest:
    case Nil{}:
      first
    case Con{h, t}:
      first ++ "|" ++ LandlockBits.join.go(t, h)

# the strings joined by "|"; "0" for none
def LandlockBits.join(xs: List<&2, String>) -> String:
  match xs:
    case Nil{}:
      "0"
    case Con{h, t}:
      LandlockBits.join.go(t, h)

# The rights and the set record

# BEGIN GENERATED by gen/sets.py: types
type LandlockFsRight is Data:
  LandlockExecute{}
  LandlockWriteFile{}
  LandlockReadFile{}
  LandlockReadDir{}
  LandlockRemoveDir{}
  LandlockRemoveFile{}
  LandlockMakeChar{}
  LandlockMakeDir{}
  LandlockMakeReg{}
  LandlockMakeSock{}
  LandlockMakeFifo{}
  LandlockMakeBlock{}
  LandlockMakeSym{}
  LandlockRefer{}
  LandlockTruncate{}
  LandlockIoctlDev{}

type LandlockFs is Data:
  LandlockFs{execute: Bool, write_file: Bool, read_file: Bool, read_dir: Bool, remove_dir: Bool, remove_file: Bool, make_char: Bool, make_dir: Bool, make_reg: Bool, make_sock: Bool, make_fifo: Bool, make_block: Bool, make_sym: Bool, refer: Bool, truncate: Bool, ioctl_dev: Bool}
# END GENERATED: types

# BEGIN GENERATED by gen/sets.py: defs
# the right's bit number in the kernel's mask
def LandlockFsRight.index(r: LandlockFsRight) -> Nat:
  match r:
    case LandlockExecute{}:
      0n
    case LandlockWriteFile{}:
      1n
    case LandlockReadFile{}:
      2n
    case LandlockReadDir{}:
      3n
    case LandlockRemoveDir{}:
      4n
    case LandlockRemoveFile{}:
      5n
    case LandlockMakeChar{}:
      6n
    case LandlockMakeDir{}:
      7n
    case LandlockMakeReg{}:
      8n
    case LandlockMakeSock{}:
      9n
    case LandlockMakeFifo{}:
      10n
    case LandlockMakeBlock{}:
      11n
    case LandlockMakeSym{}:
      12n
    case LandlockRefer{}:
      13n
    case LandlockTruncate{}:
      14n
    case LandlockIoctlDev{}:
      15n

# the kernel's name, less its LANDLOCK_ prefix
def LandlockFsRight.name(r: LandlockFsRight) -> String:
  match r:
    case LandlockExecute{}:
      "EXECUTE"
    case LandlockWriteFile{}:
      "WRITE_FILE"
    case LandlockReadFile{}:
      "READ_FILE"
    case LandlockReadDir{}:
      "READ_DIR"
    case LandlockRemoveDir{}:
      "REMOVE_DIR"
    case LandlockRemoveFile{}:
      "REMOVE_FILE"
    case LandlockMakeChar{}:
      "MAKE_CHAR"
    case LandlockMakeDir{}:
      "MAKE_DIR"
    case LandlockMakeReg{}:
      "MAKE_REG"
    case LandlockMakeSock{}:
      "MAKE_SOCK"
    case LandlockMakeFifo{}:
      "MAKE_FIFO"
    case LandlockMakeBlock{}:
      "MAKE_BLOCK"
    case LandlockMakeSym{}:
      "MAKE_SYM"
    case LandlockRefer{}:
      "REFER"
    case LandlockTruncate{}:
      "TRUNCATE"
    case LandlockIoctlDev{}:
      "IOCTL_DEV"

# every right, in bit order
def LandlockFsRight.all() -> List<&2, LandlockFsRight>:
  [LandlockExecute{}, LandlockWriteFile{}, LandlockReadFile{}, LandlockReadDir{}, LandlockRemoveDir{}, LandlockRemoveFile{}, LandlockMakeChar{}, LandlockMakeDir{}, LandlockMakeReg{}, LandlockMakeSock{}, LandlockMakeFifo{}, LandlockMakeBlock{}, LandlockMakeSym{}, LandlockRefer{}, LandlockTruncate{}, LandlockIoctlDev{}]

# the set as one Bool per right, in bit order
def LandlockFs.bools(s: LandlockFs) -> List<&2, Bool>:
  match s:
    case LandlockFs{execute, write_file, read_file, read_dir, remove_dir, remove_file, make_char, make_dir, make_reg, make_sock, make_fifo, make_block, make_sym, refer, truncate, ioctl_dev}:
      [execute, write_file, read_file, read_dir, remove_dir, remove_file, make_char, make_dir, make_reg, make_sock, make_fifo, make_block, make_sym, refer, truncate, ioctl_dev]

# the set whose right i is element i of xs (False past the end)
def LandlockFs.of_bools(+xs: List<&2, Bool>) -> LandlockFs:
  LandlockFs{LandlockBits.nth(0n, xs), LandlockBits.nth(1n, xs), LandlockBits.nth(2n, xs), LandlockBits.nth(3n, xs), LandlockBits.nth(4n, xs), LandlockBits.nth(5n, xs), LandlockBits.nth(6n, xs), LandlockBits.nth(7n, xs), LandlockBits.nth(8n, xs), LandlockBits.nth(9n, xs), LandlockBits.nth(10n, xs), LandlockBits.nth(11n, xs), LandlockBits.nth(12n, xs), LandlockBits.nth(13n, xs), LandlockBits.nth(14n, xs), LandlockBits.nth(15n, xs)}

# the set of one right
def LandlockFs.single(r: LandlockFsRight) -> LandlockFs:
  match r:
    case LandlockExecute{}:
      LandlockFs{True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockWriteFile{}:
      LandlockFs{False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockReadFile{}:
      LandlockFs{False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockReadDir{}:
      LandlockFs{False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockRemoveDir{}:
      LandlockFs{False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockRemoveFile{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockMakeChar{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockMakeDir{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockMakeReg{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockMakeSock{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockMakeFifo{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}, False{}}
    case LandlockMakeBlock{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}, False{}}
    case LandlockMakeSym{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}, False{}}
    case LandlockRefer{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}, False{}}
    case LandlockTruncate{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}, False{}}
    case LandlockIoctlDev{}:
      LandlockFs{False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}}
# END GENERATED: defs

# Set operations

# BEGIN GENERATED by gen/sets.py: ops
def LandlockFs.has(s: LandlockFs, r: LandlockFsRight) -> Bool:
  LandlockBits.nth(LandlockFsRight.index(r), LandlockFs.bools(s))

def LandlockFs.none() -> LandlockFs:
  LandlockFs.of_bools(Nil{})

def LandlockFs.all() -> LandlockFs:
  LandlockFs.of_bools(LandlockBits.trues(16n))

def LandlockFs.union(a: LandlockFs, b: LandlockFs) -> LandlockFs:
  LandlockFs.of_bools(LandlockBits.zor(LandlockFs.bools(a), LandlockFs.bools(b)))

def LandlockFs.inter(a: LandlockFs, b: LandlockFs) -> LandlockFs:
  LandlockFs.of_bools(LandlockBits.zand(LandlockFs.bools(a), LandlockFs.bools(b)))

def LandlockFs.minus(a: LandlockFs, b: LandlockFs) -> LandlockFs:
  LandlockFs.of_bools(LandlockBits.zminus(LandlockFs.bools(a), LandlockFs.bools(b)))

def LandlockFs.subset(a: LandlockFs, b: LandlockFs) -> Bool:
  LandlockBits.sub(LandlockFs.bools(a), LandlockFs.bools(b))

def LandlockFs.is_empty(s: LandlockFs) -> Bool:
  Bool.not(LandlockBits.any(LandlockFs.bools(s)))

def LandlockFs.is_eq(+a: LandlockFs, +b: LandlockFs) -> Bool:
  Bool.and(LandlockFs.subset(a, b), LandlockFs.subset(b, a))

def LandlockFs.add(s: LandlockFs, r: LandlockFsRight) -> LandlockFs:
  LandlockFs.union(s, LandlockFs.single(r))

def LandlockFs.of_list(rs: List<&2, LandlockFsRight>) -> LandlockFs:
  match rs:
    case Nil{}:
      LandlockFs.none()
    case Con{r, t}:
      LandlockFs.union(LandlockFs.single(r), LandlockFs.of_list(t))

def LandlockFs.to_list.put(keep: Bool, r: LandlockFsRight, rest: List<&2, LandlockFsRight>) -> List<&2, LandlockFsRight>:
  match keep:
    case True{}:
      Con{r, rest}
    case False{}:
      rest

def LandlockFs.to_list.go(xs: List<&2, LandlockFsRight>, +s: LandlockFs) -> List<&2, LandlockFsRight>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{+r, t}:
      LandlockFs.to_list.put(LandlockFs.has(s, r), r, LandlockFs.to_list.go(t, s))

# the rights in the set, in bit order
def LandlockFs.to_list(s: LandlockFs) -> List<&2, LandlockFsRight>:
  LandlockFs.to_list.go(LandlockFsRight.all(), s)

def LandlockFs.names(xs: List<&2, LandlockFsRight>) -> List<&2, String>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{r, t}:
      Con{LandlockFsRight.name(r), LandlockFs.names(t)}

# the rights' names joined by "|"; "0" for the empty set
def LandlockFs.show(s: LandlockFs) -> String:
  LandlockBits.join(LandlockFs.names(LandlockFs.to_list(s)))

def LandlockFs.to_u32(s: LandlockFs) -> U32:
  LandlockBits.to_u32(LandlockFs.bools(s), 1)

# the kernel's mask, a __u64 (bit i for right i)
def LandlockFs.to_mask(s: LandlockFs) -> W.W64:
  W.W64.from_u32(LandlockFs.to_u32(s))

def LandlockFs.of_mask.go(ok: Bool, lo: U32) -> Result<&2, &2, E.LandlockError, LandlockFs>:
  match ok:
    case True{}:
      Done{LandlockFs.of_bools(LandlockBits.of_u32(16n, lo))}
    case False{}:
      Fail{E.LandlockUnknownAccess{}}

# a kernel mask as a set; a bit no ABI defines is LandlockUnknownAccess
def LandlockFs.of_mask(+m: W.W64) -> Result<&2, &2, E.LandlockError, LandlockFs>:
  +lo = W.W64.lo(m)
  LandlockFs.of_mask.go(Bool.and(U32.is_eq(W.W64.hi(m), 0), U32.is_eq(U32.shrn(lo, 16n), 0)), lo)

# END GENERATED: ops

# The rights a file (not a directory) can receive (landlock(7)): what a
# path-beneath rule on a file may allow, and what a reparented file carries

def LandlockFs.file_rights() -> LandlockFs:
  LandlockFs.of_list([LandlockExecute{}, LandlockWriteFile{}, LandlockReadFile{}, LandlockTruncate{}, LandlockIoctlDev{}])

# File types: what MAKE_* and REMOVE_* are about

type LandlockFileKind is Data:
  LandlockReg{}
  LandlockDir{}
  LandlockChr{}
  LandlockBlk{}
  LandlockFifo{}
  LandlockSock{}
  LandlockSym{}

def LandlockFileKind.is_dir(k: LandlockFileKind) -> Bool:
  match k:
    case LandlockDir{}:
      True{}
    case _:
      False{}

# the right to create (or rename or link) a file of this type in a directory
def LandlockFileKind.make_right(k: LandlockFileKind) -> LandlockFsRight:
  match k:
    case LandlockReg{}:
      LandlockMakeReg{}
    case LandlockDir{}:
      LandlockMakeDir{}
    case LandlockChr{}:
      LandlockMakeChar{}
    case LandlockBlk{}:
      LandlockMakeBlock{}
    case LandlockFifo{}:
      LandlockMakeFifo{}
    case LandlockSock{}:
      LandlockMakeSock{}
    case LandlockSym{}:
      LandlockMakeSym{}

# the right to remove (or rename away) a file of this type from a directory
def LandlockFileKind.remove_right(k: LandlockFileKind) -> LandlockFsRight:
  match k:
    case LandlockDir{}:
      LandlockRemoveDir{}
    case _:
      LandlockRemoveFile{}

# the rights compared when a file of this type is reparented: every right for
# a directory (its content moves with it), the file rights otherwise
def LandlockFileKind.carried(k: LandlockFileKind) -> LandlockFs:
  match k:
    case LandlockDir{}:
      LandlockFs.all()
    case _:
      LandlockFs.file_rights()

def LandlockFileKind.name(k: LandlockFileKind) -> String:
  match k:
    case LandlockReg{}:
      "reg"
    case LandlockDir{}:
      "dir"
    case LandlockChr{}:
      "chr"
    case LandlockBlk{}:
      "blk"
    case LandlockFifo{}:
      "fifo"
    case LandlockSock{}:
      "sock"
    case LandlockSym{}:
      "sym"
