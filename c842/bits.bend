# bend-osdev-c842, bits: bit-level access to bytes and words (generated by
# gen/bits.py; do not edit by hand).
#
# A U32's word holds its bits least significant first. c842.bit.k reads bit
# k with a deep pattern, so the bits of an unknown value are terms the
# checker can carry, and a value rebuilt from its own bits is the same value
# (PROOF.bend proves byte and word round trips this way).
import Base

def c842.bit.b0(x: U32) -> Bool:
  match x:
    case U32{WCon{c0, r}}:
      c0

def c842.bit.b1(x: U32) -> Bool:
  match x:
    case U32{WCon{c0, WCon{c1, r}}}:
      c1

def c842.bit.b2(x: U32) -> Bool:
  match x:
    case U32{WCon{c0, WCon{c1, WCon{c2, r}}}}:
      c2

def c842.bit.b3(x: U32) -> Bool:
