# a byte's 8 bits, most significant first (the low 8 bits of x)
def c842.bits.byte(+x: U32) -> List<&2, Bool>:
  [c842.bit.b7(x), c842.bit.b6(x), c842.bit.b5(x), c842.bit.b4(x), c842.bit.b3(x), c842.bit.b2(x), c842.bit.b1(x), c842.bit.b0(x)]

# a word's 32 bits, most significant first
def c842.bits.word(+x: U32) -> List<&2, Bool>:
  [c842.bit.b31(x), c842.bit.b30(x), c842.bit.b29(x), c842.bit.b28(x), c842.bit.b27(x), c842.bit.b26(x), c842.bit.b25(x), c842.bit.b24(x), c842.bit.b23(x), c842.bit.b22(x), c842.bit.b21(x), c842.bit.b20(x), c842.bit.b19(x), c842.bit.b18(x), c842.bit.b17(x), c842.bit.b16(x), c842.bit.b15(x), c842.bit.b14(x), c842.bit.b13(x), c842.bit.b12(x), c842.bit.b11(x), c842.bit.b10(x), c842.bit.b9(x), c842.bit.b8(x), c842.bit.b7(x), c842.bit.b6(x), c842.bit.b5(x), c842.bit.b4(x), c842.bit.b3(x), c842.bit.b2(x), c842.bit.b1(x), c842.bit.b0(x)]

# the byte with these bits, least significant first
def c842.byte.of(b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool) -> U32:
  U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, Word.zero(24n)}}}}}}}}}

# the word with these bits, least significant first (32 of them, in a list
# read in reverse: the last bit read is the least significant)
def c842.word.of(bs: List<&2, Bool>) -> U32:
  match bs:
    case Con{c0, Con{c1, Con{c2, Con{c3, Con{c4, Con{c5, Con{c6, Con{c7, Con{c8, Con{c9, Con{c10, Con{c11, Con{c12, Con{c13, Con{c14, Con{c15, Con{c16, Con{c17, Con{c18, Con{c19, Con{c20, Con{c21, Con{c22, Con{c23, Con{c24, Con{c25, Con{c26, Con{c27, Con{c28, Con{c29, Con{c30, Con{c31, rest}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, WCon{c8, WCon{c9, WCon{c10, WCon{c11, WCon{c12, WCon{c13, WCon{c14, WCon{c15, WCon{c16, WCon{c17, WCon{c18, WCon{c19, WCon{c20, WCon{c21, WCon{c22, WCon{c23, WCon{c24, WCon{c25, WCon{c26, WCon{c27, WCon{c28, WCon{c29, WCon{c30, WCon{c31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}
    case _:
      0

# a byte from 8 bits read in reverse (least significant first); 0 if fewer
def c842.byte.of_rev(bs: List<&2, Bool>) -> U32:
  match bs:
    case Con{c0, Con{c1, Con{c2, Con{c3, Con{c4, Con{c5, Con{c6, Con{c7, rest}}}}}}}}:
      c842.byte.of(c0, c1, c2, c3, c4, c5, c6, c7)
    case _:
      0

# x's low byte, rebuilt from its bits: what the decoder reads back from the
# 8 bits the serialiser writes for x (PROOF.bend: it is B.byte(x))
def c842.rebyte(+x: U32) -> U32:
  c842.byte.of(c842.bit.b0(x), c842.bit.b1(x), c842.bit.b2(x), c842.bit.b3(x), c842.bit.b4(x), c842.bit.b5(x), c842.bit.b6(x), c842.bit.b7(x))

# x rebuilt from its 32 bits (PROOF.bend: it is x)
def c842.reword(+x: U32) -> U32:
  U32{WCon{c842.bit.b0(x), WCon{c842.bit.b1(x), WCon{c842.bit.b2(x), WCon{c842.bit.b3(x), WCon{c842.bit.b4(x), WCon{c842.bit.b5(x), WCon{c842.bit.b6(x), WCon{c842.bit.b7(x), WCon{c842.bit.b8(x), WCon{c842.bit.b9(x), WCon{c842.bit.b10(x), WCon{c842.bit.b11(x), WCon{c842.bit.b12(x), WCon{c842.bit.b13(x), WCon{c842.bit.b14(x), WCon{c842.bit.b15(x), WCon{c842.bit.b16(x), WCon{c842.bit.b17(x), WCon{c842.bit.b18(x), WCon{c842.bit.b19(x), WCon{c842.bit.b20(x), WCon{c842.bit.b21(x), WCon{c842.bit.b22(x), WCon{c842.bit.b23(x), WCon{c842.bit.b24(x), WCon{c842.bit.b25(x), WCon{c842.bit.b26(x), WCon{c842.bit.b27(x), WCon{c842.bit.b28(x), WCon{c842.bit.b29(x), WCon{c842.bit.b30(x), WCon{c842.bit.b31(x), WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}
