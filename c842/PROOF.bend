# The pointer rule: every output length (n = U32{w}) and every index of the
# kind's width (proof_pointer.bend). A literal has no history: no index
# satisfies the hypothesis.

def ll_absurd(+i: U32, +h: {Nat.is_lt(Nat.mul(U32.to_nat(i), 2n), 0n) == True{} : Bool}) -> Empty:
  PP.cp.ft(Equal.trans(Bool, False{}, Nat.is_lt(Nat.mul(U32.to_nat(i), 2n), 0n), True{}, Equal.sym(Bool, Nat.is_lt(Nat.mul(U32.to_nat(i), 2n), 0n), False{}, PP.cp.lt_zero(Nat.mul(U32.to_nat(i), 2n))), h))

# generated by gen/proof_lemmas.py (pointer_laws)
def Laws.pointer_found(n, k, i, h):
  match n:
    case U32{w}:
      match k:
        case F.C842LL{}:
          PP.cp.absurd({Maybe.is_some(&2, U32, P.c842.pointer(U32{w}, F.C842LL{}, i)) == Nat.is_lt(Laws.C842Laws.is(i, F.C842LL{}), Laws.C842Laws.t8(U32{w})) : Bool}, ll_absurd(i, h))
        case F.C842P2{}:
          %PP.cp.et(w) : {Maybe.is_some(&2, U32, P.c842.pointer(U32{w}, F.C842P2{}, i)) == Nat.is_lt(Nat.mul(U32.to_nat(i), 2n), _) : Bool}
          PP.cp.g_found(PP.cp.p0(w, 512, 2, i), PP.cp.t8(w), 512, PP.cp.b9(w), PP.cp.r9(w), Nat.mul(U32.to_nat(i), 2n), 511n, PP.cp.ht9(w), PP.cp.hp9(w, 2, i, Nat.mul(U32.to_nat(i), 2n), PP.cp.vr(i, 2, 1n, 512, PP.cp.mul2(i), h), h), {==}, h)
        case F.C842P4{}:
          %PP.cp.et(w) : {Maybe.is_some(&2, U32, P.c842.pointer(U32{w}, F.C842P4{}, i)) == Nat.is_lt(Nat.mul(U32.to_nat(i), 4n), _) : Bool}
          PP.cp.g_found(PP.cp.p0(w, 2048, 4, i), PP.cp.t8(w), 2048, PP.cp.b11(w), PP.cp.r11(w), Nat.mul(U32.to_nat(i), 4n), 2047n, PP.cp.ht11(w), PP.cp.hp11(w, 4, i, Nat.mul(U32.to_nat(i), 4n), PP.cp.vr(i, 4, 2n, 2048, PP.cp.mul4(i), h), h), {==}, h)
        case F.C842P8{}:
          %PP.cp.et(w) : {Maybe.is_some(&2, U32, P.c842.pointer(U32{w}, F.C842P8{}, i)) == Nat.is_lt(Nat.mul(U32.to_nat(i), 8n), _) : Bool}
          PP.cp.g_found(PP.cp.p0(w, 2048, 8, i), PP.cp.t8(w), 2048, PP.cp.b11(w), PP.cp.r11(w), Nat.mul(U32.to_nat(i), 8n), 2047n, PP.cp.ht11(w), PP.cp.hp11(w, 8, i, Nat.mul(U32.to_nat(i), 8n), PP.cp.vr(i, 8, 3n, 2048, PP.cp.mul8(i), h), h), {==}, h)

def Laws.pointer_rule(n, k, i, p, h, e):
  match n:
    case U32{w}:
      match k:
        case F.C842LL{}:
          PP.cp.absurd({(Nat.mod(U32.to_nat(p), U32.to_nat(F.C842Kind.history(F.C842LL{}))), Nat.is_le(Nat.add(U32.to_nat(p), U32.to_nat(F.C842Kind.size(F.C842LL{}))), Laws.C842Laws.t8(U32{w})), Nat.is_le(Laws.C842Laws.t8(U32{w}), Nat.add(U32.to_nat(p), U32.to_nat(F.C842Kind.history(F.C842LL{}))))) == (Laws.C842Laws.is(i, F.C842LL{}), True{}, True{}) : Nat & Bool & Bool}, ll_absurd(i, h))
        case F.C842P2{}:
          %PP.cp.et(w) : {(Nat.mod(U32.to_nat(p), 512n), Nat.is_le(Nat.add(U32.to_nat(p), 2n), _), Nat.is_le(_, Nat.add(U32.to_nat(p), 512n))) == (Nat.mul(U32.to_nat(i), 2n), True{}, True{}) : Nat & Bool & Bool}
          PP.cp.g_some(PP.cp.p0(w, 512, 2, i), PP.cp.t8(w), 512, p, PP.cp.b9(w), PP.cp.r9(w), Nat.mul(U32.to_nat(i), 2n), 511n, 1n, 256n, Nat.mul(PP.cp.dv(w), 4n), U32.to_nat(i), PP.cp.ht9(w), PP.cp.hp9(w, 2, i, Nat.mul(U32.to_nat(i), 2n), PP.cp.vr(i, 2, 1n, 512, PP.cp.mul2(i), h), h), {==}, PP.cp.hrr9(w), h, {==}, Equal.trans(Nat, U32.to_nat(PP.cp.t8(w)), Nat.mul(PP.cp.dv(w), 8n), Nat.mul(Nat.mul(PP.cp.dv(w), 4n), 2n), PP.cp.vt8(w), Equal.sym(Nat, Nat.mul(Nat.mul(PP.cp.dv(w), 4n), 2n), Nat.mul(PP.cp.dv(w), Nat.mul(4n, 2n)), UL.nat_mul_assoc(PP.cp.dv(w), 4n, 2n))), {==}, e)
        case F.C842P4{}:
          %PP.cp.et(w) : {(Nat.mod(U32.to_nat(p), 2048n), Nat.is_le(Nat.add(U32.to_nat(p), 4n), _), Nat.is_le(_, Nat.add(U32.to_nat(p), 2048n))) == (Nat.mul(U32.to_nat(i), 4n), True{}, True{}) : Nat & Bool & Bool}
          PP.cp.g_some(PP.cp.p0(w, 2048, 4, i), PP.cp.t8(w), 2048, p, PP.cp.b11(w), PP.cp.r11(w), Nat.mul(U32.to_nat(i), 4n), 2047n, 3n, 512n, Nat.mul(PP.cp.dv(w), 2n), U32.to_nat(i), PP.cp.ht11(w), PP.cp.hp11(w, 4, i, Nat.mul(U32.to_nat(i), 4n), PP.cp.vr(i, 4, 2n, 2048, PP.cp.mul4(i), h), h), {==}, PP.cp.hrr11(w), h, {==}, Equal.trans(Nat, U32.to_nat(PP.cp.t8(w)), Nat.mul(PP.cp.dv(w), 8n), Nat.mul(Nat.mul(PP.cp.dv(w), 2n), 4n), PP.cp.vt8(w), Equal.sym(Nat, Nat.mul(Nat.mul(PP.cp.dv(w), 2n), 4n), Nat.mul(PP.cp.dv(w), Nat.mul(2n, 4n)), UL.nat_mul_assoc(PP.cp.dv(w), 2n, 4n))), {==}, e)
        case F.C842P8{}:
          %PP.cp.et(w) : {(Nat.mod(U32.to_nat(p), 2048n), Nat.is_le(Nat.add(U32.to_nat(p), 8n), _), Nat.is_le(_, Nat.add(U32.to_nat(p), 2048n))) == (Nat.mul(U32.to_nat(i), 8n), True{}, True{}) : Nat & Bool & Bool}
          PP.cp.g_some(PP.cp.p0(w, 2048, 8, i), PP.cp.t8(w), 2048, p, PP.cp.b11(w), PP.cp.r11(w), Nat.mul(U32.to_nat(i), 8n), 2047n, 7n, 256n, PP.cp.dv(w), U32.to_nat(i), PP.cp.ht11(w), PP.cp.hp11(w, 8, i, Nat.mul(U32.to_nat(i), 8n), PP.cp.vr(i, 8, 3n, 2048, PP.cp.mul8(i), h), h), {==}, PP.cp.hrr11(w), h, {==}, PP.cp.vt8(w), {==}, e)

def Laws.pointer_in_window(n, k, i, p, h, e):
  match n:
    case U32{w}:
      +tr = Laws.pointer_rule(U32{w}, k, i, p, h, e)
      +s = U32.to_nat(F.C842Kind.size(k))
      +hh = U32.to_nat(F.C842Kind.history(k))
      +t = Nat.mul(Nat.div(Word.to_nat(32n, w), 8n), 8n)
      +b1 = Equal.cong(Nat & Bool & Bool, Bool, x => Pair.fst(Bool, Bool, Pair.snd(Nat, Bool & Bool, x)), (Nat.mod(U32.to_nat(p), hh), Nat.is_le(Nat.add(U32.to_nat(p), s), t), Nat.is_le(t, Nat.add(U32.to_nat(p), hh))), (Laws.C842Laws.is(i, k), True{}, True{}), tr)
      +b2 = Equal.cong(Nat & Bool & Bool, Bool, x => Pair.snd(Bool, Bool, Pair.snd(Nat, Bool & Bool, x)), (Nat.mod(U32.to_nat(p), hh), Nat.is_le(Nat.add(U32.to_nat(p), s), t), Nat.is_le(t, Nat.add(U32.to_nat(p), hh))), (Laws.C842Laws.is(i, k), True{}, True{}), tr)
      PP.cp.window(U32.to_nat(p), s, hh, w, b1, b2)

