# Pieces: a stream's bits are its pieces' bits, joined

def unpack_cat(+xs: List<&2, U32>, +ys: List<&2, U32>) -> {F.c842.unpack.list(B.append(xs, ys)) == F.c842.fmt.cat(F.c842.unpack.list(xs), F.c842.unpack.list(ys)) : List<&2, Bool>}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      %unpack_cat(t, ys) : {F.c842.unpack.list(B.append(Con{x, t}, ys)) == Con{Bi.c842.bit.b7(x), Con{Bi.c842.bit.b6(x), Con{Bi.c842.bit.b5(x), Con{Bi.c842.bit.b4(x), Con{Bi.c842.bit.b3(x), Con{Bi.c842.bit.b2(x), Con{Bi.c842.bit.b1(x), Con{Bi.c842.bit.b0(x), _}}}}}}}} : List<&2, Bool>}
      {==}

def unpack_append(+a: B.Octets, +b: B.Octets) -> {F.c842.unpack(B.Octets.append(a, b)) == F.c842.fmt.cat(F.c842.unpack(a), F.c842.unpack(b)) : List<&2, Bool>}:
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(a, b)), B.append(B.Octets.to_list(a), B.Octets.to_list(b)), BL.octets_append_list(a, b)) : {F.c842.unpack.list(_) == F.c842.fmt.cat(F.c842.unpack(a), F.c842.unpack(b)) : List<&2, Bool>}
  unpack_cat(B.Octets.to_list(a), B.Octets.to_list(b))

def go_cat(+a: List<&2, Bool>, +b: List<&2, Bool>, +d: D.C842Dec) -> {D.c842.dec.go(F.c842.fmt.cat(a, b), d) == D.c842.dec.go(b, D.c842.dec.go(a, d)) : D.C842Dec}:
  match a:
    case Nil{}:
      {==}
    case Con{h, t}:
      go_cat(t, b, D.c842.dec.bit(d, h))

def res_disc(+r: Result<&2, &2, E.C842Error, B.Octets>) -> Type:
  match r:
    case Fail{x}:
      Empty
    case Done{y}:
      Unit

def fail_not_done(-x: E.C842Error, -o: B.Octets, h: {Fail{x} == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}) -> Empty:
  %Equal.sym(Result<&2, &2, E.C842Error, B.Octets>, Fail{x}, Done{o}, h) : res_disc(_)
  Unit{}

# a decoder that has answered Done answers the same, whatever bits follow
def result_ext(+d: D.C842Dec, +bs: List<&2, Bool>, +o: B.Octets, e: {D.c842.dec.result(d) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}) -> {D.c842.dec.result(D.c842.dec.go(bs, d)) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}:
  match d:
    case D.C842Dec{p, r}:
      match r:
        case D.C842Going{acc, n, w, room}:
          absurd({D.c842.dec.result(D.c842.dec.go(bs, D.C842Dec{p, D.C842Going{acc, n, w, room}})) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}, fail_not_done(E.C842Truncated{}, o, e))
        case D.C842Finished{x}:
          %Equal.sym(D.C842Dec, D.c842.dec.go(bs, D.C842Dec{p, D.C842Finished{x}}), D.C842Dec{p, D.C842Finished{x}}, absorb_fin(bs, p, x)) : {D.c842.dec.result(_) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
          e
        case D.C842Failed{x}:
          absurd({D.c842.dec.result(D.c842.dec.go(bs, D.C842Dec{p, D.C842Failed{x}})) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}, fail_not_done(x, o, e))

