def reader_go(+ps: List<&2, B.Octets>, +d: D.C842Dec) -> {D.c842.reader.go(ps, d) == D.c842.dec.go(F.c842.unpack(Laws.C842Laws.join(ps)), d) : D.C842Dec}:
