# The first pointer of a stream: nothing written, so no position (n = 0)

def none0(+k: F.C842Kind, +i: U32, +h: {Nat.is_lt(Laws.C842Laws.is(i, k), U32.to_nat(F.C842Kind.history(k))) == True{} : Bool}) -> {None{} == P.c842.pointer(0, k, i) : Maybe<&2, U32>}:
  PP.cp.none_of(P.c842.pointer(0, k, i), Equal.trans(Bool, Maybe.is_some(&2, U32, P.c842.pointer(0, k, i)), Nat.is_lt(Laws.C842Laws.is(i, k), 0n), False{}, Laws.pointer_found(0, k, i, h), PP.cp.lt_zero(Laws.C842Laws.is(i, k))))

