# The parser reads each pointer's index in exactly its kind's width. In a
# field state, the bits read so far and the bits left add up to the width,
# with at least one left; so the index has width bits (proof_pointer.bend,
# cp.vb), and i * s < H.

def pinv(+p: F.C842Parser) -> Type:
  match p:
    case F.C842Parser{w, got, left}:
      match w:
        case F.C842WField{k, more}:
          match left:
            case 0n:
              Empty
            case 1n+j:
              {Nat.add(List.length(&2, Bool, got), 1n+j) == F.C842Kind.width(k) : Nat}
        case _:
          Unit

# a step: its event fits, and its parser keeps the invariant
def pinvs(+s: F.C842Step) -> Type:
  match s:
    case F.C842Step{p, ev}:
      {Laws.C842Laws.fits(ev) == True{} : Bool} & pinv(p)

def pi_nf(+ks: List<&2, F.C842Kind>) -> pinv(F.c842.parse.next_field(ks)):
  match ks:
    case Nil{}:
      Unit{}
    case Con{k, t}:
      match k:
        case F.C842LL{}:
          {==}
        case F.C842P2{}:
          {==}
        case F.C842P4{}:
          {==}
        case F.C842P8{}:
          {==}

def pi_chunk(+m: Maybe<&2, List<&2, F.C842Kind>>, +t: U32) -> pinvs(F.c842.parse.chunk(m, t)):
  match m:
    case None{}:
      ({==}, Unit{})
    case Some{ks}:
      ({==}, pi_nf(ks))

def pi_c30(+hit: Bool) -> pinvs(F.c842.parse.c30(hit)):
  match hit:
    case True{}:
      ({==}, Unit{})
    case False{}:
      ({==}, Unit{})

def pi_c29(+hit: Bool, +t: U32) -> pinvs(F.c842.parse.c29(hit, t)):
  match hit:
    case True{}:
      ({==}, Unit{})
    case False{}:
      pi_c30(U32.is_eq(t, 30))

def pi_c28(+hit: Bool, +t: U32) -> pinvs(F.c842.parse.c28(hit, t)):
  match hit:
    case True{}:
      ({==}, Unit{})
    case False{}:
      pi_c29(U32.is_eq(t, 29), t)

def pi_c27(+hit: Bool, +t: U32) -> pinvs(F.c842.parse.c27(hit, t)):
  match hit:
    case True{}:
      ({==}, Unit{})
    case False{}:
      pi_c28(U32.is_eq(t, 28), t)

def pi_codeat(+lt: Bool, +t: U32) -> pinvs(F.c842.parse.code.at(lt, t)):
  match lt:
    case True{}:
      pi_chunk(F.c842.template(t), t)
    case False{}:
      pi_c27(U32.is_eq(t, 27), t)

def pi_code(+t: U32) -> pinvs(F.c842.parse.code(t)):
  pi_codeat(U32.is_lt(t, 26), t)

def pi_count(+z: Bool, +n: Nat) -> pinvs(F.c842.parse.count(z, n)):
  match z:
    case True{}:
      ({==}, Unit{})
    case False{}:
      ({==}, Unit{})

def pi_sn(+n: Nat) -> pinv(F.c842.parse.short_next(n)):
  match n:
    case 0n:
      Unit{}
    case 1n+m:
      match m:
        case 0n:
          Unit{}
        case 1n+r:
          Unit{}

# generated by gen/proof_lemmas.py (lit_fits)
def pi_lit(+bs: List<&2, Bool>) -> {Laws.C842Laws.fits(F.c842.parse.lit(bs)) == True{} : Bool}:
  match bs:
    case Nil{}:
      {==}
    case Con{c0, t1}:
      match t1:
        case Nil{}:
          {==}
        case Con{c1, t2}:
          match t2:
            case Nil{}:
              {==}
            case Con{c2, t3}:
              match t3:
                case Nil{}:
                  {==}
                case Con{c3, t4}:
                  match t4:
                    case Nil{}:
                      {==}
                    case Con{c4, t5}:
                      match t5:
                        case Nil{}:
                          {==}
                        case Con{c5, t6}:
                          match t6:
                            case Nil{}:
                              {==}
                            case Con{c6, t7}:
                              match t7:
                                case Nil{}:
                                  {==}
                                case Con{c7, t8}:
                                  match t8:
                                    case Nil{}:
                                      {==}
                                    case Con{c8, t9}:
                                      match t9:
                                        case Nil{}:
                                          {==}
                                        case Con{c9, t10}:
                                          match t10:
                                            case Nil{}:
                                              {==}
                                            case Con{c10, t11}:
                                              match t11:
                                                case Nil{}:
                                                  {==}
                                                case Con{c11, t12}:
                                                  match t12:
                                                    case Nil{}:
                                                      {==}
                                                    case Con{c12, t13}:
                                                      match t13:
                                                        case Nil{}:
                                                          {==}
                                                        case Con{c13, t14}:
                                                          match t14:
                                                            case Nil{}:
                                                              {==}
                                                            case Con{c14, t15}:
                                                              match t15:
                                                                case Nil{}:
                                                                  {==}
                                                                case Con{c15, t16}:
                                                                  {==}

# a field of width(k) bits fits
# generated by gen/proof_lemmas.py (field_fits)
def pi_field(+k: F.C842Kind, +bs: List<&2, Bool>, +e: {List.length(&2, Bool, bs) == F.C842Kind.width(k) : Nat}) -> {Laws.C842Laws.fits(F.c842.parse.field(k, bs)) == True{} : Bool}:
  match k:
    case F.C842LL{}:
      pi_lit(bs)
    case F.C842P2{}:
      PP.cp.mulb(U32.to_nat(F.c842.fmt.value(bs)), 1n, 8n, PP.cp.lt_rw(U32.to_nat(F.c842.fmt.value(bs)), U32.to_nat(F.c842.fmt.value(bs)), U.U32Nat.dbl(List.length(&2, Bool, bs), 1n), U.U32Nat.dbl(8n, 1n), {==}, Equal.cong(Nat, Nat, z => U.U32Nat.dbl(z, 1n), List.length(&2, Bool, bs), 8n, e), PP.cp.vb(bs, PP.cp.le_rw(8n, List.length(&2, Bool, bs), 9n, 9n, Equal.sym(Nat, List.length(&2, Bool, bs), 8n, e), {==}, {==}))))
    case F.C842P4{}:
      PP.cp.mulb(U32.to_nat(F.c842.fmt.value(bs)), 2n, 9n, PP.cp.lt_rw(U32.to_nat(F.c842.fmt.value(bs)), U32.to_nat(F.c842.fmt.value(bs)), U.U32Nat.dbl(List.length(&2, Bool, bs), 1n), U.U32Nat.dbl(9n, 1n), {==}, Equal.cong(Nat, Nat, z => U.U32Nat.dbl(z, 1n), List.length(&2, Bool, bs), 9n, e), PP.cp.vb(bs, PP.cp.le_rw(9n, List.length(&2, Bool, bs), 9n, 9n, Equal.sym(Nat, List.length(&2, Bool, bs), 9n, e), {==}, {==}))))
    case F.C842P8{}:
      PP.cp.mulb(U32.to_nat(F.c842.fmt.value(bs)), 3n, 8n, PP.cp.lt_rw(U32.to_nat(F.c842.fmt.value(bs)), U32.to_nat(F.c842.fmt.value(bs)), U.U32Nat.dbl(List.length(&2, Bool, bs), 1n), U.U32Nat.dbl(8n, 1n), {==}, Equal.cong(Nat, Nat, z => U.U32Nat.dbl(z, 1n), List.length(&2, Bool, bs), 8n, e), PP.cp.vb(bs, PP.cp.le_rw(8n, List.length(&2, Bool, bs), 9n, 9n, Equal.sym(Nat, List.length(&2, Bool, bs), 8n, e), {==}, {==}))))

def pi_len1(+got: List<&2, Bool>, -b: Bool, -n: Nat, +h: {Nat.add(List.length(&2, Bool, got), 1n) == n : Nat}) -> {List.length(&2, Bool, Con{b, got}) == n : Nat}:
  Equal.trans(Nat, 1n+List.length(&2, Bool, got), Nat.add(List.length(&2, Bool, got), 1n), n, Equal.sym(Nat, Nat.add(List.length(&2, Bool, got), 1n), 1n+List.length(&2, Bool, got), Equal.trans(Nat, Nat.add(List.length(&2, Bool, got), 1n), 1n+Nat.add(List.length(&2, Bool, got), 0n), 1n+List.length(&2, Bool, got), UL.nat_add_succ(List.length(&2, Bool, got), 0n), PP.cp.succ_cong(Nat.add(List.length(&2, Bool, got), 0n), List.length(&2, Bool, got), UL.nat_add_zero(List.length(&2, Bool, got))))), h)

def pi_at(+w: F.C842Want, +got: List<&2, Bool>, +left: Nat, +b: Bool, h: pinv(F.C842Parser{w, got, left})) -> pinvs(F.c842.parse.at(left, w, Con{b, got})):
  match w:
    case F.C842WCode{}:
      match left:
        case 0n:
          pi_code(F.c842.fmt.value(Con{b, got}))
        case 1n+r:
          match r:
            case 0n:
              pi_code(F.c842.fmt.value(Con{b, got}))
            case 1n+s:
              ({==}, Unit{})
    case F.C842WField{k, more}:
      match left:
        case 0n:
          PP.cp.absurd(pinvs(F.c842.parse.at(0n, F.C842WField{k, more}, Con{b, got})), h)
        case 1n+r:
          match r:
            case 0n:
              (pi_field(k, Con{b, got}, pi_len1(got, b, F.C842Kind.width(k), h)), pi_nf(more))
            case 1n+s:
              ({==}, Equal.trans(Nat, 1n+Nat.add(List.length(&2, Bool, got), 1n+s), Nat.add(List.length(&2, Bool, got), 2n+s), F.C842Kind.width(k), Equal.sym(Nat, Nat.add(List.length(&2, Bool, got), 2n+s), 1n+Nat.add(List.length(&2, Bool, got), 1n+s), UL.nat_add_succ(List.length(&2, Bool, got), 1n+s)), h))
    case F.C842WRepeat{}:
      match left:
        case 0n:
          ({==}, Unit{})
        case 1n+r:
          match r:
            case 0n:
              ({==}, Unit{})
            case 1n+s:
              ({==}, Unit{})
    case F.C842WCount{}:
      match left:
        case 0n:
          pi_count(U32.is_eq(F.c842.fmt.value(Con{b, got}), 0), U32.to_nat(F.c842.fmt.value(Con{b, got})))
        case 1n+r:
          match r:
            case 0n:
              pi_count(U32.is_eq(F.c842.fmt.value(Con{b, got}), 0), U32.to_nat(F.c842.fmt.value(Con{b, got})))
            case 1n+s:
              ({==}, Unit{})
    case F.C842WShort{n}:
      match left:
        case 0n:
          ({==}, pi_sn(n))
        case 1n+r:
          match r:
            case 0n:
              ({==}, pi_sn(n))
            case 1n+s:
              ({==}, Unit{})
    case F.C842WCrc{}:
      match left:
        case 0n:
          ({==}, Unit{})
        case 1n+r:
          match r:
            case 0n:
              ({==}, Unit{})
            case 1n+s:
              ({==}, Unit{})
    case F.C842WEnd{}:
      match left:
        case 0n:
          ({==}, Unit{})
        case 1n+r:
          match r:
            case 0n:
              ({==}, Unit{})
            case 1n+s:
              ({==}, Unit{})

def pi_step(+p: F.C842Parser, +b: Bool, h: pinv(p)) -> pinvs(F.C842Parser.step(p, b)):
  match p:
    case F.C842Parser{w, got, left}:
      pi_at(w, got, left, b, h)

def pi_af(+bs: List<&2, Bool>, +s: F.C842Step, h: pinvs(s)) -> {Laws.C842Laws.all_fit(bs, s) == True{} : Bool}:
  match bs:
    case Nil{}:
      match s:
        case F.C842Step{p, ev}:
          (hf, hi) = h
          hf
    case Con{b, t}:
      match s:
        case F.C842Step{p, ev}:
          (hf, hi) = h
          %Equal.sym(Bool, Laws.C842Laws.fits(ev), True{}, hf) : {Bool.and(_, Laws.C842Laws.all_fit(t, F.C842Parser.step(p, b))) == True{} : Bool}
          pi_af(t, F.C842Parser.step(p, b), pi_step(p, b, hi))

def Laws.parser_indices_fit(bs):
  pi_af(bs, F.C842Step{F.C842Parser.start(), F.C842ENone{}}, ({==}, Unit{}))
