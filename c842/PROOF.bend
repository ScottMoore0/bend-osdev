  %Equal.sym(List<&2, Bool>, F.c842.unpack(B.Octets.append(s, t)), F.c842.fmt.cat(F.c842.unpack(s), F.c842.unpack(t)), unpack_append(s, t)) : {D.c842.dec.result(D.c842.dec.go(_, D.c842.dec.start(max))) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  %Equal.sym(D.C842Dec, D.c842.dec.go(F.c842.fmt.cat(F.c842.unpack(s), F.c842.unpack(t)), D.c842.dec.start(max)), D.c842.dec.go(F.c842.unpack(t), D.c842.dec.go(F.c842.unpack(s), D.c842.dec.start(max))), go_cat(F.c842.unpack(s), F.c842.unpack(t), D.c842.dec.start(max))) : {D.c842.dec.result(_) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  result_ext(D.c842.dec.go(F.c842.unpack(s), D.c842.dec.start(max)), F.c842.unpack(t), o, e)

