# The output never passes the maximum: the bytes so far and the room left add
# up to it, as long as the decoder is going

def drun(+d: D.C842Dec) -> D.C842Run:
  match d:
    case D.C842Dec{p, r}:
      r

def inv(+r: D.C842Run, +max: Nat) -> Type:
  match r:
    case D.C842Going{acc, n, w, room}:
      {Nat.add(List.length(&2, U32, acc), room) == max : Nat}
    case D.C842Finished{o}:
      {Nat.is_le(B.Octets.len(o), max) == True{} : Bool}
    case D.C842Failed{e}:
      Unit

def push_inv(+r: D.C842Run, +b: U32, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.push(r, b), max):
  match r:
    case D.C842Going{acc, n, w, room}:
      match room:
        case 0n:
          Unit{}
        case 1n+q:
          %UL.nat_add_succ(List.length(&2, U32, acc), q) : {_ == max : Nat}
          h
    case D.C842Finished{o}:
      h
    case D.C842Failed{e}:
      h

def pushes_inv(+xs: List<&2, U32>, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.pushes(xs, r), max):
  match xs:
    case Nil{}:
      h
    case Con{x, t}:
      pushes_inv(t, D.c842.dec.push(r, x), max, push_inv(r, x, max, h))

def copy_inv(+k: Nat, +p: U32, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.copy(k, p, r), max):
  match k:
    case 0n:
      h
    case 1n+j:
      copy_inv(j, U32.add(p, 1), D.c842.dec.push(r, D.c842.dec.byte_at(r, p)), max, push_inv(r, D.c842.dec.byte_at(r, p), max, h))

def reps_inv(+k: Nat, +xs: List<&2, U32>, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.reps(k, xs, r), max):
  match k:
    case 0n:
      h
    case 1n+j:
      reps_inv(j, xs, D.c842.dec.pushes(xs, r), max, pushes_inv(xs, r, max, h))

def ptr_at_inv(+m: Maybe<&2, U32>, +k: F.C842Kind, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.ptr.at(m, k, r), max):
  match m:
    case None{}:
      Unit{}
    case Some{p}:
      copy_inv(U32.to_nat(F.C842Kind.size(k)), p, r, max, h)

def ptr_inv(+k: F.C842Kind, +i: U32, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.ptr(k, i, r), max):
  match r:
    case D.C842Going{acc, n, w, room}:
      ptr_at_inv(P.c842.pointer(n, k, i), k, D.C842Going{acc, n, w, room}, max, h)
    case D.C842Finished{o}:
      h
    case D.C842Failed{e}:
      h

def rpt_at_inv(+m: Maybe<&2, List<&2, U32>>, +k: Nat, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.rpt.at(m, k, r), max):
  match m:
    case None{}:
      Unit{}
    case Some{xs}:
      reps_inv(k, xs, r, max, h)

def rpt_inv(+f: U32, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.rpt(f, r), max):
  match r:
    case D.C842Going{acc, n, w, room}:
      rpt_at_inv(D.c842.dec.last8(acc), 1n+U32.to_nat(f), D.C842Going{acc, n, w, room}, max, h)
    case D.C842Finished{o}:
      h
    case D.C842Failed{e}:
      h

def len_mask(+xs: List<&2, U32>) -> {List.length(&2, U32, B.mask(xs)) == List.length(&2, U32, xs) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      %len_mask(t) : {1n+List.length(&2, U32, B.mask(t)) == 1n+_ : Nat}
      {==}

def len_rev(+xs: List<&2, U32>, +acc: List<&2, U32>) -> {List.length(&2, U32, B.rev_onto(xs, acc)) == Nat.add(List.length(&2, U32, xs), List.length(&2, U32, acc)) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      %Equal.sym(Nat, List.length(&2, U32, B.rev_onto(t, Con{x, acc})), Nat.add(List.length(&2, U32, t), 1n+List.length(&2, U32, acc)), len_rev(t, Con{x, acc})) : {_ == 1n+Nat.add(List.length(&2, U32, t), List.length(&2, U32, acc)) : Nat}
      UL.nat_add_succ(List.length(&2, U32, t), List.length(&2, U32, acc))

def le_zero(+c: Nat) -> {Nat.is_le(0n, c) == True{} : Bool}:
  match c:
    case 0n:
      {==}
    case 1n+p:
      {==}

# the output at the end is as long as the bytes pushed
def len_out(+acc: List<&2, U32>) -> {B.Octets.len(B.Octets.of_list(B.rev(acc))) == List.length(&2, U32, acc) : Nat}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.of_list(B.rev(acc))), B.len(B.Octets.to_list(B.Octets.of_list(B.rev(acc)))), BL.octets_len_list(B.Octets.of_list(B.rev(acc)))) : {_ == List.length(&2, U32, acc) : Nat}
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(B.rev(acc))), B.mask(B.rev(acc)), BL.octets_to_of(B.rev(acc))) : {B.len(_) == List.length(&2, U32, acc) : Nat}
  %Equal.sym(Nat, List.length(&2, U32, B.mask(B.rev(acc))), List.length(&2, U32, B.rev(acc)), len_mask(B.rev(acc))) : {_ == List.length(&2, U32, acc) : Nat}
  %Equal.sym(Nat, List.length(&2, U32, B.rev_onto(acc, Nil{})), Nat.add(List.length(&2, U32, acc), 0n), len_rev(acc, Nil{})) : {_ == List.length(&2, U32, acc) : Nat}
  UL.nat_add_zero(List.length(&2, U32, acc))

def end_le(+acc: List<&2, U32>, +room: Nat, +max: Nat, h: {Nat.add(List.length(&2, U32, acc), room) == max : Nat}) -> {Nat.is_le(B.Octets.len(B.Octets.of_list(B.rev(acc))), max) == True{} : Bool}:
  %Equal.sym(Nat, B.Octets.len(B.Octets.of_list(B.rev(acc))), List.length(&2, U32, acc), len_out(acc)) : {Nat.is_le(_, max) == True{} : Bool}
  %h : {Nat.is_le(List.length(&2, U32, acc), _) == True{} : Bool}
  UO.nat_le_add_r(List.length(&2, U32, acc), room)

def end_at_inv(+ok: Bool, +out: B.Octets, +max: Nat, h: {Nat.is_le(B.Octets.len(out), max) == True{} : Bool}) -> inv(D.c842.dec.end.at(ok, out), max):
  match ok:
    case True{}:
      h
    case False{}:
      Unit{}

def end_inv(+c: U32, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.end(c, r), max):
  match r:
    case D.C842Going{acc, n, w, room}:
      end_at_inv(D.c842.u32_same(c, K.c842.crc(B.Octets.of_list(B.rev(acc)))), B.Octets.of_list(B.rev(acc)), max, end_le(acc, room, max, h))
    case D.C842Finished{o}:
      h
    case D.C842Failed{e}:
      h

def event_inv(+ev: F.C842Event, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(D.c842.dec.event(ev, r), max):
  match ev:
    case F.C842ENone{}:
      h
    case F.C842ETemplate{t}:
      h
    case F.C842ELit{hi, lo}:
      push_inv(D.c842.dec.push(r, hi), lo, max, push_inv(r, hi, max, h))
    case F.C842EPtr{k, i}:
      ptr_inv(k, i, r, max, h)
    case F.C842ERepeat{f}:
      rpt_inv(f, r, max, h)
    case F.C842EZero{}:
      pushes_inv([0, 0, 0, 0, 0, 0, 0, 0], r, max, h)
    case F.C842EShortStart{k}:
      h
    case F.C842EShort{b}:
      push_inv(r, b, max, h)
    case F.C842EEnd{c}:
      end_inv(c, r, max, h)
    case F.C842EBad{e}:
      Unit{}

def step_inv(+s: F.C842Step, +r: D.C842Run, +max: Nat, h: inv(r, max)) -> inv(drun(D.c842.dec.step(s, r)), max):
  match s:
    case F.C842Step{p, ev}:
      event_inv(ev, r, max, h)

def bit_inv(+d: D.C842Dec, +b: Bool, +max: Nat, h: inv(drun(d), max)) -> inv(drun(D.c842.dec.bit(d, b)), max):
  match d:
    case D.C842Dec{p, r}:
      match r:
        case D.C842Going{acc, n, w, room}:
          step_inv(F.C842Parser.step(p, b), D.C842Going{acc, n, w, room}, max, h)
        case D.C842Finished{o}:
          h
        case D.C842Failed{e}:
          h

def go_inv(+bs: List<&2, Bool>, +d: D.C842Dec, +max: Nat, h: inv(drun(d), max)) -> inv(drun(D.c842.dec.go(bs, d)), max):
  match bs:
    case Nil{}:
      h
    case Con{b, t}:
      go_inv(t, D.c842.dec.bit(d, b), max, bit_inv(d, b, max, h))

def res_inv(+d: D.C842Dec, +max: Nat, h: inv(drun(d), max)) -> {Nat.is_le(B.Octets.len(Result.default(&2, &2, E.C842Error, B.Octets, D.c842.dec.result(d), B.Octets.empty())), max) == True{} : Bool}:
  match d:
    case D.C842Dec{p, r}:
      match r:
        case D.C842Going{acc, n, w, room}:
          le_zero(max)
        case D.C842Finished{o}:
          h
        case D.C842Failed{e}:
          le_zero(max)

def Laws.output_within_max(src, max):
  res_inv(D.c842.dec.go(F.c842.unpack(src), D.c842.dec.start(max)), max, go_inv(F.c842.unpack(src), D.c842.dec.start(max), max, {==}))

