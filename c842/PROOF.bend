      %Equal.sym(D.C842Dec, D.c842.dec.go(F.c842.fmt.cat(F.c842.unpack(p), F.c842.unpack(Laws.C842Laws.join(t))), d), D.c842.dec.go(F.c842.unpack(Laws.C842Laws.join(t)), D.c842.dec.go(F.c842.unpack(p), d)), go_cat(F.c842.unpack(p), F.c842.unpack(Laws.C842Laws.join(t)), d)) : {D.c842.reader.go(Con{p, t}, d) == _ : D.C842Dec}
      reader_go(t, D.c842.dec.go(F.c842.unpack(p), d))

