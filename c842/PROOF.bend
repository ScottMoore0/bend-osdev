# The properties follow the decoder bit by bit. Each lemma below is about
# the package's internals, never stated as a law. Octets enter only through
# bytes' interface laws (octets_to_of, octets_of_to, octets_len_list,
# octets_cons_list, octets_append_list, rev_rev); only the vectors compute
# on concrete Octets. The pointer rule's arithmetic (pointer.bend) is in
# proof_pointer.bend, from bend-osdev-u32's laws on U32 values.
#
# The parts marked "generated by gen/proof_lemmas.py" are deep patterns
# printed by that script.

# Logic

def bool_disc(+b: Bool) -> Type:
  match b:
    case True{}:
      Empty
    case False{}:
      Unit

def false_not_true(h: {False{} == True{} : Bool}) -> Empty:
  %h : bool_disc(_)
  Unit{}

def absurd(-P: Type, e: Empty) -> P:
  match e:

# Bit lists

def cat_assoc(+a: List<&2, Bool>, +b: List<&2, Bool>, +c: List<&2, Bool>) -> {F.c842.fmt.cat(F.c842.fmt.cat(a, b), c) == F.c842.fmt.cat(a, F.c842.fmt.cat(b, c)) : List<&2, Bool>}:
  match a:
    case Nil{}:
      {==}
    case Con{h, t}:
      %cat_assoc(t, b, c) : {Con{h, F.c842.fmt.cat(F.c842.fmt.cat(t, b), c)} == Con{h, _} : List<&2, Bool>}
      {==}

def zeros_add(+a: Nat, +b: Nat) -> {F.c842.fmt.cat(F.c842.fmt.zeros(a), F.c842.fmt.zeros(b)) == F.c842.fmt.zeros(Nat.add(a, b)) : List<&2, Bool>}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      %zeros_add(p, b) : {Con{False{}, F.c842.fmt.cat(F.c842.fmt.zeros(p), F.c842.fmt.zeros(b))} == Con{False{}, _} : List<&2, Bool>}
      {==}

# pad adds fill.go's zeros
def pad_cat(+bs: List<&2, Bool>, +w: Nat) -> {F.c842.fmt.pad(bs, w) == F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.pack.fill.go(bs, w))) : List<&2, Bool>}:
  match bs:
    case Nil{}:
      {==}
    case Con{b, t}:
      match w:
        case 0n:
          %pad_cat(t, 63n) : {Con{b, F.c842.fmt.pad(t, 63n)} == Con{b, _} : List<&2, Bool>}
          {==}
        case 1n+q:
          %pad_cat(t, q) : {Con{b, F.c842.fmt.pad(t, q)} == Con{b, _} : List<&2, Bool>}
          {==}

# grouping bits into bytes and back: the bits, zero-filled to whole bytes;
# and each group is already a byte (masking changes nothing)
# generated by gen/proof_lemmas.py (groups)
def unpack_group(+bs: List<&2, Bool>) -> {F.c842.unpack.list(F.c842.fmt.group(bs)) == F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.fmt.gfill(bs))) : List<&2, Bool>}:
  match bs:
    case Nil{}:
      {==}
    case Con{c0, t1}:
      match t1:
        case Nil{}:
          {==}
        case Con{c1, t2}:
          match t2:
            case Nil{}:
              {==}
            case Con{c2, t3}:
              match t3:
                case Nil{}:
                  {==}
                case Con{c3, t4}:
                  match t4:
                    case Nil{}:
                      {==}
                    case Con{c4, t5}:
                      match t5:
                        case Nil{}:
                          {==}
                        case Con{c5, t6}:
                          match t6:
                            case Nil{}:
                              {==}
                            case Con{c6, t7}:
                              match t7:
                                case Nil{}:
                                  {==}
                                case Con{c7, t8}:
                                  %unpack_group(t8) : {F.c842.unpack.list(F.c842.fmt.group(Con{c0, Con{c1, Con{c2, Con{c3, Con{c4, Con{c5, Con{c6, Con{c7, t8}}}}}}}})) == Con{c0, Con{c1, Con{c2, Con{c3, Con{c4, Con{c5, Con{c6, Con{c7, _}}}}}}}} : List<&2, Bool>}
                                  {==}

def mask_group(+bs: List<&2, Bool>) -> {B.mask(F.c842.fmt.group(bs)) == F.c842.fmt.group(bs) : List<&2, U32>}:
  match bs:
    case Nil{}:
      {==}
    case Con{c0, t1}:
      match t1:
        case Nil{}:
          {==}
        case Con{c1, t2}:
          match t2:
            case Nil{}:
              {==}
            case Con{c2, t3}:
              match t3:
                case Nil{}:
                  {==}
                case Con{c3, t4}:
                  match t4:
                    case Nil{}:
                      {==}
                    case Con{c4, t5}:
                      match t5:
                        case Nil{}:
                          {==}
                        case Con{c5, t6}:
                          match t6:
                            case Nil{}:
                              {==}
                            case Con{c6, t7}:
                              match t7:
                                case Nil{}:
                                  {==}
                                case Con{c7, t8}:
                                  %mask_group(t8) : {B.mask(F.c842.fmt.group(Con{c0, Con{c1, Con{c2, Con{c3, Con{c4, Con{c5, Con{c6, Con{c7, t8}}}}}}}})) == Con{Bi.c842.byte.of(c7, c6, c5, c4, c3, c2, c1, c0), _} : List<&2, U32>}
                                  {==}


def Laws.pack_round_trip(bs):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(F.c842.fmt.group(F.c842.fmt.pad(bs, 0n)))), B.mask(F.c842.fmt.group(F.c842.fmt.pad(bs, 0n))), BL.octets_to_of(F.c842.fmt.group(F.c842.fmt.pad(bs, 0n)))) : {F.c842.unpack.list(_) == F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.pack.fill(bs))) : List<&2, Bool>}
  %Equal.sym(List<&2, U32>, B.mask(F.c842.fmt.group(F.c842.fmt.pad(bs, 0n))), F.c842.fmt.group(F.c842.fmt.pad(bs, 0n)), mask_group(F.c842.fmt.pad(bs, 0n))) : {F.c842.unpack.list(_) == F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.pack.fill(bs))) : List<&2, Bool>}
  %Equal.sym(List<&2, Bool>, F.c842.unpack.list(F.c842.fmt.group(F.c842.fmt.pad(bs, 0n))), F.c842.fmt.cat(F.c842.fmt.pad(bs, 0n), F.c842.fmt.zeros(F.c842.fmt.gfill(F.c842.fmt.pad(bs, 0n)))), unpack_group(F.c842.fmt.pad(bs, 0n))) : {_ == F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.pack.fill(bs))) : List<&2, Bool>}
  %Equal.sym(List<&2, Bool>, F.c842.fmt.pad(bs, 0n), F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.pack.fill.go(bs, 0n))), pad_cat(bs, 0n)) : {F.c842.fmt.cat(_, F.c842.fmt.zeros(F.c842.fmt.gfill(F.c842.fmt.pad(bs, 0n)))) == F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.pack.fill(bs))) : List<&2, Bool>}
  %Equal.sym(List<&2, Bool>, F.c842.fmt.cat(F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.pack.fill.go(bs, 0n))), F.c842.fmt.zeros(F.c842.fmt.gfill(F.c842.fmt.pad(bs, 0n)))), F.c842.fmt.cat(bs, F.c842.fmt.cat(F.c842.fmt.zeros(F.c842.pack.fill.go(bs, 0n)), F.c842.fmt.zeros(F.c842.fmt.gfill(F.c842.fmt.pad(bs, 0n))))), cat_assoc(bs, F.c842.fmt.zeros(F.c842.pack.fill.go(bs, 0n)), F.c842.fmt.zeros(F.c842.fmt.gfill(F.c842.fmt.pad(bs, 0n))))) : {_ == F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.pack.fill(bs))) : List<&2, Bool>}
  %Equal.sym(List<&2, Bool>, F.c842.fmt.cat(F.c842.fmt.zeros(F.c842.pack.fill.go(bs, 0n)), F.c842.fmt.zeros(F.c842.fmt.gfill(F.c842.fmt.pad(bs, 0n)))), F.c842.fmt.zeros(Nat.add(F.c842.pack.fill.go(bs, 0n), F.c842.fmt.gfill(F.c842.fmt.pad(bs, 0n)))), zeros_add(F.c842.pack.fill.go(bs, 0n), F.c842.fmt.gfill(F.c842.fmt.pad(bs, 0n)))) : {F.c842.fmt.cat(bs, _) == F.c842.fmt.cat(bs, F.c842.fmt.zeros(F.c842.pack.fill(bs))) : List<&2, Bool>}
  {==}

# Words and bytes through their bits
# generated by gen/proof_lemmas.py (words)
# rebyte(x) is B.byte(x): both read x's low 8 bits
def rebyte_byte(+x: U32) -> {Bi.c842.rebyte(x) == B.byte(x) : U32}:
  match x:
    case U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, hi}}}}}}}}}:
      {==}

# reword(x) is x: all 32 bits
def reword_id(+x: U32) -> {Bi.c842.reword(x) == x : U32}:
  match x:
    case U32{WCon{c0, WCon{c1, WCon{c2, WCon{c3, WCon{c4, WCon{c5, WCon{c6, WCon{c7, WCon{c8, WCon{c9, WCon{c10, WCon{c11, WCon{c12, WCon{c13, WCon{c14, WCon{c15, WCon{c16, WCon{c17, WCon{c18, WCon{c19, WCon{c20, WCon{c21, WCon{c22, WCon{c23, WCon{c24, WCon{c25, WCon{c26, WCon{c27, WCon{c28, WCon{c29, WCon{c30, WCon{c31, WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      {==}

def weq_refl(+n: Nat, +x: Word(n)) -> {D.c842.dec.weq(n, x, x) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match x:
        case WCon{b, t}:
          match b:
            case True{}:
              weq_refl(p, t)
            case False{}:
              weq_refl(p, t)

def same_refl(+a: U32) -> {D.c842.u32_same(a, a) == True{} : Bool}:
  match a:
    case U32{x}:
      weq_refl(32n, x)

# The decoder: a finished or failed decoder takes no more bits

def absorb_fin(+bs: List<&2, Bool>, +p: F.C842Parser, +o: B.Octets) -> {D.c842.dec.go(bs, D.C842Dec{p, D.C842Finished{o}}) == D.C842Dec{p, D.C842Finished{o}} : D.C842Dec}:
  match bs:
    case Nil{}:
      {==}
    case Con{h, t}:
      absorb_fin(t, p, o)

def absorb_fail(+bs: List<&2, Bool>, +p: F.C842Parser, +e: E.C842Error) -> {D.c842.dec.go(bs, D.C842Dec{p, D.C842Failed{e}}) == D.C842Dec{p, D.C842Failed{e}} : D.C842Dec}:
  match bs:
    case Nil{}:
      {==}
    case Con{h, t}:
      absorb_fail(t, p, e)

# The literal stream

# the bytes as the decoder reads them back
def mrb(+xs: List<&2, U32>) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{x, t}:
      Con{Bi.c842.rebyte(x), mrb(t)}

def mrb_mask(+xs: List<&2, U32>) -> {mrb(xs) == B.mask(xs) : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      %mrb_mask(t) : {Con{Bi.c842.rebyte(x), mrb(t)} == Con{B.byte(x), _} : List<&2, U32>}
      %rebyte_byte(x) : {Con{Bi.c842.rebyte(x), mrb(t)} == Con{_, mrb(t)} : List<&2, U32>}
      {==}

def of_mask(+o: B.Octets) -> {B.Octets.of_list(B.mask(B.Octets.to_list(o))) == o : B.Octets}:
  %BL.octets_to_of(B.Octets.to_list(o)) : {B.Octets.of_list(_) == o : B.Octets}
  %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(o)), o, BL.octets_of_to(o)) : {B.Octets.of_list(B.Octets.to_list(_)) == o : B.Octets}
  BL.octets_of_to(o)

# the parser after the CRC
def endp() -> F.C842Parser:
  F.c842.parse.want(F.C842WEnd{}, 1n)

# pushing the bytes, then the end: only the output list matters
def end_pushes(+c: U32, +xs: List<&2, U32>, +acc: List<&2, U32>, +n: U32, +w: W.C842Win, +k: Nat) -> {D.c842.dec.end(c, D.c842.dec.pushes(mrb(xs), D.C842Going{acc, n, w, Nat.add(List.length(&2, U32, xs), k)})) == D.c842.dec.end.out(c, B.Octets.of_list(B.rev(B.rev_onto(mrb(xs), acc)))) : D.C842Run}:
  match xs:
    case Nil{}:
      {==}
    case Con{x, t}:
      end_pushes(c, t, Con{Bi.c842.rebyte(x), acc}, U32.add(n, 1), W.c842.win.put(w, n, Bi.c842.rebyte(x)), k)

# the decoder over the literal stream's bits, then anything: it pushes every
# byte, then reaches the end with the stream's CRC (read back from its bits)
def lit_main(+xs: List<&2, U32>, +c: U32, +r: List<&2, Bool>, +acc: List<&2, U32>, +n: U32, +w: W.C842Win, +k: Nat) -> {D.c842.dec.go(F.c842.fmt.cat(F.c842.serialise(C.c842.enc.lits(xs, c)), r), D.C842Dec{F.C842Parser.start(), D.C842Going{acc, n, w, Nat.add(List.length(&2, U32, xs), k)}}) == D.c842.dec.go(r, D.C842Dec{endp(), D.c842.dec.end(Bi.c842.reword(c), D.c842.dec.pushes(mrb(xs), D.C842Going{acc, n, w, Nat.add(List.length(&2, U32, xs), k)}))}) : D.C842Dec}:
# generated by gen/proof_lemmas.py (chunks)
  match xs:
    case Nil{}:
      {==}
    case Con{b0, t1}:
      match t1:
        case Nil{}:
          {==}
        case Con{b1, t2}:
          match t2:
            case Nil{}:
              {==}
            case Con{b2, t3}:
              match t3:
                case Nil{}:
                  {==}
                case Con{b3, t4}:
                  match t4:
                    case Nil{}:
                      {==}
                    case Con{b4, t5}:
                      match t5:
                        case Nil{}:
                          {==}
                        case Con{b5, t6}:
                          match t6:
                            case Nil{}:
                              {==}
                            case Con{b6, t7}:
                              match t7:
                                case Nil{}:
                                  {==}
                                case Con{b7, t8}:
                                  lit_main(t8, c, r, Con{Bi.c842.rebyte(b7), Con{Bi.c842.rebyte(b6), Con{Bi.c842.rebyte(b5), Con{Bi.c842.rebyte(b4), Con{Bi.c842.rebyte(b3), Con{Bi.c842.rebyte(b2), Con{Bi.c842.rebyte(b1), Con{Bi.c842.rebyte(b0), acc}}}}}}}}, U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(n, 1), 1), 1), 1), 1), 1), 1), 1), W.c842.win.put(W.c842.win.put(W.c842.win.put(W.c842.win.put(W.c842.win.put(W.c842.win.put(W.c842.win.put(W.c842.win.put(w, n, Bi.c842.rebyte(b0)), U32.add(n, 1), Bi.c842.rebyte(b1)), U32.add(U32.add(n, 1), 1), Bi.c842.rebyte(b2)), U32.add(U32.add(U32.add(n, 1), 1), 1), Bi.c842.rebyte(b3)), U32.add(U32.add(U32.add(U32.add(n, 1), 1), 1), 1), Bi.c842.rebyte(b4)), U32.add(U32.add(U32.add(U32.add(U32.add(n, 1), 1), 1), 1), 1), Bi.c842.rebyte(b5)), U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(n, 1), 1), 1), 1), 1), 1), Bi.c842.rebyte(b6)), U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(U32.add(n, 1), 1), 1), 1), 1), 1), 1), Bi.c842.rebyte(b7)), k)

# the end, with the right CRC: finished, whatever follows
def fin_ok(+o: B.Octets, +z: List<&2, Bool>) -> {D.c842.dec.result(D.c842.dec.go(z, D.C842Dec{endp(), D.c842.dec.end.out(Bi.c842.reword(K.c842.crc(o)), o)})) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}:
  %Equal.sym(U32, Bi.c842.reword(K.c842.crc(o)), K.c842.crc(o), reword_id(K.c842.crc(o))) : {D.c842.dec.result(D.c842.dec.go(z, D.C842Dec{endp(), D.c842.dec.end.out(_, o)})) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  %Equal.sym(Bool, D.c842.u32_same(K.c842.crc(o), K.c842.crc(o)), True{}, same_refl(K.c842.crc(o))) : {D.c842.dec.result(D.c842.dec.go(z, D.C842Dec{endp(), D.c842.dec.end.at(_, o)})) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  %Equal.sym(D.C842Dec, D.c842.dec.go(z, D.C842Dec{endp(), D.C842Finished{o}}), D.C842Dec{endp(), D.C842Finished{o}}, absorb_fin(z, endp(), o)) : {D.c842.dec.result(_) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  {==}

# the literal stream decodes, then anything after it is ignored
def lit_round(+o: B.Octets, +k: Nat, +z: List<&2, Bool>) -> {D.c842.dec.result(D.c842.dec.go(F.c842.fmt.cat(C.c842.literal_bits(o), z), D.c842.dec.start(Nat.add(B.Octets.len(o), k)))) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}:
  %Equal.sym(Nat, B.Octets.len(o), B.len(B.Octets.to_list(o)), BL.octets_len_list(o)) : {D.c842.dec.result(D.c842.dec.go(F.c842.fmt.cat(C.c842.literal_bits(o), z), D.c842.dec.start(Nat.add(_, k)))) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  %Equal.sym(D.C842Dec, D.c842.dec.go(F.c842.fmt.cat(F.c842.serialise(C.c842.enc.lits(B.Octets.to_list(o), K.c842.crc(o))), z), D.C842Dec{F.C842Parser.start(), D.C842Going{Nil{}, 0, W.c842.win.empty(), Nat.add(List.length(&2, U32, B.Octets.to_list(o)), k)}}), D.c842.dec.go(z, D.C842Dec{endp(), D.c842.dec.end(Bi.c842.reword(K.c842.crc(o)), D.c842.dec.pushes(mrb(B.Octets.to_list(o)), D.C842Going{Nil{}, 0, W.c842.win.empty(), Nat.add(List.length(&2, U32, B.Octets.to_list(o)), k)}))}), lit_main(B.Octets.to_list(o), K.c842.crc(o), z, Nil{}, 0, W.c842.win.empty(), k)) : {D.c842.dec.result(_) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  %Equal.sym(D.C842Run, D.c842.dec.end(Bi.c842.reword(K.c842.crc(o)), D.c842.dec.pushes(mrb(B.Octets.to_list(o)), D.C842Going{Nil{}, 0, W.c842.win.empty(), Nat.add(List.length(&2, U32, B.Octets.to_list(o)), k)})), D.c842.dec.end.out(Bi.c842.reword(K.c842.crc(o)), B.Octets.of_list(B.rev(B.rev_onto(mrb(B.Octets.to_list(o)), Nil{})))), end_pushes(Bi.c842.reword(K.c842.crc(o)), B.Octets.to_list(o), Nil{}, 0, W.c842.win.empty(), k)) : {D.c842.dec.result(D.c842.dec.go(z, D.C842Dec{endp(), _})) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  %Equal.sym(List<&2, U32>, B.rev(B.rev(mrb(B.Octets.to_list(o)))), mrb(B.Octets.to_list(o)), BL.rev_rev(mrb(B.Octets.to_list(o)))) : {D.c842.dec.result(D.c842.dec.go(z, D.C842Dec{endp(), D.c842.dec.end.out(Bi.c842.reword(K.c842.crc(o)), B.Octets.of_list(_))})) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  %Equal.sym(List<&2, U32>, mrb(B.Octets.to_list(o)), B.mask(B.Octets.to_list(o)), mrb_mask(B.Octets.to_list(o))) : {D.c842.dec.result(D.c842.dec.go(z, D.C842Dec{endp(), D.c842.dec.end.out(Bi.c842.reword(K.c842.crc(o)), B.Octets.of_list(_))})) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  %Equal.sym(B.Octets, B.Octets.of_list(B.mask(B.Octets.to_list(o))), o, of_mask(o)) : {D.c842.dec.result(D.c842.dec.go(z, D.C842Dec{endp(), D.c842.dec.end.out(Bi.c842.reword(K.c842.crc(o)), _)})) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  fin_ok(o, z)

def Laws.literals_round_trip(o, k):
  %Equal.sym(List<&2, Bool>, F.c842.unpack(F.c842.pack(C.c842.literal_bits(o))), F.c842.fmt.cat(C.c842.literal_bits(o), F.c842.fmt.zeros(F.c842.pack.fill(C.c842.literal_bits(o)))), Laws.pack_round_trip(C.c842.literal_bits(o))) : {D.c842.dec.result(D.c842.dec.go(_, D.c842.dec.start(Nat.add(B.Octets.len(o), k)))) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  lit_round(o, k, F.c842.fmt.zeros(F.c842.pack.fill(C.c842.literal_bits(o))))

# The compressor's check

def and_l(+x: Bool, +y: Bool, e: {Bool.and(x, y) == True{} : Bool}) -> {x == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      absurd({False{} == True{} : Bool}, false_not_true(e))

def and_r(+x: Bool, +y: Bool, e: {Bool.and(x, y) == True{} : Bool}) -> {y == True{} : Bool}:
  match x:
    case True{}:
      e
    case False{}:
      absurd({y == True{} : Bool}, false_not_true(e))

def weq_sound(+n: Nat, +x: Word(n), +y: Word(n), e: {D.c842.dec.weq(n, x, y) == True{} : Bool}) -> {x == y : Word(n)}:
  match n:
    case 0n:
      match x:
        case WNil{}:
          match y:
            case WNil{}:
              {==}
    case 1n+p:
      match x:
        case WCon{a, s}:
          match a:
            case True{}:
              match y:
                case WCon{b, t}:
                  match b:
                    case True{}:
                      %weq_sound(p, s, t, e) : {WCon{True{}, s} == WCon{True{}, _} : Word(1n+p)}
                      {==}
                    case False{}:
                      absurd({WCon{True{}, s} == WCon{False{}, t} : Word(1n+p)}, false_not_true(e))
            case False{}:
              match y:
                case WCon{b, t}:
                  match b:
                    case True{}:
                      absurd({WCon{False{}, s} == WCon{True{}, t} : Word(1n+p)}, false_not_true(e))
                    case False{}:
                      %weq_sound(p, s, t, e) : {WCon{False{}, s} == WCon{False{}, _} : Word(1n+p)}
                      {==}

def same_sound(+a: U32, +b: U32, e: {D.c842.u32_same(a, b) == True{} : Bool}) -> {a == b : U32}:
  match a b:
    case U32{x} U32{y}:
      %weq_sound(32n, x, y, e) : {U32{x} == U32{_} : U32}
      {==}

# a comparison that has gone wrong stays wrong
def same_false(+xs: List<&2, U32>, +ys: List<&2, U32>) -> {C.c842.enc.same.go(xs, ys, False{}) == False{} : Bool}:
  match xs ys:
    case Nil{} Nil{}:
      {==}
    case Con{a, s} Con{b, t}:
      same_false(s, t)
    case Nil{} Con{b, t}:
      {==}
    case Con{a, s} Nil{}:
      {==}

def same_ok(+xs: List<&2, U32>, +ys: List<&2, U32>, +ok: Bool, e: {C.c842.enc.same.go(xs, ys, ok) == True{} : Bool}) -> {ok == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      %same_false(xs, ys) : {_ == True{} : Bool}
      e

def same_list(+xs: List<&2, U32>, +ys: List<&2, U32>, +ok: Bool, +e: {C.c842.enc.same.go(xs, ys, ok) == True{} : Bool}) -> {xs == ys : List<&2, U32>}:
  match xs ys:
    case Nil{} Nil{}:
      {==}
    case Con{a, s} Con{b, t}:
      +u = same_ok(s, t, Bool.and(ok, D.c842.u32_same(a, b)), e)
      %same_sound(a, b, and_r(ok, D.c842.u32_same(a, b), u)) : {Con{a, s} == Con{_, t} : List<&2, U32>}
      %same_list(s, t, Bool.and(ok, D.c842.u32_same(a, b)), e) : {Con{a, s} == Con{a, _} : List<&2, U32>}
      {==}
    case Nil{} Con{b, t}:
      absurd({Nil{} == Con{b, t} : List<&2, U32>}, false_not_true(e))
    case Con{a, s} Nil{}:
      absurd({Con{a, s} == Nil{} : List<&2, U32>}, false_not_true(e))

def ok_sound(+r: Result<&2, &2, E.C842Error, B.Octets>, +o: B.Octets, e: {C.c842.enc.ok(r, o) == True{} : Bool}) -> {r == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}:
  match r:
    case Fail{x}:
      absurd({Fail{x} == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}, false_not_true(e))
    case Done{x}:
      +h = same_list(B.Octets.to_list(x), B.Octets.to_list(o), True{}, e)
      %BL.octets_of_to(x) : {Done{_} == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
      %Equal.sym(List<&2, U32>, B.Octets.to_list(x), B.Octets.to_list(o), h) : {Done{B.Octets.of_list(_)} == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
      %Equal.sym(B.Octets, B.Octets.of_list(B.Octets.to_list(o)), o, BL.octets_of_to(o)) : {Done{_} == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
      {==}

def lit_round0(+o: B.Octets) -> {D.c842.decompress(C.c842.literals(o), B.Octets.len(o)) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}:
  %UL.nat_add_zero(B.Octets.len(o)) : {D.c842.decompress(C.c842.literals(o), _) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}
  Laws.literals_round_trip(o, 0n)

# the check's answer b: the encoder's bits if b, else the literal stream's
def check_ok(+b: Bool, +m: List<&2, Bool>, +o: B.Octets, e: {Bool.and(Nat.is_le(List.length(&2, Bool, m), F.c842.worst_bits(B.Octets.len(o))), C.c842.enc.ok(D.c842.decompress(F.c842.pack(m), B.Octets.len(o)), o)) == b : Bool}) -> {D.c842.decompress(F.c842.pack(C.c842.enc.pick(b, m, o)), B.Octets.len(o)) == Done{o} : Result<&2, &2, E.C842Error, B.Octets>}:
  match b:
    case True{}:
      ok_sound(D.c842.decompress(F.c842.pack(m), B.Octets.len(o)), o, and_r(Nat.is_le(List.length(&2, Bool, m), F.c842.worst_bits(B.Octets.len(o))), C.c842.enc.ok(D.c842.decompress(F.c842.pack(m), B.Octets.len(o)), o), e))
    case False{}:
      lit_round0(o)

def Laws.compress_round_trip(opts, o):
  check_ok(Bool.and(Nat.is_le(List.length(&2, Bool, C.c842.compress_bits_unchecked(opts, o)), F.c842.worst_bits(B.Octets.len(o))), C.c842.enc.ok(D.c842.decompress(F.c842.pack(C.c842.compress_bits_unchecked(opts, o)), B.Octets.len(o)), o)), C.c842.compress_bits_unchecked(opts, o), o, {==})

# The worst case

def lit_len(+xs: List<&2, U32>, +c: U32) -> {List.length(&2, Bool, F.c842.serialise(C.c842.enc.lits(xs, c))) == F.c842.worst_bits(List.length(&2, U32, xs)) : Nat}:
# generated by gen/proof_lemmas.py (lens)
  match xs:
    case Nil{}:
      {==}
    case Con{b0, t1}:
      match t1:
        case Nil{}:
          {==}
        case Con{b1, t2}:
          match t2:
            case Nil{}:
              {==}
            case Con{b2, t3}:
              match t3:
                case Nil{}:
                  {==}
                case Con{b3, t4}:
                  match t4:
                    case Nil{}:
                      {==}
                    case Con{b4, t5}:
                      match t5:
                        case Nil{}:
                          {==}
                        case Con{b5, t6}:
                          match t6:
                            case Nil{}:
                              {==}
                            case Con{b6, t7}:
                              match t7:
                                case Nil{}:
                                  {==}
                                case Con{b7, t8}:
                                  %lit_len(t8, c) : {List.length(&2, Bool, F.c842.serialise(C.c842.enc.lits(Con{b0, Con{b1, Con{b2, Con{b3, Con{b4, Con{b5, Con{b6, Con{b7, t8}}}}}}}}, c))) == Nat.add(69n, _) : Nat}
                                  {==}


def Laws.literal_bits_worst(o):
  %Equal.sym(Nat, B.Octets.len(o), B.len(B.Octets.to_list(o)), BL.octets_len_list(o)) : {List.length(&2, Bool, C.c842.literal_bits(o)) == F.c842.worst_bits(_) : Nat}
  lit_len(B.Octets.to_list(o), K.c842.crc(o))

def within_ok(+b: Bool, +m: List<&2, Bool>, +o: B.Octets, +okv: Bool, e: {Bool.and(Nat.is_le(List.length(&2, Bool, m), F.c842.worst_bits(B.Octets.len(o))), okv) == b : Bool}) -> {Nat.is_le(List.length(&2, Bool, C.c842.enc.pick(b, m, o)), F.c842.worst_bits(B.Octets.len(o))) == True{} : Bool}:
  match b:
    case True{}:
      and_l(Nat.is_le(List.length(&2, Bool, m), F.c842.worst_bits(B.Octets.len(o))), okv, e)
    case False{}:
      %Laws.literal_bits_worst(o) : {Nat.is_le(List.length(&2, Bool, C.c842.literal_bits(o)), _) == True{} : Bool}
      UL.nat_le_refl(List.length(&2, Bool, C.c842.literal_bits(o)))

def Laws.compress_within_worst(opts, o):
  within_ok(Bool.and(Nat.is_le(List.length(&2, Bool, C.c842.compress_bits_unchecked(opts, o)), F.c842.worst_bits(B.Octets.len(o))), C.c842.enc.ok(D.c842.decompress(F.c842.pack(C.c842.compress_bits_unchecked(opts, o)), B.Octets.len(o)), o)), C.c842.compress_bits_unchecked(opts, o), o, C.c842.enc.ok(D.c842.decompress(F.c842.pack(C.c842.compress_bits_unchecked(opts, o)), B.Octets.len(o)), o), {==})

