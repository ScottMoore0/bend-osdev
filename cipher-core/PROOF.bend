# Feistel rounds over any round function (cipher-core.bend's lc.fe, for
# CAST-128 and FCrypt): a round is undone whatever f is, so a list of rounds
# is undone by its rounds undone in reverse order

def fe_unstep_step(~RK: Data, ~f: RK -> U32 -> U32, +k: RK, b: L.LcBlock64) -> {b == L.lc.fe.unstep(~RK, ~f, k, L.lc.fe.step(~RK, ~f, k, b)) : L.LcBlock64}:
  match b:
    case L.LcBlock64{l, +r}:
      %u32_xx(l, f(k, r)) : {L.LcBlock64{l, r} == L.LcBlock64{_, r} : L.LcBlock64}
      {==}

def fe_step_unstep(~RK: Data, ~f: RK -> U32 -> U32, +k: RK, b: L.LcBlock64) -> {b == L.lc.fe.step(~RK, ~f, k, L.lc.fe.unstep(~RK, ~f, k, b)) : L.LcBlock64}:
  match b:
    case L.LcBlock64{+l, r}:
      %u32_xx(r, f(k, l)) : {L.LcBlock64{l, r} == L.LcBlock64{l, _} : L.LcBlock64}
      {==}

def fe_unrun_run(~RK: Data, ~f: RK -> U32 -> U32, ks: List<&2, RK>, +b: L.LcBlock64) -> {b == L.lc.fe.unrun(~RK, ~f, ks, L.lc.fe.run(~RK, ~f, ks, b)) : L.LcBlock64}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +t}:
      %fe_unrun_run(~RK, ~f, t, L.lc.fe.step(~RK, ~f, k, b)) : {b == L.lc.fe.unstep(~RK, ~f, k, _) : L.LcBlock64}
      fe_unstep_step(~RK, ~f, k, b)

def fe_run_unrun(~RK: Data, ~f: RK -> U32 -> U32, ks: List<&2, RK>, +b: L.LcBlock64) -> {b == L.lc.fe.run(~RK, ~f, ks, L.lc.fe.unrun(~RK, ~f, ks, b)) : L.LcBlock64}:
  match ks:
    case Nil{}:
      {==}
    case Con{+k, +t}:
      %fe_step_unstep(~RK, ~f, k, L.lc.fe.unrun(~RK, ~f, t, b)) : {b == L.lc.fe.run(~RK, ~f, t, _) : L.LcBlock64}
      fe_run_unrun(~RK, ~f, t, b)

# 64-bit blocks as bytes (blk_bytes and blk8 above)

def Laws.block64_octets_round_trip(b):
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.of_list(L.lc.block_bytes(b, Nil{}))), B.mask(L.lc.block_bytes(b, Nil{})), BL.octets_to_of(L.lc.block_bytes(b, Nil{}))) : {L.lc.block_of(_) == Some{b} : Maybe<&2, L.LcBlock64>}
  blk_bytes(b)


# a block read from 8 bytes is written back as those bytes (on their bits,
# and then off a list of any length)
def b64.mget(m: Maybe<&2, L.LcBlock64>, +d: L.LcBlock64) -> L.LcBlock64:
  match m:
    case Some{b}:
      b
    case None{}:
      d

def b64.mdisc(m: Maybe<&2, L.LcBlock64>) -> Type:
  match m:
    case Some{b}:
      Empty
    case None{}:
      Unit

def b64.nsome(+bl: L.LcBlock64, h: {None{} == Some{bl} : Maybe<&2, L.LcBlock64>}) -> Empty:
  %h : b64.mdisc(_)
  Unit{}

# a block's bytes read from 8 bytes are those bytes (on their bits)
