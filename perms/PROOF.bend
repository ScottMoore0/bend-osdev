# the class is the owner's when the owner test passes
def cls.owner(+o: Bool, +g: Bool) -> {o == True{} : Bool} -> {P.Perms.class.go(o, g) == P.PermsOwner{} : P.PermsClass}:
  match o:
    case True{}:
      h => {==}
    case False{}:
      h => bits.absurd_eq(P.PermsClass, P.Perms.class.go(False{}, g), P.PermsOwner{}, h)

def cls.bits(+o: Bool, +g: Bool, +m: U32, +q: M.PermsRwx) -> {o == True{} : Bool} -> {P.Perms.mode_check(o, g, m, q) == M.PermsRwx.covers(M.Mode.owner(m), q) : Bool}:
  match o:
    case True{}:
      h => {==}
    case False{}:
      h => bits.absurd_eq(Bool, P.Perms.mode_check(False{}, g, m, q), M.PermsRwx.covers(M.Mode.owner(m), q), h)

def acl.owner(+o: Bool, +u: Maybe<&2, M.PermsRwx>, +gm: Bool, +ga: Bool, +q: M.PermsRwx, +uo: M.PermsRwx, +go: M.PermsRwx, +mk: Maybe<&2, M.PermsRwx>, +ot: M.PermsRwx) -> {o == True{} : Bool} -> {A.PermsAcl.decide(o, u, gm, ga, q, uo, go, mk, ot) == M.PermsRwx.covers(uo, q) : Bool}:
  match o:
    case True{}:
      h => {==}
    case False{}:
      h => bits.absurd_eq(Bool, A.PermsAcl.decide(False{}, u, gm, ga, q, uo, go, mk, ot), M.PermsRwx.covers(uo, q), h)

# with no named entries and no mask, acl(5)'s algorithm is the mode check
def acl.minimal(+o: Bool, +g: Bool, +ga: Bool, +q: M.PermsRwx, +m: U32) -> {A.PermsAcl.decide(o, None{}, g, ga, q, M.Mode.owner(m), M.Mode.group(m), None{}, M.Mode.other(m)) == P.Perms.mode_check(o, g, m, q) : Bool}:
  match o g:
    case True{} g:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def acl.mask(+o: Bool, +u: Maybe<&2, M.PermsRwx>, +g: Bool, +ga: Bool, +q: M.PermsRwx, +uo: M.PermsRwx, +go: M.PermsRwx, +m: M.PermsRwx, +ot: M.PermsRwx) -> {Bool.or(Bool.not(A.PermsAcl.decide(o, u, g, ga, q, uo, go, Some{m}, ot)), A.PermsAcl.decide(o, u, g, ga, q, uo, go, Some{M.PermsRwx.all()}, ot)) == True{} : Bool}:
