# The checks branch on a few decisions (is the process the owner, in the
# group, named by an entry), each a Bool computed from the inputs. Each law
# is proved by a lemma over those Bools, given as parameters and matched,
# with hypotheses about them taken after the match ("convoy" style) so that
# matching refines them too; the law passes the lemma the decisions the
# check computes. The umask law is proved bit by bit, by induction on the
# width of the word.

# Contradictions

def bits.disc(+b: Bool) -> Type:
  match b:
    case False{}:
      Unit
    case True{}:
      Empty

def bits.disc2(+b: Bool) -> Type:
  match b:
    case False{}:
      Empty
    case True{}:
      Unit

def bits.ft(+e: {False{} == True{} : Bool}) -> bits.disc(True{}):
  %e : bits.disc(_)
  Unit{}

def bits.tf(+e: {True{} == False{} : Bool}) -> bits.disc2(False{}):
  %e : bits.disc2(_)
  Unit{}

def bits.absurd_eq(-T: Type, -x: T, -y: T, +e: {False{} == True{} : Bool}) -> {x == y : T}:
  Empty.absurd({x == y : T}, bits.ft(e))

def bits.absurd_tf(-T: Type, -x: T, -y: T, +e: {True{} == False{} : Bool}) -> {x == y : T}:
  Empty.absurd({x == y : T}, bits.tf(e))

def w32(+a: U32) -> Word(32n):
  match a:
    case U32{w}:
      w

# Implications, as not(a) or b

def imp.refl(+x: Bool) -> {Bool.or(Bool.not(x), x) == True{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      {==}

def imp.and_r(+a: Bool, +b: Bool) -> {Bool.or(Bool.not(Bool.and(a, b)), b) == True{} : Bool}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} b:
      {==}

# (a and b) implies (a and c), when c holds
def imp.and_top(+a: Bool, +b: Bool, +c: Bool) -> {c == True{} : Bool} -> {Bool.or(Bool.not(Bool.and(a, b)), Bool.and(a, c)) == True{} : Bool}:
  match a b c:
    case a b False{}:
      h => bits.absurd_eq(Bool, Bool.or(Bool.not(Bool.and(a, b)), Bool.and(a, False{})), True{}, h)
    case True{} True{} True{}:
      h => {==}
    case True{} False{} True{}:
      h => {==}
    case False{} b True{}:
      h => {==}

# (a and b) implies (c and b), when c holds
def imp.top_and(+a: Bool, +b: Bool, +c: Bool) -> {c == True{} : Bool} -> {Bool.or(Bool.not(Bool.and(a, b)), Bool.and(c, b)) == True{} : Bool}:
  match a b c:
    case a b False{}:
      h => bits.absurd_eq(Bool, Bool.or(Bool.not(Bool.and(a, b)), Bool.and(False{}, b)), True{}, h)
    case True{} True{} True{}:
      h => {==}
    case True{} False{} True{}:
      h => {==}
    case False{} b True{}:
      h => {==}

# rwx contains every request
def rwx.covers_all(+q: M.PermsRwx) -> {M.PermsRwx.covers(M.PermsRwx.all(), q) == True{} : Bool}:
  match q:
# BEGIN GENERATED by gen/proof.py: covers_all
    case M.PermsRwx{True{}, True{}, True{}}:
      {==}
    case M.PermsRwx{True{}, True{}, False{}}:
      {==}
    case M.PermsRwx{True{}, False{}, True{}}:
      {==}
    case M.PermsRwx{True{}, False{}, False{}}:
      {==}
    case M.PermsRwx{False{}, True{}, True{}}:
      {==}
    case M.PermsRwx{False{}, True{}, False{}}:
      {==}
    case M.PermsRwx{False{}, False{}, True{}}:
      {==}
    case M.PermsRwx{False{}, False{}, False{}}:
      {==}
# END GENERATED: covers_all

