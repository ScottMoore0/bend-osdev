      imp.and_top(M.PermsRwx.covers(up, q), M.PermsRwx.covers(m, q), M.PermsRwx.covers(M.PermsRwx.all(), q))(rwx.covers_all(q))
    case False{} None{} True{}:
      imp.top_and(M.PermsRwx.covers(m, q), ga, M.PermsRwx.covers(M.PermsRwx.all(), q))(rwx.covers_all(q))
    case False{} None{} False{}:
      imp.refl(M.PermsRwx.covers(ot, q))

# an empty request is granted
def cls.empty(+o: Bool, +g: Bool, +m: U32) -> {P.Perms.mode_check(o, g, m, M.PermsRwx{False{}, False{}, False{}}) == True{} : Bool}:
  match o g:
    case True{} g:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

# execute, on a mode with no execute bit, is refused in every class
def cls.noexec(+o: Bool, +g: Bool, +w0: Bool, +r0: Bool, +w1: Bool, +r1: Bool, +w2: Bool, +r2: Bool, +rest: Word(23n)) -> {P.Perms.mode_check(o, g, U32{WCon{False{}, WCon{w0, WCon{r0, WCon{False{}, WCon{w1, WCon{r1, WCon{False{}, WCon{w2, WCon{r2, rest}}}}}}}}}}, M.PermsRwx{False{}, False{}, True{}}) == False{} : Bool}:
  match o g:
    case True{} g:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def del.not_sticky(+st: Bool, +of: Bool, +od: Bool, +fo: Bool, +acc: Bool) -> {st == False{} : Bool} -> {Bool.and(S.Perms.sticky_ok(st, of, od, fo), acc) == acc : Bool}:
  match st:
    case False{}:
      h => {==}
    case True{}:
      h => bits.absurd_tf(Bool, Bool.and(S.Perms.sticky_ok(True{}, of, od, fo), acc), acc, h)

def del.owner(+st: Bool, +of: Bool, +od: Bool, +fo: Bool, +acc: Bool) -> {of == True{} : Bool} -> {Bool.and(S.Perms.sticky_ok(st, of, od, fo), acc) == acc : Bool}:
  match st of:
    case False{} of:
      h => {==}
    case True{} True{}:
      h => {==}
    case True{} False{}:
      h => bits.absurd_eq(Bool, Bool.and(S.Perms.sticky_ok(True{}, False{}, od, fo), acc), acc, h)

