# Relocations: ELF32_R_INFO, for every symbol and type. The words are
# split into their 32 bits, so the shifts and masks compute on symbolic
# bits. The type comes back as the low 8 bits of the type. The symbol comes
# back as its low 24 bits, but the shift right leaves each of them as
# Bool.or(s, False) (Bool.or matches its first argument), so 24 rewrites by
# ri.or_false turn the expected word into the computed one.

def ri.or_false(b: Bool) -> {Bool.or(b, False{}) == b : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

