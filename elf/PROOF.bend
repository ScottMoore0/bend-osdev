def hdr_list(h: H.ElfHeader, r: List<&2, U32>) -> {H.ElfHeader.parse.list(H.ElfOptions.default(), B.append(B.Octets.to_list(H.ElfHeader.write(h)), r)) == Done{H.ElfHeader.normal(h)} : Result<&2, &2, F.ElfError, H.ElfHeader>}:
  match h:
    case H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, +f7, +f8, +f9, f10, f11, f12, f13, f14, f15, f16}:
      %WL.parts_of(f7) : {H.ElfHeader.parse.list(H.ElfOptions.default(), B.append(B.Octets.to_list(H.ElfHeader.write(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, _, f8, f9, f10, f11, f12, f13, f14, f15, f16})), r)) == Done{H.ElfHeader.normal(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, _, f8, f9, f10, f11, f12, f13, f14, f15, f16})} : Result<&2, &2, F.ElfError, H.ElfHeader>}
      %WL.parts_of(f8) : {H.ElfHeader.parse.list(H.ElfOptions.default(), B.append(B.Octets.to_list(H.ElfHeader.write(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, W.W64.from_parts(W.W64.hi(f7), W.W64.lo(f7)), _, f9, f10, f11, f12, f13, f14, f15, f16})), r)) == Done{H.ElfHeader.normal(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, W.W64.from_parts(W.W64.hi(f7), W.W64.lo(f7)), _, f9, f10, f11, f12, f13, f14, f15, f16})} : Result<&2, &2, F.ElfError, H.ElfHeader>}
      %WL.parts_of(f9) : {H.ElfHeader.parse.list(H.ElfOptions.default(), B.append(B.Octets.to_list(H.ElfHeader.write(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, W.W64.from_parts(W.W64.hi(f7), W.W64.lo(f7)), W.W64.from_parts(W.W64.hi(f8), W.W64.lo(f8)), _, f10, f11, f12, f13, f14, f15, f16})), r)) == Done{H.ElfHeader.normal(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, W.W64.from_parts(W.W64.hi(f7), W.W64.lo(f7)), W.W64.from_parts(W.W64.hi(f8), W.W64.lo(f8)), _, f10, f11, f12, f13, f14, f15, f16})} : Result<&2, &2, F.ElfError, H.ElfHeader>}
      hdr_bits(f0, f1, f2, f3, f4, f5, f6, W.W64.hi(f7), W.W64.lo(f7), W.W64.hi(f8), W.W64.lo(f8), W.W64.hi(f9), W.W64.lo(f9), f10, f11, f12, f13, f14, f15, f16, r)

def hdr_rt(+h: H.ElfHeader, +rest: B.Octets) -> {H.ElfHeader.parse(B.Octets.append(H.ElfHeader.write(h), rest)) == Done{H.ElfHeader.normal(h)} : Result<&2, &2, F.ElfError, H.ElfHeader>}:
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(H.ElfHeader.write(h), rest)), B.append(B.Octets.to_list(H.ElfHeader.write(h)), B.Octets.to_list(rest)), BL.octets_append_list(H.ElfHeader.write(h), rest)) : {H.ElfHeader.parse.list(H.ElfOptions.default(), _) == Done{H.ElfHeader.normal(h)} : Result<&2, &2, F.ElfError, H.ElfHeader>}
  hdr_list(h, B.Octets.to_list(rest))

def Laws.header_round_trip(h, rest):
  hdr_rt(h, rest)

