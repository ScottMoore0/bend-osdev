      {==}

def versym_drop(big: Bool, x: V.ElfVersym, r: List<&2, U32>) -> {r == B.drop(U32.to_nat(V.ElfVersym.size()), B.append(B.Octets.to_list(V.ElfVersym.write(big, x)), r)) : List<&2, U32>}:
