def shdr_list(is64: Bool, big: Bool, x: S.ElfShdr, r: List<&2, U32>) -> {S.ElfShdr.parse.list(is64, big, B.append(B.Octets.to_list(S.ElfShdr.write(is64, big, x)), r)) == Done{S.ElfShdr.normal(is64, x)} : Result<&2, &2, F.ElfError, S.ElfShdr>}:
  match x:
    case S.ElfShdr{f0, f1, +f2, +f3, +f4, +f5, f6, f7, +f8, +f9}:
      %WL.parts_of(f2) : {S.ElfShdr.parse.list(is64, big, B.append(B.Octets.to_list(S.ElfShdr.write(is64, big, S.ElfShdr{f0, f1, _, f3, f4, f5, f6, f7, f8, f9})), r)) == Done{S.ElfShdr.normal(is64, S.ElfShdr{f0, f1, _, f3, f4, f5, f6, f7, f8, f9})} : Result<&2, &2, F.ElfError, S.ElfShdr>}
      %WL.parts_of(f3) : {S.ElfShdr.parse.list(is64, big, B.append(B.Octets.to_list(S.ElfShdr.write(is64, big, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), _, f4, f5, f6, f7, f8, f9})), r)) == Done{S.ElfShdr.normal(is64, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), _, f4, f5, f6, f7, f8, f9})} : Result<&2, &2, F.ElfError, S.ElfShdr>}
      %WL.parts_of(f4) : {S.ElfShdr.parse.list(is64, big, B.append(B.Octets.to_list(S.ElfShdr.write(is64, big, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), _, f5, f6, f7, f8, f9})), r)) == Done{S.ElfShdr.normal(is64, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), _, f5, f6, f7, f8, f9})} : Result<&2, &2, F.ElfError, S.ElfShdr>}
      %WL.parts_of(f5) : {S.ElfShdr.parse.list(is64, big, B.append(B.Octets.to_list(S.ElfShdr.write(is64, big, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), _, f6, f7, f8, f9})), r)) == Done{S.ElfShdr.normal(is64, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), _, f6, f7, f8, f9})} : Result<&2, &2, F.ElfError, S.ElfShdr>}
      %WL.parts_of(f8) : {S.ElfShdr.parse.list(is64, big, B.append(B.Octets.to_list(S.ElfShdr.write(is64, big, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), W.W64.from_parts(W.W64.hi(f5), W.W64.lo(f5)), f6, f7, _, f9})), r)) == Done{S.ElfShdr.normal(is64, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), W.W64.from_parts(W.W64.hi(f5), W.W64.lo(f5)), f6, f7, _, f9})} : Result<&2, &2, F.ElfError, S.ElfShdr>}
      %WL.parts_of(f9) : {S.ElfShdr.parse.list(is64, big, B.append(B.Octets.to_list(S.ElfShdr.write(is64, big, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), W.W64.from_parts(W.W64.hi(f5), W.W64.lo(f5)), f6, f7, W.W64.from_parts(W.W64.hi(f8), W.W64.lo(f8)), _})), r)) == Done{S.ElfShdr.normal(is64, S.ElfShdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), W.W64.from_parts(W.W64.hi(f5), W.W64.lo(f5)), f6, f7, W.W64.from_parts(W.W64.hi(f8), W.W64.lo(f8)), _})} : Result<&2, &2, F.ElfError, S.ElfShdr>}
      shdr_bits(is64, big, f0, f1, W.W64.hi(f2), W.W64.lo(f2), W.W64.hi(f3), W.W64.lo(f3), W.W64.hi(f4), W.W64.lo(f4), W.W64.hi(f5), W.W64.lo(f5), f6, f7, W.W64.hi(f8), W.W64.lo(f8), W.W64.hi(f9), W.W64.lo(f9), r)

def shdr_rt(+is64: Bool, +big: Bool, +x: S.ElfShdr, +rest: B.Octets) -> {S.ElfShdr.parse(is64, big, B.Octets.append(S.ElfShdr.write(is64, big, x), rest)) == Done{S.ElfShdr.normal(is64, x)} : Result<&2, &2, F.ElfError, S.ElfShdr>}:
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(S.ElfShdr.write(is64, big, x), rest)), B.append(B.Octets.to_list(S.ElfShdr.write(is64, big, x)), B.Octets.to_list(rest)), BL.octets_append_list(S.ElfShdr.write(is64, big, x), rest)) : {S.ElfShdr.parse.list(is64, big, _) == Done{S.ElfShdr.normal(is64, x)} : Result<&2, &2, F.ElfError, S.ElfShdr>}
  shdr_list(is64, big, x, B.Octets.to_list(rest))

def Laws.shdr_round_trip(is64, big, x, rest):
  shdr_rt(is64, big, x, rest)

