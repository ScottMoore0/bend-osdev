def versym_list(big: Bool, x: V.ElfVersym, r: List<&2, U32>) -> {V.ElfVersym.parse.list(big, B.append(B.Octets.to_list(V.ElfVersym.write(big, x)), r)) == Done{V.ElfVersym.normal(x)} : Result<&2, &2, F.ElfError, V.ElfVersym>}:
