def sym_list(is64: Bool, big: Bool, x: Y.ElfSym, r: List<&2, U32>) -> {Y.ElfSym.parse.list(is64, big, B.append(B.Octets.to_list(Y.ElfSym.write(is64, big, x)), r)) == Done{Y.ElfSym.normal(is64, x)} : Result<&2, &2, F.ElfError, Y.ElfSym>}:
  match x:
    case Y.ElfSym{f0, +f1, +f2, f3, f4, f5}:
      %WL.parts_of(f1) : {Y.ElfSym.parse.list(is64, big, B.append(B.Octets.to_list(Y.ElfSym.write(is64, big, Y.ElfSym{f0, _, f2, f3, f4, f5})), r)) == Done{Y.ElfSym.normal(is64, Y.ElfSym{f0, _, f2, f3, f4, f5})} : Result<&2, &2, F.ElfError, Y.ElfSym>}
      %WL.parts_of(f2) : {Y.ElfSym.parse.list(is64, big, B.append(B.Octets.to_list(Y.ElfSym.write(is64, big, Y.ElfSym{f0, W.W64.from_parts(W.W64.hi(f1), W.W64.lo(f1)), _, f3, f4, f5})), r)) == Done{Y.ElfSym.normal(is64, Y.ElfSym{f0, W.W64.from_parts(W.W64.hi(f1), W.W64.lo(f1)), _, f3, f4, f5})} : Result<&2, &2, F.ElfError, Y.ElfSym>}
      sym_bits(is64, big, f0, W.W64.hi(f1), W.W64.lo(f1), W.W64.hi(f2), W.W64.lo(f2), f3, f4, f5, r)

def sym_rt(+is64: Bool, +big: Bool, +x: Y.ElfSym, +rest: B.Octets) -> {Y.ElfSym.parse(is64, big, B.Octets.append(Y.ElfSym.write(is64, big, x), rest)) == Done{Y.ElfSym.normal(is64, x)} : Result<&2, &2, F.ElfError, Y.ElfSym>}:
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(Y.ElfSym.write(is64, big, x), rest)), B.append(B.Octets.to_list(Y.ElfSym.write(is64, big, x)), B.Octets.to_list(rest)), BL.octets_append_list(Y.ElfSym.write(is64, big, x), rest)) : {Y.ElfSym.parse.list(is64, big, _) == Done{Y.ElfSym.normal(is64, x)} : Result<&2, &2, F.ElfError, Y.ElfSym>}
  sym_list(is64, big, x, B.Octets.to_list(rest))

def Laws.sym_round_trip(is64, big, x, rest):
  sym_rt(is64, big, x, rest)

