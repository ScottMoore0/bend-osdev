      +e2 = note_nat_eq(B.Octets.len(desc), U32.to_nat(dz), note_and_r(Nat.is_eq(B.Octets.len(name), U32.to_nat(nz)), Nat.is_eq(B.Octets.len(desc), U32.to_nat(dz)), sz))
