def note_drop_zeros(+n: Nat, +r: List<&2, U32>) -> {r == B.drop(n, B.append(B.zeros(n), r)) : List<&2, U32>}:
  match n:
    case 0n:
      {==}
    case 1n+(+p):
      note_drop_zeros(p, r)

