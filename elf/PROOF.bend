def note_len_zeros(+n: Nat) -> {n == B.len(B.zeros(n)) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+(+p):
      %note_len_zeros(p) : {1n+p == 1n+_ : Nat}
