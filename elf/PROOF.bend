def phdr_list(is64: Bool, big: Bool, x: P.ElfPhdr, r: List<&2, U32>) -> {P.ElfPhdr.parse.list(is64, big, B.append(B.Octets.to_list(P.ElfPhdr.write(is64, big, x)), r)) == Done{P.ElfPhdr.normal(is64, x)} : Result<&2, &2, F.ElfError, P.ElfPhdr>}:
  match x:
    case P.ElfPhdr{f0, f1, +f2, +f3, +f4, +f5, +f6, +f7}:
      %WL.parts_of(f2) : {P.ElfPhdr.parse.list(is64, big, B.append(B.Octets.to_list(P.ElfPhdr.write(is64, big, P.ElfPhdr{f0, f1, _, f3, f4, f5, f6, f7})), r)) == Done{P.ElfPhdr.normal(is64, P.ElfPhdr{f0, f1, _, f3, f4, f5, f6, f7})} : Result<&2, &2, F.ElfError, P.ElfPhdr>}
      %WL.parts_of(f3) : {P.ElfPhdr.parse.list(is64, big, B.append(B.Octets.to_list(P.ElfPhdr.write(is64, big, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), _, f4, f5, f6, f7})), r)) == Done{P.ElfPhdr.normal(is64, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), _, f4, f5, f6, f7})} : Result<&2, &2, F.ElfError, P.ElfPhdr>}
      %WL.parts_of(f4) : {P.ElfPhdr.parse.list(is64, big, B.append(B.Octets.to_list(P.ElfPhdr.write(is64, big, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), _, f5, f6, f7})), r)) == Done{P.ElfPhdr.normal(is64, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), _, f5, f6, f7})} : Result<&2, &2, F.ElfError, P.ElfPhdr>}
      %WL.parts_of(f5) : {P.ElfPhdr.parse.list(is64, big, B.append(B.Octets.to_list(P.ElfPhdr.write(is64, big, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), _, f6, f7})), r)) == Done{P.ElfPhdr.normal(is64, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), _, f6, f7})} : Result<&2, &2, F.ElfError, P.ElfPhdr>}
      %WL.parts_of(f6) : {P.ElfPhdr.parse.list(is64, big, B.append(B.Octets.to_list(P.ElfPhdr.write(is64, big, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), W.W64.from_parts(W.W64.hi(f5), W.W64.lo(f5)), _, f7})), r)) == Done{P.ElfPhdr.normal(is64, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), W.W64.from_parts(W.W64.hi(f5), W.W64.lo(f5)), _, f7})} : Result<&2, &2, F.ElfError, P.ElfPhdr>}
      %WL.parts_of(f7) : {P.ElfPhdr.parse.list(is64, big, B.append(B.Octets.to_list(P.ElfPhdr.write(is64, big, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), W.W64.from_parts(W.W64.hi(f5), W.W64.lo(f5)), W.W64.from_parts(W.W64.hi(f6), W.W64.lo(f6)), _})), r)) == Done{P.ElfPhdr.normal(is64, P.ElfPhdr{f0, f1, W.W64.from_parts(W.W64.hi(f2), W.W64.lo(f2)), W.W64.from_parts(W.W64.hi(f3), W.W64.lo(f3)), W.W64.from_parts(W.W64.hi(f4), W.W64.lo(f4)), W.W64.from_parts(W.W64.hi(f5), W.W64.lo(f5)), W.W64.from_parts(W.W64.hi(f6), W.W64.lo(f6)), _})} : Result<&2, &2, F.ElfError, P.ElfPhdr>}
      phdr_bits(is64, big, f0, f1, W.W64.hi(f2), W.W64.lo(f2), W.W64.hi(f3), W.W64.lo(f3), W.W64.hi(f4), W.W64.lo(f4), W.W64.hi(f5), W.W64.lo(f5), W.W64.hi(f6), W.W64.lo(f6), W.W64.hi(f7), W.W64.lo(f7), r)

def phdr_rt(+is64: Bool, +big: Bool, +x: P.ElfPhdr, +rest: B.Octets) -> {P.ElfPhdr.parse(is64, big, B.Octets.append(P.ElfPhdr.write(is64, big, x), rest)) == Done{P.ElfPhdr.normal(is64, x)} : Result<&2, &2, F.ElfError, P.ElfPhdr>}:
  %Equal.sym(List<&2, U32>, B.Octets.to_list(B.Octets.append(P.ElfPhdr.write(is64, big, x), rest)), B.append(B.Octets.to_list(P.ElfPhdr.write(is64, big, x)), B.Octets.to_list(rest)), BL.octets_append_list(P.ElfPhdr.write(is64, big, x), rest)) : {P.ElfPhdr.parse.list(is64, big, _) == Done{P.ElfPhdr.normal(is64, x)} : Result<&2, &2, F.ElfError, P.ElfPhdr>}
  phdr_list(is64, big, x, B.Octets.to_list(rest))

def Laws.phdr_round_trip(is64, big, x, rest):
  phdr_rt(is64, big, x, rest)

