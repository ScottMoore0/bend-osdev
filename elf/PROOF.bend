def versym_rt(+big: Bool, +x: V.ElfVersym, +rest: B.Octets) -> {V.ElfVersym.parse(big, B.Octets.append(V.ElfVersym.write(big, x), rest)) == Done{V.ElfVersym.normal(x)} : Result<&2, &2, F.ElfError, V.ElfVersym>}:
