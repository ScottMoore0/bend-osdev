def Laws.header_truncated(h):
  match h:
    case H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, +f7, +f8, +f9, f10, f11, f12, f13, f14, f15, f16}:
      %WL.parts_of(f7) : {H.ElfHeader.parse(B.Octets.take(Nat.sub(U32.to_nat(H.ElfHeader.size(H.ElfHeader.is64(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, _, f8, f9, f10, f11, f12, f13, f14, f15, f16}))), 1n), H.ElfHeader.write(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, _, f8, f9, f10, f11, f12, f13, f14, f15, f16}))) == Fail{F.ElfTruncated{}} : Result<&2, &2, F.ElfError, H.ElfHeader>}
      %WL.parts_of(f8) : {H.ElfHeader.parse(B.Octets.take(Nat.sub(U32.to_nat(H.ElfHeader.size(H.ElfHeader.is64(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, W.W64.from_parts(W.W64.hi(f7), W.W64.lo(f7)), _, f9, f10, f11, f12, f13, f14, f15, f16}))), 1n), H.ElfHeader.write(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, W.W64.from_parts(W.W64.hi(f7), W.W64.lo(f7)), _, f9, f10, f11, f12, f13, f14, f15, f16}))) == Fail{F.ElfTruncated{}} : Result<&2, &2, F.ElfError, H.ElfHeader>}
      %WL.parts_of(f9) : {H.ElfHeader.parse(B.Octets.take(Nat.sub(U32.to_nat(H.ElfHeader.size(H.ElfHeader.is64(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, W.W64.from_parts(W.W64.hi(f7), W.W64.lo(f7)), W.W64.from_parts(W.W64.hi(f8), W.W64.lo(f8)), _, f10, f11, f12, f13, f14, f15, f16}))), 1n), H.ElfHeader.write(H.ElfHeader{f0, f1, f2, f3, f4, f5, f6, W.W64.from_parts(W.W64.hi(f7), W.W64.lo(f7)), W.W64.from_parts(W.W64.hi(f8), W.W64.lo(f8)), _, f10, f11, f12, f13, f14, f15, f16}))) == Fail{F.ElfTruncated{}} : Result<&2, &2, F.ElfError, H.ElfHeader>}
      trunc_bits(f0, f1, f2, f3, f4, f5, f6, W.W64.hi(f7), W.W64.lo(f7), W.W64.hi(f8), W.W64.lo(f8), W.W64.hi(f9), W.W64.lo(f9), f10, f11, f12, f13, f14, f15, f16)

